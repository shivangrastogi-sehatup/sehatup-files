{
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "functions": {
    "api/chat.js": {
      "maxDuration": 60,
      "includeFiles": "{prompts/**,api/kb/**}"
    }
  },
  "headers": [
    {
      "source": "/widget.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=300" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
