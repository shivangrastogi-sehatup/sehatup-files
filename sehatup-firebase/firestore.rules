rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Authenticated users can read/write all collections
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // QuickReply tester: the local tester UI is unauthenticated, so allow public
    // READ of conversation events only (writes still go through n8n's service
    // account). Scoped to this collection so nothing else is exposed.
    match /qr_conversations/{phone} {
      allow read: if true;
      match /events/{event} {
        allow read: if true;
      }
    }

    // Public questionnaire: visitors are NOT logged in, so they must be able to
    // submit without auth. Same inbound-write pattern as nimbus_tracking/shipments
    // below. Reads of completed submissions stay auth-only (admin dashboard) via
    // the catch-all rule above; only the writes the quiz needs are opened here.

    // In-progress (partial) submissions: created, read (to resume a session),
    // updated as the user answers, and deleted once the quiz is completed.
    match /partial_submissions/{doc} {
      allow create, read, update, delete: if true;
    }

    // Completed submissions: created on finish, and updated for the post-OTP
    // phone-number sync. The whatsapp_requests subcollection is written when the
    // user asks for their report on WhatsApp.
    match /questionnaire_submissions/{doc} {
      allow create, update: if true;

      match /whatsapp_requests/{reqDoc} {
        allow create: if true;
      }
    }

    // Nimbus webhook writes raw tracking events without auth (inbound push only)
    match /nimbus_tracking/{doc} {
      allow write: if true;
      allow read: if request.auth != null;
    }

    // Nimbus webhook (server-side enrichment) writes enriched shipment docs
    // without auth. Structure:
    //   shipments/{phone}                 → customer summary
    //   shipments/{phone}/awbs/{awb}      → per-shipment enriched doc
    match /shipments/{phone} {
      allow write: if true;
      allow read: if request.auth != null;
    }
    match /shipments/{phone}/awbs/{awb} {
      allow write: if true;
      allow read: if request.auth != null;
    }

    // Test-mode mirror of shipments (CRM "Test mode" uploads/enrichment) — same
    // inbound-write pattern, kept separate so production data is never touched.
    match /shipments_test/{phone} {
      allow write: if true;
      allow read: if request.auth != null;
    }
    match /shipments_test/{phone}/awbs/{awb} {
      allow write: if true;
      allow read: if request.auth != null;
    }
  }
}
