rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Authenticated users can read/write all collections except the server-only
    // ones. Rules are OR'd, so the exclusion has to live here, not in a deny block.
    // Servers use service accounts and bypass rules.
    match /{collection}/{document=**} {
      allow read, write: if request.auth != null
        && !(collection in ['ai_runs', 'qr_context_cache', 'nimbus_events_seen',
                            'shopify_sync_claims', 'active_whatsapp_requests']);
    }

    // Storefront lead-capture popup (shopify-elements/lead-capture-popup.liquid).
    // Visitors are not logged in: create only, never read back.
    match /popup_leads/{doc} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Public questionnaire: visitors are NOT logged in, so they must be able to
    // submit without auth. Same inbound-write pattern as nimbus_tracking/shipments
    // below. Reads of completed submissions stay auth-only (admin dashboard) via
    // the catch-all rule above; only the writes the quiz needs are opened here.

    // In-progress (partial) submissions: created, fetched by ID (to resume a session),
    // updated as the user answers, and deleted once the quiz is completed.
    // "get" not "read": the quiz only ever loads its own doc by ID, so public
    // listing stays closed. The CRM lists them signed in, via the catch-all.
    match /partial_submissions/{doc} {
      allow create, get, update, delete: if true;
    }

    // Completed submissions: created on finish, and updated for the post-OTP
    // phone-number sync. The whatsapp_requests subcollection is written when the
    // user asks for their report on WhatsApp.
    // Public update is limited to the phone sync: phone, rawState.userInfo.phone and
    // isVerified. A visitor who knows a report ID cannot rewrite the report itself.
    // Final reports are saved with add(), which is a create. CRM edits are signed in
    // and go through the catch-all.
    match /questionnaire_submissions/{doc} {
      allow create: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['phone', 'rawState', 'isVerified'])
                    && (!('rawState' in request.resource.data.diff(resource.data).affectedKeys())
                        || (request.resource.data.rawState.diff(resource.data.rawState).affectedKeys().hasOnly(['userInfo'])
                            && request.resource.data.rawState.userInfo
                                 .diff(resource.data.rawState.get('userInfo', {})).affectedKeys().hasOnly(['phone'])));

      match /whatsapp_requests/{reqDoc} {
        allow create: if true;
      }
    }

    // ── Nimbus shipment tracking ────────────────────────────────────────────
    // These collections USED TO carry `allow write: if true`, because the Vercel
    // webhook wrote to Firestore with FIREBASE_WEB_API_KEY — an API key identifies the
    // project, not a user, so `request.auth` was null and only an open rule let it
    // through. That also meant anyone who knew the project ID could write here.
    //
    // The server now authenticates with a service account (api/_lib/google-auth.js),
    // and service accounts bypass security rules entirely, so no public write rule is
    // needed. Both remaining writers are covered:
    //   • webhook / cron / backfill → service account, bypasses rules
    //   • CRM staff (Excel upload)  → signed in, covered by the auth catch-all above
    //
    // ⚠️ Deploy order matters: set FIREBASE_SERVICE_ACCOUNT in Vercel and ship the API
    // code BEFORE these rules, or inbound Nimbus events will be rejected.
    //
    // Structure:
    //   shipments/{phone}              → customer summary
    //   shipments/{phone}/awbs/{awb}   → per-shipment enriched doc
    match /nimbus_tracking/{doc} {
      allow read, write: if request.auth != null;
    }
    match /shipments/{phone} {
      allow read, write: if request.auth != null;
    }
    match /shipments/{phone}/awbs/{awb} {
      allow read, write: if request.auth != null;
    }
  }
}
