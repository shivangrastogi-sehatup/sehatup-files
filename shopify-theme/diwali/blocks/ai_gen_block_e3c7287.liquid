{% doc %}
  @prompt
    Create a responsive text marquee/ticker section with a single line of scrolling or static text.Layout structure:- Single line of text: "We Didn't Choose One Medical System. We United The Strongest Parts Of Three."- Clean, minimal design with text centered or scrolling horizontally- Optional background color or transparentRequirements:- Fully responsive layout:  * Desktop: full-width text display, centered or scrolling  * Tablet: adjusted font size, maintained layout  * Mobile: optimized font size, scrolling or wrapped text- Settings schema to customize:  * Text content (single line or multiple lines)  * Text color  * Background color  * Typography controls:    - Font size (desktop, tablet, mobile)    - Font weight    - Letter spacing    - Line height    - Text transform (uppercase, lowercase, capitalize, none)  * Text alignment: left, center, right  * Animation options:    - Static (no animation)    - Scroll/marquee (continuous horizontal scroll)    - Fade in on scroll    - Animation speed control (if scrolling)    - Animation direction (left to right, right to left)  * Section padding (top/bottom)  * Container max-width or full-width toggle  * Border options: top border, bottom border, color, width  * Mobile-specific:    - Font size override    - Text wrapping (single line or allow wrap)    - Animation toggle (enable/disable on mobile)- Text should be clean and readable- Optional scrolling/marquee animation for long text- Smooth animation if marquee is enabled- Text should scale appropriately on all devices- Support for rich text formatting (bold, italic)- Optional: duplicate text for seamless loop if using marquee- Accessible color contrast ratios- Clean, minimal design focused on typography- Optional: pause animation on hover- Mobile: text can wrap to multiple lines or scroll horizontally
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-text-marquee-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    overflow: hidden;
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    {% if block.settings.show_top_border %}
      border-top: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    {% endif %}
    {% if block.settings.show_bottom_border %}
      border-bottom: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    {% endif %}
  }

  .ai-text-marquee-container-{{ ai_gen_id }} {
    {% if block.settings.full_width %}
      width: 100%;
      max-width: none;
    {% else %}
      max-width: {{ block.settings.max_width }}px;
      margin: 0 auto;
      padding: 0 20px;
    {% endif %}
  }

  .ai-text-marquee-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    {% if block.settings.animation_type == 'marquee' %}
      display: flex;
      align-items: center;
    {% endif %}
  }

  .ai-text-marquee-content-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.font_size_desktop }}px;
    font-weight: {{ block.settings.font_weight }};
    letter-spacing: {{ block.settings.letter_spacing }}px;
    line-height: {{ block.settings.line_height }};
    text-transform: {{ block.settings.text_transform }};
    margin: 0;
    {% if block.settings.animation_type == 'static' %}
      text-align: {{ block.settings.text_alignment }};
    {% elsif block.settings.animation_type == 'marquee' %}
      white-space: nowrap;
      display: inline-block;
      padding-right: 50px;
      animation: ai-marquee-scroll-{{ ai_gen_id }} {{ block.settings.animation_speed }}s linear infinite;
      {% if block.settings.animation_direction == 'right_to_left' %}
        animation-direction: normal;
      {% else %}
        animation-direction: reverse;
      {% endif %}
    {% elsif block.settings.animation_type == 'fade' %}
      text-align: {{ block.settings.text_alignment }};
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.8s ease, transform 0.8s ease;
    {% endif %}
  }

  {% if block.settings.animation_type == 'marquee' %}
    .ai-text-marquee-wrapper-{{ ai_gen_id }}:hover .ai-text-marquee-content-{{ ai_gen_id }} {
      {% if block.settings.pause_on_hover %}
        animation-play-state: paused;
      {% endif %}
    }

    @keyframes ai-marquee-scroll-{{ ai_gen_id }} {
      0% {
        transform: translateX(0);
      }
      100% {
        transform: translateX(-100%);
      }
    }
  {% endif %}

  {% if block.settings.animation_type == 'fade' %}
    .ai-text-marquee-content-{{ ai_gen_id }}.ai-visible-{{ ai_gen_id }} {
      opacity: 1;
      transform: translateY(0);
    }
  {% endif %}

  @media screen and (max-width: 989px) {
    .ai-text-marquee-content-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size_tablet }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-text-marquee-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.7 | round }}px 0 {{ block.settings.padding_bottom | times: 0.7 | round }}px;
    }

    .ai-text-marquee-content-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size_mobile }}px;
      {% if block.settings.mobile_text_wrap %}
        white-space: normal;
        word-wrap: break-word;
      {% endif %}
      {% if block.settings.disable_animation_mobile and block.settings.animation_type == 'marquee' %}
        animation: none;
        white-space: normal;
        word-wrap: break-word;
        text-align: {{ block.settings.text_alignment }};
      {% endif %}
    }
  }
{% endstyle %}

<text-marquee-{{ ai_gen_id }}
  class="ai-text-marquee-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
  data-animation-type="{{ block.settings.animation_type }}"
>
  <div class="ai-text-marquee-container-{{ ai_gen_id }}">
    <div class="ai-text-marquee-wrapper-{{ ai_gen_id }}">
      {% if block.settings.animation_type == 'marquee' %}
        <p class="ai-text-marquee-content-{{ ai_gen_id }}">
          {{ block.settings.text_content }}
        </p>
        <p class="ai-text-marquee-content-{{ ai_gen_id }}" aria-hidden="true">
          {{ block.settings.text_content }}
        </p>
      {% else %}
        <p class="ai-text-marquee-content-{{ ai_gen_id }}">
          {{ block.settings.text_content }}
        </p>
      {% endif %}
    </div>
  </div>
</text-marquee-{{ ai_gen_id }}>

<script>
  (function() {
    class TextMarquee{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.animationType = this.dataset.animationType;
      }

      connectedCallback() {
        if (this.animationType === 'fade') {
          this.setupFadeAnimation();
        }
      }

      setupFadeAnimation() {
        const content = this.querySelector('.ai-text-marquee-content-{{ ai_gen_id }}');
        if (!content) return;

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                content.classList.add('ai-visible-{{ ai_gen_id }}');
              }
            });
          },
          {
            threshold: 0.2,
            rootMargin: '0px 0px -50px 0px'
          }
        );

        observer.observe(content);
      }
    }

    customElements.define('text-marquee-{{ ai_gen_id }}', TextMarquee{{ ai_gen_id }});
  })();
</script>

