{% doc %}
  @prompt
    Create a custom Shopify section called “Doctor-Designed Care Kits”.
    
    Section purpose:
    Showcase 4 featured care kits in a premium, trust-focused layout for a healthcare brand.
    
    Overall layout:
    - Full-width section
    - White background
    - Centered content container (max-width ~1200px)
    - Large centered heading at top:
      “Doctor-Designed Care Kits”
    
    Grid structure:
    - 2 rows × 2 columns on desktop
    - Responsive:
      - 1 column on mobile
      - Maintain visual balance
    
    Each card (block-based):
    - Rounded rectangle card (16–20px radius)
    - Soft pastel background color (editable per block)
    - No shadows (clean, medical feel)
    - Horizontal layout inside card:
      - Text on left
      - Image(s) on right
    
    Card content (left side):
    - Title (bold, large):
      Examples:
      - Stress & Sleep Balance Kit
      - Women’s Hormone Balance Kit
      - Men’s Performance Kit
      - Weight Management Kit
    - Short description (smaller, muted text)
    - Primary CTA button:
      - Label: “Buy Now”
      - Rounded pill button
      - Dark background (#111)
      - White text
    
    Card visuals (right side):
    - Allow 1–2 images per block:
      - Product bottle image
      - Human lifestyle image
    - Images should:
      - Stay inside card
      - Maintain aspect ratio
      - Align visually to the right
    - No image cropping by default
    
    Styling & typography:
    - Sans-serif font
    - Headings: bold, dark text
    - Descriptions: medium weight, slightly muted
    - Button text: medium-bold
    
    Admin / schema controls:
    - Section:
      - Heading text
      - Padding top / bottom
    - Block settings (repeatable):
      - Card background color
      - Title text
      - Description text
      - Button label
      - Button link
      - Product image
      - Lifestyle image
      - Image alignment (right)
    - Ability to reorder cards
    
    Technical requirements:
    - Use Shopify section + blocks
    - Clean Liquid, HTML, and CSS
    - No external libraries
    - Mobile-first responsive CSS
    - Semantic markup
    - Professional naming (no “ai”, no experimental tags)
    
    Goal:
    The section should look premium, trustworthy, and doctor-approved — suitable for a wellness 
{% enddoc %}
{% liquid
  assign section_id = section.id | replace: '_', '' | downcase
%}

{% style %}
  .care-kits-section-{{ section_id }} {
    width: 100%;
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .care-kits-container-{{ section_id }} {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .care-kits-heading-{{ section_id }} {
    text-align: center;
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 700;
    color: {{ section.settings.heading_color }};
    margin: 0 0 {{ section.settings.heading_spacing }}px;
    font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    font-weight: {{ section.settings.heading_font.weight }};
  }

  .care-kits-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ section.settings.grid_gap }}px;
  }

  .care-kit-card-{{ section_id }} {
    background-color: var(--card-bg-color);
    border-radius: {{ section.settings.card_radius }}px;
    padding: {{ section.settings.card_padding }}px;
    display: flex;
    align-items: center;
    gap: {{ section.settings.card_gap }}px;
    overflow: hidden;
  }

  .care-kit-content-{{ section_id }} {
    flex: 1;
    min-width: 0;
  }

  .care-kit-title-{{ section_id }} {
    font-size: {{ section.settings.title_size }}px;
    font-weight: 700;
    color: {{ section.settings.title_color }};
    margin: 0 0 {{ section.settings.title_spacing }}px;
    line-height: 1.3;
  }

  .care-kit-description-{{ section_id }} {
    font-size: {{ section.settings.description_size }}px;
    font-weight: 400;
    color: {{ section.settings.description_color }};
    margin: 0 0 {{ section.settings.description_spacing }}px;
    line-height: 1.5;
  }

  .care-kit-button-{{ section_id }} {
    display: inline-block;
    padding: {{ section.settings.button_padding_vertical }}px {{ section.settings.button_padding_horizontal }}px;
    background-color: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ section.settings.button_radius }}px;
    font-size: {{ section.settings.button_size }}px;
    font-weight: 600;
    transition: background-color 0.3s ease, transform 0.2s ease;
    border: none;
    cursor: pointer;
  }

  .care-kit-button-{{ section_id }}:hover {
    background-color: {{ section.settings.button_hover_bg_color }};
    transform: translateY(-2px);
  }

  .care-kit-images-{{ section_id }} {
    display: flex;
    gap: {{ section.settings.image_gap }}px;
    align-items: center;
    flex-shrink: 0;
  }

  .care-kit-image-wrapper-{{ section_id }} {
    width: {{ section.settings.image_width }}px;
    height: auto;
  }

  .care-kit-image-{{ section_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ section.settings.image_radius }}px;
  }

  .care-kit-image-placeholder-{{ section_id }} {
    width: 100%;
    aspect-ratio: 1;
    background-color: #f0f0f0;
    border-radius: {{ section.settings.image_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .care-kit-image-placeholder-{{ section_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @media screen and (max-width: 989px) {
    .care-kits-grid-{{ section_id }} {
      grid-template-columns: 1fr;
    }

    .care-kit-card-{{ section_id }} {
      flex-direction: column;
      text-align: center;
    }

    .care-kit-images-{{ section_id }} {
      justify-content: center;
    }

    .care-kits-heading-{{ section_id }} {
      font-size: calc({{ section.settings.heading_size }}px * 0.8);
    }

    .care-kit-title-{{ section_id }} {
      font-size: calc({{ section.settings.title_size }}px * 0.9);
    }
  }

  @media screen and (max-width: 749px) {
    .care-kit-image-wrapper-{{ section_id }} {
      width: {{ section.settings.image_width | times: 0.7 }}px;
    }

    .care-kits-heading-{{ section_id }} {
      font-size: calc({{ section.settings.heading_size }}px * 0.7);
    }
  }
{% endstyle %}

