{%- comment -%}
  About Us opening. Centred heading, line, button and trust line, then the
  people behind sehatUP as small, evenly aligned portraits in labelled groups
  (e.g. "Founders" and "Our experts"). A person starts a new group when their
  group name differs from the one before. The portraits only fade in once.
  Each person is a block: photo, name, role, group.
{%- endcomment -%}
{%- assign s = section.settings -%}
<style>
  #aop-{{ section.id }} {
    --ink: #1d1d1d; --mute: #5f5a56; --stone: #f6f0ec; --line: #e8e0d9; --btn: #d81f48;
    padding: clamp(40px, 5vw, 88px) clamp(16px, 4vw, 48px) clamp(48px, 5.5vw, 96px); background: #fff; color: var(--ink); font-family: 'Montserrat', sans-serif;
  }
  #aop-{{ section.id }} .aop__in { max-width: 1160px; margin: 0 auto; }
  #aop-{{ section.id }} .aop__head { max-width: 860px; margin: 0 auto; text-align: center; }
  #aop-{{ section.id }} .aop__kick { margin: 0 0 16px; font: 700 15px/1.3 'Montserrat', sans-serif; color: var(--btn); }
  #aop-{{ section.id }} .aop__h { margin: 0 0 20px; font: 800 clamp(36px, 4.4vw, 64px)/1.05 'Montserrat', sans-serif; letter-spacing: -.03em; color: var(--ink); text-wrap: balance; }
  #aop-{{ section.id }} .aop__sub { margin: 0 auto; max-width: 620px; font: 400 clamp(16px, 1.3vw, 18px)/1.6 'Montserrat', sans-serif; color: var(--mute); text-wrap: pretty; }
  #aop-{{ section.id }} .aop__cta { margin-top: 28px; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 12px 22px; }
  #aop-{{ section.id }} .aop__btn { display: inline-flex; align-items: center; gap: 10px; height: 54px; padding: 0 28px; border-radius: 999px; background: var(--btn); color: #fff; text-decoration: none; font: 700 16px/1 'Montserrat', sans-serif; transition: background-color .2s; }
  @media (hover: hover) { #aop-{{ section.id }} .aop__btn:hover { background: #c11a3f; color: #fff; } }
  #aop-{{ section.id }} .aop__btn:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  #aop-{{ section.id }} .aop__btn svg { width: .9em; height: .9em; }
  #aop-{{ section.id }} .aop__note { font: 500 14px/1.4 'Montserrat', sans-serif; color: var(--mute); }
  #aop-{{ section.id }} .aop__head .tp { margin-top: 22px; }

  #aop-{{ section.id }} .aop__team { display: flex; justify-content: center; align-items: flex-start; gap: clamp(28px, 4vw, 56px); margin-top: clamp(44px, 5vw, 72px); padding-top: clamp(28px, 3vw, 40px); border-top: 1px solid var(--line); }
  #aop-{{ section.id }} .aop__grp > p { margin: 0 0 16px; font: 700 14px/1.2 'Montserrat', sans-serif; color: var(--mute); }
  #aop-{{ section.id }} .aop__grp ul { display: flex; gap: 16px; margin: 0; padding: 0; list-style: none; }
  #aop-{{ section.id }} .aop__p { width: clamp(140px, 13vw, 180px); }
  #aop-{{ section.id }} .aop__pic { aspect-ratio: 4 / 5; border-radius: 18px; overflow: hidden; background: var(--stone); }
  #aop-{{ section.id }} .aop__pic img { width: 100%; height: 100%; object-fit: cover; object-position: center 12%; }
  #aop-{{ section.id }} .aop__p b { display: block; margin-top: 12px; font: 700 15px/1.3 'Montserrat', sans-serif; }
  #aop-{{ section.id }} .aop__p span { display: block; margin-top: 3px; font: 500 13.5px/1.35 'Montserrat', sans-serif; color: var(--mute); }

  #aop-{{ section.id }}.js .aop__team { opacity: 0; transform: translateY(12px); }
  #aop-{{ section.id }}.js.in .aop__team { opacity: 1; transform: none; transition: opacity .7s ease, transform .8s cubic-bezier(.22, 1, .36, 1); }

  @media (max-width: 899.98px) {
    #aop-{{ section.id }} .aop__team { flex-direction: column; align-items: stretch; gap: 28px; }
    #aop-{{ section.id }} .aop__grp ul { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
    #aop-{{ section.id }} .aop__p { width: auto; }
  }
  @media (max-width: 749.98px) {
    #aop-{{ section.id }} .aop__kick { font-size: 13.5px; margin-bottom: 12px; }
    #aop-{{ section.id }} .aop__h { font-size: clamp(30px, 8.6vw, 40px); margin-bottom: 14px; }
    #aop-{{ section.id }} .aop__sub { font-size: 15.5px; }
    #aop-{{ section.id }} .aop__cta { flex-direction: column; margin-top: 22px; }
    #aop-{{ section.id }} .aop__btn { width: 100%; justify-content: center; }
    #aop-{{ section.id }} .aop__grp > p { margin-bottom: 12px; font-size: 13px; }
    #aop-{{ section.id }} .aop__grp ul { gap: 10px; }
    #aop-{{ section.id }} .aop__pic { border-radius: 14px; }
    #aop-{{ section.id }} .aop__p b { font-size: 13px; margin-top: 8px; }
    #aop-{{ section.id }} .aop__p span { font-size: 12px; }
  }
  @media (min-width: 1680px) { #aop-{{ section.id }} .aop__in { zoom: 1.12; } }
  @media (min-width: 1920px) { #aop-{{ section.id }} .aop__in { zoom: 1.25; } }
  @media (min-width: 2560px) { #aop-{{ section.id }} .aop__in { zoom: 1.65; } }
  @media (min-width: 3200px) { #aop-{{ section.id }} .aop__in { zoom: 2; } }
  @media (prefers-reduced-motion: reduce) { #aop-{{ section.id }} * { transition: none !important; } }
</style>

<section id="aop-{{ section.id }}">
  <div class="aop__in">
    <div class="aop__head">
      {%- if s.kicker != blank -%}<p class="aop__kick">{{ s.kicker }}</p>{%- endif -%}
      <h1 class="aop__h">{{ s.heading }}</h1>
      {%- if s.subheading != blank -%}<p class="aop__sub">{{ s.subheading }}</p>{%- endif -%}
      {%- if s.button != blank or s.note != blank -%}
        <div class="aop__cta">
          {%- if s.button != blank -%}<a class="aop__btn" href="{{ s.button_link | default: '#' }}">{{ s.button }}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>{%- endif -%}
          {%- if s.note != blank -%}<span class="aop__note">{{ s.note }}</span>{%- endif -%}
        </div>
      {%- endif -%}
      {% render 'trust-proof', s: s, color: '#1d1d1d', ring: '#fff' %}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="aop__team">
        {%- assign grp = nil -%}
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          {%- if forloop.first or b.group != grp -%}
            {%- unless forloop.first -%}</ul></div>{%- endunless -%}
            {%- assign grp = b.group -%}
            <div class="aop__grp">{%- if grp != blank -%}<p>{{ grp }}</p>{%- endif -%}<ul>
          {%- endif -%}
          <li class="aop__p" {{ block.shopify_attributes }}>
            <div class="aop__pic">
              {%- if b.photo != blank -%}{{ b.photo | image_url: width: 500 | image_tag: alt: b.name, loading: 'eager', widths: '200, 360, 500', sizes: '(max-width: 899.98px) 30vw, 180px' }}{%- endif -%}
            </div>
            <b>{{ b.name }}</b>
            {%- if b.role != blank -%}<span>{{ b.role }}</span>{%- endif -%}
          </li>
          {%- if forloop.last -%}</ul></div>{%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('aop-{{ section.id }}');
    var team = root && root.querySelector('.aop__team');
    if (!team || !('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    root.classList.add('js');
    var io = new IntersectionObserver(function (es) {
      if (es[0].isIntersecting) { root.classList.add('in'); io.disconnect(); }
    }, { threshold: .15 });
    io.observe(team);
  })();
</script>

{% schema %}
{
  "name": "About: opening",
  "tag": "div",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small line above", "default": "About sehatUP" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Healthcare that finally makes sense." },
    { "type": "textarea", "id": "subheading", "label": "Line under it" },
    { "type": "text", "id": "button", "label": "Button" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "note", "label": "Line next to the button" },
    { "type": "header", "content": "Trust line" },
    { "type": "text", "id": "trust_text", "label": "Trust line", "info": "Empty hides faces, line and stars." },
    { "type": "text", "id": "rating", "label": "Rating" },
    { "type": "range", "id": "trust_count", "label": "Faces", "min": 0, "max": 5, "step": 1, "default": 4 },
    { "type": "text", "id": "trust_initials", "label": "Initials when a face has no photo", "default": "R, A, S, P, K" },
    { "type": "image_picker", "id": "avatar_1", "label": "Face 1" },
    { "type": "image_picker", "id": "avatar_2", "label": "Face 2" },
    { "type": "image_picker", "id": "avatar_3", "label": "Face 3" },
    { "type": "image_picker", "id": "avatar_4", "label": "Face 4" },
    { "type": "image_picker", "id": "avatar_5", "label": "Face 5" }
  ],
  "blocks": [
    {
      "type": "person",
      "name": "Person",
      "settings": [
        { "type": "image_picker", "id": "photo", "label": "Photo", "info": "Portrait, 4:5 works best." },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "role", "label": "Role" },
        { "type": "text", "id": "group", "label": "Group", "info": "e.g. Founders or Our experts. People next to each other with the same group sit together.", "default": "Our experts" }
      ]
    }
  ],
  "presets": [{ "name": "About: opening" }]
}
{% endschema %}
