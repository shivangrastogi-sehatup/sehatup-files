{%- comment -%}
  About Us: meet the founders. One big portrait per founder next to their
  role, name, quote and a line about them, alternating sides (photo left,
  then photo right). Each founder simply fades in once, so the page stays
  calm. Without JS, or with reduced motion, everything is simply shown.
  Under 850px each founder stacks: photo, then text.
  Each founder is a block.
{%- endcomment -%}
{%- assign s = section.settings -%}
<style>
  #afd-{{ section.id }} {
    --ink: #1d1d1d; --mute: #5f5a56; --stone: #f6f0ec; --red: #d81f48;
    --ease: cubic-bezier(.22, 1, .36, 1);
    padding: {{ s.padding_top | default: 64 }}px clamp(16px, 4vw, 48px) {{ s.padding_bottom | default: 80 }}px; background: {{ s.section_bg | default: '#ffffff' }}; color: var(--ink); font-family: 'Montserrat', sans-serif; overflow-x: clip;
  }
  #afd-{{ section.id }} * { box-sizing: border-box; }
  #afd-{{ section.id }} .afd__in { max-width: 1160px; margin: 0 auto; }
  #afd-{{ section.id }} .afd__h { margin: 0 0 clamp(36px, 4.5vw, 64px); text-align: center; color: var(--ink); font: 800 clamp(28px, 3.2vw, 44px)/1.08 'Montserrat', sans-serif; letter-spacing: -.02em; text-wrap: balance; }

  #afd-{{ section.id }} .afd__f { display: grid; grid-template-columns: minmax(0, 360px) minmax(0, 560px); justify-content: center; gap: clamp(32px, 5vw, 80px); align-items: center; margin: 0; }
  #afd-{{ section.id }} .afd__f:nth-of-type(even) { grid-template-columns: minmax(0, 560px) minmax(0, 360px); }
  #afd-{{ section.id }} .afd__f + .afd__f { margin-top: clamp(56px, 7vw, 112px); }
  #afd-{{ section.id }} .afd__f:nth-of-type(even) .afd__frame { order: 2; }
  #afd-{{ section.id }} .afd__frame { position: relative; width: 100%; max-width: 360px; justify-self: center; aspect-ratio: 4 / 5; border-radius: 28px; overflow: hidden; background: var(--stone); }
  #afd-{{ section.id }} .afd__frame img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 12%; }
  #afd-{{ section.id }} .afd__ini { position: absolute; inset: 0; display: grid; place-items: center; font: 800 120px/1 'Montserrat', sans-serif; color: #fff; background: #e8e0d9; }
  #afd-{{ section.id }} .afd__role { margin: 0 0 10px; font: 700 15px/1.3 'Montserrat', sans-serif; color: var(--red); }
  #afd-{{ section.id }} .afd__name { margin: 0; color: var(--ink); font: 800 clamp(28px, 2.8vw, 40px)/1.05 'Montserrat', sans-serif; letter-spacing: -.025em; }
  #afd-{{ section.id }} blockquote { position: relative; border: 0; font-style: normal; margin: clamp(22px, 2.6vw, 36px) 0 0; padding-left: clamp(36px, 3.6vw, 52px); font: 600 clamp(19px, 1.7vw, 24px)/1.4 'Montserrat', sans-serif; color: var(--ink); text-wrap: pretty; }
  #afd-{{ section.id }} blockquote::before { content: "\201C"; position: absolute; left: 0; top: -.08em; font: 800 clamp(56px, 5vw, 80px)/1 Georgia, serif; color: var(--red); }
  #afd-{{ section.id }} .afd__about { margin: clamp(18px, 2vw, 26px) 0 0; padding-left: clamp(36px, 3.6vw, 52px); font: 500 16px/1.6 'Montserrat', sans-serif; color: var(--mute); }

  /* Entrance (only set when the script runs) */
  #afd-{{ section.id }}.js .afd__f { transition: opacity .7s ease, transform .8s var(--ease); }
  #afd-{{ section.id }}.js .afd__f:not(.in) { opacity: 0; transform: translateY(16px); }

  @media (max-width: 849.98px) {
    #afd-{{ section.id }} { padding-top: {{ s.padding_top | default: 64 | times: 0.6 | round }}px; padding-bottom: {{ s.padding_bottom | default: 80 | times: 0.6 | round }}px; }
    #afd-{{ section.id }} .afd__f, #afd-{{ section.id }} .afd__f:nth-of-type(even) { grid-template-columns: minmax(0, 1fr); gap: 26px; }
    #afd-{{ section.id }} .afd__f:nth-of-type(even) .afd__frame { order: 0; }
    #afd-{{ section.id }} .afd__frame { max-width: 340px; border-radius: 24px; }
    #afd-{{ section.id }} blockquote, #afd-{{ section.id }} .afd__about { padding-left: 34px; }
  }
  @media (min-width: 1680px) { #afd-{{ section.id }} .afd__in { zoom: 1.12; } }
  @media (min-width: 1920px) { #afd-{{ section.id }} .afd__in { zoom: 1.25; } }
  @media (min-width: 2560px) { #afd-{{ section.id }} .afd__in { zoom: 1.65; } }
  @media (min-width: 3200px) { #afd-{{ section.id }} .afd__in { zoom: 2; } }
</style>

<section id="afd-{{ section.id }}">
  <div class="afd__in">
    {%- if s.heading != blank -%}<h2 class="afd__h">{{ s.heading }}</h2>{%- endif -%}
    {%- for b in section.blocks -%}
      {%- assign f = b.settings -%}
      <figure class="afd__f" {{ b.shopify_attributes }}>
        <div class="afd__frame">
          {%- if f.photo != blank -%}
            {{ f.photo | image_url: width: 1200 | image_tag: alt: f.name, loading: 'lazy', widths: '480, 700, 900, 1200', sizes: '(min-width: 850px) 360px, 92vw' }}
          {%- else -%}
            <span class="afd__ini" aria-hidden="true">{{ f.name | slice: 0 }}</span>
          {%- endif -%}
        </div>
        <figcaption>
          {%- if f.title != blank -%}<p class="afd__role">{{ f.title }}</p>{%- endif -%}
          <h3 class="afd__name">{{ f.name }}</h3>
          {%- if f.quote != blank -%}<blockquote>{{ f.quote }}</blockquote>{%- endif -%}
          {%- if f.about != blank -%}<p class="afd__about">{{ f.about }}</p>{%- endif -%}
        </figcaption>
      </figure>
    {%- endfor -%}
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('afd-{{ section.id }}');
    if (!root || matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
    root.classList.add('js');
    // Each founder fades in once when a third of the row is on screen.
    var io = new IntersectionObserver(function (es) {
      es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { threshold: .3 });
    root.querySelectorAll('.afd__f').forEach(function (f) { io.observe(f); });
  })();
</script>

{% schema %}
{
  "name": "About: meet the founders",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Meet the founders" },
    { "type": "color", "id": "section_bg", "label": "Background", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "label": "Space above", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Space below", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "founder", "name": "Founder", "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "photo", "label": "Photo", "info": "Portrait, at least 1000px wide. Shown 4:5, face in the top third." },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "title", "label": "Title", "default": "Founder" },
        { "type": "text", "id": "about", "label": "One line about them" },
        { "type": "textarea", "id": "quote", "label": "Quote" }
      ]
    }
  ],
  "presets": [{ "name": "About: meet the founders" }]
}
{% endschema %}
