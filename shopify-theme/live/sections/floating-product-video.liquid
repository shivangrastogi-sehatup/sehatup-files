{%- liquid
  assign fpv_accent      = section.settings.accent_color | default: '#ee204a'
  assign fpv_accent_dark = fpv_accent | color_darken: 8
  assign fpv_cta_label   = section.settings.cta_label | default: 'Add to cart'
  assign fpv_side        = section.settings.dock_side | default: 'left'
  assign fpv_bottom      = section.settings.dock_bottom | default: 96

  assign fpv_show     = false
  assign fpv_video    = ''
  assign fpv_has_card = false
  assign fpv_label    = 'Watch video'

  if section.settings.enable_video
    if section.settings.video_source == 'link'
      assign fpv_link = section.settings.video_url | strip
      assign fpv_probe = fpv_link | downcase

      assign fpv_is_page = false
      if fpv_probe contains 'instagram.com'
        assign fpv_is_page = true
      elsif fpv_probe contains 'facebook.com' or fpv_probe contains 'fb.watch'
        assign fpv_is_page = true
      elsif fpv_probe contains 'youtube.com' or fpv_probe contains 'youtu.be'
        assign fpv_is_page = true
      elsif fpv_probe contains 'tiktok.com'
        assign fpv_is_page = true
      elsif fpv_probe contains 'vimeo.com'
        assign fpv_is_page = true
      endif

      unless fpv_is_page
        assign fpv_video = fpv_link
      endunless
    else
      assign fpv_meta = product.metafields.custom.floating_video
      if template.name == 'product' and fpv_meta != blank
        if fpv_meta.value.sources != blank
          assign fpv_video = fpv_meta.value.sources.first.url
        elsif fpv_meta.value.url != blank
          assign fpv_video = fpv_meta.value.url
        else
          assign fpv_video = fpv_meta | file_url
        endif
        if fpv_video != blank
          assign fpv_has_card = true
          assign fpv_label = 'Watch video about ' | append: product.title
        endif
      endif
    endif

    if fpv_video != blank
      assign fpv_show = true
      assign fpv_id = 'fpv-' | append: section.id
    endif
  endif
-%}

{%- if fpv_show -%}

{%- comment -%} Styles first, so the browser never paints this section unstyled. {%- endcomment -%}
<style>
  #{{ fpv_id }} {
    --fpv-accent: {{ fpv_accent }};
    --fpv-accent-dark: {{ fpv_accent_dark }};
    --fpv-ink: #1d1d1d;
    --fpv-muted: #555555;
    --fpv-line: #e5e5e5;
    font-family: 'Montserrat', sans-serif;
  }

  #{{ fpv_id }} .fpv__dock {
    position: fixed;
    bottom: {{ fpv_bottom }}px;
    left: 16px;
    z-index: 60;
    width: 92px;
    animation: fpv-dock-in-{{ section.id }} .55s cubic-bezier(.18, .9, .28, 1.06) .9s both;
  }
  #{{ fpv_id }}[data-side="right"] .fpv__dock {
    left: auto;
    right: 16px;
    animation-name: fpv-dock-in-right-{{ section.id }};
  }
  #{{ fpv_id }} .fpv__dock[hidden] { display: none; }

  #{{ fpv_id }} .fpv__dock[data-return="true"] { animation-duration: .38s; animation-delay: 0s; }

  #{{ fpv_id }} .fpv__dock[data-leaving="true"] {
    animation: fpv-dock-out-{{ section.id }} .34s cubic-bezier(.6, 0, .78, 0) both;
  }
  #{{ fpv_id }}[data-side="right"] .fpv__dock[data-leaving="true"] {
    animation-name: fpv-dock-out-right-{{ section.id }};
  }

  @keyframes fpv-dock-in-{{ section.id }} {
    from { opacity: 0; transform: translateX(-140%) scale(.94); }
    to   { opacity: 1; transform: translateX(0) scale(1); }
  }
  @keyframes fpv-dock-out-{{ section.id }} {
    from { opacity: 1; transform: translateX(0) scale(1); }
    to   { opacity: 0; transform: translateX(-140%) scale(.94); }
  }
  @keyframes fpv-dock-in-right-{{ section.id }} {
    from { opacity: 0; transform: translateX(140%) scale(.94); }
    to   { opacity: 1; transform: translateX(0) scale(1); }
  }
  @keyframes fpv-dock-out-right-{{ section.id }} {
    from { opacity: 1; transform: translateX(0) scale(1); }
    to   { opacity: 0; transform: translateX(140%) scale(.94); }
  }

  #{{ fpv_id }} .fpv__dock-inner {
    position: relative;
    transition: transform .22s cubic-bezier(.16, 1, .3, 1);
  }

  #{{ fpv_id }} .fpv__dock-open {
    display: block;
    width: 100%;
    aspect-ratio: 9 / 16;
    padding: 0;
    border: 2px solid #fff;
    border-radius: 14px;
    overflow: hidden;
    background: #000;
    cursor: pointer;
    box-shadow: 0 10px 26px rgba(0, 0, 0, .28);
    position: relative;
    transition: box-shadow .22s ease;
  }
  #{{ fpv_id }} .fpv__dock-video { width: 100%; height: 100%; object-fit: cover; display: block; }
  #{{ fpv_id }} .fpv__dock-play {
    position: absolute; left: 50%; top: 50%; width: 30px; height: 30px; margin: -15px 0 0 -15px;
    border-radius: 50%; background: rgba(255, 255, 255, .92); box-shadow: 0 2px 8px rgba(0, 0, 0, .25);
  }
  #{{ fpv_id }} .fpv__dock-play::after {
    content: ""; position: absolute; left: 12px; top: 9px;
    border-left: 9px solid {{ fpv_accent }}; border-top: 6px solid transparent; border-bottom: 6px solid transparent;
  }
  #{{ fpv_id }} .fpv__dock-open::after {
    content: ""; position: absolute; inset: -2px; border-radius: 14px; border: 2px solid {{ fpv_accent }};
    opacity: 0; animation: fpv-ring-{{ section.id }} 2.6s ease-out 3s infinite; pointer-events: none;
  }
  @keyframes fpv-ring-{{ section.id }} { 0% { opacity: .8; transform: scale(1); } 70%, 100% { opacity: 0; transform: scale(1.12); } }
  @media (prefers-reduced-motion: reduce) { #{{ fpv_id }} .fpv__dock-open::after { animation: none; } }

  @media (hover: hover) and (pointer: fine) {
    #{{ fpv_id }} .fpv__dock:hover .fpv__dock-inner {
      transform: translateY(-3px) scale(1.04);
    }
    #{{ fpv_id }} .fpv__dock:hover .fpv__dock-open {
      box-shadow: 0 16px 34px rgba(0, 0, 0, .34);
    }
  }

  /* Playing inside the bubble: it grows to a watchable size, the play glyph
     and pulse ring go, and an expand button appears for the big player. */
  #{{ fpv_id }} .fpv__dock { transition: width .38s cubic-bezier(.16, 1, .3, 1); }
  #{{ fpv_id }} .fpv__dock[data-playing] { width: 176px; }
  #{{ fpv_id }} .fpv__dock[data-playing] .fpv__dock-play,
  #{{ fpv_id }} .fpv__dock[data-playing] .fpv__dock-open::after { display: none; }
  #{{ fpv_id }} .fpv__dock-expand {
    position: absolute; top: 8px; left: 8px; z-index: 2; width: 32px; height: 32px; padding: 0;
    display: none; align-items: center; justify-content: center;
    border: 0; border-radius: 999px; background: rgba(0, 0, 0, .55); color: #fff; cursor: pointer;
    backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px);
  }
  #{{ fpv_id }} .fpv__dock[data-playing] .fpv__dock-expand { display: inline-flex; }
  #{{ fpv_id }} .fpv__dock-expand:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  #{{ fpv_id }} .fpv__dock-paused {
    position: absolute; left: 50%; top: 50%; width: 44px; height: 44px; margin: -22px 0 0 -22px;
    border-radius: 50%; background: rgba(255, 255, 255, .9); display: none; pointer-events: none;
  }
  #{{ fpv_id }} .fpv__dock-paused::after {
    content: ""; position: absolute; left: 17px; top: 13px;
    border-left: 13px solid {{ fpv_accent }}; border-top: 9px solid transparent; border-bottom: 9px solid transparent;
  }
  #{{ fpv_id }} .fpv__dock[data-playing="paused"] .fpv__dock-paused { display: block; }

  #{{ fpv_id }} .fpv__dock-dismiss {
    position: absolute;
    top: -8px; right: -8px;
    width: 24px; height: 24px;
    border-radius: 999px;
    border: 1px solid var(--fpv-line);
    background: #fff;
    color: var(--fpv-ink);
    font: 400 14px/1 sans-serif;
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(0, 0, 0, .18);
    display: grid; place-items: center;
  }

  #{{ fpv_id }} .fpv__overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #{{ fpv_id }} .fpv__overlay[hidden] { display: none; }

  #{{ fpv_id }} .fpv__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(12, 10, 11, .72);
    backdrop-filter: blur(14px) saturate(120%);
    -webkit-backdrop-filter: blur(14px) saturate(120%);
    animation: fpv-fade .26s ease both;
  }
  @keyframes fpv-fade { from { opacity: 0; } to { opacity: 1; } }

  #{{ fpv_id }} .fpv__stage {
    position: relative;
    z-index: 1;
    aspect-ratio: 9 / 16;
    height: min(747px, 86vh, calc((100vw - 48px) * 16 / 9));
    width: auto;
    max-width: calc(100vw - 48px);
    border-radius: 18px;
    overflow: hidden;
    background: #000;
    box-shadow: 0 30px 80px rgba(0, 0, 0, .5);
    animation: fpv-rise .34s cubic-bezier(.16, 1, .3, 1) both;
  }
  @keyframes fpv-rise {
    from { opacity: 0; transform: translateY(20px) scale(.97); }
    to   { opacity: 1; transform: none; }
  }

  #{{ fpv_id }} .fpv__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #000;
  }

  #{{ fpv_id }} .fpv__top {
    position: absolute;
    top: 0; left: 0; right: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 26px 12px 28px;
    background: linear-gradient(to bottom, rgba(0,0,0,.55), rgba(0,0,0,0));
  }
  #{{ fpv_id }} .fpv__top-right { display: flex; gap: 8px; }

  #{{ fpv_id }} .fpv__icon {
    width: 36px; height: 36px;
    display: grid; place-items: center;
    border: none;
    border-radius: 999px;
    background: rgba(0, 0, 0, .38);
    color: #fff;
    cursor: pointer;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    transition: background .18s ease, transform .12s ease;
  }
  @media (hover: hover) and (pointer: fine) {
    #{{ fpv_id }} .fpv__icon:hover { background: var(--fpv-accent); }
  }
  #{{ fpv_id }} .fpv__icon:active { transform: scale(.92); }
  #{{ fpv_id }} .fpv__icon:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }

  #{{ fpv_id }} .fpv__ico-loud,
  #{{ fpv_id }} .fpv__ico-play { display: none; }
  #{{ fpv_id }} [data-fpv-sound][aria-pressed="true"] .fpv__ico-loud { display: block; }
  #{{ fpv_id }} [data-fpv-sound][aria-pressed="true"] .fpv__ico-muted { display: none; }
  #{{ fpv_id }} [data-fpv-playpause][data-paused="true"] .fpv__ico-play { display: block; }
  #{{ fpv_id }} [data-fpv-playpause][data-paused="true"] .fpv__ico-pause { display: none; }

  #{{ fpv_id }} .fpv__progress {
    position: absolute;
    top: 12px;
    left: 12px;
    right: 12px;
    height: 20px;
    z-index: 4;
    background: none;
    cursor: pointer;
    touch-action: none;
  }
  #{{ fpv_id }} .fpv__progress::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 3px;
    margin-top: -1.5px;
    border-radius: 999px;
    background: rgba(255, 255, 255, .34);
  }
  #{{ fpv_id }} .fpv__progress-fill {
    position: absolute;
    left: 0;
    top: 50%;
    height: 3px;
    margin-top: -1.5px;
    width: 0%;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 0 4px rgba(0, 0, 0, .5);
  }
  #{{ fpv_id }} .fpv__progress-knob {
    position: absolute;
    top: 50%;
    left: 0%;
    width: 11px; height: 11px;
    margin-left: -5.5px;
    margin-top: -5.5px;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 1px 4px rgba(0, 0, 0, .45);
    opacity: 0;
    transition: opacity .18s ease;
  }
  #{{ fpv_id }} .fpv__progress:hover .fpv__progress-knob,
  #{{ fpv_id }} .fpv__progress:focus-visible .fpv__progress-knob,
  #{{ fpv_id }} .fpv__progress[data-dragging="true"] .fpv__progress-knob { opacity: 1; }
  #{{ fpv_id }} .fpv__progress:focus-visible { outline: 2px solid #fff; outline-offset: 4px; }

  #{{ fpv_id }} .fpv__card {
    position: absolute;
    left: 10px; right: 10px; bottom: 10px;
    z-index: 3;
    padding: 10px;
    border-radius: 14px;
    background: rgba(255, 255, 255, .72);
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    border: 1px solid rgba(255, 255, 255, .5);
    box-shadow: 0 8px 26px rgba(0, 0, 0, .28);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  #{{ fpv_id }} .fpv__card-head { display: flex; align-items: center; gap: 9px; }
  #{{ fpv_id }} .fpv__thumb {
    width: 40px; height: 40px;
    flex: none;
    border-radius: 8px;
    object-fit: cover;
    background: #f2f2f2;
  }
  #{{ fpv_id }} .fpv__meta { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
  #{{ fpv_id }} .fpv__title {
    font-weight: 700; font-size: 11.5px; line-height: 1.25;
    color: var(--fpv-ink);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: -1px;
  }
  #{{ fpv_id }} .fpv__price { font-weight: 700; font-size: 13px; line-height: 1; color: var(--fpv-accent); }

  #{{ fpv_id }} .fpv__buy { display: flex; gap: 7px; }
  #{{ fpv_id }} .fpv__select {
    flex: 1;
    min-width: 0;
    height: 34px;
    padding: 0 8px;
    border: 1px solid rgba(0, 0, 0, .12);
    border-radius: 8px;
    background: rgba(255, 255, 255, .9);
    font-weight: 400; font-size: 12px; line-height: 1;
    color: var(--fpv-ink);
  }

  #{{ fpv_id }} .fpv__qty {
    flex: none;
    display: flex;
    align-items: center;
    border: 1px solid rgba(0, 0, 0, .12);
    border-radius: 8px;
    background: rgba(255, 255, 255, .9);
    overflow: hidden;
  }
  #{{ fpv_id }} .fpv__qty button {
    width: 28px; height: 34px;
    border: none;
    background: transparent;
    color: var(--fpv-ink);
    font-weight: 400; font-size: 15px; line-height: 1;
    cursor: pointer;
  }
  #{{ fpv_id }} .fpv__qty button:active { background: #f4f4f4; }
  #{{ fpv_id }} .fpv__qty input {
    width: 26px;
    height: 34px;
    border: none;
    text-align: center;
    font-weight: 600; font-size: 12px; line-height: 1;
    color: var(--fpv-ink);
    background: transparent;
  }
  #{{ fpv_id }} .fpv__qty input:focus { outline: none; }

  #{{ fpv_id }} .fpv__atc {
    width: 100%;
    padding: 11px;
    border: none;
    border-radius: 999px;
    background: var(--fpv-accent);
    color: #fff;
    font-weight: 700; font-size: 13.5px; line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: background .18s ease, transform .1s ease;
  }
  @media (hover: hover) and (pointer: fine) {
    #{{ fpv_id }} .fpv__atc:hover { background: var(--fpv-accent-dark); }
  }
  #{{ fpv_id }} .fpv__atc:active { transform: translateY(1px); }
  #{{ fpv_id }} .fpv__atc:disabled { opacity: .65; cursor: default; }

  #{{ fpv_id }} .fpv__spinner { display: none; }
  #{{ fpv_id }} .fpv__atc[data-loading="true"] .fpv__spinner {
    display: block;
    width: 14px; height: 14px;
    border-radius: 999px;
    border: 2px solid rgba(255, 255, 255, .45);
    border-top-color: #fff;
    animation: fpv-spin .7s linear infinite;
  }
  @keyframes fpv-spin { to { transform: rotate(360deg); } }

  #{{ fpv_id }} .fpv__status {
    margin: 0;
    font-weight: 500; font-size: 11px; line-height: 1.35;
    text-align: center;
    color: var(--fpv-muted);
  }
  #{{ fpv_id }} .fpv__status:empty { display: none; }
  #{{ fpv_id }} .fpv__status[data-state="error"] { color: #d01d42; }
  #{{ fpv_id }} .fpv__status a { color: inherit; font-weight: 700; }

  @media (max-width: 767px) {
    #{{ fpv_id }} .fpv__stage {
      width: 100%;
      height: 100%;
      max-width: none;
      aspect-ratio: auto;
      border-radius: 0;
      box-shadow: none;
    }
    #{{ fpv_id }} .fpv__backdrop { backdrop-filter: none; -webkit-backdrop-filter: none; background: #000; }
    #{{ fpv_id }} .fpv__progress { top: calc(12px + env(safe-area-inset-top)); }
    #{{ fpv_id }} .fpv__card {
      left: 12px; right: 12px;
      bottom: calc(12px + env(safe-area-inset-bottom));
    }
    #{{ fpv_id }} .fpv__top { padding-top: calc(26px + env(safe-area-inset-top)); }
    #{{ fpv_id }} .fpv__dock { bottom: {{ fpv_bottom | minus: 12 }}px; left: 12px; width: 78px; }
    #{{ fpv_id }} .fpv__dock[data-playing] { width: 138px; }
    /* vertical drags still scroll the page; horizontal ones are ours */
    #{{ fpv_id }} .fpv__dock { touch-action: pan-y; }
    #{{ fpv_id }} .fpv__dock[data-dragging] { cursor: grabbing; }
    #{{ fpv_id }}[data-side="right"] .fpv__dock { left: auto; right: 12px; }
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ fpv_id }} .fpv__dock,
    #{{ fpv_id }} .fpv__stage,
    #{{ fpv_id }} .fpv__backdrop { animation: none; }
    #{{ fpv_id }} .fpv__dock-inner,
    #{{ fpv_id }} .fpv__dock-open,
    #{{ fpv_id }} .fpv__icon,
    #{{ fpv_id }} .fpv__atc { transition: none; }
  }
</style>

<div
  class="fpv"
  id="{{ fpv_id }}"
  data-fpv
  data-side="{{ fpv_side }}"
  data-money-format="{{ shop.money_format | escape }}"
>

  <div class="fpv__dock" data-fpv-dock{% if section.settings.show_after_hero %} hidden data-wait-hero{% endif %}>
    <div class="fpv__dock-inner">
      <button type="button" class="fpv__dock-open" data-fpv-open aria-label="{{ fpv_label | escape }}">
        {%- comment -%}
          The dock is ~74px wide. It used to autoplay the full video on a loop,
          which streamed the whole file (12.5 MB on the Health Score page) on
          every visit, opened or not. Now it shows the first frame only, unless
          a small preview clip is set, which is the only thing that autoplays.
          The full video still loads only when the player is opened.
        {%- endcomment -%}
        {%- assign fpv_preview = section.settings.dock_preview_url | strip -%}
        {%- if fpv_preview != blank -%}
          <video class="fpv__dock-video" muted loop playsinline preload="none" aria-hidden="true" data-fpv-dock-autoplay>
            <source src="{{ fpv_preview }}" type="video/mp4">
          </video>
        {%- else -%}
          <video class="fpv__dock-video" muted playsinline preload="metadata" aria-hidden="true">
            <source src="{{ fpv_video }}#t=0.1" type="video/mp4">
          </video>
          <span class="fpv__dock-play" aria-hidden="true"></span>
        {%- endif -%}
      </button>
      <button type="button" class="fpv__dock-dismiss" data-fpv-dismiss aria-label="Hide this video">&#215;</button>
      <button type="button" class="fpv__dock-expand" data-fpv-expand aria-label="Watch larger">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <span class="fpv__dock-paused" aria-hidden="true"></span>
    </div>
  </div>

  <div class="fpv__overlay" data-fpv-overlay hidden>
    <div class="fpv__backdrop" data-fpv-close></div>

    <div class="fpv__stage" role="dialog" aria-modal="true" aria-label="{{ fpv_label | escape }}">
      <video class="fpv__video" data-fpv-video playsinline loop preload="none">
        <source src="{{ fpv_video }}" type="video/mp4">
      </video>

      <div
        class="fpv__progress"
        data-fpv-progress
        role="slider"
        aria-label="Video progress"
        aria-orientation="horizontal"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
        tabindex="0"
      >
        <span class="fpv__progress-fill" data-fpv-fill></span>
        <span class="fpv__progress-knob" data-fpv-knob></span>
      </div>

      <div class="fpv__top">
        <button type="button" class="fpv__icon" data-fpv-close aria-label="Close video">
          <svg viewBox="0 0 24 24" width="18" height="18"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>

        <div class="fpv__top-right">
          <button type="button" class="fpv__icon" data-fpv-sound aria-label="Unmute" aria-pressed="false">
            <svg class="fpv__ico-muted" viewBox="0 0 24 24" width="18" height="18"><path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor"/><path d="M17 9l4 6M21 9l-4 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            <svg class="fpv__ico-loud" viewBox="0 0 24 24" width="18" height="18"><path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor"/><path d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </button>
          <button type="button" class="fpv__icon" data-fpv-playpause aria-label="Pause">
            <svg class="fpv__ico-pause" viewBox="0 0 24 24" width="18" height="18"><path d="M8 5v14M16 5v14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
            <svg class="fpv__ico-play" viewBox="0 0 24 24" width="18" height="18"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg>
          </button>
          <button type="button" class="fpv__icon" data-fpv-full aria-label="Watch full screen">
            <svg viewBox="0 0 24 24" width="18" height="18"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </div>

      {%- if fpv_has_card -%}
      <div class="fpv__card">
        <div class="fpv__card-head">
          {%- if product.featured_image != blank -%}
            <img class="fpv__thumb" src="{{ product.featured_image | image_url: width: 120 }}" alt="" width="60" height="60" loading="lazy">
          {%- endif -%}
          <div class="fpv__meta">
            <span class="fpv__title">{{ product.title }}</span>
            <span class="fpv__price" data-fpv-price>{{ product.selected_or_first_available_variant.price | money }}</span>
          </div>
        </div>

        <div class="fpv__buy">
          {%- if product.variants.size > 1 -%}
            <select class="fpv__select" data-fpv-variant aria-label="Choose an option">
              {%- for variant in product.variants -%}
                <option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>
                  {{ variant.title }}{% unless variant.available %} (sold out){% endunless %}
                </option>
              {%- endfor -%}
            </select>
          {%- else -%}
            <input type="hidden" data-fpv-variant value="{{ product.selected_or_first_available_variant.id }}">
          {%- endif -%}

          <div class="fpv__qty">
            <button type="button" data-fpv-qty="-1" aria-label="Decrease quantity">&#8722;</button>
            <input type="text" inputmode="numeric" value="1" data-fpv-qty-input aria-label="Quantity">
            <button type="button" data-fpv-qty="1" aria-label="Increase quantity">&#43;</button>
          </div>
        </div>

        <button type="button" class="fpv__atc" data-fpv-atc>
          <span class="fpv__spinner" aria-hidden="true"></span>
          <span data-fpv-atc-label>{{ fpv_cta_label }}</span>
        </button>
        <p class="fpv__status" data-fpv-status role="status" aria-live="polite"></p>
      </div>
      {%- endif -%}
    </div>
  </div>
</div>

{%- if fpv_has_card -%}
<script type="application/json" data-fpv-variants>
[
  {%- for v in product.variants -%}
    {"id": {{ v.id }}, "price": {{ v.price }}, "available": {{ v.available }}}{%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
]
</script>
{%- endif -%}


<script>
  (function () {
    var root = document.getElementById('{{ fpv_id }}');
    if (!root || root.dataset.fpvBooted === '1') return;
    root.dataset.fpvBooted = '1';

    var $ = function (sel) { return root.querySelector(sel); };
    var dock      = $('[data-fpv-dock]');
    var overlay   = $('[data-fpv-overlay]');
    var video     = $('[data-fpv-video]');
    var progress  = $('[data-fpv-progress]');
    var fill      = $('[data-fpv-fill]');
    var knob      = $('[data-fpv-knob]');
    var soundBtn  = $('[data-fpv-sound]');
    var playBtn   = $('[data-fpv-playpause]');
    var variantEl = $('[data-fpv-variant]');
    var qtyInput  = $('[data-fpv-qty-input]');
    var priceEl   = $('[data-fpv-price]');
    var atc       = $('[data-fpv-atc]');
    var atcLabel  = $('[data-fpv-atc-label]');
    var statusEl  = $('[data-fpv-status]');

    var variants = [];
    try { variants = JSON.parse(root.parentNode.querySelector('[data-fpv-variants]').textContent); }
    catch (e) { try { variants = JSON.parse(document.querySelector('[data-fpv-variants]').textContent); } catch (e2) { variants = []; } }

    var dockDismissed = false;
    var dockVideo = $('[data-fpv-dock-autoplay]');   // only a small preview clip autoplays
    var dockReduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var dockPlaying = false;
    function playDock() {
      if (dockPlaying || !dockVideo) return;
      dockPlaying = true;
      var p = dockVideo.play();
      if (p && p.catch) p.catch(function () {});
    }

    dock.addEventListener('animationend', function (e) {
      if (e.animationName.indexOf('fpv-dock-in') === 0) playDock();
    });
    if (dockReduceMotion) playDock();
    setTimeout(playDock, 2200);

    var priorOverflow = '', priorPad = '';
    function lockScroll() {
      var gap = window.innerWidth - document.documentElement.clientWidth;
      priorOverflow = document.body.style.overflow;
      priorPad = document.body.style.paddingRight;
      document.body.style.overflow = 'hidden';
      if (gap > 0) {
        var cur = parseFloat(getComputedStyle(document.body).paddingRight) || 0;
        document.body.style.paddingRight = (cur + gap) + 'px';
      }
    }
    function unlockScroll() {
      document.body.style.overflow = priorOverflow;
      document.body.style.paddingRight = priorPad;
    }

    var lastFocused = null;

    function openPlayer(startAt, withSound) {
      if (!overlay.hidden) return;
      lastFocused = document.activeElement;
      overlay.hidden = false;
      dock.hidden = true;
      lockScroll();
      setStatus('');
      video.muted = !withSound;
      syncSound();
      if (startAt > 0) {
        // The big player has not loaded yet: seek once it knows its length.
        if (video.readyState >= 1) video.currentTime = startAt;
        else video.addEventListener('loadedmetadata', function () { video.currentTime = startAt; }, { once: true });
      }
      var p = video.play();
      if (p && p.catch) p.catch(function () { syncPlay(); });
      syncPlay();
      $('[data-fpv-close]').focus({ preventScroll: true });
    }

    function closePlayer() {
      if (overlay.hidden) return;
      video.pause();
      if (inlinePlay && video.currentTime > 0) {
        try { bubbleVid.currentTime = video.currentTime; } catch (e) {}
        dock.setAttribute('data-playing', 'paused');
      }
      stopTracking();
      overlay.hidden = true;
      unlockScroll();
      if (!dockDismissed && !atFooter) {
        dock.removeAttribute('data-leaving');
        dock.setAttribute('data-return', 'true');
      }
      dock.hidden = dockDismissed || atFooter || waitHero;
      if (lastFocused && lastFocused.focus) lastFocused.focus({ preventScroll: true });
    }

    /* Tapping the bubble plays the video right there (it grows to a watchable
       size, sound on, since the tap allows it); tapping again pauses. The
       expand button opens the big player at the same second. A small preview
       clip, when one is set, keeps the old behaviour: tap opens the player. */
    var bubbleVid = $('.fpv__dock-video');
    var inlinePlay = !!bubbleVid && !dockVideo;
    var expandBtn = $('[data-fpv-expand]');

    function bubblePlay() {
      bubbleVid.muted = false;
      bubbleVid.loop = true;
      var p = bubbleVid.play(); if (p && p.catch) p.catch(function () { bubbleVid.muted = true; bubbleVid.play(); });
      dock.setAttribute('data-playing', 'true');
    }
    function bubblePause() {
      bubbleVid.pause();
      dock.setAttribute('data-playing', 'paused');
    }

    $('[data-fpv-open]').addEventListener('click', function () {
      if (!inlinePlay) { openPlayer(); return; }
      if (bubbleVid.paused) bubblePlay(); else bubblePause();
    });

    if (expandBtn) expandBtn.addEventListener('click', function (e) {
      e.stopPropagation();
      var at = bubbleVid ? bubbleVid.currentTime : 0;
      var wasHeard = bubbleVid && !bubbleVid.paused && !bubbleVid.muted;
      if (bubbleVid) bubbleVid.pause();
      dock.removeAttribute('data-playing');
      openPlayer(at, wasHeard || true);
    });
    root.querySelectorAll('[data-fpv-close]').forEach(function (el) {
      el.addEventListener('click', closePlayer);
    });

    $('[data-fpv-dismiss]').addEventListener('click', function () {
      dockDismissed = true;
      if (dockReduceMotion) { dock.hidden = true; return; }
      dock.setAttribute('data-leaving', 'true');
      var gone = false;
      function finish() {
        if (gone) return;
        gone = true;
        dock.hidden = true;
        dock.removeAttribute('data-leaving');
      }
      dock.addEventListener('animationend', finish, { once: true });
      setTimeout(finish, 500);
    });

    /* ── Swipe the dock away (touch) ───────────────────────────────────────
       Drag it toward the edge it is docked against: it follows the finger and
       fades as it goes, so you can see the dismissal before you commit. Let go
       short of the threshold and it springs back; carry on past it and it
       leaves. Vertical drags are left to the page, so scrolling still works
       with a finger on the video. */
    (function () {
      var DISMISS_PX = 72;        // far enough to mean it
      var FADE_OVER = 130;        // fully faded by here
      var FLICK = 0.5;            // px per ms: a quick flick counts regardless
      var startX = 0, startY = 0, startT = 0;
      var dx = 0, dragging = false, decided = false, swallowClick = false;
      var toLeft = root.getAttribute('data-side') !== 'right';

      function setDrag(on) {
        dock.style.transition = on ? 'none' : 'transform .32s cubic-bezier(.22,.9,.3,1), opacity .32s ease';
      }

      function reset() {
        setDrag(false);
        // explicit, not cleared: the slide-in animation has been switched off
        dock.style.transform = 'translateX(0px)';
        dock.style.opacity = '1';
      }

      dock.addEventListener('pointerdown', function (e) {
        if (e.pointerType === 'mouse') return;      // pointer devices have the × button
        startX = e.clientX; startY = e.clientY; startT = e.timeStamp;
        dx = 0; dragging = false; decided = false;
        // The dock slides in with a CSS animation whose "both" fill keeps
        // applying its transform for the life of the page. A running animation
        // beats an inline style, so without this the video never moved with
        // the finger and only disappeared at the end of the gesture.
        dock.style.animation = 'none';
        // Keep every move on this element even when the finger leaves it.
        try { dock.setPointerCapture(e.pointerId); } catch (err) {}
      });

      dock.addEventListener('pointermove', function (e) {
        if (!startT) return;
        var mx = e.clientX - startX, my = e.clientY - startY;

        if (!decided) {
          if (Math.abs(mx) < 6 && Math.abs(my) < 6) return;
          // a mostly vertical drag belongs to the page, not to us
          decided = true;
          dragging = Math.abs(mx) > Math.abs(my) && (toLeft ? mx < 0 : mx > 0);
          if (dragging) { setDrag(true); dock.setAttribute('data-dragging', 'true'); }
        }
        if (!dragging) return;

        // only toward the docked edge, with a little resistance the other way
        dx = toLeft ? Math.min(0, mx) : Math.max(0, mx);
        var travelled = Math.min(1, Math.abs(dx) / FADE_OVER);
        dock.style.transform = 'translateX(' + dx + 'px)';
        dock.style.opacity = String(Math.max(0.08, 1 - travelled));
        e.preventDefault();
      }, { passive: false });

      function release(e) {
        if (!startT) return;
        var was = dragging;
        var speed = Math.abs(dx) / Math.max(1, e.timeStamp - startT);
        startT = 0; dragging = false; decided = false;
        if (!was) return;

        dock.removeAttribute('data-dragging');
        swallowClick = true;
        setTimeout(function () { swallowClick = false; }, 0);

        if (Math.abs(dx) > DISMISS_PX || speed > FLICK) {
          dockDismissed = true;
          setDrag(false);
          dock.style.transform = 'translateX(' + (toLeft ? -1 : 1) * (dock.offsetWidth + 40) + 'px)';
          dock.style.opacity = '0';
          setTimeout(function () { dock.hidden = true; reset(); }, 300);
        } else {
          reset();
        }
      }

      dock.addEventListener('pointerup', release);
      // A cancelled pointer is the browser taking the gesture away, not a
      // decision to dismiss, so put the video back.
      dock.addEventListener('pointercancel', function () {
        startT = 0; dragging = false; decided = false;
        dock.removeAttribute('data-dragging');
        reset();
      });

      // a drag that ends on the video should not also open the player
      dock.addEventListener('click', function (e) {
        if (!swallowClick) return;
        e.preventDefault();
        e.stopPropagation();
      }, true);
    })();

    var atFooter = false;

    /* Optional: keep the bubble out of the way until the visitor has scrolled
       past the first section, so it never covers the page's main choice. */
    var waitHero = dock.hasAttribute('data-wait-hero');
    (function () {
      if (!waitHero) return;
      var first = document.querySelector('main .shopify-section, #MainContent .shopify-section');
      function reveal() {
        if (!waitHero) return;
        waitHero = false;
        if (dockDismissed || atFooter || !overlay.hidden) return;
        dock.setAttribute('data-return', 'true');
        dock.hidden = false;
      }
      if (!first || !('IntersectionObserver' in window)) { reveal(); return; }
      var io = new IntersectionObserver(function (en) {
        // Gone above the viewport = scrolled past it.
        if (!en[0].isIntersecting && en[0].boundingClientRect.top < 0) { io.disconnect(); reveal(); }
      }, { threshold: 0 });
      io.observe(first);
    })();

    function findFooter() {
      try {
        var footers = document.querySelectorAll(
          '[id*="shopify-section"][id*="footer"], footer, .footer, [class*="site-footer"]'
        );
        return footers.length ? footers[footers.length - 1] : null;
      } catch (e) { return null; }
    }

    function hideForFooter() {
      if (dockDismissed || atFooter) return;
      atFooter = true;
      if (!overlay.hidden || dock.hidden) return;
      if (dockReduceMotion) { dock.hidden = true; return; }
      dock.removeAttribute('data-return');
      dock.setAttribute('data-leaving', 'true');
      var gone = false;
      function finish() {
        if (gone) return;
        gone = true;
        dock.removeAttribute('data-leaving');
        if (atFooter) dock.hidden = true;
      }
      dock.addEventListener('animationend', finish, { once: true });
      setTimeout(finish, 500);
    }

    function showAfterFooter() {
      if (!atFooter) return;
      atFooter = false;
      if (dockDismissed || !overlay.hidden || waitHero) return;
      dock.removeAttribute('data-leaving');
      if (!dockReduceMotion) dock.setAttribute('data-return', 'true');
      dock.hidden = false;
    }

    function watchFooter() {
      var footerEl = findFooter();
      if (!footerEl || !('IntersectionObserver' in window)) return;
      new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) hideForFooter();
          else showAfterFooter();
        });
      }, {
        rootMargin: '0px 0px -40px 0px',
        threshold: 0
      }).observe(footerEl);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', watchFooter, { once: true });
    } else {
      watchFooter();
    }

    document.addEventListener('keydown', function (e) {
      if (overlay.hidden) return;
      if (e.key === 'Escape') { closePlayer(); return; }
      if (e.key === ' ' && e.target === progress) { e.preventDefault(); togglePlay(); return; }
      if (e.key !== 'Tab') return;
      var f = overlay.querySelectorAll('button, select, input, [href], [tabindex="0"]');
      if (!f.length) return;
      var first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    });

    function syncPlay() {
      var paused = video.paused;
      playBtn.setAttribute('data-paused', paused ? 'true' : 'false');
      playBtn.setAttribute('aria-label', paused ? 'Play' : 'Pause');
    }
    function togglePlay() {
      if (video.paused) { var p = video.play(); if (p && p.catch) p.catch(function () {}); }
      else video.pause();
      syncPlay();
    }
    function syncSound() {
      soundBtn.setAttribute('aria-pressed', video.muted ? 'false' : 'true');
      soundBtn.setAttribute('aria-label', video.muted ? 'Unmute' : 'Mute');
    }

    playBtn.addEventListener('click', togglePlay);
    soundBtn.addEventListener('click', function () { video.muted = !video.muted; syncSound(); });

    // Full screen. The first play stays inline in the player; this button takes
    // the video full screen with sound and the browser's own controls (seek,
    // pause, exit). iPhone Safari only allows video full screen through its
    // native player (webkitEnterFullscreen); everything else uses the standard
    // Fullscreen API on the video element.
    var fullBtn = $('[data-fpv-full]');
    function inFull() { return document.fullscreenElement === video || document.webkitFullscreenElement === video; }
    function leftFull() {
      video.controls = false;
      syncSound(); syncPlay();
    }
    if (fullBtn) {
      fullBtn.addEventListener('click', function () {
        video.muted = false;
        syncSound();
        var p = video.play(); if (p && p.catch) p.catch(function () {});
        video.controls = true;
        if (video.requestFullscreen) video.requestFullscreen().catch(function () { video.controls = false; });
        else if (video.webkitRequestFullscreen) video.webkitRequestFullscreen();
        else if (video.webkitEnterFullscreen) video.webkitEnterFullscreen();
        else video.controls = false;
      });
      document.addEventListener('fullscreenchange', function () { if (!inFull()) leftFull(); });
      document.addEventListener('webkitfullscreenchange', function () { if (!inFull()) leftFull(); });
      video.addEventListener('webkitendfullscreen', leftFull);   // iPhone native player closed
    }
    video.addEventListener('play', syncPlay);
    video.addEventListener('pause', syncPlay);
    video.addEventListener('click', togglePlay);

    var rafId = null;
    var lastAria = -1;

    function paint(pct) {
      fill.style.width = pct + '%';
      knob.style.left = pct + '%';
      var rounded = Math.round(pct);
      if (rounded !== lastAria) {
        lastAria = rounded;
        progress.setAttribute('aria-valuenow', rounded);
      }
    }

    function frame() {
      if (video.duration && !isNaN(video.duration) && progress.dataset.dragging !== 'true') {
        paint(video.currentTime / video.duration * 100);
      }
      rafId = requestAnimationFrame(frame);
    }
    function startTracking() { if (rafId === null) rafId = requestAnimationFrame(frame); }
    function stopTracking() {
      if (rafId !== null) { cancelAnimationFrame(rafId); rafId = null; }
    }

    video.addEventListener('playing', startTracking);
    video.addEventListener('pause', stopTracking);
    video.addEventListener('ended', stopTracking);
    video.addEventListener('seeked', function () {
      if (video.paused && video.duration) paint(video.currentTime / video.duration * 100);
    });
    video.addEventListener('loadedmetadata', function () { paint(0); });

    function seekTo(clientX) {
      if (!video.duration || isNaN(video.duration)) return;
      var r = progress.getBoundingClientRect();
      var pct = Math.min(1, Math.max(0, (clientX - r.left) / r.width));
      video.currentTime = pct * video.duration;
      paint(pct * 100);
    }

    progress.addEventListener('pointerdown', function (e) {
      progress.dataset.dragging = 'true';
      progress.setPointerCapture(e.pointerId);
      seekTo(e.clientX);
    });
    progress.addEventListener('pointermove', function (e) {
      if (progress.dataset.dragging === 'true') seekTo(e.clientX);
    });
    ['pointerup', 'pointercancel'].forEach(function (evt) {
      progress.addEventListener(evt, function () { progress.dataset.dragging = 'false'; });
    });
    progress.addEventListener('keydown', function (e) {
      if (!video.duration) return;
      if (e.key === 'ArrowDown' || e.key === 'ArrowRight') { e.preventDefault(); video.currentTime = Math.min(video.duration, video.currentTime + 5); }
      if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') { e.preventDefault(); video.currentTime = Math.max(0, video.currentTime - 5); }
    });

    var MONEY_FORMAT = root.dataset.moneyFormat || '{% raw %}{{amount}}{% endraw %}';

    function formatFallback(cents, format) {
      var placeholder = /\{\{\s*(\w+)\s*\}\}/;
      function group(num, precision, thousands, decimal) {
        if (isNaN(num) || num === null) return '0';
        var fixed = (num / 100.0).toFixed(precision);
        var parts = fixed.split('.');
        var whole = parts[0].replace(/(\d)(?=(\d\d\d)+(?!\d))/g, '$1' + thousands);
        return whole + (parts[1] ? decimal + parts[1] : '');
      }
      var m = format.match(placeholder);
      var out;
      switch (m && m[1]) {
        case 'amount_no_decimals': out = group(cents, 0, ',', '.'); break;
        case 'amount_with_comma_separator': out = group(cents, 2, '.', ','); break;
        case 'amount_no_decimals_with_comma_separator': out = group(cents, 0, '.', ','); break;
        default: out = group(cents, 2, ',', '.');
      }
      return format.replace(placeholder, out);
    }

    function money(cents) {
      if (window.Shopify && typeof window.Shopify.formatMoney === 'function') {
        return window.Shopify.formatMoney(cents, MONEY_FORMAT);
      }
      return formatFallback(cents, MONEY_FORMAT);
    }

    function unitPrice() {
      var id = variantEl ? String(variantEl.value) : null;
      var v = variants.filter(function (x) { return String(x.id) === id; })[0];
      return v ? v.price : (variants[0] ? variants[0].price : 0);
    }

    function paintPrice() {
      if (priceEl) priceEl.textContent = money(unitPrice() * currentQty());
    }

    var hasCard = !!atc;

    function currentQty() {
      if (!qtyInput) return 1;
      var n = parseInt(String(qtyInput.value).replace(/\D/g, ''), 10);
      return (!n || n < 1) ? 1 : Math.min(n, 99);
    }
    function setStatus(msg, state) {
      if (!statusEl) return;
      statusEl.innerHTML = msg || '';
      if (state) statusEl.setAttribute('data-state', state);
      else statusEl.removeAttribute('data-state');
    }

    if (hasCard) {
      root.querySelectorAll('[data-fpv-qty]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          qtyInput.value = Math.max(1, currentQty() + parseInt(btn.dataset.fpvQty, 10));
          paintPrice();
        });
      });
      qtyInput.addEventListener('input', paintPrice);
      qtyInput.addEventListener('blur', function () { qtyInput.value = currentQty(); paintPrice(); });

      if (variantEl && variantEl.tagName === 'SELECT') {
        variantEl.addEventListener('change', function () { paintPrice(); setStatus(''); });
      }

      paintPrice();
    }

    if (hasCard) atc.addEventListener('click', async function () {
      var id = variantEl ? variantEl.value : null;
      if (!id) { setStatus('Choose an option first.', 'error'); return; }

      atc.disabled = true;
      atc.setAttribute('data-loading', 'true');
      atcLabel.textContent = 'Adding…';
      setStatus('');

      try {
        var res = await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ items: [{ id: Number(id), quantity: currentQty() }] }),
        });
        if (!res.ok) {
          var problem = await res.json().catch(function () { return {}; });
          throw new Error(problem.description || problem.message || 'Add to cart failed');
        }

        document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
        document.dispatchEvent(new CustomEvent('cart:build', { bubbles: true }));
        document.dispatchEvent(new CustomEvent('ajaxProduct:added', { bubbles: true }));
        document.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true }));

        unlockScroll();
        window.location.href = '/cart';
        return;
      } catch (err) {
        console.error('[floating video] add to cart failed:', err);
        setStatus(err.message || 'Could not add to cart. Please try again.', 'error');
      } finally {
        atc.disabled = false;
        atc.removeAttribute('data-loading');
        atcLabel.textContent = {{ fpv_cta_label | json }};
      }
    });
  })();
</script>

{%- endif -%}

{% schema %}
{
  "name": "Floating video",
