{%- comment -%}
  "What's in your kit": the products a kit is made of, each with its photo and
  how to take it. Shown only on products whose description names at least two
  other products of the store (so single products skip it on their own).

  Items and the one-line instruction come from snippets/sehat-facts.liquid.
  A product not listed there falls back to its metafields (custom.kit_items,
  custom.short_use), then to guessing from the description text.
{%- endcomment -%}

{%- liquid
  assign hay = product.description | strip_html | downcase
  assign found = ''
  assign count = 0
  for p in collections.all.products
    if p.id == product.id or count >= section.settings.max_items
      continue
    endif
    assign short = p.title | split: ' - ' | first | split: ' | ' | first | split: ' (' | first | split: ' – ' | first | strip | downcase
    if short.size > 5 and hay contains short
      assign found = found | append: p.handle | append: ','
      assign count = count | plus: 1
    endif
  endfor
  capture fact_items
    render 'sehat-facts', handle: product.handle, field: 'items'
  endcapture
  assign fact_items = fact_items | strip
  assign picked = product.metafields.custom.kit_items.value
  if fact_items != ''
    assign found = fact_items
    assign count = fact_items | split: ',' | size
  elsif picked != blank
    assign found = ''
    assign count = 0
    for p in picked
      assign found = found | append: p.handle | append: ','
      assign count = count | plus: 1
    endfor
  endif
  assign handles = found | split: ','
  assign min_items = 2
  if picked != blank or fact_items != ''
    assign min_items = 1
  endif
-%}

{%- if count >= min_items -%}
{%- comment -%} Styles first, so the browser never paints this section unstyled. {%- endcomment -%}
<style>
  #ski-{{ section.id }} {
    --ski-text: #1d1d1d; --ski-muted: #555; --ski-line: #eadfd8;
    --ski-ink: {{ section.settings.accent_color | color_darken: 8 }};
    padding: 8px clamp(16px, 2vw, 28px) 48px;
    background: #fff;
    font-family: 'Montserrat', sans-serif; color: var(--ski-text);
  }
  #ski-{{ section.id }} * { box-sizing: border-box; }
  #ski-{{ section.id }} .ski__inner { max-width: 1160px; margin: 0 auto; padding-top: 16px; }
  #ski-{{ section.id }} .ski__heading { margin: 0; font: 800 clamp(24px, 2.6vw, 34px)/1.15 'Montserrat', sans-serif; letter-spacing: -.02em; }
  #ski-{{ section.id }} .ski__sub { margin: 10px 0 0; max-width: 40em; font: 500 15.5px/1.55 'Montserrat', sans-serif; color: var(--ski-muted); }
  #ski-{{ section.id }} .ski__grid { margin-top: 28px; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 18px; }
  #ski-{{ section.id }} .ski__card {
    display: grid; grid-template-columns: 170px minmax(0, 1fr); gap: 24px; align-items: center;
    padding: 16px; border-radius: 14px; background: #f6f0ec;
  }
  #ski-{{ section.id }} .ski__img { border-radius: 10px; overflow: hidden; aspect-ratio: 1; background: #f4f1ee; }
  #ski-{{ section.id }} .ski__img img { display: block; width: 100%; height: 100%; object-fit: cover; }
  #ski-{{ section.id }} .ski__n { font: 700 12.5px/1 'Montserrat', sans-serif; color: var(--ski-ink); }
  #ski-{{ section.id }} .ski__name { margin: 0 0 8px; font: 700 20px/1.25 'Montserrat', sans-serif; }
  #ski-{{ section.id }} .ski__use-h { margin: 12px 0 4px; font: 700 13px/1 'Montserrat', sans-serif; }
  #ski-{{ section.id }} .ski__use { margin: 0; font: 400 14px/1.55 'Montserrat', sans-serif; color: var(--ski-muted); }
  #ski-{{ section.id }} .ski__link { display: inline-block; margin-top: 12px; font: 700 13.5px/1 'Montserrat', sans-serif; color: var(--ski-ink); text-decoration: underline; text-underline-offset: 4px; }
  #ski-{{ section.id }} .ski__link:focus-visible { outline: 2px solid var(--ski-text); outline-offset: 3px; border-radius: 4px; }
  #ski-{{ section.id }} .ski__note { margin: 22px 0 0; font: 500 13.5px/1.5 'Montserrat', sans-serif; color: var(--ski-muted); }
  @media (max-width: 599px) {
    #ski-{{ section.id }} { padding-bottom: 44px; }
    #ski-{{ section.id }} .ski__inner { padding-top: 32px; }
    #ski-{{ section.id }} .ski__grid { grid-template-columns: minmax(0, 1fr); }
    #ski-{{ section.id }} .ski__card { grid-template-columns: 104px minmax(0, 1fr); gap: 14px; padding: 12px; border-radius: 18px; }
    #ski-{{ section.id }} .ski__name { font-size: 17px; }
  }
  @media (min-width: 1680px) { #ski-{{ section.id }} .ski__inner { zoom: 1.12; } }
  @media (min-width: 1920px) { #ski-{{ section.id }} .ski__inner { zoom: 1.25; } }
  @media (min-width: 2560px) { #ski-{{ section.id }} .ski__inner { zoom: 1.65; } }
</style>

<section id="ski-{{ section.id }}" class="ski">
  <div class="ski__inner">
    <h2 class="ski__heading">{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}<p class="ski__sub">{{ section.settings.subheading }}</p>{%- endif -%}
    <div class="ski__grid">
      {%- for h in handles -%}
        {%- liquid
          assign p = all_products[h]
          assign name = p.title | split: ' - ' | first | split: ' | ' | first | split: ' (' | first | strip
          capture use
            render 'sehat-facts', handle: p.handle, field: 'use'
          endcapture
          assign use = use | strip
          if use == ''
            assign use = p.metafields.custom.short_use.value | default: ''
          endif
          if use == '' and p.description contains '[how_to_use]'
            assign use_raw = p.description | split: '[how_to_use]' | last | split: '[/how_to_use]' | first | strip_html | strip
            assign sentences = use_raw | split: '. '
            comment
              The first sentence that says how to take it; else the first real sentence.
            endcomment
            for sn in sentences
              assign sn_low = sn | downcase
              if sn_low contains 'take' or sn_low contains 'drops' or sn_low contains 'tablet'
                assign use = sn | strip | truncatewords: 24 | append: '.' | replace: '..', '.'
                break
              endif
            endfor
            if use == ''
              assign use = sentences | first | strip | truncatewords: 24
            endif
          endif
        -%}
        <article class="ski__card">
          <div class="ski__img">
            {%- if p.featured_image != blank -%}
              <img src="{{ p.featured_image | image_url: width: 400 }}" alt="{{ p.featured_image.alt | default: name | escape }}" loading="lazy" width="400" height="400">
            {%- endif -%}
          </div>
          <div>
            <h3 class="ski__name">{{ name }}</h3>
            {%- if use != '' -%}
              <p class="ski__use">{{ use }}</p>
            {%- endif -%}
            <a class="ski__link" href="{{ p.url }}">{{ section.settings.link_label }}<span class="visually-hidden"> about {{ name }}</span></a>
          </div>
        </article>
      {%- endfor -%}
    </div>
    {%- if section.settings.note != blank -%}<p class="ski__note">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "sehatUP kit items",
  "tag": "div",
  "class": "section-sehat-kit-items",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What's in your kit" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "use_label", "label": "Label above the instructions", "default": "How to take it" },
    { "type": "text", "id": "link_label", "label": "Link text", "default": "See details" },
    { "type": "text", "id": "note", "label": "Note under the items" },
    { "type": "range", "id": "max_items", "label": "Most items to show", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "color", "id": "accent_color", "label": "Accent colour", "default": "#d81f48" }
  ],
  "presets": [{ "name": "sehatUP kit items" }]
}
{% endschema %}
