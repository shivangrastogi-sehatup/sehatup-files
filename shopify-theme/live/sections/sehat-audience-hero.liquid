{%- comment -%}
  Banner hero for an audience page (For Him, For Her). Full width: the
  person (with the product) stands large on the right, the message sits on
  the left. It opens with reassurance, not a sales line: the problem is
  common, and it is treatable.
  Colours: the store palette only (brand red, charcoal, white, warm stone).
{%- endcomment -%}

{%- assign s = section.settings -%}

{%- comment -%} Styles first, so the browser never paints this section unstyled. {%- endcomment -%}
<style>
  #sah-{{ section.id }} {
    --sah-text: #1d1d1d; --sah-muted: #4f4a46;
    --sah-ink: {{ s.accent_color | color_darken: 8 }};
    position: relative; overflow: hidden; isolation: isolate;
    background: linear-gradient(105deg, #f7f1ec 0%, #f1e7df 55%, #e9dcd1 100%);
    font-family: 'Montserrat', sans-serif; color: var(--sah-text);
  }
  #sah-{{ section.id }} * { box-sizing: border-box; }
  /* Quiet texture: the old banner's diamond grid, in stone, fading out. */
  #sah-{{ section.id }}::before {
    content: ""; position: absolute; inset: 0; z-index: -1;
    background-image: repeating-linear-gradient(35deg, rgba(255, 255, 255, .55) 0 1.5px, transparent 1.5px 46px), repeating-linear-gradient(-35deg, rgba(255, 255, 255, .55) 0 1.5px, transparent 1.5px 46px);
    -webkit-mask-image: linear-gradient(90deg, transparent 30%, #000 85%); mask-image: linear-gradient(90deg, transparent 30%, #000 85%);
  }
  #sah-{{ section.id }} .sah__inner {
    position: relative; max-width: 1320px; margin: 0 auto; min-height: clamp(460px, 42vw, 600px);
    padding: clamp(36px, 5vw, 72px) clamp(16px, 3vw, 48px);
    display: flex; align-items: center;
  }
  #sah-{{ section.id }} .sah__copy { position: relative; z-index: 2; width: min(100%, 560px); }
  #sah-{{ section.id }} .sah__kicker { margin: 0 0 16px; font: 700 15px/1.3 'Montserrat', sans-serif; color: var(--sah-ink); }
  #sah-{{ section.id }} .sah__heading { margin: 0; font: 800 clamp(34px, 4.2vw, 58px)/1.04 'Montserrat', sans-serif; letter-spacing: -.025em; text-wrap: balance; }
  #sah-{{ section.id }} .sah__sub { margin: 18px 0 0; max-width: 30em; font: 500 clamp(15.5px, 1.2vw, 18px)/1.6 'Montserrat', sans-serif; color: var(--sah-muted); }
  #sah-{{ section.id }} .sah__btns { margin-top: 28px; display: flex; flex-wrap: wrap; gap: 12px; }
  #sah-{{ section.id }} .sah__btn {
    display: inline-flex; align-items: center; justify-content: center; min-height: 54px; padding: 0 28px; border-radius: 999px;
    border: 1.5px solid var(--sah-ink); font: 700 15.5px/1 'Montserrat', sans-serif; text-decoration: none;
    transition: background-color .2s ease, color .2s ease, transform .1s ease;
  }
  #sah-{{ section.id }} .sah__btn--solid { background: var(--sah-ink); color: #fff; }
  #sah-{{ section.id }} .sah__btn--solid:hover { background: #b3123a; border-color: #b3123a; }
  #sah-{{ section.id }} .sah__btn--ghost { background: rgba(255, 255, 255, .7); color: var(--sah-ink); }
  #sah-{{ section.id }} .sah__btn--ghost:hover { background: #fff; }
  #sah-{{ section.id }} .sah__btn:active { transform: translateY(1px); }
  #sah-{{ section.id }} .sah__btn:focus-visible { outline: 2px solid var(--sah-text); outline-offset: 3px; }
  #sah-{{ section.id }} .sah__note { margin: 18px 0 0; font: 500 13.5px/1.4 'Montserrat', sans-serif; color: var(--sah-muted); }
  #sah-{{ section.id }} .sah__note b { color: var(--sah-text); }

  /* The person: large, standing on the bottom edge, on the right. */
  #sah-{{ section.id }} .sah__person { position: absolute; z-index: 1; right: clamp(-40px, -1vw, 0px); bottom: 0; height: 100%; width: 62%; pointer-events: none; }
  #sah-{{ section.id }} .sah__person img { position: absolute; right: 0; bottom: 0; height: 100%; width: auto; max-width: none; object-fit: contain; object-position: right bottom; }

  @media (max-width: 849px) {
    #sah-{{ section.id }} .sah__inner { display: block; min-height: 0; padding: 0 16px 32px; }
    #sah-{{ section.id }}::before { -webkit-mask-image: linear-gradient(180deg, #000 0, transparent 45%); mask-image: linear-gradient(180deg, #000 0, transparent 45%); }
    #sah-{{ section.id }} .sah__person { position: relative; right: auto; width: auto; height: auto; margin: 0 -16px; aspect-ratio: 16 / 10; }
    #sah-{{ section.id }} .sah__person img { right: 0; height: 100%; }
    #sah-{{ section.id }} .sah__copy { width: 100%; padding-top: 22px; }
    #sah-{{ section.id }} .sah__btn { flex: 1 1 100%; }
  }
  @media (prefers-reduced-motion: reduce) { #sah-{{ section.id }} * { transition: none !important; } }
  @media (min-width: 1680px) { #sah-{{ section.id }} .sah__copy { zoom: 1.12; } }
  @media (min-width: 1920px) { #sah-{{ section.id }} .sah__copy { zoom: 1.25; } }
  @media (min-width: 2560px) { #sah-{{ section.id }} .sah__copy { zoom: 1.6; } }
</style>

<section id="sah-{{ section.id }}" class="sah">
  <div class="sah__inner">
    {%- if s.image_asset != blank -%}
      <div class="sah__person" aria-hidden="true">
        <img src="{{ s.image_asset | asset_url }}" alt="" loading="eager" fetchpriority="high" width="1440" height="810">
      </div>
    {%- elsif s.image != blank -%}
      <div class="sah__person" aria-hidden="true">
        <img src="{{ s.image | image_url: width: 1400 }}" srcset="{{ s.image | image_url: width: 800 }} 800w, {{ s.image | image_url: width: 1400 }} 1400w, {{ s.image | image_url: width: 2000 }} 2000w" sizes="(max-width: 849px) 100vw, 62vw" alt="" loading="eager" fetchpriority="high" width="{{ s.image.width }}" height="{{ s.image.height }}">
      </div>
    {%- endif -%}
    <div class="sah__copy">
      {%- if s.kicker != blank -%}<p class="sah__kicker">{{ s.kicker }}</p>{%- endif -%}
      <h1 class="sah__heading">{{ s.heading }}</h1>
      {%- if s.subheading != blank -%}<p class="sah__sub">{{ s.subheading }}</p>{%- endif -%}
      <div class="sah__btns">
        {%- if s.button_1_text != blank -%}<a class="sah__btn sah__btn--solid" href="{{ s.button_1_link | default: '#' }}">{{ s.button_1_text }}</a>{%- endif -%}
        {%- if s.button_2_text != blank -%}<a class="sah__btn sah__btn--ghost" href="{{ s.button_2_link | default: '#' }}">{{ s.button_2_text }}</a>{%- endif -%}
      </div>
      {%- if s.note != blank -%}<p class="sah__note">{{ s.note }}</p>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "sehatUP audience hero",
  "tag": "div",
  "class": "section-sehat-audience-hero",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small line above the heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You're not the only one." },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "image_picker", "id": "image", "label": "Person (transparent PNG, standing on the bottom edge)" },
    { "type": "text", "id": "image_asset", "label": "Or a theme asset file name", "info": "Used instead of the picked image when set, e.g. for-him-hero-warm.webp" },
    { "type": "text", "id": "button_1_text", "label": "Main button text", "default": "Take the free Health Score" },
    { "type": "url", "id": "button_1_link", "label": "Main button link" },
    { "type": "text", "id": "button_2_text", "label": "Second button text", "default": "See the products" },
    { "type": "text", "id": "button_2_link", "label": "Second button link", "info": "A page link, or #name to jump to a section on this page." },
    { "type": "text", "id": "note", "label": "Small line under the buttons" },
    { "type": "color", "id": "accent_color", "label": "Accent colour", "default": "#d81f48" }
  ],
  "presets": [{ "name": "sehatUP audience hero" }]
}
{% endschema %}
