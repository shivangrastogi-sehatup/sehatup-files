{%- comment -%}
  About Us opening. Left: small line, heading (second line in red), lead
  paragraph and the "In this story" contents in two short columns (links
  jump to the chapter sections, #ch-01, #ch-02...). Right: the two founders
  as equal portraits with captions. Under 990px everything stacks; on phones
  the contents become a swipe row of chapter links.
  Contents: one "01|Chapter title" per line, matching each chapter's number.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign rows = s.contents | newline_to_br | split: '<br />'
-%}
<style>
  #aeo-{{ section.id }} {
    --ink: #1d1d1d; --mute: #5f5a56; --line: #e8e0d9; --stone: #f6f0ec; --btn: #d81f48;
    padding: clamp(32px, 4vw, 64px) clamp(16px, 4vw, 48px) clamp(24px, 3vw, 48px); background: #fff; color: var(--ink); font-family: 'Montserrat', sans-serif;
  }
  #aeo-{{ section.id }} .aeo__in { max-width: 1160px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 72px); align-items: center; }
  #aeo-{{ section.id }} .aeo__kick { margin: 0 0 14px; font: 700 15px/1.3 'Montserrat', sans-serif; color: var(--btn); }
  #aeo-{{ section.id }} .aeo__h { margin: 0 0 18px; font: 800 clamp(32px, 3.4vw, 48px)/1.12 'Montserrat', sans-serif; letter-spacing: -.025em; color: var(--ink); }
  #aeo-{{ section.id }} .aeo__h span { display: block; color: var(--btn); }
  #aeo-{{ section.id }} .aeo__lead p { margin: 0 0 12px; max-width: 34em; font: 400 17px/1.65 'Montserrat', sans-serif; color: var(--mute); text-wrap: pretty; }
  #aeo-{{ section.id }} .aeo__lead p:last-child { margin: 0; }
  #aeo-{{ section.id }} .aeo__lead strong { color: var(--ink); font-weight: 700; }

  #aeo-{{ section.id }} .aeo__toc { margin-top: 28px; }
  #aeo-{{ section.id }} .aeo__toc > p { margin: 0 0 6px; font: 700 14px/1.2 'Montserrat', sans-serif; color: var(--ink); }
  #aeo-{{ section.id }} .aeo__toc ol { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 28px; margin: 0; padding: 0; list-style: none; }
  #aeo-{{ section.id }} .aeo__toc a { display: flex; gap: 12px; align-items: baseline; padding: 9px 0; border-bottom: 1px solid var(--line); font: 600 14.5px/1.35 'Montserrat', sans-serif; color: var(--ink); text-decoration: none; transition: color .2s; }
  #aeo-{{ section.id }} .aeo__toc a i { font-style: normal; font-weight: 700; font-size: 12.5px; color: var(--btn); font-variant-numeric: tabular-nums; }
  @media (hover: hover) { #aeo-{{ section.id }} .aeo__toc a:hover { color: var(--btn); } }
  #aeo-{{ section.id }} .aeo__toc a:focus-visible { outline: 2px solid var(--btn); outline-offset: 2px; }

  #aeo-{{ section.id }} .aeo__people { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; max-width: 440px; margin: 0; justify-self: end; width: 100%; }
  #aeo-{{ section.id }} .aeo__people img { display: block; width: 100%; aspect-ratio: 4 / 5; height: auto; object-fit: cover; object-position: center 15%; border-radius: 18px; background: var(--stone); }
  #aeo-{{ section.id }} .aeo__people b { display: block; margin-top: 10px; font: 700 14.5px/1.3 'Montserrat', sans-serif; }
  #aeo-{{ section.id }} .aeo__people span { display: block; margin-top: 2px; font: 500 13px/1.35 'Montserrat', sans-serif; color: var(--mute); }

  @media (max-width: 989.98px) {
    #aeo-{{ section.id }} .aeo__in { grid-template-columns: minmax(0, 1fr); }
    #aeo-{{ section.id }} .aeo__people { justify-self: start; max-width: 400px; }
  }
  @media (max-width: 749.98px) {
    #aeo-{{ section.id }} .aeo__kick { margin-bottom: 10px; font-size: 13.5px; }
    #aeo-{{ section.id }} .aeo__h { font-size: clamp(28px, 8vw, 34px); }
    #aeo-{{ section.id }} .aeo__lead p { font-size: 15.5px; }
    #aeo-{{ section.id }} .aeo__toc ol { display: flex; gap: 8px; overflow-x: auto; margin: 4px -16px 0; padding: 0 16px 4px; scrollbar-width: none; }
    #aeo-{{ section.id }} .aeo__toc ol::-webkit-scrollbar { display: none; }
    #aeo-{{ section.id }} .aeo__toc li { flex: none; }
    #aeo-{{ section.id }} .aeo__toc a { padding: 9px 14px; border: 1px solid var(--line); border-radius: 999px; font-size: 13px; white-space: nowrap; }
    #aeo-{{ section.id }} .aeo__people { max-width: none; gap: 10px; }
    #aeo-{{ section.id }} .aeo__people img { border-radius: 14px; }
  }
  @media (min-width: 1680px) { #aeo-{{ section.id }} .aeo__in { zoom: 1.12; } }
  @media (min-width: 1920px) { #aeo-{{ section.id }} .aeo__in { zoom: 1.25; } }
  @media (min-width: 2560px) { #aeo-{{ section.id }} .aeo__in { zoom: 1.65; } }
  @media (min-width: 3200px) { #aeo-{{ section.id }} .aeo__in { zoom: 2; } }
</style>

<section id="aeo-{{ section.id }}">
  <div class="aeo__in">
    <div>
      {%- if s.kicker != blank -%}<p class="aeo__kick">{{ s.kicker }}</p>{%- endif -%}
      <h1 class="aeo__h">{{ s.heading }}{%- if s.heading_red != blank -%} <span>{{ s.heading_red }}</span>{%- endif -%}</h1>
      <div class="aeo__lead">{{ s.lead }}</div>
      {%- if s.contents != blank -%}
        <nav class="aeo__toc" aria-label="{{ s.contents_label | escape }}">
          <p>{{ s.contents_label }}</p>
          <ol>
            {%- for r in rows -%}
              {%- assign parts = r | strip | split: '|' -%}
              {%- if parts.size > 1 -%}<li><a href="#ch-{{ parts[0] | strip }}"><i>{{ parts[0] | strip }}</i>{{ parts[1] | strip }}</a></li>{%- endif -%}
            {%- endfor -%}
          </ol>
        </nav>
      {%- endif -%}
    </div>

    {%- if s.photo != blank or s.photo_2 != blank -%}
      <div class="aeo__people">
        {%- if s.photo != blank -%}
          <figure style="margin: 0">
            {{ s.photo | image_url: width: 500 | image_tag: alt: s.photo_name, loading: 'eager', widths: '220, 360, 500', sizes: '(max-width: 749.98px) 45vw, 210px' }}
            <figcaption><b>{{ s.photo_name }}</b>{%- if s.photo_role != blank -%}<span>{{ s.photo_role }}</span>{%- endif -%}</figcaption>
          </figure>
        {%- endif -%}
        {%- if s.photo_2 != blank -%}
          <figure style="margin: 0">
            {{ s.photo_2 | image_url: width: 500 | image_tag: alt: s.photo_2_name, loading: 'eager', widths: '220, 360, 500', sizes: '(max-width: 749.98px) 45vw, 210px' }}
            <figcaption><b>{{ s.photo_2_name }}</b>{%- if s.photo_2_role != blank -%}<span>{{ s.photo_2_role }}</span>{%- endif -%}</figcaption>
          </figure>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "About: editorial opening",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small line above", "default": "About sehatUP" },
    { "type": "text", "id": "heading", "label": "Heading, line 1", "default": "Not short of medicine." },
    { "type": "text", "id": "heading_red", "label": "Heading, line 2 (red)", "default": "Short of direction." },
    { "type": "richtext", "id": "lead", "label": "Lead paragraph", "info": "Bold text shows darker." },
    { "type": "text", "id": "contents_label", "label": "Contents title", "default": "In this story" },
    { "type": "textarea", "id": "contents", "label": "Contents", "info": "One per line: 01|Chapter title. The number must match the chapter's number so the link jumps to it." },
    { "type": "header", "content": "Founders" },
    { "type": "image_picker", "id": "photo", "label": "Portrait 1" },
    { "type": "text", "id": "photo_name", "label": "Name 1" },
    { "type": "text", "id": "photo_role", "label": "Role 1" },
    { "type": "image_picker", "id": "photo_2", "label": "Portrait 2" },
    { "type": "text", "id": "photo_2_name", "label": "Name 2" },
    { "type": "text", "id": "photo_2_role", "label": "Role 2" }
  ],
  "presets": [{ "name": "About: editorial opening" }]
}
{% endschema %}
