<section
  class="conditions-section"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background: {{ section.settings.background }};"
>
  <div class="conditions-container">
    {% if section.settings.heading != blank %}
      <h2
        class="conditions-heading"
        style="font-size: clamp(24px,3.4vw,64px); font-weight: {{ section.settings.title_font_weight }}; color: {{ section.settings.title_color }}; text-align: {{ section.settings.title_alignment }}; letter-spacing: {{ section.settings.title_letter_spacing }}px;"
      >
        {{ section.settings.heading }}
      </h2>
    {% endif -%}
    {%- if section.settings.description != blank %}
      <p
        class="conditions-description"
        style="font-size: clamp(15px, 1.2vw, 20px); color: {{ section.settings.paragraph_color }}; line-height: {{ section.settings.paragraph_line_height }}; text-align: {{ section.settings.paragraph_alignment }};"
      >
        {{ section.settings.description }}
      </p>
    {% endif %}
    <div class="conditions-featured-grid" data-row="featured">
      {% for block in section.blocks -%}
        {%- if block.settings.layout_type == 'featured' %}
          <div
            class="condition-card featured"
            style="background: {{ block.settings.bg_color }};"
            {{ block.shopify_attributes }}
          >
            {% if block.settings.icon %}
              <div
                class="condition-icon-wrap {% if block.settings.icon_circle %}has-circle{% endif %}"
                style="{% if block.settings.icon_circle %}--circle-bg: {{ block.settings.icon_circle_color }}; --circle-opacity: {{ block.settings.icon_circle_opacity | divided_by: 100.0 }};{% endif %}"
              >
                <img
                  src="{{ block.settings.icon | image_url: width: 220 }}"
                  alt="{{ block.settings.title | escape }}"
                  width="{{ block.settings.icon.width }}"
                  height="{{ block.settings.icon.height }}"
                  loading="lazy"
                  decoding="async"
                >
              </div>
            {% endif -%}
            {%- if block.settings.title != blank %}
              <h3
                class="condition-title"
                style="font-size: clamp(14px, 2vw, 35px); font-weight: {{ block.settings.title_font_weight }}; font-style: {{ block.settings.title_font_style }}; color: {{ block.settings.title_color }};"
              >
                {{ block.settings.title }}
              </h3>
            {% endif -%}
            {%- if block.settings.text != blank %}
              <p
                class="condition-text"
                style="font-size: clamp(14px, 1.2vw, 24px); font-weight: {{ block.settings.text_font_weight }}; font-style: {{ block.settings.text_font_style }}; color: {{ block.settings.text_color }};"
              >
                {{ block.settings.text }}
              </p>
            {% endif %}
          </div>
        {% endif -%}
      {%- endfor %}
    </div>
    <div class="cond-swipe" data-rail="featured" hidden>
      <div class="cond-dots" role="tablist" aria-label="Choose a condition"></div>
      <p class="cond-hint"><span aria-hidden="true">&#8592;</span> Swipe to see more <span aria-hidden="true">&#8594;</span></p>
    </div>
    <div class="conditions-normal-grid" data-row="normal">
      {% for block in section.blocks -%}
        {%- if block.settings.layout_type == 'normal' %}
          <div class="condition-card normal" {{ block.shopify_attributes }}>
            {% if block.settings.icon %}
              <div
                class="condition-icon-wrap {% if block.settings.icon_circle %}has-circle{% endif %}"
                style="{% if block.settings.icon_circle %}--circle-bg: {{ block.settings.icon_circle_color }}; --circle-opacity: {{ block.settings.icon_circle_opacity | divided_by: 100.0 }};{% endif %}"
              >
                <img
                  src="{{ block.settings.icon | image_url: width: 220 }}"
                  alt="{{ block.settings.title | escape }}"
                  width="{{ block.settings.icon.width }}"
                  height="{{ block.settings.icon.height }}"
                  loading="lazy"
                  decoding="async"
                >
              </div>
            {% endif -%}
            {%- if block.settings.title != blank %}
              <h4
                class="condition-title"
                style="font-size: clamp(14px, 2vw, 35px); font-weight: {{ block.settings.title_font_weight }}; font-style: {{ block.settings.title_font_style }}; color: {{ block.settings.title_color }};"
              >
                {{ block.settings.title }}
              </h4>
            {% endif -%}
            {%- if block.settings.text != blank %}
              <p
                class="condition-text"
                style="font-size: clamp(14px, 1.2vw, 24px); font-weight: {{ block.settings.text_font_weight }}; font-style: {{ block.settings.text_font_style }}; color: {{ block.settings.text_color }};"
              >
                {{ block.settings.text }}
              </p>
            {% endif %}
          </div>
        {% endif -%}
      {%- endfor %}
    </div>
    <div class="cond-swipe" data-rail="normal" hidden>
      <div class="cond-dots" role="tablist" aria-label="Choose a condition"></div>
      <p class="cond-hint"><span aria-hidden="true">&#8592;</span> Swipe to see more <span aria-hidden="true">&#8594;</span></p>
    </div>
    {% if section.settings.show_cta_section %}
      <div
        class="conditions-cta-section"
        style="background: {{ section.settings.cta_bg_color }}; box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.3); border: 0.5px solid #D8D8D8; border-radius: {{ section.settings.cta_border_radius }}px; padding: {{ section.settings.cta_padding_vertical }}px {{ section.settings.cta_padding_horizontal }}px; margin-top: {{ section.settings.cta_margin_top }}px;"
      >
        <div class="cta-content-wrapper">
          {% if section.settings.cta_text != blank %}
            <p
              class="cta-text"
              style="font-size: clamp(14px, 1.2vw, 24px); font-weight: {{ section.settings.cta_text_weight }}; color: {{ section.settings.cta_text_color }}; margin: 0;"
            >
              {{ section.settings.cta_text }}
            </p>
          {% endif -%}
          {%- if section.settings.cta_button_text != blank -%}
            <a
              href="{% if section.settings.cta_button_url != blank %}{{ section.settings.cta_button_url }}{% else %}#{% endif %}"
              class="cta-button"
              style="background: {{ section.settings.cta_button_bg }}; color: {{ section.settings.cta_button_color }}; font-size: clamp(10px, 1vw, 20px); font-weight: {{ section.settings.cta_button_text_weight }}; padding: {{ section.settings.cta_button_padding_vertical }}px {{ section.settings.cta_button_padding_horizontal }}px; border-radius: {{ section.settings.cta_button_border_radius }}px; display: inline-flex; align-items: center; gap: 8px; text-decoration: none; transition: all 0.3s ease; white-space: nowrap;"
            >
              {{- section.settings.cta_button_text -}}
              {%- if section.settings.cta_button_show_arrow %}
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M3.33334 8H12.6667M12.6667 8L8.00001 3.33334M12.6667 8L8.00001 12.6667" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {% endif -%}
            </a>
          {%- endif %}
        </div>
      </div>
    {% endif -%}
    {%- if section.settings.show_explore_button %}
      <div class="explore-button-wrapper" style="margin-top: {{ section.settings.explore_button_margin_top }}px;">
        {% if section.settings.explore_button_text != blank -%}
          <a
            href="{% if section.settings.explore_button_url != blank %}{{ section.settings.explore_button_url }}{% else %}#{% endif %}"
            class="explore-button"
            style="background: {{ section.settings.explore_button_bg }}; color: {{ section.settings.explore_button_color }}; font-weight: {{ section.settings.explore_button_text_weight }}; padding: {{ section.settings.explore_button_padding_vertical }}px {{ section.settings.explore_button_padding_horizontal }}px; border-radius: {{ section.settings.explore_button_border_radius }}px; border: {{ section.settings.explore_button_border_width }}px solid {{ section.settings.explore_button_border_color }}; display: inline-block; text-decoration: none; transition: all 0.3s ease;"
          >
            {{- section.settings.explore_button_text -}}
          </a>
        {%- endif %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  .conditions-container{max-width:1400px;margin:0 auto;padding:0 16px;text-align:center}.conditions-description{max-width:980px;margin:0 auto 48px}.conditions-featured-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-bottom:40px}.conditions-normal-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:20px;margin-bottom:40px}.condition-card{border-radius:16px;padding:24px;text-align:center;min-height:190px;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;transition:transform .2s ease,box-shadow .2s ease}.condition-card.normal,.condition-card.featured{background:#fff;box-shadow:0 6px 18px rgba(0,0,0,.06)}.condition-card:hover{transform:translateY(-4px);box-shadow:0 10px 24px rgba(0,0,0,.1)}.condition-icon-wrap{position:relative;display:inline-flex;align-items:center;justify-content:center;width:64px;height:64px;margin-bottom:14px}.condition-icon-wrap.has-circle::before{content:"";position:absolute;inset:0;border-radius:50%;background:var(--circle-bg);opacity:var(--circle-opacity);z-index:0}.condition-icon-wrap img{position:relative;z-index:1;max-width:60%}.conditions-cta-section{text-align:center;max-width:900px;margin-left:auto;margin-right:auto}.cta-content-wrapper{display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap}.cta-text{line-height:1.4;flex:0 0 auto}.cta-button{cursor:pointer;font-family:inherit;box-shadow:0 2px 8px rgba(241,47,70,0.25);flex-shrink:0}.cta-button:hover{opacity:0.92;transform:translateY(-2px);box-shadow:0 4px 14px rgba(241,47,70,0.35)}.explore-button-wrapper{text-align:center}.explore-button{cursor:pointer;font-family:inherit;box-shadow:0 1px 4px rgba(0,0,0,0.08)}.explore-button:hover{background:#f8f8f8!important;transform:translateY(-1px);box-shadow:0 2px 8px rgba(0,0,0,0.12)}@media(max-width:991px){.conditions-featured-grid,.conditions-normal-grid{display:flex;overflow-x:auto;gap:18px;padding-bottom:10px;scroll-snap-type:x mandatory}.conditions-featured-grid::-webkit-scrollbar,.conditions-normal-grid::-webkit-scrollbar{display:none}.condition-card{min-width:260px;flex:0 0 auto;scroll-snap-align:start}.conditions-cta-section{padding:28px 20px!important}.cta-content-wrapper{justify-content:center}}@media(max-width:575px){
  .condition-card{min-width:240px;padding:20px;border-radius:14px}
  .condition-icon-wrap{width:54px;height:54px;margin-bottom:12px}
  .condition-icon-wrap img{max-width:58%}
  .conditions-cta-section{padding:24px 16px!important;border-radius:12px!important}
  .cta-content-wrapper{flex-direction:column;gap:16px;text-align:center}
  .cta-text{font-size:17px!important}
  .cta-button{
    font-size:14px!important;
    padding:13px 24px!important;
    white-space:normal!important;
    max-width:100%;
    width:100%;
    text-align:center;
    line-height:1.4;
    min-height:auto;
    height:auto;
    display:inline-block;
  }
  .explore-button{font-size:14px!important;padding:11px 28px!important}
}


  /* ---- Phones: one card at a time, a peek of the next, and a progress row
     underneath. Both rows behave identically so the section reads as one
     thing rather than two different carousels. ---- */
  .cond-swipe { display: none; }

  /* Hover: the icon grows inside its circle and the card lifts, so the tile
     reads as a surface with something sitting on it. Pointer devices only,
     otherwise a tap on a phone leaves the card stuck in its hover state. */
  @media (hover: hover) {
    .condition-icon-wrap img { transition: transform .4s cubic-bezier(.22,.9,.3,1); }
    .condition-icon-wrap.has-circle::before { transition: transform .4s cubic-bezier(.22,.9,.3,1); }
    .condition-card:hover .condition-icon-wrap img { transform: scale(1.22); }
    .condition-card:hover .condition-icon-wrap.has-circle::before { transform: scale(1.08); }
    .condition-card:hover { box-shadow: 0 16px 30px -18px rgba(20, 24, 60, .35) !important; }
  }

  @media (max-width: 599px) {
    .conditions-section { background: #ffffff !important; padding-bottom: 44px !important; }
    .conditions-container { padding-inline: 0; }
    .conditions-heading { font-size: 30px !important; line-height: 1.12; letter-spacing: -.02em; padding-inline: 16px; }
    .conditions-description {
      font-size: 16px !important;   /* was clamping down to about 10px */
      line-height: 1.55 !important;
      margin: 14px 16px 26px !important;
      max-width: none;
    }

    .conditions-featured-grid,
    .conditions-normal-grid {
      display: flex;
      gap: 12px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      /* the side padding is what leaves a peek of the neighbouring card */
      padding: 4px 34px 8px;
      scroll-padding-inline: 34px;
      margin-bottom: 0;
      align-items: stretch;
    }
    .condition-card {
      flex: 0 0 calc(100% - 68px);
      min-width: 0;
      scroll-snap-align: center;
      background: #fdf3f5 !important;
      box-shadow: none !important;
      border-radius: 20px;
      padding: 22px 18px 24px;
      min-height: 0;
      justify-content: flex-start;
      gap: 4px;
    }
    .condition-card:hover { transform: none; box-shadow: none !important; }
    .condition-icon-wrap { width: 108px; height: 108px; margin-bottom: 16px; }
    .condition-icon-wrap img { max-width: 72%; }
    .condition-title { font-size: 20px !important; line-height: 1.25; margin: 0 0 6px; }
    .condition-text { font-size: 15.5px !important; line-height: 1.5; margin: 0; }

    /* progress row: a dot per card, then the hint */
    .cond-swipe { display: block; margin: 12px 0 26px; }
    .cond-dots { display: flex; justify-content: center; gap: 7px; }
    .cond-dot {
      width: 7px; height: 7px; padding: 0; border: 0; border-radius: 50%;
      background: #f0c3d0; cursor: pointer;
      transition: background .25s ease, width .25s ease;
    }
    .cond-dot[aria-selected="true"] { background: #ee204a; width: 20px; border-radius: 4px; }

    /* the card in the middle of the screen is the full size one */
    @supports (animation-timeline: view()) {
      @media (prefers-reduced-motion: no-preference) {
        .condition-card {
          animation: cond-center linear both;
          animation-timeline: view(inline);
          animation-range: cover 5% cover 95%;
        }
        @keyframes cond-center {
          0%, 100% { transform: scale(.95); opacity: .7; }
          50%      { transform: scale(1);   opacity: 1; }
        }
      }
    }
    .condition-card:active { transform: scale(.985); }
    .cta-button:active, .explore-button:active { transform: scale(.975); }
    .cond-hint {
      margin: 10px 0 0; text-align: center;
      color: #55555f; font-size: 14px; letter-spacing: .01em;
    }
    .cond-hint span { color: #1d1d1d; }

    .conditions-cta-section {
      background: #fdf3f5 !important;
      box-shadow: none !important;
      border: 0 !important;
      border-radius: 20px !important;
      margin-inline: 16px;
      padding: 22px 18px !important;
    }
    .cta-button { width: 100%; justify-content: center; }
    .explore-button-wrapper { padding-inline: 16px; margin-top: 16px !important; }
  }
</style>

<script>
  (() => {
    const root = document.getElementById("shopify-section-{{ section.id }}");
    if (!root) return;

    root.querySelectorAll(".cond-swipe").forEach((swipe) => {
      const row = root.querySelector('[data-row="' + swipe.dataset.rail + '"]');
      if (!row) return;
      const cards = [...row.children];
      if (cards.length < 2) return;

      swipe.hidden = false;
      const dots = swipe.querySelector(".cond-dots");
      cards.forEach((card, i) => {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "cond-dot";
        b.setAttribute("role", "tab");
        b.setAttribute("aria-label", "Condition " + (i + 1));
        b.addEventListener("click", () => {
          row.scrollTo({ left: card.offsetLeft - row.offsetLeft - 34, behavior: "smooth" });
        });
        dots.appendChild(b);
      });

      const marks = [...dots.children];
      let queued = false;
      const paint = () => {
        queued = false;
        const mid = row.scrollLeft + row.clientWidth / 2;
        let best = 0, bestGap = Infinity;
        cards.forEach((c, i) => {
          const gap = Math.abs(c.offsetLeft - row.offsetLeft + c.offsetWidth / 2 - mid);
          if (gap < bestGap) { bestGap = gap; best = i; }
        });
        marks.forEach((m, i) => m.setAttribute("aria-selected", i === best));
      };
      row.addEventListener("scroll", () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(paint);
      }, { passive: true });
      paint();
    });
  })();
</script>

