{%- comment -%}
  Meet the experts who review the Health Score together. Real photos, names
  and degrees come from the blocks; an empty photo shows a quiet initial
  instead of a stock face, and an empty degree is simply left out (never
  invented). Every photo sits on the same plain stone backdrop, so the three
  people read as one team.
  Desktop: three columns. Phones: a native swipe row with the next card
  peeking in (CSS scroll-snap, no script).
{%- endcomment -%}

{%- liquid
  assign s = section.settings
-%}

{%- comment -%} Styles first, so the browser never paints this section unstyled. {%- endcomment -%}
{{ 'sh-swipe.css' | asset_url | stylesheet_tag }}
<style>
  #hdr-{{ section.id }} {
    --hdr-text: #1d1d1d; --hdr-muted: #5c5c5c; --hdr-accent: {{ s.accent_color | color_darken: 8 }};
    --hdr-stone: #f3ece6;
    background: {{ s.background | default: '#faf7f5' }}; font-family: 'Montserrat', sans-serif; color: var(--hdr-text);
  }
  #hdr-{{ section.id }} .hdr__inner { max-width: 1320px; margin: 0 auto; padding: {{ s.padding_top | default: 88 }}px 24px {{ s.padding_bottom | default: 80 }}px; }
  #hdr-{{ section.id }} .hdr__head { max-width: none; margin: 0 auto 48px; text-align: center; }
  #hdr-{{ section.id }} .hdr__eyebrow { margin: 0 0 16px; font: 700 13px/1 'Montserrat', sans-serif; letter-spacing: .14em; text-transform: uppercase; color: var(--hdr-accent); }
  #hdr-{{ section.id }} .hdr__heading { color: var(--hdr-text); margin: 0 0 14px; font: 800 clamp(30px, 3.6vw, 52px)/1.06 'Montserrat', sans-serif; letter-spacing: -.02em; text-wrap: balance; }
  #hdr-{{ section.id }} .hdr__sub { margin: 0 auto; max-width: min(780px, 60vw); font: 400 17px/1.6 'Montserrat', sans-serif; color: var(--hdr-muted); text-wrap: pretty; }

  @media (min-width: 1100px) { #hdr-{{ section.id }} .hdr__row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; } }
  #hdr-{{ section.id }} .hdr__card {
    display: flex; flex-direction: column; border-radius: 24px; overflow: hidden; background: #fff;
    box-shadow: 0 1px 0 rgba(29, 29, 29, .04), 0 12px 32px rgba(29, 29, 29, .06);
    transition: transform .35s cubic-bezier(.16, 1, .3, 1), box-shadow .35s ease;
  }
  @media (hover: hover) and (pointer: fine) {
    #hdr-{{ section.id }} .hdr__card:hover { transform: translateY(-6px); box-shadow: 0 1px 0 rgba(29, 29, 29, .04), 0 22px 44px rgba(29, 29, 29, .1); }
  }
  #hdr-{{ section.id }} .hdr__photo {
    position: relative; aspect-ratio: 1 / 1; background: var(--hdr-stone);
    display: grid; place-items: end center; overflow: hidden;
  }
  /* Pinned to the box edges: Safari cannot resolve height: 100% on a grid child of an aspect-ratio box, so the photo grew to its own height and slid down. */
  #hdr-{{ section.id }} .hdr__photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; object-position: center bottom; }
  #hdr-{{ section.id }} .hdr__initial { align-self: center; font: 300 96px/1 'Montserrat', sans-serif; color: var(--hdr-muted); opacity: .35; }
  #hdr-{{ section.id }} .hdr__body { padding: 24px 28px 30px; display: grid; gap: 8px; }
  #hdr-{{ section.id }} .hdr__name { margin: 0; font: 700 clamp(19px, 1.6vw, 23px)/1.2 'Montserrat', sans-serif; color: var(--hdr-text); }
  #hdr-{{ section.id }} .hdr__top { display: grid; align-content: start; gap: 8px; }
  #hdr-{{ section.id }} .hdr__degree { margin: 0; font: 600 14.5px/1.45 'Montserrat', sans-serif; color: var(--hdr-muted); }
  #hdr-{{ section.id }} .hdr__role { margin: 8px 0 0; padding-top: 14px; border-top: 1px solid #eee6e0; font: 400 16px/1.55 'Montserrat', sans-serif; color: var(--hdr-muted); }
  #hdr-{{ section.id }} .hdr__cta { margin-top: 36px; display: flex; justify-content: center; }
  #hdr-{{ section.id }} .hdr__btn { display: inline-flex; align-items: center; gap: 10px; min-height: 54px; padding: 0 30px; border-radius: 999px; background: var(--hdr-accent); color: #fff; font: 700 16px/1 'Montserrat', sans-serif; text-decoration: none; box-shadow: 0 12px 26px -10px rgba(216, 31, 72, .55); transition: transform .2s ease, background-color .2s ease; }
  @media (hover: hover) { #hdr-{{ section.id }} .hdr__btn:hover { transform: translateY(-2px); background: {{ s.accent_color | color_darken: 16 }}; } }
  #hdr-{{ section.id }} .hdr__btn:focus-visible { outline: 2px solid var(--hdr-text); outline-offset: 3px; }
  #hdr-{{ section.id }} .hdr__btn svg { width: 19px; height: 19px; fill: currentColor; }
  #hdr-{{ section.id }} .hdr__btn--wa { background: #fff; color: var(--hdr-text); border: 1.5px solid #e0d6ce; box-shadow: 0 8px 22px -12px rgba(29, 29, 29, .25); }
  #hdr-{{ section.id }} .hdr__btn--wa .hdr__wa { width: 24px; height: 24px; }
  /* Filled button with a WhatsApp link: the icon goes white on the accent colour. */
  #hdr-{{ section.id }} .hdr__btn:not(.hdr__btn--wa) .hdr__wa path { fill: #fff; }
  @media (hover: hover) { #hdr-{{ section.id }} .hdr__btn--wa:hover { background: #fff; color: var(--hdr-text); border-color: #25D366; box-shadow: 0 12px 26px -12px rgba(37, 211, 102, .45); } }
  #hdr-{{ section.id }} .hdr__cta + .hdr__foot { margin-top: 14px; }
  #hdr-{{ section.id }} .hdr__foot { margin: 36px 0 0; text-align: center; font: 500 15px/1.5 'Montserrat', sans-serif; color: var(--hdr-muted); }

  /* Phones: swipe row, next card peeking in. */
  @media (max-width: 749.98px) {
    #hdr-{{ section.id }} .hdr__inner { padding: {{ s.padding_top | default: 88 | times: 0.64 | round }}px 0 {{ s.padding_bottom | default: 80 | times: 0.65 | round }}px; }
    #hdr-{{ section.id }} .hdr__head { padding: 0 16px; margin-bottom: 26px; }
    #hdr-{{ section.id }} .hdr__heading { font-size: 30px; }
    #hdr-{{ section.id }} .hdr__sub { font-size: 15px; max-width: none; }
    #hdr-{{ section.id }} .hdr__degree { font-size: 13.5px; }
    #hdr-{{ section.id }} .hdr__body { padding: 20px 20px 24px; }
    /* Phones: the qualification line and its divider go; the name and photo stay. */
    #hdr-{{ section.id }} .hdr__role, body #MainContent #hdr-{{ section.id }} .hdr__role { display: none !important; }
    #hdr-{{ section.id }} .hdr__name { font-size: 19px; }
    #hdr-{{ section.id }} .hdr__role { font-size: 14px; }
    #hdr-{{ section.id }} .hdr__cta { margin-top: 18px; padding: 0 16px; }
    #hdr-{{ section.id }} .hdr__btn { width: 100%; justify-content: center; text-align: center; text-wrap: balance; line-height: 1.25; padding-top: 12px; padding-bottom: 12px; height: auto; min-height: 54px; }
    #hdr-{{ section.id }} .hdr__foot { padding: 0 16px; margin-top: 18px; font-size: 13.5px; }
  }
  @media (min-width: 750px) and (max-width: 1099.98px) {
    #hdr-{{ section.id }} .hdr__inner { padding-left: 0; padding-right: 0; }
    #hdr-{{ section.id }} .hdr__head { padding: 0 24px; margin-bottom: 36px; }
    #hdr-{{ section.id }} .hdr__heading { font-size: 38px; }
    #hdr-{{ section.id }} .hdr__sub { font-size: 16px; max-width: min(520px, 50vw); }
    #hdr-{{ section.id }} .hdr__name { font-size: 21px; }
    #hdr-{{ section.id }} .hdr__cta { margin-top: 24px; }
  }
  @media (prefers-reduced-motion: reduce) { #hdr-{{ section.id }} .hdr__card { transition: none; } }

  /* Big screens: scale the whole section in proportion, so 1920-3840px
     monitors get a page sized for them instead of a 1200px island. */
  @media (min-width: 1680px) { #hdr-{{ section.id }} .hdr__inner { zoom: 1.12; } }
  @media (min-width: 1920px) { #hdr-{{ section.id }} .hdr__inner { zoom: 1.25; } }
  @media (min-width: 2240px) { #hdr-{{ section.id }} .hdr__inner { zoom: 1.45; } }
  @media (min-width: 2560px) { #hdr-{{ section.id }} .hdr__inner { zoom: 1.65; } }
  @media (min-width: 3200px) { #hdr-{{ section.id }} .hdr__inner { zoom: 2; } }
  @media (min-width: 3840px) { #hdr-{{ section.id }} .hdr__inner { zoom: 2.4; } }
  /* ...and the cards row gets a little wider at each step (about 88-90% of the screen). */
  @media (min-width: 1920px) { #hdr-{{ section.id }} .hdr__inner { max-width: 1360px; } }
  @media (min-width: 2560px) { #hdr-{{ section.id }} .hdr__inner { max-width: 1440px; } }
  /* Phones: text runs the full width. Headings wrap normally instead of being balanced into short lines, and intros lose their desktop width caps. */
  @media (max-width: 749.98px) { #hdr-{{ section.id }} .hdr__heading { text-wrap: wrap; } #hdr-{{ section.id }} .hdr__sub { max-width: none; text-wrap: wrap; } }
</style>

<section id="hdr-{{ section.id }}" class="hdr">
  <div class="hdr__inner">
    <div class="hdr__head">
      {%- if s.eyebrow != blank -%}<p class="hdr__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      <h2 class="hdr__heading">{{ s.heading }}</h2>
      {%- if s.subheading != blank -%}<p class="hdr__sub">{{ s.subheading }}</p>{%- endif -%}
    </div>

    <div class="hdr__row sh-swipe sh-swipe--tablet">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <article class="hdr__card" {{ block.shopify_attributes }}>
          <div class="hdr__photo">
            {%- if b.photo != blank -%}
              <img src="{{ b.photo | image_url: width: 700 }}"
                   srcset="{{ b.photo | image_url: width: 400 }} 400w, {{ b.photo | image_url: width: 700 }} 700w, {{ b.photo | image_url: width: 1000 }} 1000w, {{ b.photo | image_url: width: 1400 }} 1400w"
                   sizes="(max-width: 749.98px) 78vw, (max-width: 1099.98px) 42vw, 30vw"
                   alt="{{ b.name | escape }}" loading="lazy" width="700" height="{{ 700 | divided_by: b.photo.aspect_ratio | round }}">
            {%- else -%}
              <span class="hdr__initial" aria-hidden="true">{{ b.system | slice: 0 }}</span>
            {%- endif -%}
          </div>
          <div class="hdr__body">
            <div class="hdr__top">
              {%- if b.name != blank -%}<h3 class="hdr__name">{{ b.name }}</h3>{%- endif -%}
              {%- if b.degree != blank -%}<p class="hdr__degree">{{ b.degree }}</p>{%- endif -%}
            </div>
            {%- if b.role != blank -%}<p class="hdr__role">{{ b.role }}</p>{%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>

    {%- if s.button != blank -%}
      <div class="hdr__cta">
        <a class="hdr__btn{% if s.button_link contains 'wa.me' and s.button_style != 'filled' %} hdr__btn--wa{% endif %}" href="{{ s.button_link | default: '#' }}"{% if s.button_link contains 'wa.me' %} target="_blank" rel="noopener"{% endif %}>
          {%- if s.button_link contains 'wa.me' -%}<svg class="hdr__wa" viewBox="0 0 24 24" aria-hidden="true"><path fill="#25D366" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>{%- endif -%}
          {{ s.button }}
        </a>
      </div>
    {%- endif -%}
    {%- if s.footnote != blank -%}<p class="hdr__foot">{{ s.footnote }}</p>{%- endif -%}
  </div>
</section>


<script>
  (function () {
    var root = document.getElementById('hdr-{{ section.id }}');
    if (!root) return;
    var tops = [].slice.call(root.querySelectorAll('.hdr__top'));
    if (tops.length < 2) return;
    function even() {
      tops.forEach(function (t) { t.style.minHeight = ''; });
      var h = Math.max.apply(null, tops.map(function (t) { return t.offsetHeight; }));
      tops.forEach(function (t) { t.style.minHeight = h + 'px'; });
    }
    var raf;
    function soon() { cancelAnimationFrame(raf); raf = requestAnimationFrame(even); }
    even();
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(soon);
    window.addEventListener('load', soon);
    if ('ResizeObserver' in window) new ResizeObserver(soon).observe(root); else window.addEventListener('resize', soon);
  })();
</script>

{% schema %}
{
  "name": "Meet the doctors",
  "tag": "div",
  "class": "section-health-doctors",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Who reviews your Health Score" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three experts. One plan for you." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "An Ayurveda doctor, a Homeopathy doctor and a counselling psychologist look at your score together, so your plan cares for your body and your mind." },
    { "type": "text", "id": "footnote", "label": "Line under the cards", "default": "Talk to them in Hindi or English, on a call that suits you." },
    { "type": "text", "id": "button", "label": "Button", "info": "Leave empty for no button." },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "A wa.me link shows the WhatsApp icon." },
    { "type": "select", "id": "button_style", "label": "Button style", "default": "auto", "options": [
      { "value": "auto", "label": "White for WhatsApp links" },
      { "value": "filled", "label": "Filled, accent colour" }
    ] },
    { "type": "color", "id": "background", "label": "Background", "default": "#faf7f5" },
    { "type": "range", "id": "padding_top", "label": "Space above", "min": 16, "max": 120, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_bottom", "label": "Space below", "min": 16, "max": 120, "step": 4, "unit": "px", "default": 80 },
    { "type": "color", "id": "accent_color", "label": "Accent colour", "default": "#ee204a" }
  ],
  "blocks": [
    {
      "type": "doctor",
      "name": "Doctor",
      "settings": [
        { "type": "image_picker", "id": "photo", "label": "Photo", "info": "A real photo of the expert. Empty shows the first letter of the system." },
        { "type": "text", "id": "system", "label": "System", "default": "Ayurveda" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "degree", "label": "Degree / experience", "info": "e.g. BAMS, 5 years experience. Leave empty rather than guess." },
        { "type": "text", "id": "role", "label": "What they do for you", "default": "Looks for the root cause behind your symptoms." }
      ]
    }
  ],
  "presets": [{
    "name": "Meet the doctors",
    "blocks": [
      { "type": "doctor", "settings": { "system": "Ayurveda", "role": "Looks for the root cause behind your symptoms." } },
      { "type": "doctor", "settings": { "system": "Homeopathy", "role": "Gentle, long-term support for balance." } },
      { "type": "doctor", "settings": { "system": "Psychology", "role": "Helps with stress, mood and worries that affect your health." } }
    ]
  }]
}
{% endschema %}
