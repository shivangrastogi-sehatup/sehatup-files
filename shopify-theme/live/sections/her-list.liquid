{%- comment -%}
  For Her: the page's one layout, same as her-facts. Heading, lead and an
  optional button on the left; light rows on the right split by hairlines.
  Each row: a bold title (with a small label under it) and its text.
  Layout "strip": a centred heading, then the rows as one horizontal strip of
  short points, each with a small line icon (phones: a stacked list).
{%- endcomment -%}
{%- assign s = section.settings -%}
<style>
  #hls-{{ section.id }} {
    --hls-red: #ee204a; --hls-ink: #d81f48; --hls-text: #1d1d1d; --hls-muted: #5f5a56; --hls-line: #ece4de;
    padding: clamp(36px, 4.4vw, 64px) clamp(16px, 3vw, 48px); background: #fff; font-family: 'Montserrat', sans-serif; color: var(--hls-text);
  }
  #hls-{{ section.id }} * { box-sizing: border-box; }
  #hls-{{ section.id }} .hls__wrap { max-width: 1160px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(28px, 5vw, 80px); align-items: center; }
  #hls-{{ section.id }} h2 { margin: 0; font: 800 clamp(26px, 2.8vw, 36px)/1.15 'Montserrat', sans-serif; letter-spacing: -.02em; text-wrap: balance; }
  #hls-{{ section.id }} .hls__lead { margin: 12px 0 0; font: 500 15.5px/1.6 'Montserrat', sans-serif; color: var(--hls-muted); text-wrap: pretty; }
  #hls-{{ section.id }} .hls__btn { display: inline-flex; align-items: center; min-height: 50px; margin-top: 22px; padding: 0 26px; border-radius: 999px; background: var(--hls-red); color: #fff; font: 700 15px/1 'Montserrat', sans-serif; text-decoration: none; transition: background-color .2s ease; }
  #hls-{{ section.id }} .hls__btn:hover { background: var(--hls-ink); }
  #hls-{{ section.id }} .hls__note { margin: 14px 0 0; font: 500 13px/1.5 'Montserrat', sans-serif; color: var(--hls-muted); }

  #hls-{{ section.id }} .hls__row { display: grid; grid-template-columns: 190px minmax(0, 1fr); gap: 6px 24px; align-items: baseline; padding: 20px 0; }
  #hls-{{ section.id }} .hls__row + .hls__row { border-top: 1px solid var(--hls-line); }
  #hls-{{ section.id }} .hls__t { margin: 0; font: 800 18px/1.25 'Montserrat', sans-serif; letter-spacing: -.01em; color: var(--hls-text); }
  #hls-{{ section.id }} .hls__t small { display: block; margin-top: 6px; font: 700 11px/1.3 'Montserrat', sans-serif; letter-spacing: .12em; text-transform: uppercase; color: var(--hls-ink); }
  #hls-{{ section.id }} .hls__x { margin: 0; font: 500 15px/1.6 'Montserrat', sans-serif; color: var(--hls-muted); }
  #hls-{{ section.id }} .hls__x a { display: inline-block; margin-top: 6px; font-weight: 700; color: var(--hls-ink); text-decoration: underline; text-underline-offset: 4px; }
  #hls-{{ section.id }} a:focus-visible { outline: 2px solid var(--hls-text); outline-offset: 3px; }
  /* Strip layout */
  #hls-{{ section.id }}.hls--strip .hls__wrap { display: block; }
  #hls-{{ section.id }}.hls--strip .hls__head { max-width: 640px; margin: 0 auto clamp(24px, 3vw, 36px); text-align: center; }
  #hls-{{ section.id }}.hls--strip .hls__rows { display: grid; grid-template-columns: repeat({{ section.blocks.size | at_least: 1 }}, minmax(0, 1fr)); border-top: 1px solid var(--hls-line); border-bottom: 1px solid var(--hls-line); }
  #hls-{{ section.id }}.hls--strip .hls__row { display: block; padding: 24px clamp(14px, 2vw, 26px); border-top: 0; }
  #hls-{{ section.id }}.hls--strip .hls__row + .hls__row { border-left: 1px solid var(--hls-line); }
  #hls-{{ section.id }} .hls__ic { display: block; width: 28px; height: 28px; margin-bottom: 14px; fill: none; stroke: var(--hls-ink); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  #hls-{{ section.id }}.hls--strip .hls__t { font-size: 16.5px; }
  #hls-{{ section.id }}.hls--strip .hls__x { margin-top: 8px; font-size: 14px; }
  @media (max-width: 849px) {
    #hls-{{ section.id }}.hls--strip .hls__rows { grid-template-columns: 1fr; border-bottom: 0; }
    #hls-{{ section.id }}.hls--strip .hls__row { display: grid; grid-template-columns: 28px minmax(0, 1fr); gap: 4px 14px; padding: 18px 0; }
    #hls-{{ section.id }}.hls--strip .hls__row + .hls__row { border-left: 0; border-top: 1px solid var(--hls-line); }
    #hls-{{ section.id }}.hls--strip .hls__ic { grid-row: span 2; margin: 0; }
    #hls-{{ section.id }}.hls--strip .hls__x { margin-top: 0; grid-column: 2; }
  }
  @media (max-width: 849px) {
    #hls-{{ section.id }} .hls__wrap { grid-template-columns: 1fr; gap: 8px; }
    #hls-{{ section.id }} .hls__row { grid-template-columns: 1fr; padding: 18px 0; }
    #hls-{{ section.id }} .hls__btn { width: 100%; justify-content: center; }
  }
</style>

<section id="hls-{{ section.id }}"{% if s.layout == 'strip' %} class="hls--strip"{% endif %}>
  <div class="hls__wrap">
    <div class="hls__head">
      <h2>{{ s.heading }}</h2>
      {%- if s.lead != blank -%}<p class="hls__lead">{{ s.lead }}</p>{%- endif -%}
      {%- if s.button != blank -%}<a class="hls__btn" href="{{ s.button_link }}"{% if s.button_link contains 'wa.me' %} target="_blank" rel="noopener"{% endif %}>{{ s.button }}</a>{%- endif -%}
      {%- if s.note != blank -%}<p class="hls__note">{{ s.note }}</p>{%- endif -%}
    </div>
    <div class="hls__rows">
      {%- for b in section.blocks -%}
        {%- assign r = b.settings -%}
        <div class="hls__row" {{ b.shopify_attributes }}>
          {%- if s.layout == 'strip' -%}
            {%- case r.icon -%}
              {%- when 'doctor' -%}<svg class="hls__ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3v6a5 5 0 0 0 10 0V3"/><path d="M11 14v2a4 4 0 0 0 8 0v-2"/><circle cx="19" cy="12" r="2"/></svg>
              {%- when 'wallet' -%}<svg class="hls__ic" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="13" rx="2.5"/><path d="M3 10h18M16 14.5h2"/></svg>
              {%- when 'box' -%}<svg class="hls__ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 7.5 12 3l8.5 4.5v9L12 21l-8.5-4.5z"/><path d="M3.5 7.5 12 12l8.5-4.5M12 12v9"/></svg>
              {%- when 'chat' -%}<svg class="hls__ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v11H9l-5 4z"/><path d="M8 9.5h8M8 12.5h5"/></svg>
            {%- endcase -%}
          {%- endif -%}
          <p class="hls__t">{{ r.title }}{%- if r.tag != blank -%}<small>{{ r.tag }}</small>{%- endif -%}</p>
          <p class="hls__x">{{ r.text }}{%- if r.link_label != blank and r.link != blank -%}<br><a href="{{ r.link }}"{% if r.link contains 'wa.me' %} target="_blank" rel="noopener"{% endif %}>{{ r.link_label }}</a>{%- endif -%}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Her: list",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Heading" },
    { "type": "textarea", "id": "lead", "label": "Lead" },
    { "type": "text", "id": "button", "label": "Button" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "note", "label": "Small note" },
    { "type": "select", "id": "layout", "label": "Layout", "default": "rows", "options": [{ "value": "rows", "label": "Heading left, rows right" }, { "value": "strip", "label": "Centred heading, one strip" }] }
  ],
  "blocks": [
    {
      "type": "row", "name": "Row",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Title" },
        { "type": "text", "id": "tag", "label": "Small label under the title" },
        { "type": "select", "id": "icon", "label": "Icon (strip layout)", "default": "none", "options": [{ "value": "none", "label": "None" }, { "value": "doctor", "label": "Doctor" }, { "value": "wallet", "label": "Payment" }, { "value": "box", "label": "Parcel" }, { "value": "chat", "label": "Chat" }] },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "text", "id": "link_label", "label": "Link text" },
        { "type": "text", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Her: list" }]
}
{% endschema %}
