{% assign uid = section.id %}<section class="sehatUP-trust-strip-{{ uid }}"><div class="sts-container">{% if section.settings.main_heading != blank %}<h2 class="sts-main-heading">{{ section.settings.main_heading }}</h2>{% endif %}{% if section.settings.top_heading != blank %}<h2 class="sts-top-heading">{{ section.settings.top_heading }}</h2>{% endif %}<div class="sts-badges">{% for block in section.blocks %}<div class="sts-badge" {{ block.shopify_attributes }}><span class="sts-icon" style="color: {{ block.settings.icon_color }};">{% if block.settings.custom_icon != blank %}{{ block.settings.custom_icon }}{% else %}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z" fill="currentColor"/></svg>{% endif %}</span><span class="sts-text">{{ block.settings.badge_text }}</span></div>{% endfor %}</div>{% if section.settings.bottom_text != blank %}<p class="sts-bottom-text">{{ section.settings.bottom_text }}</p>{% endif %}</div></section>

<style>.sehatUP-trust-strip-{{ uid }}{padding:{{ section.settings.section_padding_top }}px 20px {{ section.settings.section_padding_bottom }}px;background:{{ section.settings.section_bg_color }}}.sts-container{min-width:800px;max-width:{{ section.settings.container_max_width }}px;margin:0 auto;text-align:center}.sts-main-heading{font-size:clamp(24px,3.4vw,64px);font-weight:{{ section.settings.main_heading_weight }};color:{{ section.settings.main_heading_color }};margin:0 0 {{ section.settings.main_heading_spacing }}px;letter-spacing:.3px;line-height:1.2}.sts-top-heading{font-size:clamp(14px, 1.5vw, 34px);font-weight:{{ section.settings.top_heading_weight }};color:{{ section.settings.top_heading_color }};margin:0 0 30px;letter-spacing:.3px}.sts-badges{display:flex;justify-content:center;align-items:center;gap:{{ section.settings.badge_gap }}px;flex-wrap:wrap;margin-bottom:30px}.sts-badge{display:inline-flex;align-items:center;gap:12px;background:{{ section.settings.badge_bg_color }};padding:{{ section.settings.badge_padding_vertical }}px {{ section.settings.badge_padding_horizontal }}px;border-radius:{{ section.settings.badge_border_radius }}px;box-shadow:0 2px 8px rgba(0,0,0,.08);font-size:clamp(13px,1vw,22px);color:{{ section.settings.badge_text_color }};font-weight:{{ section.settings.badge_font_weight }};transition:transform .2s ease,box-shadow .2s ease;white-space:nowrap}.sts-badge:hover{transform:translateY(-2px);box-shadow:0 4px 12px rgba(0,0,0,.12)}.sts-icon{display:flex;align-items:center;justify-content:center;flex-shrink:0;line-height:1}.sts-icon svg{width:{{ section.settings.icon_size }}px;height:{{ section.settings.icon_size }}px;display:block}.sts-text{line-height:1.4}.sts-bottom-text{font-size:clamp(14px, 1.5vw, 34px);font-weight:{{ section.settings.bottom_text_weight }};color:{{ section.settings.bottom_text_color }};margin:0;line-height:1.4;max-width:900px;margin-left:auto;margin-right:auto}@media (max-width:1024px){.sts-container{min-width:auto;padding:0 20px}.sts-main-heading{font-size:{{ section.settings.main_heading_size | minus:4 }}px}.sts-top-heading{font-size:{{ section.settings.top_heading_size | minus:2 }}px}.sts-badges{gap:{{ section.settings.badge_gap | minus:4 }}px}.sts-badge{font-size:{{ section.settings.badge_font_size | minus:1 }}px;padding:{{ section.settings.badge_padding_vertical | minus:2 }}px {{ section.settings.badge_padding_horizontal | minus:4 }}px}.sts-bottom-text{font-size:{{ section.settings.bottom_text_size | minus:2 }}px}}@media (max-width:767px){.sehatUP-trust-strip-{{ uid }}{padding:{{ section.settings.section_padding_top | minus:10 }}px 16px {{ section.settings.section_padding_bottom | minus:10 }}px}.sts-container{min-width:auto;padding:0}.sts-main-heading{font-size:{{ section.settings.main_heading_size | minus:8 }}px;margin-bottom:{{ section.settings.main_heading_spacing | minus:8 }}px}.sts-top-heading{font-size:{{ section.settings.top_heading_size | minus:4 }}px;margin-bottom:24px}.sts-badges{flex-direction:column;gap:12px;margin-bottom:24px}.sts-badge{width:100%;max-width:100%;justify-content:center;padding:14px 20px;font-size:{{ section.settings.badge_font_size }}px}.sts-bottom-text{font-size:{{ section.settings.bottom_text_size | minus:6 }}px;padding:0 10px}}@media (max-width:480px){.sts-main-heading{font-size:{{ section.settings.main_heading_size | minus:12 }}px}.sts-top-heading{font-size:{{ section.settings.top_heading_size | minus:6 }}px}.sts-badge{font-size:{{ section.settings.badge_font_size | minus:2 }}px;padding:12px 16px}.sts-bottom-text{font-size:{{ section.settings.bottom_text_size | minus:8 }}px}}</style>

{% schema %}{"name":"sehatUP Trust Strip","class":"section-trust-strip","settings":[{"type":"range","id":"container_max_width","min":800,"max":1600,"step":50,"unit":"px","label":"Container Max Width","default":1200},{"type":"range","id":"section_padding_top","min":0,"max":100,"step":5,"unit":"px","label":"Section Padding Top","default":50},{"type":"range","id":"section_padding_bottom","min":0,"max":100,"step":5,"unit":"px","label":"Section Padding Bottom","default":50},{"type":"color","id":"section_bg_color","label":"Section Background Color","default":"#f5f5f5"},{"type":"header","content":"Main Heading"},{"type":"text","id":"main_heading","label":"Main Heading Text","default":"Why Choose sehatUP?"},{"type":"range","id":"main_heading_size","min":20,"max":60,"step":2,"unit":"px","label":"Font Size","default":42},{"type":"select","id":"main_heading_weight","label":"Font Weight","options":[{"value":"400","label":"Normal"},{"value":"500","label":"Medium"},{"value":"600","label":"Semi Bold"},{"value":"700","label":"Bold"}],"default":"700"},{"type":"color","id":"main_heading_color","label":"Text Color","default":"#1d1d1d"},{"type":"range","id":"main_heading_spacing","min":10,"max":60,"step":5,"unit":"px","label":"Spacing Below Heading","default":20},{"type":"header","content":"Top Paragraph"},{"type":"text","id":"top_heading","label":"Top Heading Text","default":"Together, They Create Care That Is:"},{"type":"range","id":"top_heading_size","min":12,"max":32,"step":1,"unit":"px","label":"Font Size","default":18},{"type":"select","id":"top_heading_weight","label":"Font Weight","options":[{"value":"300","label":"Light"},{"value":"400","label":"Normal"},{"value":"500","label":"Medium"},{"value":"600","label":"Semi Bold"},{"value":"700","label":"Bold"}],"default":"400"},{"type":"color","id":"top_heading_color","label":"Text Color","default":"#6b6f6b"},{"type":"header","content":"Trust Badges"},{"type":"color","id":"badge_bg_color","label":"Badge Background Color","default":"#ffffff"},{"type":"color","id":"badge_text_color","label":"Badge Text Color","default":"#2e2e2e"},{"type":"range","id":"badge_gap","min":8,"max":40,"step":2,"unit":"px","label":"Gap Between Badges","default":16},{"type":"range","id":"badge_font_size","min":12,"max":24,"step":1,"unit":"px","label":"Badge Font Size","default":15},{"type":"select","id":"badge_font_weight","label":"Badge Font Weight","options":[{"value":"400","label":"Normal"},{"value":"500","label":"Medium"},{"value":"600","label":"Semi Bold"},{"value":"700","label":"Bold"}],"default":"500"},{"type":"range","id":"badge_padding_vertical","min":6,"max":24,"step":2,"unit":"px","label":"Badge Padding (Top/Bottom)","default":12},{"type":"range","id":"badge_padding_horizontal","min":12,"max":40,"step":2,"unit":"px","label":"Badge Padding (Left/Right)","default":24},{"type":"range","id":"badge_border_radius","min":0,"max":50,"step":2,"unit":"px","label":"Badge Border Radius","default":50},{"type":"range","id":"icon_size","min":12,"max":32,"step":2,"unit":"px","label":"Icon Size","default":20},{"type":"header","content":"Bottom Statement"},{"type":"text","id":"bottom_text","label":"Bottom Statement Text","default":"This Isn't Alternative Medicine. This Is Complete Medicine."},{"type":"range","id":"bottom_text_size","min":14,"max":36,"step":1,"unit":"px","label":"Font Size","default":22},{"type":"select","id":"bottom_text_weight","label":"Font Weight","options":[{"value":"400","label":"Normal"},{"value":"500","label":"Medium"},{"value":"600","label":"Semi Bold"},{"value":"700","label":"Bold"}],"default":"600"},{"type":"color","id":"bottom_text_color","label":"Text Color","default":"#1d1d1d"}],"blocks":[{"type":"text","name":"Trust Badge","settings":[{"type":"text","id":"badge_text","label":"Badge Text","default":"Root cause focused"},{"type":"html","id":"custom_icon","label":"Custom Icon (SVG)"},{"type":"color","id":"icon_color","label":"Icon Color","default":"#2e7d32"}]}],"presets":[{"name":"sehatUP Trust Strip"}]}{% endschema %}
