{%- comment -%}
  Phones only: a bar fixed to the bottom with the main button and WhatsApp.
  It slides in once the visitor scrolls past the first section and slides
  away when the page's final call to action (.hfc) comes into view, so the
  two never show together. While it is up it lifts the other floating items
  so nothing overlaps: the sehatUP Mitra chat bubble (inside its own shadow
  root, via its --gap-bottom variable) and the review toast at bottom left.
{%- endcomment -%}

{%- assign s = section.settings -%}

<style>
  #ssb-{{ section.id }} { display: none; }
  @media (max-width: 749px) {
    #ssb-{{ section.id }} {
      display: flex; align-items: center; gap: 10px;
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 90;
      padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
      background: #fff; border-top: 1px solid #e8e0d9; box-shadow: 0 -8px 24px rgba(60, 30, 20, .08);
      font-family: 'Montserrat', sans-serif;
      transform: translateY(110%); visibility: hidden;
      transition: transform .35s cubic-bezier(.16, 1, .3, 1), visibility 0s linear .35s;
    }
    #ssb-{{ section.id }}.is-on { transform: none; visibility: visible; transition: transform .35s cubic-bezier(.16, 1, .3, 1); }
    #ssb-{{ section.id }} .ssb__main { flex: 1; min-width: 0; display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 18px; border-radius: 999px; background: {{ s.accent_color }}; color: #fff; font: 700 15px/1 'Montserrat', sans-serif; text-decoration: none; white-space: nowrap; }
    #ssb-{{ section.id }} .ssb__wa { flex: none; width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center; background: #f6f0ec; color: #1d1d1d; }
    #ssb-{{ section.id }} .ssb__wa svg { width: 24px; height: 24px; fill: currentColor; }
    #ssb-{{ section.id }} a:focus-visible { outline: 2px solid #1d1d1d; outline-offset: 3px; }
    /* Lift the review toast above the bar while the bar is up. */
    html.sbar-on #sehatUP-proof-left { bottom: calc(var(--sbar-h, 70px) + 12px) !important; }
  }
  @media (prefers-reduced-motion: reduce) { #ssb-{{ section.id }}, #ssb-{{ section.id }}.is-on { transition: none; } }
</style>

<div id="ssb-{{ section.id }}" class="ssb">
  <a class="ssb__main" href="{{ s.link | default: '#' }}">{{ s.label }}</a>
  {%- if s.whatsapp_link != blank -%}
    <a class="ssb__wa" href="{{ s.whatsapp_link }}" target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.7a2.8 2.8 0 0 0 1.8-1.3 2.3 2.3 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3z"/></svg>
    </a>
  {%- endif -%}
</div>

<script>
  (function () {
    var bar = document.getElementById('ssb-{{ section.id }}');
    if (!bar) return;
    var root = document.documentElement;
    var mq = window.matchMedia('(max-width: 749px)');
    var first = document.querySelector('main .shopify-section');
    var stop = document.querySelector('.hfc');
    var shown = false, ticking = false;

    // The chat bubble lives in a shadow root; raise it through its own variable.
    function chatWrap() {
      var host = document.getElementById('sehatup-chat-root');
      var sr = host && host.shadowRoot;
      if (!sr) return null;
      if (!sr.getElementById('ssb-lift')) {
        var st = document.createElement('style');
        st.id = 'ssb-lift';
        st.textContent = '.launcher, .tip { transition: bottom .35s cubic-bezier(.16, 1, .3, 1); }';
        sr.appendChild(st);
      }
      return sr.querySelector('.wrap');
    }
    function lift(on) {
      var h = bar.offsetHeight || 70;
      root.style.setProperty('--sbar-h', h + 'px');
      root.classList.toggle('sbar-on', on);
      var w = chatWrap();
      if (w) { if (on) w.style.setProperty('--gap-bottom', (h + 12) + 'px'); else w.style.removeProperty('--gap-bottom'); }
    }
    function update() {
      ticking = false;
      var pastFirst = first ? first.getBoundingClientRect().bottom < 0 : window.scrollY > window.innerHeight * 0.8;
      var beforeEnd = !stop || stop.getBoundingClientRect().top > window.innerHeight;
      var on = mq.matches && pastFirst && beforeEnd;
      if (on === shown) return;
      shown = on;
      bar.classList.toggle('is-on', on);
      lift(on);
    }
    function onScroll() { if (!ticking) { ticking = true; requestAnimationFrame(update); } }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    // The chat widget can load after the bar is already up.
    window.addEventListener('load', function () { setTimeout(function () { if (shown) lift(true); }, 1500); });
    update();
  })();
</script>

{% schema %}
{
  "name": "sehatUP phone sticky bar",
  "tag": "div",
  "class": "section-sehat-sticky-cta",
  "settings": [
    { "type": "text", "id": "label", "label": "Button", "default": "Take the free Health Score" },
    { "type": "url", "id": "link", "label": "Button link" },
    { "type": "url", "id": "whatsapp_link", "label": "WhatsApp link", "info": "Leave empty to hide the WhatsApp button." },
    { "type": "color", "id": "accent_color", "label": "Button colour", "default": "#d81f48" }
  ],
  "presets": [{ "name": "sehatUP phone sticky bar" }]
}
{% endschema %}
