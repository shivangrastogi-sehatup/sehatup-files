{%- comment -%}
  Combos: "Find your kit". A short heading, then one photo tile per goal. Each
  tile is a real person living that problem, the goal in plain words and one
  line on what the kit does; the whole tile jumps to that goal's kit shelf.
  Four in a row on laptops, two by two on phones.
  Blocks: goal (photo, or a theme asset file as a fallback; title; line; link).
{%- endcomment -%}
{%- assign s = section.settings -%}
<style>
  #cgl-{{ section.id }} { --ink: #1d1d1d; --mute: #5f5a56; --line: #e8e0d9; --red: #d81f48; padding: clamp(32px, 4vw, 56px) clamp(16px, 3vw, 48px); background: {{ s.section_bg | default: '#ffffff' }}; font-family: 'Montserrat', sans-serif; color: var(--ink); }
  #cgl-{{ section.id }} * { box-sizing: border-box; letter-spacing: normal; }
  #cgl-{{ section.id }} .cgl__in { max-width: 1240px; margin: 0 auto; }
  #cgl-{{ section.id }} .cgl__head { max-width: 640px; margin: 0 auto clamp(20px, 2.6vw, 32px); text-align: center; }
  #cgl-{{ section.id }} .cgl__h { margin: 0; font: 800 clamp(28px, 3.2vw, 44px)/1.1 'Montserrat', sans-serif; letter-spacing: -.02em; color: var(--ink); }
  #cgl-{{ section.id }} .cgl__sub { margin: 10px 0 0; font: 400 16px/1.55 'Montserrat', sans-serif; color: var(--mute); }
  #cgl-{{ section.id }} .cgl__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat({{ section.blocks.size | at_most: 4 | at_least: 1 }}, minmax(0, 1fr)); gap: clamp(12px, 1.6vw, 20px); }
  /* Each goal: a round photo with the goal name centred under it. */
  #cgl-{{ section.id }} .cgl__tile { display: flex; flex-direction: column; align-items: center; height: 100%; text-align: center; color: inherit; text-decoration: none; }
  #cgl-{{ section.id }} .cgl__ph { position: relative; width: 100%; max-width: 240px; aspect-ratio: 1; border-radius: 50%; overflow: hidden; background: #f6f0ec; box-shadow: 0 0 0 1px #ece4de; transition: box-shadow .3s ease; }
  #cgl-{{ section.id }} .cgl__ph img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: var(--focus, center 25%); transition: transform .6s cubic-bezier(.22, 1, .36, 1); }
  #cgl-{{ section.id }} .cgl__t { margin: 16px 4px 0; font: 700 clamp(16px, 1.3vw, 19px)/1.3 'Montserrat', sans-serif; text-wrap: balance; }
  #cgl-{{ section.id }} .cgl__d { margin: 4px 2px 0; font: 400 14px/1.45 'Montserrat', sans-serif; color: var(--mute); }
  #cgl-{{ section.id }} .cgl__go { display: inline-flex; align-items: center; gap: 6px; margin: 10px 2px 0; font: 700 14px/1 'Montserrat', sans-serif; color: var(--red); }
  #cgl-{{ section.id }} .cgl__go svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; transition: transform .3s ease; }
  @media (hover: hover) {
    #cgl-{{ section.id }} .cgl__tile:hover .cgl__ph img { transform: scale(1.05); }
    #cgl-{{ section.id }} .cgl__tile:hover .cgl__ph { box-shadow: 0 0 0 2px var(--red); }
    #cgl-{{ section.id }} .cgl__tile:hover .cgl__go svg { transform: translateX(3px); }
  }
  #cgl-{{ section.id }} .cgl__tile:focus-visible { outline: none; }
  #cgl-{{ section.id }} .cgl__tile:focus-visible .cgl__ph { box-shadow: 0 0 0 3px var(--ink); }
  @media (max-width: 849px) { #cgl-{{ section.id }} .cgl__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 749.98px) {
    #cgl-{{ section.id }} { padding: 32px 16px; }
    #cgl-{{ section.id }} .cgl__h { font-size: 30px; }
    #cgl-{{ section.id }} .cgl__sub { display: none; }
    #cgl-{{ section.id }} .cgl__grid { gap: 12px 10px; }
    #cgl-{{ section.id }} .cgl__ph { max-width: 150px; }
    #cgl-{{ section.id }} .cgl__t { margin-top: 10px; font-size: 14.5px; }
    #cgl-{{ section.id }} .cgl__d { font-size: 13px; }
    #cgl-{{ section.id }} .cgl__go { margin-top: 8px; font-size: 13px; }
  }
  @media (prefers-reduced-motion: reduce) { #cgl-{{ section.id }} * { transition: none !important; } }
  @media (min-width: 1680px) { #cgl-{{ section.id }} .cgl__in { zoom: 1.12; } }
  @media (min-width: 1920px) { #cgl-{{ section.id }} .cgl__in { zoom: 1.25; } }
  @media (min-width: 2240px) { #cgl-{{ section.id }} .cgl__in { zoom: 1.45; } }
  @media (min-width: 2560px) { #cgl-{{ section.id }} .cgl__in { zoom: 1.65; } }
  @media (min-width: 3200px) { #cgl-{{ section.id }} .cgl__in { zoom: 2; } }
  @media (min-width: 3840px) { #cgl-{{ section.id }} .cgl__in { zoom: 2.4; } }
</style>

<section id="cgl-{{ section.id }}"{% if s.anchor != blank %} class="cgl" {% endif %}>
  {%- if s.anchor != blank -%}<span id="{{ s.anchor | handleize }}" style="position: relative; top: -90px;"></span>{%- endif -%}
  <div class="cgl__in">
    <div class="cgl__head">
      <h2 class="cgl__h">{{ s.heading }}</h2>
      {%- if s.subheading != blank -%}<p class="cgl__sub">{{ s.subheading }}</p>{%- endif -%}
    </div>
    <ul class="cgl__grid">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li {{ block.shopify_attributes }}>
          <a class="cgl__tile" href="{{ b.link | default: '#' }}">
            <span class="cgl__ph" style="--focus: {{ b.focus | default: 'center 25%' }}">
              {%- if b.image != blank -%}
                {{ b.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(max-width: 849px) 50vw, 25vw', alt: '' }}
              {%- elsif b.image_asset != blank -%}
                <img src="{{ b.image_asset | asset_url }}" alt="" loading="lazy" width="600" height="750">
              {%- endif -%}
            </span>
            <span class="cgl__t">{{ b.title }}</span>
            {%- if b.text != blank -%}<span class="cgl__d">{{ b.text }}</span>{%- endif -%}
            {%- if s.link_label != blank -%}<span class="cgl__go">{{ s.link_label }}<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></span>{%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Combos: find your kit",
  "tag": "div",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your kit" },
    { "type": "textarea", "id": "subheading", "label": "Line under the heading", "info": "Hidden on phones." },
    { "type": "text", "id": "link_label", "label": "Link text on each photo", "default": "See kits" },
    { "type": "text", "id": "anchor", "label": "Anchor name", "info": "So other buttons can jump here, e.g. find-your-kit" },
    { "type": "color", "id": "section_bg", "label": "Background", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "goal",
      "name": "Goal",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo", "info": "A real person, portrait. Shown 4:5 on laptops, square on phones." },
        { "type": "text", "id": "image_asset", "label": "Or a theme asset file name", "info": "Used only when no photo is picked." },
        { "type": "select", "id": "focus", "label": "Keep this part of the photo in view", "default": "center 25%", "options": [
          { "value": "center 25%", "label": "Top centre" },
          { "value": "center center", "label": "Centre" },
          { "value": "left 30%", "label": "Left" },
          { "value": "right 30%", "label": "Right" }
        ] },
        { "type": "text", "id": "title", "label": "Goal", "default": "Performance and stamina" },
        { "type": "text", "id": "text", "label": "One line" },
        { "type": "text", "id": "link", "label": "Link", "info": "#name of a kit shelf on this page." }
      ]
    }
  ],
  "presets": [{ "name": "Combos: find your kit", "blocks": [{ "type": "goal" }, { "type": "goal" }, { "type": "goal" }, { "type": "goal" }] }]
}
{% endschema %}
