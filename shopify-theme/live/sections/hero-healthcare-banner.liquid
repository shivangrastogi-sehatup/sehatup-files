{% assign ai_gen_id = section.id | replace: '_', '' | replace: '-', '' | downcase %}

{%- liquid
  assign fg_scale = section.settings.foreground_image_scale | default: 100
  assign fg_x = section.settings.foreground_position_x
  assign fg_y = section.settings.foreground_position_y
  assign fg_ox = section.settings.foreground_offset_x | default: 0
  assign fg_oy = section.settings.foreground_offset_y | default: 0

  assign fg_tx = '0'
  assign fg_ty = '0'
  if fg_x == 'center'
    assign fg_tx = '-50%'
  endif
  if fg_y == 'center'
    assign fg_ty = '-50%'
  endif

  assign ov = section.settings.background_overlay_strength | default: 0
  assign ov_alpha = ov | divided_by: 100.0

  # Shifting the photo sideways opens a gap on one edge; zoom just enough to cover it.
  assign bg_shift = section.settings.background_shift_x | default: 0
  assign bg_zoom = bg_shift | abs | times: 0.02 | plus: 1.08

  assign has_fg = false
  if section.settings.layout_mode == 'background-with-overlay-image' and section.settings.foreground_image
    assign has_fg = true
  endif
-%}

{% style %}

    .ai-healthcare-hero-{{ ai_gen_id }} {
      display: block;
      position: relative;
      width: 100%;
      max-width: {{ section.settings.desktop_width_percent }}%;
      margin-left: auto;
      margin-right: auto;
      /* Grows with the screen instead of staying a fixed strip on big monitors,
         but never shorter than the height set in the theme editor. */
      min-height: max({{ section.settings.section_min_height }}px, 62svh);
      max-height: 900px;
      overflow: hidden;
      /* Keeps the z-indexes below inside the hero, so it never paints over the sticky header. */
      isolation: isolate;
    }

    .ai-healthcare-hero__background-{{ ai_gen_id }} {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
    }

    .ai-healthcare-hero__background-image-{{ ai_gen_id }} {
      width: 100%;
      height: 100%;
      object-fit: {{ section.settings.background_image_size }};
      object-position: {{ section.settings.background_position_x }} {{ section.settings.background_position_y }};
      transform: translateX({{ bg_shift }}%) scale({{ bg_zoom }});
      opacity: {{ section.settings.background_overlay_opacity | divided_by: 100.0 }};
    }

    .ai-healthcare-hero__background-placeholder-{{ ai_gen_id }} {
      width: 100%;
      height: 100%;
      background-color: #f4f4f4;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 1.0;
    }

    .ai-healthcare-hero__background-placeholder-{{ ai_gen_id }} svg {
      width: 100%;
      height: 100%;
      max-width: 600px;
      max-height: 600px;
    }

    .ai-healthcare-hero__background-overlay-{{ ai_gen_id }} {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
      {% if ov > 0 %}
        background-color: rgba({{ section.settings.background_overlay_color.rgb }}, {{ ov_alpha }});
      {% endif %}
      {% if section.settings.light_text_fade %}
        /* Soft light wash behind the text side so dark text reads on a busy photo. */
        background-image: linear-gradient(90deg, rgba(251, 249, 247, .94) 0%, rgba(251, 249, 247, .82) 38%, rgba(251, 249, 247, 0) 62%);
      {% endif %}
    }

    {% if section.settings.light_text_fade %}
      @media (max-width: 1040px) {
        .ai-healthcare-hero__background-overlay-{{ ai_gen_id }} {
          background-image: linear-gradient(180deg, rgba(251, 249, 247, .94) 0%, rgba(251, 249, 247, .82) 45%, rgba(251, 249, 247, 0) 70%);
        }
      }
    {% endif %}

    {% if section.settings.layout_mode == 'split-layout' or section.settings.show_white_panel %}
      .ai-healthcare-hero__white-panel-{{ ai_gen_id }} {
        position: absolute;
        top: 0;
        left: 0;
        width: {{ section.settings.white_panel_width }}%;
        height: 100%;
        background-color: {{ section.settings.white_panel_color }};
        opacity: {{ section.settings.white_panel_opacity | divided_by: 100.0 }};
        z-index: 1;
        {% if section.settings.white_panel_rounded %}
          border-radius: 0 {{ section.settings.white_panel_border_radius }}px {{ section.settings.white_panel_border_radius }}px 0;
        {% endif %}
      }
    {% endif %}

    .ai-healthcare-hero__container-{{ ai_gen_id }} {
      position: relative;
      /* Above the doctors photo, so no line of text ever disappears behind it. */
      z-index: 3;
      /* Centred and capped, so the text does not drift into the middle of a 4K screen. */
      max-width: {{ section.settings.content_max_width }}px;
      margin: 0 auto;
      padding: {{ section.settings.section_padding_top }}px clamp(20px, 4vw, {{ section.settings.section_padding_horizontal }}px) {{ section.settings.section_padding_bottom }}px;
      min-height: max({{ section.settings.section_min_height }}px, 62svh);
      display: flex;
      align-items: center;
      {% if section.settings.content_position == 'left' %}
        justify-content: flex-start;
      {% elsif section.settings.content_position == 'center' %}
        justify-content: center;
      {% else %}
        justify-content: flex-end;
      {% endif %}
    }

    .ai-healthcare-hero__content-{{ ai_gen_id }} {
      max-width: {{ section.settings.content_text_max_width }}px;
      color: #ffffff;
      {% if section.settings.content_position == 'center' %}
        text-align: center;
      {% elsif section.settings.content_position == 'right' %}
        text-align: right;
      {% else %}
        text-align: left;
      {% endif %}
    }

    .ai-healthcare-hero__heading-{{ ai_gen_id }} {
      /* vh cap keeps the headline from filling a short laptop screen. */
      font-size: clamp(28px, min(3.5vw, 7.5vh), {{ section.settings.heading_size | times: 1.33 | round }}px);
      font-weight: {{ section.settings.heading_weight }};
      color: {{ section.settings.heading_color }};
      margin: 0 0 {{ section.settings.content_spacing }}px;
      line-height: 1.2;
      text-wrap: balance;
      {% if section.settings.text_shadow_enabled %}
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
      {% endif %}
    }

    .ai-healthcare-hero__subheading-{{ ai_gen_id }} {
      font-size: clamp(19px, 2.1vw, {{ section.settings.subheading_size }}px);
      font-weight: {{ section.settings.subheading_weight }};
      color: {{ section.settings.subheading_color }};
      margin: 0 0 {{ section.settings.content_spacing }}px;
      line-height: 1.4;
      {% if section.settings.text_shadow_enabled %}
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
      {% endif %}
    }

    .ai-healthcare-hero__body-{{ ai_gen_id }} {
      font-size: clamp(17px, 1.5vw, {{ section.settings.body_size }}px);
      color: {{ section.settings.body_color }};
      margin: 0 0 {{ section.settings.content_spacing }}px;
      line-height: 1.6;
      {% if section.settings.text_shadow_enabled %}
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
      {% endif %}
    }

    .ai-healthcare-hero__kicker-{{ ai_gen_id }} {
      font-size: clamp(15px, 1.3vw, 18px);
      font-weight: 700;
      color: {{ section.settings.subheading_highlight_color }};
      margin: 0 0 12px;
    }

    .ai-healthcare-hero__note-{{ ai_gen_id }} {
      font-size: 14px;
      color: {{ section.settings.body_color }};
      opacity: .8;
      margin: 18px 0 0;
    }

    .ai-healthcare-hero__buttons-{{ ai_gen_id }} {
      display: flex;
      gap: 16px;
      margin-top: {{ section.settings.button_spacing }}px;
      {% if section.settings.button_layout == 'stacked' %}
        flex-direction: column;
        align-items: {% if section.settings.content_position == 'center' %}center{% elsif section.settings.content_position == 'right' %}flex-end{% else %}flex-start{% endif %};
      {% else %}
        flex-direction: row;
        flex-wrap: wrap;
        {% if section.settings.content_position == 'center' %}
          justify-content: center;
        {% elsif section.settings.content_position == 'right' %}
          justify-content: flex-end;
        {% else %}
          justify-content: flex-start;
        {% endif %}
      {% endif %}
    }

    .ai-healthcare-hero__button-{{ ai_gen_id }} {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 52px;
      padding: {{ section.settings.button_padding_vertical }}px {{ section.settings.button_padding_horizontal }}px;
      font-size: clamp(16px, 1.25vw, {{ section.settings.button_font_size }}px);
      font-weight: {{ section.settings.button_font_weight }};
      text-decoration: none;
      border-radius: {{ section.settings.button_border_radius }}px;
      transition: all 0.3s ease;
      cursor: pointer;
      border: 2px solid transparent;
      {% if section.settings.button_layout == 'stacked' %}
        width: 100%;
        max-width: 300px;
        text-align: center;
      {% endif %}
    }

    .ai-healthcare-hero__button-primary-{{ ai_gen_id }} {
      background-color: {{ section.settings.button_1_bg_color }};
      color: {{ section.settings.button_1_text_color }};
      border-color: {{ section.settings.button_1_border_color }};
      {% if section.settings.button_1_style == 'outline' %}
        background-color: transparent;
        border-color: {{ section.settings.button_1_bg_color }};
        color: {{ section.settings.button_1_bg_color }};
      {% endif %}
    }

    .ai-healthcare-hero__button-primary-{{ ai_gen_id }}:hover {
      background-color: {{ section.settings.button_1_hover_bg_color }};
      color: {{ section.settings.button_1_hover_text_color }};
      border-color: {{ section.settings.button_1_hover_border_color }};
      transform: translateY(-2px);
    }

    .ai-healthcare-hero__button-secondary-{{ ai_gen_id }} {
      background-color: {{ section.settings.button_2_bg_color }};
      color: {{ section.settings.button_2_text_color }};
      border-color: {{ section.settings.button_2_border_color }};
      {% if section.settings.button_2_style == 'outline' %}
        background-color: transparent;
        border-color: {{ section.settings.button_2_bg_color }};
        color: {{ section.settings.button_2_bg_color }};
      {% endif %}
    }

    .ai-healthcare-hero__button-secondary-{{ ai_gen_id }}:hover {
      background-color: {{ section.settings.button_2_hover_bg_color }};
      color: {{ section.settings.button_2_hover_text_color }};
      border-color: {{ section.settings.button_2_hover_border_color }};
      transform: translateY(-2px);
    }

    .hero-highlight-{{ ai_gen_id }} {
      color: {{ section.settings.subheading_highlight_color }};
      font-weight: 700;
    }

    {% if section.settings.layout_mode == 'background-with-overlay-image' and section.settings.foreground_image %}
      .ai-healthcare-hero__foreground-image-{{ ai_gen_id }} {
        position: absolute;
        z-index: 2;
        {% if fg_x == 'left' %}
          left: {{ fg_ox }}%;
        {% elsif fg_x == 'center' %}
          left: 50%;
        {% else %}
          right: {{ fg_ox }}%;
        {% endif %}
        {% if fg_y == 'top' %}
          top: {{ fg_oy }}%;
        {% elsif fg_y == 'center' %}
          top: 50%;
        {% else %}
          bottom: {{ fg_oy }}%;
        {% endif %}
        transform: translate({{ fg_tx }}, {{ fg_ty }});
        /* Full hero height, so the image can be capped at it below instead of
           spilling past the top and getting cut off by overflow: hidden. */
        height: 100%;
        display: flex;
        align-items: {% if fg_y == 'top' %}flex-start{% elsif fg_y == 'center' %}center{% else %}flex-end{% endif %};
      }

      .ai-healthcare-hero__foreground-image-{{ ai_gen_id }} img {
        /* Scales with the hero, which now grows on large screens. */
        height: calc(max({{ section.settings.section_min_height }}px, 62svh) * {{ fg_scale }} / 100);
        max-height: 100%;
        width: auto;
        object-fit: {{ section.settings.foreground_image_fit }};
        object-position: bottom center;
        display: block;
        {% if section.settings.foreground_trim_bottom > 0 %}
          /* Hides empty transparent rows at the bottom of the PNG so it sits flush. */
          transform: translateY({{ section.settings.foreground_trim_bottom }}%);
        {% endif %}
      }
    {% endif %}

    /* ============ CRITICAL OVERLAP FIX BELOW 1208px ============ */
    @media (max-width: 1208px) {
      .ai-healthcare-hero__container-{{ ai_gen_id }} {
        padding: {{ section.settings.section_padding_top | minus: 30 }}px 40px {{ section.settings.section_padding_bottom | minus: 30 }}px;
        min-height: 405px;
      }

      .ai-healthcare-hero__foreground-image-{{ ai_gen_id }} img {
        height: calc(380px * {{ fg_scale }} / 100);
      }

      .ai-healthcare-hero__buttons-{{ ai_gen_id }} {
        gap: 12px;
        margin-top: 22px;
      }

      .ai-healthcare-hero__button-{{ ai_gen_id }} {
        padding: 12px 22px;
      }
    }

    @media (max-width: 1140px) {
      .ai-healthcare-hero__foreground-image-{{ ai_gen_id }} img {
        height: calc(350px * {{ fg_scale }} / 100);
      }

      .ai-healthcare-hero__container-{{ ai_gen_id }} {
        padding: {{ section.settings.section_padding_top | minus: 30 }}px 40px {{ section.settings.section_padding_bottom | minus: 30 }}px;
        min-height: 368px;
      }
    }

    @media (max-width: 1084px) {
      .ai-healthcare-hero__container-{{ ai_gen_id }} {
        padding: {{ section.settings.section_padding_top | minus: 30 }}px 40px {{ section.settings.section_padding_bottom | minus: 30 }}px;
        min-height: 359px;
      }

      .ai-healthcare-hero__foreground-image-{{ ai_gen_id }} img {
        height: calc(320px * {{ fg_scale }} / 100);
      }

      .ai-healthcare-hero__buttons-{{ ai_gen_id }} {
        gap: 12px;
        margin-top: 22px;
      }

      .ai-healthcare-hero__button-{{ ai_gen_id }} {
        padding: 12px 22px;
      }
    }

    /* ============ PHONE PERFECT LAYOUT ============ */
    @media (max-width: 1040px) {
      .ai-healthcare-hero-{{ ai_gen_id }} {
        max-width: 100%;
        /* Text + stacked image can be taller than 900px; don't clip the photo. */
        max-height: none;
      }

      .ai-healthcare-hero__container-{{ ai_gen_id }} {
        display: block;
        {% if section.settings.enable_mobile_overrides %}
          padding: {{ section.settings.section_padding_top_mobile }}px {{ section.settings.section_padding_horizontal_mobile }}px {{ section.settings.section_padding_bottom_mobile }}px;
          min-height: {% if section.settings.section_min_height_mobile > 0 %}{{ section.settings.section_min_height_mobile }}px{% else %}auto{% endif %};
        {% else %}
          padding: 24px 16px;
          min-height: auto;
        {% endif %}
        margin: 0;
      }

      {% if section.settings.enable_mobile_overrides %}
        .ai-healthcare-hero__background-image-{{ ai_gen_id }} {
          object-position: {{ section.settings.mobile_background_position_x }} {{ section.settings.mobile_background_position_y }};
        }
      {% endif %}

      .ai-healthcare-hero__content-{{ ai_gen_id }} {
        max-width: 100%;
        {% if section.settings.enable_mobile_overrides %}
          text-align: {{ section.settings.mobile_content_alignment }};
        {% else %}
          text-align: left;
        {% endif %}
      }

      /* Readable sizes on tablet and phone. These used to be 22px / 13px / 12px,
         which was too small to read on a phone and far too small on a tablet. */
      .ai-healthcare-hero__heading-{{ ai_gen_id }} {
        font-size: clamp(28px, 4.6vw, 40px);
        line-height: 1.22;
      }

      .ai-healthcare-hero__subheading-{{ ai_gen_id }} {
        font-size: clamp(18px, 2.6vw, 22px);
        margin-top: 10px;
      }

      .ai-healthcare-hero__body-{{ ai_gen_id }} {
        font-size: clamp(16px, 2.2vw, 18px);
        margin-top: 10px;
      }

      .ai-healthcare-hero__buttons-{{ ai_gen_id }} {
        {% if section.settings.enable_mobile_overrides and section.settings.mobile_content_alignment == 'center' %}
          justify-content: center;
        {% elsif section.settings.enable_mobile_overrides and section.settings.mobile_content_alignment == 'right' %}
          justify-content: flex-end;
        {% else %}
          justify-content: flex-start;
        {% endif %}
        gap: 10px;
        margin-top: 18px;
        flex-direction: row;
        flex-wrap: wrap;
      }

      /* Side by side on a phone instead of stacked, so the photo is not pushed
         off the first screen. They wrap on their own if the text is long. */
      .ai-healthcare-hero__button-{{ ai_gen_id }} {
        flex: 1 1 auto;
        min-width: 150px;
        max-width: 100%;
        width: auto;
        padding: 12px 18px;
        font-size: 16px;
      }

      .ai-healthcare-hero__foreground-image-{{ ai_gen_id }} {
        {% if section.settings.hide_foreground_mobile %}
          display: none;
        {% else %}
          position: relative;
          left: auto;
          right: auto;
          top: auto;
          bottom: auto;
          transform: none;
          height: auto;
          margin: 20px auto 0 auto;
          display: flex;
          justify-content: center;
          width: 100%;
        {% endif %}
      }

      /* The hero PNGs are wide 16:9 canvases with the person + product on one
         side. A square crop anchored to that side drops the empty half, so the
         subject fills the phone width, centred, with the product label readable. */
      .ai-healthcare-hero__foreground-image-{{ ai_gen_id }} img {
        height: auto;
        max-height: none;
        width: 100%;
        max-width: 480px;
        margin: 0 auto;
        {% if section.settings.mobile_crop_foreground %}
          aspect-ratio: 1 / 1;
          object-fit: cover;
          object-position: {{ fg_x }} bottom;
        {% else %}
          object-fit: contain;
          object-position: center bottom;
        {% endif %}
      }
    }

    /* Large monitors: let the headline use more of the line so it stops
       breaking into four short lines at 1600px and above. */
    @media (min-width: 1600px) {
      .ai-healthcare-hero__content-{{ ai_gen_id }} {
        max-width: {{ section.settings.content_text_max_width | plus: 260 }}px;
      }
    }

    {% if has_fg %}
      /* Doctors photo sits on the right half: keep the text on the left half. */
      @media (min-width: 1041px) {
        /* The doctors are pinned to the banner's right edge, so pin the text to its
           left edge too. A centred 1400px box left a huge gap on 4K screens. */
        .ai-healthcare-hero__container-{{ ai_gen_id }} {
          max-width: none;
          padding-left: max({{ section.settings.section_padding_horizontal }}px, 5vw);
          padding-right: max({{ section.settings.section_padding_horizontal }}px, 5vw);
        }

        .ai-healthcare-hero__content-{{ ai_gen_id }} {
          max-width: min({{ section.settings.content_text_max_width | plus: 260 }}px, 52%);
        }
      }
    {% endif %}

    @media (max-width: 1040px) {
      .ai-healthcare-hero__background-image-{{ ai_gen_id }} {
        transform: scale(1.08);
        object-position: {{ section.settings.mobile_bg_focus_x | default: 50 }}% {% if section.settings.enable_mobile_overrides %}{{ section.settings.mobile_background_position_y }}{% else %}{{ section.settings.background_position_y }}{% endif %};
      }

      {% if has_fg and section.settings.hide_foreground_mobile == false %}
        /* Doctors stack centred under the text here, so centre the text with them. */
        .ai-healthcare-hero__content-{{ ai_gen_id }} {
          margin-left: auto;
          margin-right: auto;
          text-align: center;
        }

        .ai-healthcare-hero__buttons-{{ ai_gen_id }} {
          justify-content: center;
        }
      {% endif %}
    }

    /* Tablet: give the hero room so the text block and the photo both breathe. */
    @media (min-width: 700px) and (max-width: 1040px) {
      .ai-healthcare-hero__container-{{ ai_gen_id }} {
        padding: 40px clamp(24px, 5vw, 56px);
      }

      .ai-healthcare-hero__content-{{ ai_gen_id }} {
        max-width: 640px;
      }

      .ai-healthcare-hero__foreground-image-{{ ai_gen_id }} img {
        max-width: 520px;
      }
    }
{% if section.settings.split_layout and section.settings.layout_mode == 'background-with-overlay-image' and section.settings.foreground_image %}
    @media (min-width: 1041px) {
      .ai-healthcare-hero__content-{{ ai_gen_id }} {
        max-width: min({{ section.settings.content_text_max_width }}px, calc(50% - 40px));
      }

      .ai-healthcare-hero__foreground-image-{{ ai_gen_id }} {
        top: 0;
        bottom: 0;
        left: auto;
        right: 0;
        width: 50%;
        height: 100%;
        transform: none;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        padding: 24px 24px 0;
        box-sizing: border-box;
      }

      .ai-healthcare-hero__foreground-image-{{ ai_gen_id }} img {
        width: auto;
        height: {{ fg_scale | at_most: 100 }}%;
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        object-position: center bottom;
      }
    }
  {% endif %}
{% endstyle %}

<healthcare-hero-{{ ai_gen_id }} class="ai-healthcare-hero-{{ ai_gen_id }}" {{ section.shopify_attributes }}>
  <div class="ai-healthcare-hero__background-{{ ai_gen_id }}">
    {% if section.settings.background_image %}
      <picture style="display: contents;">
      {% if section.settings.mobile_background_image %}
        <source
          media="(max-width: 1040px)"
          srcset="
            {{ section.settings.mobile_background_image | image_url: width: 600 }} 600w,
            {{ section.settings.mobile_background_image | image_url: width: 900 }} 900w,
            {{ section.settings.mobile_background_image | image_url: width: 1200 }} 1200w
          "
          sizes="100vw"
          width="{{ section.settings.mobile_background_image.width }}"
          height="{{ section.settings.mobile_background_image.height }}"
        >
      {% endif %}
      <img
        src="{{ section.settings.background_image | image_url: width: 1600 }}"
        fetchpriority="high"
        loading="eager"
        decoding="async"
        srcset="
        {{ section.settings.background_image | image_url: width: 480 }} 480w,
        {{ section.settings.background_image | image_url: width: 768 }} 768w,
        {{ section.settings.background_image | image_url: width: 1200 }} 1200w,
        {{ section.settings.background_image | image_url: width: 1600 }} 1600w,
        {{ section.settings.background_image | image_url: width: 2400 }} 2400w,
        {{ section.settings.background_image | image_url: width: 3200 }} 3200w
        "
        sizes="100vw"
        alt="{{ section.settings.background_image.alt | escape }}"
        width="{{ section.settings.background_image.width }}"
        height="{{ section.settings.background_image.height }}"
        class="ai-healthcare-hero__background-image-{{ ai_gen_id }}"
      >
      </picture>
    {% else %}
      <div class="ai-healthcare-hero__background-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
    <div class="ai-healthcare-hero__background-overlay-{{ ai_gen_id }}"></div>
  </div>

  {% if section.settings.layout_mode == 'split-layout' or section.settings.show_white_panel %}
    <div class="ai-healthcare-hero__white-panel-{{ ai_gen_id }}"></div>
  {% endif %}

  <div class="ai-healthcare-hero__container-{{ ai_gen_id }}">
    <div class="ai-healthcare-hero__content-{{ ai_gen_id }}">
      {% if section.settings.kicker != blank %}
        <p class="ai-healthcare-hero__kicker-{{ ai_gen_id }}">{{ section.settings.kicker }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        {%- liquid
          assign hero_h = section.settings.heading
          if section.settings.heading_red != blank
            capture red_words
              echo '<span style="color: ' | append: section.settings.heading_red_color | append: ';">' | append: section.settings.heading_red | append: '</span>'
            endcapture
            assign hero_h = hero_h | replace_first: section.settings.heading_red, red_words
          endif
        -%}
        <h1 class="ai-healthcare-hero__heading-{{ ai_gen_id }}">{{ hero_h }}</h1>
      {% endif %}

      {% if section.settings.subheading_prefix != blank %}
        <div class="ai-healthcare-hero__subheading-{{ ai_gen_id }}">
          {{ section.settings.subheading_prefix }}
          {% if section.settings.subheading_highlight != blank %}
            <span class="hero-highlight-{{ ai_gen_id }}">
              {{ section.settings.subheading_highlight }}
            </span>
          {% endif %}
        </div>
      {% endif %}

      {% if section.settings.body_text != blank %}
        <div class="ai-healthcare-hero__body-{{ ai_gen_id }}">
          {{ section.settings.body_text }}
        </div>
      {% endif %}

      {% if section.settings.button_1_text != blank or section.settings.button_2_text != blank %}
        <div class="ai-healthcare-hero__buttons-{{ ai_gen_id }}">
          {% if section.settings.button_1_text != blank %}
            <a
              href="{{ section.settings.button_1_link }}"
              class="ai-healthcare-hero__button-{{ ai_gen_id }} ai-healthcare-hero__button-primary-{{ ai_gen_id }}"
            >
              {{ section.settings.button_1_text }}
            </a>
          {% endif %}

          {% if section.settings.show_button_2 and section.settings.button_2_text != blank %}
            {% assign btn2_text_downcase = section.settings.button_2_text | downcase %}
            <a
              href="{{ section.settings.button_2_link }}"
              class="ai-healthcare-hero__button-{{ ai_gen_id }} ai-healthcare-hero__button-secondary-{{ ai_gen_id }}"
              {% if section.settings.enable_doctor_new_tab
                    and btn2_text_downcase contains 'talk to a doctor' %}
                target="_blank"
                rel="noopener noreferrer"
              {% endif %}
            >
              {{ section.settings.button_2_text }}
            </a>
          {% endif %}
        </div>
      {% endif %}

      {% render 'trust-proof', s: section.settings, color: section.settings.body_color, ring: 'rgba(255, 255, 255, .9)' %}

      {% if section.settings.note != blank %}
        <p class="ai-healthcare-hero__note-{{ ai_gen_id }}">{{ section.settings.note }}</p>
      {% endif %}
    </div>
  </div>

  {% if section.settings.layout_mode == 'background-with-overlay-image' and section.settings.foreground_image %}
    <div class="ai-healthcare-hero__foreground-image-{{ ai_gen_id }}">
      <picture style="display: contents;">
      {% if section.settings.mobile_foreground_image %}
        <source
          media="(max-width: 1040px)"
          srcset="
            {{ section.settings.mobile_foreground_image | image_url: width: 600 }} 600w,
            {{ section.settings.mobile_foreground_image | image_url: width: 900 }} 900w,
            {{ section.settings.mobile_foreground_image | image_url: width: 1200 }} 1200w
          "
          sizes="min(100vw, 600px)"
          width="{{ section.settings.mobile_foreground_image.width }}"
          height="{{ section.settings.mobile_foreground_image.height }}"
        >
      {% endif %}
      <img
        src="{{ section.settings.foreground_image | image_url: width: 1200 }}"
        srcset="
          {{ section.settings.foreground_image | image_url: width: 800 }} 800w,
          {{ section.settings.foreground_image | image_url: width: 1200 }} 1200w,
          {{ section.settings.foreground_image | image_url: width: 1600 }} 1600w,
          {{ section.settings.foreground_image | image_url: width: 2000 }} 2000w
        "
        sizes="(max-width: 1040px) min(100vw, 600px), 50vw"
        alt="{{ section.settings.foreground_image.alt | escape }}"
        loading="eager"
        width="{{ section.settings.foreground_image.width }}"
        height="{{ section.settings.foreground_image.height }}"
      >
      </picture>
    </div>
  {% endif %}
</healthcare-hero-{{ ai_gen_id }}>

<script>
  (function() {
    class HealthcareHero{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.init();
      }

      init() {
        const container = this;
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              container.classList.add('visible');
              observer.disconnect();
            }
          });
        }, { threshold: 0.1 });

        observer.observe(container);
      }
    }

    if (!customElements.get('healthcare-hero-{{ ai_gen_id }}')) {
      customElements.define('healthcare-hero-{{ ai_gen_id }}', HealthcareHero{{ ai_gen_id }});
    }
  })();
</script>

