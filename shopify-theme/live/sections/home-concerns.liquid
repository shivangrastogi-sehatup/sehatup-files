{%- comment -%}
  Home: "What would you like help with?" Heading on the left (stays in view
  on desktop), concerns on the right as big typographic rows. Each row says
  who it is for and links to the right page. Hover: a stone fill sweeps in
  and the arrow turns red. Rows rise in one after another on first view.
{%- endcomment -%}
{%- assign s = section.settings -%}
<style>
  #hcn-{{ section.id }} {
    --ink: #1d1d1d; --mute: #5f5a56; --stone: #f6f0ec; --line: #e8e0d9; --btn: #d81f48;
    --ease: cubic-bezier(.22, 1, .36, 1);
    padding: clamp(56px, 6vw, 104px) clamp(16px, 4vw, 24px); background: {{ s.section_bg | default: '#ffffff' }}; color: var(--ink); font-family: 'Montserrat', sans-serif;
  }
  #hcn-{{ section.id }} * { letter-spacing: normal; }
  #hcn-{{ section.id }} .hcn__in { max-width: 1272px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: clamp(32px, 5.5vw, 88px); align-items: start; }
  #hcn-{{ section.id }} .hcn__head { position: sticky; top: 120px; }
  #hcn-{{ section.id }} .hcn__h { margin: 0 0 16px; font: 800 clamp(30px, 3.6vw, 52px)/1.06 'Montserrat', sans-serif; letter-spacing: -.02em; color: var(--ink); text-wrap: balance; }
  #hcn-{{ section.id }} .hcn__sub { margin: 0; font: 400 17px/1.6 'Montserrat', sans-serif; color: var(--mute); text-wrap: pretty; }
  #hcn-{{ section.id }} .hcn__more { display: inline-flex; align-items: center; gap: 8px; margin-top: 28px; padding-bottom: 4px; border-bottom: 2px solid var(--line); font: 700 16px/1.3 'Montserrat', sans-serif; color: var(--ink); text-decoration: none; transition: border-color .2s; }
  @media (hover: hover) { #hcn-{{ section.id }} .hcn__more:hover { border-color: var(--btn); } }
  #hcn-{{ section.id }} .hcn__more small { display: block; margin-bottom: 4px; font: 500 14px/1.3 'Montserrat', sans-serif; color: var(--mute); }

  #hcn-{{ section.id }} .hcn__list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  #hcn-{{ section.id }} .hcn__row { position: relative; display: grid; grid-template-columns: 44px minmax(0, 1fr) auto 44px; gap: 18px; align-items: center; padding: 24px 16px; border-bottom: 1px solid var(--line); color: var(--ink); text-decoration: none; isolation: isolate; }
  #hcn-{{ section.id }} .hcn__row::before { content: ''; position: absolute; inset: 0; z-index: -1; border-radius: 20px; background: var(--stone); transform: scaleX(0); transform-origin: left; transition: transform .5s var(--ease); }
  #hcn-{{ section.id }} .hcn__n { font: 600 14px/1 'Montserrat', sans-serif; color: var(--mute); font-variant-numeric: tabular-nums; }
  #hcn-{{ section.id }} .hcn__t { display: block; font: 700 clamp(20px, 1.9vw, 26px)/1.2 'Montserrat', sans-serif; letter-spacing: -.01em; }
  #hcn-{{ section.id }} .hcn__d { display: block; margin-top: 6px; font: 400 15px/1.45 'Montserrat', sans-serif; color: var(--mute); }
  #hcn-{{ section.id }} .hcn__who { font: 600 13px/1 'Montserrat', sans-serif; color: var(--mute); white-space: nowrap; }
  /* Brand red, sparingly: the red part of the heading, the row numbers and the link.
     The arrows stay quiet and turn red on hover, so the list itself reads calm. */
  #hcn-{{ section.id }} .hcn__h span { color: var(--btn); }
  #hcn-{{ section.id }} .hcn__n { color: var(--btn) !important; }
  #hcn-{{ section.id }} .hcn__more { border-bottom-color: var(--btn) !important; }
  #hcn-{{ section.id }} .hcn__go { width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; border: 1.5px solid var(--line); background: #fff; transition: background-color .3s, border-color .3s, color .3s; }
  #hcn-{{ section.id }} .hcn__go svg { width: 16px; height: 16px; transition: transform .3s var(--ease); }
  @media (hover: hover) {
    #hcn-{{ section.id }} .hcn__row:hover::before { transform: none; }
    #hcn-{{ section.id }} .hcn__row:hover .hcn__go { background: var(--btn); border-color: var(--btn); color: #fff; }
    #hcn-{{ section.id }} .hcn__row:hover .hcn__go svg { transform: translateX(2px); }
  }
  #hcn-{{ section.id }} .hcn__row:focus-visible { outline: 2px solid var(--ink); outline-offset: -2px; border-radius: 20px; }

  /* Entrance */
  #hcn-{{ section.id }}.js li { opacity: 0; transform: translateY(18px); }
  #hcn-{{ section.id }}.js.in li { opacity: 1; transform: none; transition: opacity .6s ease calc(var(--i) * .06s), transform .8s var(--ease) calc(var(--i) * .06s); }

  /* Small laptops: the list column is narrow here, so the row number goes and
     the title gets that room. */
  @media (min-width: 900px) and (max-width: 1199.98px) {
    #hcn-{{ section.id }} .hcn__row { grid-template-columns: minmax(0, 1fr) auto 44px; gap: 14px; padding: 22px 12px; }
    #hcn-{{ section.id }} .hcn__n { display: none; }
  }
  /* Tablets: Health Score 360 tablet sizes. */
  @media (min-width: 750px) and (max-width: 1099.98px) {
    #hcn-{{ section.id }} .hcn__h { font-size: 38px; }
    #hcn-{{ section.id }} .hcn__sub { font-size: 16px; }
  }
  @media (max-width: 899.98px) {
    #hcn-{{ section.id }} .hcn__in { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    /* Stacked above the list: centred, like the other section headings on phones and tablets. */
    #hcn-{{ section.id }} .hcn__head { position: static; text-align: center; }
    #hcn-{{ section.id }} .hcn__sub { max-width: 560px; margin-left: auto; margin-right: auto; }
  }
  @media (max-width: 749.98px) {
    #hcn-{{ section.id }} .hcn__h { font-size: 30px; }
    #hcn-{{ section.id }} .hcn__sub { font-size: 15px; }
    #hcn-{{ section.id }} .hcn__more { margin-top: 18px; font-size: 15px; }
    #hcn-{{ section.id }} .hcn__row { grid-template-columns: minmax(0, 1fr) 38px; gap: 12px; padding: 18px 4px; }
    #hcn-{{ section.id }} .hcn__n { display: none; }
    #hcn-{{ section.id }} .hcn__who { grid-column: 1; grid-row: 1; margin-bottom: -4px; font-size: 12px; }
    #hcn-{{ section.id }} .hcn__body { grid-column: 1; }
    #hcn-{{ section.id }} .hcn__go { grid-column: 2; grid-row: 1 / span 2; width: 38px; height: 38px; }
    #hcn-{{ section.id }} .hcn__t { font-size: 19px; }
    #hcn-{{ section.id }} .hcn__d { font-size: 14px; }
  }
  @media (min-width: 1680px) { #hcn-{{ section.id }} .hcn__in { zoom: 1.12; } }
  @media (min-width: 1920px) { #hcn-{{ section.id }} .hcn__in { zoom: 1.25; } }
  @media (min-width: 2240px) { #hcn-{{ section.id }} .hcn__in { zoom: 1.45; } }
  @media (min-width: 2560px) { #hcn-{{ section.id }} .hcn__in { zoom: 1.65; } }
  @media (min-width: 3200px) { #hcn-{{ section.id }} .hcn__in { zoom: 2; } }
  @media (min-width: 3840px) { #hcn-{{ section.id }} .hcn__in { zoom: 2.4; } }
  /* ...and wider at each step, like the Health Score 360 sections, so a big
     screen is filled instead of leaving wide empty sides. */
  @media (min-width: 1920px) { #hcn-{{ section.id }} .hcn__in { max-width: 1312px; } }
  @media (min-width: 2560px) { #hcn-{{ section.id }} .hcn__in { max-width: 1392px; } }
  @media (prefers-reduced-motion: reduce) { #hcn-{{ section.id }} * { transition: none !important; } }
</style>

<section id="hcn-{{ section.id }}">
  <div class="hcn__in">
    <div class="hcn__head">
      <h2 class="hcn__h">{{ s.heading }}{% if s.heading_red != blank %} <span>{{ s.heading_red }}</span>{% endif %}</h2>
      {%- if s.subheading != blank -%}<p class="hcn__sub">{{ s.subheading }}</p>{%- endif -%}
      {%- if s.more_label != blank -%}
        <a class="hcn__more" href="{{ s.more_link | default: '#' }}"><span>{%- if s.more_kicker != blank -%}<small>{{ s.more_kicker }}</small>{%- endif -%}{{ s.more_label }} &rarr;</span></a>
      {%- endif -%}
    </div>
    <ul class="hcn__list">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <a class="hcn__row" href="{{ b.link | default: s.more_link | default: '#' }}">
            <span class="hcn__n">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
            <span class="hcn__body"><span class="hcn__t">{{ b.title }}</span>{%- if b.text != blank -%}<span class="hcn__d">{{ b.text }}</span>{%- endif -%}</span>
            <span class="hcn__who">{{ b.who }}</span>
            <span class="hcn__go" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg></span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('hcn-{{ section.id }}');
    if (!root || !('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    root.classList.add('js');
    var io = new IntersectionObserver(function (es) {
      if (es[0].isIntersecting) { root.classList.add('in'); io.disconnect(); }
    }, { threshold: .15 });
    io.observe(root.querySelector('.hcn__list'));
  })();
</script>

{% schema %}
{
  "name": "Home: concerns",
  "tag": "div",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What would you like help with?" },
    { "type": "text", "id": "heading_red", "label": "Heading, red ending", "info": "Shown in brand red after the heading." },
    { "type": "textarea", "id": "subheading", "label": "Line under it" },
    { "type": "text", "id": "more_kicker", "label": "Small line above the link", "default": "Not sure where to start?" },
    { "type": "text", "id": "more_label", "label": "Link", "default": "Take the 2-minute Health Score" },
    { "type": "url", "id": "more_link", "label": "Link to", "info": "Also used by rows without their own link." },
    { "type": "color", "id": "section_bg", "label": "Background", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "concern",
      "name": "Concern",
      "settings": [
        { "type": "text", "id": "title", "label": "Concern", "default": "Weight & metabolism" },
        { "type": "text", "id": "text", "label": "Signs", "default": "Belly fat, slow metabolism, cravings" },
        { "type": "text", "id": "who", "label": "Who it is for", "default": "Women & men" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Home: concerns" }]
}
{% endschema %}
