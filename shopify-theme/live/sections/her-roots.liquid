{%- comment -%}
  For Her: "your symptoms are clues". One calm centred column:
    1. Tap what you notice   pills with a + that turns into a tick
                             (phones show the first few + "See more")
    2. Result card           bordered, always there at a fixed height, so
                             nothing jumps; its words fade from a hint to the
                             strongest root cause, its text, link and one quiet
                             "Also linked" line.
  Blocks: "sign" (a pill) and "root" (lists its signs by their exact pill text).
  Not a diagnosis, and the copy says so.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign signs = section.blocks | where: 'type', 'sign'
  assign roots = section.blocks | where: 'type', 'root'
  assign more = signs.size | minus: s.mobile_signs
  assign desk_more = 0
  if s.desktop_signs > 0
    assign desk_more = signs.size | minus: s.desktop_signs
  endif
-%}
<style>
  #hrt-{{ section.id }} {
    --hrt-red: #ee204a; --hrt-ink: #d81f48; --hrt-text: #1d1d1d; --hrt-muted: #5f5a56; --hrt-line: #e8e0d9; --hrt-blush: #fdf0f2;
    padding: clamp(40px, 4.4vw, 64px) clamp(16px, 3vw, 48px); background: {{ s.section_bg | default: '#ffffff' }}; font-family: 'Montserrat', sans-serif; color: var(--hrt-text);
  }
  #hrt-{{ section.id }} * { box-sizing: border-box; }
  #hrt-{{ section.id }} .hrt__inner { max-width: 820px; margin: 0 auto; text-align: center; }
  #hrt-{{ section.id }} h2 { margin: 0; color: var(--hrt-text); font: 800 clamp(30px, 3.6vw, 52px)/1.06 'Montserrat', sans-serif; letter-spacing: -.02em; text-wrap: balance; }
  #hrt-{{ section.id }} .hrt__lead { max-width: 600px; margin: 10px auto 0; font: 500 15.5px/1.6 'Montserrat', sans-serif; color: var(--hrt-muted); text-wrap: pretty; }

  #hrt-{{ section.id }} .hrt__ask { margin: clamp(24px, 3vw, 32px) 0 14px; font: 700 14px/1.4 'Montserrat', sans-serif; }
  #hrt-{{ section.id }} .hrt__ask > span { margin-left: 8px; font-weight: 600; color: var(--hrt-muted); }
  #hrt-{{ section.id }} .hrt__clear { margin-left: 6px; padding: 0; border: 0; background: none; font: inherit; font-weight: 600; color: var(--hrt-ink); text-decoration: underline; cursor: pointer; }

  /* Pills: a + that becomes a tick, so they read as "tap me". */
  #hrt-{{ section.id }} .hrt__signs { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
  #hrt-{{ section.id }} .hrt__sign {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 16px 0 8px; border-radius: 999px;
    border: 1.5px solid var(--hrt-line); background: #fff; font: 600 14.5px/1 'Montserrat', sans-serif; color: var(--hrt-text);
    cursor: pointer; transition: border-color .2s ease, background-color .2s ease, color .2s ease, transform .15s ease;
  }
  #hrt-{{ section.id }} .hrt__sign:hover { border-color: var(--hrt-red); transform: translateY(-1px); }
  #hrt-{{ section.id }} .hrt__sign:active { transform: scale(.97); }
  #hrt-{{ section.id }} .hrt__ic { flex: none; width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; background: var(--hrt-blush); color: var(--hrt-ink); transition: background-color .2s ease, color .2s ease; }
  #hrt-{{ section.id }} .hrt__ic svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
  #hrt-{{ section.id }} .hrt__ic .tick { display: none; }
  #hrt-{{ section.id }} .hrt__sign[aria-pressed="true"] { border-color: var(--hrt-red); background: var(--hrt-red); color: #fff; }
  #hrt-{{ section.id }} .hrt__sign[aria-pressed="true"] .hrt__ic { background: #fff; color: var(--hrt-red); }
  #hrt-{{ section.id }} .hrt__sign[aria-pressed="true"] .plus { display: none; }
  #hrt-{{ section.id }} .hrt__sign[aria-pressed="true"] .tick { display: block; }
  /* See more / See less: a white pill with a soft red shadow and a chevron that flips when open. */
  #hrt-{{ section.id }} .hrt__more { display: none; gap: 8px; min-height: 44px; padding: 0 18px 0 22px; border-radius: 999px; border: 0; background: #fff; box-shadow: 0 1px 0 rgba(29, 29, 29, .04), 0 8px 20px -10px rgba(216, 31, 72, .45); font: 700 14px/1 'Montserrat', sans-serif; color: var(--hrt-ink); cursor: pointer; transition: transform .2s ease, box-shadow .2s ease; }
  #hrt-{{ section.id }} .hrt__more:active { transform: scale(.97); }
  @media (hover: hover) { #hrt-{{ section.id }} .hrt__more:hover { transform: translateY(-1px); box-shadow: 0 1px 0 rgba(29, 29, 29, .04), 0 12px 24px -10px rgba(216, 31, 72, .55); } }
  #hrt-{{ section.id }} .hrt__chev { width: 22px; height: 22px; padding: 4px; border-radius: 50%; background: #fdecef; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; transition: transform .35s cubic-bezier(.2, .9, .25, 1); }
  #hrt-{{ section.id }} .hrt__more[aria-expanded="true"] .hrt__chev { transform: rotate(180deg); }
  /* The chips sit in a track; it only takes part in the layout on phones when the list is open. */
  #hrt-{{ section.id }} .hrt__track { display: contents; }
  #hrt-{{ section.id }} :is(.hrt__sign, .hrt__more, .hrt__clear, .hrt__btn, .hrt__res a):focus-visible { outline: 2px solid var(--hrt-text); outline-offset: 3px; }

  /* Result card: bordered, fixed room, the words fade, nothing below moves. */
  #hrt-{{ section.id }} .hrt__res { margin-top: clamp(24px, 3vw, 32px); min-height: 180px; padding: 24px clamp(20px, 3vw, 32px); border-radius: 22px; border: 1.5px solid var(--hrt-line); background: #fff; text-align: left; display: grid; align-items: center; }
  #hrt-{{ section.id }} .hrt__res > div { grid-area: 1 / 1; transition: opacity .35s ease, transform .35s ease; }
  #hrt-{{ section.id }} .hrt__idle { display: flex; align-items: center; gap: 16px; }
  #hrt-{{ section.id }} .hrt__idle svg { flex: none; width: 40px; height: 40px; fill: none; stroke: var(--hrt-red); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  #hrt-{{ section.id }} .hrt__idle p { margin: 0; font: 600 15px/1.5 'Montserrat', sans-serif; color: var(--hrt-muted); }
  #hrt-{{ section.id }} .hrt__ans small { display: block; font: 700 11px/1 'Montserrat', sans-serif; letter-spacing: .12em; text-transform: uppercase; color: var(--hrt-muted); }
  #hrt-{{ section.id }} .hrt__ans b { display: block; margin-top: 8px; font: 800 clamp(22px, 2.2vw, 26px)/1.2 'Montserrat', sans-serif; color: var(--hrt-ink); }
  #hrt-{{ section.id }} .hrt__ans p { margin: 8px 0 0; font: 500 14.5px/1.55 'Montserrat', sans-serif; color: var(--hrt-muted); }
  #hrt-{{ section.id }} .hrt__ans .hrt__also { font-size: 13px; color: var(--hrt-text); }
  #hrt-{{ section.id }} .hrt__ans .hrt__also:empty { display: none; }
  #hrt-{{ section.id }} .hrt__ans a { display: inline-block; margin-top: 10px; font: 700 14px/1.3 'Montserrat', sans-serif; color: var(--hrt-ink); text-decoration: underline; text-underline-offset: 4px; }
  #hrt-{{ section.id }} .hrt__ans a[hidden] { display: none; }
  #hrt-{{ section.id }} .hrt__ans, #hrt-{{ section.id }}.is-picked .hrt__idle { opacity: 0; transform: translateY(6px); pointer-events: none; }
  #hrt-{{ section.id }}.is-picked .hrt__ans { opacity: 1; transform: none; pointer-events: auto; }
  #hrt-{{ section.id }}.is-picked .hrt__ans.is-swap { opacity: .15; }

  #hrt-{{ section.id }} .hrt__foot { margin-top: 22px; display: flex; flex-direction: column; align-items: center; gap: 10px; }
  #hrt-{{ section.id }} .hrt__btn { display: inline-flex; align-items: center; justify-content: center; min-height: 52px; padding: 0 32px; border-radius: 999px; background: var(--hrt-red); color: #fff; font: 700 15px/1 'Montserrat', sans-serif; text-decoration: none; transition: background-color .2s ease; }
  #hrt-{{ section.id }} .hrt__btn:hover { background: var(--hrt-ink); }
  #hrt-{{ section.id }} .hrt__note { margin: 0; font: 500 12px/1.5 'Montserrat', sans-serif; color: var(--hrt-muted); }

  @media (max-width: 749px) {
    /* Phones: less air above and below the section. */
    #hrt-{{ section.id }} { padding: 32px 16px; }
    /* Phones: the line under the heading goes; laptops keep it. */
    #hrt-{{ section.id }} .hrt__lead { display: none; }
    #hrt-{{ section.id }} .hrt__signs { gap: 8px; }
    #hrt-{{ section.id }} .hrt__sign { font-size: 13.5px; min-height: 42px; }
    /* Phones: first the opening signs wrapped in a few rows with a "See more" button.
       Tapping it turns the list into three rows that scroll sideways, edge to edge,
       with the chips sliding in one after another. */
    #hrt-{{ section.id }} .hrt__signs:not(.is-open) .hrt__sign:nth-child(n + {{ s.mobile_signs | plus: 1 }}) { display: none; }
    {%- if more > 0 %}
    #hrt-{{ section.id }} .hrt__more { display: inline-flex; align-items: center; margin-top: 12px; }
    {%- else %}
    #hrt-{{ section.id }} .hrt__more { display: none; }
    {%- endif %}
    #hrt-{{ section.id }} .hrt__signs.is-open .hrt__track { display: flex; flex-wrap: wrap; gap: 8px; width: var(--hrt-track, max-content); }
    #hrt-{{ section.id }} .hrt__signs.is-open { display: block; overflow-x: auto; margin: 0 -16px; padding: 2px 16px 10px; scroll-padding-inline: 16px; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
    #hrt-{{ section.id }} .hrt__signs.is-open::-webkit-scrollbar { display: none; }
    #hrt-{{ section.id }} .hrt__signs.is-open .hrt__sign { animation: hrt-in-{{ section.id }} .45s cubic-bezier(.2, .9, .25, 1) both; animation-delay: calc(var(--i, 0) * 35ms); }
    #hrt-{{ section.id }} .hrt__res { min-height: 230px; }
    #hrt-{{ section.id }} .hrt__btn { width: 100%; }
  }
  {%- if desk_more > 0 %}
  /* Laptops: the first few signs, then View more / View less. */
  @media (min-width: 750px) {
    #hrt-{{ section.id }} .hrt__signs:not(.is-open) .hrt__sign:nth-child(n + {{ s.desktop_signs | plus: 1 }}) { display: none; }
    #hrt-{{ section.id }} .hrt__more { display: inline-flex; align-items: center; margin-top: 14px; }
    #hrt-{{ section.id }} .hrt__signs.is-open .hrt__sign { animation: hrt-in-{{ section.id }} .45s cubic-bezier(.2, .9, .25, 1) both; animation-delay: calc((var(--i, 0) - {{ s.desktop_signs }}) * 35ms); }
  }
  {%- endif %}
  @keyframes hrt-in-{{ section.id }} { from { opacity: 0; transform: translateX(18px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    #hrt-{{ section.id }} .hrt__signs.is-open .hrt__sign { animation: none; }
    #hrt-{{ section.id }} .hrt__res > div { transition: none; }
  }
  /* Big screens: the same zoom steps as the rest of the site, so it does not stay small on a 4K screen.
     The space above and below grows with it (--sz from theme.liquid), so the band is not cramped. */
  @media (min-width: 1680px) { #hrt-{{ section.id }} { padding-top: calc(64px * var(--sz, 1)); padding-bottom: calc(64px * var(--sz, 1)); } }
  @media (min-width: 1680px) { #hrt-{{ section.id }} .hrt__inner { zoom: 1.12; } }
  @media (min-width: 1920px) { #hrt-{{ section.id }} .hrt__inner { zoom: 1.25; } }
  @media (min-width: 2240px) { #hrt-{{ section.id }} .hrt__inner { zoom: 1.45; } }
  @media (min-width: 2560px) { #hrt-{{ section.id }} .hrt__inner { zoom: 1.65; } }
  @media (min-width: 3200px) { #hrt-{{ section.id }} .hrt__inner { zoom: 2; } }
  @media (min-width: 3840px) { #hrt-{{ section.id }} .hrt__inner { zoom: 2.4; } }
  /* Site type scale (Health Score 360): heading 30px phones, 38px tablets, up to 52px laptops; the line under it 15 / 16 / 17px. */
  #hrt-{{ section.id }} .hrt__lead { font-size: 17px; }
  @media (min-width: 750px) and (max-width: 1099.98px) { #hrt-{{ section.id }} h2 { font-size: 38px; } #hrt-{{ section.id }} .hrt__lead { font-size: 16px; } }
  @media (max-width: 749.98px) { #hrt-{{ section.id }} h2 { font-size: 30px !important; } #hrt-{{ section.id }} .hrt__lead { font-size: 15px; } }
</style>

<section id="hrt-{{ section.id }}">
  <div class="hrt__inner">
    <h2>{{ s.heading }}</h2>
    {%- if s.lead != blank -%}<p class="hrt__lead">{{ s.lead }}</p>{%- endif -%}

    <p class="hrt__ask">{{ s.step_1 }}<span aria-live="polite"><span class="hrt__n">{{ s.hint }}</span><button type="button" class="hrt__clear" hidden>Clear</button></span></p>
    <div class="hrt__signs" role="group" aria-label="{{ s.step_1 | escape }}"><div class="hrt__track">
      {%- for b in signs -%}
        <button type="button" class="hrt__sign" style="--i: {{ forloop.index0 }}" aria-pressed="false" data-sign="{{ b.settings.label | strip | escape }}" {{ b.shopify_attributes }}>
          <span class="hrt__ic" aria-hidden="true"><svg class="plus" viewBox="0 0 16 16"><path d="M8 3v10M3 8h10"/></svg><svg class="tick" viewBox="0 0 16 16"><path d="M3 8.5l3.2 3L13 4.5"/></svg></span>{{ b.settings.label }}
        </button>
      {%- endfor -%}
    </div></div>
    {%- if more > 0 or desk_more > 0 -%}<button type="button" class="hrt__more" aria-expanded="false"><span class="hrt__more-t">See more</span><svg class="hrt__chev" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6l4 4 4-4"/></svg></button>{%- endif -%}

    <div class="hrt__res" aria-live="polite">
      <div class="hrt__idle">
        <svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="21" cy="21" r="13"/><path d="M31 31l10 10M16 21h10M21 16v10"/></svg>
        <p>{{ s.idle_text }}</p>
      </div>
      <div class="hrt__ans">
        <small>{{ s.top_label }}</small>
        <b></b>
        <p class="hrt__why"></p>
        <p class="hrt__also"></p>
        <a href="#" hidden></a>
      </div>
    </div>
    <ul class="hrt__data" hidden>
      {%- for b in roots -%}
        {%- assign r = b.settings -%}
        <li data-signs="{{ r.signs | escape }}" data-title="{{ r.title | escape }}" data-text="{{ r.text | escape }}" data-link="{{ r.link | escape }}" data-link-label="{{ r.link_label | default: 'See what helps' | escape }}" {{ b.shopify_attributes }}></li>
      {%- endfor -%}
    </ul>

    <div class="hrt__foot">
      {%- if s.button != blank -%}<a class="hrt__btn" href="{{ s.button_link }}">{{ s.button }}</a>{%- endif -%}
      {%- if s.note != blank -%}<p class="hrt__note">{{ s.note }}</p>{%- endif -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var el = document.getElementById('hrt-{{ section.id }}');
    if (!el) return;
    var tiles = [].slice.call(el.querySelectorAll('.hrt__sign'));
    var ans = el.querySelector('.hrt__ans'), link = ans.querySelector('a');
    var nEl = el.querySelector('.hrt__n'), hint = nEl.textContent, clear = el.querySelector('.hrt__clear');
    var also = {{ s.also_label | json }}, last = '', swapT;
    var roots = [].slice.call(el.querySelectorAll('.hrt__data li')).map(function (li, i) {
      return { d: li.dataset, i: i, signs: li.dataset.signs.split(',').map(function (x) { return x.trim().toLowerCase(); }) };
    });

    function fill(best, rest) {
      ans.querySelector('b').textContent = best.d.title;
      ans.querySelector('.hrt__why').textContent = best.d.text;
      ans.querySelector('.hrt__also').textContent = rest.length ? also + ' ' + rest.map(function (r) { return r.d.title; }).join(', ') : '';
      link.hidden = !best.d.link;
      link.href = best.d.link || '#';
      link.textContent = best.d.linkLabel;
    }

    function update() {
      var on = tiles.filter(function (t) { return t.getAttribute('aria-pressed') === 'true'; }).map(function (t) { return t.dataset.sign.toLowerCase(); });
      roots.forEach(function (r) { r.n = on.filter(function (x) { return r.signs.indexOf(x) > -1; }).length; });
      var hit = roots.filter(function (r) { return r.n > 0; }).sort(function (a, b) { return b.n - a.n || a.i - b.i; });
      nEl.textContent = on.length ? on.length + ' selected' : hint;
      clear.hidden = !on.length;
      el.classList.toggle('is-picked', hit.length > 0);
      if (!hit.length) { last = ''; return; }
      var best = hit[0], rest = hit.slice(1, 3);
      if (!last || best.d.title === last) { fill(best, rest); last = best.d.title; return; }
      last = best.d.title;
      ans.classList.add('is-swap');
      clearTimeout(swapT);
      swapT = setTimeout(function () { fill(best, rest); ans.classList.remove('is-swap'); }, 180);
    }

    tiles.forEach(function (t) {
      t.addEventListener('click', function () {
        t.setAttribute('aria-pressed', t.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
        update();
      });
    });
    clear.addEventListener('click', function () { tiles.forEach(function (t) { t.setAttribute('aria-pressed', 'false'); }); update(); });
    var more = el.querySelector('.hrt__more');
    var list = el.querySelector('.hrt__signs');
    // Phones say See more / See less, laptops View more / View less.
    var wide = matchMedia('(min-width: 750px)');
    var track = el.querySelector('.hrt__track');
    function label() { if (!more) return; var open = list.classList.contains('is-open'); more.querySelector('.hrt__more-t').textContent = wide.matches ? (open ? 'View less' : 'View more') : (open ? 'See less' : 'See more'); }
    // Phones, open: pick the narrowest track width that lays the chips out in 3 rows, each chip its own width.
    function fit() {
      if (wide.matches || !list.classList.contains('is-open')) return;
      var chips = tiles.filter(function (c) { return c.offsetWidth; }), gap = 8;
      var total = chips.reduce(function (s, c) { return s + c.offsetWidth + gap; }, 0), widest = Math.max.apply(null, chips.map(function (c) { return c.offsetWidth; }));
      var w = Math.max(Math.ceil(total / 3), widest), rows;
      do { track.style.setProperty('--hrt-track', w + 'px'); rows = new Set(chips.map(function (c) { return c.offsetTop; })).size; w += 12; } while (rows > 3 && w < total + 12);
    }
    window.addEventListener('resize', fit);
    label();
    if (wide.addEventListener) wide.addEventListener('change', label);
    if (more) more.addEventListener('click', function () {
      var open = !list.classList.contains('is-open');
      list.classList.toggle('is-open', open);
      more.setAttribute('aria-expanded', open ? 'true' : 'false');
      label();
      if (open) fit(); else list.scrollLeft = 0;
    });
  })();
</script>

{% schema %}
{
  "name": "Her: symptom roots",
  "tag": "div",
  "settings": [
    { "type": "color", "id": "section_bg", "label": "Section background", "default": "#ffffff" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your symptoms are clues." },
    { "type": "textarea", "id": "lead", "label": "Lead" },
    { "type": "text", "id": "step_1", "label": "Prompt above the signs", "default": "Tap everything you notice" },
    { "type": "text", "id": "hint", "label": "Hint before anything is picked", "default": "(one or more)" },
    { "type": "text", "id": "idle_text", "label": "Result card before anything is picked", "default": "Your result will appear here. Tap at least one sign above." },
    { "type": "text", "id": "top_label", "label": "Label above the strongest cause", "default": "Most of your signs point to" },
    { "type": "text", "id": "also_label", "label": "Label before other causes", "default": "Also linked:" },
    { "type": "range", "id": "mobile_signs", "label": "Signs shown on phones before See more", "min": 3, "max": 10, "step": 1, "default": 6 },
    { "type": "range", "id": "desktop_signs", "label": "Signs shown on laptops before View more", "info": "0 = show all, no button.", "min": 0, "max": 12, "step": 1, "default": 0 },
    { "type": "text", "id": "button", "label": "Button" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "note", "label": "Small note" }
  ],
  "blocks": [
    {
      "type": "sign", "name": "Sign",
      "settings": [{ "type": "text", "id": "label", "label": "Sign", "default": "Irregular periods" }]
    },
    {
      "type": "root", "name": "Root cause",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Root cause" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "textarea", "id": "signs", "label": "Signs that point here", "info": "Comma separated, written exactly like the sign pills." },
        { "type": "text", "id": "link", "label": "Link", "info": "A page, or #name of a shelf on this page." },
        { "type": "text", "id": "link_label", "label": "Link text", "default": "See what helps" }
      ]
    }
  ],
  "presets": [{ "name": "Her: symptom roots" }]
}
{% endschema %}
