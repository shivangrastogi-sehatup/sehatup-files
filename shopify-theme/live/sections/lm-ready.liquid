{%- assign s = section.settings -%}
<section class="lm-sec{% if s.tone != 'white' %} lm-sec--stone{% endif %}{% if s.card_style == 'tinted' %} lm-ready--tinted{% endif %}{% if s.head_align == 'left' %} lm-ready--left{% endif %}" style="--lm-oi: {{ s.icon_size }}px;">
  <div class="lm-wrap">
    <div class="lm-head">
      <h2 class="lm-h2">{{ s.heading }}{% if s.highlight != blank %} <span class="lm-mark">{{ s.highlight }}</span>{% endif %}</h2>
      {%- if s.subheading != blank -%}<p class="lm-sub">{{ s.subheading }}</p>{%- endif -%}
    </div>
    <ul class="lm-cards3{% if section.blocks.size == 2 %} lm-cards3--two{% endif %}">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li {{ block.shopify_attributes }}>
          <div class="lm-opt{% if b.highlight %} lm-opt--hi{% endif %}">
            <span class="lm-opt__media" aria-hidden="true">
              {%- case b.icon -%}
                {%- when 'pulse' -%}<svg viewBox="0 0 24 24"><path d="M3 12h4l2.5-6 4 12 2.5-6H21"/></svg>
                {%- when 'alert' -%}<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.5M12 16.5v.01"/></svg>
                {%- when 'heart' -%}<svg viewBox="0 0 24 24"><path d="M20.4 5.6a5 5 0 0 0-7.1 0L12 6.9l-1.3-1.3a5 5 0 0 0-7.1 7.1L12 21l8.4-8.3a5 5 0 0 0 0-7.1z"/></svg>
                {%- when 'doctor' -%}<svg viewBox="0 0 24 24"><path d="M6 3.5H5a1 1 0 0 0-1 1V9a5 5 0 0 0 10 0V4.5a1 1 0 0 0-1-1h-1"/><path d="M9 14v1.5a4.5 4.5 0 0 0 9 0V13"/><circle cx="18" cy="11" r="2"/></svg>
                {%- when 'whatsapp' -%}<svg viewBox="0 0 24 24"><path d="M20.5 11.6a8.5 8.5 0 0 1-12.4 7.6L3.5 20.5l1.3-4.4a8.5 8.5 0 1 1 15.7-4.5z"/><path d="M9 8.3c-.4 0-.9.5-.9 1.3 0 2.6 3 5.7 5.7 5.7.8 0 1.3-.5 1.3-.9v-1l-1.9-.8-.7.9a4.7 4.7 0 0 1-2.6-2.6l.9-.7-.8-1.9z"/></svg>
                {%- else -%}<svg viewBox="0 0 24 24"><rect x="5" y="4" width="14" height="17" rx="2.5"/><path d="M9 4V3h6v1M8.5 11l1.6 1.6 3-3M8.5 16.5l1.6 1.6 3-3"/></svg>
              {%- endcase -%}
            </span>
            <b class="lm-opt__title">{{ b.title }}</b>
            {%- if b.text != blank -%}<p class="lm-opt__text">{{ b.text }}</p>{%- endif -%}
            {%- if b.button != blank -%}
              <a class="lm-btn {% if b.highlight %}lm-btn--red{% else %}lm-btn--line{% endif %}" href="{{ b.link | default: '#book' }}"{% if b.link contains 'wa.me' %} target="_blank" rel="noopener"{% endif %}>{{ b.button }}<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "LM always here",
  "tag": "div",
  "max_blocks": 3,
  "settings": [
    { "type": "select", "id": "card_style", "label": "Card style", "default": "plain", "options": [{ "value": "plain", "label": "White card" }, { "value": "tinted", "label": "Soft gradient card, button below" }] },
    { "type": "select", "id": "head_align", "label": "Heading", "default": "center", "options": [{ "value": "center", "label": "Centred" }, { "value": "left", "label": "Left" }] },
    { "type": "select", "id": "tone", "label": "Background", "default": "stone", "options": [{ "value": "stone", "label": "Stone" }, { "value": "white", "label": "White" }] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We are always here," },
    { "type": "text", "id": "highlight", "label": "Heading part with the highlighter", "default": "when you are ready." },
    { "type": "textarea", "id": "subheading", "label": "Line under the heading" },
    {"type":"header","content":"Sizes"},
    {"type":"range","id":"icon_size","label":"Icon size","min":20,"max":64,"step":2,"unit":"px","default":34}
  ],
  "blocks": [
    { "type": "option", "name": "Option", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "options": [
        { "value": "doctor", "label": "Stethoscope" }, { "value": "list", "label": "Checklist" }, { "value": "whatsapp", "label": "WhatsApp" }, { "value": "pulse", "label": "Pulse line" }, { "value": "alert", "label": "Exclamation circle" }, { "value": "heart", "label": "Heart" } ], "default": "list" },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "textarea", "id": "text", "label": "Text" },
      { "type": "text", "id": "button", "label": "Button" },
      { "type": "url", "id": "link", "label": "Button link", "info": "Empty goes to the booking form." },
      { "type": "checkbox", "id": "highlight", "label": "Highlight this option", "default": false }
    ] }
  ],
  "presets": [{ "name": "LM always here" }]
}
{% endschema %}
