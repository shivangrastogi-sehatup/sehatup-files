{%- assign s = section.settings -%}
<footer class="lm-foot" style="--lm-fl: {{ s.logo_width }}px;">
  <div class="lm-wrap">
    <div class="lm-foot__top">
      <div class="lm-foot__brand">
        <a href="{{ routes.root_url }}" class="lm-foot__logo" aria-label="sehatUP home">
          {%- if s.logo != blank -%}{{ s.logo | image_url: width: 400 | image_tag: alt: 'sehatUP', loading: 'lazy', widths: '200, 400', sizes: '180px' }}{%- endif -%}
        </a>
        {%- if s.heading != blank -%}<p class="lm-foot__h">{{ s.heading }}</p>{%- endif -%}
        {%- if s.tagline != blank -%}<p class="lm-foot__p">{{ s.tagline }}</p>{%- endif -%}
        <ul class="lm-foot__contact">
          {%- if s.phone != blank -%}<li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg><a href="tel:{{ s.phone | remove: ' ' | remove: '-' }}">{{ s.phone }}</a></li>{%- endif -%}
          {%- if s.email != blank -%}<li><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="M3.5 7l8.5 6 8.5-6"/></svg><a href="mailto:{{ s.email }}">{{ s.email }}</a></li>{%- endif -%}
          {%- if s.address != blank -%}<li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-6.2 7-11.5a7 7 0 0 0-14 0C5 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg><span>{{ s.address }}</span></li>{%- endif -%}
        </ul>
      </div>
      {%- for i in (1..3) -%}
        {%- assign tk = 'menu_' | append: i | append: '_title' -%}
        {%- assign mk = 'menu_' | append: i -%}
        {%- if s[mk] != blank -%}
          <nav class="lm-foot__col" aria-label="{{ s[tk] | escape }}">
            {%- if s[tk] != blank -%}<p class="lm-foot__t">{{ s[tk] }}</p>{%- endif -%}
            <ul>
              {%- for link in linklists[s[mk]].links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="lm-foot__bottom">
      <p>{{ s.copyright }}</p>
      <div class="lm-foot__social">
        {%- if s.facebook != blank -%}<a href="{{ s.facebook }}" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24"><path d="M14 8.5V7c0-.8.5-1.2 1.2-1.2H17V2.5h-2.6C11.8 2.5 10.5 4 10.5 6.4v2.1H8V12h2.5v9.5H14V12h2.6l.4-3.5z"/></svg></a>{%- endif -%}
        {%- if s.instagram != blank -%}<a href="{{ s.instagram }}" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24"><path d="M7 2C4.2 2 2 4.2 2 7v10c0 2.8 2.2 5 5 5h10c2.8 0 5-2.2 5-5V7c0-2.8-2.2-5-5-5H7zm5 5a5 5 0 110 10 5 5 0 010-10zm0 2.2A2.8 2.8 0 1014.8 12 2.8 2.8 0 0012 9.2zM17.5 6.5a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z"/></svg></a>{%- endif -%}
        {%- if s.linkedin != blank -%}<a href="{{ s.linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn"><svg viewBox="0 0 24 24"><path d="M4 3a2 2 0 100 4 2 2 0 000-4zm-2 6h4v12H2zm7 0h4v2c.7-1.2 2.3-2 4-2 3.3 0 5 2.2 5 6v6h-4v-5.5c0-2-.7-3.3-2.5-3.3-1.7 0-2.5 1.2-2.5 3.3V21H9z"/></svg></a>{%- endif -%}
        {%- if s.youtube != blank -%}<a href="{{ s.youtube }}" target="_blank" rel="noopener" aria-label="YouTube"><svg viewBox="0 0 24 24"><path d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4a2.5 2.5 0 0 0-1.8 1.8C2 8.8 2 12 2 12s0 3.2.4 4.8a2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8c.4-1.6.4-4.8.4-4.8s0-3.2-.4-4.8zM10 15V9l5.2 3z"/></svg></a>{%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "LM footer",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo (light version)" },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 100, "max": 240, "step": 4, "unit": "px", "default": 160 },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One You. One Health. One sehatUP." },
    { "type": "textarea", "id": "tagline", "label": "Line under the heading" },
    { "type": "text", "id": "phone", "label": "Phone" },
    { "type": "text", "id": "email", "label": "Email" },
    { "type": "text", "id": "address", "label": "Address" },
    { "type": "header", "content": "Link columns" },
    { "type": "text", "id": "menu_1_title", "label": "Column 1 title", "default": "Quick Links" },
    { "type": "link_list", "id": "menu_1", "label": "Column 1 menu" },
    { "type": "text", "id": "menu_2_title", "label": "Column 2 title", "default": "Support" },
    { "type": "link_list", "id": "menu_2", "label": "Column 2 menu" },
    { "type": "text", "id": "menu_3_title", "label": "Column 3 title", "default": "Company" },
    { "type": "link_list", "id": "menu_3", "label": "Column 3 menu" },
    { "type": "header", "content": "Bottom row" },
    { "type": "text", "id": "copyright", "label": "Copyright", "default": "© 2026 sehatUP. All rights reserved." },
    { "type": "url", "id": "facebook", "label": "Facebook link" },
    { "type": "url", "id": "instagram", "label": "Instagram link" },
    { "type": "url", "id": "linkedin", "label": "LinkedIn link" },
    { "type": "url", "id": "youtube", "label": "YouTube link" }
  ],
  "presets": [{ "name": "LM footer" }]
}
{% endschema %}
