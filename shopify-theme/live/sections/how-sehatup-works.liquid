{%- liquid
  assign hf = section.settings.heading_font
  assign bf = section.settings.body_font
  assign scale = section.settings.type_scale | default: 100 | divided_by: 100.0
-%}

{% style %}
  {%- unless section.settings.use_theme_fonts -%}
    {{ hf | font_face: font_display: 'swap' }}
    {{ bf | font_face: font_display: 'swap' }}
    {%- assign bf_med = bf | font_modify: 'weight', '500' -%}
    {%- if bf_med -%}{{ bf_med | font_face: font_display: 'swap' }}{%- endif -%}
  {%- endunless -%}

  #shopify-section-{{ section.id }} {
    --hsw-bg: {{ section.settings.color_bg }};
    --hsw-title: {{ section.settings.color_title }};
    --hsw-accent: {{ section.settings.color_accent }};
    --hsw-sub: {{ section.settings.color_sub }};
    --hsw-step-title: {{ section.settings.color_step_title }};
    --hsw-step-text: {{ section.settings.color_step_text }};
    --hsw-disc: {{ section.settings.color_disc }};
    --hsw-badge: {{ section.settings.color_badge }};
    --hsw-badge-text: {{ section.settings.color_badge_text }};
    --hsw-btn: {{ section.settings.color_button }};
    --hsw-btn-text: {{ section.settings.color_button_text }};
    --hsw-scale: {{ scale }};
    --hsw-maxw: {{ section.settings.container_width | default: 1320 }}px;
    --hsw-pad-top: {{ section.settings.padding_top }}px;
    --hsw-pad-bottom: {{ section.settings.padding_bottom }}px;
    {%- if section.settings.use_theme_fonts -%}
      --hsw-font-head: var(--font-heading-family, inherit);
      --hsw-font-body: var(--font-body-family, inherit);
    {%- else -%}
      --hsw-font-head: {{ hf.family }}, {{ hf.fallback_families }};
      --hsw-font-body: {{ bf.family }}, {{ bf.fallback_families }};
    {%- endif -%}
  }

  .hsw {
    background: var(--hsw-bg);
    font-family: var(--hsw-font-body);
    padding: calc(var(--hsw-pad-top) * .75) 16px calc(var(--hsw-pad-bottom) * .75);
    -webkit-font-smoothing: antialiased;
    overflow: hidden;
  }
  .hsw__inner { max-width: var(--hsw-maxw); margin-inline: auto; }

  .hsw__head { text-align: center; margin-bottom: clamp(28px, 4vw, 64px); }
  .hsw__title {
    margin: 0;
    color: var(--hsw-title);
    font-family: var(--hsw-font-head);
    font-weight: 700;
    font-size: calc(clamp(25px, 3.3vw, 60px) * var(--hsw-scale));
    line-height: 1.08;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  /* the accent word is set in the same ink as the rest of the heading */
  .hsw__title em { font-style: normal; color: inherit; }
  .hsw__sub {
    margin: 10px auto 0;
    max-width: 52ch;
    color: var(--hsw-sub);
    /* was 14px on every screen under 1280 */
    font-size: calc(clamp(16px, 1.3vw, 22px) * var(--hsw-scale));
    line-height: 1.5;
  }

  /* Phones: one step per row, artwork beside the text, joined by a vertical dotted line. */
  .hsw__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }
  /* Phone layout: artwork and title share the top row, and the sentence runs
     the full width underneath. Keeping the text in a 215px column next to the
     artwork stretched step 2 to eleven lines. */
  .hsw__step {
    position: relative;
    display: grid;
    grid-template-columns: clamp(132px, 38vw, 160px) 1fr;
    grid-template-areas:
      "media stepno"
      "media title"
      "text  text";
    grid-template-rows: auto auto auto;
    align-items: center;
    column-gap: 14px;
    row-gap: 8px;
  }
  .hsw__body { display: contents; }
  .hsw__step {
    background: #fdf3f5;
    border-radius: 18px;
    padding: 14px 14px 16px;
  }
  .hsw__stepno {
    grid-area: stepno;
    align-self: end;
    color: var(--hsw-accent);
    font-weight: 600;
    font-size: 13px;
    line-height: 1;
    letter-spacing: .02em;
    /* sits right on top of the title instead of a row-gap away from it */
    margin-bottom: -12px;
  }
  .hsw__media { grid-area: media; }
  .hsw__step-title { grid-area: title; }
  .hsw__step-text { grid-area: text; }
  /* One continuous rail down the left instead of short dotted stubs between
     rows, so the four steps read as one sequence. The gap is bridged as well
     as the row itself, so the line never breaks. */
  .hsw__media { z-index: 1; grid-row: 1 / span 2; align-self: center; }

  .hsw__media { position: relative; }
  .hsw__disc {
    position: relative;
    aspect-ratio: 1;
    width: 100%;
    max-width: 100%;
    border-radius: 50%;
    background: var(--hsw-disc);
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .hsw__disc img,
  .hsw__disc svg {
    width: 88%;
    height: 88%;
    object-fit: contain;
    display: block;
  }
  .hsw__badge {
    position: absolute;
    top: 2%;
    left: 2%;
    z-index: 1;
    width: clamp(26px, 8vw, 34px);
    aspect-ratio: 1;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--hsw-badge);
    color: var(--hsw-badge-text);
    font-weight: 700;
    font-size: clamp(11px, 3vw, 13px);
    box-shadow: 0 4px 10px -4px rgba(238, 32, 74, .6);
  }

  /* the rail number is a phone-only element: above 600px the number sits on
     the artwork instead */
  .hsw__badge--rail { display: none; }

  .hsw__step-title {
    margin: 0 0 6px;
    color: var(--hsw-step-title);
    font-family: var(--hsw-font-head);
    font-weight: 700;
    font-size: calc(clamp(19px, 4.6vw, 22px) * var(--hsw-scale));
    line-height: 1.2;
    text-wrap: balance;
  }
  .hsw__step-text {
    margin: 0;
    color: var(--hsw-step-text);
    /* was 13.5 to 15px: too small to read on a phone */
    font-size: calc(clamp(16px, 3.6vw, 17px) * var(--hsw-scale));
    line-height: 1.55;
  }
  .hsw__arrow { display: none; }
  .hsw__rail { display: none; }

  .hsw__cta-wrap { text-align: center; margin-top: clamp(28px, 4vw, 56px); }
  .hsw__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    /* matches the hero's primary button instead of looking like a small link */
    min-height: 54px;
    padding: 0 clamp(28px, 3vw, 44px);
    border-radius: 999px;
    background: var(--hsw-btn);
    color: var(--hsw-btn-text);
    font-weight: 700;
    font-size: calc(clamp(17px, 1.2vw, 20px) * var(--hsw-scale));
    text-decoration: none;
    box-shadow: 0 12px 26px -14px rgba(238, 32, 74, .75);
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .hsw__cta:active { transform: scale(.975); }
  .hsw__cta:hover { transform: translateY(-2px); box-shadow: 0 16px 30px -14px rgba(238, 32, 74, .8); }
  .hsw__cta:focus-visible { outline: 3px solid var(--hsw-title); outline-offset: 3px; }
  .hsw__cta svg { width: 1em; height: 1em; }

  /* ---- Phones: a vertical timeline. A numbered circle sits on a dotted rail
     down the left, the illustration sits large beside it, and the title and
     sentence run underneath. Each step lights up as you scroll to it. ---- */
  @media (max-width: 599px) {
    .hsw { background: #ffffff; }

    .hsw__steps {
      display: block;
      gap: 0;
      padding: 0;
      margin: 0;
    }

    .hsw__step {
      position: relative;
      display: grid;
      grid-template-columns: 52px minmax(0, 1fr);
      grid-template-areas:
        "num   media"
        "blank title"
        "blank text";
      column-gap: 16px;
      row-gap: 6px;
      align-items: start;
      background: none;
      border-radius: 0;
      padding: 0 0 22px;
      /* the step itself only fades: the number, picture and words carry the
         movement, so nothing slides twice */
      transition: opacity .45s ease;
    }
    .hsw-anim .hsw__step { opacity: 0; }
    .hsw__step.is-in { opacity: 1; }
    .hsw__step:last-child { padding-bottom: 6px; }

    /* the numbered circle, back on show and sitting on the rail */
    .hsw__media .hsw__badge { display: none; }
    .hsw__step .hsw__badge--rail {
      display: grid;
      position: static;
      grid-area: num;
      align-self: center;          /* sits level with the middle of the artwork */
      z-index: 1;
      width: 46px;
      height: 46px;
      /* pale until you reach the step, then the circle itself fills crimson.
         No white collar: the dotted rail runs behind the circle. */
      background: #fbe6ec;
      color: var(--hsw-step-title);
      font-size: 17px;
      font-weight: 700;
      letter-spacing: .01em;
      position: relative;
      box-shadow: none;
      transition: transform .5s cubic-bezier(.34,1.4,.5,1),
                  opacity .4s ease,
                  background .3s ease,
                  color .3s ease;
    }
    .hsw-anim .hsw__badge--rail { transform: scale(.82); opacity: 0; }
    .hsw__step.is-in .hsw__badge--rail { transform: none; opacity: 1; }
    .hsw__step.is-lit .hsw__badge--rail {
      background: var(--hsw-accent);
      color: #ffffff;
    }
    .hsw__badge-n { position: relative; z-index: 1; }

    /* One rail for the whole list. It used to be one dotted segment per step,
       and every segment restarted its dot rhythm at its own top, which is what
       made the line look broken between the steps. JS sets its start and end
       from the first and last number, so it runs 01 to 04 without a join. */
    .hsw__step::after { content: none; }

    .hsw__steps { position: relative; }
    .hsw__rail {
      display: block;
      position: absolute;
      left: var(--rail-left, 22px);
      top: var(--rail-top, 95px);
      height: var(--rail-h, 0px);
      width: 2px;
      width: 3px;
      background-image: radial-gradient(circle at 1.5px 1.5px, #eab5c5 1.5px, transparent 1.7px);
      background-size: 3px 6px;
      background-repeat: repeat-y;
    }
    /* the crimson line the scroll draws over the pale one, dot for dot */
    /* The crimson dots are clipped to --rail-p, a single 0 to 1 value the
       script updates on every scroll frame. One source of truth means the line
       and the numbers can never disagree: a number only fills once the line
       has actually reached it. */
    .hsw__rail-fill {
      position: absolute;
      inset: 0;
      background-image: radial-gradient(circle at 1.5px 1.5px, var(--hsw-accent) 1.5px, transparent 1.7px);
      background-size: 3px 6px;
      background-repeat: repeat-y;
      clip-path: inset(0 0 calc((1 - var(--rail-p, 0)) * 100%) 0);
    }

    /* ...and none below the last one: the rail has to cross the gap from the
       step above down to this number, then stop there. Without this the last
       step drew nothing and the dots ended a full artwork above the 04. */

    /* the illustration, large, in its own soft circle */
    .hsw__media {
      grid-area: media;
      width: min(52vw, 190px);
      grid-row: auto;
      justify-self: start;

    }
    .hsw__disc {
      border-radius: 50%;
      aspect-ratio: 1;
      transition: transform .6s cubic-bezier(.22,.9,.3,1) .1s, opacity .5s ease .1s;
    }
    .hsw-anim .hsw__disc { transform: scale(.9); opacity: 0; }
    .hsw__step.is-in .hsw__disc { transform: none; opacity: 1; }
    .hsw__disc img,
    .hsw__disc svg {
      width: 82%;
      height: 82%;
      transition: transform .6s cubic-bezier(.22,.9,.3,1) .26s, opacity .5s ease .26s;
    }
    .hsw-anim .hsw__disc img,
    .hsw-anim .hsw__disc svg { transform: translateY(8px); opacity: 0; }
    .hsw__step.is-in .hsw__disc img,
    .hsw__step.is-in .hsw__disc svg { transform: none; opacity: 1; }

    /* the words follow the picture in, a beat later */
    .hsw__step-title,
    .hsw__step-text {
      transition: opacity .5s ease, transform .5s cubic-bezier(.22,.7,.3,1);
    }
    .hsw-anim .hsw__step-title,
    .hsw-anim .hsw__step-text { opacity: 0; transform: translateY(10px); }
    .hsw__step.is-in .hsw__step-title { opacity: 1; transform: none; transition-delay: .3s; }
    .hsw__step.is-in .hsw__step-text  { opacity: 1; transform: none; transition-delay: .4s; }

    /* the written "Step 1" label is replaced by the numbered circle */
    .hsw__stepno { display: none; }

    .hsw__step-title { grid-area: title; margin: 10px 0 0; }
    .hsw__step-text { grid-area: text; margin-top: 5px; }

    @media (prefers-reduced-motion: reduce) {
      .hsw-anim .hsw__step,
      .hsw-anim .hsw__badge--rail,
      .hsw-anim .hsw__disc,
      .hsw-anim .hsw__disc img,
      .hsw-anim .hsw__disc svg,
      .hsw-anim .hsw__step-title,
      .hsw-anim .hsw__step-text {
        opacity: 1;
        transform: none;
        transition: none;
        animation: none;
      }
      .hsw__rail-fill { clip-path: inset(0 0 0 0); }
    }
  }

  /* Very small phones (e.g. 320px): narrower artwork column. */
  @media (max-width: 359px) {
    .hsw__step { grid-template-columns: 46px minmax(0, 1fr); column-gap: 12px; }
    .hsw__step::after { left: 19px; }
    .hsw__step .hsw__badge--rail { width: 40px; height: 40px; font-size: 15px; }
  }


  /* Large phones and tablets: two by two grid, artwork above the text. */
  @media (min-width: 600px) {
    .hsw { padding-inline: 24px; }
    /* rows line up because each step is its own grid with the text on one row */
    .hsw__steps { grid-template-columns: repeat(2, 1fr); gap: 32px 32px; align-items: start; }
    .hsw__step { grid-template-columns: 1fr; grid-template-areas: "media" "body"; grid-template-rows: auto 1fr; align-content: start; justify-items: center; text-align: center; }
    /* every title reserves two lines, so the sentences underneath start at the
       same height in all four columns (titles wrap to one or two lines) */
    .hsw__body { display: block; grid-area: body; }
    .hsw__media { grid-row: auto; align-self: start; }
    .hsw__step-title, .hsw__step-text { grid-area: auto; }
    .hsw__step-title { min-height: 2.4em; }
    .hsw__stepno { display: none; }
    .hsw__step-title, .hsw__step-text { grid-area: auto; }
    .hsw__step::after { display: none; }
    .hsw__step { background: none; padding: 0; border-radius: 0; }
    .hsw__media { width: clamp(150px, 26vw, 200px); }
    .hsw__step-text { max-width: 32ch; margin-inline: auto; }

    /* no entrance animation above 600px: the four columns are simply there */
    .hsw-anim .hsw__step { opacity: 1; transform: none; }

    /* answering a pointer: the artwork lifts and the number warms up */
    .hsw__media { transition: transform .35s cubic-bezier(.22,.9,.3,1); }
    .hsw__disc { transition: box-shadow .35s ease; }
    .hsw__step:hover .hsw__media { transform: translateY(-6px); }
    /* the picture grows inside the circle, which clips it, so the disc keeps
       its shape and the shadow stays a circle */
    .hsw__disc { transition: box-shadow .35s ease, transform .35s cubic-bezier(.22,.9,.3,1); }
    .hsw__disc img,
    .hsw__disc svg { transition: transform .45s cubic-bezier(.22,.9,.3,1); }
    .hsw__step:hover .hsw__disc {
      transform: scale(1.02);
      box-shadow: 0 16px 30px -16px rgba(238, 32, 74, .45);
    }
    .hsw__step:hover .hsw__disc img,
    .hsw__step:hover .hsw__disc svg { transform: scale(1.12); }
    /* the number stays put on hover: only the artwork responds */

    @media (prefers-reduced-motion: reduce) {
      .hsw-anim .hsw__step { opacity: 1; transform: none; transition: none; }
      .hsw__media, .hsw__disc, .hsw__badge { transition: none; }
      .hsw__step:hover .hsw__media { transform: none; }
    }
  }

  /* Laptops and desktops: four in a row with dotted arrows between. */
  @media (min-width: 990px) {
    .hsw { padding: var(--hsw-pad-top) 32px var(--hsw-pad-bottom); }
    .hsw__steps { grid-template-columns: repeat(4, 1fr); gap: 24px; }
    .hsw__step { justify-items: start; text-align: left; }
    .hsw__step { --hsw-disc-w: min(100%, clamp(160px, 15vw, 240px)); }
    .hsw__media { width: var(--hsw-disc-w); }
    .hsw__step-text { margin-inline: 0; }
    .hsw__arrow {
      display: block;
      position: absolute;
      top: calc(var(--hsw-disc-w) / 2);
      left: calc(var(--hsw-disc-w) + 14px);
      right: -10px;
      height: 12px;
      transform: translateY(-50%);
      color: var(--hsw-accent);
      pointer-events: none;
    }
    .hsw__arrow::before {
      content: "";
      position: absolute;
      left: 15%;
      right: calc(15% + 10px);
      top: 50%;
      border-top: 2px dotted currentColor;
      opacity: .7;
    }
    .hsw__arrow::after {
      content: "";
      position: absolute;
      right: calc(15% + 1px);
      top: 50%;
      width: 8px;
      height: 8px;
      border-top: 2px solid currentColor;
      border-right: 2px solid currentColor;
      transform: translateY(-50%) rotate(45deg);
    }
    .hsw__step:last-child .hsw__arrow { display: none; }
    .hsw__step-title { font-size: calc(clamp(19px, 1.6vw, 30px) * var(--hsw-scale)); }
    .hsw__step-text { font-size: calc(clamp(14px, 1.05vw, 19px) * var(--hsw-scale)); }
    .hsw__badge { width: clamp(32px, 2.6vw, 48px); font-size: clamp(12px, 1vw, 17px); }
  }

  /* 2K and 4K: let the section grow instead of floating in a narrow column. */
  @media (min-width: 1920px) {
    .hsw__inner { max-width: calc(var(--hsw-maxw) * 1.25); }
    /* artwork grows with the type instead of staying at 240px */
    .hsw__step { --hsw-disc-w: min(100%, 300px); }
  }
  @media (min-width: 2560px) {
    .hsw__inner { max-width: calc(var(--hsw-maxw) * 1.6); }
    .hsw__step { --hsw-disc-w: min(100%, 380px); }
  }
  @media (min-width: 3400px) {
    .hsw__inner { max-width: calc(var(--hsw-maxw) * 2.1); }
    .hsw__step { --hsw-disc-w: min(100%, 460px); }
  }

  /* Same heading size as the "Why care isn't working" section, including its 2K and 4K step-ups. */
  @media (min-width: 2000px) { .hsw__title { font-size: calc(clamp(25px, 3.3vw, 60px) * var(--hsw-scale) * 1.12); } }
  @media (min-width: 2800px) { .hsw__title { font-size: calc(clamp(25px, 3.3vw, 60px) * var(--hsw-scale) * 1.28); } }

  @media (hover: hover) and (min-width: 990px) {
    .hsw__disc { transition: transform .3s ease; }
    .hsw__step:hover .hsw__disc { transform: translateY(-4px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hsw__cta, .hsw__disc { transition: none; }
    .hsw__cta:hover, .hsw__step:hover .hsw__disc { transform: none; }
  }
{% endstyle %}

<section class="hsw" aria-labelledby="hsw-title-{{ section.id }}">
  <div class="hsw__inner">
    <header class="hsw__head">
      <h2 class="hsw__title" id="hsw-title-{{ section.id }}">
        {{- section.settings.heading_before | escape }}
        {% if section.settings.heading_accent != blank %}<em>{{ section.settings.heading_accent | escape }}</em>{% endif %}
        {{ section.settings.heading_after | escape -}}
      </h2>
      {%- if section.settings.subheading != blank -%}
        <p class="hsw__sub">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </header>

    <ol class="hsw__steps">
      <span class="hsw__rail" aria-hidden="true"><span class="hsw__rail-fill"></span></span>
      {%- for block in section.blocks -%}
        {%- capture num -%}{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}{%- endcapture -%}
        <li class="hsw__step" {{ block.shopify_attributes }}>
          {%- comment -%} phone only: the number sits on the rail, not on the artwork {%- endcomment -%}
          <span class="hsw__badge hsw__badge--rail" aria-hidden="true">
            <span class="hsw__badge-n">{{ num }}</span>
          </span>
          <div class="hsw__media">
            <span class="hsw__badge" aria-hidden="true">{{ num }}</span>
            <div class="hsw__disc">
              {%- if block.settings.image != blank -%}
                {%- assign alt = block.settings.image.alt | default: block.settings.title -%}
                {{
                  block.settings.image
                  | image_url: width: 960
                  | image_tag:
                    loading: 'lazy',
                    decoding: 'async',
                    widths: '120, 180, 240, 320, 400, 480, 640, 800, 960',
                    sizes: '(min-width: 3400px) 480px, (min-width: 2560px) 380px, (min-width: 1920px) 300px, (min-width: 990px) 15vw, (min-width: 600px) 26vw, 120px',
                    alt: alt
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
          </div>
          <div class="hsw__body">
            <span class="hsw__stepno" aria-hidden="true">Step {{ forloop.index }}</span>
            {%- if block.settings.title != blank -%}
              <h3 class="hsw__step-title"><span class="visually-hidden">Step {{ forloop.index }}: </span>{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="hsw__step-text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </div>
          <span class="hsw__arrow" aria-hidden="true"></span>
        </li>
      {%- endfor -%}
    </ol>


    {%- if section.settings.button_label != blank -%}
      <div class="hsw__cta-wrap">
        <a class="hsw__cta" href="{{ section.settings.button_link | default: '#' }}">
          {{ section.settings.button_label | escape }}
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>


<script>
  (() => {
    const root = document.getElementById("shopify-section-{{ section.id }}");
    if (!root) return;
    const steps = [...root.querySelectorAll(".hsw__step")];
    if (!steps.length) return;

    // Hide the steps only once we know JS is here to reveal them again.
    root.querySelector(".hsw").classList.add("hsw-anim");

    // Reveal one step at a time as it comes into view, and let its connector
    // grow into the next card. Anything off-screen stays hidden until reached.
    if (!("IntersectionObserver" in window)) { steps.forEach(s => s.classList.add("is-in")); return; }

    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("is-in");
        io.unobserve(entry.target);
      });
    }, { threshold: 0.25, rootMargin: "0px 0px -10% 0px" });

    steps.forEach(s => io.observe(s));

    // The rail runs from the centre of the first number to the centre of the
    // last one. Those positions depend on the artwork size, so measure them.
    const rail = root.querySelector(".hsw__rail");
    const list = root.querySelector(".hsw__steps");
    if (rail && list) {
      const place = () => {
        const badges = steps.map(s => s.querySelector(".hsw__badge--rail"));
        if (!badges[0] || badges[0].offsetParent === null) return;
        const listTop = list.getBoundingClientRect().top;
        const first = badges[0].getBoundingClientRect();
        const last = badges[badges.length - 1].getBoundingClientRect();
        const listLeft = list.getBoundingClientRect().left;
        list.style.setProperty('--rail-left', (first.left - listLeft + first.width / 2 - 1) + 'px');
        const start = first.top - listTop + first.height / 2;
        const end = last.top - listTop + last.height / 2;
        list.style.setProperty("--rail-top", start + "px");
        list.style.setProperty("--rail-h", Math.max(0, end - start) + "px");
      };
      place();
      addEventListener("load", place);

      // One scroll pass drives everything: how far a reading line partway down
      // the screen has travelled from the first number to the last.
      const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
      let ticking = false;
      const progress = () => {
        ticking = false;
        const badges = steps.map(s => s.querySelector(".hsw__badge--rail"));
        if (!badges[0] || badges[0].offsetParent === null) return;   // desktop
        const line = innerHeight * 0.58;
        const mid = b => { const r = b.getBoundingClientRect(); return r.top + r.height / 2; };
        const a = mid(badges[0]), z = mid(badges[badges.length - 1]);
        const p = still ? 1 : Math.min(1, Math.max(0, (line - a) / Math.max(1, z - a)));
        list.style.setProperty("--rail-p", p.toFixed(4));
        badges.forEach((b, i) => steps[i].classList.toggle("is-lit", still || line >= mid(b) - 1));
      };
      addEventListener("scroll", () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(progress);
      }, { passive: true });
      addEventListener("resize", progress, { passive: true });
      progress();
      addEventListener("resize", place, { passive: true });
      if ("ResizeObserver" in window) new ResizeObserver(place).observe(list);
    }
  })();
</script>

