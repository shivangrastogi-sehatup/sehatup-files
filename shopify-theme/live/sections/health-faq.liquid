{%- comment -%}
  Health Score FAQ: answers the real objections (cost, payment, privacy,
  safety, delivery) before the final call to action. Native <details>
  rows, so it works without JS and with keyboards / screen readers, and a
  FAQPage JSON-LD built from the same blocks so Google can show rich
  results. Every answer is an editable block: only keep what is true.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  comment
    On a product page the product's own questions (the custom.product_faqs
    metafield: a list of question / answer) come first, then the blocks.
  endcomment
  assign own = blank
  if template.name == 'product' and product.metafields.custom.product_faqs != blank
    assign own = product.metafields.custom.product_faqs.value
  endif
-%}

{%- comment -%} Styles first, so the browser never paints this section unstyled. {%- endcomment -%}
<style>
  #hfq-{{ section.id }} { --hfq-text: #1d1d1d; --hfq-muted: #5c5c5c; --hfq-accent: {{ s.accent_color | color_darken: 8 }}; background: #faf7f5; font-family: 'Montserrat', sans-serif; color: var(--hfq-text); }
  #hfq-{{ section.id }} .hfq__inner {
    max-width: 1160px; margin: 0 auto; padding: 88px 24px;
    display: grid; grid-template-columns: minmax(0, 380px) minmax(0, 1fr); gap: 64px; align-items: start;
  }
  #hfq-{{ section.id }} .hfq__side { position: sticky; top: 110px; }
  #hfq-{{ section.id }} .hfq__heading { color: var(--hfq-text); margin: 0 0 14px; font: 800 clamp(28px, 3.2vw, 44px)/1.08 'Montserrat', sans-serif; letter-spacing: -.02em; text-wrap: balance; }
  #hfq-{{ section.id }} .hfq__sub { margin: 0; font: 400 16px/1.55 'Montserrat', sans-serif; color: var(--hfq-muted); }
  #hfq-{{ section.id }} .hfq__contact {
    display: inline-flex; align-items: center; gap: 10px; margin-top: 24px; padding: 13px 20px; border-radius: 999px;
    border: 1.5px solid var(--hfq-text); color: var(--hfq-text); text-decoration: none; font: 700 14.5px/1 'Montserrat', sans-serif;
    transition: background-color .2s ease, color .2s ease;
  }
  #hfq-{{ section.id }} .hfq__contact:hover { background: var(--hfq-text); color: #fff; }

  #hfq-{{ section.id }} .hfq__reads { margin-top: 34px; }
  #hfq-{{ section.id }} .hfq__reads-h { margin: 0 0 10px; font: 700 12px/1 'Montserrat', sans-serif; letter-spacing: .12em; text-transform: uppercase; color: var(--hfq-muted); }
  #hfq-{{ section.id }} .hfq__reads ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  #hfq-{{ section.id }} .hfq__reads a {
    display: block; padding: 9px 0; border-bottom: 1px solid #e6dfd9; text-decoration: none;
    font: 600 14.5px/1.35 'Montserrat', sans-serif; color: var(--hfq-text); transition: color .2s ease, padding .2s ease;
  }
  #hfq-{{ section.id }} .hfq__reads a:hover { color: var(--hfq-accent); padding-left: 4px; }
  #hfq-{{ section.id }} .hfq__shop { margin: 22px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  #hfq-{{ section.id }} .hfq__shop a {
    padding: 9px 14px; border-radius: 999px; background: #fff; text-decoration: none;
    font: 700 13px/1 'Montserrat', sans-serif; color: var(--hfq-text); box-shadow: 0 1px 4px rgba(29,29,29,.08);
  }
  #hfq-{{ section.id }} .hfq__shop a:hover { color: var(--hfq-accent); }

  #hfq-{{ section.id }} .hfq__list { border-top: 1px solid #e6dfd9; }
  #hfq-{{ section.id }} .hfq__item { border-bottom: 1px solid #e6dfd9; }
  #hfq-{{ section.id }} .hfq__q {
    list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 18px;
    padding: 22px 4px; font: 700 17px/1.35 'Montserrat', sans-serif; color: var(--hfq-text);
  }
  #hfq-{{ section.id }} .hfq__q::-webkit-details-marker { display: none; }
  #hfq-{{ section.id }} .hfq__q:hover { color: var(--hfq-accent); }
  #hfq-{{ section.id }} .hfq__q:focus-visible { outline: 2px solid var(--hfq-text); outline-offset: 2px; border-radius: 4px; }
  #hfq-{{ section.id }} .hfq__plus { position: relative; flex: none; width: 28px; height: 28px; border-radius: 50%; background: #fff; box-shadow: 0 1px 4px rgba(29,29,29,.1); }
  #hfq-{{ section.id }} .hfq__plus::before,
  #hfq-{{ section.id }} .hfq__plus::after { content: ""; position: absolute; left: 50%; top: 50%; width: 12px; height: 2px; margin: -1px 0 0 -6px; border-radius: 2px; background: var(--hfq-text); transition: transform .12s ease; }
  /* The icon follows the tap straight away: a closing item shows + at once,
     without waiting for its slide to finish. */
  #hfq-{{ section.id }} .hfq__plus::after { transform: rotate(90deg); }
  #hfq-{{ section.id }} .hfq__item[open]:not(.is-closing) .hfq__plus::after { transform: rotate(0deg); }
  #hfq-{{ section.id }} .hfq__item[open]:not(.is-closing) .hfq__plus { background: var(--hfq-accent); }
  #hfq-{{ section.id }} .hfq__item[open]:not(.is-closing) .hfq__plus::before,
  #hfq-{{ section.id }} .hfq__item[open]:not(.is-closing) .hfq__plus::after { background: #fff; }
  #hfq-{{ section.id }} .hfq__a { padding: 0 52px 24px 4px; font: 400 15.5px/1.65 'Montserrat', sans-serif; color: var(--hfq-muted); }
  /* Opening and closing slide (height animated by the script below); the
     answer text fades in as it opens. */
  #hfq-{{ section.id }} .hfq__a { transition: opacity .3s ease, transform .4s cubic-bezier(.16, 1, .3, 1); }
  #hfq-{{ section.id }} .hfq__item.is-closing .hfq__a,
  #hfq-{{ section.id }} .hfq__item.is-opening .hfq__a { opacity: 0; transform: translateY(-6px); }

  @media (max-width: 749px) {
    #hfq-{{ section.id }} .hfq__inner { grid-template-columns: 1fr; gap: 24px; padding: 56px 16px; }
    #hfq-{{ section.id }} .hfq__side { position: static; }
    #hfq-{{ section.id }} .hfq__heading { font-size: 28px; }
    #hfq-{{ section.id }} .hfq__sub { font-size: 14.5px; }
    #hfq-{{ section.id }} .hfq__q { padding: 18px 2px; font-size: 15.5px; }
    #hfq-{{ section.id }} .hfq__a { padding: 0 8px 20px 2px; font-size: 14.5px; }
  }
  @media (prefers-reduced-motion: reduce) {
    #hfq-{{ section.id }} .hfq__a { transition: none; }
    #hfq-{{ section.id }} .hfq__plus::before, #hfq-{{ section.id }} .hfq__plus::after { transition: none; }
  }

  /* Big screens: scale the whole section in proportion, so 1920-3840px
     monitors get a page sized for them instead of a 1200px island. */
  @media (min-width: 1680px) { #hfq-{{ section.id }} .hfq__inner { zoom: 1.12; } }
  @media (min-width: 1920px) { #hfq-{{ section.id }} .hfq__inner { zoom: 1.25; } }
  @media (min-width: 2240px) { #hfq-{{ section.id }} .hfq__inner { zoom: 1.45; } }
  @media (min-width: 2560px) { #hfq-{{ section.id }} .hfq__inner { zoom: 1.65; } }
  @media (min-width: 3200px) { #hfq-{{ section.id }} .hfq__inner { zoom: 2; } }
  @media (min-width: 3840px) { #hfq-{{ section.id }} .hfq__inner { zoom: 2.4; } }
</style>

<section id="hfq-{{ section.id }}" class="hfq">
  <span id="faq" class="sh-anchor" style="display:block;position:relative;top:-90px;height:0;visibility:hidden" aria-hidden="true"></span>
  <div class="hfq__inner">
    <div class="hfq__side">
      <h2 class="hfq__heading">{{ s.heading }}</h2>
      {%- if s.subheading != blank -%}<p class="hfq__sub">{{ s.subheading }}</p>{%- endif -%}
      {%- if s.contact_text != blank and s.contact_link != blank -%}
        <a class="hfq__contact" href="{{ s.contact_link }}">{{ s.contact_text }}<span aria-hidden="true">&rarr;</span></a>
      {%- endif -%}

      {%- comment -%} Helpful reads: internal links to the matching blog articles and shop pages. {%- endcomment -%}
      {%- capture hfq_reads -%}
        {%- for i in (1..4) -%}
          {%- capture k_t -%}read_{{ i }}_text{%- endcapture -%}
          {%- capture k_u -%}read_{{ i }}_link{%- endcapture -%}
          {%- if s[k_t] != blank and s[k_u] != blank -%}<li><a href="{{ s[k_u] }}">{{ s[k_t] }}</a></li>{%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- if hfq_reads != blank -%}
        <nav class="hfq__reads" aria-label="{{ s.reads_heading | escape }}">
          <p class="hfq__reads-h">{{ s.reads_heading }}</p>
          <ul>{{ hfq_reads }}</ul>
        </nav>
      {%- endif -%}
      {%- capture hfq_shop -%}
        {%- for i in (1..3) -%}
          {%- capture k_t -%}shop_{{ i }}_text{%- endcapture -%}
          {%- capture k_u -%}shop_{{ i }}_link{%- endcapture -%}
          {%- if s[k_t] != blank and s[k_u] != blank -%}<a href="{{ s[k_u] }}">{{ s[k_t] }}</a>{%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- if hfq_shop != blank -%}<p class="hfq__shop">{{ hfq_shop }}</p>{%- endif -%}
    </div>

    <div class="hfq__list" data-sehat-accordion>
      {%- assign hfq_n = 0 -%}
      {%- for item in own -%}
        {%- if item.question == blank or item.answer == blank -%}{%- continue -%}{%- endif -%}
        {%- assign hfq_n = hfq_n | plus: 1 -%}
        <details class="hfq__item" name="hfq-{{ section.id }}"{% if hfq_n == 1 and s.open_first %} open{% endif %}>
          <summary class="hfq__q">
            <span>{{ item.question }}</span>
            <i class="hfq__plus" aria-hidden="true"></i>
          </summary>
          <div class="hfq__a">{{ item.answer }}</div>
        </details>
      {%- endfor -%}
      {%- for block in section.blocks -%}
        {%- assign hfq_n = hfq_n | plus: 1 -%}
        <details class="hfq__item" name="hfq-{{ section.id }}" {{ block.shopify_attributes }}{% if hfq_n == 1 and s.open_first %} open{% endif %}>
          <summary class="hfq__q">
            <span>{{ block.settings.question }}</span>
            <i class="hfq__plus" aria-hidden="true"></i>
          </summary>
          <div class="hfq__a">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- capture hfq_ld -%}
  {%- for item in own -%}
    {%- if item.question == blank or item.answer == blank -%}{%- continue -%}{%- endif -%}
    ,{ "@type": "Question", "name": {{ item.question | strip_html | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ item.answer | strip_html | json }} } }
  {%- endfor -%}
  {%- for block in section.blocks -%}
    ,{ "@type": "Question", "name": {{ block.settings.question | strip_html | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} } }
  {%- endfor -%}
{%- endcapture -%}
{%- assign hfq_ld = hfq_ld | strip | remove_first: ',' -%}
{%- if hfq_ld != blank -%}
<script type="application/ld+json">
{ "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [ {{ hfq_ld }} ] }
</script>
{%- endif -%}


<script src="{{ 'sehat-accordion.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Health Score FAQ",
  "tag": "div",
  "class": "section-health-faq",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions people ask before they start" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Straight answers about cost, privacy and what happens next." },
    { "type": "text", "id": "contact_text", "label": "Contact button text", "default": "Ask us on WhatsApp" },
    { "type": "url", "id": "contact_link", "label": "Contact button link", "info": "e.g. your WhatsApp link. The button hides when this is empty." },
    { "type": "checkbox", "id": "open_first", "label": "Open the first question", "default": true },
    { "type": "header", "content": "Helpful reads (internal links)" },
    { "type": "text", "id": "reads_heading", "label": "Heading", "default": "Helpful reads" },
    { "type": "text", "id": "read_1_text", "label": "Link 1 text" }, { "type": "url", "id": "read_1_link", "label": "Link 1" },
    { "type": "text", "id": "read_2_text", "label": "Link 2 text" }, { "type": "url", "id": "read_2_link", "label": "Link 2" },
    { "type": "text", "id": "read_3_text", "label": "Link 3 text" }, { "type": "url", "id": "read_3_link", "label": "Link 3" },
    { "type": "text", "id": "read_4_text", "label": "Link 4 text" }, { "type": "url", "id": "read_4_link", "label": "Link 4" },
    { "type": "text", "id": "shop_1_text", "label": "Shop link 1 text", "default": "Shop For Her" }, { "type": "url", "id": "shop_1_link", "label": "Shop link 1" },
    { "type": "text", "id": "shop_2_text", "label": "Shop link 2 text", "default": "Shop For Him" }, { "type": "url", "id": "shop_2_link", "label": "Shop link 2" },
    { "type": "text", "id": "shop_3_text", "label": "Shop link 3 text", "default": "All combos" }, { "type": "url", "id": "shop_3_link", "label": "Shop link 3" },
    { "type": "color", "id": "accent_color", "label": "Accent colour", "default": "#ee204a" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Is the Health Score really free?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Yes. The questionnaire is free and needs no sign-up.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "Health Score FAQ", "blocks": [{ "type": "question" }] }]
}
{% endschema %}
