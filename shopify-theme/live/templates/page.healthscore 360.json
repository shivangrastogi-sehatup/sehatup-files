    "health_faq_hfq01": {
      "type": "health-faq",
      "blocks": {
        "faq_1": {
          "type": "question",
          "settings": {
            "question": "Is the Health Score really free?",
            "answer": "<p>Yes. The questionnaire is free and needs no sign-up. You only pay if you decide to order a care kit.</p>"
          }
        },
        "faq_8": {
          "type": "question",
          "settings": {
            "question": "Can Health Score 360 help with PCOS or irregular periods?",
            "answer": "<p>It helps you spot the signs, like irregular or painful periods, acne, unwanted hair growth and weight changes, and a doctor then goes through them with you. It does not diagnose PCOS on its own; if needed, your doctor will suggest the right tests.</p>"
          }
        },
        "faq_9": {
          "type": "question",
          "settings": {
            "question": "Can it help with low stamina or performance worries?",
            "answer": "<p>Yes. The men's check covers stamina, energy, stress and performance, and a doctor reviews your answers privately before suggesting anything. Many of these concerns are common and treatable.</p>"
          }
        },
        "faq_2": {
          "type": "question",
          "settings": {
            "question": "What happens after I finish it?",
            "answer": "<p>A doctor from our team calls you, usually within 24 hours, to go through your answers. You can talk in Hindi or English.</p>"
          }
        },
        "faq_3": {
          "type": "question",
          "settings": {
            "question": "Do I have to buy anything?",
            "answer": "<p>No. If your doctor suggests a care kit, they tell you what is in it and what it costs before you decide. Most care kits cost between ₹799 and ₹1,699.</p>"
          }
        },
        "faq_10": {
          "type": "question",
          "settings": {
            "question": "How soon will I see results?",
            "answer": "<p>Most people notice first changes in 4 to 6 weeks. A full plan usually runs 3 months, adjusted at each monthly check-in. Results vary from person to person.</p>"
          }
        },
        "faq_4": {
          "type": "question",
          "settings": {
            "question": "How do I pay for a care kit?",
            "answer": "<p>Confirm your order with just ₹50 and pay the rest when your kit arrives, or pay the full amount online.</p>"
          }
        },
        "faq_5": {
          "type": "question",
          "settings": {
            "question": "Will anyone know what I ordered?",
            "answer": "<p>No. Your kit comes in a plain box with nothing printed on it about what is inside, and only your doctor sees your answers.</p>"
          }
        },
        "faq_6": {
          "type": "question",
          "settings": {
            "question": "Is it safe to combine Ayurveda, Homeopathy and Allopathy?",
            "answer": "<p>Your doctors plan your care together, so the parts of your plan are chosen to work with each other. Always tell your doctor about any medicines you already take.</p>"
          }
        },
        "faq_7": {
          "type": "question",
          "settings": {
            "question": "How long does delivery take?",
            "answer": "<p>Usually 3 to 5 days, depending on where you live.</p>"
          }
        }
      },
