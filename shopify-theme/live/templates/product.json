            "custom_liquid": "<style>\n  /* Consultation prompt styling */\n  .consultation-prompt-wrapper {\n    margin-top: 16px;\n  }\n\n  /* Inner container for centering */\n  .consultation-content {\n    text-align: center;\n  }\n\n  /* Container for consultation prompt */\n  .quantity-consultation {\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    white-space: nowrap;\n  }\n\n  /* Text */\n  .consult-label {\n    font-size: 14px;\n    color: #666;\n    line-height: 1.4;\n  }\n\n  /* Button with icon */\n  .consult-btn {\n    display: inline-flex;\n    align-items: center;\n    gap: 0;\n    font-size: 14px;\n    font-weight: 600;\n    color: #6b21a8;\n    text-decoration: underline;\n    padding: 0;\n    background: none;\n    border: none;\n    cursor: pointer;\n    transition: opacity 0.2s ease;\n    line-height: 1.4;\n  }\n\n  .consult-btn:hover {\n    opacity: 0.8;\n  }\n\n  /* WhatsApp icon */\n  .whatsapp-icon {\n    display: inline-block;\n    vertical-align: middle;\n    margin-right: 6px;\n    width: 18px;\n    height: 18px;\n    flex-shrink: 0;\n  }\n\n  .whatsapp-icon svg {\n    width: 100%;\n    height: 100%;\n    display: block;\n  }\n\n  /* Mobile */\n  @media (max-width: 768px) {\n    .consultation-prompt-wrapper {\n      margin-top: 12px;\n    }\n\n    .quantity-consultation {\n      flex-wrap: wrap;\n      gap: 4px;\n      justify-content: center;\n    }\n  }\n</style>\n\n<div class=\"product-form__buttons consultation-prompt-wrapper\">\n  <div class=\"consultation-content\">\n    <div class=\"quantity-consultation\">\n      <span class=\"consult-label\">Still confused?</span>\n      <a href=\"https://wa.me/919355539355?text=I%20want%20to%20consult%20doctor\" target=\"_blank\" class=\"consult-btn\">\n        <span class=\"whatsapp-icon\">\n          <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n            <path d=\"M17.472 14.382c-.297-.149-1.758-.867-2.03-.9