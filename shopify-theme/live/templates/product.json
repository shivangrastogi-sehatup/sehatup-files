        "custom_liquid_B8N6j8": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% comment %}\n  Estimated Delivery Time — restyled to match store branding\n  - Uses theme's own font (inherits --font-body-family, no forced Google Font)\n  - Accent color #ee204a to match the pill-variant \"checked\" color used elsewhere on the PDP\n  - Border-radius language matched to the prepaid-offer / product-highlight boxes (12–18px)\n  - Six-digit pincode input, Check button inside the same row\n  - Responsive desktop and mobile layout\n{% endcomment %}\n\n{% assign delivery_box_id =\n  'minimal-delivery-box-'\n  | append: section.id\n  | append: '-'\n  | append: product.id\n%}\n\n<div\n  id=\"{{ delivery_box_id }}\"\n  class=\"minimal-delivery-box\"\n  data-minimal-delivery-box\n>\n\n  <!-- HEADER -->\n  <div class=\"minimal-delivery-header\">\n    <span class=\"minimal-delivery-title\">\n      Estimated Delivery Time\n    </span>\n  </div>\n\n  <!-- PINCODE FIELD -->\n  <div\n    class=\"minimal-delivery-field\"\n    data-pincode-form\n  >\n    <input\n      type=\"tel\"\n      inputmode=\"numeric\"\n      pattern=\"[0-9]*\"\n      maxlength=\"6\"\n      placeholder=\"Enter 6 digit pincode\"\n      autocomplete=\"postal-code\"\n      aria-label=\"Enter delivery pincode\"\n      data-pincode-input\n    >\n\n    <button\n      type=\"button\"\n      class=\"minimal-delivery-check\"\n      data-check-btn\n    >\n      Check\n    </button>\n  </div>\n\n  <!-- ERROR -->\n  <p\n    class=\"minimal-delivery-error\"\n    data-pincode-error\n    role=\"alert\"\n    hidden\n  >\n    Please enter a valid 6-digit pincode.\n  </p>\n\n  <!-- RESULT -->\n  <div\n    class=\"minimal-delivery-result\"\n    data-delivery-result\n    hidden\n  >\n    <div class=\"minimal-delivery-result-copy\">\n      <span>Estimated delivery</span>\n      <strong data-delivery-date></strong>\n    </div>\n\n    <button\n      type=\"button\"\n      class=\"minimal-delivery-change\"\n      data-change-btn\n    >\n      Change\n    </button>\n  </div>\n\n</div>\n\n<style>\n\n  #{{ delivery_box_id }},\n  #{{ delivery_box_id }} * {\n    box-sizing: border-box;\n    /* Inherit the theme's own body font instead of forcing Inter,\n       so it matches the rest of the product page typography */\n    font-family: var(--font-body-family, inherit);\n  }\n\n  /*\n    DESKTOP SPACING\n    Change these two values independently.\n  */\n  #{{ delivery_box_id }} {\n    --delivery-accent: #ee204a;        /* matches .product-form__input--pill checked color */\n    --delivery-accent-soft: #fff0f3;   /* light tint of accent for the check button / result bg */\n    --delivery-text: #171717;\n    --delivery-muted: #6b7280;         /* matches WhatsApp consult label gray */\n\n    --desktop-margin-top: 4px;\n    --desktop-margin-bottom: 14px;\n\n    width: 100%;\n    margin-top: var(--desktop-margin-top);\n    margin-right: 0;\n    margin-bottom: var(--desktop-margin-bottom);\n    margin-left: 0;\n\n    padding: 0;\n    background: transparent;\n    color: var(--delivery-text);\n    -webkit-font-smoothing: antialiased;\n    text-rendering: optimizeLegibility;\n  }\n\n  /* HEADER */\n  #{{ delivery_box_id }} .minimal-delivery-header {\n    display: block;\n    margin: 0 0 7px;\n  }\n\n  #{{ delivery_box_id }} .minimal-delivery-title {\n    display: block;\n    color: var(--delivery-muted);\n    font-size: 15px;\n    font-weight: 500;\n    line-height: 1.35;\n    letter-spacing: 0;\n  }\n\n  /* FIELD */\n  #{{ delivery_box_id }} .minimal-delivery-field {\n    position: relative;\n    display: flex;\n    align-items: stretch;\n\n    width: 100%;\n    min-height: 49px;\n\n    overflow: hidden;\n\n    background: #ffffff;\n    border: 1px solid rgba(238, 32, 74, 0.22); /* accent-tinted border */\n    border-radius: 14px; /* matches prepaid-offer-new / product-highlights radius language */\n\n    transition:\n      border-color 0.18s ease,\n      box-shadow 0.18s ease;\n  }\n\n  #{{ delivery_box_id }} .minimal-delivery-field:focus-within {\n    border-color: var(--delivery-accent);\n    box-shadow: 0 0 0 3px rgba(238, 32, 74, 0.08);\n  }\n\n  /* INPUT */\n  #{{ delivery_box_id }} input {\n    flex: 1 1 auto;\n\n    width: 100%;\n    min-width: 0;\n    height: 47px;\n\n    margin: 0;\n    padding: 0 16px;\n\n    background: #ffffff;\n    border: 0;\n    outline: 0;\n    box-shadow: none;\n\n    color: var(--delivery-text);\n\n    font-size: 13px;\n    font-weight: 400;\n    line-height: 1;\n  }\n\n  #{{ delivery_box_id }} input::placeholder {\n    color: #9a9a9a;\n    opacity: 1;\n  }\n\n  /* CHECK BUTTON */\n  #{{ delivery_box_id }} .minimal-delivery-check {\n    position: static;\n    transform: none;\n\n    flex: 0 0 84px;\n\n    min-width: 84px;\n    height: 47px;\n\n    margin: 0;\n    padding: 0 16px;\n\n    background: var(--delivery-accent-soft);\n    border: 0;\n    border-left: 1px solid rgba(238, 32, 74, 0.15);\n\n    color: var(--delivery-text);\n\n    font-size: 12px;\n    font-weight: 600;\n    line-height: 1;\n\n    cursor: pointer;\n    white-space: nowrap;\n\n    transition:\n      background-color 0.18s ease,\n      color 0.18s ease;\n  }\n\n  #{{ delivery_box_id }} .minimal-delivery-check:hover {\n    background: var(--delivery-accent);\n    color: #ffffff;\n  }\n\n  /* ERROR */\n  #{{ delivery_box_id }} .minimal-delivery-error {\n    margin: 6px 0 0;\n    padding: 0;\n\n    color: var(--delivery-accent);\n\n    font-size: 11px;\n    font-weight: 400;\n    line-height: 1.35;\n  }\n\n  #{{ delivery_box_id }} .minimal-delivery-error[hidden],\n  #{{ delivery_box_id }} .minimal-delivery-result[hidden] {\n    display: none !important;\n  }\n\n  /* RESULT */\n  #{{ delivery_box_id }} .minimal-delivery-result {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 12px;\n\n    min-height: 49px;\n    padding: 10px 13px;\n\n    background: var(--delivery-accent-soft);\n    border: 1px solid rgba(238, 32, 74, 0.2);\n    border-radius: 14px;\n  }\n\n  #{{ delivery_box_id }} .minimal-delivery-result-copy {\n    display: flex;\n    align-items: baseline;\n    flex-wrap: wrap;\n    gap: 5px;\n    min-width: 0;\n  }\n\n  #{{ delivery_box_id }} .minimal-delivery-result-copy span {\n    color: var(--delivery-muted);\n    font-size: 12px;\n    font-weight: 400;\n    line-height: 1.35;\n  }\n\n  #{{ delivery_box_id }} .minimal-delivery-result-copy strong {\n    color: var(--delivery-text);\n    font-size: 13px;\n    font-weight: 700;\n    line-height: 1.35;\n    white-space: nowrap;\n  }\n\n  #{{ delivery_box_id }} .minimal-delivery-change {\n    flex: 0 0 auto;\n\n    margin: 0;\n    padding: 0;\n\n    background: transparent;\n    border: 0;\n\n    color: var(--delivery-accent);\n\n    font-size: 11px;\n    font-weight: 600;\n    line-height: 1;\n\n    cursor: pointer;\n    text-decoration: underline;\n    text-underline-offset: 2px;\n  }\n\n  @media screen and (max-width: 749px) {\n    /*\n      MOBILE SPACING\n      Change these two values independently.\n    */\n    #{{ delivery_box_id }} {\n      --mobile-margin-top: 4px;\n      --mobile-margin-bottom: 0px;\n\n      margin-top: var(--mobile-margin-top);\n      margin-right: 0;\n      margin-bottom: var(--mobile-margin-bottom);\n      margin-left: 0;\n    }\n\n    #{{ delivery_box_id }} .minimal-delivery-header {\n      margin-bottom: 7px;\n    }\n\n    #{{ delivery_box_id }} .minimal-delivery-title {\n      font-size: 14px;\n    }\n\n    #{{ delivery_box_id }} .minimal-delivery-field,\n    #{{ delivery_box_id }} .minimal-delivery-result {\n      min-height: 48px;\n      border-radius: 12px;\n    }\n\n    #{{ delivery_box_id }} input {\n      height: 46px;\n      padding: 0 13px;\n      font-size: 12px;\n    }\n\n    #{{ delivery_box_id }} .minimal-delivery-check {\n      flex-basis: 78px;\n      min-width: 78px;\n      height: 46px;\n      padding: 0 12px;\n      font-size: 11px;\n    }\n\n    #{{ delivery_box_id }} .minimal-delivery-result {\n      padding: 9px 12px;\n    }\n\n    #{{ delivery_box_id }} .minimal-delivery-result-copy span {\n      font-size: 11px;\n    }\n\n    #{{ delivery_box_id }} .minimal-delivery-result-copy strong {\n      font-size: 12px;\n    }\n  }\n\n  @media screen and (max-width: 390px) {\n    #{{ delivery_box_id }} .minimal-delivery-title {\n      font-size: 13px;\n    }\n\n    #{{ delivery_box_id }} input {\n      padding-left: 12px;\n    }\n\n    #{{ delivery_box_id }} .minimal-delivery-check {\n      flex-basis: 72px;\n      min-width: 72px;\n      padding: 0 10px;\n    }\n  }\n\n</style>\n\n<script>\n\n(function () {\n\n  var deliveryBox =\n    document.getElementById(\n      '{{ delivery_box_id }}'\n    );\n\n  if (\n    !deliveryBox ||\n    deliveryBox.dataset.loaded === 'true'\n  ) {\n    return;\n  }\n\n  deliveryBox.dataset.loaded =\n    'true';\n\n  var input =\n    deliveryBox.querySelector(\n      '[data-pincode-input]'\n    );\n\n  var checkBtn =\n    deliveryBox.querySelector(\n      '[data-check-btn]'\n    );\n\n  var form =\n    deliveryBox.querySelector(\n      '[data-pincode-form]'\n    );\n\n  var result =\n    deliveryBox.querySelector(\n      '[data-delivery-result]'\n    );\n\n  var deliveryDate =\n    deliveryBox.querySelector(\n      '[data-delivery-date]'\n    );\n\n  var error =\n    deliveryBox.querySelector(\n      '[data-pincode-error]'\n    );\n\n  var changeBtn =\n    deliveryBox.querySelector(\n      '[data-change-btn]'\n    );\n\n  if (\n    !input ||\n    !checkBtn ||\n    !form ||\n    !result\n  ) {\n    return;\n  }\n\n  /* =========================================\n     CLEAN PINCODE\n     ========================================= */\n\n  function cleanPincode(value) {\n\n    return String(\n      value || ''\n    )\n      .replace(/\\D/g, '')\n      .slice(0, 6);\n\n  }\n\n  /* =========================================\n     DELIVERY ESTIMATE\n     ========================================= */\n\n  function getDeliveryDays(pin) {\n\n    var p =\n      parseInt(\n        pin,\n        10\n      );\n\n    if (\n      (p >= 110001 && p <= 110096) ||\n      (p >= 201001 && p <= 201310) ||\n      (p >= 122001 && p <= 122508) ||\n      (p >= 124001 && p <= 124507) ||\n      (p >= 131001 && p <= 131402) ||\n      (p >= 121001 && p <= 121106) ||\n      (p >= 245001 && p <= 245412)\n    ) {\n      return 2;\n    }\n\n    if (\n      (p >= 200001 && p <= 285205) ||\n      (p >= 125001 && p <= 136156) ||\n      (p >= 140001 && p <= 160059) ||\n      (p >= 301001 && p <= 345034) ||\n      (p >= 246001 && p <= 263680) ||\n      (p >= 170001 && p <= 177213)\n    ) {\n      return 3;\n    }\n\n    if (\n      (p >= 450001 && p <= 488776) ||\n      (p >= 800001 && p <= 855117) ||\n      (p >= 360001 && p <= 396590) ||\n      (p >= 400001 && p <= 445402) ||\n      (p >= 490001 && p <= 497778) ||\n      (p >= 700001 && p <= 743710)\n    ) {\n      return 4;\n    }\n\n    return 5;\n\n  }\n\n  /* =========================================\n     DATE\n     ========================================= */\n\n  function getEstimatedDate(days) {\n\n    var date =\n      new Date();\n\n    date.setDate(\n      date.getDate() +\n      Number(days)\n    );\n\n    return date.toLocaleDateString(\n      'en-IN',\n      {\n        weekday: 'short',\n        day: 'numeric',\n        month: 'short'\n      }\n    );\n\n  }\n\n  function hideError() {\n\n    if (error) {\n      error.hidden = true;\n    }\n\n  }\n\n  /* =========================================\n     CHECK\n     ========================================= */\n\n  function checkPincode() {\n\n    var pin =\n      cleanPincode(\n        input.value\n      );\n\n    input.value =\n      pin;\n\n    if (\n      pin.length !== 6\n    ) {\n\n      if (error) {\n        error.hidden = false;\n      }\n\n      input.focus();\n\n      return;\n\n    }\n\n    hideError();\n\n    var days =\n      getDeliveryDays(pin);\n\n    if (deliveryDate) {\n\n      deliveryDate.textContent =\n        getEstimatedDate(days);\n\n    }\n\n    form.style.display =\n      'none';\n\n    result.hidden =\n      false;\n\n  }\n\n  /* =========================================\n     CHANGE\n     ========================================= */\n\n  function changePincode() {\n\n    result.hidden =\n      true;\n\n    form.style.display =\n      'flex';\n\n    input.value =\n      '';\n\n    hideError();\n\n    setTimeout(\n      function () {\n\n        input.focus();\n\n      },\n      50\n    );\n\n  }\n\n  /* =========================================\n     EVENTS\n     ========================================= */\n\n  input.addEventListener(\n    'input',\n    function () {\n\n      input.value =\n        cleanPincode(\n          input.value\n        );\n\n      hideError();\n\n    }\n  );\n\n  input.addEventListener(\n    'keydown',\n    function (event) {\n\n      if (\n        event.key === 'Enter'\n      ) {\n\n        event.preventDefault();\n\n        checkPincode();\n\n      }\n\n    }\n  );\n\n  checkBtn.addEventListener(\n    'click',\n    checkPincode\n  );\n\n  if (changeBtn) {\n\n    changeBtn.addEventListener(\n      'click',\n      changePincode\n    );\n\n  }\n\n})();\n\n</script>"
