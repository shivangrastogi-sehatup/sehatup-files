</reviews-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class ReviewsCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupAccessibility();
      }

      setupAccessibility() {
        const tracks = this.querySelectorAll('.ai-reviews-carousel__track-{{ ai_gen_id }}');
        tracks.forEach((track) => {
          track.setAttribute('role', 'region');
          track.setAttribute('aria-live', 'off');
        });
      }
    }

    customElements.define('reviews-carousel-{{ ai_gen_id }}', ReviewsCarousel{{ ai_gen_id }});
  })();
</script>

