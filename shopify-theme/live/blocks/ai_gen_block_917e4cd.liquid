{% doc %}
  @prompt
    Create a custom reviews carousel section for the homepage that displays customer reviews in two horizontal rows that auto-scroll infinitely to the left. Each review card should display: customer profile image, star rating, customer name, and review text. The section should have a clean, premium healthcare brand aesthetic with smooth continuous scrolling animation. The reviews should loop seamlessly and pause on hover. Make it fully responsive and accessible with proper ARIA labels. Include settings in the theme editor to: add/edit individual reviews with fields for image, name, rating (1-5 stars), and review text; control scroll speed; adjust card styling (padding, border radius, shadows); and customize colors for background, text, and star ratings.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-reviews-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
    overflow: hidden;
  }

  .ai-reviews-carousel__container-{{ ai_gen_id }} {
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-reviews-carousel__heading-{{ ai_gen_id }} {
    text-align: center;
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
    padding: 0 20px;
  }

  .ai-reviews-carousel__track-wrapper-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.row_gap }}px;
  }

  .ai-reviews-carousel__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    will-change: transform;
  }

  .ai-reviews-carousel__track-{{ ai_gen_id }}--row-1 {
    animation: ai-reviews-scroll-left-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
  }

  .ai-reviews-carousel__track-{{ ai_gen_id }}--row-2 {
    animation: ai-reviews-scroll-left-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
    animation-delay: calc({{ block.settings.scroll_speed }}s / -2);
  }

  .ai-reviews-carousel__track-{{ ai_gen_id }}:hover {
    animation-play-state: paused;
  }

  @keyframes ai-reviews-scroll-left-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-100% - {{ block.settings.card_gap }}px));
    }
  }

  .ai-reviews-carousel__card-{{ ai_gen_id }} {
    flex: 0 0 auto;
    width: {{ block.settings.card_width }}px;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: {{ block.settings.card_shadow_horizontal }}px {{ block.settings.card_shadow_vertical }}px {{ block.settings.card_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | divided_by: 100.0 }});
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-reviews-carousel__header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-reviews-carousel__avatar-{{ ai_gen_id }} {
    width: {{ block.settings.avatar_size }}px;
    height: {{ block.settings.avatar_size }}px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background-color: #e0e0e0;
  }

  .ai-reviews-carousel__avatar-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-reviews-carousel__avatar-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.star_color }};
    color: #ffffff;
    font-size: {{ block.settings.avatar_size | divided_by: 2 }}px;
    font-weight: 600;
  }

  .ai-reviews-carousel__info-{{ ai_gen_id }} {
    flex: 1;
    min-width: 0;
  }

  .ai-reviews-carousel__name-{{ ai_gen_id }} {
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0 0 4px;
    font-size: 14px;
  }

  .ai-reviews-carousel__stars-{{ ai_gen_id }} {
    display: flex;
    gap: 2px;
  }

  .ai-reviews-carousel__star-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
    color: {{ block.settings.star_color }};
  }

  .ai-reviews-carousel__star-{{ ai_gen_id }}--empty {
    color: #d0d0d0;
  }

  .ai-reviews-carousel__text-{{ ai_gen_id }} {
    color: {{ block.settings.review_text_color }};
    font-size: 14px;
    line-height: 1.5;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-reviews-carousel__card-{{ ai_gen_id }} {
      width: {{ block.settings.card_width | times: 0.8 }}px;
    }

    .ai-reviews-carousel__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<reviews-carousel-{{ ai_gen_id }}
