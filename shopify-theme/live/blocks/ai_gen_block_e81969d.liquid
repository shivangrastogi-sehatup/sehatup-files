{% doc %}
  @prompt
    Create a responsive "Our Commitment" feature section with icon-based commitment cards in a horizontal layout.
        
        Layout structure:
        - Section heading: "Our Commitment"
        - Three feature cards in a row (3 columns desktop, stacked mobile):
        
        Card 1:
        - Icon: lock/padlock icon
        - Title: "Privacy First"
        - Description: "All your answers are encrypted."
        
        Card 2:
        - Icon: shield with checkmark icon
        - Title: "Quality Assured"
        - Description: "AYUSH-approved products. Doctor-reviewed plans. No shortcuts."
        
        Card 3:
        - Icon: clock/24-7 icon
        - Title: "Always Accessible"
        - Description: "Health doesn't clock out-and neither do we."
        
        Requirements:
        - Fully responsive layout:
          * Desktop: 3 columns in a row, evenly spaced
          * Tablet: 3 columns with adjusted spacing or 2+1 layout
          * Mobile: single column, stacked vertically
        - Settings schema to customize:
          * Section heading text and typography (size, weight, color, alignment)
          * Section background color
          * Content max-width control
          * Section padding (top/bottom)
          * Feature cards (repeatable blocks):
            - Icon upload or icon picker
            - Icon size control
            - Icon color
            - Title text
            - Description text
            - Card alignment (center, left)
          * Grid layout: columns per row (2, 3, or 4 on desktop)
          * Typography controls:
            - Title font size, weight, color
            - Description font size, color, line height
          * Spacing controls: section padding, card gaps, icon-to-text spacing
          * Icon styling: size, color, background circle (optional)
          * Text alignment within cards (center or left)
          * Card background color (optional)
          * Card padding and border (optional)
          * Mobile-specific: icon size, font size overrides, card spacing
        - Icons should be simple, clean, and centered above text
        - Cards should be center-aligned by default
        - Equal spacing between cards
        - Clean, minimal design with good readability
        - Support for adding/removing commitment cards (flexible blocks)
        - Icons should be consistent size across all cards
        - Mobile: cards stack vertically, full width, center-aligned
        - Optional: subtle background or border on cards
        - Optional: hover effects on cards (lift, shadow)
        - Accessible color contrast ratios
        - Support for 2-6 feature cards in flexible grid
        - Light background section with dark text for contrast, resize the cards when available space is there making the padding and icon and text sizes accordingly . do changes and make it responsive design and align the card contents to left and if the cards dont come in horizontally in one row . if it is having more then 1 row then make it a horizontal scroll do changes
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-commitment-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.section_background_color }};
    overflow: hidden;
  }

  .ai-commitment-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-commitment-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    color: {{ block.settings.heading_color }};
    text-align: {{ block.settings.heading_alignment }};
    margin: 0 0 {{ block.settings.heading_bottom_spacing }}px;
    line-height: 1.2;
  }

  .ai-commitment-scroll-wrapper-{{ ai_gen_id }} {
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: rgba(0, 0, 0, 0.2) transparent;
  }

  .ai-commitment-scroll-wrapper-{{ ai_gen_id }}::-webkit-scrollbar {
    height: 6px;
  }

  .ai-commitment-scroll-wrapper-{{ ai_gen_id }}::-webkit-scrollbar-track {
    background: transparent;
  }

  .ai-commitment-scroll-wrapper-{{ ai_gen_id }}::-webkit-scrollbar-thumb {
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 3px;
  }

  .ai-commitment-grid-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    margin: 0;
    min-width: min-content;
  }

  .ai-commitment-card-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    padding: {{ block.settings.card_padding }}px;
    background-color: {{ block.settings.card_background_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    flex: 0 0 auto;
    width: calc(({{ block.settings.content_max_width }}px - ({{ block.settings.card_gap }}px * ({{ block.settings.columns_desktop }} - 1)) - 40px) / {{ block.settings.columns_desktop }});
    min-width: 280px;
    max-width: 450px;
    {% if block.settings.card_border_thickness > 0 %}
      border: {{ block.settings.card_border_thickness }}px solid {{ block.settings.card_border_color }};
    {% endif %}
    {% if block.settings.enable_hover_effect %}
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    {% endif %}
  }

  {% if block.settings.enable_hover_effect %}
    .ai-commitment-card-{{ ai_gen_id }}:hover {
      transform: translateY(-{{ block.settings.hover_lift_distance }}px);
      box-shadow: 0 {{ block.settings.hover_shadow_distance }}px {{ block.settings.hover_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.hover_shadow_opacity }});
    }
  {% endif %}

  .ai-commitment-icon-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin-bottom: {{ block.settings.icon_to_text_spacing }}px;
    flex-shrink: 0;
    {% if block.settings.icon_background_circle %}
      background-color: {{ block.settings.icon_background_color }};
      border-radius: 50%;
      padding: {{ block.settings.icon_circle_padding }}px;
    {% endif %}
  }

  .ai-commitment-icon-wrapper-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: {{ block.settings.icon_color }};
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ai-commitment-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: {{ block.settings.title_font_weight }};
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_bottom_spacing }}px;
    line-height: 1.3;
  }

  .ai-commitment-card-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_font_size }}px;
    color: {{ block.settings.description_color }};
    line-height: {{ block.settings.description_line_height }};
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-commitment-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-commitment-grid-{{ ai_gen_id }} {
      gap: {{ block.settings.card_gap_mobile }}px;
    }

    .ai-commitment-card-{{ ai_gen_id }} {
      width: calc((100vw - ({{ block.settings.card_gap_mobile }}px * ({{ block.settings.columns_tablet }} - 1)) - 60px) / {{ block.settings.columns_tablet }});
      padding: {{ block.settings.card_padding_mobile }}px;
    }

    .ai-commitment-icon-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size_mobile }}px;
      height: {{ block.settings.icon_size_mobile }}px;
    }

    .ai-commitment-card-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_font_size_mobile }}px;
    }

    .ai-commitment-card-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_font_size_mobile }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-commitment-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top_mobile }}px 0 {{ block.settings.section_padding_bottom_mobile }}px;
    }

    .ai-commitment-container-{{ ai_gen_id }} {
      padding: 0 16px;
    }

    .ai-commitment-card-{{ ai_gen_id }} {
      width: calc(100vw - 80px);
      min-width: 260px;
    }
  }
{% endstyle %}

