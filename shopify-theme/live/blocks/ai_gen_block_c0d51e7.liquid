{% doc %}
  @prompt
    Create a responsive "What Is Health Score 360?" informational section with three feature cards and descriptive text block.
    
    Layout structure:
    - Main heading: "What Is Health Score 360?"
    - Three cards in a row (desktop/tablet) or stacked (mobile):
      
    Card 1 (pink background):
    - Icon: dumbbell/weight icon
    - Title: "Weight"
    - Description: "Track metabolism, energy levels, and weight patterns for optimized health."
    
    Card 2 (pink background):
    - Icon: wellness/meditation icon
    - Title: "Sexual Wellness"
    - Description: "Track metabolism, energy levels, and weight patterns for optimized health."
    
    Card 3 (pink background):
    - Icon: period care icon
    - Title: "Period Care"
    - Description: "Monitor cycle health, PMS signals, and hormonal patterns."
    
    Below cards:
    - Subheading: "Health Score 360: Your Complete Wellness Guide" (with "360:" in red/accent color)
    - Paragraph text explaining the health score concept
    
    Requirements:
    - Fully responsive (desktop: 3 columns, tablet: 3 columns or 2+1, mobile: stacked)
    - Settings schema to customize:
      * Main heading text
      * Number of feature cards (blocks)
      * For each card: icon/image upload, title, description text, background color
      * Subheading text with color accent control
      * Body paragraph text
      * Card styling: border radius, padding, shadow
      * Typography: font sizes for headings, titles, body text
      * Spacing controls: section padding, card gaps, text spacing
      * Color pickers: card backgrounds, text colors, accent color
      * Layout options: cards per row on desktop/tablet
    - Cards should have soft rounded corners and subtle backgrounds
    - Icons should be centered above titles
    - Mobile: full-width cards with proper spacing
    - Include hover effects on cards (optional)
    - Max-width container for desktop, centered layout
    - Flexible block system to add/remove/reorder cards
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-health-score-section-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.section_background_color }};
  }

  .ai-health-score-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_max_width }}px;
    margin: 0 auto;
  }

  .ai-health-score-main-heading-{{ ai_gen_id }} {
    font-size: clamp(24px,3.4vw,64px);
    color: {{ block.settings.main_heading_color }};
    text-align: {{ block.settings.text_alignment }};
    margin: 0 0 {{ block.settings.heading_bottom_spacing }}px;
    font-weight: 600;
  }

  .ai-health-score-cards-wrapper-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.cards_per_row_desktop }}, 1fr);
    gap: {{ block.settings.card_gap }}px;
    margin-bottom: {{ block.settings.cards_bottom_spacing }}px;
  }

  .ai-health-score-card-{{ ai_gen_id }} {
    background: {{ block.settings.card_background_color }};
    background: linear-gradient(176deg,rgba(255, 226, 226, 1) 0%, rgba(255, 255, 255, 1) 100%);
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 {{ block.settings.card_shadow_vertical }}px {{ block.settings.card_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity }});
  }

  {% if block.settings.enable_card_hover %}
    .ai-health-score-card-{{ ai_gen_id }}:hover {
      transform: translateY(-4px);
      box-shadow: 0 {{ block.settings.card_shadow_vertical | plus: 4 }}px {{ block.settings.card_shadow_blur | plus: 4 }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | times: 1.5 | at_most: 1 }});
    }
  {% endif %}

  .ai-health-score-card-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin: 0 auto {{ block.settings.icon_bottom_spacing }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-health-score-card-icon-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-health-score-card-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-health-score-card-title-{{ ai_gen_id }} {
    font-size: clamp(14px, 2.4vw, 35px);
    color: {{ block.settings.card_title_color }};
    margin: 0 0 {{ block.settings.title_bottom_spacing }}px;
    font-weight: 600;
  }

  .ai-health-score-card-description-{{ ai_gen_id }} {
    font-size: clamp(10px, 1.2vw, 20px);
    color: {{ block.settings.card_description_color }};
    line-height: 1.5;
    margin: 0;
  }

  .ai-health-score-text-content-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    padding: 30px;
    border-radius: 20px;
    background: #F0F0F0;
  }

  .ai-health-score-subheading-{{ ai_gen_id }} {
    font-size: clamp(14px, 2.4vw, 35px);
    color: {{ block.settings.subheading_color }};
    margin: 0 0 {{ block.settings.subheading_bottom_spacing }}px;
    font-weight: 600;
  }

  .ai-health-score-accent-{{ ai_gen_id }} {
    color: {{ block.settings.accent_color }};
  }

  .ai-health-score-body-text-{{ ai_gen_id }} {
    font-size: clamp(10px, 1.2vw, 20px);
    color: {{ block.settings.body_text_color }};
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-health-score-cards-wrapper-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.cards_per_row_tablet }}, 1fr);
    }

    .ai-health-score-main-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.main_heading_size }}px * 0.85);
    }

    .ai-health-score-subheading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size }}px * 0.85);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-health-score-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.7 }}px 16px {{ block.settings.section_padding_bottom | times: 0.7 }}px;
    }

    .ai-health-score-cards-wrapper-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-health-score-main-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.main_heading_size }}px * 0.7);
    }

    .ai-health-score-subheading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size }}px * 0.7);
    }

    .ai-health-score-card-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.8 }}px;
    }
  }
{% endstyle %}

<health-score-section-{{ ai_gen_id }} class="ai-health-score-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-health-score-container-{{ ai_gen_id }}">
    {% if block.settings.main_heading != blank %}
      <h2 class="ai-health-score-main-heading-{{ ai_gen_id }}">
        {{ block.settings.main_heading }}
      </h2>
    {% endif %}

    <div class="ai-health-score-cards-wrapper-{{ ai_gen_id }}">
      <div class="ai-health-score-card-{{ ai_gen_id }}">
        {% if block.settings.card_1_icon != blank %}
          <div class="ai-health-score-card-icon-{{ ai_gen_id }}">
            <img
              src="{{ block.settings.card_1_icon | image_url: width: 200 }}"
              alt="{{ block.settings.card_1_title | escape }}"
              loading="lazy"
              width="200"
              height="200"
            >
          </div>
        {% else %}
          <div class="ai-health-score-card-icon-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}

        {% if block.settings.card_1_title != blank %}
          <h3 class="ai-health-score-card-title-{{ ai_gen_id }}">
            {{ block.settings.card_1_title }}
          </h3>
        {% endif %}

        {% if block.settings.card_1_description != blank %}
          <p class="ai-health-score-card-description-{{ ai_gen_id }}">
            {{ block.settings.card_1_description }}
          </p>
        {% endif %}
      </div>

      <div class="ai-health-score-card-{{ ai_gen_id }}">
        {% if block.settings.card_2_icon != blank %}
          <div class="ai-health-score-card-icon-{{ ai_gen_id }}">
            <img
              src="{{ block.settings.card_2_icon | image_url: width: 200 }}"
              alt="{{ block.settings.card_2_title | escape }}"
              loading="lazy"
              width="200"
              height="200"
            >
          </div>
        {% else %}
          <div class="ai-health-score-card-icon-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}

        {% if block.settings.card_2_title != blank %}
          <h3 class="ai-health-score-card-title-{{ ai_gen_id }}">
            {{ block.settings.card_2_title }}
          </h3>
        {% endif %}

        {% if block.settings.card_2_description != blank %}
          <p class="ai-health-score-card-description-{{ ai_gen_id }}">
            {{ block.settings.card_2_description }}
          </p>
        {% endif %}
      </div>

      <div class="ai-health-score-card-{{ ai_gen_id }}">
        {% if block.settings.card_3_icon != blank %}
          <div class="ai-health-score-card-icon-{{ ai_gen_id }}">
            <img
              src="{{ block.settings.card_3_icon | image_url: width: 200 }}"
              alt="{{ block.settings.card_3_title | escape }}"
              loading="lazy"
              width="200"
              height="200"
            >
          </div>
        {% else %}
          <div class="ai-health-score-card-icon-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}

        {% if block.settings.card_3_title != blank %}
          <h3 class="ai-health-score-card-title-{{ ai_gen_id }}">
            {{ block.settings.card_3_title }}
          </h3>
        {% endif %}

        {% if block.settings.card_3_description != blank %}
          <p class="ai-health-score-card-description-{{ ai_gen_id }}">
            {{ block.settings.card_3_description }}
          </p>
        {% endif %}
      </div>
    </div>

    <div class="ai-health-score-text-content-{{ ai_gen_id }}">
      {% if block.settings.subheading != blank %}
        <h3 class="ai-health-score-subheading-{{ ai_gen_id }}">
          {% assign subheading_parts = block.settings.subheading | split: block.settings.accent_text %}
          {% if subheading_parts.size > 1 %}
            {{ subheading_parts[0] }}<span class="ai-health-score-accent-{{ ai_gen_id }}">{{ block.settings.accent_text }}</span>{{ subheading_parts[1] }}
          {% else %}
            {{ block.settings.subheading }}
          {% endif %}
        </h3>
      {% endif %}

      {% if block.settings.body_text != blank %}
        <div class="ai-health-score-body-text-{{ ai_gen_id }}">
          {{ block.settings.body_text }}
        </div>
      {% endif %}
    </div>
  </div>
</health-score-section-{{ ai_gen_id }}>

<script>
  (function() {
    class HealthScoreSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.init();
      }

      init() {
        const cards = this.querySelectorAll('.ai-health-score-card-{{ ai_gen_id }}');
        cards.forEach((card, index) => {
          card.style.animationDelay = `${index * 0.1}s`;
        });
      }
    }

    customElements.define('health-score-section-{{ ai_gen_id }}', HealthScoreSection{{ ai_gen_id }});
  })();
</script>

