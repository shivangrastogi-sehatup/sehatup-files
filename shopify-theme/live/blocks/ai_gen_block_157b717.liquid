{% doc %}
  @prompt
    Create an advanced product collection showcase section with flexible layout options:
    
    PRODUCT DISPLAY:
    - Products centered in viewport by default
    - Product image with padding showing white background
    - Title and pricing with sale display (strikethrough original + bold sale price)
    - Add-to-cart button that transforms into quantity selector capsule (minus left, quantity center, plus right)
    
    DISCOUNT BADGE:
    - Automatic discount badge on product images showing percentage off (e.g., "20% OFF")
    - Badge positioned on top-right corner of image
    - Only shows when product has compare-at price
    - Customizable badge colors and position
    
    LAYOUT OPTIONS (CRITICAL):
    - Toggle between horizontal scrolling and grid layout
    - Horizontal scroll mode: smooth scrolling with customizable scrollbar
    - Grid mode: responsive multi-column grid (4 cols desktop, 3 tablet, 2 mobile)
    - Scrollbar controls: show/hide, height, color, thumb color, border radius
    - Option to auto-hide scrollbar on mobile
    - Smooth transitions between layout modes
    
    RESPONSIVE DESIGN:
    - Desktop: Full card width with smooth scrolling
    - Tablet (768px-1024px): Cards scale to 70-80%, optimized spacing, touch scrolling
    - Mobile (below 768px): Cards scale to 60-70%, larger touch targets, optimized padding
    - Responsive images maintaining aspect ratio
    - Touch-friendly scrolling with momentum
    - Responsive typography
    - Smooth breakpoint transitions
    
    SCHEMA SETTINGS (customizable by merchant):
    - Layout mode toggle (horizontal scroll vs grid)
    - Scrollbar visibility toggle (show/hide)
    - Scrollbar height control
    - Scrollbar color customization
    - Scrollbar thumb color
    - Scrollbar border radius
    - Product alignment control (left, center, right)
    - Badge position (top-left, top-right)
    - Badge display toggle
    - Badge format (percentage or amount off)
    - Badge colors
    - Card hover effect intensity
    - Heading and description text
    - Card width, gap, padding controls
    - All color customizations
    
    FUNCTIONALITY:
    - Real-time navbar cart icon updates via Shopify cart API events
    - Smooth horizontal scrolling with left padding on load
    - AJAX cart operations without page reload
    - Premium healthcare/wellness styling
    - Mobile-optimized touch interactions
    
    Include heading "Sexual Wellness Packs" and description as default. Make layout mode and scrollbar fully customizable through theme settings., i dont want to select product , i want to choose collection, now when the device width is getting smaller , then price which is in red color is dividing where the Rs. is coming above but the price is 349.00 below which is an error . solve this issue and also i want the product cards to be centered suppose there is only two products then they should be showing aligned center with a setting controlling also for alignment adjusting . also add the arrows to show and make setting to turn them on or off . 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-showcase-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 0;
    background-color: {{ block.settings.section_bg_color }};
  }

  .ai-product-showcase-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-product-showcase-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: 32px;
  }

  .ai-product-showcase-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 12px;
    font-weight: 600;
  }

  .ai-product-showcase-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0;
    line-height: 1.6;
  }

  .ai-product-showcase-wrapper-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-product-showcase-grid-{{ ai_gen_id }} {
    {% if block.settings.layout_mode == 'scroll' %}
      display: flex;
      gap: {{ block.settings.card_gap }}px;
      overflow-x: auto;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      padding-left: {{ block.settings.scroll_padding_left }}px;
      padding-bottom: 20px;
      {% if block.settings.card_alignment == 'center' %}
        justify-content: center;
      {% elsif block.settings.card_alignment == 'right' %}
        justify-content: flex-end;
      {% else %}
        justify-content: flex-start;
      {% endif %}
    {% else %}
      display: grid;
      grid-template-columns: repeat({{ block.settings.grid_columns_desktop }}, 1fr);
      gap: {{ block.settings.card_gap }}px;
      {% if block.settings.card_alignment == 'center' %}
        justify-items: center;
      {% elsif block.settings.card_alignment == 'right' %}
        justify-items: end;
      {% else %}
        justify-items: start;
      {% endif %}
    {% endif %}
  }

  {% if block.settings.layout_mode == 'scroll' %}
    {% if block.settings.show_scrollbar %}
      .ai-product-showcase-grid-{{ ai_gen_id }}::-webkit-scrollbar {
        height: {{ block.settings.scrollbar_height }}px;
      }

      .ai-product-showcase-grid-{{ ai_gen_id }}::-webkit-scrollbar-track {
        background: {{ block.settings.scrollbar_track_color }};
        border-radius: {{ block.settings.scrollbar_radius }}px;
      }

      .ai-product-showcase-grid-{{ ai_gen_id }}::-webkit-scrollbar-thumb {
        background: {{ block.settings.scrollbar_thumb_color }};
        border-radius: {{ block.settings.scrollbar_radius }}px;
      }

      .ai-product-showcase-grid-{{ ai_gen_id }}::-webkit-scrollbar-thumb:hover {
        background: {{ block.settings.scrollbar_thumb_hover_color }};
      }
    {% else %}
      .ai-product-showcase-grid-{{ ai_gen_id }}::-webkit-scrollbar {
        display: none;
      }

      .ai-product-showcase-grid-{{ ai_gen_id }} {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
    {% endif %}
  {% endif %}

  {% if block.settings.layout_mode == 'scroll' and block.settings.show_arrows %}
    .ai-scroll-arrow-{{ ai_gen_id }} {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      background: {{ block.settings.arrow_bg_color }};
      color: {{ block.settings.arrow_color }};
      border: none;
      width: {{ block.settings.arrow_size }}px;
      height: {{ block.settings.arrow_size }}px;
      border-radius: 50%;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 10;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
      transition: all 0.3s ease;
      opacity: 0.9;
    }

    .ai-scroll-arrow-{{ ai_gen_id }}:hover {
      background: {{ block.settings.arrow_hover_bg_color }};
      opacity: 1;
      transform: translateY(-50%) scale(1.1);
    }

    .ai-scroll-arrow-{{ ai_gen_id }}:disabled {
      opacity: 0.3;
      cursor: not-allowed;
    }
    .ai-scroll-arrow-{{ ai_gen_id }}.hidden {
      display: none;
    }

    .ai-scroll-arrow-left-{{ ai_gen_id }} {
      left: 10px;
    }

    .ai-scroll-arrow-right-{{ ai_gen_id }} {
      right: 10px;
    }

    .ai-scroll-arrow-{{ ai_gen_id }} svg {
      width: {{ block.settings.arrow_size | times: 0.5 }}px;
      height: {{ block.settings.arrow_size | times: 0.5 }}px;
    }
  {% endif %}

  .ai-product-card-{{ ai_gen_id }} {
    {% if block.settings.layout_mode == 'scroll' %}
      flex: 0 0 {{ block.settings.card_width }}px;
      min-width: {{ block.settings.card_width }}px;
    {% endif %}
    background: {{ block.settings.card_bg_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    position: relative;
  }

  .ai-product-card-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.hover_lift }}px);
    box-shadow: 0 {{ block.settings.hover_shadow }}px {{ block.settings.hover_shadow | times: 2 }}px rgba(0, 0, 0, 0.1);
  }

  .ai-product-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    background: {{ block.settings.image_bg_color }};
    padding: {{ block.settings.image_padding }}px;
    border-radius: {{ block.settings.image_border_radius }}px;
    margin-bottom: 16px;
    overflow: hidden;
  }

  .ai-product-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  {% if block.settings.show_discount_badge %}
    .ai-discount-badge-{{ ai_gen_id }} {
      position: absolute;
      {% if block.settings.badge_position == 'top-left' %}
        top: 12px;
        left: 12px;
      {% else %}
        top: 12px;
        right: 12px;
      {% endif %}
      background: {{ block.settings.badge_bg_color }};
      color: {{ block.settings.badge_text_color }};
      padding: 6px 12px;
      border-radius: {{ block.settings.badge_border_radius }}px;
      font-size: {{ block.settings.badge_font_size }}px;
      font-weight: 700;
      z-index: 2;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
      white-space: nowrap;
    }
  {% endif %}

  .ai-product-info-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_title_color }};
    margin: 0 0 8px;
    font-weight: 600;
    line-height: 1.3;
  }

  .ai-product-price-{{ ai_gen_id }} {
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    {% if block.settings.text_alignment == 'center' %}
      justify-content: center;
    {% elsif block.settings.text_alignment == 'right' %}
      justify-content: flex-end;
    {% else %}
      justify-content: flex-start;
    {% endif %}
  }

  .ai-price-regular-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }};
    font-weight: 600;
    white-space: nowrap;
  }

  .ai-price-compare-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size | times: 0.9 }}px;
    color: {{ block.settings.compare_price_color }};
    text-decoration: line-through;
    white-space: nowrap;
  }

  .ai-price-sale-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.sale_price_color }};
    font-weight: 700;
    white-space: nowrap;
  }

  .ai-add-to-cart-btn-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px 24px;
    background: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    display: block;
  }

  .ai-add-to-cart-btn-{{ ai_gen_id }}:hover {
    background: {{ block.settings.button_hover_bg_color }};
    transform: translateY(-2px);
  }

  .ai-add-to-cart-btn-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-quantity-selector-{{ ai_gen_id }} {
    display: none;
    align-items: center;
    justify-content: space-between;
    background: {{ block.settings.quantity_bg_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    padding: 8px 12px;
    width: 100%;
  }

  .ai-quantity-selector-{{ ai_gen_id }}.active {
    display: flex;
  }

  .ai-quantity-btn-{{ ai_gen_id }} {
    background: {{ block.settings.quantity_button_bg }};
    color: {{ block.settings.quantity_button_color }};
    border: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 18px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .ai-quantity-btn-{{ ai_gen_id }}:hover {
    background: {{ block.settings.quantity_button_hover_bg }};
    transform: scale(1.1);
  }

  .ai-quantity-btn-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-quantity-display-{{ ai_gen_id }} {
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    color: {{ block.settings.quantity_text_color }};
    min-width: 40px;
    text-align: center;
  }

  @media screen and (max-width: 1024px) {
    .ai-product-showcase-grid-{{ ai_gen_id }} {
      {% if block.settings.layout_mode == 'grid' %}
        grid-template-columns: repeat({{ block.settings.grid_columns_tablet }}, 1fr);
      {% endif %}
    }

    .ai-product-card-{{ ai_gen_id }} {
      {% if block.settings.layout_mode == 'scroll' %}
        flex: 0 0 {{ block.settings.card_width | times: 0.75 }}px;
        min-width: {{ block.settings.card_width | times: 0.75 }}px;
      {% endif %}
    }

    .ai-product-showcase-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.9 }}px;
    }

    {% if block.settings.layout_mode == 'scroll' and block.settings.show_arrows %}
      .ai-scroll-arrow-{{ ai_gen_id }} {
        width: {{ block.settings.arrow_size | times: 0.85 }}px;
        height: {{ block.settings.arrow_size | times: 0.85 }}px;
      }

      .ai-scroll-arrow-{{ ai_gen_id }} svg {
        width: {{ block.settings.arrow_size | times: 0.42 }}px;
        height: {{ block.settings.arrow_size | times: 0.42 }}px;
      }
    {% endif %}
  }

  @media screen and (max-width: 768px) {
    .ai-product-showcase-grid-{{ ai_gen_id }} {
      {% if block.settings.layout_mode == 'grid' %}
        grid-template-columns: repeat({{ block.settings.grid_columns_mobile }}, 1fr);
      {% else %}
        padding-left: 0px;
      {% endif %}
    }

    .ai-product-card-{{ ai_gen_id }} {
      {% if block.settings.layout_mode == 'scroll' %}
        flex: 0 0 {{ block.settings.card_width | times: 0.65 }}px;
        min-width: {{ block.settings.card_width | times: 0.65 }}px;
      {% endif %}
    }

    .ai-product-showcase-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-product-showcase-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }

    {% if block.settings.hide_scrollbar_mobile and block.settings.layout_mode == 'scroll' %}
      .ai-product-showcase-grid-{{ ai_gen_id }}::-webkit-scrollbar {
        display: none;
      }

      .ai-product-showcase-grid-{{ ai_gen_id }} {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
    {% endif %}

    {% if block.settings.layout_mode == 'scroll' and block.settings.show_arrows %}
      {% if block.settings.hide_arrows_mobile %}
        .ai-scroll-arrow-{{ ai_gen_id }} {
          display: none;
        }
      {% else %}
        .ai-scroll-arrow-{{ ai_gen_id }} {
          width: {{ block.settings.arrow_size | times: 0.7 }}px;
          height: {{ block.settings.arrow_size | times: 0.7 }}px;
        }

        .ai-scroll-arrow-{{ ai_gen_id }} svg {
          width: {{ block.settings.arrow_size | times: 0.35 }}px;
          height: {{ block.settings.arrow_size | times: 0.35 }}px;
        }

        .ai-scroll-arrow-left-{{ ai_gen_id }} {
          left: 5px;
        }

        .ai-scroll-arrow-right-{{ ai_gen_id }} {
          right: 5px;
        }
      {% endif %}
    {% endif %}
  }
{% endstyle %}

<product-showcase-{{ ai_gen_id }} class="ai-product-showcase-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-showcase-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.description != blank %}
      <div class="ai-product-showcase-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-product-showcase-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.description != blank %}
          <p class="ai-product-showcase-description-{{ ai_gen_id }}">{{ block.settings.description }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-product-showcase-wrapper-{{ ai_gen_id }}">
      {% if block.settings.layout_mode == 'scroll' and block.settings.show_arrows %}
        <button class="ai-scroll-arrow-{{ ai_gen_id }} ai-scroll-arrow-left-{{ ai_gen_id }}" aria-label="Scroll left">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button class="ai-scroll-arrow-{{ ai_gen_id }} ai-scroll-arrow-right-{{ ai_gen_id }}" aria-label="Scroll right">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      {% endif %}

      <div class="ai-product-showcase-grid-{{ ai_gen_id }}">
        {% if block.settings.collection != blank %}
          {% assign collection = block.settings.collection %}
          {% assign products_to_show = block.settings.products_limit %}
          
          {% for product in collection.products limit: products_to_show %}
            <div class="ai-product-card-{{ ai_gen_id }}" data-product-id="{{ product.id }}">
              <div class="ai-product-image-wrapper-{{ ai_gen_id }}">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    class="ai-product-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="600"
                    height="600"
                  >
                {% else %}
                  <div class="ai-product-image-placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}

                {% if block.settings.show_discount_badge and product.compare_at_price > product.price %}
                  {% assign discount_percent = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round %}
                  <div class="ai-discount-badge-{{ ai_gen_id }}">
                    {% if block.settings.badge_format == 'percentage' %}
                      {{ discount_percent }}% OFF
                    {% else %}
                      {{ product.compare_at_price | minus: product.price | money }} OFF
                    {% endif %}
                  </div>
                {% endif %}
              </div>

              <div class="ai-product-info-{{ ai_gen_id }}">
                <h3 class="ai-product-title-{{ ai_gen_id }}">{{ product.title }}</h3>

                <div class="ai-product-price-{{ ai_gen_id }}">
                  {% if product.compare_at_price > product.price %}
                    <span class="ai-price-compare-{{ ai_gen_id }}">{{ product.compare_at_price | money }}</span>
                    <span class="ai-price-sale-{{ ai_gen_id }}">{{ product.price | money }}</span>
                  {% else %}
                    <span class="ai-price-regular-{{ ai_gen_id }}">{{ product.price | money }}</span>
                  {% endif %}
                </div>

                <button
                  class="ai-add-to-cart-btn-{{ ai_gen_id }}"
                  data-product-id="{{ product.id }}"
                  data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                  {% unless product.available %}disabled{% endunless %}
                >
                  {% if product.available %}
                    {{ block.settings.add_to_cart_text }}
                  {% else %}
                    Sold Out
                  {% endif %}
                </button>

                <div class="ai-quantity-selector-{{ ai_gen_id }}" data-product-id="{{ product.id }}">
                  <button class="ai-quantity-btn-{{ ai_gen_id }} ai-quantity-minus-{{ ai_gen_id }}" data-action="minus">−</button>
                  <span class="ai-quantity-display-{{ ai_gen_id }}">1</span>
                  <button class="ai-quantity-btn-{{ ai_gen_id }} ai-quantity-plus-{{ ai_gen_id }}" data-action="plus">+</button>
                </div>
              </div>
            </div>
          {% endfor %}
        {% else %}
          {% for i in (1..6) %}
            <div class="ai-product-card-{{ ai_gen_id }}">
              <div class="ai-product-image-wrapper-{{ ai_gen_id }}">
                <div class="ai-product-image-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              </div>
              <div class="ai-product-info-{{ ai_gen_id }}">
                <h3 class="ai-product-title-{{ ai_gen_id }}">Product Title</h3>
                <div class="ai-product-price-{{ ai_gen_id }}">
                  <span class="ai-price-regular-{{ ai_gen_id }}">₹999</span>
                </div>
                <button class="ai-add-to-cart-btn-{{ ai_gen_id }}" disabled>Select a collection</button>
              </div>
            </div>
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>
</product-showcase-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductShowcase{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.cartQuantities = {};
      }

      connectedCallback() {
        this.addToCartButtons = this.querySelectorAll('.ai-add-to-cart-btn-{{ ai_gen_id }}');
        this.quantitySelectors = this.querySelectorAll('.ai-quantity-selector-{{ ai_gen_id }}');
        this.scrollContainer = this.querySelector('.ai-product-showcase-grid-{{ ai_gen_id }}');
        this.leftArrow = this.querySelector('.ai-scroll-arrow-left-{{ ai_gen_id }}');
        this.rightArrow = this.querySelector('.ai-scroll-arrow-right-{{ ai_gen_id }}');
        
        this.setupEventListeners();
        this.setupScrollArrows();
        this.checkScrollability();
        
        // Check scrollability on window resize
        window.addEventListener('resize', () => this.checkScrollability());
      }

      setupEventListeners() {
        this.addToCartButtons.forEach((button) => {
          button.addEventListener('click', (e) => this.handleAddToCart(e));
        });

        this.quantitySelectors.forEach((selector) => {
          const minusBtn = selector.querySelector('.ai-quantity-minus-{{ ai_gen_id }}');
          const plusBtn = selector.querySelector('.ai-quantity-plus-{{ ai_gen_id }}');

          minusBtn.addEventListener('click', (e) => this.handleQuantityChange(e, 'minus'));
          plusBtn.addEventListener('click', (e) => this.handleQuantityChange(e, 'plus'));
        });
      }

      setupScrollArrows() {
        if (!this.leftArrow || !this.rightArrow || !this.scrollContainer) return;

        this.leftArrow.addEventListener('click', () => {
          this.scrollContainer.scrollBy({
            left: -300,
            behavior: 'smooth'
          });
        });

        this.rightArrow.addEventListener('click', () => {
          this.scrollContainer.scrollBy({
            left: 300,
            behavior: 'smooth'
          });
        });

        this.scrollContainer.addEventListener('scroll', () => {
          this.updateArrowStates();
        });

        this.updateArrowStates();
      }

      checkScrollability() {
        if (!this.scrollContainer || !this.leftArrow || !this.rightArrow) return;
        
        const hasScroll = this.scrollContainer.scrollWidth > this.scrollContainer.clientWidth;
        
        if (!hasScroll) {
          this.leftArrow.classList.add('hidden');
          this.rightArrow.classList.add('hidden');
        } else {
          this.leftArrow.classList.remove('hidden');
          this.rightArrow.classList.remove('hidden');
          this.updateArrowStates();
        }
      }

      updateArrowStates() {
        if (!this.leftArrow || !this.rightArrow || !this.scrollContainer) return;

        const scrollLeft = this.scrollContainer.scrollLeft;
        const maxScroll = this.scrollContainer.scrollWidth - this.scrollContainer.clientWidth;

        if (scrollLeft <= 0) {
          this.leftArrow.disabled = true;
        } else {
          this.leftArrow.disabled = false;
        }

        if (scrollLeft >= maxScroll - 1) {
          this.rightArrow.disabled = true;
        } else {
          this.rightArrow.disabled = false;
        }
      }

      async handleAddToCart(event) {
        const button = event.target;
        const variantId = button.dataset.variantId;
        const productId = button.dataset.productId;

        if (!variantId || button.disabled) return;

        button.disabled = true;
        const originalText = button.textContent;
        button.textContent = 'Adding...';

        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              id: variantId,
              quantity: 1,
            }),
          });

          if (response.ok) {
            this.cartQuantities[productId] = 1;
            this.showQuantitySelector(productId);
            this.updateCartIcon();
          } else {
            throw new Error('Failed to add to cart');
          }
        } catch (error) {
          console.error('Error adding to cart:', error);
          button.textContent = originalText;
          button.disabled = false;
        }
      }

      async handleQuantityChange(event, action) {
        const button = event.target;
        const selector = button.closest('.ai-quantity-selector-{{ ai_gen_id }}');
        const productId = selector.dataset.productId;
        const display = selector.querySelector('.ai-quantity-display-{{ ai_gen_id }}');
        const card = selector.closest('.ai-product-card-{{ ai_gen_id }}');
        const addToCartBtn = card.querySelector('.ai-add-to-cart-btn-{{ ai_gen_id }}');
        const variantId = addToCartBtn.dataset.variantId;

        let currentQty = this.cartQuantities[productId] || 0;
        let newQty = action === 'plus' ? currentQty + 1 : currentQty - 1;

        if (newQty < 0) return;

        button.disabled = true;

        try {
          if (newQty === 0) {
            await fetch('/cart/change.js', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify({
                id: variantId,
                quantity: 0,
              }),
            });

            this.cartQuantities[productId] = 0;
            this.hideQuantitySelector(productId);
            this.updateCartIcon();
          } else {
            const response = await fetch('/cart/change.js', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify({
                id: variantId,
                quantity: newQty,
              }),
            });

            if (response.ok) {
              this.cartQuantities[productId] = newQty;
              display.textContent = newQty;
              this.updateCartIcon();
            }
          }
        } catch (error) {
          console.error('Error updating quantity:', error);
        } finally {
          button.disabled = false;
        }
      }

      showQuantitySelector(productId) {
        const card = this.querySelector(`.ai-product-card-{{ ai_gen_id }}[data-product-id="${productId}"]`);
        if (!card) return;

        const addToCartBtn = card.querySelector('.ai-add-to-cart-btn-{{ ai_gen_id }}');
        const quantitySelector = card.querySelector('.ai-quantity-selector-{{ ai_gen_id }}');
        const display = quantitySelector.querySelector('.ai-quantity-display-{{ ai_gen_id }}');

        addToCartBtn.style.display = 'none';
        quantitySelector.classList.add('active');
        display.textContent = this.cartQuantities[productId] || 1;
      }

      hideQuantitySelector(productId) {
        const card = this.querySelector(`.ai-product-card-{{ ai_gen_id }}[data-product-id="${productId}"]`);
        if (!card) return;

        const addToCartBtn = card.querySelector('.ai-add-to-cart-btn-{{ ai_gen_id }}');
        const quantitySelector = card.querySelector('.ai-quantity-selector-{{ ai_gen_id }}');

        quantitySelector.classList.remove('active');
        addToCartBtn.style.display = 'block';
        addToCartBtn.disabled = false;
        addToCartBtn.textContent = addToCartBtn.dataset.originalText || '{{ block.settings.add_to_cart_text }}';
      }

      async updateCartIcon() {
        try {
          const response = await fetch('/cart.js');
          const cart = await response.json();

          document.dispatchEvent(new CustomEvent('cart:updated', {
            detail: { cart }
          }));

          const cartCountElements = document.querySelectorAll('.cart-count-bubble, [data-cart-count]');
          cartCountElements.forEach((element) => {
            element.textContent = cart.item_count;
            if (cart.item_count > 0) {
              element.style.display = 'flex';
            }
          });
        } catch (error) {
          console.error('Error updating cart icon:', error);
        }
      }
    }

    customElements.define('product-showcase-{{ ai_gen_id }}', ProductShowcase{{ ai_gen_id }});
  })();
</script>


