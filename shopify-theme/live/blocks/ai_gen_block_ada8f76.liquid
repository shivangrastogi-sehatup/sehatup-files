    },
    {
      "type": "text",
      "id": "card_title_should_not_use",
      "label": "Should not use title",
      "default": "Who Should Not Use [product_name]",
      "info": "Use [product_name] as placeholder"
    },
    {
      "type": "range",
      "id": "card_title_size",
      "label": "Size",
      "min": 16,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Color",
      "default": "#262626"
    },
    {
      "type": "select",
      "id": "card_title_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "range",
      "id": "card_title_spacing",
      "label": "Bottom spacing",
      "min": 8,
      "max": 40,
      "step": 4,
