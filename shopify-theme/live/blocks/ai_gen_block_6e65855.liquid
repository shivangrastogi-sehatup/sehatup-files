{% doc %}
  @prompt
    Create a responsive video gallery section with heading, description, video thumbnail cards with play buttons, and a CTA button.
    
    Layout structure:
    - Main heading: "We Built sehatUP Because Healthcare Was Broken"
    - Subheading/description: "Our Founders Explain Why India Needs Integrated Care—And Why Shortcuts, Symptom-Only Medicine, And Stigma Have Failed Us."
    - Three video cards in a row (3 columns desktop, stacked mobile):
    
    Card 1:
    - Video thumbnail image with overlay
    - Play button icon (centered)
    - Label: "The Problem"
    - Title: "Healthcare Treats Parts Of You. We Treat Your Whole Story."
    
    Card 2:
    - Video thumbnail image with overlay
    - Play button icon (centered)
    - Label: "The Breakthrough"
    - Title: "Why Three Systems Of Medicine Together Is The Only Logical Future."
    
    Card 3:
    - Video thumbnail image with overlay
    - Play button icon (centered)
    - Label: "The Mission"
    - Title: "Healthcare Shouldn't Be Embarrassing, Expensive, Or Fragmented— It Should Be Personal, Private, And Precise."
    
    Below cards:
    - CTA button: "Watch More On Our YouTube" (outline style, rounded)
    
    Requirements:
    - Fully responsive layout:
      * Desktop: 3 columns in a row, centered content
      * Tablet: 3 columns with adjusted spacing or 2+1 layout
      * Mobile: single column, stacked vertically
    - Settings schema to customize:
      * Section heading text and typography (size, weight, color, alignment)
      * Section description text and typography
      * Section background color
      * Content max-width control
      * Video cards (repeatable blocks):
        - Video thumbnail image upload
        - Video URL or embed code
        - Play button icon (upload or built-in)
        - Play button size and color
        - Label text (e.g., "The Problem")
        - Title/description text
        - Overlay color and opacity
        - Card border radius
        - Hover effects (zoom, brightness)
      * Grid layout: columns per row (2, 3, or 4 on desktop)
      * Typography controls:
        - Label font size, weight, color
        - Title font size, weight, color, line height
      * Spacing controls: section padding, card gaps, text spacing
      * Card styling: border radius, aspect ratio (16:9, 4:3, square)
      * Play button styling: size, color, background circle, hover effects
      * Text overlay positioning and styling
      * CTA button: text, link, style (filled/outline), colors, border radius
      * Button alignment (center, left, right)
      * Mobile-specific: card spacing, font size overrides, button width
    - Video cards should have rounded corners and overlay text
    - Play button centered on each card with hover effect
    - Cards should open video in lightbox/modal or link to YouTube
    - Equal height cards on desktop
    - Text overlay should be readable with proper contrast
    - CTA button centered below cards with outline style
    - Mobile: cards stack vertically, full width
    - Support for adding/removing video cards (flexible blocks)
    - Optional: autoplay video on hover
    - Optional: video modal/lightbox functionality
    - Accessible color contrast ratios
    - Support for 2-6 video cards in flexible grid
    - Smooth hover transitions on cards and play button
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-gallery-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.section_bg_color }};
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
  }

  .ai-video-gallery-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-video-gallery-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-video-gallery-heading-{{ ai_gen_id }} {
    font-size: clamp(24px, 3.4vw, 64px);
    font-weight: {{ block.settings.heading_weight }};
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px;
    line-height: 1.2;
  }

  .ai-video-gallery-description-{{ ai_gen_id }} {
    font-size: clamp(10px, 1vw, 20px);
    color: {{ block.settings.description_color }};
    line-height: 1.5;
    margin: 0;
  }

  .ai-video-gallery-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.card_gap }}px;
    margin-bottom: {{ block.settings.cta_spacing }}px;
  }

  .ai-video-card-{{ ai_gen_id }} {
    position: relative;
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.3s ease;
  }

  .ai-video-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
  }

  .ai-video-card-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {% if block.settings.aspect_ratio == '16-9' %}56.25%{% elsif block.settings.aspect_ratio == '4-3' %}75%{% else %}100%{% endif %};
    background-color: #f4f4f4;
    overflow: hidden;
  }

  .ai-video-card-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease, filter 0.3s ease;
  }

  .ai-video-card-{{ ai_gen_id }}:hover .ai-video-card-image-{{ ai_gen_id }} {
    transform: scale(1.05);
    filter: brightness(0.8);
  }

  .ai-video-card-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    transition: opacity 0.3s ease;
  }

  .ai-video-card-{{ ai_gen_id }}:hover .ai-video-card-overlay-{{ ai_gen_id }} {
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 | times: 1.3 | at_most: 1 }};
  }

  .ai-video-card-play-button-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: {{ block.settings.play_button_size }}px;
    height: {{ block.settings.play_button_size }}px;
    background-color: {{ block.settings.play_button_bg_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: transform 0.3s ease, background-color 0.3s ease;
  }

  .ai-video-card-{{ ai_gen_id }}:hover .ai-video-card-play-button-{{ ai_gen_id }} {
    transform: translate(-50%, -50%) scale(1.1);
    background-color: {{ block.settings.play_button_hover_bg_color }};
  }

  .ai-video-card-play-icon-{{ ai_gen_id }} {
    width: calc({{ block.settings.play_button_size }}px * 0.4);
    height: calc({{ block.settings.play_button_size }}px * 0.4);
    margin-left: 4px;
  }

  .ai-video-card-play-icon-{{ ai_gen_id }} polygon {
    fill: {{ block.settings.play_button_icon_color }};
  }

  .ai-video-card-content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_text_padding }}px;
    background-color: {{ block.settings.card_bg_color }};
  }

  .ai-video-card-label-{{ ai_gen_id }} {
    font-size: clamp(10px, 1vw, 20px);
    font-weight: {{ block.settings.label_weight }};
    color: {{ block.settings.label_color }};
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0 0 8px;
  }

  .ai-video-card-title-{{ ai_gen_id }} {
    font-size: clamp(10px, 1vw, 20px);
    font-weight: {{ block.settings.title_weight }};
    color: {{ block.settings.title_color }};
    line-height: {{ block.settings.title_line_height }};
    margin: 0;
  }

  .ai-video-gallery-cta-{{ ai_gen_id }} {
    text-align: {{ block.settings.button_alignment }};
  }

  .ai-video-gallery-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 14px 32px;
    font-weight: 500;
    color: {{ block.settings.button_text_color }};
    background-color: {{ block.settings.button_bg_color }};
    border: 2px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    text-decoration: none;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .ai-video-gallery-button-{{ ai_gen_id }}:hover {
    color: {{ block.settings.button_hover_text_color }};
    background-color: {{ block.settings.button_hover_bg_color }};
    border-color: {{ block.settings.button_hover_border_color }};
    transform: translateY(-2px);
  }

  .ai-video-modal-{{ ai_gen_id }} {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.9);
    z-index: 9999;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .ai-video-modal-{{ ai_gen_id }}.active {
    display: flex;
  }

  .ai-video-modal-content-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    max-width: 1200px;
    aspect-ratio: 16 / 9;
    background-color: #000;
  }

  .ai-video-modal-close-{{ ai_gen_id }} {
    position: absolute;
    top: -40px;
    right: 0;
    background: none;
    border: none;
    color: #fff;
    font-size: 32px;
    cursor: pointer;
    padding: 0;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.3s ease;
  }

  .ai-video-modal-close-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-video-modal-iframe-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    border: none;
  }

  .ai-video-card-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-video-card-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @media screen and (max-width: 989px) {
    .ai-video-gallery-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
      gap: {{ block.settings.card_gap_mobile }}px;
    }

    .ai-video-gallery-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-video-gallery-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size_mobile }}px;
    }

    .ai-video-card-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size_mobile }}px;
    }

    .ai-video-card-label-{{ ai_gen_id }} {
      font-size: {{ block.settings.label_size_mobile }}px;
    }

    .ai-video-gallery-button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_font_size_mobile }}px;
      {% if block.settings.button_full_width_mobile %}
        width: 100%;
      {% endif %}
    }
  }

  @media screen and (max-width: 749px) {
    .ai-video-gallery-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-video-gallery-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top_mobile }}px 0 {{ block.settings.section_padding_bottom_mobile }}px;
    }
  }
{% endstyle %}

<video-gallery-{{ ai_gen_id }} class="ai-video-gallery-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-video-gallery-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.description != blank %}
      <div class="ai-video-gallery-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-video-gallery-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.description != blank %}
          <div class="ai-video-gallery-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-video-gallery-grid-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign video_enabled_key = 'video_' | append: i | append: '_enabled'
          assign thumbnail_key = 'video_' | append: i | append: '_thumbnail'
          assign url_key = 'video_' | append: i | append: '_url'
          assign label_key = 'video_' | append: i | append: '_label'
          assign title_key = 'video_' | append: i | append: '_title'

          assign video_enabled = block.settings[video_enabled_key]
          assign thumbnail = block.settings[thumbnail_key]
          assign video_url = block.settings[url_key]
          assign label = block.settings[label_key]
          assign title = block.settings[title_key]
        %}

        {% if video_enabled %}
          <div class="ai-video-card-{{ ai_gen_id }}" data-video-url="{{ video_url }}">
            <div class="ai-video-card-image-wrapper-{{ ai_gen_id }}">
              {% if thumbnail %}
                <img
                  src="{{ thumbnail | image_url: width: 800 }}"
                  alt="{{ title | escape }}"
                  class="ai-video-card-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="800"
                  height="450"
                >
              {% else %}
                <div class="ai-video-card-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
              <div class="ai-video-card-overlay-{{ ai_gen_id }}"></div>
              <div class="ai-video-card-play-button-{{ ai_gen_id }}">
                <svg class="ai-video-card-play-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <polygon points="5,3 19,12 5,21" />
                </svg>
              </div>
            </div>
            <div class="ai-video-card-content-{{ ai_gen_id }}">
              {% if label != blank %}
                <div class="ai-video-card-label-{{ ai_gen_id }}">{{ label }}</div>
              {% endif %}
              {% if title != blank %}
                <h3 class="ai-video-card-title-{{ ai_gen_id }}">{{ title }}</h3>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if block.settings.cta_text != blank %}
      <div class="ai-video-gallery-cta-{{ ai_gen_id }}">
        <a href="{{ block.settings.cta_url }}" class="ai-video-gallery-button-{{ ai_gen_id }}">
          {{ block.settings.cta_text }}
        </a>
      </div>
    {% endif %}
  </div>

  <div class="ai-video-modal-{{ ai_gen_id }}" role="dialog" aria-modal="true" aria-label="Video player">
    <div class="ai-video-modal-content-{{ ai_gen_id }}">
      <button class="ai-video-modal-close-{{ ai_gen_id }}" aria-label="Close video">&times;</button>
      <iframe class="ai-video-modal-iframe-{{ ai_gen_id }}" src="" allow="autoplay; encrypted-media" allowfullscreen></iframe>
    </div>
  </div>
</video-gallery-{{ ai_gen_id }}>

<script>
  (function() {
    class VideoGallery{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.videoCards = this.querySelectorAll('.ai-video-card-{{ ai_gen_id }}');
        this.modal = this.querySelector('.ai-video-modal-{{ ai_gen_id }}');
        this.modalIframe = this.querySelector('.ai-video-modal-iframe-{{ ai_gen_id }}');
        this.closeButton = this.querySelector('.ai-video-modal-close-{{ ai_gen_id }}');

        this.setupEventListeners();
      }

      setupEventListeners() {
        this.videoCards.forEach((card) => {
          card.addEventListener('click', () => {
            const videoUrl = card.getAttribute('data-video-url');
            if (videoUrl) {
              this.openModal(videoUrl);
            }
          });
        });

        this.closeButton.addEventListener('click', () => {
          this.closeModal();
        });

        this.modal.addEventListener('click', (e) => {
          if (e.target === this.modal) {
            this.closeModal();
          }
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && this.modal.classList.contains('active')) {
            this.closeModal();
          }
        });
      }

      openModal(videoUrl) {
        const embedUrl = this.getEmbedUrl(videoUrl);
        if (embedUrl) {
          this.modalIframe.src = embedUrl;
          this.modal.classList.add('active');
          document.body.style.overflow = 'hidden';
        }
      }

      closeModal() {
        this.modal.classList.remove('active');
        this.modalIframe.src = '';
        document.body.style.overflow = '';
      }

      getEmbedUrl(url) {
        if (!url) return null;

        let videoId = '';
        
        if (url.includes('youtube.com') || url.includes('youtu.be')) {
          const youtubeRegex = /(?:youtube\.com\/(?:[^\/]+\/.+\/|(?:v|e(?:mbed)?)\/|.*[?&]v=)|youtu\.be\/)([^"&?\/\s]{11})/;
          const match = url.match(youtubeRegex);
          if (match && match[1]) {
            videoId = match[1];
            return 'https://www.youtube.com/embed/' + videoId + '?autoplay=1';
          }
        }
        
        if (url.includes('vimeo.com')) {
          const vimeoRegex = /vimeo\.com\/(?:channels\/(?:\w+\/)?|groups\/([^\/]*)\/videos\/|album\/(\d+)\/video\/|)(\d+)(?:$|\/|\?)/;
          const match = url.match(vimeoRegex);
          if (match && match[3]) {
            videoId = match[3];
            return 'https://player.vimeo.com/video/' + videoId + '?autoplay=1';
          }
        }

        return url;
      }
    }

    customElements.define('video-gallery-{{ ai_gen_id }}', VideoGallery{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Video gallery",
  "tag": null,
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "We Built sehatUP Because Healthcare Was Broken"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Our Founders Explain Why India Needs Integrated Care—And Why Shortcuts, Symptom-Only Medicine, And Stigma Have Failed Us.</p>"
