{% doc %}
  @prompt
    Create a responsive "Our Commitment" feature section with icon-based commitment cards in a horizontal layout.
    
    Layout structure:
    - Section heading: "Our Commitment"
    - Three feature cards in a row (3 columns desktop, stacked mobile):
    
    Card 1:
    - Icon: lock/padlock icon
    - Title: "Privacy First"
    - Description: "All your answers are encrypted."
    
    Card 2:
    - Icon: shield with checkmark icon
    - Title: "Quality Assured"
    - Description: "AYUSH-approved products. Doctor-reviewed plans. No shortcuts."
    
    Card 3:
    - Icon: clock/24-7 icon
    - Title: "Always Accessible"
    - Description: "Health doesn't clock out-and neither do we."
    
    Requirements:
    - Fully responsive layout:
      * Desktop: 3 columns in a row, evenly spaced
      * Tablet: 3 columns with adjusted spacing or 2+1 layout
      * Mobile: single column, stacked vertically
    - Settings schema to customize:
      * Section heading text and typography (size, weight, color, alignment)
      * Section background color
      * Content max-width control
      * Section padding (top/bottom)
      * Feature cards (repeatable blocks):
        - Icon upload or icon picker
        - Icon size control
        - Icon color
        - Title text
        - Description text
        - Card alignment (center, left)
      * Grid layout: columns per row (2, 3, or 4 on desktop)
      * Typography controls:
        - Title font size, weight, color
        - Description font size, color, line height
      * Spacing controls: section padding, card gaps, icon-to-text spacing
      * Icon styling: size, color, background circle (optional)
      * Text alignment within cards (center or left)
      * Card background color (optional)
      * Card padding and border (optional)
      * Mobile-specific: icon size, font size overrides, card spacing
    - Icons should be simple, clean, and centered above text
    - Cards should be center-aligned by default
    - Equal spacing between cards
    - Clean, minimal design with good readability
    - Support for adding/removing commitment cards (flexible blocks)
    - Icons should be consistent size across all cards
    - Mobile: cards stack vertically, full width, center-aligned
    - Optional: subtle background or border on cards
    - Optional: hover effects on cards (lift, shadow)
    - Accessible color contrast ratios
    - Support for 2-6 feature cards in flexible grid
    - Light background section with dark text for contrast
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-commitment-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.section_background_color }};
  }

  .ai-commitment-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-commitment-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    color: {{ block.settings.heading_color }};
    text-align: {{ block.settings.heading_alignment }};
    margin: 0 0 {{ block.settings.heading_bottom_spacing }}px;
    line-height: 1.2;
  }

  .ai-commitment-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.desktop_columns }}, 1fr);
    gap: {{ block.settings.card_gap }}px;
    margin: 0;
  }

  .ai-commitment-card-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: {{ block.settings.card_alignment }};
    text-align: {{ block.settings.card_alignment }};
    padding: {{ block.settings.card_padding }}px;
    background-color: {{ block.settings.card_background_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    {% if block.settings.card_border_thickness > 0 %}
      border: {{ block.settings.card_border_thickness }}px solid {{ block.settings.card_border_color }};
    {% endif %}
    {% if block.settings.enable_card_hover %}
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    {% endif %}
  }

  {% if block.settings.enable_card_hover %}
    .ai-commitment-card-{{ ai_gen_id }}:hover {
      transform: translateY(-{{ block.settings.card_hover_lift }}px);
      box-shadow: 0 {{ block.settings.card_hover_shadow }}px {{ block.settings.card_hover_shadow | times: 2 }}px rgba(0, 0, 0, 0.1);
    }
  {% endif %}

  .ai-commitment-icon-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin-bottom: {{ block.settings.icon_to_text_spacing }}px;
    {% if block.settings.icon_background_circle %}
      background-color: {{ block.settings.icon_background_color }};
      border-radius: 50%;
      padding: {{ block.settings.icon_circle_padding }}px;
    {% endif %}
  }

  .ai-commitment-icon-wrapper-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: {{ block.settings.icon_color }};
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ai-commitment-icon-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-commitment-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_bottom_spacing }}px;
    line-height: 1.3;
  }

  .ai-commitment-card-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: {{ block.settings.description_line_height }};
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-commitment-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.tablet_columns }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-commitment-section-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_section_padding_top }}px 0 {{ block.settings.mobile_section_padding_bottom }}px;
    }

    .ai-commitment-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_heading_size }}px;
      margin-bottom: {{ block.settings.heading_bottom_spacing | times: 0.8 }}px;
    }

    .ai-commitment-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_card_gap }}px;
    }

    .ai-commitment-card-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_card_padding }}px;
    }

    .ai-commitment-icon-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_icon_size }}px;
      height: {{ block.settings.mobile_icon_size }}px;
    }

    .ai-commitment-card-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_title_size }}px;
    }

    .ai-commitment-card-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_description_size }}px;
    }
  }
{% endstyle %}

<commitment-section-{{ ai_gen_id }} class="ai-commitment-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-commitment-container-{{ ai_gen_id }}">
    {% if block.settings.section_heading != blank %}
      <h2 class="ai-commitment-heading-{{ ai_gen_id }}">{{ block.settings.section_heading }}</h2>
    {% endif %}

    <div class="ai-commitment-grid-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign card_enabled_key = 'card_' | append: i | append: '_enabled'
          assign icon_type_key = 'card_' | append: i | append: '_icon_type'
          assign custom_icon_key = 'card_' | append: i | append: '_custom_icon'
          assign title_key = 'card_' | append: i | append: '_title'
          assign description_key = 'card_' | append: i | append: '_description'

          assign card_enabled = block.settings[card_enabled_key]
          assign icon_type = block.settings[icon_type_key]
          assign custom_icon = block.settings[custom_icon_key]
          assign card_title = block.settings[title_key]
          assign card_description = block.settings[description_key]
        %}

        {% if card_enabled %}
          <div class="ai-commitment-card-{{ ai_gen_id }}" role="article">
            <div class="ai-commitment-icon-wrapper-{{ ai_gen_id }}">
              {% if custom_icon != blank %}
                <img
                  src="{{ custom_icon | image_url: width: 200 }}"
                  alt="{{ card_title | escape }}"
                  loading="lazy"
                  width="200"
                  height="200"
                >
              {% else %}
                {% case icon_type %}
                  {% when 'lock' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                      <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                      <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                  {% when 'shield' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                      <polyline points="9 12 11 14 15 10"></polyline>
                    </svg>
                  {% when 'clock' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                      <circle cx="12" cy="12" r="10"></circle>
                      <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                  {% when 'heart' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                    </svg>
                  {% when 'star' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>
                  {% when 'check' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                      <circle cx="12" cy="12" r="10"></circle>
                      <polyline points="9 12 11 14 15 10"></polyline>
                    </svg>
                  {% when 'award' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                      <circle cx="12" cy="8" r="7"></circle>
                      <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
                    </svg>
                  {% when 'leaf' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                      <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path>
                      <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path>
                    </svg>
                  {% when 'truck' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                      <rect x="1" y="3" width="15" height="13"></rect>
                      <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                      <circle cx="5.5" cy="18.5" r="2.5"></circle>
                      <circle cx="18.5" cy="18.5" r="2.5"></circle>
                    </svg>
                  {% when 'users' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                      <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                      <circle cx="9" cy="7" r="4"></circle>
                      <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                      <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                {% endcase %}
              {% endif %}
            </div>

            {% if card_title != blank %}
              <h3 class="ai-commitment-card-title-{{ ai_gen_id }}">{{ card_title }}</h3>
            {% endif %}

            {% if card_description != blank %}
              <p class="ai-commitment-card-description-{{ ai_gen_id }}">{{ card_description }}</p>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</commitment-section-{{ ai_gen_id }}>

<script>
  (function() {
    class CommitmentSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.initAccessibility();
      }

      initAccessibility() {
        const cards = this.querySelectorAll('.ai-commitment-card-{{ ai_gen_id }}');
        cards.forEach(card => {
          card.setAttribute('role', 'article');
        });
      }
    }

    customElements.define('commitment-section-{{ ai_gen_id }}', CommitmentSection{{ ai_gen_id }});
  })();
</script>

