{% doc %}
  @prompt
    Create a responsive health assessment section with the heading "Know More About Your Body Than Your Mirror Can Tell" and subheading "A quick 2-minute check to understand what your body really needs — and how to fix it."
    
    The section should display two side-by-side cards on desktop/tablet and stack vertically on mobile:
    
    Left card (pink/lavender background):
    - Image of a woman in red outfit
    - Black button labeled "Period Care"
    - Outlined button labeled "Weight Management"
    
    Right card (light blue background):
    - Image of a man in plaid shirt
    - Black button labeled "Sexual Health"
    - Outlined button labeled "Weight Management"
    
    Requirements:
    - Fully responsive layout (desktop, tablet, mobile)
    - Settings schema to customize:
      * Section heading and subheading text
      * Card background colors
      * Images for both cards
      * Button labels and links for all four buttons
      * Button styling (filled vs outlined)
      * Spacing and padding controls
    - Cards should have rounded corners and subtle shadows
    - Buttons should be rounded with hover effects
    - Mobile: cards stack vertically, full width
    - Tablet: 2 columns with appropriate spacing
    - Desktop: 2 columns, centered, max-width container
    - Include color picker for card backgrounds and button colors
    - Allow customization of text alignment and font sizes
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-health-assessment-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.section_background_color }};
  }

  .ai-health-assessment-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_max_width }}px;
    margin: 0 auto;
  }

  .ai-health-assessment-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-health-assessment-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px;
    line-height: 1.2;
    font-weight: 600;
  }

  .ai-health-assessment-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-health-assessment-cards-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ block.settings.card_gap }}px;
  }

  .ai-health-assessment-heading-{{ ai_gen_id }} {
    font-size: clamp(24px,3.4vw,64px);
  }

  .ai-health-assessment-subheading-{{ ai_gen_id }} {
    font-size: clamp(13px,1.2vw,22px)
  }

  @media screen and (min-width: 750px) {
    .ai-health-assessment-cards-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-health-assessment-heading-{{ ai_gen_id }} {
      {% comment %} font-size: calc({{ block.settings.heading_size }}px * 1.2); {% endcomment %}
    }

    .ai-health-assessment-subheading-{{ ai_gen_id }} {
      {% comment %} font-size: calc({{ block.settings.subheading_size }}px * 1.1); {% endcomment %}
    }
  }

  .ai-health-assessment-card-{{ ai_gen_id }} {
    background-color: var(--card-bg-color);
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: 0 {{ block.settings.card_shadow_vertical }}px {{ block.settings.card_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity }});
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.card_content_gap }}px;
  }

  .ai-health-assessment-card-image-{{ ai_gen_id }} {
    width: 100%;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-health-assessment-card-image-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .ai-health-assessment-card-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 4 / 3;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-health-assessment-card-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-health-assessment-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-health-assessment-card-buttons-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.button_gap }}px;
  }

  .ai-health-assessment-button-{{ ai_gen_id }} {
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-weight: 500;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
    display: inline-block;
    border: 2px solid transparent;
  }

  .ai-health-assessment-button-filled-{{ ai_gen_id }} {
    background-color: var(--button-bg-color);
    color: var(--button-text-color);
    border-color: var(--button-bg-color);
  }

  .ai-health-assessment-button-filled-{{ ai_gen_id }}:hover {
    background-color: var(--button-hover-bg-color);
    border-color: var(--button-hover-bg-color);
    transform: translateY(-2px);
  }

  .ai-health-assessment-button-outlined-{{ ai_gen_id }} {
    background-color: transparent;
    color: var(--button-outline-text-color);
    border-color: var(--button-outline-border-color);
  }

  .ai-health-assessment-button-outlined-{{ ai_gen_id }}:hover {
    background-color: var(--button-outline-hover-bg-color);
    color: var(--button-outline-hover-text-color);
    border-color: var(--button-outline-hover-border-color);
    transform: translateY(-2px);
  }
{% endstyle %}

<health-assessment-{{ ai_gen_id }} class="ai-health-assessment-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-health-assessment-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-health-assessment-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h1 class="ai-health-assessment-heading-{{ ai_gen_id }}">
            {{ block.settings.heading }}
          </h1>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <p class="ai-health-assessment-subheading-{{ ai_gen_id }}">
            {{ block.settings.subheading }}
          </p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-health-assessment-cards-{{ ai_gen_id }}">
      <div
        class="ai-health-assessment-card-{{ ai_gen_id }}"
        style="--card-bg-color: {{ block.settings.card_1_bg_color }};"
      >
        <div class="ai-health-assessment-card-image-{{ ai_gen_id }}">
          {% if block.settings.card_1_image %}
            <img
              src="{{ block.settings.card_1_image | image_url: width: 800 }}"
              alt="{{ block.settings.card_1_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.card_1_image.width }}"
              height="{{ block.settings.card_1_image.height }}"
            >
          {% else %}
            <div class="ai-health-assessment-card-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
              <div class="ai-health-assessment-empty-state-{{ ai_gen_id }}">
                Add an image for card 1
              </div>
            </div>
          {% endif %}
        </div>

        <div class="ai-health-assessment-card-buttons-{{ ai_gen_id }}">
          {% if block.settings.card_1_button_1_text != blank %}
            <a
              href="{{ block.settings.card_1_button_1_link }}"
              class="ai-health-assessment-button-{{ ai_gen_id }} ai-health-assessment-button-filled-{{ ai_gen_id }}"
              style="
                --button-bg-color: {{ block.settings.card_1_button_1_bg_color }};
                --button-text-color: {{ block.settings.card_1_button_1_text_color }};
                --button-hover-bg-color: {{ block.settings.card_1_button_1_hover_bg_color }};
              "
            >
              {{ block.settings.card_1_button_1_text }}
            </a>
          {% endif %}

          {% if block.settings.card_1_button_2_text != blank %}
            <a
              href="{{ block.settings.card_1_button_2_link }}"
              class="ai-health-assessment-button-{{ ai_gen_id }} ai-health-assessment-button-outlined-{{ ai_gen_id }}"
              style="
                --button-outline-text-color: {{ block.settings.card_1_button_2_text_color }};
                --button-outline-border-color: {{ block.settings.card_1_button_2_border_color }};
                --button-outline-hover-bg-color: {{ block.settings.card_1_button_2_hover_bg_color }};
                --button-outline-hover-text-color: {{ block.settings.card_1_button_2_hover_text_color }};
                --button-outline-hover-border-color: {{ block.settings.card_1_button_2_hover_border_color }};
              "
            >
              {{ block.settings.card_1_button_2_text }}
            </a>
          {% endif %}
        </div>
      </div>

      <div
        class="ai-health-assessment-card-{{ ai_gen_id }}"
        style="--card-bg-color: {{ block.settings.card_2_bg_color }};"
      >
        <div class="ai-health-assessment-card-image-{{ ai_gen_id }}">
          {% if block.settings.card_2_image %}
            <img
              src="{{ block.settings.card_2_image | image_url: width: 800 }}"
              alt="{{ block.settings.card_2_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.card_2_image.width }}"
              height="{{ block.settings.card_2_image.height }}"
            >
          {% else %}
            <div class="ai-health-assessment-card-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
              <div class="ai-health-assessment-empty-state-{{ ai_gen_id }}">
                Add an image for card 2
              </div>
            </div>
          {% endif %}
        </div>

        <div class="ai-health-assessment-card-buttons-{{ ai_gen_id }}">
          {% if block.settings.card_2_button_1_text != blank %}
            <a
              href="{{ block.settings.card_2_button_1_link }}"
              class="ai-health-assessment-button-{{ ai_gen_id }} ai-health-assessment-button-filled-{{ ai_gen_id }}"
              style="
                --button-bg-color: {{ block.settings.card_2_button_1_bg_color }};
                --button-text-color: {{ block.settings.card_2_button_1_text_color }};
                --button-hover-bg-color: {{ block.settings.card_2_button_1_hover_bg_color }};
              "
            >
              {{ block.settings.card_2_button_1_text }}
            </a>
          {% endif %}

          {% if block.settings.card_2_button_2_text != blank %}
            <a
              href="{{ block.settings.card_2_button_2_link }}"
              class="ai-health-assessment-button-{{ ai_gen_id }} ai-health-assessment-button-outlined-{{ ai_gen_id }}"
              style="
                --button-outline-text-color: {{ block.settings.card_2_button_2_text_color }};
                --button-outline-border-color: {{ block.settings.card_2_button_2_border_color }};
                --button-outline-hover-bg-color: {{ block.settings.card_2_button_2_hover_bg_color }};
                --button-outline-hover-text-color: {{ block.settings.card_2_button_2_hover_text_color }};
                --button-outline-hover-border-color: {{ block.settings.card_2_button_2_hover_border_color }};
              "
            >
              {{ block.settings.card_2_button_2_text }}
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</health-assessment-{{ ai_gen_id }}>

<script>
  (function() {
    class HealthAssessment{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupAccessibility();
      }

      setupAccessibility() {
        const buttons = this.querySelectorAll('.ai-health-assessment-button-{{ ai_gen_id }}');
        buttons.forEach(button => {
          if (!button.getAttribute('href') || button.getAttribute('href') === '') {
            button.setAttribute('role', 'button');
            button.setAttribute('tabindex', '0');
          }
        });
      }
    }

    customElements.define('health-assessment-{{ ai_gen_id }}', HealthAssessment{{ ai_gen_id }});
  })();
</script>

