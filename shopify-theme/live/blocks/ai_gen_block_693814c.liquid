{% doc %}
  @prompt
    Create a flexible A+ content section that reads from product metafields (custom.a_content_block) and dynamically renders different layout types. The section should:
    
    1. Loop through metafield entries sorted by order field
    2. Support three layout types based on layout_type field:
       - "full_width": Single full-width image with optional text overlay
       - "three_column": Three benefit cards in a grid with images, headings, and descriptions
       - "two_column": Two-column grid layout
    
    3. Image sizing and responsiveness:
       - Desktop (large screens): Images centered with auto left/right margins, max-width container
       - Laptop/tablet: Images take full width and maintain aspect ratio
       - Mobile: Images resize smoothly to cover full width while maintaining aspect ratio
       - Height: Automatic based on image aspect ratio, with optional manual height override setting
    
    4. Full-width blocks should include:
       - Image from metafield image_1
       - Optional heading and description overlay with customizable position
       - Text overlay with semi-transparent background option
    
    5. Three-column grid blocks should:
       - Display image_1, image_2, image_3 side-by-side on desktop
       - Show 2 columns on tablet
       - Stack vertically on mobile
       - Support headings and rich text descriptions from metafield
       - Equal height cards with proper spacing
    
    6. Two-column blocks similar to three-column but with 2 images
    
    7. Section settings for:
       - Container max-width for large screens
       - Spacing between blocks
       - Default background and text colors
       - Typography options
    
    8. Block-level settings override for:
       - Custom height (optional, defaults to auto)
       - Background color
       - Text color and alignment
       - Padding and margins
    
    The design should be premium wellness brand aesthetic with clean spacing, smooth responsive transitions, and professional typography. Images should always maintain quality and proper aspect ratios across all devices., what i want if there is no data then dont show anything right now you are rendering the paragraph , and also if it is having some data then in this edit theme it should be appeared and fetched the actual data . 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% liquid
  assign a_content = product.metafields.custom.a_content_block.value
  assign sorted_blocks = a_content | sort: 'order'
%}

{% if sorted_blocks.size > 0 %}
  {% style %}
    .ai-aplus-content-{{ ai_gen_id }} {
      display: block;
      width: 100%;
    }

    .ai-aplus-container-{{ ai_gen_id }} {
      max-width: {{ block.settings.container_max_width }}px;
      margin: 0 auto;
      padding: 0 {{ block.settings.container_padding }}px;
    }

    .ai-aplus-block-{{ ai_gen_id }} {
      margin-bottom: {{ block.settings.block_spacing }}px;
    }

    .ai-aplus-block-{{ ai_gen_id }}:last-child {
      margin-bottom: 0;
    }

    .ai-aplus-full-width-{{ ai_gen_id }} {
      position: relative;
      width: 100%;
      overflow: hidden;
      border-radius: {{ block.settings.image_border_radius }}px;
    }

    .ai-aplus-full-width-image-{{ ai_gen_id }} {
      width: 100%;
      height: auto;
      display: block;
      object-fit: cover;
    }

    .ai-aplus-full-width-image-{{ ai_gen_id }}.has-custom-height {
      height: var(--ai-custom-height);
    }

    .ai-aplus-overlay-{{ ai_gen_id }} {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      display: flex;
      align-items: var(--ai-overlay-align);
      justify-content: var(--ai-overlay-justify);
      padding: {{ block.settings.overlay_padding }}px;
    }

    .ai-aplus-overlay-content-{{ ai_gen_id }} {
      background-color: var(--ai-overlay-bg);
      padding: {{ block.settings.overlay_content_padding }}px;
      border-radius: {{ block.settings.overlay_border_radius }}px;
      max-width: {{ block.settings.overlay_max_width }}%;
      text-align: var(--ai-text-align);
    }

    .ai-aplus-overlay-heading-{{ ai_gen_id }} {
      color: var(--ai-text-color);
      font-size: {{ block.settings.overlay_heading_size }}px;
      font-weight: 600;
      margin: 0 0 12px 0;
      line-height: 1.2;
    }

    .ai-aplus-overlay-description-{{ ai_gen_id }} {
      color: var(--ai-text-color);
      font-size: {{ block.settings.overlay_text_size }}px;
      line-height: 1.6;
      margin: 0;
    }

    .ai-aplus-grid-{{ ai_gen_id }} {
      display: grid;
      gap: {{ block.settings.grid_gap }}px;
      grid-template-columns: repeat(var(--ai-grid-columns), 1fr);
    }

    .ai-aplus-card-{{ ai_gen_id }} {
      background-color: var(--ai-card-bg);
      border-radius: {{ block.settings.card_border_radius }}px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      height: 100%;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .ai-aplus-card-{{ ai_gen_id }}:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 16px rgba(0, 0, 0, 0.12);
    }

    .ai-aplus-card-image-{{ ai_gen_id }} {
      width: 100%;
      height: auto;
      display: block;
      object-fit: cover;
    }

    .ai-aplus-card-content-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding }}px;
      flex-grow: 1;
      display: flex;
      flex-direction: column;
    }

    .ai-aplus-card-heading-{{ ai_gen_id }} {
      color: var(--ai-card-text-color);
      font-size: {{ block.settings.card_heading_size }}px;
      font-weight: 600;
      margin: 0 0 12px 0;
      line-height: 1.3;
    }

    .ai-aplus-card-description-{{ ai_gen_id }} {
      color: var(--ai-card-text-color);
      font-size: {{ block.settings.card_text_size }}px;
      line-height: 1.6;
      margin: 0;
      flex-grow: 1;
    }

    .ai-aplus-card-description-{{ ai_gen_id }} p {
      margin: 0 0 12px 0;
    }

    .ai-aplus-card-description-{{ ai_gen_id }} p:last-child {
      margin-bottom: 0;
    }

    @media screen and (max-width: 989px) {
      .ai-aplus-grid-{{ ai_gen_id }} {
        grid-template-columns: repeat(2, 1fr);
      }

      .ai-aplus-overlay-heading-{{ ai_gen_id }} {
        font-size: calc({{ block.settings.overlay_heading_size }}px * 0.85);
      }

      .ai-aplus-overlay-description-{{ ai_gen_id }} {
        font-size: calc({{ block.settings.overlay_text_size }}px * 0.9);
      }

      .ai-aplus-card-heading-{{ ai_gen_id }} {
        font-size: calc({{ block.settings.card_heading_size }}px * 0.9);
      }
    }

    @media screen and (max-width: 749px) {
      .ai-aplus-container-{{ ai_gen_id }} {
        padding: 0 {{ block.settings.container_padding | times: 0.75 }}px;
      }

      .ai-aplus-grid-{{ ai_gen_id }} {
        grid-template-columns: 1fr;
        gap: {{ block.settings.grid_gap | times: 0.75 }}px;
      }

      .ai-aplus-overlay-{{ ai_gen_id }} {
        padding: {{ block.settings.overlay_padding | times: 0.75 }}px;
      }

      .ai-aplus-overlay-content-{{ ai_gen_id }} {
        padding: {{ block.settings.overlay_content_padding | times: 0.75 }}px;
        max-width: 100%;
      }

      .ai-aplus-overlay-heading-{{ ai_gen_id }} {
        font-size: calc({{ block.settings.overlay_heading_size }}px * 0.75);
      }

      .ai-aplus-overlay-description-{{ ai_gen_id }} {
        font-size: calc({{ block.settings.overlay_text_size }}px * 0.85);
      }

      .ai-aplus-card-content-{{ ai_gen_id }} {
        padding: {{ block.settings.card_padding | times: 0.75 }}px;
      }

      .ai-aplus-card-heading-{{ ai_gen_id }} {
        font-size: calc({{ block.settings.card_heading_size }}px * 0.8);
      }

      .ai-aplus-card-description-{{ ai_gen_id }} {
        font-size: calc({{ block.settings.card_text_size }}px * 0.9);
      }
    }
  {% endstyle %}

  <a-plus-content-{{ ai_gen_id }} class="ai-aplus-content-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    <div class="ai-aplus-container-{{ ai_gen_id }}">
      {% for content_block in sorted_blocks %}
        {% liquid
          assign layout_type = content_block.layout_type
          assign custom_height = content_block.custom_height
          assign bg_color = content_block.background_color | default: block.settings.default_bg_color
          assign text_color = content_block.text_color | default: block.settings.default_text_color
          assign text_align = content_block.text_alignment | default: 'center'
          assign overlay_position = content_block.overlay_position | default: 'center'
        %}

        <div class="ai-aplus-block-{{ ai_gen_id }}">
          {% if layout_type == 'full_width' %}
            {% liquid
              case overlay_position
                when 'top_left'
                  assign align_items = 'flex-start'
                  assign justify_content = 'flex-start'
                when 'top_center'
                  assign align_items = 'flex-start'
                  assign justify_content = 'center'
                when 'top_right'
                  assign align_items = 'flex-start'
                  assign justify_content = 'flex-end'
                when 'center_left'
                  assign align_items = 'center'
                  assign justify_content = 'flex-start'
                when 'center'
                  assign align_items = 'center'
                  assign justify_content = 'center'
                when 'center_right'
                  assign align_items = 'center'
                  assign justify_content = 'flex-end'
                when 'bottom_left'
                  assign align_items = 'flex-end'
                  assign justify_content = 'flex-start'
                when 'bottom_center'
                  assign align_items = 'flex-end'
                  assign justify_content = 'center'
                when 'bottom_right'
                  assign align_items = 'flex-end'
                  assign justify_content = 'flex-end'
                else
                  assign align_items = 'center'
                  assign justify_content = 'center'
              endcase

              assign overlay_bg_opacity = block.settings.overlay_bg_opacity | divided_by: 100.0
              assign overlay_bg_with_opacity = bg_color | color_modify: 'alpha', overlay_bg_opacity
            %}

            <div class="ai-aplus-full-width-{{ ai_gen_id }}">
              {% if content_block.image_1 %}
                <img
                  src="{{ content_block.image_1 | image_url: width: 2000 }}"
                  alt="{{ content_block.heading | default: product.title | escape }}"
                  loading="lazy"
                  width="{{ content_block.image_1.width }}"
                  height="{{ content_block.image_1.height }}"
                  class="ai-aplus-full-width-image-{{ ai_gen_id }} {% if custom_height %}has-custom-height{% endif %}"
                  {% if custom_height %}
                    style="--ai-custom-height: {{ custom_height }}px;"
                  {% endif %}
                >
              {% endif %}

              {% if content_block.heading or content_block.description %}
                <div
                  class="ai-aplus-overlay-{{ ai_gen_id }}"
                  style="
                    --ai-overlay-align: {{ align_items }};
                    --ai-overlay-justify: {{ justify_content }};
                  "
                >
                  <div
                    class="ai-aplus-overlay-content-{{ ai_gen_id }}"
                    style="
                      --ai-overlay-bg: {{ overlay_bg_with_opacity }};
                      --ai-text-color: {{ text_color }};
                      --ai-text-align: {{ text_align }};
                    "
                  >
                    {% if content_block.heading %}
                      <h2 class="ai-aplus-overlay-heading-{{ ai_gen_id }}">{{ content_block.heading }}</h2>
                    {% endif %}
                    {% if content_block.description %}
                      <div class="ai-aplus-overlay-description-{{ ai_gen_id }}">{{ content_block.description }}</div>
                    {% endif %}
                  </div>
                </div>
              {% endif %}
            </div>

          {% elsif layout_type == 'three_column' %}
            <div
              class="ai-aplus-grid-{{ ai_gen_id }}"
              style="--ai-grid-columns: 3;"
            >
              {% for i in (1..3) %}
                {% liquid
                  assign image_key = 'image_' | append: i
                  assign heading_key = 'heading_' | append: i
                  assign description_key = 'description_' | append: i
                  assign card_image = content_block[image_key]
                  assign card_heading = content_block[heading_key]
                  assign card_description = content_block[description_key]
                %}

                {% if card_image or card_heading or card_description %}
                  <div
                    class="ai-aplus-card-{{ ai_gen_id }}"
                    style="
                      --ai-card-bg: {{ bg_color }};
                      --ai-card-text-color: {{ text_color }};
                    "
                  >
                    {% if card_image %}
                      <img
                        src="{{ card_image | image_url: width: 800 }}"
                        alt="{{ card_heading | default: product.title | escape }}"
                        loading="lazy"
                        width="{{ card_image.width }}"
                        height="{{ card_image.height }}"
                        class="ai-aplus-card-image-{{ ai_gen_id }}"
                      >
                    {% endif %}

                    {% if card_heading or card_description %}
                      <div class="ai-aplus-card-content-{{ ai_gen_id }}">
                        {% if card_heading %}
                          <h3 class="ai-aplus-card-heading-{{ ai_gen_id }}">{{ card_heading }}</h3>
                        {% endif %}
                        {% if card_description %}
                          <div class="ai-aplus-card-description-{{ ai_gen_id }}">{{ card_description }}</div>
                        {% endif %}
                      </div>
                    {% endif %}
                  </div>
                {% endif %}
              {% endfor %}
            </div>

          {% elsif layout_type == 'two_column' %}
            <div
              class="ai-aplus-grid-{{ ai_gen_id }}"
              style="--ai-grid-columns: 2;"
            >
              {% for i in (1..2) %}
                {% liquid
                  assign image_key = 'image_' | append: i
                  assign heading_key = 'heading_' | append: i
                  assign description_key = 'description_' | append: i
                  assign card_image = content_block[image_key]
                  assign card_heading = content_block[heading_key]
                  assign card_description = content_block[description_key]
                %}

                {% if card_image or card_heading or card_description %}
                  <div
                    class="ai-aplus-card-{{ ai_gen_id }}"
                    style="
                      --ai-card-bg: {{ bg_color }};
                      --ai-card-text-color: {{ text_color }};
                    "
                  >
                    {% if card_image %}
                      <img
                        src="{{ card_image | image_url: width: 1000 }}"
                        alt="{{ card_heading | default: product.title | escape }}"
                        loading="lazy"
                        width="{{ card_image.width }}"
                        height="{{ card_image.height }}"
                        class="ai-aplus-card-image-{{ ai_gen_id }}"
                      >
                    {% endif %}

                    {% if card_heading or card_description %}
                      <div class="ai-aplus-card-content-{{ ai_gen_id }}">
                        {% if card_heading %}
                          <h3 class="ai-aplus-card-heading-{{ ai_gen_id }}">{{ card_heading }}</h3>
                        {% endif %}
                        {% if card_description %}
                          <div class="ai-aplus-card-description-{{ ai_gen_id }}">{{ card_description }}</div>
                        {% endif %}
                      </div>
                    {% endif %}
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </a-plus-content-{{ ai_gen_id }}>

  <script>
    (function() {
      class APlusContent{{ ai_gen_id }} extends HTMLElement {
        constructor() {
          super();
        }

        connectedCallback() {
          this.style.display = 'block';
        }
      }

      customElements.define('a-plus-content-{{ ai_gen_id }}', APlusContent{{ ai_gen_id }});
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "A+ content",
  "settings": [
    {
      "type": "header",
      "content": "Container"
    },
    {
      "type": "range",
      "id": "container_max_width",
      "label": "Max width",
      "min": 1000,
      "max": 1600,
      "step": 100,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "range",
      "id": "container_padding",
      "label": "Side padding",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "block_spacing",
      "label": "Spacing between blocks",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "header",
      "content": "Default colors"
    },
    {
      "type": "color",
      "id": "default_bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "default_text_color",
      "label": "Text",
      "default": "#262626"
    },
    {
      "type": "header",
      "content": "Full-width layout"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "overlay_padding",
      "label": "Overlay padding",
      "min": 20,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "overlay_content_padding",
      "label": "Overlay content padding",
      "min": 16,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "overlay_border_radius",
      "label": "Overlay border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "overlay_max_width",
      "label": "Overlay max width",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "overlay_bg_opacity",
      "label": "Overlay background opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 85
    },
    {
      "type": "range",
      "id": "overlay_heading_size",
      "label": "Overlay heading size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "overlay_text_size",
      "label": "Overlay text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Grid layouts"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Gap between cards",
      "min": 12,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card content padding",
      "min": 16,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_heading_size",
      "label": "Card heading size",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "card_text_size",
      "label": "Card text size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "A+ content"
    }
  ]
}
{% endschema %}
