<script>
  (function() {
    class CommitmentSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.cardsContainer = this.querySelector('.ai-commitment-cards-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-commitment-nav-button-{{ ai_gen_id }}.prev');
        this.nextButton = this.querySelector('.ai-commitment-nav-button-{{ ai_gen_id }}.next');
        
        this.setupNavigation();
        this.updateNavigationVisibility();
        
        window.addEventListener('resize', () => this.updateNavigationVisibility());
        this.cardsContainer.addEventListener('scroll', () => this.updateNavigationVisibility());
      }

      setupNavigation() {
        if (!this.cardsContainer || !this.prevButton || !this.nextButton) return;

        this.prevButton.addEventListener('click', () => {
          const scrollAmount = this.cardsContainer.offsetWidth * 0.8;
          this.cardsContainer.scrollBy({
            left: -scrollAmount,
            behavior: 'smooth'
          });
        });

        this.nextButton.addEventListener('click', () => {
          const scrollAmount = this.cardsContainer.offsetWidth * 0.8;
          this.cardsContainer.scrollBy({
            left: scrollAmount,
            behavior: 'smooth'
          });
        });
      }

      updateNavigationVisibility() {
        if (!this.cardsContainer) return;

        const isScrollable = this.cardsContainer.scrollWidth > this.cardsContainer.clientWidth;
        const scrollLeft = this.cardsContainer.scrollLeft;
        const maxScroll = this.cardsContainer.scrollWidth - this.cardsContainer.clientWidth;

        if (isScrollable) {
          if (scrollLeft > 10) {
            this.prevButton.classList.add('visible');
          } else {
            this.prevButton.classList.remove('visible');
          }

          if (scrollLeft < maxScroll - 10) {
            this.nextButton.classList.add('visible');
          } else {
            this.nextButton.classList.remove('visible');
          }
        } else {
          this.prevButton.classList.remove('visible');
          this.nextButton.classList.remove('visible');
        }
      }
    }

    customElements.define('commitment-section-{{ ai_gen_id }}', CommitmentSection{{ ai_gen_id }});
  })();
</script>

