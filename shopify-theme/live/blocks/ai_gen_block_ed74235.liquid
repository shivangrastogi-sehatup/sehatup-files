{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-cta-banner-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding-bottom: {{ block.settings.section_padding_bottom }}px;
    background: white;
  }

  .ai-cta-banner-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: {{ block.settings.section_padding_vertical }}px {{ block.settings.section_padding_horizontal }}px;
    background-color: {{ block.settings.background_color }};
    {% if block.settings.background_gradient != blank %}
      background: {{ block.settings.background_gradient }};
    {% endif %}
    {% if block.settings.enable_border %}
      border: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
    {% endif %}
    border-radius: {{ block.settings.border_radius }}px;
    {% if block.settings.enable_shadow %}
      box-shadow: {{ block.settings.shadow_horizontal }}px {{ block.settings.shadow_vertical }}px {{ block.settings.shadow_blur }}px rgba(0, 0, 0, {{ block.settings.shadow_opacity | divided_by: 100.0 }});
    {% endif %}
    display: flex;
    align-items: {{ block.settings.vertical_alignment }};
    justify-content: {{ block.settings.content_alignment }};
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-cta-banner-text-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.text_line_gap }}px;
  }

  .ai-cta-banner-text-line-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: clamp(10px, 1vw, 20px);
    font-weight: {{ block.settings.text_weight }};
    line-height: {{ block.settings.line_height }};
    margin: 0;
  }

  .ai-cta-banner-button-wrapper-{{ ai_gen_id }} {
    flex-shrink: 0;
  }

  .ai-cta-banner-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: {{ block.settings.button_icon_gap }}px;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-weight: {{ block.settings.button_text_weight }};
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.3s ease, color 0.3s ease, transform 0.2s ease;
    white-space: nowrap;
  }

  .ai-cta-banner-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    {% if block.settings.button_hover_lift %}
      transform: translateY(-2px);
    {% endif %}
  }

  .ai-cta-banner-arrow-{{ ai_gen_id }} {
    width: {{ block.settings.arrow_size }}px;
    height: {{ block.settings.arrow_size }}px;
    display: inline-block;
    transition: transform 0.3s ease;
  }

  .ai-cta-banner-button-{{ ai_gen_id }}:hover .ai-cta-banner-arrow-{{ ai_gen_id }} {
    transform: translateX(4px);
  }

  .ai-cta-banner-custom-liquid-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  @media screen and (max-width: 749px) {
    .ai-cta-banner-{{ ai_gen_id }} {
      padding-bottom: {{ block.settings.mobile_section_padding_bottom }}px;
    }

    .ai-cta-banner-container-{{ ai_gen_id }} {
      flex-direction: {{ block.settings.mobile_stack_direction }};
      text-align: {{ block.settings.mobile_text_alignment }};
      gap: {{ block.settings.mobile_content_gap }}px;
      padding: {{ block.settings.mobile_padding_vertical }}px {{ block.settings.mobile_padding_horizontal }}px;
    }

    .ai-cta-banner-text-{{ ai_gen_id }} {
      {% if block.settings.mobile_stack_direction == 'column' %}
        align-items: {{ block.settings.mobile_text_alignment }};
      {% endif %}
    }

    .ai-cta-banner-text-line-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_text_size }}px;
    }

    .ai-cta-banner-button-wrapper-{{ ai_gen_id }} {
      {% if block.settings.mobile_button_width == 'full' %}
        width: 100%;
      {% endif %}
    }

    .ai-cta-banner-button-{{ ai_gen_id }} {
      {% if block.settings.mobile_button_width == 'full' %}
        width: 100%;
        justify-content: center;
      {% endif %}
      font-size: {{ block.settings.mobile_button_text_size }}px;
      padding: {{ block.settings.mobile_button_padding_vertical }}px {{ block.settings.mobile_button_padding_horizontal }}px;
    }
  }
{% endstyle %}

<cta-banner-{{ ai_gen_id }} class="ai-cta-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-cta-banner-container-{{ ai_gen_id }}">
    <div class="ai-cta-banner-text-{{ ai_gen_id }}">
      {% if block.settings.text_line_1 != blank %}
        <p class="ai-cta-banner-text-line-{{ ai_gen_id }}">{{ block.settings.text_line_1 }}</p>
      {% endif %}
      {% if block.settings.text_line_2 != blank %}
        <p class="ai-cta-banner-text-line-{{ ai_gen_id }}">{{ block.settings.text_line_2 }}</p>
      {% endif %}
    </div>
    <div class="ai-cta-banner-button-wrapper-{{ ai_gen_id }}">
      <a href="{{ block.settings.button_link }}" class="ai-cta-banner-button-{{ ai_gen_id }}">
        {% if block.settings.show_arrow and block.settings.arrow_position == 'before' %}
          <span class="ai-cta-banner-arrow-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </span>
        {% endif %}
        <span>{{ block.settings.button_text }}</span>
        {% if block.settings.show_arrow and block.settings.arrow_position == 'after' %}
          <span class="ai-cta-banner-arrow-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </span>
        {% endif %}
      </a>
    </div>
  </div>
  
  {% if block.settings.custom_liquid != blank %}
    <div class="ai-cta-banner-custom-liquid-{{ ai_gen_id }}">
      {{ block.settings.custom_liquid }}
    </div>
  {% endif %}
</cta-banner-{{ ai_gen_id }}>

<script>
  (function() {
    class CtaBanner{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.button = this.querySelector('.ai-cta-banner-button-{{ ai_gen_id }}');
        if (this.button) {
          this.button.addEventListener('click', this.handleClick.bind(this));
        }
      }

      handleClick(event) {
        if (!this.button.getAttribute('href') || this.button.getAttribute('href') === '#') {
          event.preventDefault();
        }
      }

      disconnectedCallback() {
        if (this.button) {
          this.button.removeEventListener('click', this.handleClick);
        }
      }
    }

    customElements.define('cta-banner-{{ ai_gen_id }}', CtaBanner{{ ai_gen_id }});
  })();
</script>

