{% doc %}
  @prompt
    Create a highly flexible responsive healthcare hero banner section with multiple layout modes and extensive customization.    Layout variations:1. Full-width background image with overlay content (left-aligned)2. Split layout with white/light background on left, image on right3. Background image with optional foreground doctor/person image overlaySection structure:- Background image with position controls (X/Y axis movement)- Optional white/light overlay panel on left side- Content area with:  * Main heading (e.g., "Struggling with stress, hormones, weight or sexual health?")  * Subheading with color accent support (e.g., "Find the real cause in 60 seconds" - with "60 seconds" in red/pink)  * Body text/description  * Flexible button group: 1 or 2 buttons  * Button 1: Primary style (filled background)  * Button 2: Secondary style (outline/ghost)- Optional foreground image (doctor/person) with resize and position controlsRequirements:- Fully responsive layout with intelligent scaling:  * Desktop: full-width hero, content positioned left/center, optional foreground image on right  * Tablet: adjusted spacing, maintained layout structure  * Mobile: stacked content, full-width, background repositioned, foreground image hidden or repositioned  * Adaptive scaling: When viewport width increases and extra space is available, automatically scale up text sizes, button dimensions, and image sizes proportionally to fill the space elegantly without leaving excessive whitespace  * Fluid typography: Use clamp() or viewport-based units (vw, vh) to smoothly scale heading, subheading, and body text between minimum and maximum sizes  * Responsive buttons: Scale button padding, font size, and dimensions based on available space  * Dynamic image sizing: Foreground and background images should scale proportionally with viewport, with controls for min/max sizes- Extensive settings for layout modes, images, typography, colors, buttons, spacing, and scaling controls- Support for gradient overlays, parallax effects, and scroll animations- Full accessibility with proper contrast and alt text
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-healthcare-hero-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    min-height: clamp(400px, 60vh, 800px);
    overflow: hidden;
  }

  .ai-healthcare-hero__background-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .ai-healthcare-hero__background-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ block.settings.bg_position_x }}% {{ block.settings.bg_position_y }}%;
  }

  .ai-healthcare-hero__background-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-healthcare-hero__background-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 600px;
    max-height: 600px;
  }

  .ai-healthcare-hero__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: {{ block.settings.overlay_gradient }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 2;
  }

  .ai-healthcare-hero__container-{{ ai_gen_id }} {
    position: relative;
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: clamp(40px, 8vw, {{ block.settings.section_padding_top }}px) clamp(20px, 4vw, {{ block.settings.section_padding_horizontal }}px) clamp(40px, 8vw, {{ block.settings.section_padding_bottom }}px);
    z-index: 3;
    display: flex;
    align-items: {{ block.settings.content_vertical_align }};
    min-height: clamp(400px, 60vh, 800px);
  }

  .ai-healthcare-hero__layout-{{ ai_gen_id }} {
    display: flex;
    width: 100%;
    gap: clamp(30px, 5vw, 60px);
    align-items: center;
    {% if block.settings.layout_mode == 'split' %}
      flex-direction: row;
    {% elsif block.settings.layout_mode == 'full_width' %}
      flex-direction: row;
    {% else %}
      flex-direction: row;
    {% endif %}
  }

  .ai-healthcare-hero__content-panel-{{ ai_gen_id }} {
    {% if block.settings.layout_mode == 'split' %}
      background-color: {{ block.settings.panel_bg_color }};
      padding: clamp(30px, 5vw, {{ block.settings.panel_padding }}px);
      border-radius: {{ block.settings.panel_border_radius }}px;
      box-shadow: 0 {{ block.settings.panel_shadow_y }}px {{ block.settings.panel_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.panel_shadow_opacity | divided_by: 100.0 }});
      flex: 0 0 {{ block.settings.content_width }}%;
      max-width: {{ block.settings.content_width }}%;
    {% elsif block.settings.layout_mode == 'full_width' %}
      flex: 0 0 {{ block.settings.content_width }}%;
      max-width: {{ block.settings.content_width }}%;
    {% else %}
      flex: 0 0 {{ block.settings.content_width }}%;
      max-width: {{ block.settings.content_width }}%;
    {% endif %}
  }

  .ai-healthcare-hero__heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: clamp({{ block.settings.heading_size_mobile }}px, {{ block.settings.heading_size_mobile | plus: block.settings.heading_size_desktop | divided_by: 2.0 | times: 0.05 }}vw, {{ block.settings.heading_size_desktop }}px);
    line-height: {{ block.settings.heading_line_height }};
    color: {{ block.settings.heading_color }};
    margin: 0 0 clamp(12px, 2vw, {{ block.settings.heading_spacing }}px) 0;
    text-align: {{ block.settings.text_align }};
  }

  .ai-healthcare-hero__subheading-{{ ai_gen_id }} {
    font-family: {{ block.settings.subheading_font.family }}, {{ block.settings.subheading_font.fallback_families }};
    font-weight: {{ block.settings.subheading_font.weight }};
    font-size: clamp({{ block.settings.subheading_size_mobile }}px, {{ block.settings.subheading_size_mobile | plus: block.settings.subheading_size_desktop | divided_by: 2.0 | times: 0.04 }}vw, {{ block.settings.subheading_size_desktop }}px);
    line-height: {{ block.settings.subheading_line_height }};
    color: {{ block.settings.subheading_color }};
    margin: 0 0 clamp(16px, 2.5vw, {{ block.settings.subheading_spacing }}px) 0;
    text-align: {{ block.settings.text_align }};
  }

  .ai-healthcare-hero__subheading-accent-{{ ai_gen_id }} {
    color: {{ block.settings.accent_color }};
  }

  .ai-healthcare-hero__body-{{ ai_gen_id }} {
    font-size: clamp({{ block.settings.body_size_mobile }}px, {{ block.settings.body_size_mobile | plus: block.settings.body_size_desktop | divided_by: 2.0 | times: 0.03 }}vw, {{ block.settings.body_size_desktop }}px);
    line-height: {{ block.settings.body_line_height }};
    color: {{ block.settings.body_color }};
    margin: 0 0 clamp(20px, 3vw, {{ block.settings.body_spacing }}px) 0;
    text-align: {{ block.settings.text_align }};
  }

  .ai-healthcare-hero__buttons-{{ ai_gen_id }} {
    display: flex;
    gap: clamp(12px, 2vw, {{ block.settings.button_gap }}px);
    {% if block.settings.text_align == 'center' %}
      justify-content: center;
    {% elsif block.settings.text_align == 'right' %}
      justify-content: flex-end;
    {% else %}
      justify-content: flex-start;
    {% endif %}
    flex-wrap: wrap;
  }

  .ai-healthcare-hero__button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: clamp({{ block.settings.button_padding_mobile }}px, 1.5vw, {{ block.settings.button_padding_desktop }}px) clamp({{ block.settings.button_padding_mobile | times: 2 }}px, 3vw, {{ block.settings.button_padding_desktop | times: 2 }}px);
    font-size: clamp({{ block.settings.button_text_size_mobile }}px, 1.2vw, {{ block.settings.button_text_size_desktop }}px);
    font-weight: {{ block.settings.button_font_weight }};
    border-radius: {{ block.settings.button_border_radius }}px;
    text-decoration: none;
    transition: all 0.3s ease;
    cursor: pointer;
    border: {{ block.settings.button_border_width }}px solid;
  }

  .ai-healthcare-hero__button--primary-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_primary_bg }};
    color: {{ block.settings.button_primary_text_color }};
    border-color: {{ block.settings.button_primary_bg }};
  }

  .ai-healthcare-hero__button--primary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_primary_hover_bg }};
    border-color: {{ block.settings.button_primary_hover_bg }};
    color: {{ block.settings.button_primary_hover_text }};
  }

  .ai-healthcare-hero__button--secondary-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_secondary_bg }};
    color: {{ block.settings.button_secondary_text_color }};
    border-color: {{ block.settings.button_secondary_border }};
  }

  .ai-healthcare-hero__button--secondary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_secondary_hover_bg }};
    border-color: {{ block.settings.button_secondary_hover_border }};
    color: {{ block.settings.button_secondary_hover_text }};
  }

  .ai-healthcare-hero__foreground-image-{{ ai_gen_id }} {
    {% if block.settings.layout_mode == 'split' %}
      flex: 1;
      display: flex;
      align-items: {{ block.settings.foreground_vertical_align }};
      justify-content: {{ block.settings.foreground_horizontal_align }};
    {% else %}
      position: absolute;
      top: {{ block.settings.foreground_position_y }}%;
      right: {{ block.settings.foreground_position_x }}%;
      transform: translate({{ block.settings.foreground_position_x }}%, -{{ block.settings.foreground_position_y }}%);
      z-index: 4;
    {% endif %}
  }

  .ai-healthcare-hero__foreground-image-{{ ai_gen_id }} img {
    width: clamp({{ block.settings.foreground_size_mobile }}px, {{ block.settings.foreground_size_mobile | plus: block.settings.foreground_size_desktop | divided_by: 2.0 | times: 0.1 }}vw, {{ block.settings.foreground_size_desktop }}px);
    height: auto;
    object-fit: contain;
    border-radius: {{ block.settings.foreground_border_radius }}px;
  }

  @media screen and (max-width: 989px) {
    .ai-healthcare-hero__layout-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-healthcare-hero__content-panel-{{ ai_gen_id }} {
      flex: 1;
      max-width: 100%;
    }

    .ai-healthcare-hero__foreground-image-{{ ai_gen_id }} {
      {% if block.settings.hide_foreground_mobile %}
        display: none;
      {% else %}
        position: relative;
        top: auto;
        right: auto;
        transform: none;
        width: 100%;
        justify-content: center;
      {% endif %}
    }

    .ai-healthcare-hero__background-image-{{ ai_gen_id }} {
      object-position: {{ block.settings.bg_position_x_mobile }}% {{ block.settings.bg_position_y_mobile }}%;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-healthcare-hero__buttons-{{ ai_gen_id }} {
      flex-direction: column;
      width: 100%;
    }

    .ai-healthcare-hero__button-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<healthcare-hero-{{ ai_gen_id }} class="ai-healthcare-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-healthcare-hero__background-{{ ai_gen_id }}">
    {% if block.settings.background_image %}
      <img
        src="{{ block.settings.background_image | image_url: width: 2400 }}"
        alt="{{ block.settings.background_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.background_image.width }}"
        height="{{ block.settings.background_image.height }}"
        class="ai-healthcare-hero__background-image-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-healthcare-hero__background-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
    {% if block.settings.show_overlay %}
      <div class="ai-healthcare-hero__overlay-{{ ai_gen_id }}"></div>
    {% endif %}
  </div>

  <div class="ai-healthcare-hero__container-{{ ai_gen_id }}">
    <div class="ai-healthcare-hero__layout-{{ ai_gen_id }}">
      <div class="ai-healthcare-hero__content-panel-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h1 class="ai-healthcare-hero__heading-{{ ai_gen_id }}">
            {{ block.settings.heading }}
          </h1>
        {% endif %}

        {% if block.settings.subheading != blank %}
          <div class="ai-healthcare-hero__subheading-{{ ai_gen_id }}">
            {% if block.settings.accent_text != blank %}
              {% assign subheading_parts = block.settings.subheading | split: block.settings.accent_text %}
              {% if subheading_parts.size > 1 %}
                {{ subheading_parts[0] }}<span class="ai-healthcare-hero__subheading-accent-{{ ai_gen_id }}">{{ block.settings.accent_text }}</span>{{ subheading_parts[1] }}
              {% else %}
                {{ block.settings.subheading }}
              {% endif %}
            {% else %}
              {{ block.settings.subheading }}
            {% endif %}
          </div>
        {% endif %}

        {% if block.settings.body_text != blank %}
          <div class="ai-healthcare-hero__body-{{ ai_gen_id }}">
            {{ block.settings.body_text }}
          </div>
        {% endif %}

        {% if block.settings.show_buttons %}
          <div class="ai-healthcare-hero__buttons-{{ ai_gen_id }}">
            {% if block.settings.button_primary_label != blank %}
              <a
                href="{{ block.settings.button_primary_link }}"
                class="ai-healthcare-hero__button-{{ ai_gen_id }} ai-healthcare-hero__button--primary-{{ ai_gen_id }}"
              >
                {{ block.settings.button_primary_label }}
              </a>
            {% endif %}

            {% if block.settings.show_button_secondary and block.settings.button_secondary_label != blank %}
              <a
                href="{{ block.settings.button_secondary_link }}"
                class="ai-healthcare-hero__button-{{ ai_gen_id }} ai-healthcare-hero__button--secondary-{{ ai_gen_id }}"
              >
                {{ block.settings.button_secondary_label }}
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>

      {% if block.settings.show_foreground_image and block.settings.foreground_image %}
        <div class="ai-healthcare-hero__foreground-image-{{ ai_gen_id }}">
          <img
            src="{{ block.settings.foreground_image | image_url: width: 1200 }}"
            alt="{{ block.settings.foreground_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.foreground_image.width }}"
            height="{{ block.settings.foreground_image.height }}"
          >
        </div>
      {% endif %}
    </div>
  </div>
</healthcare-hero-{{ ai_gen_id }}>

<script>
(function() {
  class HealthcareHero{{ ai_gen_id }} extends HTMLElement {
    constructor() {
      super();
    }

    connectedCallback() {
      this.setupParallax();
      this.setupScrollAnimations();
    }

    setupParallax() {
      {% if block.settings.enable_parallax %}
        const background = this.querySelector('.ai-healthcare-hero__background-image-{{ ai_gen_id }}');
        if (!background) return;

        const handleScroll = () => {
          const scrolled = window.pageYOffset;
          const rate = scrolled * {{ block.settings.parallax_speed | divided_by: 100.0 }};
          background.style.transform = `translateY(${rate}px)`;
        };

        window.addEventListener('scroll', handleScroll, { passive: true });
      {% endif %}
    }

    setupScrollAnimations() {
      {% if block.settings.enable_scroll_animations %}
        const contentPanel = this.querySelector('.ai-healthcare-hero__content-panel-{{ ai_gen_id }}');
        const foregroundImage = this.querySelector('.ai-healthcare-hero__foreground-image-{{ ai_gen_id }}');

        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.style.opacity = '1';
              entry.target.style.transform = 'translateY(0)';
            }
          });
        }, { threshold: 0.1 });

        if (contentPanel) {
          contentPanel.style.opacity = '0';
          contentPanel.style.transform = 'translateY(30px)';
          contentPanel.style.transition = 'opacity 0.8s ease, transform 0.8s ease';
          observer.observe(contentPanel);
        }

        if (foregroundImage) {
          foregroundImage.style.opacity = '0';
          foregroundImage.style.transform = 'translateY(30px)';
          foregroundImage.style.transition = 'opacity 0.8s ease 0.2s, transform 0.8s ease 0.2s';
          observer.observe(foregroundImage);
        }
      {% endif %}
    }
  }

  customElements.define('healthcare-hero-{{ ai_gen_id }}', HealthcareHero{{ ai_gen_id }});
})();
</script>

