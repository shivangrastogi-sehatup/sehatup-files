{% doc %}
  @prompt
    create a navbar header 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-navbar-{{ ai_gen_id }} {
    display: block;
    position: {{ block.settings.position }};
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    box-shadow: {{ block.settings.shadow_vertical_offset }}px {{ block.settings.shadow_horizontal_offset }}px {{ block.settings.shadow_blur }}px rgba(0, 0, 0, {{ block.settings.shadow_opacity | divided_by: 100.0 }});
    z-index: 1000;
    transition: all 0.3s ease;
  }

  .ai-navbar-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: {{ block.settings.vertical_padding }}px {{ block.settings.horizontal_padding }}px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .ai-navbar-logo-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .ai-navbar-logo-{{ ai_gen_id }} img {
    height: {{ block.settings.logo_height }}px;
    width: auto;
    object-fit: contain;
  }

  .ai-navbar-logo-placeholder-{{ ai_gen_id }} {
    height: {{ block.settings.logo_height }}px;
    width: 120px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
  }

  .ai-navbar-logo-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-navbar-menu-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.menu_spacing }}px;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-grow: 1;
    justify-content: {{ block.settings.menu_alignment }};
  }

  .ai-navbar-menu-item-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-navbar-menu-link-{{ ai_gen_id }} {
    color: {{ block.settings.link_color }};
    text-decoration: none;
    font-size: {{ block.settings.link_font_size }}px;
    font-weight: {{ block.settings.link_font_weight }};
    padding: 8px 12px;
    display: block;
    transition: color 0.3s ease;
  }

  .ai-navbar-menu-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-navbar-actions-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
  }

  .ai-navbar-icon-button-{{ ai_gen_id }} {
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.icon_color }};
    transition: color 0.3s ease;
  }

  .ai-navbar-icon-button-{{ ai_gen_id }}:hover {
    color: {{ block.settings.icon_hover_color }};
  }

  .ai-navbar-icon-button-{{ ai_gen_id }} svg {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
  }

  .ai-navbar-mobile-toggle-{{ ai_gen_id }} {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    color: {{ block.settings.icon_color }};
  }

  .ai-navbar-mobile-toggle-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
  }

  @media screen and (max-width: 989px) {
    .ai-navbar-menu-{{ ai_gen_id }} {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background-color: {{ block.settings.background_color }};
      flex-direction: column;
      align-items: stretch;
      padding: 20px;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .ai-navbar-menu-{{ ai_gen_id }}.active {
      display: flex;
    }

    .ai-navbar-menu-link-{{ ai_gen_id }} {
      padding: 12px 16px;
    }

    .ai-navbar-mobile-toggle-{{ ai_gen_id }} {
      display: block;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-navbar-container-{{ ai_gen_id }} {
      padding: {{ block.settings.vertical_padding | times: 0.8 }}px {{ block.settings.horizontal_padding | times: 0.8 }}px;
    }

    .ai-navbar-logo-{{ ai_gen_id }} img {
      height: {{ block.settings.logo_height | times: 0.8 }}px;
    }

    .ai-navbar-logo-placeholder-{{ ai_gen_id }} {
      height: {{ block.settings.logo_height | times: 0.8 }}px;
    }
  }
{% endstyle %}

<navbar-header-{{ ai_gen_id }} class="ai-navbar-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-navbar-container-{{ ai_gen_id }}">
    <a href="/" class="ai-navbar-logo-{{ ai_gen_id }}">
      {% if block.settings.logo %}
        <img
          src="{{ block.settings.logo | image_url: width: 400 }}"
          alt="{{ shop.name }}"
          loading="lazy"
          width="{{ block.settings.logo.width }}"
          height="{{ block.settings.logo.height }}"
        >
      {% else %}
        <div class="ai-navbar-logo-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </a>

    <nav>
      <ul class="ai-navbar-menu-{{ ai_gen_id }}">
        {% for i in (1..6) %}
          {% liquid
            assign link_text_key = 'menu_link_' | append: i | append: '_text'
            assign link_url_key = 'menu_link_' | append: i | append: '_url'
            assign link_text = block.settings[link_text_key]
            assign link_url = block.settings[link_url_key]
          %}
          {% if link_text != blank %}
            <li class="ai-navbar-menu-item-{{ ai_gen_id }}">
              <a href="{{ link_url }}" class="ai-navbar-menu-link-{{ ai_gen_id }}">
                {{ link_text }}
              </a>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </nav>

    <div class="ai-navbar-actions-{{ ai_gen_id }}">
      {% if block.settings.show_search %}
        <button
          class="ai-navbar-icon-button-{{ ai_gen_id }}"
          aria-label="Search"
          type="button"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>
      {% endif %}

      {% if block.settings.show_account %}
        <a
          href="/account"
          class="ai-navbar-icon-button-{{ ai_gen_id }}"
          aria-label="Account"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
        </a>
      {% endif %}

      {% if block.settings.show_cart %}
        <a
          href="/cart"
          class="ai-navbar-icon-button-{{ ai_gen_id }}"
          aria-label="Cart"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
        </a>
      {% endif %}

      <button
        class="ai-navbar-mobile-toggle-{{ ai_gen_id }}"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>
</navbar-header-{{ ai_gen_id }}>

<script>
  (function() {
    class NavbarHeader{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.mobileToggle = this.querySelector('.ai-navbar-mobile-toggle-{{ ai_gen_id }}');
        this.menu = this.querySelector('.ai-navbar-menu-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        if (this.mobileToggle && this.menu) {
          this.mobileToggle.addEventListener('click', () => {
            const isActive = this.menu.classList.contains('active');
            this.menu.classList.toggle('active');
            this.mobileToggle.setAttribute('aria-expanded', !isActive);
          });

          document.addEventListener('click', (event) => {
            if (!this.contains(event.target)) {
              this.menu.classList.remove('active');
              this.mobileToggle.setAttribute('aria-expanded', 'false');
            }
          });
        }
      }
    }

    customElements.define('navbar-header-{{ ai_gen_id }}', NavbarHeader{{ ai_gen_id }});
  })();
</script>

