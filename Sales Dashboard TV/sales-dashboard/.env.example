# ── SERVER-SIDE ONLY (no VITE_ prefix → never exposed to the browser) ──
# Used by the serverless function api/sheet.js to read the private sheets.

# Base64 of the entire service-account JSON key file.
#   Create it:  base64 -w0 service-account.json     (Linux/Git Bash)
#               [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))   (PowerShell)
GOOGLE_SERVICE_ACCOUNT_JSON=base64_of_your_service_account_json_here

# Per-sheet tab selector. Each SHEET_TAB_* may be:
#   auto:month          → current "<Month> <Year>" tab (e.g. "June 2026"), rolls over monthly
#   auto:leads          → current "<Month> <Year> LEADS" tab (Healthscore per-lead board)
#   auto:afterconsult   → current "<Month> <Year> After Consultation" tab
#   <number>            → a specific tab gid (the number after gid= in the URL)
#   <Tab Title>         → a literal tab name
# Healthscore 360 — per-lead monthly "LEADS" tab (Caller 1 + Call Status).
SHEET_ID_HEALTH=1140R1IZCvNyNezYCvW_5cVltWFkJ4oFGHEH9bpmRh6M
SHEET_TAB_HEALTH=auto:leads
# Quick Reply Leads — per-lead monthly tab (Caller 1 + Status; "Order Placed" = conversion).
SHEET_ID_QUICK=1p_p0Ti0owVswnZI-N263UIJ-5pt3H7WxJbwdazALksg
SHEET_TAB_QUICK=auto:month
