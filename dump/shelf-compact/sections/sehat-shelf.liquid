{%- comment -%}
  A product shelf: heading and one line on the left, the products of one
  collection as cards. With an intro set, it becomes a swipeable row led by
  an intro panel, pinned products first. Used on the For Him / For Her pages, one shelf per
  concern. The section carries an anchor name (and, optionally, an older
  anchor id) so menu links and the hero's jump links land on it.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign col = collections[s.collection]
  assign items = col.products
  # Picked products: every one shows, in the picked order. A collection shows up to "Products to show".
  assign cap = s.limit
  if s.products != blank
    assign items = s.products
    assign cap = 50
  endif
  assign pinned_handles = s.pinned | map: 'handle' | join: ','
  # Every shelf is one swipeable row with arrows; the intro panel shows only when set.
  assign row = true
  assign has_intro = false
  if s.intro_title != blank or s.intro_text != blank
    assign has_intro = true
  endif
-%}

{%- comment -%} Styles first, so the browser never paints this section unstyled. {%- endcomment -%}
<style>
  #ssf-{{ section.id }} {
    --ssf-text: #1d1d1d; --ssf-muted: #5f5a56; --ssf-line: #e8e0d9; --ssf-soft: #f6f0ec;
    --ssf-ink: {{ s.accent_color | color_darken: 8 }};
    padding: clamp(28px, 3vw, 40px) clamp(16px, 3vw, 48px) 0;
    background: #fff; font-family: 'Montserrat', sans-serif; color: var(--ssf-text);
  }
  #ssf-{{ section.id }} * { box-sizing: border-box; }
  #ssf-{{ section.id }} .ssf__anchor { display: block; position: relative; top: -84px; height: 0; visibility: hidden; }
  #ssf-{{ section.id }} .ssf__inner { max-width: 1240px; margin: 0 auto; }
  #ssf-{{ section.id }} .ssf__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 22px; }
  #ssf-{{ section.id }} .ssf__heading { margin: 0; font: 800 clamp(24px, 2.8vw, 36px)/1.12 'Montserrat', sans-serif; letter-spacing: -.02em; }
  #ssf-{{ section.id }} .ssf__sub { margin: 8px 0 0; max-width: 38em; font: 500 15.5px/1.55 'Montserrat', sans-serif; color: var(--ssf-muted); }
  #ssf-{{ section.id }} .ssf__all { flex: none; font: 700 14.5px/1 'Montserrat', sans-serif; color: var(--ssf-ink); text-decoration: underline; text-underline-offset: 4px; white-space: nowrap; }
  #ssf-{{ section.id }} .ssf__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; }
  #ssf-{{ section.id }} .ssf__card { position: relative; display: flex; flex-direction: column; }
  #ssf-{{ section.id }} .ssf__link { flex: 1; display: flex; flex-direction: column; text-decoration: none; color: inherit; }
  #ssf-{{ section.id }} .ssf__add { margin-top: 12px; min-height: 44px; padding: 0 16px; border: 0; border-radius: 999px; background: {{ s.accent_color }}; color: #fff; font: 700 14.5px/1 'Montserrat', sans-serif; cursor: pointer; transition: background-color .2s ease, transform .2s ease; }
  #ssf-{{ section.id }} .ssf__add:hover:not(:disabled) { background: var(--ssf-ink); transform: translateY(-1px); }
  #ssf-{{ section.id }} .ssf__add:disabled { background: var(--ssf-line); color: var(--ssf-muted); cursor: default; }
  #ssf-{{ section.id }} .ssf__add[hidden], #ssf-{{ section.id }} .ssf__qty[hidden], #ssf-{{ section.id }} [data-off][hidden], #ssf-{{ section.id }} [data-was][hidden] { display: none; }
  #ssf-{{ section.id }} .ssf__pick { position: relative; margin-top: 12px; min-width: 0; }
  #ssf-{{ section.id }} .ssf__pick-btn { display: flex; align-items: center; justify-content: space-between; gap: 8px; width: 100%; min-height: 42px; margin: 0; padding: 0 14px; border: 1px solid #f2d9a6; border-radius: 12px; background: #fdedcf; color: #1d1d1d; font: 600 13.5px/1.2 'Montserrat', sans-serif; text-align: left; cursor: pointer; transition: border-color .2s ease; }
  #ssf-{{ section.id }} .ssf__pick-val { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  #ssf-{{ section.id }} .ssf__pick-btn svg { flex: none; width: 11px; height: 11px; color: #8f1836; transition: transform .25s ease; }
  #ssf-{{ section.id }} .ssf__pick-btn[aria-expanded="true"] { border-color: #d99a2b; }
  #ssf-{{ section.id }} .ssf__pick-btn[aria-expanded="true"] svg { transform: rotate(180deg); }
  #ssf-{{ section.id }} .ssf__pick-btn:focus-visible { outline: 2px solid var(--ssf-text); outline-offset: 2px; }
  #ssf-{{ section.id }} .ssf__pick-list { position: absolute; z-index: 5; left: 0; right: 0; bottom: calc(100% + 6px); max-height: 220px; margin: 0; padding: 6px; overflow-y: auto; border: 1px solid #efdcb8; border-radius: 14px; background: #fff; list-style: none; box-shadow: 0 18px 34px -18px rgba(92, 16, 36, .35); }
  #ssf-{{ section.id }} .ssf__pick-list[hidden] { display: none; }
  #ssf-{{ section.id }} .ssf__pick-opt { display: flex; justify-content: space-between; gap: 10px; width: 100%; margin: 0; padding: 9px 10px; border: 0; border-radius: 9px; background: none; color: #1d1d1d; font: 500 13px/1.3 'Montserrat', sans-serif; text-align: left; cursor: pointer; }
  #ssf-{{ section.id }} .ssf__pick-opt > span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  #ssf-{{ section.id }} .ssf__pick-opt em { flex: none; font-style: normal; font-weight: 700; }
  #ssf-{{ section.id }} .ssf__pick-opt:hover, #ssf-{{ section.id }} .ssf__pick-opt:focus-visible { background: #fffaf3; outline: none; }
  #ssf-{{ section.id }} .ssf__pick-opt[aria-selected="true"] { background: #5c1024; color: #fbe3b0; font-weight: 700; }
  #ssf-{{ section.id }} .ssf__pick-opt:disabled { opacity: .45; cursor: default; }
  /* Cards without a pack picker keep the same space, so prices and buttons line up across the row. */
  #ssf-{{ section.id }} .ssf__grid:has(.ssf__pick) .ssf__card:not(:has(.ssf__pick)) .ssf__link { margin-bottom: 54px; }
  #ssf-{{ section.id }} .ssf__qty { margin-top: 12px; min-height: 44px; display: flex; align-items: center; justify-content: space-between; padding: 0 4px; border: 1.5px solid {{ s.accent_color }}; border-radius: 999px; color: {{ s.accent_color }}; }
  #ssf-{{ section.id }} .ssf__qty button { width: 38px; height: 38px; border: 0; border-radius: 50%; background: none; color: inherit; font: 600 20px/1 'Montserrat', sans-serif; cursor: pointer; transition: background-color .2s ease; }
  #ssf-{{ section.id }} .ssf__qty button:hover:not(:disabled) { background: var(--ssf-soft); }
  #ssf-{{ section.id }} .ssf__qty button:disabled { opacity: .4; cursor: default; }
  #ssf-{{ section.id }} .ssf__qty span { font: 700 15px/1 'Montserrat', sans-serif; color: var(--ssf-ink); }
  #ssf-{{ section.id }} .ssf__img { position: relative; border-radius: 14px; overflow: hidden; aspect-ratio: 1; background: var(--ssf-soft); }
  #ssf-{{ section.id }} .ssf__img img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .5s cubic-bezier(.16, 1, .3, 1); }
  #ssf-{{ section.id }} .ssf__off { position: absolute; left: 10px; top: 10px; padding: 6px 9px; border-radius: 8px; background: #fff; color: var(--ssf-ink); font: 700 12.5px/1 'Montserrat', sans-serif; }
  #ssf-{{ section.id }} .ssf__name { margin: 12px 0 0; font: 700 16px/1.3 'Montserrat', sans-serif; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  #ssf-{{ section.id }} .ssf__use { margin: 6px 0 0; font: 400 13.5px/1.45 'Montserrat', sans-serif; color: var(--ssf-muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  #ssf-{{ section.id }} .ssf__price { margin: auto 0 0; padding-top: 10px; font: 700 16px/1.2 'Montserrat', sans-serif; }
  #ssf-{{ section.id }} .ssf__price s { margin-left: 6px; font: 400 13.5px/1 'Montserrat', sans-serif; color: var(--ssf-muted); }
  @media (hover: hover) and (pointer: fine) {
    #ssf-{{ section.id }} .ssf__card:hover .ssf__img img { transform: scale(1.04); }
    #ssf-{{ section.id }} .ssf__card:hover .ssf__name { color: var(--ssf-ink); }
  }
  #ssf-{{ section.id }} :is(.ssf__link, .ssf__all, .ssf__add):focus-visible { outline: 2px solid var(--ssf-text); outline-offset: 4px; border-radius: 14px; }
  @media (max-width: 899px) {
    #ssf-{{ section.id }} { padding-right: 0; }
    #ssf-{{ section.id }} .ssf__head { padding-right: 16px; }
    #ssf-{{ section.id }} .ssf__grid { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; gap: 12px; padding-right: 16px; }
    #ssf-{{ section.id }} .ssf__grid::-webkit-scrollbar { display: none; }
    #ssf-{{ section.id }} .ssf__card { flex: 0 0 62%; scroll-snap-align: start; }
  }
  @media (min-width: 600px) and (max-width: 899px) { #ssf-{{ section.id }} .ssf__card { flex-basis: 34%; } }
  @media (max-width: 599px) {
    #ssf-{{ section.id }} .ssf__head { display: block; }
    #ssf-{{ section.id }} .ssf__all { display: inline-block; margin-top: 12px; }
  }
  {%- if s.center %}
  /* Centred: heading, line and View all stacked in the middle; when there are fewer
     products than columns, they sit in the middle too instead of hugging the left. */
  #ssf-{{ section.id }} .ssf__head { flex-direction: column; align-items: center; text-align: center; gap: 10px; }
  #ssf-{{ section.id }} .ssf__sub { margin-left: auto; margin-right: auto; }
  @media (min-width: 900px) {
    #ssf-{{ section.id }} .ssf__grid { grid-template-columns: repeat(auto-fit, minmax(0, calc((100% - 54px) / 4))); justify-content: center; }
  }
  @media (max-width: 899px) {
    #ssf-{{ section.id }} .ssf__head { padding-right: 0; }
    #ssf-{{ section.id }} .ssf__grid { justify-content: safe center; }
  }
  {%- endif %}
  /* Row mode (an intro is set): intro panel first, then every product in a
     swipeable row with arrow buttons, like the old store shelf. */
  #ssf-{{ section.id }}.ssf--row .ssf__grid { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; scrollbar-width: none; gap: 18px; padding-bottom: 4px; }
  #ssf-{{ section.id }}.ssf--row .ssf__grid::-webkit-scrollbar { display: none; }
  #ssf-{{ section.id }}.ssf--row .ssf__card { flex: 0 0 calc((100% - 54px) / 4.25); min-width: 0; scroll-snap-align: start; }
  #ssf-{{ section.id }}.ssf--intro .ssf__card { flex-basis: calc((100% - 300px - 54px) / 3.25); }
  #ssf-{{ section.id }} .ssf__nav[hidden] { display: none; }
  {%- if s.center %}#ssf-{{ section.id }}.ssf--row:not(.ssf--intro) .ssf__grid { justify-content: safe center; }{%- endif %}
  #ssf-{{ section.id }} .ssf__intro { flex: 0 0 300px; scroll-snap-align: start; display: flex; flex-direction: column; padding: 26px 24px; border-radius: 18px; background: linear-gradient(160deg, #fbeef0 0%, var(--ssf-soft) 70%); }
  #ssf-{{ section.id }} .ssf__intro b { font: 800 21px/1.25 'Montserrat', sans-serif; letter-spacing: -.01em; text-wrap: balance; }
  #ssf-{{ section.id }} .ssf__intro p { margin: 12px 0 0; font: 500 14.5px/1.6 'Montserrat', sans-serif; color: var(--ssf-muted); }
  #ssf-{{ section.id }} .ssf__intro a { margin-top: auto; padding-top: 18px; display: inline-flex; align-items: center; gap: 8px; color: var(--ssf-ink); font: 700 14.5px/1 'Montserrat', sans-serif; text-decoration: none; }
  #ssf-{{ section.id }} .ssf__intro a svg, #ssf-{{ section.id }} .ssf__arrow svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  #ssf-{{ section.id }} .ssf__intro a:hover svg { transform: translateX(3px); }
  #ssf-{{ section.id }} .ssf__nav { display: flex; gap: 8px; flex: none; }
  #ssf-{{ section.id }} .ssf__arrow { width: 44px; height: 44px; padding: 0; border-radius: 50%; border: 1.5px solid var(--ssf-line); background: #fff; color: var(--ssf-text); display: grid; place-items: center; cursor: pointer; transition: border-color .2s ease, color .2s ease, opacity .2s ease; }
  #ssf-{{ section.id }} .ssf__arrow:hover { border-color: var(--ssf-ink); color: var(--ssf-ink); }
  #ssf-{{ section.id }} .ssf__arrow:disabled { opacity: .35; cursor: default; }
  @media (max-width: 899px) {
    #ssf-{{ section.id }}.ssf--row .ssf__card { flex: 0 0 62%; }
    #ssf-{{ section.id }} .ssf__intro { flex: 0 0 78%; }
    #ssf-{{ section.id }} .ssf__nav { display: none; }
  }
  @media (min-width: 600px) and (max-width: 899px) { #ssf-{{ section.id }}.ssf--row .ssf__card { flex-basis: 34%; } #ssf-{{ section.id }} .ssf__intro { flex-basis: 44%; } }
  @media (prefers-reduced-motion: reduce) { #ssf-{{ section.id }} .ssf__img img { transition: none; } #ssf-{{ section.id }}.ssf--row .ssf__grid { scroll-behavior: auto; } }
  @media (min-width: 1680px) { #ssf-{{ section.id }} .ssf__inner { zoom: 1.12; } }
  @media (min-width: 1920px) { #ssf-{{ section.id }} .ssf__inner { zoom: 1.25; } }
  @media (min-width: 2560px) { #ssf-{{ section.id }} .ssf__inner { zoom: 1.65; } }
  #ssf-{{ section.id }} :is(h2, h3) { color: #1d1d1d; }
  @media (max-width: 749.98px) {
    #ssf-{{ section.id }} .ssf__all { color: var(--ssf-ink); text-decoration-color: var(--ssf-ink); text-decoration-thickness: 2px; }
    #ssf-{{ section.id }} .ssf__off { color: var(--ssf-text); }
    #ssf-{{ section.id }} .ssf__use { display: none; }
    {%- unless s.red_buttons_mobile %}
    #ssf-{{ section.id }} .ssf__add { background: #1d1d1d; }
    #ssf-{{ section.id }} .ssf__add:hover:not(:disabled) { background: #000; }
    #ssf-{{ section.id }} .ssf__qty { border-color: #1d1d1d; color: #1d1d1d; }
    {%- endunless %}
  }
  /* Phones: text runs the full width. Headings wrap normally instead of being balanced into short lines, and intros lose their desktop width caps. */
  @media (max-width: 749.98px) { #ssf-{{ section.id }} .ssf__sub { max-width: none; } #ssf-{{ section.id }} .ssf__intro b { text-wrap: wrap; } }
</style>

<section id="ssf-{{ section.id }}" class="ssf ssf--row{% if has_intro %} ssf--intro{% endif %}">
  {%- if s.anchor != blank -%}<span id="{{ s.anchor | handleize }}" class="ssf__anchor" aria-hidden="true"></span>{%- endif -%}
  {%- if s.legacy_anchor != blank -%}<span id="{{ s.legacy_anchor | escape }}" class="ssf__anchor" aria-hidden="true"></span>{%- endif -%}
  <div class="ssf__inner">
    <div class="ssf__head">
      <div>
        <h2 class="ssf__heading">{{ s.heading }}</h2>
        {%- if s.subheading != blank -%}<p class="ssf__sub">{{ s.subheading }}</p>{%- endif -%}
      </div>
      {%- if row -%}
        <div class="ssf__nav">
          <button class="ssf__arrow" type="button" data-dir="-1" aria-label="Previous products"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M13 8H3M7 4 3 8l4 4"/></svg></button>
          <button class="ssf__arrow" type="button" data-dir="1" aria-label="More products"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></button>
        </div>
      {%- elsif col != blank and s.all_label != blank and col.products_count > cap -%}
        <a class="ssf__all" href="{{ col.url }}">{{ s.all_label }}</a>
      {%- endif -%}
    </div>
    <div class="ssf__grid">
      {%- if has_intro -%}
        <div class="ssf__intro">
          {%- if s.intro_title != blank -%}<b>{{ s.intro_title }}</b>{%- endif -%}
          {%- if s.intro_text != blank -%}<p>{{ s.intro_text }}</p>{%- endif -%}
          {%- if col != blank and s.all_label != blank -%}<a href="{{ col.url }}">{{ s.all_label }}<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>{%- endif -%}
        </div>
      {%- endif -%}
      {%- assign shown = 0 -%}
      {%- for p in s.pinned -%}
          {%- render 'sehat-shelf-card', p: p, show_use: s.show_use -%}
        {%- assign shown = shown | plus: 1 -%}
      {%- endfor -%}
      {%- for p in items -%}
        {%- if shown >= cap -%}{%- break -%}{%- endif -%}
        {%- assign ph = ',' | append: pinned_handles | append: ',' -%}
        {%- assign me = ',' | append: p.handle | append: ',' -%}
        {%- if ph contains me -%}{%- continue -%}{%- endif -%}
          {%- render 'sehat-shelf-card', p: p, show_use: s.show_use -%}
        {%- assign shown = shown | plus: 1 -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
  /* Add to cart: posts to the cart, then refreshes the theme's cart drawer
     (and opens it) when the store uses one, otherwise just the cart count.
     After that the button turns into a - n + counter for that product, like
     the live store's shelves. Every counter for the same product on the page
     moves together, and they re-check the cart when the page is shown again
     (back button) or something else on the page changes the cart. */
  (function () {
    var root = document.getElementById('ssf-{{ section.id }}');
    if (!root) return;
    var base = window.Shopify && Shopify.routes ? Shopify.routes.root : '/';

    function show(id, qty) {
      document.querySelectorAll('.ssf__qty[data-qty="' + id + '"]').forEach(function (box) {
        var add = box.parentNode.querySelector('.ssf__add[data-variant]');
        box.hidden = qty < 1;
        if (add) add.hidden = qty > 0;
        box.querySelector('[data-count]').textContent = Math.max(qty, 1);
      });
    }
    function bubble(d) {
      if (!d.sections || !d.sections['cart-icon-bubble']) return;
      var el = document.getElementById('cart-icon-bubble');
      var html = new DOMParser().parseFromString(d.sections['cart-icon-bubble'], 'text/html').querySelector('.shopify-section');
      if (el && html) el.innerHTML = html.innerHTML;
    }
    function post(path, body) {
      return fetch(base + path, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(body) })
        .then(function (r) { return r.json().then(function (d) { if (!r.ok) throw d; return d; }); });
    }
    function inCart(cart, id) {
      return cart.items.reduce(function (n, it) { return n + (String(it.variant_id) === String(id) ? it.quantity : 0); }, 0);
    }
    function changed() { document.dispatchEvent(new CustomEvent('cart:updated', { detail: { source: 'sehat-shelf' } })); }

    /* Pack picker: open/close the list; picking a pack updates price, % off, and the variant the button adds. */
    function closePicks(except) {
      root.querySelectorAll('.ssf__pick-btn[aria-expanded="true"]').forEach(function (b) {
        if (b === except) return;
        b.setAttribute('aria-expanded', 'false');
        b.nextElementSibling.hidden = true;
      });
    }
    document.addEventListener('click', function (e) { if (!(e.target.closest && root.contains(e.target) && e.target.closest('.ssf__pick'))) closePicks(); });
    root.addEventListener('keydown', function (e) {
      var list = e.target.closest && e.target.closest('.ssf__pick-list');
      if (!list) return;
      if (e.key === 'Escape') { closePicks(); list.previousElementSibling.focus(); }
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        var all = [].slice.call(list.querySelectorAll('.ssf__pick-opt:not(:disabled)')), i = all.indexOf(e.target);
        e.preventDefault();
        all[(i + (e.key === 'ArrowDown' ? 1 : all.length - 1)) % all.length].focus();
      }
    });
    function pick(opt) {
      var card = opt.closest('.ssf__card'), id = opt.dataset.v;
      card.querySelector('.ssf__pick-val').textContent = opt.dataset.t;
      card.querySelectorAll('.ssf__pick-opt').forEach(function (o) { o.setAttribute('aria-selected', o === opt); });
      card.querySelector('[data-now]').textContent = opt.dataset.p;
      var was = card.querySelector('[data-was]'), off = card.querySelector('[data-off]');
      if (was) { was.hidden = !opt.dataset.c; was.querySelector('[data-was-v]').textContent = opt.dataset.c || ''; }
      if (off) { off.hidden = !opt.dataset.o; off.textContent = (opt.dataset.o || 0) + '% off'; }
      var add = card.querySelector('.ssf__add[data-variant]'), qty = card.querySelector('.ssf__qty[data-qty]');
      if (add) add.dataset.variant = id;
      if (qty) qty.dataset.qty = id;
      closePicks();
      card.querySelector('.ssf__pick-btn').focus();
      sync();
    }

    root.addEventListener('click', function (e) {
      var pb = e.target.closest('.ssf__pick-btn'), po = e.target.closest('.ssf__pick-opt');
      if (pb) {
        closePicks(pb);
        var open = pb.getAttribute('aria-expanded') !== 'true';
        pb.setAttribute('aria-expanded', open);
        pb.nextElementSibling.hidden = !open;
        if (open) (pb.nextElementSibling.querySelector('[aria-selected="true"]:not(:disabled)') || pb.nextElementSibling.querySelector('.ssf__pick-opt:not(:disabled)')).focus();
        return;
      }
      if (po) { if (!po.disabled) pick(po); return; }
      var btn = e.target.closest('.ssf__add[data-variant]');
      if (btn && !btn.disabled) {
        var id = btn.dataset.variant, drawer = document.querySelector('cart-drawer'), label = btn.textContent;
        btn.disabled = true; btn.textContent = 'Adding...';
        post('cart/add.js', { items: [{ id: +id, quantity: 1 }], sections: drawer ? 'cart-drawer,cart-icon-bubble' : 'cart-icon-bubble', sections_url: location.pathname })
          .then(function (d) {
            if (drawer && drawer.renderContents) { drawer.classList.remove('is-empty'); drawer.renderContents(d); } else bubble(d);
            var line = (d.items || []).filter(function (it) { return String(it.variant_id) === id; })[0];
            btn.disabled = false; btn.textContent = label;
            show(id, line ? line.quantity : 1);
            changed();
          })
          .catch(function (err) {
            btn.textContent = (err && err.description) || 'Could not add, try again';
            setTimeout(function () { btn.disabled = false; btn.textContent = label; }, 2200);
          });
        return;
      }
      var step = e.target.closest('.ssf__qty [data-step]');
      if (!step) return;
      var box = step.closest('.ssf__qty'), vid = box.dataset.qty, ctrls = box.querySelectorAll('button');
      var want = Math.max(0, +box.querySelector('[data-count]').textContent + +step.dataset.step);
      var upd = {}; upd[vid] = want;
      ctrls.forEach(function (c) { c.disabled = true; });
      post('cart/update.js', { updates: upd, sections: 'cart-icon-bubble', sections_url: location.pathname })
        .then(function (cart) { bubble(cart); show(vid, inCart(cart, vid)); changed(); })
        .catch(function () {})
        .finally(function () { ctrls.forEach(function (c) { c.disabled = false; }); });
    });

    function sync() {
      fetch(base + 'cart.js', { headers: { Accept: 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (cart) { root.querySelectorAll('.ssf__qty[data-qty]').forEach(function (box) { show(box.dataset.qty, inCart(cart, box.dataset.qty)); }); })
        .catch(function () {});
    }
    window.addEventListener('pageshow', function (e) { if (e.persisted) sync(); });
    document.addEventListener('cart:updated', function (e) { if (!e.detail || e.detail.source !== 'sehat-shelf') sync(); });
  })();
</script>

{%- if row -%}
<script>
  (function () {
    var root = document.getElementById('ssf-{{ section.id }}');
    var grid = root && root.querySelector('.ssf__grid');
    if (!grid) return;
    var btns = root.querySelectorAll('.ssf__arrow');
    var nav = root.querySelector('.ssf__nav');
    function state() {
      if (nav) nav.hidden = grid.scrollWidth <= grid.clientWidth + 8;
      btns[0].disabled = grid.scrollLeft < 8;
      btns[1].disabled = grid.scrollLeft + grid.clientWidth > grid.scrollWidth - 8;
    }
    btns.forEach(function (b) {
      b.addEventListener('click', function () {
        var card = grid.querySelector('.ssf__card');
        var step = card ? card.getBoundingClientRect().width + 18 : grid.clientWidth * .8;
        grid.scrollBy({ left: step * Number(b.dataset.dir), behavior: 'smooth' });
      });
    });
    grid.addEventListener('scroll', state, { passive: true });
    addEventListener('resize', state);
    state();
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "sehatUP product shelf",
  "tag": "div",
  "class": "section-sehat-shelf",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sexual wellness" },
    { "type": "textarea", "id": "subheading", "label": "One line under it" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Also used for the View all link." },
    { "type": "product_list", "id": "products", "label": "Or pick products", "info": "Shown instead of the collection when set. All picked products show, as many as you add.", "limit": 50 },
    { "type": "product_list", "id": "pinned", "label": "Show these first", "limit": 12 },
    { "type": "range", "id": "limit", "label": "Products to show (collection only)", "min": 2, "max": 48, "step": 1, "default": 4, "info": "Picked products ignore this and all show." },
    { "type": "text", "id": "intro_title", "label": "Intro title", "info": "Setting an intro turns the shelf into a swipeable row with arrows." },
    { "type": "textarea", "id": "intro_text", "label": "Intro text" },
    { "type": "text", "id": "all_label", "label": "View all link text", "default": "View all" },
    { "type": "checkbox", "id": "show_use", "label": "Show the short 'how to take it' line", "default": false },
    { "type": "text", "id": "anchor", "label": "Anchor name", "info": "Jump links use #name, for example #sexual-wellness." },
    { "type": "text", "id": "legacy_anchor", "label": "Older anchor id (optional)", "info": "Keeps an existing menu link working: paste the part after # from the old link." },
    { "type": "checkbox", "id": "center", "label": "Centre the heading and the products", "default": false },
    { "type": "checkbox", "id": "red_buttons_mobile", "label": "Phones: Add to cart in the accent colour", "info": "Off: black on phones.", "default": false },
    { "type": "color", "id": "accent_color", "label": "Accent colour", "default": "#d81f48" }
  ],
  "presets": [{ "name": "sehatUP product shelf" }]
}
{% endschema %}
