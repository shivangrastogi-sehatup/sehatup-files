{%- comment -%}
  A product shelf: heading and one line on the left, the products of one
  collection as cards. With an intro set, it becomes a swipeable row led by
  an intro panel, pinned products first. Used on the For Him / For Her pages, one shelf per
  concern. The section carries an anchor name (and, optionally, an older
  anchor id) so menu links and the hero's jump links land on it.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign col = collections[s.collection]
  assign items = col.products
  if s.products != blank
    assign items = s.products
  endif
  assign pinned_handles = s.pinned | map: 'handle' | join: ','
  assign row = false
  if s.intro_title != blank or s.intro_text != blank
    assign row = true
  endif
-%}

{%- comment -%} Styles first, so the browser never paints this section unstyled. {%- endcomment -%}
<style>
  #ssf-{{ section.id }} {
    --ssf-text: #1d1d1d; --ssf-muted: #5f5a56; --ssf-line: #e8e0d9; --ssf-soft: #f6f0ec;
    --ssf-ink: {{ s.accent_color | color_darken: 8 }};
    padding: clamp(36px, 5vw, 64px) clamp(16px, 3vw, 48px) 0;
    background: #fff; font-family: 'Montserrat', sans-serif; color: var(--ssf-text);
  }
  #ssf-{{ section.id }} * { box-sizing: border-box; }
  #ssf-{{ section.id }} .ssf__anchor { display: block; position: relative; top: -84px; height: 0; visibility: hidden; }
  #ssf-{{ section.id }} .ssf__inner { max-width: 1240px; margin: 0 auto; }
  #ssf-{{ section.id }} .ssf__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 22px; }
  #ssf-{{ section.id }} .ssf__heading { margin: 0; font: 800 clamp(24px, 2.8vw, 36px)/1.12 'Montserrat', sans-serif; letter-spacing: -.02em; }
  #ssf-{{ section.id }} .ssf__sub { margin: 8px 0 0; max-width: 38em; font: 500 15.5px/1.55 'Montserrat', sans-serif; color: var(--ssf-muted); }
  #ssf-{{ section.id }} .ssf__all { flex: none; font: 700 14.5px/1 'Montserrat', sans-serif; color: var(--ssf-ink); text-decoration: underline; text-underline-offset: 4px; white-space: nowrap; }
  #ssf-{{ section.id }} .ssf__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; }
  #ssf-{{ section.id }} .ssf__card { position: relative; display: flex; flex-direction: column; }
  #ssf-{{ section.id }} .ssf__link { flex: 1; display: flex; flex-direction: column; text-decoration: none; color: inherit; }
  #ssf-{{ section.id }} .ssf__add { margin-top: 12px; min-height: 44px; padding: 0 16px; border: 0; border-radius: 999px; background: {{ s.accent_color }}; color: #fff; font: 700 14.5px/1 'Montserrat', sans-serif; cursor: pointer; transition: background-color .2s ease, transform .2s ease; }
  #ssf-{{ section.id }} .ssf__add:hover:not(:disabled) { background: var(--ssf-ink); transform: translateY(-1px); }
  #ssf-{{ section.id }} .ssf__add:disabled { background: var(--ssf-line); color: var(--ssf-muted); cursor: default; }
  #ssf-{{ section.id }} .ssf__add.is-done { background: var(--ssf-text); }
  #ssf-{{ section.id }} .ssf__img { position: relative; border-radius: 14px; overflow: hidden; aspect-ratio: 1; background: var(--ssf-soft); }
  #ssf-{{ section.id }} .ssf__img img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .5s cubic-bezier(.16, 1, .3, 1); }
  #ssf-{{ section.id }} .ssf__off { position: absolute; left: 10px; top: 10px; padding: 6px 9px; border-radius: 8px; background: #fff; color: var(--ssf-ink); font: 700 12.5px/1 'Montserrat', sans-serif; }
  #ssf-{{ section.id }} .ssf__name { margin: 12px 0 0; font: 700 16px/1.3 'Montserrat', sans-serif; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  #ssf-{{ section.id }} .ssf__use { margin: 6px 0 0; font: 400 13.5px/1.45 'Montserrat', sans-serif; color: var(--ssf-muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  #ssf-{{ section.id }} .ssf__price { margin: auto 0 0; padding-top: 10px; font: 700 16px/1.2 'Montserrat', sans-serif; }
  #ssf-{{ section.id }} .ssf__price s { margin-left: 6px; font: 400 13.5px/1 'Montserrat', sans-serif; color: var(--ssf-muted); }
  @media (hover: hover) and (pointer: fine) {
    #ssf-{{ section.id }} .ssf__card:hover .ssf__img img { transform: scale(1.04); }
    #ssf-{{ section.id }} .ssf__card:hover .ssf__name { color: var(--ssf-ink); }
  }
  #ssf-{{ section.id }} :is(.ssf__link, .ssf__all, .ssf__add):focus-visible { outline: 2px solid var(--ssf-text); outline-offset: 4px; border-radius: 14px; }
  @media (max-width: 899px) {
    #ssf-{{ section.id }} { padding-right: 0; }
    #ssf-{{ section.id }} .ssf__head { padding-right: 16px; }
    #ssf-{{ section.id }} .ssf__grid { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; gap: 12px; padding-right: 16px; }
    #ssf-{{ section.id }} .ssf__grid::-webkit-scrollbar { display: none; }
    #ssf-{{ section.id }} .ssf__card { flex: 0 0 62%; scroll-snap-align: start; }
  }
  @media (min-width: 600px) and (max-width: 899px) { #ssf-{{ section.id }} .ssf__card { flex-basis: 34%; } }
  @media (max-width: 599px) {
    #ssf-{{ section.id }} .ssf__head { display: block; }
    #ssf-{{ section.id }} .ssf__all { display: inline-block; margin-top: 12px; }
  }
  /* Row mode (an intro is set): intro panel first, then every product in a
     swipeable row with arrow buttons, like the old store shelf. */
  #ssf-{{ section.id }}.ssf--row .ssf__grid { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; scrollbar-width: none; gap: 18px; padding-bottom: 4px; }
  #ssf-{{ section.id }}.ssf--row .ssf__grid::-webkit-scrollbar { display: none; }
  #ssf-{{ section.id }}.ssf--row .ssf__card { flex: 0 0 calc((100% - 300px - 54px) / 3.25); scroll-snap-align: start; }
  #ssf-{{ section.id }} .ssf__intro { flex: 0 0 300px; scroll-snap-align: start; display: flex; flex-direction: column; padding: 26px 24px; border-radius: 18px; background: linear-gradient(160deg, #fbeef0 0%, var(--ssf-soft) 70%); }
  #ssf-{{ section.id }} .ssf__intro b { font: 800 21px/1.25 'Montserrat', sans-serif; letter-spacing: -.01em; text-wrap: balance; }
  #ssf-{{ section.id }} .ssf__intro p { margin: 12px 0 0; font: 500 14.5px/1.6 'Montserrat', sans-serif; color: var(--ssf-muted); }
  #ssf-{{ section.id }} .ssf__intro a { margin-top: auto; padding-top: 18px; display: inline-flex; align-items: center; gap: 8px; color: var(--ssf-ink); font: 700 14.5px/1 'Montserrat', sans-serif; text-decoration: none; }
  #ssf-{{ section.id }} .ssf__intro a svg, #ssf-{{ section.id }} .ssf__arrow svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  #ssf-{{ section.id }} .ssf__intro a:hover svg { transform: translateX(3px); }
  #ssf-{{ section.id }} .ssf__nav { display: flex; gap: 8px; flex: none; }
  #ssf-{{ section.id }} .ssf__arrow { width: 44px; height: 44px; padding: 0; border-radius: 50%; border: 1.5px solid var(--ssf-line); background: #fff; color: var(--ssf-text); display: grid; place-items: center; cursor: pointer; transition: border-color .2s ease, color .2s ease, opacity .2s ease; }
  #ssf-{{ section.id }} .ssf__arrow:hover { border-color: var(--ssf-ink); color: var(--ssf-ink); }
  #ssf-{{ section.id }} .ssf__arrow:disabled { opacity: .35; cursor: default; }
  @media (max-width: 899px) {
    #ssf-{{ section.id }}.ssf--row .ssf__card { flex: 0 0 62%; }
    #ssf-{{ section.id }} .ssf__intro { flex: 0 0 78%; }
    #ssf-{{ section.id }} .ssf__nav { display: none; }
  }
  @media (min-width: 600px) and (max-width: 899px) { #ssf-{{ section.id }}.ssf--row .ssf__card { flex-basis: 34%; } #ssf-{{ section.id }} .ssf__intro { flex-basis: 44%; } }
  @media (prefers-reduced-motion: reduce) { #ssf-{{ section.id }} .ssf__img img { transition: none; } #ssf-{{ section.id }}.ssf--row .ssf__grid { scroll-behavior: auto; } }
  @media (min-width: 1680px) { #ssf-{{ section.id }} .ssf__inner { zoom: 1.12; } }
  @media (min-width: 1920px) { #ssf-{{ section.id }} .ssf__inner { zoom: 1.25; } }
  @media (min-width: 2560px) { #ssf-{{ section.id }} .ssf__inner { zoom: 1.65; } }
</style>

<section id="ssf-{{ section.id }}" class="ssf{% if row %} ssf--row{% endif %}">
  {%- if s.anchor != blank -%}<span id="{{ s.anchor | handleize }}" class="ssf__anchor" aria-hidden="true"></span>{%- endif -%}
  {%- if s.legacy_anchor != blank -%}<span id="{{ s.legacy_anchor | escape }}" class="ssf__anchor" aria-hidden="true"></span>{%- endif -%}
  <div class="ssf__inner">
    <div class="ssf__head">
      <div>
        <h2 class="ssf__heading">{{ s.heading }}</h2>
        {%- if s.subheading != blank -%}<p class="ssf__sub">{{ s.subheading }}</p>{%- endif -%}
      </div>
      {%- if row -%}
        <div class="ssf__nav">
          <button class="ssf__arrow" type="button" data-dir="-1" aria-label="Previous products"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M13 8H3M7 4 3 8l4 4"/></svg></button>
          <button class="ssf__arrow" type="button" data-dir="1" aria-label="More products"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></button>
        </div>
      {%- elsif col != blank and s.all_label != blank and col.products_count > s.limit -%}
        <a class="ssf__all" href="{{ col.url }}">{{ s.all_label }}</a>
      {%- endif -%}
    </div>
    <div class="ssf__grid">
      {%- if row -%}
        <div class="ssf__intro">
          {%- if s.intro_title != blank -%}<b>{{ s.intro_title }}</b>{%- endif -%}
          {%- if s.intro_text != blank -%}<p>{{ s.intro_text }}</p>{%- endif -%}
          {%- if col != blank and s.all_label != blank -%}<a href="{{ col.url }}">{{ s.all_label }}<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>{%- endif -%}
        </div>
      {%- endif -%}
      {%- assign shown = 0 -%}
      {%- for p in s.pinned -%}
          {%- render 'sehat-shelf-card', p: p, show_use: s.show_use -%}
        {%- assign shown = shown | plus: 1 -%}
      {%- endfor -%}
      {%- for p in items -%}
        {%- if shown >= s.limit -%}{%- break -%}{%- endif -%}
        {%- assign ph = ',' | append: pinned_handles | append: ',' -%}
        {%- assign me = ',' | append: p.handle | append: ',' -%}
        {%- if ph contains me -%}{%- continue -%}{%- endif -%}
          {%- render 'sehat-shelf-card', p: p, show_use: s.show_use -%}
        {%- assign shown = shown | plus: 1 -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
  /* Add to cart: posts to the cart, then refreshes the theme's cart drawer
     (and opens it) when the store uses one, otherwise just the cart count. */
  (function () {
    var root = document.getElementById('ssf-{{ section.id }}');
    if (!root) return;
    root.addEventListener('click', function (e) {
      var btn = e.target.closest('.ssf__add[data-variant]');
      if (!btn || btn.disabled) return;
      var drawer = document.querySelector('cart-drawer');
      var label = btn.textContent;
      btn.disabled = true; btn.textContent = 'Adding...';
      fetch(window.Shopify && Shopify.routes ? Shopify.routes.root + 'cart/add.js' : '/cart/add.js', {
        method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ items: [{ id: +btn.dataset.variant, quantity: 1 }], sections: drawer ? 'cart-drawer,cart-icon-bubble' : 'cart-icon-bubble', sections_url: location.pathname })
      }).then(function (r) { return r.json().then(function (d) { if (!r.ok) throw d; return d; }); })
        .then(function (d) {
          if (drawer && drawer.renderContents) {
            drawer.classList.remove('is-empty');
            drawer.renderContents(d);
          } else if (d.sections && d.sections['cart-icon-bubble']) {
            var bubble = document.getElementById('cart-icon-bubble');
            var html = new DOMParser().parseFromString(d.sections['cart-icon-bubble'], 'text/html').querySelector('.shopify-section');
            if (bubble && html) bubble.innerHTML = html.innerHTML;
          }
          btn.textContent = 'Added'; btn.classList.add('is-done');
        })
        .catch(function (err) { btn.textContent = (err && err.description) || 'Could not add, try again'; })
        .finally(function () {
          setTimeout(function () { btn.disabled = false; btn.textContent = label; btn.classList.remove('is-done'); }, 2200);
        });
    });
  })();
</script>

{%- if row -%}
<script>
  (function () {
    var root = document.getElementById('ssf-{{ section.id }}');
    var grid = root && root.querySelector('.ssf__grid');
    if (!grid) return;
    var btns = root.querySelectorAll('.ssf__arrow');
    function state() {
      btns[0].disabled = grid.scrollLeft < 8;
      btns[1].disabled = grid.scrollLeft + grid.clientWidth > grid.scrollWidth - 8;
    }
    btns.forEach(function (b) {
      b.addEventListener('click', function () {
        var card = grid.querySelector('.ssf__card');
        var step = card ? card.getBoundingClientRect().width + 18 : grid.clientWidth * .8;
        grid.scrollBy({ left: step * Number(b.dataset.dir), behavior: 'smooth' });
      });
    });
    grid.addEventListener('scroll', state, { passive: true });
    state();
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "sehatUP product shelf",
  "tag": "div",
  "class": "section-sehat-shelf",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sexual wellness" },
    { "type": "textarea", "id": "subheading", "label": "One line under it" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Also used for the View all link." },
    { "type": "product_list", "id": "products", "label": "Or pick products", "info": "Shown instead of the collection when set.", "limit": 12 },
    { "type": "product_list", "id": "pinned", "label": "Show these first", "limit": 3 },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "text", "id": "intro_title", "label": "Intro title", "info": "Setting an intro turns the shelf into a swipeable row with arrows." },
    { "type": "textarea", "id": "intro_text", "label": "Intro text" },
    { "type": "text", "id": "all_label", "label": "View all link text", "default": "View all" },
    { "type": "checkbox", "id": "show_use", "label": "Show the short 'how to take it' line", "default": false },
    { "type": "text", "id": "anchor", "label": "Anchor name", "info": "Jump links use #name, for example #sexual-wellness." },
    { "type": "text", "id": "legacy_anchor", "label": "Older anchor id (optional)", "info": "Keeps an existing menu link working: paste the part after # from the old link." },
    { "type": "color", "id": "accent_color", "label": "Accent colour", "default": "#d81f48" }
  ],
  "presets": [{ "name": "sehatUP product shelf" }]
}
{% endschema %}
