{%- liquid
  assign s = section.settings
  assign box = false
  if s.layout == 'box'
    assign box = true
  endif
  assign card = false
  if s.layout == 'card'
    assign card = true
  endif
-%}
{%- capture photo -%}
  <div class="lm-hero__bg">
    {%- if s.image != blank -%}
      {{ s.image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '700, 1000, 1400, 1800', sizes: '(max-width: 749px) 100vw, 60vw', alt: s.image.alt }}
    {%- endif -%}
  </div>
{%- endcapture -%}
{%- if card -%}
<style>
  /* Card layout: heading on top, photo + card below. */
  .lm-hero--card .lm-hero__top { text-align: center; padding-top: clamp(36px, 4.5vw, 72px); }
  .lm-hero__ticks { list-style: none; display: flex; justify-content: center; flex-wrap: wrap; gap: 8px 24px; margin: 0 0 18px; padding: 0; font: 600 15px/1.3 var(--lm-font); color: var(--lm-mute); }
  .lm-hero__ticks li { display: inline-flex; align-items: center; gap: 8px; }
  .lm-hero__ticks i { width: 20px; height: 20px; flex: none; border-radius: 50%; display: grid; place-items: center; background: var(--lm-tick, #2e9e5b); }
  .lm-hero__ticks svg { width: 12px; height: 12px; fill: none; stroke: #fff; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .lm-hero--card .lm-hero__h { margin: 0 auto; max-width: 16em; }
  .lm-hero--card .lm-hero__sub { margin: 16px auto 0; }
  .lm-hero--card .lm-hero__in { align-items: stretch; padding-top: clamp(28px, 3.5vw, 52px); }
  .lm-hero--card .lm-hero__bg { aspect-ratio: auto; min-height: 440px; }
  .lm-hero__card { max-width: none; display: flex; flex-direction: column; justify-content: center; min-width: 0; padding: clamp(24px, 3vw, 40px); border-radius: 28px; background: #fff; border: 1px solid var(--lm-line); box-shadow: 0 30px 60px -42px rgba(60, 30, 20, .4); }
  .lm-hero__card-h { margin: 0; text-align: center; font: 800 clamp(22px, 1.9vw, 28px)/1.2 var(--lm-font); letter-spacing: -.01em; color: var(--lm-red-2, #d81f48); }
  .lm-hero__card-p { margin: 8px 0 0; font: 500 15px/1.55 var(--lm-font); color: var(--lm-mute); }
  .lm-hero--card .lm-hero__cta { flex-direction: column; margin-top: 24px; }
  .lm-hero--card .lm-hero__cta .lm-btn { width: 100%; justify-content: space-between; }
  .lm-hero--card .lm-hero__safe { align-self: flex-start; margin-top: 16px; }
  .lm-hero--card .lm-hero__proof { margin-top: 24px; padding-top: 22px; border-top: 1px solid var(--lm-line); }
  /* Desktop sizes from the settings: photo height, card width, and whether the card matches the photo's height. */
  @media (min-width: 750px) {
    .lm-hero--card .lm-hero__in { align-items: var(--lm-calign, stretch); }
    .lm-hero--card .lm-hero__bg { min-height: 0; height: var(--lm-ch, 440px); }
    .lm-hero--card .lm-hero__card { max-width: var(--lm-cw, 600px); width: 100%; }
  }
  .lm-hero__revs { margin-top: 18px; min-width: 0; }
  .lm-hero__revs .jmr__card { flex-basis: 100%; min-height: 0; padding: 18px 18px 16px; }
  .lm-hero__revs .jmr__nav { justify-content: flex-start; margin-top: 12px; }
  .lm-hero__revs .jmr__arrow { width: 38px; height: 38px; }
  @media (max-width: 749.98px) {
    .lm-hero--card .lm-hero__top { padding-top: 28px; }
    .lm-hero__ticks { gap: 6px 16px; margin-bottom: 14px; font-size: 13.5px; }
    .lm-hero__ticks i { width: 18px; height: 18px; }
    .lm-hero--card .lm-hero__in { margin-top: 0; padding-top: 22px; }
    .lm-hero--card .lm-hero__bg { min-height: 0; }
    .lm-hero__card { padding: 22px 18px; border-radius: 22px; }
  }
</style>
<section class="lm-hero lm-hero--box lm-hero--card lm-hero--img-left{% if s.glow %} lm-hero--glow{% endif %}" style="{% if s.glow %}--lm-glow: {{ s.glow_color }}; {% endif %}--lm-tick: {{ s.tick_color | default: '#2e9e5b' }}; --lm-hw: {{ s.img_width }}%; --lm-hz: {{ s.img_zoom | divided_by: 100.0 }}; --lm-hy: {{ s.img_focus }}%; --lm-hm: {{ s.img_height_mobile }}px; --lm-hg: {{ s.gap }}px; --lm-ch: {{ s.card_photo_height | default: 440 }}px; --lm-cw: {{ s.card_width | default: 600 }}px; --lm-calign: {% if s.card_match_height == false %}center{% else %}stretch{% endif %};">
  <div class="lm-wrap lm-hero__top">
    {%- assign ticks = s.ticks | newline_to_br | split: '<br />' -%}
    {%- if s.ticks != blank -%}
      <ul class="lm-hero__ticks">
        {%- for tk in ticks -%}{%- assign tk = tk | strip -%}{%- if tk != blank -%}<li><i aria-hidden="true"><svg viewBox="0 0 16 16"><path d="m3.5 8.5 3 3 6-7"/></svg></i>{{ tk }}</li>{%- endif -%}{%- endfor -%}
      </ul>
    {%- endif -%}
    <h1 class="lm-hero__h">{{ s.heading }}{% if s.highlight != blank %} <span class="lm-mark">{{ s.highlight }}</span>{% endif %}{% if s.heading_end != blank %} {{ s.heading_end }}{% endif %}</h1>
    {%- if s.subheading != blank -%}<p class="lm-hero__sub">{%- if s.sub_red != blank -%}{%- capture red -%}<span class="lm-mark">{{ s.sub_red }}</span>{%- endcapture -%}{{ s.subheading | replace_first: s.sub_red, red }}{%- else -%}{{ s.subheading }}{%- endif -%}</p>{%- endif -%}
  </div>
  <div class="lm-wrap lm-hero__in">
    {{ photo }}
    <div class="lm-hero__copy lm-hero__card">
      {%- if s.card_heading != blank -%}<h2 class="lm-hero__card-h">{{ s.card_heading }}</h2>{%- endif -%}
      {%- if s.card_text != blank -%}<p class="lm-hero__card-p">{{ s.card_text }}</p>{%- endif -%}
      <div class="lm-hero__cta">
        {%- if s.button_1 != blank -%}
          <a class="lm-btn lm-btn--red" href="{{ s.button_1_link | default: '#book' }}"><span>{{ s.button_1 }}{% if s.button_1_note != blank %}<small>{{ s.button_1_note }}</small>{% endif %}</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>
        {%- endif -%}
        {%- if s.button_2 != blank -%}
          <a class="lm-btn lm-btn--line" href="{{ s.button_2_link | default: '#' }}"><span>{{ s.button_2 }}{% if s.button_2_note != blank %}<small>{{ s.button_2_note }}</small>{% endif %}</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>
        {%- endif -%}
      </div>
      {%- if s.privacy != blank -%}
        <p class="lm-hero__safe"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>{{ s.privacy }}</p>
      {%- endif -%}
      {%- if s.trust_text != blank -%}
        <div class="lm-hero__proof">
          <span class="lm-hero__avs" aria-hidden="true">
            {%- assign avs = s.trust_initials | split: ',' -%}
            {%- for i in (1..3) -%}{%- assign ak = 'avatar_' | append: i -%}{%- assign letter = avs[forloop.index0] | strip | slice: 0 -%}{%- if s[ak] != blank -%}<i class="has-img">{{ s[ak] | image_url: width: 400, height: 400, crop: 'center' | image_tag: alt: '', loading: 'eager', width: 42, height: 42, widths: '120, 200, 300, 400', sizes: '42px' }}</i>{%- elsif letter != blank -%}<i>{{ letter }}</i>{%- endif -%}{%- endfor -%}
          </span>
          <span class="lm-hero__proof-t">
            <b>{{ s.trust_text }}</b>
            {%- if s.rating != blank -%}<span><i aria-hidden="true">★★★★★</i> ({{ s.rating }}/5)</span>{%- endif -%}
          </span>
        </div>
      {%- endif -%}
      {%- if s.review_products != blank -%}
        <div class="lm-hero__revs">{%- render 'sehat-jm-reviews', products: s.review_products, min: 4, max: 8, uid: section.id -%}</div>
      {%- endif -%}
    </div>
  </div>
</section>
{%- else -%}
<section class="lm-hero{% if s.glow %} lm-hero--glow{% endif %}{% if box %} lm-hero--box lm-hero--img-{{ s.image_side | default: 'left' }}{% endif %}" style="{% if s.glow %}--lm-glow: {{ s.glow_color }}; {% endif %}--lm-hw: {{ s.img_width }}%; --lm-hz: {{ s.img_zoom | divided_by: 100.0 }}; --lm-hy: {{ s.img_focus }}%; --lm-hm: {{ s.img_height_mobile }}px; --lm-hg: {{ s.gap }}px;">
  {%- unless box -%}{{ photo }}{%- endunless -%}
  <div class="lm-wrap lm-hero__in">
    {%- if box -%}{{ photo }}{%- endif -%}
    <div class="lm-hero__copy">
      <h1 class="lm-hero__h">{{ s.heading }}{% if s.highlight != blank %} <span class="lm-mark">{{ s.highlight }}</span>{% endif %}{% if s.heading_end != blank %} {{ s.heading_end }}{% endif %}</h1>
      {%- if s.subheading != blank -%}<p class="lm-hero__sub">{%- if s.sub_red != blank -%}{%- capture red -%}<span class="lm-mark">{{ s.sub_red }}</span>{%- endcapture -%}{{ s.subheading | replace_first: s.sub_red, red }}{%- else -%}{{ s.subheading }}{%- endif -%}</p>{%- endif -%}
      <div class="lm-hero__cta">
        {%- if s.button_1 != blank -%}
          <a class="lm-btn lm-btn--red" href="{{ s.button_1_link | default: '#book' }}"><span>{{ s.button_1 }}{% if s.button_1_note != blank %}<small>{{ s.button_1_note }}</small>{% endif %}</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>
        {%- endif -%}
        {%- if s.button_2 != blank -%}
          <a class="lm-btn lm-btn--line" href="{{ s.button_2_link | default: '#' }}"><span>{{ s.button_2 }}{% if s.button_2_note != blank %}<small>{{ s.button_2_note }}</small>{% endif %}</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>
        {%- endif -%}
      </div>
      {%- if s.trust_text != blank -%}
        <div class="lm-hero__proof">
          <span class="lm-hero__avs" aria-hidden="true">
            {%- assign avs = s.trust_initials | split: ',' -%}
            {%- for i in (1..3) -%}{%- assign ak = 'avatar_' | append: i -%}{%- assign letter = avs[forloop.index0] | strip | slice: 0 -%}{%- if s[ak] != blank -%}<i class="has-img">{{ s[ak] | image_url: width: 400, height: 400, crop: 'center' | image_tag: alt: '', loading: 'eager', width: 42, height: 42, widths: '120, 200, 300, 400', sizes: '42px' }}</i>{%- elsif letter != blank -%}<i>{{ letter }}</i>{%- endif -%}{%- endfor -%}
          </span>
          <span class="lm-hero__proof-t">
            <b>{{ s.trust_text }}</b>
            {%- if s.rating != blank -%}<span><i aria-hidden="true">★★★★★</i> ({{ s.rating }}/5)</span>{%- endif -%}
          </span>
        </div>
      {%- endif -%}
      {%- if s.privacy != blank -%}
        <p class="lm-hero__safe"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>{{ s.privacy }}</p>
      {%- endif -%}
    </div>
  </div>
  {%- if box == false and s.chip_1 != blank or box == false and s.chip_2 != blank -%}
    <ul class="lm-hero__chips" aria-hidden="true">
      {%- if s.chip_1 != blank -%}<li><i><svg viewBox="0 0 24 24"><path d="M12 3 4 6v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V6z"/><path d="m9 12 2 2 4-4"/></svg></i>{{ s.chip_1 }}</li>{%- endif -%}
      {%- if s.chip_2 != blank -%}<li><i><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M5 21a7 7 0 0 1 14 0"/></svg></i>{{ s.chip_2 }}</li>{%- endif -%}
    </ul>
  {%- endif -%}
</section>
{%- endif -%}

{% schema %}
{
  "name": "LM hero (PCOD)",
  "tag": "div",
  "settings": [
    {
      "type": "checkbox",
      "id": "glow",
      "label": "Soft glow behind the banner",
      "default": false
    },
    {
      "type": "color",
      "id": "glow_color",
      "label": "Glow colour",
      "default": "#fbdcd3"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "background",
      "options": [
        {
          "value": "background",
          "label": "Photo fills the banner"
        },
        {
          "value": "box",
          "label": "Photo in a box beside the text"
        },
        {
          "value": "card",
          "label": "Heading on top, photo + card below"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "Photo side (box layout)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background photo",
      "info": "Wide photo, people on the right. The left side fades for the text."
    },
    {
      "type": "textarea",
      "id": "ticks",
      "label": "Ticked points above the heading (card layout)",
      "info": "One per line, e.g. Diet / Exercise / Weight Loss Pills."
    },
    {
      "type": "color",
      "id": "tick_color",
      "label": "Tick colour",
      "default": "#2e9e5b"
    },
    {
      "type": "text",
      "id": "card_heading",
      "label": "Card heading (card layout)"
    },
    {
      "type": "textarea",
      "id": "card_text",
      "label": "Card line (card layout)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading start",
      "default": "Struggling to"
    },
    {
      "type": "text",
      "id": "highlight",
      "label": "Heading part with the highlighter",
      "default": "last longer"
    },
    {
      "type": "text",
      "id": "heading_end",
      "label": "Heading end",
      "default": "in bed?"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Line under the heading"
    },
    {
      "type": "text",
      "id": "sub_red",
      "label": "Words in red in that line",
      "info": "Type them exactly as they appear in the line, e.g. Irregular periods, Acne, Mood Swings"
    },
    {
      "type": "text",
      "id": "button_1",
      "label": "Button 1",
      "default": "Book an Appointment"
    },
    {
      "type": "text",
      "id": "button_1_note",
      "label": "Button 1 small line"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Button 1 link",
      "info": "Empty goes to the booking form."
    },
    {
      "type": "text",
      "id": "button_2",
      "label": "Button 2",
      "default": "Take the 360 Self-Assessment"
    },
    {
      "type": "text",
      "id": "button_2_note",
      "label": "Button 2 small line"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Button 2 link"
    },
    {
      "type": "text",
      "id": "trust_text",
      "label": "Trust line under the buttons",
      "default": "Trusted by 65,000+ men"
    },
    {
      "type": "text",
      "id": "rating",
      "label": "Star rating (out of 5)",
      "default": "4.5",
      "info": "Use the real Judge.me average."
    },
    {
      "type": "text",
      "id": "trust_initials",
      "label": "Initials in the circles (comma separated)",
      "default": "R, D, S"
    },
    {
      "type": "image_picker",
      "id": "avatar_1",
      "label": "Face photo 1",
      "info": "Square, at least 400 x 400 px, face centred. Empty = the first initial."
    },
    {
      "type": "image_picker",
      "id": "avatar_2",
      "label": "Face photo 2"
    },
    {
      "type": "image_picker",
      "id": "avatar_3",
      "label": "Face photo 3"
    },
    {
      "type": "text",
      "id": "privacy",
      "label": "Line under the buttons"
    },
    {
      "type": "product_list",
      "id": "review_products",
      "label": "Reviews in the card (card layout)",
      "limit": 8,
      "info": "Real Judge.me reviews (4 stars and up) of these products, one at a time. Empty hides them."
    },
    {
      "type": "text",
      "id": "chip_1",
      "label": "Photo chip 1"
    },
    {
      "type": "text",
      "id": "chip_2",
      "label": "Photo chip 2"
    },
    {
      "type": "header",
      "content": "Photo size"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between photo and text (box layout)",
      "min": 24,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "img_width",
      "label": "Photo width (desktop)",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "%",
      "default": 60,
      "info": "How much of the banner the photo covers, from the right."
    },
    {
      "type": "range",
      "id": "card_photo_height",
      "label": "Photo height (card layout, desktop)",
      "min": 280,
      "max": 640,
      "step": 10,
      "unit": "px",
      "default": 440
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Card width (card layout, desktop)",
      "min": 320,
      "max": 720,
      "step": 10,
      "unit": "px",
      "default": 600,
      "info": "Use Photo width above to give the card more or less room."
    },
    {
      "type": "checkbox",
      "id": "card_match_height",
      "label": "Card same height as the photo (card layout)",
      "default": true
    },
    {
      "type": "range",
      "id": "img_zoom",
      "label": "Photo zoom",
      "min": 100,
      "max": 160,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "img_focus",
      "label": "Photo focus, top to bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 25
    },
    {
      "type": "range",
      "id": "img_height_mobile",
      "label": "Photo height (phones)",
      "min": 200,
      "max": 480,
      "step": 10,
      "unit": "px",
      "default": 300
    }
  ],
  "presets": [
    {
      "name": "LM hero (PCOD)"
    }
  ]
}
{% endschema %}
