{%- assign s = section.settings -%}
{%- assign has_video = false -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'video' -%}
    {%- if block.settings.video != blank or block.settings.video_url != blank -%}{%- assign has_video = true -%}{%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- if request.design_mode or section.settings.show_empty -%}{%- assign has_video = true -%}{%- endif -%}

{%- assign split = false -%}{%- if s.layout == 'split' and has_video -%}{%- assign split = true -%}{%- endif -%}
<section id="reviews" class="lm-sec lm-sec--stone{% if split %} lm-stories--split{% endif %}" style="--lm-vn: {{ s.videos_per_row }};">
  <div class="lm-wrap">
    <div class="lm-stories__head">
      <div>
        <h2 class="lm-h2">{{ s.heading }}{% if s.highlight != blank %} <span class="lm-mark">{{ s.highlight }}</span>{% endif %}</h2>
        {%- if s.subheading != blank -%}<p class="lm-sub">{{ s.subheading }}</p>{%- endif -%}
      </div>
      {%- if has_video and split == false -%}
        <div class="lm-arrows">
          <button class="lm-arrow" type="button" data-dir="-1" aria-label="Previous videos"><svg viewBox="0 0 16 16"><path d="M10 3 5 8l5 5"/></svg></button>
          <button class="lm-arrow" type="button" data-dir="1" aria-label="More videos"><svg viewBox="0 0 16 16"><path d="m6 3 5 5-5 5"/></svg></button>
        </div>
      {%- endif -%}
    </div>

    {%- if split -%}<div class="lm-stories__grid"><div class="lm-stories__vcol">{%- endif -%}
    {%- if has_video -%}
      <div class="lm-vids">
        {%- for block in section.blocks -%}
          {%- if block.type == 'video' -%}
            {%- assign b = block.settings -%}
            <div class="lm-vid"{% if b.poster != blank %} data-poster="{{ b.poster | image_url: width: 720 }}"{% endif %} {{ block.shopify_attributes }}>
              {%- if b.video != blank -%}
                {{ b.video | video_tag: controls: true, preload: 'none', playsinline: true, image_size: '540x' }}
              {%- elsif b.video_url != blank -%}
                <video src="{{ b.video_url }}" controls preload="none" playsinline{% if b.poster != blank %} poster="{{ b.poster | image_url: width: 540 }}"{% endif %}></video>
              {%- else -%}
                <div class="lm-vid__empty">Add a customer video in the theme editor</div>
              {%- endif -%}
              {%- if b.quote != blank -%}
                <div class="lm-vid__cap"><b>"{{ b.quote }}"</b>{%- if b.length != blank -%}<span>{{ b.length }}</span>{%- endif -%}</div>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- if split -%}
        <input class="lm-vslider" type="range" min="0" max="1000" value="0" step="1" aria-label="Slide through the videos">
      {%- endif -%}
    {%- endif -%}
    {%- if split -%}</div><div class="lm-stories__rcol">{%- endif -%}

    {%- render 'sehat-jm-reviews', products: s.review_products, min: s.min_rating, max: s.max_reviews, uid: section.id -%}
    {%- if split -%}</div></div>{%- endif -%}
  </div>
</section>

{%- if has_video -%}
<script>
  (function () {
    var sec = document.currentScript.previousElementSibling;
    var row = sec.querySelector('.lm-vids');
    var calm = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
    function step(dir) {
      var card = row.querySelector('.lm-vid');
      row.scrollBy({ left: (card ? card.offsetWidth + 14 : 240) * dir, behavior: 'smooth' });
    }
    sec.querySelectorAll('.lm-arrow').forEach(function (b) {
      b.addEventListener('click', function () { step(Number(b.dataset.dir)); });
    });

    var bar = sec.querySelector('.lm-vslider');
    var dragging = false;
    function sync() {
      if (!bar || dragging) return;
      var max = row.scrollWidth - row.clientWidth;
      var v = max > 0 ? Math.round(row.scrollLeft / max * 1000) : 0;
      bar.value = v;
      bar.style.setProperty('--p', v / 10 + '%');
    }
    if (bar) {
      row.addEventListener('scroll', sync, { passive: true });
      window.addEventListener('resize', sync);
      bar.addEventListener('pointerdown', function () { dragging = true; row.style.scrollBehavior = 'auto'; });
      bar.addEventListener('input', function () {
        var max = row.scrollWidth - row.clientWidth;
        row.scrollLeft = bar.value / 1000 * max;
        bar.style.setProperty('--p', bar.value / 10 + '%');
      });
      ['pointerup', 'pointercancel', 'change'].forEach(function (ev) { bar.addEventListener(ev, function () { dragging = false; row.style.scrollBehavior = ''; }); });
      sync();
    }

    if (!sec.classList.contains('lm-stories--split') || calm) return;

    var seen = false, held = false;
    if ('IntersectionObserver' in window) new IntersectionObserver(function (e) { seen = e[0].isIntersecting; }, { threshold: .2 }).observe(sec);
    function playing() { return [].some.call(row.querySelectorAll('video'), function (v) { return !v.paused; }); }
    ['mouseenter', 'touchstart', 'focusin'].forEach(function (ev) { row.addEventListener(ev, function () { held = true; }, { passive: true }); });
    if (bar) bar.addEventListener('pointerdown', function () { held = true; setTimeout(function () { held = false; }, 6000); });
    ['mouseleave', 'focusout'].forEach(function (ev) { row.addEventListener(ev, function () { held = false; }); });
    row.addEventListener('touchend', function () { setTimeout(function () { held = false; }, 4000); }, { passive: true });
    setInterval(function () {
      if (!seen || held || dragging || document.hidden || playing()) return;
      if (row.scrollLeft + row.clientWidth >= row.scrollWidth - 4) row.scrollTo({ left: 0, behavior: 'smooth' });
      else step(1);
    }, {{ s.video_speed | default: 4 }}000);

    var list = sec.querySelector('.lm-stories__rcol .jmr__row');
    if (!list) return;
    function marquee() {
      var cards = [].slice.call(list.querySelectorAll('.jmr__card'));
      if (cards.length < 2 || list.classList.contains('is-mq')) return;
      cards.forEach(function (c) { var d = c.cloneNode(true); d.setAttribute('aria-hidden', 'true'); list.appendChild(d); });
      list.style.setProperty('--mq-dur', (cards.length * {{ s.review_speed | default: 6 }}) + 's');
      list.classList.add('is-mq');
    }
    if (list.querySelector('.jmr__card')) marquee();
    else new MutationObserver(function (m, o) { if (list.querySelector('.jmr__card')) { o.disconnect(); setTimeout(marquee, 50); } }).observe(list, { childList: true });
  })();
</script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/plyr/3.7.8/plyr.min.css">
<style>
  /* Standard player (Plyr): play/pause, progress, time, mute, fullscreen. Click anywhere on the video to play or pause. */
  /* Cards never grow past a phone-sized video, however wide the column gets (tablets stack the layout). */
  .lm-vid { max-width: 260px; }
  .lm-vid .plyr { height: 100%; border-radius: 20px; --plyr-color-main: #d81f48; --plyr-video-background: #2a2523; --plyr-font-family: var(--lm-font, inherit); }
  .lm-vid .plyr__video-wrapper { height: 100%; }
  .lm-vid .plyr video { height: 100%; object-fit: cover; }
  .lm-vid .plyr__poster { background-size: cover; }
  .lm-vid .plyr--video .plyr__controls { padding: 14px 10px 8px; }
  .lm-vid .plyr__control--overlaid { padding: 20px; }
  .lm-vid .plyr--video { cursor: pointer; }
</style>
<script src="https://cdnjs.cloudflare.com/ajax/libs/plyr/3.7.8/plyr.min.js"></script>
<script>
  (function () {
    function boot() {
      if (!window.Plyr) return;
      var players = [];
      [].forEach.call(document.querySelectorAll('.lm-vid video'), function (v) {
        v.preload = 'metadata';
        var cover = v.parentNode.dataset.poster;
        if (cover) v.setAttribute('poster', cover);
        var p = new Plyr(v, {
          controls: ['play-large', 'play', 'progress', 'current-time', 'mute', 'fullscreen'],
          clickToPlay: true, hideControls: true, resetOnEnd: true, tooltips: { controls: false, seek: true },
          keyboard: { focused: true, global: false }
        });
        if (cover) p.poster = cover;
        players.push(p);
        p.on('play', function () { players.forEach(function (o) { if (o !== p) o.pause(); }); });
      });
    }
    if (window.Plyr) boot(); else window.addEventListener('load', boot);
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "LM success stories (PCOD)",
  "tag": "div",
  "settings": [
    { "type": "range", "id": "video_speed", "label": "Videos: seconds per move (split layout)", "min": 2, "max": 10, "step": 1, "unit": "s", "default": 4 },
    { "type": "range", "id": "review_speed", "label": "Reviews: scroll speed (seconds per review)", "min": 3, "max": 12, "step": 1, "unit": "s", "default": 6 },
    { "type": "select", "id": "layout", "label": "Layout", "default": "stacked", "options": [{ "value": "stacked", "label": "Videos on top, reviews below" }, { "value": "split", "label": "Videos left, reviews right" }] },
    { "type": "checkbox", "id": "show_empty", "label": "Show empty video slots", "info": "Placeholder boxes until real videos are added.", "default": false },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Hear from the men who chose" },
    { "type": "text", "id": "highlight", "label": "Heading part with the highlighter", "default": "sehatUP" },
    { "type": "textarea", "id": "subheading", "label": "Line under the heading" },
    { "type": "header", "content": "Reviews (live from Judge.me)" },
    { "type": "product_list", "id": "review_products", "label": "Reviews from these products", "limit": 20, "info": "Only reviews of these products show, with the product photo." },
    { "type": "range", "id": "min_rating", "label": "Lowest star rating to show", "min": 1, "max": 5, "step": 1, "default": 4 },
    { "type": "range", "id": "max_reviews", "label": "Most reviews to show", "min": 4, "max": 30, "step": 1, "default": 18 },
    {"type":"header","content":"Sizes"},
    {"type":"range","id":"videos_per_row","label":"Videos visible per row (desktop)","min":3,"max":6,"step":1,"default":5,"info":"Fewer means bigger videos."}
  ],
  "blocks": [
    { "type": "video", "name": "Video story", "limit": 6, "settings": [
      { "type": "video", "id": "video", "label": "Video (vertical, 30 sec to 1 min)" },
      { "type": "url", "id": "video_url", "label": "Or an .mp4 link" },
      { "type": "image_picker", "id": "poster", "label": "Cover image (thumbnail)" },
      { "type": "text", "id": "quote", "label": "Short quote shown on the video" },
      { "type": "text", "id": "length", "label": "Length label", "info": "e.g. 0:52" }
    ] }
  ],
  "presets": [{ "name": "LM success stories (PCOD)" }]
}
{% endschema %}
