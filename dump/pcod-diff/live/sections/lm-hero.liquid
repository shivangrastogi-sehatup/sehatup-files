{%- liquid
  assign s = section.settings
  assign box = false
  if s.layout == 'box'
    assign box = true
  endif
-%}
{%- capture photo -%}
  <div class="lm-hero__bg">
    {%- if s.image != blank -%}
      {{ s.image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '700, 1000, 1400, 1800', sizes: '(max-width: 749px) 100vw, 60vw', alt: s.image.alt }}
    {%- endif -%}
  </div>
{%- endcapture -%}
<section class="lm-hero{% if s.glow %} lm-hero--glow{% endif %}{% if box %} lm-hero--box lm-hero--img-{{ s.image_side | default: 'left' }}{% endif %}" style="{% if s.glow %}--lm-glow: {{ s.glow_color }}; {% endif %}--lm-hw: {{ s.img_width }}%; --lm-hz: {{ s.img_zoom | divided_by: 100.0 }}; --lm-hy: {{ s.img_focus }}%; --lm-hm: {{ s.img_height_mobile }}px; --lm-hg: {{ s.gap }}px;">
  {%- unless box -%}{{ photo }}{%- endunless -%}
  <div class="lm-wrap lm-hero__in">
    {%- if box -%}{{ photo }}{%- endif -%}
    <div class="lm-hero__copy">
      <h1 class="lm-hero__h">{{ s.heading }}{% if s.highlight != blank %} <span class="lm-mark">{{ s.highlight }}</span>{% endif %}{% if s.heading_end != blank %} {{ s.heading_end }}{% endif %}</h1>
      {%- if s.subheading != blank -%}<p class="lm-hero__sub">{%- if s.sub_red != blank -%}{%- capture red -%}<span class="lm-mark">{{ s.sub_red }}</span>{%- endcapture -%}{{ s.subheading | replace_first: s.sub_red, red }}{%- else -%}{{ s.subheading }}{%- endif -%}</p>{%- endif -%}
      <div class="lm-hero__cta">
        {%- if s.button_1 != blank -%}
          <a class="lm-btn lm-btn--red" href="{{ s.button_1_link | default: '#book' }}"><span>{{ s.button_1 }}{% if s.button_1_note != blank %}<small>{{ s.button_1_note }}</small>{% endif %}</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>
        {%- endif -%}
        {%- if s.button_2 != blank -%}
          <a class="lm-btn lm-btn--line" href="{{ s.button_2_link | default: '#' }}"><span>{{ s.button_2 }}{% if s.button_2_note != blank %}<small>{{ s.button_2_note }}</small>{% endif %}</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>
        {%- endif -%}
      </div>
      {%- render 'trust-proof', s: s -%}
      {%- if s.privacy != blank -%}
        <p class="lm-hero__safe"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>{{ s.privacy }}</p>
      {%- endif -%}
    </div>
  </div>
  {%- if box == false and s.chip_1 != blank or box == false and s.chip_2 != blank -%}
    <ul class="lm-hero__chips" aria-hidden="true">
      {%- if s.chip_1 != blank -%}<li><i><svg viewBox="0 0 24 24"><path d="M12 3 4 6v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V6z"/><path d="m9 12 2 2 4-4"/></svg></i>{{ s.chip_1 }}</li>{%- endif -%}
      {%- if s.chip_2 != blank -%}<li><i><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M5 21a7 7 0 0 1 14 0"/></svg></i>{{ s.chip_2 }}</li>{%- endif -%}
    </ul>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "LM hero",
  "tag": "div",
  "settings": [
    { "type": "checkbox", "id": "glow", "label": "Soft glow behind the banner", "default": false },
    { "type": "color", "id": "glow_color", "label": "Glow colour", "default": "#fbdcd3" },
    { "type": "select", "id": "layout", "label": "Layout", "default": "background", "options": [{ "value": "background", "label": "Photo fills the banner" }, { "value": "box", "label": "Photo in a box beside the text" }] },
    { "type": "select", "id": "image_side", "label": "Photo side (box layout)", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }] },
    { "type": "image_picker", "id": "image", "label": "Background photo", "info": "Wide photo, people on the right. The left side fades for the text." },
    { "type": "text", "id": "heading", "label": "Heading start", "default": "Struggling to" },
    { "type": "text", "id": "highlight", "label": "Heading part with the highlighter", "default": "last longer" },
    { "type": "text", "id": "heading_end", "label": "Heading end", "default": "in bed?" },
    { "type": "textarea", "id": "subheading", "label": "Line under the heading" },
    { "type": "text", "id": "sub_red", "label": "Words in red in that line", "info": "Type them exactly as they appear in the line, e.g. Irregular periods, Acne, Mood Swings" },
    { "type": "text", "id": "button_1", "label": "Button 1", "default": "Book an Appointment" },
    { "type": "text", "id": "button_1_note", "label": "Button 1 small line" },
    { "type": "url", "id": "button_1_link", "label": "Button 1 link", "info": "Empty goes to the booking form." },
    { "type": "text", "id": "button_2", "label": "Button 2", "default": "Take the 360 Self-Assessment" },
    { "type": "text", "id": "button_2_note", "label": "Button 2 small line" },
    { "type": "url", "id": "button_2_link", "label": "Button 2 link" },
    { "type": "text", "id": "trust_text", "label": "Trust line under the buttons", "default": "Trusted by 65,000+ men" },
    { "type": "text", "id": "rating", "label": "Star rating (out of 5)", "default": "4.5", "info": "Use the real Judge.me average." },
    { "type": "range", "id": "trust_count", "label": "People in the photo row", "min": 0, "max": 5, "step": 1, "default": 3 },
    { "type": "text", "id": "trust_initials", "label": "Initials in the circles (comma separated)", "default": "R, D, S" },
    { "type": "image_picker", "id": "avatar_1", "label": "Face photo 1", "info": "Square, at least 400 x 400 px, face centred. Empty = the first initial." },
    { "type": "image_picker", "id": "avatar_2", "label": "Face photo 2" },
    { "type": "image_picker", "id": "avatar_3", "label": "Face photo 3" },
    { "type": "image_picker", "id": "avatar_4", "label": "Face photo 4" },
    { "type": "image_picker", "id": "avatar_5", "label": "Face photo 5" },
    { "type": "text", "id": "privacy", "label": "Line under the buttons" },
    { "type": "text", "id": "chip_1", "label": "Photo chip 1" },
    { "type": "text", "id": "chip_2", "label": "Photo chip 2" },
    {"type":"header","content":"Photo size"},
    {"type":"range","id":"gap","label":"Space between photo and text (box layout)","min":24,"max":200,"step":4,"unit":"px","default":72},
    {"type":"range","id":"img_width","label":"Photo width (desktop)","min":20,"max":80,"step":2,"unit":"%","default":60,"info":"How much of the banner the photo covers, from the right."},
    {"type":"range","id":"img_zoom","label":"Photo zoom","min":100,"max":160,"step":5,"unit":"%","default":100},
    {"type":"range","id":"img_focus","label":"Photo focus, top to bottom","min":0,"max":100,"step":5,"unit":"%","default":25},
    {"type":"range","id":"img_height_mobile","label":"Photo height (phones)","min":200,"max":480,"step":10,"unit":"px","default":300}
  ],
  "presets": [{ "name": "LM hero" }]
}
{% endschema %}
