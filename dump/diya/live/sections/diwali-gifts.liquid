{%- comment -%}
  Diwali gift finder: "Who are you gifting?" A candle-lit night: string lights across the top, real diyas
  glowing behind, a stack of mithai boxes and gifts, and products under little strings of lights.
  Each pill is a block with its own collection; cards add to the cart in place.
  Photos: Pexels (free licence, no credit needed), saved in assets as dw-*.webp.
{%- endcomment -%}
{%- assign sid = section.id -%}
<style>
  #dwg-{{ sid }} { position: relative; overflow: hidden; isolation: isolate; color: #fbeedd;
    background: radial-gradient(70% 60% at 78% 30%, #4a1512 0%, #22090d 55%, #14070a 100%); }
  #dwg-{{ sid }} .dwg__bg { position: absolute; top: 0; right: 0; z-index: -1; width: 64%; height: 760px; object-fit: cover; object-position: 30% 40%; opacity: .85;
    -webkit-mask-image: radial-gradient(70% 70% at 62% 42%, #000 35%, transparent 78%); mask-image: radial-gradient(70% 70% at 62% 42%, #000 35%, transparent 78%); }

  /* String lights across the top; the glow layer breathes (opacity only, its own layer) */
  #dwg-{{ sid }} .dwg__lights { position: relative; height: 80px; margin-bottom: -40px; }
  #dwg-{{ sid }} .dwg__lights svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  #dwg-{{ sid }} .dwg__glow { opacity: .85; }

  #dwg-{{ sid }} .dwg__in { position: relative; max-width: 1272px; margin: 0 auto; padding: 40px 24px 84px; zoom: var(--sz, 1); }
  #dwg-{{ sid }} .dwg__head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: 40px; }
  #dwg-{{ sid }} .dwg__k { margin: 0; font: italic 500 20px/1 var(--dw-serif, Georgia, serif); color: var(--dw-gold, #f2c46d); }
  #dwg-{{ sid }} .dwg__h { margin: 14px 0 0; max-width: 13ch; font: 500 clamp(36px, 4.2vw, 60px)/1.04 var(--dw-serif, Georgia, serif); color: #fff6e8; letter-spacing: -.01em; }
  #dwg-{{ sid }} .dwg__h em { font-style: italic; color: var(--dw-gold, #f2c46d); }
  #dwg-{{ sid }} .dwg__tabs { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 30px; }
  #dwg-{{ sid }} .dwg__tab { min-height: 46px; padding: 0 22px; border: 1.5px solid rgba(242, 196, 109, .45); border-radius: 999px; background: rgba(255, 240, 210, .06); color: #fbeedd; cursor: pointer;
    font: 700 15px/1 'Montserrat', sans-serif; transition: background .2s, color .2s, border-color .2s; }
  #dwg-{{ sid }} .dwg__tab:hover { border-color: var(--dw-gold, #f2c46d); }
  #dwg-{{ sid }} .dwg__tab[aria-selected="true"] { background: var(--dw-gold, #f2c46d); border-color: var(--dw-gold, #f2c46d); color: #2a0a10; box-shadow: 0 0 24px -4px rgba(242, 196, 109, .6); }

  /* The chosen person's products, set down like three framed photos on a table */
  #dwg-{{ sid }} .dwg__stack { position: relative; }
  #dwg-{{ sid }} .dwg__boxes { position: relative; height: 380px; }
  #dwg-{{ sid }} .dwg__boxes[hidden] { display: none; }
  #dwg-{{ sid }} .dwg__boxes:not([hidden]) .dwg__box { animation: dwg-drop .5s cubic-bezier(.2, .8, .3, 1) both; }
  #dwg-{{ sid }} .dwg__boxes:not([hidden]) .dwg__box--2 { animation-delay: .06s; }
  #dwg-{{ sid }} .dwg__boxes:not([hidden]) .dwg__box--3 { animation-delay: .12s; }
  @keyframes dwg-drop { from { opacity: 0; translate: 0 14px; } }
  #dwg-{{ sid }} .dwg__box { position: absolute; display: block; aspect-ratio: 1; border: 7px solid #fff8ec; border-radius: 16px; background: #fff; overflow: hidden;
    box-shadow: 0 24px 50px -18px rgba(0, 0, 0, .7), 0 0 60px -20px rgba(255, 170, 70, .45); transition: transform .35s cubic-bezier(.3, 1.4, .5, 1); }
  #dwg-{{ sid }} .dwg__box img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #dwg-{{ sid }} .dwg__box--1 { left: 2%; top: 46px; width: 38%; transform: rotate(-7deg); }
  #dwg-{{ sid }} .dwg__box--2 { left: 31%; top: 0; width: 40%; transform: rotate(3deg); z-index: 2; }
  #dwg-{{ sid }} .dwg__box--3 { right: 2%; top: 120px; width: 37%; transform: rotate(-4deg); z-index: 3; }
  #dwg-{{ sid }} .dwg__boxes:hover .dwg__box--1 { transform: rotate(-10deg) translate(-8px, -4px); }
  #dwg-{{ sid }} .dwg__boxes:hover .dwg__box--2 { transform: rotate(1deg) translateY(-8px); }
  #dwg-{{ sid }} .dwg__boxes:hover .dwg__box--3 { transform: rotate(-1deg) translate(8px, 4px); }

  #dwg-{{ sid }} .dwg__panel { margin-top: 16px; }
  #dwg-{{ sid }} .dwg__panel:not([hidden]) { animation: dwg-in .3s ease both; }
  @keyframes dwg-in { from { opacity: 0; } }
  #dwg-{{ sid }} .dwg__note { margin: 0 0 22px; max-width: 52ch; font: 500 16px/1.55 'Montserrat', sans-serif; color: rgba(251, 238, 221, .78); }
  #dwg-{{ sid }} .dwg__rail { position: relative; }
  #dwg-{{ sid }} .dwg__track { display: flex; gap: 22px; margin: 0 -8px; padding: 8px 8px 16px; list-style: none; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding: 0 8px; scroll-behavior: smooth; overscroll-behavior-x: contain; scrollbar-width: none; }
  #dwg-{{ sid }} .dwg__track::-webkit-scrollbar { display: none; }
  #dwg-{{ sid }} .dwg__track > .dwg__card { flex: 0 0 calc((100% - 3 * 22px) / 4.3); min-width: 0; scroll-snap-align: start; }
  #dwg-{{ sid }} .dwg__arrow { position: absolute; z-index: 3; top: 38%; width: 44px; height: 44px; margin: 0; padding: 0; display: grid; place-items: center; border: 1.5px solid var(--dw-gold, #f2c46d); border-radius: 50%;
    background: #2a0a10; color: var(--dw-gold, #f2c46d); cursor: pointer; box-shadow: 0 10px 24px -10px rgba(0, 0, 0, .7); transition: background-color .2s, color .2s, opacity .2s; }
  #dwg-{{ sid }} .dwg__arrow[hidden] { display: none; }
  #dwg-{{ sid }} .dwg__arrow:disabled { opacity: 0; pointer-events: none; }
  #dwg-{{ sid }} .dwg__arrow:hover { background: var(--dw-gold, #f2c46d); color: #2a0a10; }
  #dwg-{{ sid }} .dwg__arrow:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  #dwg-{{ sid }} .dwg__arrow--prev { left: -22px; }
  #dwg-{{ sid }} .dwg__arrow--next { right: -22px; }
  #dwg-{{ sid }} .dwg__card { position: relative; display: flex; flex-direction: column; border-radius: 18px; background: #fff; color: #1d1d1d;
    box-shadow: 0 22px 44px -26px rgba(0, 0, 0, .8); transition: transform .25s, box-shadow .25s; }
  #dwg-{{ sid }} .dwg__card:hover { transform: translateY(-4px); box-shadow: 0 26px 50px -24px rgba(0, 0, 0, .8), 0 0 40px -10px rgba(255, 190, 90, .55); }
  #dwg-{{ sid }} .dwg__media { display: block; aspect-ratio: 1; border-radius: 18px 18px 0 0; background: #f8efe2; overflow: hidden; }
  #dwg-{{ sid }} .dwg__media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s; }
  #dwg-{{ sid }} .dwg__card:hover .dwg__media img { transform: scale(1.04); }
  #dwg-{{ sid }} .dwg__body { display: flex; flex-direction: column; flex: 1; gap: 8px; padding: 16px 16px 18px; }
  #dwg-{{ sid }} .dwg__t { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; overflow: hidden; min-height: 2.6em; font: 700 16px/1.3 'Montserrat', sans-serif; color: #1d1d1d; text-decoration: none; }
  #dwg-{{ sid }} .dwg__price { display: flex; align-items: baseline; gap: 8px; margin: 0; font: 800 17px/1 'Montserrat', sans-serif; color: #1d1d1d; }
  #dwg-{{ sid }} .dwg__price s { font-weight: 500; font-size: 14px; color: #8a817b; }
  #dwg-{{ sid }} .dwg__add { display: flex; align-items: center; justify-content: center; min-height: 46px; margin-top: auto; border: 0; border-radius: 999px; background: #d81f48; color: #fff;
    font: 700 15px/1 'Montserrat', sans-serif; text-decoration: none; cursor: pointer; transition: background .2s; }
  #dwg-{{ sid }} .dwg__add:hover { background: #ee204a; }
  #dwg-{{ sid }} .dwg__add.is-done { background: #2a0a10; }
  /* View all: a clear gold outline button */
  #dwg-{{ sid }} .dwg__view { display: inline-flex; align-items: center; gap: 8px; min-height: 46px; margin-top: 18px; padding: 0 22px; border: 1.5px solid var(--dw-gold, #f2c46d); border-radius: 999px;
    color: var(--dw-gold, #f2c46d); text-decoration: none; font: 700 15px/1 'Montserrat', sans-serif; transition: background-color .2s, color .2s; }
  #dwg-{{ sid }} .dwg__view[hidden] { display: none; }
  #dwg-{{ sid }} .dwg__view:hover { background: var(--dw-gold, #f2c46d); color: #2a0a10; }
  #dwg-{{ sid }} .dwg__view--end { display: flex; width: max-content; margin: 30px auto 0; }
  #dwg-{{ sid }} .dwg__all { display: table; margin: 30px auto 0; font: 700 15px/1 'Montserrat', sans-serif; color: var(--dw-gold, #f2c46d); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 6px; }
  #dwg-{{ sid }} .dwg__empty { grid-column: 1 / -1; padding: 30px; text-align: center; color: rgba(251, 238, 221, .7); font: 500 14px/1.5 'Montserrat', sans-serif; }

  @media (max-width: 989.98px) {
    #dwg-{{ sid }} .dwg__track > .dwg__card { flex-basis: calc((100% - 2 * 22px) / 2.5); }
    #dwg-{{ sid }} .dwg__arrow--prev { left: -12px; }
    #dwg-{{ sid }} .dwg__arrow--next { right: -12px; }
  }
  @media (max-width: 749.98px) {
    #dwg-{{ sid }} .dwg__bg { width: 100%; height: 420px; opacity: .6; object-position: 40% 40%;
      -webkit-mask-image: linear-gradient(#000 40%, transparent); mask-image: linear-gradient(#000 40%, transparent); }
    #dwg-{{ sid }} .dwg__lights { height: 56px; margin-bottom: -28px; }
    #dwg-{{ sid }} .dwg__in { padding: 28px 0 52px; }
    #dwg-{{ sid }} .dwg__head { display: flex; flex-direction: column-reverse; gap: 22px; min-height: 0; text-align: center; }
    #dwg-{{ sid }} .dwg__text { padding: 0 16px; }
    #dwg-{{ sid }} .dwg__boxes { width: 100%; max-width: 360px; height: 220px; margin: 0 auto; }
    #dwg-{{ sid }} .dwg__box { border-width: 4px; border-radius: 12px; }
    #dwg-{{ sid }} .dwg__box--1 { left: 3%; top: 30px; width: 38%; }
    #dwg-{{ sid }} .dwg__box--2 { left: 31%; top: 0; width: 40%; }
    #dwg-{{ sid }} .dwg__box--3 { right: 3%; top: 64px; width: 37%; }
    #dwg-{{ sid }} .dwg__view { margin-top: 14px; }
    #dwg-{{ sid }} .dwg__view--end { margin-top: 18px; }
    #dwg-{{ sid }} .dwg__k { font-size: 17px; }
    #dwg-{{ sid }} .dwg__h { max-width: none; margin-top: 10px; font-size: 32px; }
    #dwg-{{ sid }} .dwg__tabs { flex-wrap: nowrap; justify-content: flex-start; overflow-x: auto; margin: 20px -16px 0; padding: 4px 16px 6px; scrollbar-width: none; }
    #dwg-{{ sid }} .dwg__tabs::-webkit-scrollbar { display: none; }
    #dwg-{{ sid }} .dwg__tab { flex: none; min-height: 42px; padding: 0 18px; font-size: 14px; }
    #dwg-{{ sid }} .dwg__tabs .dwg__tab:first-child { margin-left: auto; }
    #dwg-{{ sid }} .dwg__tabs .dwg__tab:last-child { margin-right: auto; }
    #dwg-{{ sid }} .dwg__panel { margin-top: 18px; }
    #dwg-{{ sid }} .dwg__note { margin: 0 16px 16px; font-size: 14.5px; text-align: center; }
    #dwg-{{ sid }} .dwg__track { gap: 14px; margin: 0; padding: 4px 16px 14px; scroll-padding: 0 16px; }
    #dwg-{{ sid }} .dwg__track > .dwg__card { flex-basis: 64%; }
    #dwg-{{ sid }} .dwg__arrow { display: none; }
    #dwg-{{ sid }} .dwg__card:hover { transform: none; }
    #dwg-{{ sid }} .dwg__body { padding: 12px 12px 14px; }
    #dwg-{{ sid }} .dwg__t { font-size: 14.5px; }
    #dwg-{{ sid }} .dwg__price { font-size: 16px; }
    #dwg-{{ sid }} .dwg__add { min-height: 42px; font-size: 14px; }
    #dwg-{{ sid }} .dwg__all { margin-top: 14px; }
  }
  @media (prefers-reduced-motion: reduce) { #dwg-{{ sid }} .dwg__panel { animation: none !important; } }

  /* Flow: heading, choices and the person's line centred over the diya glow; the products right under them */
  #dwg-{{ sid }} .dwg__head { display: block; min-height: 0; text-align: center; }
  #dwg-{{ sid }} .dwg__h { max-width: none; margin-left: auto; margin-right: auto; text-wrap: balance; }
  #dwg-{{ sid }} .dwg__tabs { justify-content: center; }
  #dwg-{{ sid }} .dwg__panel { margin-top: 22px; }
  #dwg-{{ sid }} .dwg__note { margin: 0 auto 26px; max-width: 46ch; text-align: center; font: italic 500 20px/1.4 var(--dw-serif, Georgia, serif); color: var(--dw-gold, #f2c46d); }
  #dwg-{{ sid }} .dwg__bg { left: 0; right: 0; width: 100%; height: 640px; object-position: 50% 45%; opacity: .5;
    -webkit-mask-image: radial-gradient(60% 75% at 50% 30%, #000 30%, transparent 80%); mask-image: radial-gradient(60% 75% at 50% 30%, #000 30%, transparent 80%); }
  #dwg-{{ sid }} .dwg__in { padding-top: 56px; }
  @media (max-width: 749.98px) {
    #dwg-{{ sid }} .dwg__in { padding-top: 34px; }
    #dwg-{{ sid }} .dwg__note { margin: 0 16px 12px; font-size: 16.5px; }
    #dwg-{{ sid }} .dwg__bg { height: 460px; }
  }
</style>
