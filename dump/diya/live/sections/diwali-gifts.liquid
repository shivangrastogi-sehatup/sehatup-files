="18.7" fill="url(#dwgT{{ sid }}G)"/><circle cx="1450" cy="26.4" r="18.7" fill="url(#dwgT{{ sid }}G)"/></svg></div>
  <div class="dwg__in">
    <div class="dwg__head">
      <div class="dwg__text">
        <p class="dwg__k">{{ section.settings.kicker }}</p>
        <h2 class="dwg__h">{{ section.settings.heading }}{% if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent }}</em>{% endif %}</h2>
        <div class="dwg__tabs" role="tablist" aria-label="{{ section.settings.heading | escape }}">
          {%- for block in section.blocks -%}
            <button type="button" class="dwg__tab" role="tab" id="dwg-t-{{ block.id }}" aria-controls="dwg-p-{{ block.id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" {% unless forloop.first %}tabindex="-1"{% endunless %} {{ block.shopify_attributes }}>{{ block.settings.label }}</button>
          {%- endfor -%}
        </div>
      </div>
    </div>

    {%- for block in section.blocks -%}
      <div class="dwg__panel" role="tabpanel" id="dwg-p-{{ block.id }}" aria-labelledby="dwg-t-{{ block.id }}" {% unless forloop.first %}hidden{% endunless %}>
        {%- if block.settings.note != blank -%}<p class="dwg__note">{{ block.settings.note }}</p>{%- endif -%}
        <div class="dwg__rail">
        <button type="button" class="dwg__arrow dwg__arrow--prev" aria-label="Previous products" hidden><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        <ul class="dwg__track">
          {%- assign c = block.settings.collection -%}
          {%- assign list = c.products -%}
          {%- assign cap = section.settings.limit -%}
          {%- if block.settings.products != blank -%}{%- assign list = block.settings.products -%}{%- assign cap = 50 -%}{%- endif -%}
          {%- for product in list limit: cap -%}
            {%- assign v = product.selected_or_first_available_variant -%}
            <li class="dwg__card">
              <a class="dwg__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
                {%- if product.featured_media -%}
                  {{ product.featured_media | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 450, 600, 900', sizes: '(max-width: 749px) 66vw, (max-width: 1679px) 280px, (max-width: 2559px) 420px, 640px', alt: product.title | escape }}
                {%- endif -%}
              </a>
              <div class="dwg__body">
                <a class="dwg__t" href="{{ product.url }}">{{ product.title }}</a>
                <p class="dwg__price">
                  <b>{{ product.price | money_without_trailing_zeros }}</b>
                  {%- if product.compare_at_price > product.price -%}<s>{{ product.compare_at_price | money_without_trailing_zeros }}</s>{%- endif -%}
                </p>
                {%- if product.has_only_default_variant and v.available -%}
                  <button type="button" class="dwg__add" data-variant="{{ v.id }}">{{ section.settings.add_label }}</button>
                {%- else -%}
                  <a class="dwg__add" href="{{ product.url }}">{{ section.settings.view_label }}</a>
                {%- endif -%}
              </div>
            </li>
          {%- else -%}
            <li class="dwg__empty">Choose products or a collection for "{{ block.settings.label }}" in the theme editor.</li>
          {%- endfor -%}
        </ul>
        <button type="button" class="dwg__arrow dwg__arrow--next" aria-label="More products" hidden><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        </div>
        {%- assign all_href = block.settings.all_link | default: c.url -%}
        {%- if all_href != blank and section.settings.all_label != blank -%}
          <a class="dwg__view dwg__view--end" href="{{ all_href }}">{{ section.settings.all_label }} <span aria-hidden="true">&rarr;</span></a>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>


<script>
  (function () {
    var root = document.getElementById('dwg-{{ sid }}');
    if (!root) return;
    var tabs = [].slice.call(root.querySelectorAll('.dwg__tab'));
    [].forEach.call(root.querySelectorAll('.dwg__rail'), function (rail) {
      var track = rail.querySelector('.dwg__track'), prev = rail.querySelector('.dwg__arrow--prev'), next = rail.querySelector('.dwg__arrow--next');
      function sync() {
        var more = track.scrollWidth > track.clientWidth + 4;
        prev.hidden = next.hidden = !more;
        prev.disabled = track.scrollLeft < 4;
        next.disabled = track.scrollLeft + track.clientWidth > track.scrollWidth - 4;
      }
      function step(dir) { var c = track.querySelector('.dwg__card'); track.scrollBy({ left: dir * (c ? c.offsetWidth + 22 : track.clientWidth * .8), behavior: 'smooth' }); }
      prev.addEventListener('click', function () { step(-1); });
      next.addEventListener('click', function () { step(1); });
      track.addEventListener('scroll', sync, { passive: true });
      addEventListener('resize', sync);
      if ('ResizeObserver' in window) new ResizeObserver(sync).observe(track);
      sync();
    });
    function pick(t, focus) {
      tabs.forEach(function (x) {
        var on = x === t;
        x.setAttribute('aria-selected', on); x.tabIndex = on ? 0 : -1;
        document.getElementById(x.getAttribute('aria-controls')).hidden = !on;
      });
      var id = t.getAttribute('aria-controls');
      root.querySelectorAll('[data-for]').forEach(function (el) { el.hidden = el.getAttribute('data-for') !== id; });
      if (focus) t.focus();
      var bar = t.parentNode;
      if (bar.scrollWidth > bar.clientWidth) bar.scrollTo({ left: t.offsetLeft - (bar.clientWidth - t.offsetWidth) / 2, behavior: 'smooth' });
    }
    tabs.forEach(function (t, i) {
      t.addEventListener('click', function () { pick(t); });
      t.addEventListener('keydown', function (e) {
        var d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (d) { e.preventDefault(); pick(tabs[(i + d + tabs.length) % tabs.length], true); }
      });
    });

    /* Add to cart in place, then refresh (and open) the cart drawer, like the product shelves */
    var base = window.Shopify && Shopify.routes ? Shopify.routes.root : '/';
    root.addEventListener('click', function (e) {
      var btn = e.target.closest('button.dwg__add[data-variant]');
      if (!btn || btn.disabled) return;
      var drawer = document.querySelector('cart-drawer'), label = btn.textContent;
      btn.disabled = true; btn.textContent = 'Adding...';
      fetch(base + 'cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ items: [{ id: +btn.dataset.variant, quantity: 1 }], sections: drawer ? 'cart-drawer,cart-icon-bubble' : 'cart-icon-bubble', sections_url: location.pathname }) })
        .then(function (r) { return r.json().then(function (d) { if (!r.ok) throw d; return d; }); })
        .then(function (d) {
          if (drawer && drawer.renderContents) { drawer.classList.remove('is-empty'); drawer.renderContents(d); }
          else if (d.sections && d.sections['cart-icon-bubble']) {
            var el = document.getElementById('cart-icon-bubble'), h = new DOMParser().parseFromString(d.sections['cart-icon-bubble'], 'text/html').querySelector('.shopify-section');
            if (el && h) el.innerHTML = h.innerHTML;
          }
          document.dispatchEvent(new CustomEvent('cart:updated', { detail: { source: 'diwali-gifts' } }));
          btn.textContent = 'Added'; btn.classList.add('is-done');
        }, function () { btn.textContent = 'Try again'; })
        .then(function () { setTimeout(function () { btn.disabled = false; btn.textContent = label; btn.classList.remove('is-done'); }, 2000); });
    });
  })();
</script>

{% schema %}
{
  "name": "Diwali: gift finder",
  "tag": "div",
  "class": "section-diwali-gifts",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small line", "default": "Diwali gifting" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Who are you gifting" },
    { "type": "text", "id": "heading_accent", "label": "Heading, gold italic part", "default": "good health to?" },
    { "type": "range", "id": "limit", "label": "Products per person (collection only)", "min": 2, "max": 48, "step": 1, "default": 4, "info": "Picked products ignore this and all show." },
    { "type": "text", "id": "add_label", "label": "Add button", "default": "Add to cart" },
    { "type": "text", "id": "view_label", "label": "Button for products with options", "default": "Choose" },
    { "type": "text", "id": "all_label", "label": "View all button", "default": "View all gifts" }
  ],
  "blocks": [
    {
      "type": "person", "name": "Person",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Mom and Dad" },
        { "type": "product_list", "id": "products", "label": "Products", "limit": 50, "info": "Pick and order the products; all of them show. Empty uses the collection below." },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "note", "label": "Line above the products" },
        { "type": "url", "id": "all_link", "label": "View all link", "info": "Empty goes to the collection." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Diwali: gift finder",
      "blocks": [
        { "type": "person", "settings": { "label": "Mom and Dad" } },
        { "type": "person", "settings": { "label": "Him" } },
        { "type": "person", "settings": { "label": "Her" } },
        { "type": "person", "settings": { "label": "Myself" } }
      ]
    }
  ]
}
{% endschema %}
