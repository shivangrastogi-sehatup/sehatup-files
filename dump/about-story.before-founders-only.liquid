{%- comment -%}
  About Us: why we started, then the founders.
  Story: one paragraph in a readable column that lights up word by word as
  you scroll (scroll-linked), the last sentence in brand red.
  Founders: one big portrait per founder next to their quote, alternating
  sides. Each founder simply fades in once, so the page stays calm.
  Without JS, or with reduced motion, everything is simply shown.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign words = s.story | strip | split: ' ' -%}
{%- assign end_words = s.story_end | strip | split: ' ' -%}
<style>
  #ast-{{ section.id }} {
    --ink: #1d1d1d; --mute: #5f5a56; --dim: #ddd3cb; --stone: #f6f0ec; --red: #d81f48;
    --ease: cubic-bezier(.22, 1, .36, 1);
    padding: clamp(56px, 6.5vw, 112px) clamp(16px, 4vw, 48px); background: #fff; color: var(--ink); font-family: 'Montserrat', sans-serif; overflow-x: clip;
  }
  #ast-{{ section.id }} * { box-sizing: border-box; }
  #ast-{{ section.id }} .ast__in { max-width: 1160px; margin: 0 auto; }

  /* Story */
  #ast-{{ section.id }} .ast__intro { max-width: 880px; margin: 0 auto; text-align: center; }
  #ast-{{ section.id }} .ast__h { margin: 0 0 22px; color: var(--red); font: 700 16px/1.2 'Montserrat', sans-serif; }
  #ast-{{ section.id }} .ast__story { margin: 0; font: 700 clamp(24px, 2.6vw, 36px)/1.38 'Montserrat', sans-serif; letter-spacing: -.015em; color: var(--ink); text-wrap: pretty; overflow-wrap: break-word; }
  #ast-{{ section.id }} .ast__story .e { color: var(--red); }
  #ast-{{ section.id }}.js .ast__story .w { color: var(--dim); transition: color .35s ease; }
  #ast-{{ section.id }}.js .ast__story .w.on { color: var(--ink); }
  #ast-{{ section.id }}.js .ast__story .e.on { color: var(--red); }
  #ast-{{ section.id }} .ast__more { margin: 26px auto 0; max-width: 38em; font: 500 16px/1.65 'Montserrat', sans-serif; color: var(--mute); text-wrap: pretty; }

  /* Founders */
  #ast-{{ section.id }} .ast__teamh { margin: clamp(72px, 9vw, 140px) 0 clamp(36px, 4.5vw, 64px); text-align: center; color: var(--ink); font: 800 clamp(28px, 3.2vw, 44px)/1.08 'Montserrat', sans-serif; letter-spacing: -.02em; text-wrap: balance; }
  #ast-{{ section.id }} .ast__f { display: grid; grid-template-columns: minmax(0, 360px) minmax(0, 560px); justify-content: center; gap: clamp(32px, 5vw, 80px); align-items: center; margin: 0; }
  #ast-{{ section.id }} .ast__f:nth-of-type(even) { grid-template-columns: minmax(0, 560px) minmax(0, 360px); }
  #ast-{{ section.id }} .ast__f + .ast__f { margin-top: clamp(56px, 7vw, 112px); }
  #ast-{{ section.id }} .ast__f:nth-of-type(even) .ast__frame { order: 2; }
  #ast-{{ section.id }} .ast__frame { position: relative; width: 100%; max-width: 360px; justify-self: center; aspect-ratio: 4 / 5; border-radius: 28px; overflow: hidden; background: var(--stone); }
  #ast-{{ section.id }} .ast__frame img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 12%; }
  #ast-{{ section.id }} .ast__frame .ast__ini { position: absolute; inset: 0; display: grid; place-items: center; font: 800 120px/1 'Montserrat', sans-serif; color: #fff; background: #e8e0d9; }
  #ast-{{ section.id }} .ast__role { margin: 0 0 10px; font: 700 15px/1.3 'Montserrat', sans-serif; color: var(--red); }
  #ast-{{ section.id }} .ast__name { margin: 0; color: var(--ink); font: 800 clamp(28px, 2.8vw, 40px)/1.05 'Montserrat', sans-serif; letter-spacing: -.025em; }
  #ast-{{ section.id }} blockquote { position: relative; border: 0; font-style: normal; margin: clamp(22px, 2.6vw, 36px) 0 0; padding-left: clamp(36px, 3.6vw, 52px); font: 600 clamp(19px, 1.7vw, 24px)/1.4 'Montserrat', sans-serif; color: var(--ink); text-wrap: pretty; }
  #ast-{{ section.id }} blockquote::before { content: "\201C"; position: absolute; left: 0; top: -.08em; font: 800 clamp(56px, 5vw, 80px)/1 Georgia, serif; color: var(--red); }
  #ast-{{ section.id }} .ast__about { margin: clamp(18px, 2vw, 26px) 0 0; padding-left: clamp(36px, 3.6vw, 52px); font: 500 16px/1.6 'Montserrat', sans-serif; color: var(--mute); }

  /* Entrance (only set when the script runs) */
  #ast-{{ section.id }}.js .ast__f { transition: opacity .7s ease, transform .8s var(--ease); }
  #ast-{{ section.id }}.js .ast__f:not(.in) { opacity: 0; transform: translateY(16px); }

  @media (max-width: 849.98px) {
    #ast-{{ section.id }} .ast__f, #ast-{{ section.id }} .ast__f:nth-of-type(even) { grid-template-columns: minmax(0, 1fr); gap: 26px; }
    #ast-{{ section.id }} .ast__f:nth-of-type(even) .ast__frame { order: 0; }
    #ast-{{ section.id }} .ast__frame { max-width: 340px; border-radius: 24px; }
    #ast-{{ section.id }} blockquote, #ast-{{ section.id }} .ast__about { padding-left: 34px; }
  }
  @media (min-width: 1680px) { #ast-{{ section.id }} .ast__in { zoom: 1.12; } }
  @media (min-width: 1920px) { #ast-{{ section.id }} .ast__in { zoom: 1.25; } }
  @media (min-width: 2560px) { #ast-{{ section.id }} .ast__in { zoom: 1.65; } }
  @media (min-width: 3200px) { #ast-{{ section.id }} .ast__in { zoom: 2; } }
</style>

<section id="ast-{{ section.id }}">
  <div class="ast__in">
    <div class="ast__intro">
      {%- if s.heading != blank -%}<h2 class="ast__h">{{ s.heading }}</h2>{%- endif -%}
      <p class="ast__story">
        {%- for w in words %}<span class="w">{{ w }}</span> {% endfor -%}
        {%- for w in end_words %}<span class="w e">{{ w }}</span> {% endfor -%}
      </p>
      {%- if s.more != blank -%}<p class="ast__more">{{ s.more }}</p>{%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      {%- if s.team_heading != blank -%}<h2 class="ast__teamh">{{ s.team_heading }}</h2>{%- endif -%}
      {%- for b in section.blocks -%}
        {%- assign f = b.settings -%}
        <figure class="ast__f" {{ b.shopify_attributes }}>
          <div class="ast__frame">
            {%- if f.photo != blank -%}
              {{ f.photo | image_url: width: 1200 | image_tag: alt: f.name, loading: 'lazy', widths: '480, 700, 900, 1200', sizes: '(min-width: 850px) 360px, 92vw' }}
            {%- else -%}
              <span class="ast__ini" aria-hidden="true">{{ f.name | slice: 0 }}</span>
            {%- endif -%}
          </div>
          <figcaption class="ast__txt">
            {%- if f.title != blank -%}<p class="ast__role">{{ f.title }}</p>{%- endif -%}
            <h3 class="ast__name">{{ f.name }}</h3>
            {%- if f.quote != blank -%}<blockquote>{{ f.quote }}</blockquote>{%- endif -%}
            {%- if f.about != blank -%}<p class="ast__about">{{ f.about }}</p>{%- endif -%}
          </figcaption>
        </figure>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('ast-{{ section.id }}');
    if (!root || matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
    var text = root.querySelector('.ast__story'), words = text.querySelectorAll('.w'), lit = -1;
    var ticking = false, live = 0;
    root.classList.add('js');

    // Story lights up from when the paragraph's top reaches 85% of the
    // screen until its bottom reaches 55%.
    function story(vh) {
      var r = text.getBoundingClientRect();
      var p = (vh * .85 - r.top) / (r.height + vh * .3);
      var n = Math.round(Math.min(1, Math.max(0, p)) * words.length) - 1;
      if (n === lit) return;
      for (var i = Math.min(n, lit) + 1; i <= Math.max(n, lit); i++) words[i].classList.toggle('on', i <= n);
      lit = n;
    }
    function update() { ticking = false; story(window.innerHeight); }
    function onScroll() { if (!ticking) { ticking = true; requestAnimationFrame(update); } }

    // Listen to scroll only while the section is on screen.
    new IntersectionObserver(function (es) {
      if (es[0].isIntersecting) { if (!live++) window.addEventListener('scroll', onScroll, { passive: true }); }
      else if (live) { live = 0; window.removeEventListener('scroll', onScroll); }
      update();
    }).observe(root);

    // Founders fade in once when a third of the row is on screen.
    var io = new IntersectionObserver(function (es) {
      es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { threshold: .3 });
    root.querySelectorAll('.ast__f').forEach(function (f) { io.observe(f); });
  })();
</script>

{% schema %}
{
  "name": "About: our story",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Small heading", "default": "Why we started sehatUP" },
    { "type": "textarea", "id": "story", "label": "Story (lights up as you scroll)", "default": "Google says one thing. A doctor says another. A wellness influencer says the opposite. Most people we met were not short of medicine. They were short of direction." },
    { "type": "textarea", "id": "story_end", "label": "Last sentence (in red)", "default": "So we built one clinic where the three systems finally work together." },
    { "type": "textarea", "id": "more", "label": "Smaller paragraph under it" },
    { "type": "text", "id": "team_heading", "label": "Heading above the founders", "default": "The people who started it" }
  ],
  "blocks": [
    {
      "type": "founder", "name": "Founder", "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "photo", "label": "Photo", "info": "Portrait, at least 1000px wide. Shown 4:5, face in the top third." },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "title", "label": "Title", "default": "Founder" },
        { "type": "text", "id": "about", "label": "One line about them" },
        { "type": "textarea", "id": "quote", "label": "Quote" }
      ]
    }
  ],
  "presets": [{ "name": "About: our story" }]
}
{% endschema %}
