{%- comment -%}
  Landing page hero: small label, headline (start / part in red / end), one
  line, red button, up to three trust points with an icon image each, and the
  photo on the right blending into the background. The top bar is its own
  section (lp-header).
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="lp-hero lp-sec--{{ s.tone }}">
  <div class="lp-hero__grid">
    <div class="lp-hero__copy">
      {%- if s.eyebrow != blank -%}<span class="lp-eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
      <h1 class="lp-hero__h">{{ s.heading }}{% if s.highlight != blank %} <span class="lp-hl">{{ s.highlight }}</span>{% endif %}{% if s.heading_end != blank %} {{ s.heading_end }}{% endif %}</h1>
      {%- if s.subheading != blank -%}<p class="lp-hero__sub">{{ s.subheading }}</p>{%- endif -%}
      {%- if s.button != blank -%}
        <a class="lp-hero__btn" href="#book">{{ s.button }}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>
      {%- endif -%}
      {%- if s.trust_1 != blank or s.trust_2 != blank or s.trust_3 != blank -%}
        <ul class="lp-hero__trust">
          {%- for i in (1..3) -%}
            {%- assign tk = 'trust_' | append: i -%}
            {%- assign ik = 'trust_' | append: i | append: '_icon' -%}
            {%- if s[tk] != blank -%}
              <li>
                <span class="lp-hero__ic">
                  {%- if s[ik] != blank -%}{{ s[ik] | image_url: width: 96 | image_tag: loading: 'eager', alt: '' }}{%- else -%}<span class="lp-hero__ic-ph" aria-hidden="true"></span>{%- endif -%}
                </span>
                <span>{{ s[tk] }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
    <div class="lp-hero__media">
      {%- if s.image != blank -%}
        {{ s.image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1400', sizes: '(max-width: 860px) 100vw, 55vw', alt: s.image.alt }}
      {%- else -%}
        <div class="lp-ph">Hero photo: pick one in the theme editor</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LP hero",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label above the heading" },
    { "type": "text", "id": "heading", "label": "Heading start", "default": "Why PCOD is happening to you" },
    { "type": "text", "id": "highlight", "label": "Heading part in red", "default": "again and again?" },
    { "type": "text", "id": "heading_end", "label": "Heading end (after the red part)" },
    { "type": "textarea", "id": "subheading", "label": "Line under the heading" },
    { "type": "text", "id": "button", "label": "Button (goes to the booking form)" },
    { "type": "header", "content": "Trust points" },
    { "type": "text", "id": "trust_1", "label": "Point 1" },
    { "type": "image_picker", "id": "trust_1_icon", "label": "Point 1 icon (square PNG)" },
    { "type": "text", "id": "trust_2", "label": "Point 2" },
    { "type": "image_picker", "id": "trust_2_icon", "label": "Point 2 icon (square PNG)" },
    { "type": "text", "id": "trust_3", "label": "Point 3" },
    { "type": "image_picker", "id": "trust_3_icon", "label": "Point 3 icon (square PNG)" },
    { "type": "header", "content": "Photo and background" },
    { "type": "image_picker", "id": "image", "label": "Photo", "info": "Landscape 5:4. The left edge fades into the background." },
    { "type": "select", "id": "tone", "label": "Background", "options": [
      { "value": "stone", "label": "Warm stone" }, { "value": "blush", "label": "Blush" }, { "value": "white", "label": "White" }
    ], "default": "stone" }
  ],
  "presets": [{ "name": "LP hero" }]
}
{% endschema %}
