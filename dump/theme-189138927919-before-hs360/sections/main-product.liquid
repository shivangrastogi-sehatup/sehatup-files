  <script>
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.sub-variant-selector .sub-card').forEach((card) => {
        card.onclick = function () {
          const variantId = this.dataset.variantId;

          // Remove active
          document.querySelectorAll('.sub-card').forEach((c) => c.classList.remove('sub-card-active'));
          this.classList.add('sub-card-active');

          // Update variant selector
          document.querySelectorAll('select[name="id"], input[name="id"]').forEach((select) => {
            select.value = variantId;
            select.dispatchEvent(new Event('change', { bubbles: true }));
          });

          // Radio buttons
          document.querySelectorAll(`input[type="radio"][value="${variantId}"]`).forEach((radio) => {
            radio.checked = true;
            radio.dispatchEvent(new Event('change', { bubbles: true }));
          });
        };
      });
    });
  </script>

