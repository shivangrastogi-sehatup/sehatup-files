{% doc %}
  @prompt
    Create a responsive text-focused informational section with multiple text blocks and hierarchical typography.Layout structure:- Clean, centered layout with light background- Main heading: "Getting healthy today feels like guesswork"- Subheading/description: "Google Says One Thing. A Doctor Says Another. A Wellness Influencer Says The Opposite. You're Left With Pills, Supplements, And Zero Clarity."- Secondary heading: "The Real Issue?"- Secondary description: "Healthcare Is Fragmented. Every System Works In Isolation. No One Treats The Whole Person"Content hierarchy:1. Main heading (large, bold, attention-grabbing)2. Main description (medium size, regular weight)3. Secondary heading (medium-large, bold)4. Secondary description (medium size, regular weight)Requirements:- Fully responsive layout:  * Desktop: centered content, max-width container (700-900px), generous padding  * Tablet: centered content, adjusted font sizes and padding  * Mobile: centered content, optimized font sizes, proper line spacing- Settings schema to customize:  * Section background color  * Section padding (top/bottom)  * Content max-width control  * Main heading text  * Main heading color and typography (size, weight, line height)  * Main description text (rich text support)  * Main description color and typography  * Secondary heading text  * Secondary heading color and typography  * Secondary description text (rich text support)  * Secondary description color and typography  * Text alignment: center, left, or right  * Spacing between elements (heading to description, between sections)  * Optional: Add more text blocks (repeatable blocks)  * Optional: Divider/separator between sections (line, spacing, or decorative element)  * Font family selection (if theme supports)  * Letter spacing controls  * Mobile-specific font size overrides- All text should be center-aligned by default with option to change- Proper vertical spacing between text elements- Responsive typography that scales appropriately on mobile- Support for rich text formatting (bold, italic, color highlights)- Optional decorative elements between sections- Accessible color contrast ratios- Clean, minimal design with focus on readability- Line height optimized for readability- Mobile: reduce font sizes proportionally, maintain hierarchy- Optional: fade-in animation on scroll- Optional: background pattern or subtle gradient
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-text-section-{{ ai_gen_id }} {
    display: block;
    background-color: {{ block.settings.section_bg_color }};
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
    width: 100%;
  }

  .ai-text-section-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-text-section-main-heading-{{ ai_gen_id }} {
    color: {{ block.settings.main_heading_color }};
    font-size: clamp(24px,3.4vw,64px);
    font-weight: {{ block.settings.main_heading_weight }};
    line-height: {{ block.settings.main_heading_line_height }};
    letter-spacing: {{ block.settings.main_heading_letter_spacing }}px;
    margin: 0 0 {{ block.settings.spacing_heading_to_description }}px;
  }

  .ai-text-section-main-description-{{ ai_gen_id }} {
    color: {{ block.settings.main_description_color }};
    font-size: clamp(10px, 1vw, 20px);
    font-weight: {{ block.settings.main_description_weight }};
    line-height: {{ block.settings.main_description_line_height }};
    letter-spacing: {{ block.settings.main_description_letter_spacing }}px;
    margin: 0 0 {{ block.settings.spacing_between_sections }}px;
  }

  .ai-text-section-main-description-{{ ai_gen_id }} p {
    margin: 0;
  }

  .ai-text-section-divider-{{ ai_gen_id }} {
    {% if block.settings.show_divider %}
      width: {{ block.settings.divider_width }}%;
      height: {{ block.settings.divider_thickness }}px;
      background-color: {{ block.settings.divider_color }};
      margin: {{ block.settings.spacing_between_sections }}px auto;
      border-radius: {{ block.settings.divider_radius }}px;
    {% else %}
      display: none;
    {% endif %}
  }

  .ai-text-section-secondary-heading-{{ ai_gen_id }} {
    color: {{ block.settings.secondary_heading_color }};
    font-size: clamp(14px, 2.4vw, 35px);
    font-weight: {{ block.settings.secondary_heading_weight }};
    line-height: {{ block.settings.secondary_heading_line_height }};
    letter-spacing: {{ block.settings.secondary_heading_letter_spacing }}px;
    margin: {{ block.settings.spacing_between_sections }}px 0 {{ block.settings.spacing_heading_to_description }}px;
  }

  .ai-text-section-secondary-description-{{ ai_gen_id }} {
    color: {{ block.settings.secondary_description_color }};
    font-size: clamp(10px, 1vw, 20px);
    font-weight: {{ block.settings.secondary_description_weight }};
    line-height: {{ block.settings.secondary_description_line_height }};
    letter-spacing: {{ block.settings.secondary_description_letter_spacing }}px;
    margin: 0;
  }

  .ai-text-section-secondary-description-{{ ai_gen_id }} p {
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-text-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.7 }}px 20px {{ block.settings.section_padding_bottom | times: 0.7 }}px;
    }

    .ai-text-section-main-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.main_heading_size_mobile }}px;
    }

    .ai-text-section-main-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.main_description_size_mobile }}px;
    }

    .ai-text-section-secondary-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.secondary_heading_size_mobile }}px;
    }

    .ai-text-section-secondary-description-{{ ai_gen_id }} {
      {% comment %} font-size: {{ block.settings.secondary_description_size_mobile }}px; {% endcomment %}
    }
  }

  @media screen and (max-width: 749px) {
    .ai-text-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.5 }}px 16px {{ block.settings.section_padding_bottom | times: 0.5 }}px;
    }
  }

  {% if block.settings.enable_scroll_animation %}
    @media (prefers-reduced-motion: no-preference) {
      .ai-text-section-container-{{ ai_gen_id }} {
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.8s ease, transform 0.8s ease;
      }

      .ai-text-section-container-{{ ai_gen_id }}.ai-text-section-visible-{{ ai_gen_id }} {
        opacity: 1;
        transform: translateY(0);
      }
    }
  {% endif %}
{% endstyle %}

<text-section-{{ ai_gen_id }} class="ai-text-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-text-section-container-{{ ai_gen_id }}">
    {% if block.settings.main_heading != blank %}
      <h2 class="ai-text-section-main-heading-{{ ai_gen_id }}">
        {{ block.settings.main_heading }}
      </h2>
    {% endif %}

    {% if block.settings.main_description != blank %}
      <div class="ai-text-section-main-description-{{ ai_gen_id }}">
        {{ block.settings.main_description }}
      </div>
    {% endif %}

    {% if block.settings.show_divider %}
      <div class="ai-text-section-divider-{{ ai_gen_id }}"></div>
    {% endif %}

    {% if block.settings.secondary_heading != blank %}
      <h3 class="ai-text-section-secondary-heading-{{ ai_gen_id }}">
        {{ block.settings.secondary_heading }}
      </h3>
    {% endif %}

    {% if block.settings.secondary_description != blank %}
      <div class="ai-text-section-secondary-description-{{ ai_gen_id }}">
        {{ block.settings.secondary_description }}
      </div>
    {% endif %}
  </div>
</text-section-{{ ai_gen_id }}>

{% if block.settings.enable_scroll_animation %}
  <script>
    (function() {
      class TextSection{{ ai_gen_id }} extends HTMLElement {
        constructor() {
          super();
        }

        connectedCallback() {
          this.container = this.querySelector('.ai-text-section-container-{{ ai_gen_id }}');
          this.setupScrollAnimation();
        }

        setupScrollAnimation() {
          if (!this.container) return;

          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                this.container.classList.add('ai-text-section-visible-{{ ai_gen_id }}');
                observer.unobserve(entry.target);
              }
            });
          }, {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
          });

          observer.observe(this.container);
        }
      }

      customElements.define('text-section-{{ ai_gen_id }}', TextSection{{ ai_gen_id }});
    })();
  </script>
{% endif %}

