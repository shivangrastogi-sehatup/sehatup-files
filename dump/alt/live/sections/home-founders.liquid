{%- comment -%}
  Home: why we built sehatUP. Story and the founders on the left, a video on
  the right. The video is a thumbnail until clicked (YouTube loads only
  then). Smaller thumbnails underneath play their video in the big frame.
  Blocks: founder (photo, name, title) and video (YouTube link, title).
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign videos = section.blocks | where: 'type', 'video' -%}
{%- assign founders = section.blocks | where: 'type', 'founder' -%}
<style>
  #hfd-{{ section.id }} {
    --ink: #1d1d1d; --mute: #5f5a56; --line: #e8e0d9; --btn: #d81f48;
    padding: clamp(40px, 4.5vw, 72px) clamp(16px, 4vw, 24px); background: {{ s.section_bg | default: '#ffffff' }}; color: var(--ink); font-family: 'Montserrat', sans-serif;
  }
  #hfd-{{ section.id }} .hfd__in { max-width: 1272px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 3fr); gap: clamp(32px, 5vw, 72px); align-items: center; }
  /* Heading centred across both columns; under it the story, the founders and
     the link on the left, the video on the right, centred against each other. */
  #hfd-{{ section.id }} .hfd__txt { display: flex; flex-direction: column; }
  /* The theme's wide letter-spacing makes the text look thin and spaced out. */
  #hfd-{{ section.id }} * { letter-spacing: normal; }
  /* Less air above the heading: the stats band above already ends with its own space. */
  #hfd-{{ section.id }} { padding-top: clamp(28px, 3vw, 48px); padding-bottom: clamp(28px, 3vw, 40px); }
  #hfd-{{ section.id }} .hfd__h { grid-column: 1 / -1; margin: 0 0 calc(clamp(28px, 3.5vw, 48px) - clamp(32px, 5vw, 72px)); text-align: center; font: 800 clamp(30px, 3.6vw, 52px)/1.06 'Montserrat', sans-serif; letter-spacing: -.02em; color: var(--ink); text-wrap: balance; }
  #hfd-{{ section.id }} .hfd__story p { margin: 0 0 14px; font: 400 17px/1.65 'Montserrat', sans-serif; color: var(--mute); text-wrap: pretty; }
  #hfd-{{ section.id }} .hfd__story { margin-bottom: 24px; }
  #hfd-{{ section.id }} .hfd__story p:last-child { margin: 0; }
  #hfd-{{ section.id }} .hfd__story p:last-child:not(:first-child) { color: var(--ink); font-weight: 600; }
  #hfd-{{ section.id }} .hfd__people { display: flex; flex-wrap: wrap; gap: 16px 28px; margin: 0; padding: 22px 0 0; border-top: 1px solid var(--line); list-style: none; }
  #hfd-{{ section.id }} .hfd__people li { display: flex; align-items: center; gap: 12px; }
  #hfd-{{ section.id }} .hfd__people img, #hfd-{{ section.id }} .hfd__people i { flex: none; width: 60px; height: 60px; border-radius: 50%; object-fit: cover; object-position: center 20%; background: #f6f0ec; }
  #hfd-{{ section.id }} .hfd__people b { display: block; font: 700 16px/1.3 'Montserrat', sans-serif; }
  #hfd-{{ section.id }} .hfd__people span { display: block; font: 500 13.5px/1.3 'Montserrat', sans-serif; color: var(--mute); }
  #hfd-{{ section.id }} .hfd__more { align-self: flex-start; margin: 26px 0 0; padding-bottom: 4px; border-bottom: 2px solid var(--line); font: 700 16px/1.3 'Montserrat', sans-serif; color: var(--ink); text-decoration: none; transition: border-color .2s; }
  @media (hover: hover) { #hfd-{{ section.id }} .hfd__more:hover { border-color: var(--btn); } }

  #hfd-{{ section.id }} .hfd__player { position: relative; aspect-ratio: 16 / 9; border-radius: 24px; overflow: hidden; background: #1d1d1d; }
  #hfd-{{ section.id }} .hfd__player iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  #hfd-{{ section.id }} .hfd__play { position: absolute; inset: 0; width: 100%; padding: 0; border: 0; background: none; cursor: pointer; }
  #hfd-{{ section.id }} .hfd__play img { width: 100%; height: 100%; object-fit: cover; transition: transform .8s cubic-bezier(.22, 1, .36, 1); }
  #hfd-{{ section.id }} .hfd__play i { position: absolute; left: 50%; top: 50%; width: 76px; height: 76px; margin: -38px 0 0 -38px; border-radius: 50%; display: grid; place-items: center; background: var(--btn); color: #fff; box-shadow: 0 10px 30px rgba(0, 0, 0, .25); transition: transform .3s ease; }
  #hfd-{{ section.id }} .hfd__play i svg { width: 26px; height: 26px; margin-left: 4px; fill: currentColor; }
  @media (hover: hover) {
    #hfd-{{ section.id }} .hfd__play:hover img { transform: scale(1.03); }
    #hfd-{{ section.id }} .hfd__play:hover i { transform: scale(1.08); }
  }
  #hfd-{{ section.id }} .hfd__play:focus-visible { outline: 3px solid var(--btn); outline-offset: -3px; }
  /* The video's title: a small red play mark and the title, and it plays the video too. */
  #hfd-{{ section.id }} .hfd__cap { display: flex; align-items: center; gap: 12px; margin: 18px 0 0; font: 700 17px/1.3 'Montserrat', sans-serif; color: var(--ink); cursor: pointer; }
  #hfd-{{ section.id }} .hfd__cap small { display: block; margin-top: 2px; font: 500 13.5px/1.3 'Montserrat', sans-serif; color: var(--mute); }
  #hfd-{{ section.id }} .hfd__list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin: 16px 0 0; padding: 0; list-style: none; }
  #hfd-{{ section.id }} .hfd__t { display: grid; gap: 8px; width: 100%; padding: 0; border: 0; background: none; text-align: left; cursor: pointer; font: 500 13px/1.35 'Montserrat', sans-serif; color: var(--mute); }
  #hfd-{{ section.id }} .hfd__t img { width: 100%; height: auto; aspect-ratio: 3 / 4; object-fit: cover; border-radius: 12px; outline: 2px solid transparent; outline-offset: 2px; transition: outline-color .2s; }
  #hfd-{{ section.id }} .hfd__t[aria-current="true"] { color: var(--ink); font-weight: 700; }
  #hfd-{{ section.id }} .hfd__t[aria-current="true"] img { outline-color: var(--btn); }
  #hfd-{{ section.id }} .hfd__t:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; border-radius: 12px; }

  @media (min-width: 900px) { #hfd-{{ section.id }} .hfd__h { white-space: nowrap; } }
  @media (max-width: 899.98px) {
    #hfd-{{ section.id }} .hfd__in { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    #hfd-{{ section.id }} .hfd__h { margin-bottom: 0; }
  }
  @media (max-width: 749.98px) {
    #hfd-{{ section.id }} .hfd__h { font-size: 30px; }
    #hfd-{{ section.id }} .hfd__story p { font-size: 15px; }
    #hfd-{{ section.id }} .hfd__player { border-radius: 18px; }
    #hfd-{{ section.id }} .hfd__play i { width: 60px; height: 60px; margin: -30px 0 0 -30px; }
    #hfd-{{ section.id }} .hfd__list { gap: 8px; }
    #hfd-{{ section.id }} .hfd__t { font-size: 11.5px; }
  }
  @media (min-width: 1680px) { #hfd-{{ section.id }} .hfd__in { zoom: 1.12; } }
  @media (min-width: 1920px) { #hfd-{{ section.id }} .hfd__in { zoom: 1.25; max-width: 1312px; } }
  @media (min-width: 2240px) { #hfd-{{ section.id }} .hfd__in { zoom: 1.45; } }
  @media (min-width: 2560px) { #hfd-{{ section.id }} .hfd__in { zoom: 1.65; max-width: 1392px; } }
  @media (min-width: 3200px) { #hfd-{{ section.id }} .hfd__in { zoom: 2; } }
  @media (min-width: 3840px) { #hfd-{{ section.id }} .hfd__in { zoom: 2.4; } }
</style>

<section id="hfd-{{ section.id }}">
  <div class="hfd__in">
    <h2 class="hfd__h">{{ s.heading }}</h2>
    <div class="hfd__txt">
      <div class="hfd__story">{{ s.story }}</div>
      {%- if founders.size > 0 -%}
        <ul class="hfd__people">
          {%- for block in founders -%}
            <li {{ block.shopify_attributes }}>
              {%- comment -%} Plain img: image_tag with width 60 adds a 60w-only srcset, so the photo loaded at 60px and looked blurry on retina/zoomed screens. {%- endcomment -%}
              {%- if block.settings.photo != blank -%}<img src="{{ block.settings.photo | image_url: width: 360 }}" alt="" width="60" height="60" loading="lazy">{%- else -%}<i></i>{%- endif -%}
              <span><b>{{ block.settings.name }}</b><span>{{ block.settings.title }}</span></span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if s.more_label != blank -%}<a class="hfd__more" href="{{ s.more_link | default: '#' }}">{{ s.more_label }} &rarr;</a>{%- endif -%}
    </div>

    {%- if videos.size > 0 -%}
      {%- assign v0 = videos.first.settings -%}
      <div>
        <div class="hfd__player">
          <button class="hfd__play" type="button" data-id="{{ v0.video.id }}" aria-label="{{ s.play_label | escape }}: {{ v0.title | escape }}">
            <img src="https://i.ytimg.com/vi/{{ v0.video.id }}/maxresdefault.jpg" alt="" loading="lazy" width="1280" height="720">
            <i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 4.5v15l12-7.5z"/></svg></i>
          </button>
        </div>
        <p class="hfd__cap"><span>{{ v0.title }}{% if s.video_note != blank %}<small>{{ s.video_note }}</small>{% endif %}</span></p>
        {%- if videos.size > 1 and s.show_more_videos -%}
          <ul class="hfd__list">
            {%- for block in videos -%}
              <li {{ block.shopify_attributes }}>
                <button class="hfd__t" type="button" data-id="{{ block.settings.video.id }}" data-title="{{ block.settings.title | escape }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
                  <img src="https://i.ytimg.com/vi/{{ block.settings.video.id }}/mqdefault.jpg" alt="" loading="lazy" width="320" height="180">
                  <span>{{ block.settings.title }}</span>
                </button>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('hfd-{{ section.id }}');
    if (!root) return;
    var player = root.querySelector('.hfd__player'), cap = root.querySelector('.hfd__cap');
    if (!player) return;
    function play(id) {
      player.innerHTML = '<iframe src="https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0&playsinline=1" title="' + cap.textContent.replace(/"/g, '&quot;') + '" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>';
    }
    cap.addEventListener('click', function () { var b = root.querySelector('.hfd__play'); if (b) play(b.getAttribute('data-id')); });
    player.addEventListener('click', function (e) {
      var b = e.target.closest('.hfd__play');
      if (b) play(b.getAttribute('data-id'));
    });
    root.querySelectorAll('.hfd__t').forEach(function (t) {
      t.addEventListener('click', function () {
        root.querySelectorAll('.hfd__t').forEach(function (o) { o.setAttribute('aria-current', o === t ? 'true' : 'false'); });
        cap.textContent = t.getAttribute('data-title');
        play(t.getAttribute('data-id'));
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Home: founders",
  "tag": "div",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why we built sehatUP" },
    { "type": "richtext", "id": "story", "label": "Story", "info": "With two or more paragraphs, the last one is shown darker." },
    { "type": "text", "id": "more_label", "label": "Link", "default": "Read our story" },
    { "type": "url", "id": "more_link", "label": "Link to" },
    { "type": "checkbox", "id": "show_more_videos", "label": "Show the other videos as thumbnails", "default": false, "info": "Off: only the first video is shown." },
    { "type": "text", "id": "video_note", "label": "Line under the video title", "default": "Watch our founders on why we built sehatUP" },
    { "type": "text", "id": "play_label", "label": "Play button label (screen readers)", "default": "Play video" },
    { "type": "color", "id": "section_bg", "label": "Background", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "founder",
      "name": "Founder",
      "settings": [
        { "type": "image_picker", "id": "photo", "label": "Photo" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "title", "label": "Title" }
      ]
    },
    {
      "type": "video",
      "name": "Video",
      "settings": [
        { "type": "video_url", "id": "video", "label": "YouTube link", "accept": ["youtube"] },
        { "type": "text", "id": "title", "label": "Title" }
      ]
    }
  ],
  "presets": [{ "name": "Home: founders" }]
}
{% endschema %}
