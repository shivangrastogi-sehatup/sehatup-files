{%- comment -%}
  Health journey: "What happens after you start".

  The second act of the Health Score story, deliberately NOT another pinned
  scroll-jacking section (the scroll story right above already is one).
  The page scrolls normally: four steps are ordinary text blocks, and on
  desktop a phone (built in HTML) stays in view beside them. When a step
  reaches the middle of the screen it lights up and the phone plays it:
    Today       the quiz, score fills to 72
    24 hours    a doctor calls, 3 systems review the score
    Day 3 to 5  delivery tracking, a plain box arrives (Cash on Delivery)
    Every month WhatsApp check-in, score climbs 72 -> 84
  A Health Score card travels beside the phone through all four steps.
  On phones nothing is sticky: each step is its text followed by its own
  phone screen, which plays when it scrolls into view.

  No libraries: the browser's IntersectionObserver picks the active step and
  its Web Animations API plays the phone screens, so the page keeps normal
  scrolling. Without JS, or with reduced motion, the steps render as a plain list.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
-%}

{%- comment -%} Styles first, so the browser never paints this section unstyled. {%- endcomment -%}
<style>
  #hj-{{ section.id }} {
    --hj-text: #1d1d1d;
    --hj-muted: #5c5c5c;
    --hj-bg: #faf7f5;
    --hj-rose: #fde2e7;
    --hj-teal: #d9f0ee;
    --ph: min(600px, 72vh);
    background: var(--hj-bg);
    overflow-x: clip; /* the box beside the phone stuck out 3px and made the page scroll sideways */
    font-family: 'Montserrat', sans-serif;
    color: var(--hj-text);
  }

  /* ---- Static layout (no JS / reduced motion): a plain list ---------- */
  #hj-{{ section.id }} .hj__inner {
    max-width: 1320px;
    margin: 0 auto;
    padding: 72px 24px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 48px;
    align-items: center;
  }
  #hj-{{ section.id }} .hj__eyebrow {
    margin: 0 0 18px;
    font: 700 12px/1 'Montserrat', sans-serif;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--hj-ink);
  }
  #hj-{{ section.id }} .hj__heading { color: var(--hj-text); margin: 0 0 36px; font: 800 clamp(30px, 3.6vw, 52px)/1.05 'Montserrat', sans-serif; letter-spacing: -.02em; max-width: 520px; }
  #hj-{{ section.id }} .hj__n { display: block; margin-bottom: 10px; font: 300 44px/1 'Montserrat', sans-serif; color: var(--hj-ink); }
  #hj-{{ section.id }} .hj__slot { display: none; }
  #hj-{{ section.id }} .hj__steps { display: grid; gap: 28px; }
  #hj-{{ section.id }} .hj__day { margin: 0 0 6px; font: 700 13px/1.2 'Montserrat', sans-serif; color: var(--hj-ink); }
  #hj-{{ section.id }} .hj__title { margin: 0 0 8px; font: 700 clamp(24px, 2.6vw, 38px)/1.1 'Montserrat', sans-serif; letter-spacing: -.01em; }
  #hj-{{ section.id }} .hj__text { margin: 0; max-width: 420px; font: 400 16px/1.55 'Montserrat', sans-serif; color: var(--hj-muted); }
  #hj-{{ section.id }} .hj__chip,
  #hj-{{ section.id }} .hj__box { display: none; }

  /* ---- The phone (all sizes in em, so it scales from one number) ------ */
  #hj-{{ section.id }} .hj__visual { position: relative; }
  #hj-{{ section.id }} .hj__phone {
    position: relative;
    height: var(--ph);
    width: calc(var(--ph) * .49);
    font-size: calc(var(--ph) / 38);
    border-radius: 2.6em;
    background: #111;
    padding: .55em;
    box-sizing: border-box;
    box-shadow: 0 2.4em 4em rgba(29, 29, 29, .18), 0 .4em 1em rgba(29, 29, 29, .12);
  }
  #hj-{{ section.id }} .hj__notch {
    position: absolute; z-index: 3; top: 1.05em; left: 50%;
    width: 5.2em; height: 1.35em; margin-left: -2.6em;
    border-radius: 1em; background: #111;
  }
  #hj-{{ section.id }} .hj__screen {
    position: relative; height: 100%;
    border-radius: 2.1em; overflow: hidden;
    background: #fff;
  }
  #hj-{{ section.id }} .hj__scr {
    position: absolute; inset: 0;
    padding: 3.6em 1.3em 1.4em;
    display: flex; flex-direction: column; gap: .8em;
    box-sizing: border-box;
  }
  #hj-{{ section.id }} .hj__scr:not([data-scr="1"]) { visibility: hidden; opacity: 0; }

  /* 1. Quiz */
  #hj-{{ section.id }} .hj__quiz-top { display: flex; align-items: center; gap: .7em; font: 600 .75em/1 'Montserrat', sans-serif; color: #6b6b6b; }
  #hj-{{ section.id }} .hj__quiz-bar { flex: 1; height: .35em; border-radius: 1em; background: #eee; overflow: hidden; }
  #hj-{{ section.id }} .hj__quiz-bar i { display: block; width: 50%; height: 100%; background: var(--hj-accent); }
  #hj-{{ section.id }} .hj__quiz-q { margin: .6em 0 .4em; font: 700 1.45em/1.2 'Montserrat', sans-serif; }
  #hj-{{ section.id }} .hj__opt {
    padding: .9em 1em; border-radius: .8em; border: 1px solid #eee;
    font: 500 .95em/1 'Montserrat', sans-serif; color: #333;
  }
  #hj-{{ section.id }} .hj__opt--pick { transition: none; }
  #hj-{{ section.id }} .hj__result {
    margin-top: auto; padding: 1em; border-radius: 1em; background: #f6f3f1;
    display: grid; gap: .35em;
  }
  #hj-{{ section.id }} .hj__result-label { font: 600 .8em/1 'Montserrat', sans-serif; color: #6b6b6b; }
  #hj-{{ section.id }} .hj__num { font: 700 2.4em/1 'Montserrat', sans-serif; }
  #hj-{{ section.id }} .hj__meter { height: .55em; border-radius: 1em; background: #eaeaea; overflow: hidden; }
  #hj-{{ section.id }} .hj__meter i { display: block; width: 0; height: 100%; border-radius: inherit; background: var(--hj-accent); }

  /* 2. Call */
  #hj-{{ section.id }} .hj__scr--call { background: #2b2b2b; color: #fff; padding: 0; }
  #hj-{{ section.id }} .hj__call-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center top; }
  #hj-{{ section.id }} .hj__call-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,.45) 0%, rgba(0,0,0,0) 26%, rgba(0,0,0,0) 48%, rgba(0,0,0,.78) 100%); }
  #hj-{{ section.id }} .hj__call-top { position: relative; padding: 3.4em 1.3em 0; display: grid; gap: .3em; text-align: center; }
  #hj-{{ section.id }} .hj__call-top b { font: 700 1.15em/1.2 'Montserrat', sans-serif; }
  #hj-{{ section.id }} .hj__call-top span { font: 500 .8em/1 'Montserrat', sans-serif; opacity: .85; }
  #hj-{{ section.id }} .hj__call-panel { position: relative; margin-top: auto; padding: 1.2em 1.1em 1.4em; display: grid; gap: .9em; text-align: center; }
  #hj-{{ section.id }} .hj__call-panel p { margin: 0; font: 600 .85em/1.3 'Montserrat', sans-serif; }
  #hj-{{ section.id }} .hj__faces { display: flex; justify-content: center; gap: .8em; }
  #hj-{{ section.id }} .hj__face { display: grid; justify-items: center; gap: .3em; }
  #hj-{{ section.id }} .hj__face img,
  #hj-{{ section.id }} .hj__face em {
    width: 3.2em; height: 3.2em; border-radius: 50%; object-fit: cover; object-position: center top;
    border: 2px solid #fff; background: #d9d2cb;
    display: grid; place-items: center; font: 700 1.1em/1 'Montserrat', sans-serif; font-style: normal; color: #555;
  }
  #hj-{{ section.id }} .hj__face small { font: 600 .62em/1 'Montserrat', sans-serif; opacity: .9; }
  #hj-{{ section.id }} .hj__call-btns { display: flex; justify-content: center; gap: 1.4em; }
  #hj-{{ section.id }} .hj__call-btns span { width: 2.6em; height: 2.6em; border-radius: 50%; background: rgba(255,255,255,.22); display: grid; place-items: center; color: #fff; }
  #hj-{{ section.id }} .hj__call-btns svg { width: 1.15em; height: 1.15em; }
  #hj-{{ section.id }} .hj__call-btns .hj__end { background: #e5484d; }

  /* 3. Tracking */
  #hj-{{ section.id }} .hj__track-title { margin: .4em 0 .2em; font: 700 1.35em/1.2 'Montserrat', sans-serif; }
  #hj-{{ section.id }} .hj__track { position: relative; list-style: none; margin: .4em 0; padding: 0 0 0 1.6em; display: grid; gap: 1.25em; }
  #hj-{{ section.id }} .hj__track::before { content: ""; position: absolute; left: .42em; top: .5em; bottom: .5em; width: 2px; background: #e6e6e6; }
  #hj-{{ section.id }} .hj__track li.hj__track-fill::before { display: none; }
  #hj-{{ section.id }} .hj__track .hj__track-fill { position: absolute; left: .42em; top: .5em; width: 2px; height: 0; background: var(--hj-accent); }
  #hj-{{ section.id }} .hj__track li { position: relative; font: 500 .92em/1.2 'Montserrat', sans-serif; color: #767676; }
  #hj-{{ section.id }} .hj__track li::before { content: ""; position: absolute; left: -1.6em; top: .15em; width: .9em; height: .9em; border-radius: 50%; background: #fff; border: 2px solid #ddd; box-sizing: border-box; }
  #hj-{{ section.id }} .hj__track li.is-done { color: #333; }
  #hj-{{ section.id }} .hj__track li.is-done::before { background: var(--hj-accent); border-color: var(--hj-accent); }
  #hj-{{ section.id }} .hj__track li[data-track-now] { color: var(--hj-text); font-weight: 700; }
  #hj-{{ section.id }} .hj__pay {
    margin-top: auto; padding: 1em; border-radius: 1em; background: var(--hj-rose);
    font: 700 .9em/1.3 'Montserrat', sans-serif; text-align: center; color: #9a1633;
  }

  /* 4. WhatsApp */
  #hj-{{ section.id }} .hj__scr--chat { padding: 0; background: #efe7de; }
  #hj-{{ section.id }} .hj__chat-head { display: flex; align-items: center; gap: .7em; padding: 3.1em 1em .9em; background: #075e54; color: #fff; font: 700 .95em/1 'Montserrat', sans-serif; }
  #hj-{{ section.id }} .hj__chat-av { width: 2em; height: 2em; flex: none; border-radius: 50%; background: #fff; overflow: hidden; display: grid; place-items: center; }
  #hj-{{ section.id }} .hj__chat-av img { width: 64%; height: 64%; object-fit: contain; display: block; }
  #hj-{{ section.id }} .hj__chat-body { flex: 1; padding: 1.1em .9em; display: flex; flex-direction: column; gap: .7em; }
  #hj-{{ section.id }} .hj__msg { margin: 0; max-width: 82%; padding: .7em .85em; border-radius: .9em; font: 500 .88em/1.35 'Montserrat', sans-serif; box-shadow: 0 1px 1px rgba(0,0,0,.08); }
  #hj-{{ section.id }} .hj__msg--in { align-self: flex-start; background: #fff; border-top-left-radius: .2em; }
  #hj-{{ section.id }} .hj__msg--out { align-self: flex-end; background: #d9fdd3; border-top-right-radius: .2em; }
  #hj-{{ section.id }} .hj__msg--card { display: grid; gap: .35em; min-width: 62%; }
  #hj-{{ section.id }} .hj__msg--card span:first-child { font-weight: 600; color: #6b6b6b; font-size: .85em; }
  #hj-{{ section.id }} .hj__msg--card b { font: 700 1.9em/1 'Montserrat', sans-serif; }

  /* ---- Live layout ------------------------------------------------------ */
  #hj-{{ section.id }}.is-live .hj__scr { visibility: hidden; opacity: 0; }
  #hj-{{ section.id }} .hj__chip-k { font: 600 11px/1 'Montserrat', sans-serif; color: #6b6b6b; letter-spacing: .04em; }
  #hj-{{ section.id }} .hj__chip-n { font: 700 34px/1 'Montserrat', sans-serif; color: var(--hj-text); }
  #hj-{{ section.id }} .hj__chip-s { display: grid; font: 600 12px/1.2 'Montserrat', sans-serif; color: var(--hj-ink); }
  #hj-{{ section.id }} .hj__chip-s i { grid-area: 1 / 1; font-style: normal; opacity: 0; }
  #hj-{{ section.id }} .hj__chip-s i[data-chip="1"] { opacity: 1; }
  #hj-{{ section.id }}.is-live .hj__chip {
    display: grid; gap: 4px; position: absolute; z-index: 2;
    padding: 14px 18px 14px 16px; border-radius: 16px; background: #fff;
    box-shadow: 0 14px 34px rgba(29, 29, 29, .14);
  }
  #hj-{{ section.id }}.is-live .hj__box { display: block; position: absolute; z-index: 1; }
  #hj-{{ section.id }} .hj__box img { display: block; width: 100%; height: auto; filter: drop-shadow(0 18px 24px rgba(29, 29, 29, .18)); }
  #hj-{{ section.id }} .hj__box-css {
    display: block; aspect-ratio: 1.25; border-radius: 6px;
    background: linear-gradient(180deg, #d9b98f 0 18%, #c9a476 18% 100%);
    box-shadow: inset 0 0 0 1px rgba(0,0,0,.06), 0 18px 24px rgba(29,29,29,.18);
    position: relative;
  }
  #hj-{{ section.id }} .hj__box-css::after { content: ""; position: absolute; left: 44%; right: 44%; top: 0; height: 30%; background: rgba(255,255,255,.35); }

  /* Laptops and desktops: text scrolls, the phone stays in view beside it.
     (Tablets use the one-column phone layout: two columns do not fit there.) */
  @media (min-width: 1100px) {
    #hj-{{ section.id }}.is-live .hj__inner {
      /* Text on the left edge, phone on the right; wider laptops use up to 92% of the screen. */
      max-width: max(1200px, 92vw); grid-template-columns: minmax(0, 460px) auto; justify-content: space-between;
      column-gap: calc(var(--ph) * .5); align-items: start; padding-top: 96px; padding-bottom: 24px;
    }
    #hj-{{ section.id }}.is-live .hj__steps { gap: 0; }
    #hj-{{ section.id }}.is-live .hj__step {
      min-height: 62vh; display: flex; flex-direction: column; justify-content: center;
      opacity: .4; transition: opacity .45s ease;
    }
    #hj-{{ section.id }}.is-live .hj__step.is-active { opacity: 1; }
    #hj-{{ section.id }}.is-live .hj__title { font-size: clamp(28px, 3vw, 44px); }
    #hj-{{ section.id }}.is-live .hj__text { font-size: 17px; }
    #hj-{{ section.id }}.is-live .hj__visual {
      position: sticky;
      top: calc(var(--hj-top, 0px) + (100vh - var(--hj-top, 0px) - var(--ph)) / 2);
      margin: calc(31vh - var(--ph) / 2 + 60px) calc(var(--ph) * .36) 0 0;
    }
    /* The score card hangs off the phone's left edge (only a sliver over the screen), so it never covers the doctor's face, whatever the phone size. */
    #hj-{{ section.id }}.is-live .hj__chip { left: auto; right: calc(100% - var(--ph) * .05); top: 22%; width: max-content; }
    #hj-{{ section.id }}.is-live .hj__box { right: calc(-1 * var(--ph) * .42); bottom: 2%; width: calc(var(--ph) * .42); }
  }

  /* Phones and tablets: nothing sticky. Each step: its text, then its own phone. */
  @media (max-width: 1099.98px) {
    #hj-{{ section.id }} { --ph: min(430px, 62svh); }
    #hj-{{ section.id }} .hj__inner { grid-template-columns: minmax(0, 1fr); gap: 0; padding: 56px 16px 32px; }
    #hj-{{ section.id }} .hj__heading { font-size: 30px; margin-bottom: 8px; }
    #hj-{{ section.id }} .hj__n { font-size: 34px; margin-bottom: 6px; }
    #hj-{{ section.id }}.is-live .hj__visual { display: none; }
    #hj-{{ section.id }}.is-live .hj__steps { gap: 0; }
    #hj-{{ section.id }}.is-live .hj__step { padding: 36px 0 12px; }
    #hj-{{ section.id }}.is-live .hj__title { font-size: 26px; }
    #hj-{{ section.id }}.is-live .hj__text { font-size: 15px; }
    #hj-{{ section.id }}.is-live .hj__slot {
      /* Phone to the left, the score card right beside it rather than on the screen. */
      display: flex; justify-content: flex-start; position: relative; margin-top: 22px;
    }
    #hj-{{ section.id }}.is-live .hj__slot .hj__chip { left: min(calc(var(--ph) * .49 + 12px), calc(100% - 150px)); right: auto; max-width: 150px; top: 16%; padding: 9px 10px; border-radius: 12px; }
    #hj-{{ section.id }} .hj__slot .hj__chip-n { font-size: 24px; }
    #hj-{{ section.id }} .hj__slot .hj__chip-s { font-size: 10px; }
    #hj-{{ section.id }}.is-live .hj__slot .hj__box { left: min(calc(var(--ph) * .4), calc(100% - var(--ph) * .34)); right: auto; bottom: 3%; width: calc(var(--ph) * .34); }
  }

  /* Big screens (QHD, 4K): same width (92%) and the same growth steps as the
     quizzes section above. Sizes are the laptop sizes times --k (no zoom: the
     sticky phone and the step triggers measure real pixels). */
  @media (min-width: 1680px) { #hj-{{ section.id }} { --k: 1.12; } }
  @media (min-width: 1920px) { #hj-{{ section.id }} { --k: 1.25; } }
  @media (min-width: 2240px) { #hj-{{ section.id }} { --k: 1.45; } }
  @media (min-width: 2560px) { #hj-{{ section.id }} { --k: 1.65; } }
  @media (min-width: 3200px) { #hj-{{ section.id }} { --k: 2; } }
  @media (min-width: 3840px) { #hj-{{ section.id }} { --k: 2.4; } }
  @media (min-width: 1920px) { #hj-{{ section.id }} .hj__inner { max-width: calc(1312px * var(--k)) !important; } }
  @media (min-width: 2560px) { #hj-{{ section.id }} .hj__inner { max-width: calc(1392px * var(--k)) !important; } }
  @media (min-width: 1680px) {
    #hj-{{ section.id }} { --ph: min(calc(600px * var(--k)), 72vh); }
    /* the same content width as the other sections at each step */
    #hj-{{ section.id }} .hj__inner { max-width: calc(1272px * var(--k)); padding-left: 0; padding-right: 0; }
    #hj-{{ section.id }}.is-live .hj__inner { justify-content: space-between; grid-template-columns: minmax(0, calc(620px * var(--k))) auto; padding-top: calc(96px * var(--k)); padding-right: calc(var(--ph) * .07); /* room for the box that sticks out right of the phone */ }
    #hj-{{ section.id }} .hj__eyebrow { font-size: calc(12px * var(--k)); margin-bottom: calc(18px * var(--k)); }
    #hj-{{ section.id }} .hj__heading { font-size: calc(52px * var(--k)); margin-bottom: calc(36px * var(--k)); max-width: calc(620px * var(--k)); }
    #hj-{{ section.id }} .hj__n { font-size: calc(44px * var(--k)); margin-bottom: calc(10px * var(--k)); }
    #hj-{{ section.id }} .hj__day { font-size: calc(13px * var(--k)); margin-bottom: calc(6px * var(--k)); }
    #hj-{{ section.id }}.is-live .hj__title { font-size: calc(44px * var(--k)); margin-bottom: calc(8px * var(--k)); }
    #hj-{{ section.id }}.is-live .hj__text { font-size: calc(17px * var(--k)); max-width: calc(500px * var(--k)); }
    #hj-{{ section.id }}.is-live .hj__chip { padding: calc(14px * var(--k)) calc(18px * var(--k)) calc(14px * var(--k)) calc(16px * var(--k)); border-radius: calc(16px * var(--k)); gap: calc(4px * var(--k)); }
    #hj-{{ section.id }} .hj__chip-k { font-size: calc(11px * var(--k)); }
    #hj-{{ section.id }} .hj__chip-n { font-size: calc(34px * var(--k)); }
    #hj-{{ section.id }} .hj__chip-s { font-size: calc(12px * var(--k)); }
  }

  /* Phones and tablets: the section heading centred. */
  @media (max-width: 1099.98px) {
    #hj-{{ section.id }} .hj__eyebrow, #hj-{{ section.id }} .hj__heading { text-align: center; margin-left: auto; margin-right: auto; }
  }
  /* Tablets: the phone layout in a comfortable centred column. */
  @media (min-width: 640px) and (max-width: 1099.98px) {
    #hj-{{ section.id }} .hj__inner { max-width: none; padding: 72px 24px 40px; }
    #hj-{{ section.id }} .hj__heading { font-size: 38px; margin-bottom: 12px; }
    /* Each step: its text on the left, its phone and score card on the right. */
    #hj-{{ section.id }}.is-live .hj__step {
      display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-rows: 1fr auto auto auto auto 1fr;
      column-gap: 6%; padding: 32px 0;
    }
    #hj-{{ section.id }}.is-live .hj__n { grid-area: 2 / 1; }
    #hj-{{ section.id }}.is-live .hj__day { grid-area: 3 / 1; }
    #hj-{{ section.id }}.is-live .hj__title { grid-area: 4 / 1; font-size: 30px; }
    #hj-{{ section.id }}.is-live .hj__text { grid-area: 5 / 1; font-size: 16px; }
    #hj-{{ section.id }}.is-live .hj__slot { grid-area: 1 / 2 / 7 / 3; margin-top: 0; width: calc(var(--ph) * .49 + 162px); }
  }
  /* Large phones (640-749): same side by side, a slightly smaller phone. */
  @media (min-width: 640px) and (max-width: 749.98px) {
    #hj-{{ section.id }} { --ph: min(340px, 50svh); }
    #hj-{{ section.id }} .hj__inner { padding: 56px 24px 32px; }
    #hj-{{ section.id }} .hj__heading { font-size: 32px; }
    #hj-{{ section.id }}.is-live .hj__step { column-gap: 24px; }
    #hj-{{ section.id }}.is-live .hj__title { font-size: 24px; }
    #hj-{{ section.id }}.is-live .hj__text { font-size: 15px; }
  }
  /* Phones: no room beside the text, so the phone and its card sit centred below it. */
  @media (max-width: 639.98px) {
    /* The phone mockup about 20% smaller than before, so each step fits a phone screen better. */
    #hj-{{ section.id }} { --ph: min(340px, 50svh); }
    #hj-{{ section.id }} .hj__steps { grid-template-columns: minmax(0, 1fr); }
    #hj-{{ section.id }}.is-live .hj__slot { width: calc(var(--ph) * .49 + 162px); max-width: 100%; margin-left: auto; margin-right: auto; }
  }

  /* Narrow phones: a slightly smaller phone so the score card fits beside it. */
  @media (max-width: 374px) {
    #hj-{{ section.id }} { --ph: min(320px, 48svh); }
  }

  @media (max-width: 749.98px) { #hj-{{ section.id }} .hj__heading, #hj-{{ section.id }} .hj__text { max-width: none; } }
  /* Phones: each step is its number, when, title and phone; the sentence under the title goes. */
  @media (max-width: 749.98px) { #hj-{{ section.id }} .hj__text { display: none; } }

  @media (prefers-reduced-motion: reduce) {
    #hj-{{ section.id }} * { transition: none !important; animation: none !important; }
  }
</style>

<section id="hj-{{ section.id }}" class="hj" data-hj style="--hj-accent: {{ s.accent_color }}; --hj-ink: {{ s.accent_color | color_darken: 8 }};">
  <div class="hj__stage">
    <div class="hj__inner">

      <div class="hj__copy">
        <p class="hj__eyebrow">{{ s.eyebrow }}</p>
        {%- if s.heading != blank -%}<h2 class="hj__heading">{{ s.heading }}</h2>{%- endif -%}
        <div class="hj__steps">
          {%- for i in (1..4) -%}
            {%- capture k_day -%}day_{{ i }}{%- endcapture -%}
            {%- capture k_title -%}title_{{ i }}{%- endcapture -%}
            {%- capture k_text -%}text_{{ i }}{%- endcapture -%}
            <div class="hj__step" data-step="{{ i }}">
              <span class="hj__n" aria-hidden="true">0{{ i }}</span>
              <p class="hj__day">{{ s[k_day] }}</p>
              <h3 class="hj__title">{{ s[k_title] }}</h3>
              <p class="hj__text">{{ s[k_text] }}</p>
              <div class="hj__slot"></div>
            </div>
          {%- endfor -%}
        </div>
      </div>

      <div class="hj__visual">
        <div class="hj__phone">
          <div class="hj__notch"></div>
          <div class="hj__screen">

            {%- comment -%} 1. Quiz {%- endcomment -%}
            <div class="hj__scr hj__scr--quiz" data-scr="1">
              <div class="hj__quiz-top"><span class="hj__quiz-bar"><i></i></span><span>3/6</span></div>
              <p class="hj__quiz-q">How has your sleep been lately?</p>
              <div class="hj__opt">Good</div>
              <div class="hj__opt hj__opt--pick">Average</div>
              <div class="hj__opt">Poor</div>
              <div class="hj__result">
                <span class="hj__result-label">Your Health Score</span>
                <b class="hj__num" data-score>0</b>
                <span class="hj__meter"><i data-meter></i></span>
              </div>
            </div>

            {%- comment -%} 2. Doctor call {%- endcomment -%}
            <div class="hj__scr hj__scr--call" data-scr="2">
              {%- if s.call_image != blank -%}
                <img class="hj__call-img" style="top: {{ s.call_image_y | default: 0 }}%" src="{{ s.call_image | image_url: width: 600 }}" alt="" loading="lazy" width="600" height="{{ 600 | divided_by: s.call_image.aspect_ratio | round }}">
              {%- endif -%}
              <div class="hj__call-shade"></div>
              <div class="hj__call-top">
                <b>{{ s.call_name }}</b>
                <span data-timer>00:00</span>
              </div>
              <div class="hj__call-panel">
                <p>{{ s.review_line }}</p>
                <div class="hj__faces">
                  {%- for i in (1..3) -%}
                    {%- capture k_img -%}doctor_{{ i }}_image{%- endcapture -%}
                    {%- capture k_lab -%}doctor_{{ i }}_label{%- endcapture -%}
                    <span class="hj__face">
                      {%- if s[k_img] != blank -%}
                        <img src="{{ s[k_img] | image_url: width: 160 }}" alt="" loading="lazy" width="160" height="160">
                      {%- else -%}
                        <em>{{ s[k_lab] | slice: 0 }}</em>
                      {%- endif -%}
                    </span>
                  {%- endfor -%}
                </div>
                <div class="hj__call-btns"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/></svg></span><span class="hj__end"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 14.5c5-4.7 13-4.7 18 0l-2.3 2.3-3.2-1.6v-2.4a11 11 0 0 0-7 0v2.4l-3.2 1.6z"/></svg></span><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9.5v5h3.5L12 18V6L7.5 9.5z"/><path d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11"/></svg></span></div>
              </div>
            </div>

            {%- comment -%} 3. Delivery tracking {%- endcomment -%}
            <div class="hj__scr hj__scr--track" data-scr="3">
              <p class="hj__track-title">Your care kit is on the way</p>
              <ul class="hj__track">
                <li class="is-done">Order confirmed</li>
                <li class="is-done">Packed</li>
                <li data-track-now>Out for delivery</li>
                <li>Delivered</li>
                <li class="hj__track-fill" aria-hidden="true" data-track-fill></li>
              </ul>
              <div class="hj__pay">{{ s.pay_line }}</div>
            </div>

            {%- comment -%} 4. WhatsApp check-in {%- endcomment -%}
            <div class="hj__scr hj__scr--chat" data-scr="4">
              {%- assign chat_logo = s.chat_logo | default: shop.brand.square_logo | default: settings.favicon -%}
              <div class="hj__chat-head"><span class="hj__chat-av">{%- if chat_logo != blank -%}<img src="{{ chat_logo | image_url: width: 96 }}" alt="" loading="lazy" width="48" height="48">{%- endif -%}</span><b>{{ s.chat_name | default: 'sehatUP' }}</b></div>
              <div class="hj__chat-body">
                <p class="hj__msg hj__msg--in" data-msg>{{ s.chat_q }}</p>
                <p class="hj__msg hj__msg--out" data-msg>{{ s.chat_a }}</p>
                <div class="hj__msg hj__msg--in hj__msg--card" data-msg>
                  <span>Health Score</span>
                  <b><span data-score-old>72</span> &rarr; <span data-score-new>72</span></b>
                  <span class="hj__meter"><i data-meter-new></i></span>
                </div>
              </div>
            </div>

          </div>
        </div>

        {%- comment -%} The Health Score card that travels through all 4 steps. {%- endcomment -%}
        <div class="hj__chip" aria-hidden="true">
          <span class="hj__chip-k">Health Score</span>
          <b class="hj__chip-n" data-chip-n>72</b>
          <span class="hj__chip-s">
            <i data-chip="1">Your starting point</i>
            <i data-chip="2">Reviewed by 3 doctors</i>
            <i data-chip="3">Your plan, in the box</i>
            <i data-chip="4">Progress at your check-in</i>
          </span>
        </div>

        <div class="hj__box" aria-hidden="true">
          {%- if s.box_image != blank -%}
            <img src="{{ s.box_image | image_url: width: 500 }}" alt="" loading="lazy" width="500" height="{{ 500 | divided_by: s.box_image.aspect_ratio | round }}">
          {%- else -%}
            <span class="hj__box-css"></span>
          {%- endif -%}
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  /* The same story as before, with no libraries: the browser's own IntersectionObserver
     notices which step is at the middle of the screen (where ScrollTrigger used to),
     and the Web Animations API plays each phone screen (where GSAP timelines used to).
     Same moments, timings and easing curves. The page keeps normal scrolling. */
  (function () {
    var root = document.getElementById('hj-{{ section.id }}');
    if (!root || root.dataset.hjBooted === '1') return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    root.dataset.hjBooted = '1';

    /* GSAP's easing curves, as CSS cubic-beziers */
    var E = {
      p2out: 'cubic-bezier(.33, 1, .68, 1)', p3out: 'cubic-bezier(.25, 1, .5, 1)', p2in: 'cubic-bezier(.32, 0, .67, 0)',
      p1io: 'cubic-bezier(.37, 0, .63, 1)', back2: 'cubic-bezier(.34, 1.8, .64, 1)', back16: 'cubic-bezier(.34, 1.56, .64, 1)', none: 'linear'
    };
    var PROPS = ['opacity', 'visibility', 'transform', 'width', 'height', 'background-color', 'border-color', 'color'];

    function stop(el) { el.getAnimations().forEach(function (a) { a.cancel(); }); }
    function reset(el) { stop(el); PROPS.forEach(function (p) { el.style.removeProperty(p); }); }
    /* Set the end state on the element, then animate into it from 'from' (held during the delay). */
    function tween(el, from, to, ms, ease, delay) {
      stop(el);
      Object.keys(to).forEach(function (k) { el.style[k] = to[k]; });
      return el.animate([from, to], { duration: ms, easing: ease, delay: delay || 0, fill: 'backwards' });
    }
    function setVis(el, on) { stop(el); el.style.visibility = on ? 'visible' : 'hidden'; el.style.opacity = on ? '1' : '0'; }

    /* A play-through that can be stopped part way (the next step cancels the last one) */
    function Run() { this.a = []; this.r = []; }
    Run.prototype.add = function (anim) { this.a.push(anim); return anim; };
    Run.prototype.kill = function () {
      this.a.forEach(function (x) { x.finish(); });
      this.r.forEach(function (x) { x.stop = true; });
    };
    /* Count a number up (eased), like the score 0 -> 72 */
    function count(run, el, from, to, ms, delay, ease) {
      var job = { stop: false }; run.r.push(job);
      var t0 = performance.now() + delay;
      el.textContent = from;
      (function f(now) {
        if (job.stop) { el.textContent = to; return; }
        var p = Math.min(1, Math.max(0, (now - t0) / ms));
        el.textContent = Math.round(from + (to - from) * (ease ? 1 - Math.pow(1 - p, 3) : p));
        if (p < 1) requestAnimationFrame(f);
      })(performance.now());
    }

    var header = document.querySelector('.section-header');
    function measure() {
      var hp = header ? getComputedStyle(header).position : '';
      root.style.setProperty('--hj-top', ((hp === 'sticky' || hp === 'fixed') ? header.offsetHeight : 0) + 'px');
    }
    measure();
    window.addEventListener('resize', measure);
    root.classList.add('is-live');

    var steps = [].slice.call(root.querySelectorAll('.hj__step'));
    var phone = root.querySelector('.hj__phone');
    var chip = root.querySelector('.hj__chip');
    var box = root.querySelector('.hj__box');

    function show(scope, i) {
      scope.querySelectorAll('.hj__scr').forEach(function (el, k) { setVis(el, k === i - 1); el.style.transform = 'none'; });
    }
    function chipStatus(c, i) {
      c.querySelectorAll('[data-chip]').forEach(function (el, k) {
        var on = k === i - 1;
        tween(el, { opacity: getComputedStyle(el).opacity }, { opacity: on ? '1' : '0' }, 250, 'ease', on ? 150 : 0);
      });
    }

    /* What each step does on its phone screen (time-based, about 1-2s) */
    function play(scope, i, chipN, bx) {
      var run = new Run();
      var $ = function (sel) { return scope.querySelector(sel); };
      if (i === 1) {
        run.add(tween($('.hj__opt--pick'), { backgroundColor: '#ffffff', borderColor: '#eeeeee', color: '#333333' },
          { backgroundColor: 'rgba(238, 32, 74, .09)', borderColor: 'rgba(238, 32, 74, .6)', color: '#b3123a' }, 250, 'ease', 250));
        run.add(tween($('[data-meter]'), { width: '0%' }, { width: '72%' }, 1000, E.p2out, 550));
        count(run, $('[data-score]'), 0, 72, 1000, 550, true);
      } else if (i === 2) {
        var timer = $('[data-timer]'), job = { stop: false }, t0 = performance.now();
        run.r.push(job);
        (function f(now) {
          var s = Math.round(Math.min(1, (now - t0) / 2200) * 45);
          timer.textContent = '00:' + (s < 10 ? '0' : '') + s;
          if (!job.stop && s < 45) requestAnimationFrame(f);
        })(t0);
        scope.querySelectorAll('.hj__face').forEach(function (el, k) {
          run.add(tween(el, { opacity: 0, visibility: 'hidden', transform: 'translateY(12px) scale(.8)' }, { opacity: '1', visibility: 'visible', transform: 'none' }, 350, E.back2, 350 + k * 120));
        });
      } else if (i === 3) {
        run.add(tween($('[data-track-fill]'), { height: '0%' }, { height: '52%' }, 800, E.p1io, 200));
        if (bx) run.add(tween(bx, { opacity: 0, visibility: 'hidden', transform: 'translateY(-70px) rotate(-8deg)' }, { opacity: '1', visibility: 'visible', transform: 'none' }, 600, E.back16, 350));
      } else {
        scope.querySelectorAll('[data-msg]').forEach(function (el, k) {
          run.add(tween(el, { opacity: 0, visibility: 'hidden', transform: 'translateY(14px)' }, { opacity: '1', visibility: 'visible', transform: 'none' }, 300, E.p2out, 200 + k * 350));
        });
        run.add(tween($('[data-meter-new]'), { width: '72%' }, { width: '84%' }, 800, E.p2out, 1050));
        count(run, $('[data-score-new]'), 72, 84, 800, 1050, true);
        if (chipN) count(run, chipN, 72, 84, 800, 1050, true);
      }
      return run;
    }

    var cleanup = null;

    /* Laptops and desktops: steps scroll past, the sticky phone follows the active one */
    function desktop() {
      var current = 0, running = null, chipN = chip.querySelector('[data-chip-n]');
      var scr = [].slice.call(phone.querySelectorAll('.hj__scr'));
      show(phone, 1);
      steps[0].classList.add('is-active');
      setVis(chip, false); chip.style.transform = 'translateX(-16px)';
      setVis(box, false);

      function activate(i) {
        if (i === current) return;
        var prev = current; current = i;
        steps.forEach(function (el, k) { el.classList.toggle('is-active', k === i - 1); });
        scr.forEach(function (el, k) {
          if (k !== i - 1 && el.style.visibility !== 'hidden') tween(el, { opacity: 1, visibility: 'visible', transform: 'none' }, { opacity: '0', visibility: 'hidden', transform: 'scale(.97)' }, 300, E.p2in);
        });
        tween(scr[i - 1], { opacity: 0, visibility: 'hidden', transform: 'translateY(30px)' }, { opacity: '1', visibility: 'visible', transform: 'none' }, 450, E.p3out, prev ? 150 : 0);
        if (chip.style.visibility === 'hidden') tween(chip, { opacity: 0, visibility: 'hidden', transform: 'translateX(-16px)' }, { opacity: '1', visibility: 'visible', transform: 'none' }, 400, E.p3out);
        chipStatus(chip, i);
        if (i < 4) chipN.textContent = '72';
        if (i !== 3 && box.style.visibility !== 'hidden') tween(box, { opacity: 1, visibility: 'visible', transform: 'none' }, { opacity: '0', visibility: 'hidden', transform: 'translateX(30px)' }, 300, E.p2in);
        if (running) running.kill();
        running = play(phone, i, chipN, i === 3 ? box : null);
      }
      /* A thin line at 58% of the screen height: the step crossing it is the active one */
      var io = new IntersectionObserver(function (es) {
        es.forEach(function (e) { if (e.isIntersecting) activate(steps.indexOf(e.target) + 1); });
      }, { rootMargin: '-58% 0px -41.8% 0px' });
      steps.forEach(function (el) { io.observe(el); });

      return function () {
        io.disconnect();
        if (running) running.kill();
        steps.forEach(function (el) { el.classList.remove('is-active'); });
        root.querySelectorAll('.hj__scr, .hj__chip, .hj__box, [data-chip], .hj__face, [data-msg], [data-meter], [data-meter-new], [data-track-fill], .hj__opt--pick').forEach(reset);
      };
    }

    /* Phones and tablets: each step gets its own copy of the phone, played once in view */
    function mobile() {
      var made = [];
      var io = new IntersectionObserver(function (es) {
        es.forEach(function (e) {
          if (!e.isIntersecting) return;
          io.unobserve(e.target);
          var d = e.target._hj; play(d.ph, d.i, d.c.querySelector('[data-chip-n]'), d.bx);
        });
      }, { rootMargin: '0px 0px -22% 0px' });
      steps.forEach(function (el, k) {
        var i = k + 1, slot = el.querySelector('.hj__slot');
        var ph = phone.cloneNode(true), c = chip.cloneNode(true), bx = null;
        slot.appendChild(ph); slot.appendChild(c); made.push(ph, c);
        show(ph, i);
        setVis(c, true); c.style.transform = 'none';
        c.querySelectorAll('[data-chip]').forEach(function (n, j) { n.style.opacity = j === i - 1 ? 1 : 0; });
        c.querySelector('[data-chip-n]').textContent = '72';
        if (i === 3) { bx = box.cloneNode(true); slot.appendChild(bx); made.push(bx); setVis(bx, false); }
        slot._hj = { ph: ph, c: c, bx: bx, i: i };
        io.observe(slot);
      });
      return function () { io.disconnect(); made.forEach(function (n) { n.remove(); }); };
    }

    var wide = window.matchMedia('(min-width: 1100px)');
    function setup() {
      if (cleanup) cleanup();
      cleanup = wide.matches ? desktop() : mobile();
    }
    setup();
    if (wide.addEventListener) wide.addEventListener('change', setup); else wide.addListener(setup);
  })();
</script>

{% schema %}
{
  "name": "Health journey (phone)",
  "tag": "div",
  "class": "section-health-journey",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What happens after you start" },
    { "type": "color", "id": "accent_color", "label": "Accent colour", "default": "#ee204a" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From your first tap to feeling better" },
    { "type": "header", "content": "1. The check" },
    { "type": "text", "id": "day_1", "label": "When", "default": "Today" },
    { "type": "text", "id": "title_1", "label": "Title", "default": "Take your Health Score" },
    { "type": "textarea", "id": "text_1", "label": "Text", "default": "Free. No sign-up. Simple, honest questions about your body." },
    { "type": "header", "content": "2. The doctor call" },
    { "type": "text", "id": "day_2", "label": "When", "default": "Within 24 hours" },
    { "type": "text", "id": "title_2", "label": "Title", "default": "A doctor consults you" },
    { "type": "textarea", "id": "text_2", "label": "Text", "default": "Your score is reviewed together by Ayurveda, Homeopathy and Allopathy doctors, who talk to you in Hindi or English." },
    { "type": "image_picker", "id": "call_image", "label": "Doctor on the call (portrait)" },
    { "type": "range", "id": "call_image_y", "label": "Call photo: move down", "min": 0, "max": 30, "step": 1, "unit": "%", "default": 12, "info": "Moves the photo down so the name and timer at the top do not cover the face." },
    { "type": "text", "id": "call_name", "label": "Caller name", "default": "sehatUP Doctor" },
    { "type": "text", "id": "review_line", "label": "Review line", "default": "Your score is reviewed by 3 doctors" },
    { "type": "image_picker", "id": "doctor_1_image", "label": "Doctor 1 photo" },
    { "type": "text", "id": "doctor_1_label", "label": "Doctor 1 system", "default": "Ayurveda" },
    { "type": "image_picker", "id": "doctor_2_image", "label": "Doctor 2 photo" },
    { "type": "text", "id": "doctor_2_label", "label": "Doctor 2 system", "default": "Homeopathy" },
    { "type": "image_picker", "id": "doctor_3_image", "label": "Doctor 3 photo" },
    { "type": "text", "id": "doctor_3_label", "label": "Doctor 3 system", "default": "Allopathy" },
    { "type": "header", "content": "3. The kit" },
    { "type": "text", "id": "day_3", "label": "When", "default": "Day 3 to 5" },
    { "type": "text", "id": "title_3", "label": "Title", "default": "Your personalised kit arrives" },
    { "type": "textarea", "id": "text_3", "label": "Text", "default": "Only what your doctor chose for you, packed discreetly. Confirm with ₹50 and pay the rest on delivery, or pay in full online." },
    { "type": "text", "id": "pay_line", "label": "Payment line on the phone", "default": "₹50 paid · rest on delivery" },
    { "type": "image_picker", "id": "box_image", "label": "Box photo (transparent PNG)", "info": "Leave empty to show a simple drawn box." },
    { "type": "header", "content": "4. The check-ins" },
    { "type": "text", "id": "day_4", "label": "When", "default": "Every month" },
    { "type": "text", "id": "title_4", "label": "Title", "default": "Your plan keeps improving" },
    { "type": "textarea", "id": "text_4", "label": "Text", "default": "A WhatsApp check-in each month, and your plan changes as your body responds." },
    { "type": "image_picker", "id": "chat_logo", "label": "WhatsApp profile picture", "info": "Empty uses the Square logo from Shopify admin > Settings > Brand (the one used for social media), then the favicon." },
    { "type": "text", "id": "chat_name", "label": "WhatsApp chat name", "default": "sehatUP" },
    { "type": "text", "id": "chat_q", "label": "Doctor's message", "default": "Day 30: how is your sleep now?" },
    { "type": "text", "id": "chat_a", "label": "Customer's reply", "default": "Much better, thank you!" }
  ],
  "presets": [{ "name": "Health journey (phone)" }]
}
{% endschema %}
