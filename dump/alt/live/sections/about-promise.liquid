{%- comment -%}
  About Us: our commitment to you. Heading and intro centred, then the promises
  in one row (two by two on tablets, a list on phones): a short charcoal bar,
  a bold title, a line of text. On a soft stone panel.
{%- endcomment -%}
{%- assign s = section.settings -%}
<style>
  #apr-{{ section.id }} { background: {{ s.section_bg }}; color: #1d1d1d; font-family: 'Montserrat', sans-serif; padding: {{ s.padding_top }}px 0 {{ s.padding_bottom }}px; }
  #apr-{{ section.id }} * { box-sizing: border-box; letter-spacing: normal; }
  #apr-{{ section.id }} .apr__in { max-width: 1120px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 48px); }
  #apr-{{ section.id }} .apr__head { max-width: 640px; margin: 0 auto clamp(28px, 3.4vw, 48px); text-align: center; }
  #apr-{{ section.id }} .apr__h { margin: 0 0 12px; font: 800 clamp(30px, 3.6vw, 48px)/1.1 'Montserrat', sans-serif; letter-spacing: -.025em; color: #1d1d1d; text-wrap: balance; }
  #apr-{{ section.id }} .apr__lead { margin: 0; font: 400 clamp(16px, 1.3vw, 18px)/1.6 'Montserrat', sans-serif; color: #5f5a56; text-wrap: pretty; }
  #apr-{{ section.id }} .apr__list { list-style: none; margin: 0; padding: clamp(24px, 3vw, 40px); display: grid; grid-template-columns: repeat({{ section.blocks.size | at_most: 4 | at_least: 1 }}, minmax(0, 1fr)); gap: clamp(20px, 3vw, 40px); border-radius: 24px; background: #f6f0ec; }
  #apr-{{ section.id }} .apr__ic { display: block; width: 30px; height: 30px; margin-bottom: 16px; color: #1d1d1d; }
  #apr-{{ section.id }} .apr__ic svg { width: 100%; height: 100%; fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }
  #apr-{{ section.id }} .apr__ic img { width: 100%; height: 100%; object-fit: contain; }
  #apr-{{ section.id }} .apr__ic .dot { fill: #d81f48; stroke: none; }
  /* The one link of the section, centred under the panel. */
  /* The one link of the section, centred along the bottom of the panel. */
  #apr-{{ section.id }} .apr__cta { grid-column: 1 / -1; text-align: center; padding-top: clamp(16px, 2vw, 24px); border-top: 1px solid #e3d9d1; }
  #apr-{{ section.id }} .apr__cta .apr__a { margin-top: 0; }
  #apr-{{ section.id }} .apr__t { margin: 0 0 8px; font: 800 clamp(18px, 1.6vw, 21px)/1.25 'Montserrat', sans-serif; letter-spacing: -.01em; color: #1d1d1d; }
  #apr-{{ section.id }} .apr__x { margin: 0; font: 400 15px/1.6 'Montserrat', sans-serif; color: #5f5a56; text-wrap: pretty; }
  #apr-{{ section.id }} .apr__a { display: inline-block; margin-top: 12px; font: 700 14.5px/1.3 'Montserrat', sans-serif; color: #1d1d1d; text-decoration: underline; text-decoration-color: #d81f48; text-decoration-thickness: 2px; text-underline-offset: 4px; }
  @media (hover: hover) { #apr-{{ section.id }} .apr__a:hover { color: #d81f48; } }
  #apr-{{ section.id }} .apr__a:focus-visible { outline: 2px solid #d81f48; outline-offset: 4px; }
  @media (max-width: 999.98px) { #apr-{{ section.id }} .apr__list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 749.98px) {
    #apr-{{ section.id }} { padding-top: {{ s.padding_top_mobile }}px; padding-bottom: {{ s.padding_bottom_mobile }}px; }
    #apr-{{ section.id }} .apr__h { font-size: 30px; }
    #apr-{{ section.id }} .apr__list { grid-template-columns: minmax(0, 1fr); gap: 0; padding: 4px 20px; border-radius: 20px; }
    #apr-{{ section.id }} .apr__row { padding: 18px 0; border-top: 1px solid #e3d9d1; }
    #apr-{{ section.id }} .apr__row:first-child { border-top: 0; }
    #apr-{{ section.id }} .apr__cta { padding: 16px 0 18px; }
    #apr-{{ section.id }} .apr__row { display: grid; grid-template-columns: 28px minmax(0, 1fr); column-gap: 14px; }
    #apr-{{ section.id }} .apr__row > * { grid-column: 2; }
    #apr-{{ section.id }} .apr__ic { grid-column: 1; grid-row: 1 / span 3; width: 26px; height: 26px; margin: 2px 0 0; }
  }
  @media (min-width: 1680px) { #apr-{{ section.id }} .apr__in { zoom: 1.12; } }
  @media (min-width: 1920px) { #apr-{{ section.id }} .apr__in { zoom: 1.25; } }
  @media (min-width: 2240px) { #apr-{{ section.id }} .apr__in { zoom: 1.45; } }
  @media (min-width: 2560px) { #apr-{{ section.id }} .apr__in { zoom: 1.65; } }
  @media (min-width: 3200px) { #apr-{{ section.id }} .apr__in { zoom: 2; } }
  @media (min-width: 3840px) { #apr-{{ section.id }} .apr__in { zoom: 2.4; } }
</style>

<section id="apr-{{ section.id }}">
  <div class="apr__in">
    <div class="apr__head">
      <h2 class="apr__h">{{ s.heading }}</h2>
      {%- if s.lead != blank -%}<p class="apr__lead">{{ s.lead }}</p>{%- endif -%}
    </div>
    {%- liquid
      assign cta_label = s.cta_label
      assign cta_link = s.cta_link
      if cta_label == blank
        for block in section.blocks
          if block.settings.link_label != blank and block.settings.link != blank
            assign cta_label = block.settings.link_label
            assign cta_link = block.settings.link
            break
          endif
        endfor
      endif
    -%}
    <ul class="apr__list">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li class="apr__row" {{ block.shopify_attributes }}>
          <span class="apr__ic" aria-hidden="true">
            {%- if b.icon_image != blank -%}{{ b.icon_image | image_url: width: 96 | image_tag: alt: '', loading: 'lazy' }}
            {%- else -%}
            {%- case b.icon -%}
              {%- when 'shield' -%}<svg viewBox="0 0 24 24"><path d="M12 3l7 3v5.5c0 4.4-3 8-7 9.5-4-1.5-7-5.1-7-9.5V6z"/><path d="M8.8 12.2l2.2 2.2 4.4-4.6"/></svg>
              {%- when 'lock' -%}<svg viewBox="0 0 24 24"><rect x="5" y="10.5" width="14" height="10" rx="2.5"/><path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5"/><circle class="dot" cx="12" cy="15.5" r="1.3"/></svg>
              {%- when 'chat' -%}<svg viewBox="0 0 24 24"><path d="M20.5 11.5a8 8 0 0 1-11.8 7L4 20l1.5-4.4A8 8 0 1 1 20.5 11.5z"/><circle class="dot" cx="8.5" cy="11.5" r="1"/><circle class="dot" cx="12.5" cy="11.5" r="1"/><circle class="dot" cx="16.5" cy="11.5" r="1"/></svg>
              {%- when 'wallet' -%}<svg viewBox="0 0 24 24"><path d="M4 7.5A2.5 2.5 0 0 1 6.5 5H18v3"/><rect x="4" y="8" width="16" height="11" rx="2.5"/><circle class="dot" cx="16" cy="13.5" r="1.3"/></svg>
              {%- when 'box' -%}<svg viewBox="0 0 24 24"><path d="M3.5 8l8.5-4.5L20.5 8v8.5L12 21l-8.5-4.5z"/><path d="M3.5 8L12 12.5 20.5 8M12 12.5V21"/></svg>
              {%- when 'doctor' -%}<svg viewBox="0 0 24 24"><circle cx="12" cy="7" r="3.5"/><path d="M5 20.5a7 7 0 0 1 14 0"/><path d="M12 13.5v3M10.5 15h3"/></svg>
              {%- else -%}
            {%- endcase -%}
            {%- endif -%}
          </span>
          <h3 class="apr__t">{{ b.title }}</h3>
          {%- if b.text != blank -%}<p class="apr__x">{{ b.text }}</p>{%- endif -%}
        </li>
      {%- endfor -%}
      {%- if cta_label != blank and cta_link != blank -%}
        <li class="apr__cta"><a class="apr__a" href="{{ cta_link }}"{% if cta_link contains 'wa.me' %} target="_blank" rel="noopener"{% endif %}>{{ cta_label }}</a></li>
      {%- endif -%}
    </ul>

  </div>
</section>

{% schema %}
{
  "name": "About: our commitment",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our commitment to you" },
    { "type": "textarea", "id": "lead", "label": "Line under the heading", "default": "sehatUP is a clinic, not a supplement shop. This is how we look after you." },
    { "type": "color", "id": "section_bg", "label": "Background", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "label": "Space above", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_bottom", "label": "Space below", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above on phones", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 44 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below on phones", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 44 }
  ],
  "blocks": [
    {
      "type": "promise",
      "name": "Promise",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "shield", "options": [
          { "value": "shield", "label": "Shield with tick (quality)" },
          { "value": "lock", "label": "Lock (privacy)" },
          { "value": "box", "label": "Plain box (discreet delivery)" },
          { "value": "chat", "label": "Chat bubble (reachable)" },
          { "value": "wallet", "label": "Wallet (easy to pay)" },
          { "value": "doctor", "label": "Doctor" },
          { "value": "none", "label": "None" }
        ] },
        { "type": "image_picker", "id": "icon_image", "label": "Or your own icon", "info": "Square PNG or SVG. Used instead of the icon above." },
        { "type": "text", "id": "title", "label": "Title", "default": "Promise" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "text", "id": "link_label", "label": "Link text (optional)", "info": "Shown once, centred under all the promises." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "About: our commitment" }]
}
{% endschema %}
