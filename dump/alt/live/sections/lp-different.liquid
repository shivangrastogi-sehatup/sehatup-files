{%- comment -%}
  "How sehatUP treats your root causes": three white cards on stone.
  1. Three systems (system blocks: icon image, name, role).
  2. A kit made for you (generic kit image, never one product).
  3. The doctor (cut-out photo, name, credentials, line, language chip).
  Then an optional strip of steps (step blocks). A card with no content hides.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign has_system = false
  assign has_step = false
  for block in section.blocks
    if block.type == 'system'
      assign has_system = true
    elsif block.type == 'step'
      assign has_step = true
    endif
  endfor
  assign show_kit = false
  if s.kit_image != blank or s.kit_title != blank
    assign show_kit = true
  endif
  assign show_doc = false
  if s.doctor_image != blank or s.doctor_name != blank
    assign show_doc = true
  endif
-%}
<section id="different" class="lp-dif-sec lp-sec--{{ s.tone }}">
  <div class="lp-wrap">
    <div class="lp-dif-head">
      <h2 class="lp-dif-h">{{ s.heading }}{% if s.highlight != blank %} <span class="lp-hl">{{ s.highlight }}</span>{% endif %}</h2>
      {%- if s.subheading != blank -%}<p class="lp-dif-sub">{{ s.subheading }}</p>{%- endif -%}
    </div>

    <div class="lp-dif-grid">
      {%- if has_system -%}
        <div class="lp-dif-card">
          <h3 class="lp-dif-card__t">{{ s.systems_title }}</h3>
          <ul class="lp-dif-sys">
            {%- for block in section.blocks -%}
              {%- if block.type == 'system' -%}
                <li {{ block.shopify_attributes }}>
                  <span class="lp-dif-sys__ic">
                    {%- if block.settings.icon_image != blank -%}{{ block.settings.icon_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}{%- else -%}{% render 'lp-icon', name: block.settings.icon %}{%- endif -%}
                  </span>
                  <span><b>{{ block.settings.name }}</b><span>{{ block.settings.role }}</span></span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      {%- if show_kit -%}
        <div class="lp-dif-card lp-dif-card--kit">
          <h3 class="lp-dif-card__t">{{ s.kit_title }}</h3>
          {%- if s.kit_text != blank -%}<p class="lp-dif-card__x">{{ s.kit_text }}</p>{%- endif -%}
          <div class="lp-dif-kit">
            {%- if s.kit_image != blank -%}{{ s.kit_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(max-width: 860px) 90vw, 360px', alt: s.kit_title }}{%- else -%}<span class="lp-dif-kit__ic">{% render 'lp-icon', name: 'box' %}</span>{%- endif -%}
          </div>
        </div>
      {%- endif -%}

      {%- if show_doc -%}
        <div class="lp-dif-card lp-dif-card--doc">
          <div class="lp-dif-doc">
            {%- if s.doctor_image != blank -%}{{ s.doctor_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '360, 520, 700', sizes: '(max-width: 860px) 70vw, 300px', alt: s.doctor_name }}{%- else -%}<span class="lp-dif-kit__ic">{% render 'lp-icon', name: 'doctor' %}</span>{%- endif -%}
          </div>
          <div class="lp-dif-doc__body">
            {%- if s.doctor_label != blank -%}<span class="lp-dif-doc__label">{{ s.doctor_label }}</span>{%- endif -%}
            <h3 class="lp-dif-card__t">{{ s.doctor_name }}</h3>
            {%- if s.doctor_credential != blank -%}<p class="lp-dif-doc__cred">{{ s.doctor_credential }}</p>{%- endif -%}
            {%- if s.doctor_text != blank -%}<p class="lp-dif-card__x">{{ s.doctor_text }}</p>{%- endif -%}
            {%- if s.doctor_chip != blank -%}<span class="lp-dif-chip">{% render 'lp-icon', name: 'chat' %}{{ s.doctor_chip }}</span>{%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </div>

    {%- if has_step -%}
      <ol class="lp-dif-steps">
        {%- for block in section.blocks -%}
          {%- if block.type == 'step' -%}
            <li {{ block.shopify_attributes }}>
              <span class="lp-dif-steps__n"></span>
              <span><b>{{ block.settings.title }}</b>{%- if block.settings.text != blank -%}<span>{{ block.settings.text }}</span>{%- endif -%}</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ol>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "LP why different",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How sehatUP treats" },
    { "type": "text", "id": "highlight", "label": "Heading ending in red", "default": "your root causes" },
    { "type": "textarea", "id": "subheading", "label": "Line under the heading" },
    { "type": "text", "id": "systems_title", "label": "Systems card title", "default": "Three systems, one plan" },
    { "type": "header", "content": "Kit card" },
    { "type": "image_picker", "id": "kit_image", "label": "Kit image (generic, transparent PNG)" },
    { "type": "text", "id": "kit_title", "label": "Title", "default": "A kit made for you" },
    { "type": "textarea", "id": "kit_text", "label": "Text" },
    { "type": "header", "content": "Doctor card" },
    { "type": "image_picker", "id": "doctor_image", "label": "Doctor photo (transparent cut-out)" },
    { "type": "text", "id": "doctor_label", "label": "Small label", "default": "Your doctor" },
    { "type": "text", "id": "doctor_name", "label": "Name" },
    { "type": "text", "id": "doctor_credential", "label": "Degree and experience", "info": "Real details only, e.g. BAMS, 8 years. Leave empty to hide." },
    { "type": "textarea", "id": "doctor_text", "label": "Text" },
    { "type": "text", "id": "doctor_chip", "label": "Small chip", "default": "Hindi or English" },
    { "type": "select", "id": "tone", "label": "Background", "options": [
      { "value": "stone", "label": "Warm stone" }, { "value": "white", "label": "White" }, { "value": "blush", "label": "Blush" }
    ], "default": "stone" }
  ],
  "blocks": [
    { "type": "system", "name": "System", "settings": [
      { "type": "image_picker", "id": "icon_image", "label": "Icon image (transparent PNG)" },
      { "type": "select", "id": "icon", "label": "Fallback icon", "options": [
        { "value": "leaf", "label": "Leaf" }, { "value": "bottle", "label": "Bottle" }, { "value": "pill", "label": "Pill" }
      ], "default": "leaf" },
      { "type": "text", "id": "name", "label": "Name", "default": "Ayurveda" },
      { "type": "text", "id": "role", "label": "What it does in your plan" }
    ] },
    { "type": "step", "name": "Step", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Find the root cause" },
      { "type": "text", "id": "text", "label": "Text" }
    ] }
  ],
  "presets": [{ "name": "LP why different" }]
}
{% endschema %}
