{%- liquid
  for p in shop.policies
    if request.path == p.url
      assign policy = p
    endif
  endfor
-%}

<div class="policy-page">
  <div class="policy-page__inner">
    <h1 class="policy-page__title">{{ policy.title | default: page_title }}</h1>
    <div class="policy-page__body rte">
      {{ policy.body }}
    </div>
  </div>
</div>

<style>
  .policy-page { padding: 48px 20px 80px; }
  .policy-page__inner { max-width: 820px; margin: 0 auto; }
  .policy-page__title {
    font-size: clamp(28px, 4vw, 44px);
    margin: 0 0 28px;
    padding-bottom: 18px;
    border-bottom: 2px solid #ee204a;
  }
  .policy-page__body { line-height: 1.75; color: #374151; }
  .policy-page__body h2 { margin: 36px 0 12px; font-size: 22px; color: #111827; }
  .policy-page__body ul { padding-left: 22px; }
  .policy-page__body li { margin-bottom: 8px; }
  .policy-page__body a { color: #ee204a; }
</style>

{% schema %}
{ "name": "Policy page" }
{% endschema %}
