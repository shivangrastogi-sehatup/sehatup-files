{%- comment -%}
  About Us hero. Copy on the left; on the right three soft circles
  (Ayurveda, Homeopathy, Modern medicine) glide in and overlap, and the
  overlap is "You". Hover or tap a circle: it tints and the line under the
  drawing says what that system does (fixed-height line, no layout jump).
  Phones: one column, drawing under the copy.
{%- endcomment -%}
{%- assign s = section.settings -%}
<style>
  #ahr-{{ section.id }} {
    --ink: #1d1d1d; --mute: #5f5a56; --line: #e3d9d1; --stone: #f6f0ec; --tint: #fdecef;
    --red: {{ s.accent_color }}; --btn: {{ s.accent_color | color_darken: 8 }};
    --ease: cubic-bezier(.22, 1, .36, 1);
    background: #fff; color: var(--ink); font-family: 'Montserrat', sans-serif;
  }
  #ahr-{{ section.id }} * { box-sizing: border-box; }
  #ahr-{{ section.id }} .ahr__in { max-width: 1240px; margin: 0 auto; padding: clamp(40px, 5vw, 88px) clamp(16px, 4vw, 48px); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .95fr); gap: clamp(24px, 4vw, 72px); align-items: center; }
  #ahr-{{ section.id }} .ahr__kick { margin: 0 0 16px; font: 700 15px/1.2 'Montserrat', sans-serif; color: var(--btn); }
  #ahr-{{ section.id }} .ahr__h { margin: 0 0 20px; color: var(--ink); font: 800 clamp(38px, 4.4vw, 68px)/1.04 'Montserrat', sans-serif; letter-spacing: -.03em; text-wrap: balance; }
  #ahr-{{ section.id }} .ahr__sub { margin: 0; max-width: 34em; font: 400 clamp(16px, 1.35vw, 20px)/1.55 'Montserrat', sans-serif; color: var(--mute); text-wrap: pretty; }
  #ahr-{{ section.id }} .ahr__cta { margin-top: 32px; display: flex; flex-wrap: wrap; align-items: center; gap: 14px 22px; }
  #ahr-{{ section.id }} .ahr__btn { display: inline-flex; align-items: center; gap: 12px; height: 58px; padding: 0 34px; border-radius: 999px; background: var(--btn); color: #fff; text-decoration: none; font: 700 17px/1 'Montserrat', sans-serif; box-shadow: 0 14px 30px rgba(219, 29, 68, .22); transition: background .2s; }
  @media (hover: hover) { #ahr-{{ section.id }} .ahr__btn:hover { background: {{ s.accent_color | color_darken: 16 }}; color: #fff; } }
  #ahr-{{ section.id }} .ahr__btn svg { width: .9em; height: .9em; transition: transform .2s; }
  @media (hover: hover) { #ahr-{{ section.id }} .ahr__btn:hover svg { transform: translateX(3px); } }
  #ahr-{{ section.id }} .ahr__note { font: 500 14px/1.4 'Montserrat', sans-serif; color: var(--mute); }
  #ahr-{{ section.id }} a:focus-visible, #ahr-{{ section.id }} .ahr__c:focus-visible { outline: 2px solid var(--red); outline-offset: 3px; }

  /* The drawing */
  #ahr-{{ section.id }} .ahr__art { width: 100%; max-width: 560px; margin: 0 auto; }
  #ahr-{{ section.id }} .ahr__svg { display: block; width: 100%; height: auto; overflow: visible; }
  #ahr-{{ section.id }} .ahr__c { cursor: pointer; outline: none; transition: transform 1.3s var(--ease), opacity .9s ease; }
  #ahr-{{ section.id }} .ahr__c circle { fill: var(--stone); stroke: var(--line); stroke-width: 1.5; mix-blend-mode: multiply; transition: fill .35s ease, stroke .35s ease; }
  #ahr-{{ section.id }} .ahr__c text { font: 700 21px 'Montserrat', sans-serif; fill: var(--ink); text-anchor: middle; }
  #ahr-{{ section.id }} .ahr__c .ahr__ic { fill: none; stroke: var(--btn); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  #ahr-{{ section.id }} .ahr__c.is-on circle { fill: var(--tint); stroke: rgba(238, 32, 74, .35); }
  #ahr-{{ section.id }} .ahr__you { transform-box: fill-box; transform-origin: center; transition: transform .6s cubic-bezier(.34, 1.56, .64, 1) .95s; }
  #ahr-{{ section.id }} .ahr__you circle { fill: var(--red); }
  #ahr-{{ section.id }} .ahr__you text { font: 800 20px 'Montserrat', sans-serif; fill: #fff; text-anchor: middle; }
  #ahr-{{ section.id }} .ahr__pulse { fill: none; stroke: var(--red); stroke-width: 2; opacity: 0; transform-box: fill-box; transform-origin: center; }
  #ahr-{{ section.id }}.is-live .ahr__pulse { animation: ahr-pulse-{{ section.id }} 2.6s ease-out 2s infinite; }
  @keyframes ahr-pulse-{{ section.id }} { 0% { opacity: .45; transform: scale(1); } 100% { opacity: 0; transform: scale(1.9); } }
  #ahr-{{ section.id }} .ahr__say { display: grid; min-height: 3.2em; margin: 6px auto 0; max-width: 30em; text-align: center; font: 500 15px/1.55 'Montserrat', sans-serif; color: var(--mute); }
  #ahr-{{ section.id }} .ahr__say p { grid-area: 1 / 1; margin: 0; opacity: 0; transition: opacity .3s ease; }
  #ahr-{{ section.id }} .ahr__say p.is-on { opacity: 1; }
  #ahr-{{ section.id }} .ahr__say b { color: var(--ink); }

  /* Before the entrance (only set when the animation can run) */
  #ahr-{{ section.id }}.pre .ahr__c { opacity: 0; transform: translate(var(--x), var(--y)); }
  #ahr-{{ section.id }}.pre .ahr__you { transform: scale(0); }

  @media (max-width: 1099.98px) {
    #ahr-{{ section.id }} .ahr__btn { height: 54px; padding: 0 28px; font-size: 16px; }
  }
  @media (max-width: 749.98px) {
    #ahr-{{ section.id }} .ahr__in { grid-template-columns: minmax(0, 1fr); gap: 28px; padding: 32px 16px 40px; text-align: center; }
    #ahr-{{ section.id }} .ahr__h { font-size: clamp(32px, 9vw, 42px); margin-bottom: 14px; }
    #ahr-{{ section.id }} .ahr__sub { margin: 0 auto; font-size: 16px; }
    #ahr-{{ section.id }} .ahr__cta { justify-content: center; margin-top: 24px; flex-direction: column; }
    #ahr-{{ section.id }} .ahr__btn { width: 100%; justify-content: center; }
    #ahr-{{ section.id }} .ahr__art { max-width: 380px; }
    #ahr-{{ section.id }} .ahr__say { font-size: 14px; }
    #ahr-{{ section.id }} .tp { margin-top: 20px; }
  }
  @media (min-width: 1680px) { #ahr-{{ section.id }} .ahr__in { zoom: 1.12; } }
  @media (min-width: 1920px) { #ahr-{{ section.id }} .ahr__in { zoom: 1.25; } }
  @media (min-width: 2560px) { #ahr-{{ section.id }} .ahr__in { zoom: 1.65; } }
  @media (min-width: 3200px) { #ahr-{{ section.id }} .ahr__in { zoom: 2; } }
  @media (prefers-reduced-motion: reduce) {
    #ahr-{{ section.id }} .ahr__c, #ahr-{{ section.id }} .ahr__you { transition: none; }
    #ahr-{{ section.id }}.is-live .ahr__pulse { animation: none; }
  }
</style>

<section id="ahr-{{ section.id }}">
  <script>if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) document.currentScript.parentNode.classList.add('pre');</script>
  <div class="ahr__in">
    <div class="ahr__copy">
      {%- if s.kicker != blank -%}<p class="ahr__kick">{{ s.kicker }}</p>{%- endif -%}
      <h1 class="ahr__h">{{ s.heading }}</h1>
      {%- if s.subheading != blank -%}<p class="ahr__sub">{{ s.subheading }}</p>{%- endif -%}
      <div class="ahr__cta">
        {%- if s.button != blank -%}<a class="ahr__btn" href="{{ s.button_link | default: '#' }}">{{ s.button }}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>{%- endif -%}
        {%- if s.note != blank -%}<span class="ahr__note">{{ s.note }}</span>{%- endif -%}
      </div>
      {% render 'trust-proof', s: s, color: '#1d1d1d', ring: '#fff' %}
    </div>

    <div class="ahr__art">
      {%- comment -%} Centres sit 100 units from (300, 290): top, bottom-left, bottom-right. {%- endcomment -%}
      <svg class="ahr__svg" viewBox="40 20 520 500" role="img" aria-label="{{ s.ayur_name | escape }}, {{ s.homeo_name | escape }} and {{ s.modern_name | escape }} overlap, and the overlap is {{ s.you_label | escape }}">
        <g class="ahr__c" data-k="ayur" tabindex="0" role="button" aria-label="{{ s.ayur_name | escape }}" style="--x: 0px; --y: -80px; transition-delay: 0s">
          <circle cx="300" cy="190" r="150"/>
          <svg class="ahr__ic" x="286" y="76" width="28" height="28" viewBox="0 0 24 24"><path d="M5 19c0-8 5-13 15-14-1 10-6 15-14 15"/><path d="M5 19c3-4 6-7 10-9"/></svg>
          <text x="300" y="130">{{ s.ayur_name }}</text>
        </g>
        <g class="ahr__c" data-k="homeo" tabindex="0" role="button" aria-label="{{ s.homeo_name | escape }}" style="--x: -70px; --y: 40px; transition-delay: .12s">
          <circle cx="213.4" cy="340" r="150"/>
          <svg class="ahr__ic" x="146" y="360" width="28" height="28" viewBox="0 0 24 24"><path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"/><path d="M9.5 15a2.5 2.5 0 0 0 2.5 2.5"/></svg>
          <text x="160" y="414">{{ s.homeo_name }}</text>
        </g>
        <g class="ahr__c" data-k="modern" tabindex="0" role="button" aria-label="{{ s.modern_name | escape }}" style="--x: 70px; --y: 40px; transition-delay: .24s">
          <circle cx="386.6" cy="340" r="150"/>
          <svg class="ahr__ic" x="426" y="360" width="28" height="28" viewBox="0 0 24 24"><rect x="3" y="8.5" width="18" height="7" rx="3.5" transform="rotate(-45 12 12)"/><path d="m9.5 9.5 5 5"/></svg>
          <text x="440" y="414">{{ s.modern_name }}</text>
        </g>
        <circle class="ahr__pulse" cx="300" cy="290" r="44"/>
        <g class="ahr__you">
          <circle cx="300" cy="290" r="44"/>
          <text x="300" y="297">{{ s.you_label }}</text>
        </g>
      </svg>
      <div class="ahr__say" aria-live="polite">
        <p data-k="you" class="is-on">{{ s.you_text }}</p>
        <p data-k="ayur"><b>{{ s.ayur_name }}:</b> {{ s.ayur_text }}</p>
        <p data-k="homeo"><b>{{ s.homeo_name }}:</b> {{ s.homeo_text }}</p>
        <p data-k="modern"><b>{{ s.modern_name }}:</b> {{ s.modern_text }}</p>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('ahr-{{ section.id }}');
    if (!root) return;
    var circles = root.querySelectorAll('.ahr__c'), lines = root.querySelectorAll('.ahr__say p');
    var picked = null;
    function show(k) {
      circles.forEach(function (c) { c.classList.toggle('is-on', c.dataset.k === k); });
      lines.forEach(function (p) { p.classList.toggle('is-on', p.dataset.k === (k || 'you')); });
    }
    circles.forEach(function (c) {
      c.addEventListener('mouseenter', function () { show(c.dataset.k); });
      c.addEventListener('mouseleave', function () { show(picked); });
      c.addEventListener('focus', function () { show(c.dataset.k); });
      c.addEventListener('blur', function () { show(picked); });
      // Tap (phones) keeps the choice; tapping it again goes back to "You".
      c.addEventListener('click', function () { picked = picked === c.dataset.k ? null : c.dataset.k; show(picked); });
      c.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); c.click(); } });
    });

    if (!('IntersectionObserver' in window)) { root.classList.remove('pre'); return; }
    var art = root.querySelector('.ahr__art');
    // Entrance once; the pulse only runs while the drawing is on screen.
    new IntersectionObserver(function (es) {
      var on = es[0].isIntersecting;
      if (on && root.classList.contains('pre')) requestAnimationFrame(function () { requestAnimationFrame(function () { root.classList.remove('pre'); }); });
      root.classList.toggle('is-live', on);
    }, { threshold: .25 }).observe(art);
  })();
</script>

{% schema %}
{
  "name": "About: hero",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small line above", "default": "About sehatUP" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Healthcare that finally makes sense." },
    { "type": "textarea", "id": "subheading", "label": "Line under it", "default": "India's first digital clinic where doctors from Ayurveda, Homeopathy and Modern medicine work together for you." },
    { "type": "text", "id": "button", "label": "Button", "default": "Start your wellness plan" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "note", "label": "Line next to the button", "default": "Free Health Score. 2 minutes." },
    { "type": "header", "content": "Trust line" },
    { "type": "text", "id": "trust_text", "label": "Trust line", "info": "Empty hides faces, line and stars." },
    { "type": "text", "id": "rating", "label": "Rating" },
    { "type": "range", "id": "trust_count", "label": "Faces", "min": 0, "max": 5, "step": 1, "default": 4 },
    { "type": "text", "id": "trust_initials", "label": "Initials when a face has no photo", "default": "R, A, S, P, K" },
    { "type": "image_picker", "id": "avatar_1", "label": "Face 1" },
    { "type": "image_picker", "id": "avatar_2", "label": "Face 2" },
    { "type": "image_picker", "id": "avatar_3", "label": "Face 3" },
    { "type": "image_picker", "id": "avatar_4", "label": "Face 4" },
    { "type": "image_picker", "id": "avatar_5", "label": "Face 5" },
    { "type": "header", "content": "Drawing" },
    { "type": "text", "id": "you_label", "label": "Middle label", "default": "You" },
    { "type": "text", "id": "you_text", "label": "Line under the drawing", "default": "Three systems, one plan, built around you. Tap a circle to see what each one does." },
    { "type": "text", "id": "ayur_name", "label": "Circle 1", "default": "Ayurveda" },
    { "type": "text", "id": "ayur_text", "label": "Circle 1 line", "default": "balance from the root, for hormones, digestion and metabolism." },
    { "type": "text", "id": "homeo_name", "label": "Circle 2", "default": "Homeopathy" },
    { "type": "text", "id": "homeo_text", "label": "Circle 2 line", "default": "gentle remedies matched to you, for steady long-term care." },
    { "type": "text", "id": "modern_name", "label": "Circle 3", "default": "Modern medicine" },
    { "type": "text", "id": "modern_text", "label": "Circle 3 line", "default": "clear diagnosis and faster relief, only when a doctor says it fits." },
    { "type": "color", "id": "accent_color", "label": "Accent colour", "default": "#ee204a" }
  ],
  "presets": [{ "name": "About: hero" }]
}
{% endschema %}
