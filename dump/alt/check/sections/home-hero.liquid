{%- comment -%}
  Home hero. Copy on the left: the heading ends on a concern that changes
  every few seconds (weight gain, irregular periods, low stamina...), in a
  fixed one-line slot so nothing below it moves. On the right the three
  experts stand together on a stone panel (transparent cut-outs), each with
  a small system label, plus one card about the doctor call.
  Phones: one column, panel under the copy.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign words = s.concerns | newline_to_br | split: '<br />'
-%}
<style>
  #hhr-{{ section.id }} {
    --ink: #1d1d1d; --mute: #5f5a56; --stone: #f6f0ec; --line: #e8e0d9; --red: #ee204a; --btn: #d81f48;
    --ease: cubic-bezier(.22, 1, .36, 1);
    background: #fff; color: var(--ink); font-family: 'Montserrat', sans-serif; overflow-x: clip;
  }
  #hhr-{{ section.id }} * { box-sizing: border-box; }
  #hhr-{{ section.id }} .hhr__in { max-width: 1240px; margin: 0 auto; padding: clamp(32px, 4vw, 72px) clamp(16px, 4vw, 48px) clamp(40px, 5vw, 88px); display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 72px); align-items: center; }
  #hhr-{{ section.id }} .hhr__kick { margin: 0 0 18px; font: 700 15px/1.3 'Montserrat', sans-serif; color: var(--btn); }
  #hhr-{{ section.id }} .hhr__h { margin: 0 0 22px; color: var(--ink); font: 800 clamp(34px, 3.8vw, 58px)/1.06 'Montserrat', sans-serif; letter-spacing: -.03em; }
  #hhr-{{ section.id }} .hhr__rot { display: grid; height: 1.12em; overflow: hidden; color: var(--btn); }
  #hhr-{{ section.id }} .hhr__rot span { grid-area: 1 / 1; white-space: nowrap; transform: translateY(100%); opacity: 0; transition: transform .7s var(--ease), opacity .5s ease; }
  #hhr-{{ section.id }} .hhr__rot span.on { transform: none; opacity: 1; }
  #hhr-{{ section.id }} .hhr__rot span.out { transform: translateY(-100%); opacity: 0; }
  #hhr-{{ section.id }} .hhr__sub { margin: 0; max-width: 33em; font: 400 clamp(16px, 1.3vw, 19px)/1.6 'Montserrat', sans-serif; color: var(--mute); text-wrap: pretty; }
  #hhr-{{ section.id }} .hhr__cta { margin-top: 32px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 14px; }
  #hhr-{{ section.id }} .hhr__btn, #hhr-{{ section.id }} .hhr__alt { display: inline-flex; align-items: center; justify-content: center; gap: 10px; height: 58px; padding: 0 30px; border-radius: 999px; text-decoration: none; font: 700 16.5px/1 'Montserrat', sans-serif; transition: background-color .2s, border-color .2s, transform .2s; }
  #hhr-{{ section.id }} .hhr__btn { background: var(--btn); color: #fff; }
  #hhr-{{ section.id }} .hhr__alt { border: 1.5px solid var(--line); color: var(--ink); background: #fff; }
  @media (hover: hover) {
    #hhr-{{ section.id }} .hhr__btn:hover { background: #c11a3f; color: #fff; }
    #hhr-{{ section.id }} .hhr__alt:hover { border-color: var(--ink); }
    #hhr-{{ section.id }} .hhr__btn:hover svg { transform: translateX(3px); }
  }
  #hhr-{{ section.id }} .hhr__btn svg { width: .9em; height: .9em; transition: transform .2s; }
  #hhr-{{ section.id }} .hhr__alt svg { width: 19px; height: 19px; fill: currentColor; }
  #hhr-{{ section.id }} a:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  #hhr-{{ section.id }} .hhr__note { margin: 14px 0 0; font: 500 14px/1.4 'Montserrat', sans-serif; color: var(--mute); }

  /* The experts */
  #hhr-{{ section.id }} .hhr__art { position: relative; width: 100%; max-width: 580px; aspect-ratio: 1 / 1; margin: 0 auto; border-radius: 32px; background: var(--stone); overflow: hidden; }
  #hhr-{{ section.id }} .hhr__doc { position: absolute; bottom: 0; height: 74%; width: auto; max-width: none; transition: transform 1.1s var(--ease), opacity .8s ease; }
  #hhr-{{ section.id }} .hhr__doc.d1 { left: -10%; }
  #hhr-{{ section.id }} .hhr__doc.d3 { right: -10%; }
  #hhr-{{ section.id }} .hhr__doc.d2 { z-index: 1; left: 50%; height: 90%; transform: translateX(-50%); }
  #hhr-{{ section.id }} .hhr__tag { position: absolute; z-index: 2; display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: 999px; background: #fff; font: 600 13.5px/1 'Montserrat', sans-serif; color: var(--ink); box-shadow: 0 6px 18px rgba(60, 40, 30, .08); transition: transform .6s cubic-bezier(.34, 1.56, .64, 1), opacity .4s ease; }
  #hhr-{{ section.id }} .hhr__tag::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--red); }
  #hhr-{{ section.id }} .hhr__tag.t1 { left: 5%; top: 30%; }
  #hhr-{{ section.id }} .hhr__tag.t2 { left: 58%; top: 7%; }
  #hhr-{{ section.id }} .hhr__tag.t3 { right: 5%; top: 30%; }
  #hhr-{{ section.id }} .hhr__card { position: absolute; z-index: 2; left: 50%; bottom: 5%; width: max-content; max-width: 88%; transform: translateX(-50%); display: flex; align-items: center; gap: 12px; padding: 14px 18px; border-radius: 18px; background: #fff; box-shadow: 0 10px 30px rgba(60, 40, 30, .1); transition: transform .9s var(--ease), opacity .6s ease; }
  #hhr-{{ section.id }} .hhr__card i { flex: none; width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; background: #fdecef; color: var(--btn); }
  #hhr-{{ section.id }} .hhr__card i svg { width: 18px; height: 18px; }
  #hhr-{{ section.id }} .hhr__card b { display: block; font: 700 14.5px/1.3 'Montserrat', sans-serif; }
  #hhr-{{ section.id }} .hhr__card span { display: block; margin-top: 2px; font: 500 13px/1.3 'Montserrat', sans-serif; color: var(--mute); }

  /* Entrance, only when it can run */
  #hhr-{{ section.id }}.pre .hhr__doc { opacity: 0; transform: translateY(40px); }
  #hhr-{{ section.id }}.pre .hhr__doc.d2 { transform: translate(-50%, 40px); }
  #hhr-{{ section.id }}.pre .hhr__tag { opacity: 0; transform: scale(.7); }
  #hhr-{{ section.id }}.pre .hhr__card { opacity: 0; transform: translate(-50%, 24px); }
  #hhr-{{ section.id }} .hhr__doc.d1 { transition-delay: .15s; }
  #hhr-{{ section.id }} .hhr__doc.d3 { transition-delay: .25s; }
  #hhr-{{ section.id }} .hhr__tag.t2 { transition-delay: .7s; }
  #hhr-{{ section.id }} .hhr__tag.t1 { transition-delay: .82s; }
  #hhr-{{ section.id }} .hhr__tag.t3 { transition-delay: .94s; }
  #hhr-{{ section.id }} .hhr__card { transition-delay: 1.1s; }

  @media (max-width: 1099.98px) {
    #hhr-{{ section.id }} .hhr__btn, #hhr-{{ section.id }} .hhr__alt { height: 54px; padding: 0 24px; font-size: 15.5px; }
    #hhr-{{ section.id }} .hhr__tag { font-size: 12.5px; padding: 7px 12px; }
  }
  @media (max-width: 749.98px) {
    #hhr-{{ section.id }} .hhr__in { grid-template-columns: minmax(0, 1fr); gap: 28px; padding: 24px 16px 40px; text-align: center; }
    #hhr-{{ section.id }} .hhr__kick { margin-bottom: 12px; font-size: 13.5px; }
    #hhr-{{ section.id }} .hhr__h { font-size: clamp(28px, 8.2vw, 38px); margin-bottom: 14px; }
    #hhr-{{ section.id }} .hhr__sub { margin: 0 auto; font-size: 15.5px; }
    #hhr-{{ section.id }} .hhr__cta { flex-direction: column; margin-top: 22px; }
    #hhr-{{ section.id }} .hhr__btn, #hhr-{{ section.id }} .hhr__alt { width: 100%; }
    #hhr-{{ section.id }} .tp { margin-top: 18px; }
    #hhr-{{ section.id }} .hhr__art { max-width: 440px; aspect-ratio: 1 / .92; border-radius: 26px; }
    #hhr-{{ section.id }} .hhr__card { padding: 10px 14px; gap: 10px; }
    #hhr-{{ section.id }} .hhr__card i { width: 30px; height: 30px; }
    #hhr-{{ section.id }} .hhr__card b { font-size: 13px; }
    #hhr-{{ section.id }} .hhr__card span { font-size: 12px; }
    #hhr-{{ section.id }} .hhr__tag { font-size: 11.5px; padding: 6px 10px; gap: 6px; }
  }
  @media (min-width: 1680px) { #hhr-{{ section.id }} .hhr__in { zoom: 1.12; } }
  @media (min-width: 1920px) { #hhr-{{ section.id }} .hhr__in { zoom: 1.25; } }
  @media (min-width: 2560px) { #hhr-{{ section.id }} .hhr__in { zoom: 1.65; } }
  @media (min-width: 3200px) { #hhr-{{ section.id }} .hhr__in { zoom: 2; } }
  @media (prefers-reduced-motion: reduce) {
    #hhr-{{ section.id }} * { transition: none !important; }
  }
</style>

<section id="hhr-{{ section.id }}">
  <script>if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) document.currentScript.parentNode.classList.add('pre');</script>
  <div class="hhr__in">
    <div class="hhr__copy">
      {%- if s.kicker != blank -%}<p class="hhr__kick">{{ s.kicker }}</p>{%- endif -%}
      <h1 class="hhr__h">
        {{ s.heading }}
        {%- if words.size > 0 -%}
          <span class="hhr__rot" aria-hidden="true">
            {%- for w in words -%}{%- assign word = w | strip -%}{%- if word != blank -%}<span{% if forloop.first %} class="on"{% endif %}>{{ word }}</span>{%- endif -%}{%- endfor -%}
          </span>
          <span class="visually-hidden"> {{ s.heading_end }}</span>
        {%- endif -%}
      </h1>
      {%- if s.subheading != blank -%}<p class="hhr__sub">{{ s.subheading }}</p>{%- endif -%}
      <div class="hhr__cta">
        {%- if s.button != blank -%}<a class="hhr__btn" href="{{ s.button_link | default: '#' }}">{{ s.button }}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>{%- endif -%}
        {%- if s.button_2 != blank -%}
          <a class="hhr__alt" href="{{ s.button_2_link | default: '#' }}"{% if s.button_2_link contains 'wa.me' %} target="_blank" rel="noopener"{% endif %}>
            {%- if s.button_2_link contains 'wa.me' -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.7a2.8 2.8 0 0 0 1.8-1.3 2.3 2.3 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3z"/></svg>{%- endif -%}
            {{ s.button_2 }}
          </a>
        {%- endif -%}
      </div>
      {%- if s.note != blank -%}<p class="hhr__note">{{ s.note }}</p>{%- endif -%}
      {% render 'trust-proof', s: s, color: '#1d1d1d', ring: '#fff' %}
    </div>

    <div class="hhr__art">
      {%- for i in (1..3) -%}
        {%- assign pk = 'doc_' | append: i | append: '_photo' -%}
        {%- assign lk = 'doc_' | append: i | append: '_label' -%}
        {%- if s[pk] != blank -%}
          <img class="hhr__doc d{{ i }}" src="{{ s[pk] | image_url: width: 800 }}"
               srcset="{{ s[pk] | image_url: width: 500 }} 500w, {{ s[pk] | image_url: width: 800 }} 800w, {{ s[pk] | image_url: width: 1100 }} 1100w"
               sizes="(max-width: 749.98px) 70vw, 420px" alt="{{ s[pk].alt | escape }}" fetchpriority="{% if i == 2 %}high{% else %}auto{% endif %}" loading="eager"
               width="800" height="{{ 800 | divided_by: s[pk].aspect_ratio | round }}">
        {%- endif -%}
        {%- if s[lk] != blank -%}<span class="hhr__tag t{{ i }}">{{ s[lk] }}</span>{%- endif -%}
      {%- endfor -%}
      {%- if s.card_title != blank -%}
        <div class="hhr__card">
          <i aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg></i>
          <div><b>{{ s.card_title }}</b>{%- if s.card_text != blank -%}<span>{{ s.card_text }}</span>{%- endif -%}</div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('hhr-{{ section.id }}');
    if (!root) return;
    var words = [].slice.call(root.querySelectorAll('.hhr__rot span'));
    var cur = 0, live = true, still = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // One concern at a time, every few seconds, only while the hero is on screen.
    if (words.length > 1 && !still) setInterval(function () {
      if (!live || document.hidden) return;
      var old = words[cur];
      cur = (cur + 1) % words.length;
      old.className = 'out';
      words[cur].className = '';
      void words[cur].offsetWidth;
      words[cur].className = 'on';
      setTimeout(function () { if (old !== words[cur]) old.className = ''; }, 800);
    }, 2600);

    if (!('IntersectionObserver' in window)) return;
    new IntersectionObserver(function (es) {
      live = es[0].isIntersecting;
      if (live && root.classList.contains('pre')) requestAnimationFrame(function () { requestAnimationFrame(function () { root.classList.remove('pre'); }); });
    }, { threshold: .15 }).observe(root);
  })();
</script>

{% schema %}
{
  "name": "Home: hero",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small line above", "default": "India's first integrated digital health clinic" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find the real cause of your" },
    { "type": "textarea", "id": "concerns", "label": "Changing words", "info": "One per line. They take turns at the end of the heading.", "default": "weight gain\nirregular periods\nlow stamina\npoor sleep\nconstant stress" },
    { "type": "text", "id": "heading_end", "label": "Heading ending for screen readers", "default": "health concerns" },
    { "type": "textarea", "id": "subheading", "label": "Line under it" },
    { "type": "text", "id": "button", "label": "Button", "default": "Take the free Health Score" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button_2", "label": "Second button", "default": "Talk to a doctor" },
    { "type": "url", "id": "button_2_link", "label": "Second button link", "info": "A wa.me link shows the WhatsApp icon." },
    { "type": "text", "id": "note", "label": "Line under the buttons", "default": "2 minutes. Free. No sign-up." },
    { "type": "header", "content": "Trust line" },
    { "type": "text", "id": "trust_text", "label": "Trust line", "info": "Empty hides faces, line and stars." },
    { "type": "text", "id": "rating", "label": "Rating" },
    { "type": "range", "id": "trust_count", "label": "Faces", "min": 0, "max": 5, "step": 1, "default": 4 },
    { "type": "text", "id": "trust_initials", "label": "Initials when a face has no photo", "default": "R, A, S, P, K" },
    { "type": "image_picker", "id": "avatar_1", "label": "Face 1" },
    { "type": "image_picker", "id": "avatar_2", "label": "Face 2" },
    { "type": "image_picker", "id": "avatar_3", "label": "Face 3" },
    { "type": "image_picker", "id": "avatar_4", "label": "Face 4" },
    { "type": "image_picker", "id": "avatar_5", "label": "Face 5" },
    { "type": "header", "content": "Experts", "info": "Cut-out photos with a transparent background. The middle one stands in front." },
    { "type": "image_picker", "id": "doc_1_photo", "label": "Left photo" },
    { "type": "text", "id": "doc_1_label", "label": "Left label", "default": "Homeopathy" },
    { "type": "image_picker", "id": "doc_2_photo", "label": "Middle photo" },
    { "type": "text", "id": "doc_2_label", "label": "Middle label", "default": "Ayurveda" },
    { "type": "image_picker", "id": "doc_3_photo", "label": "Right photo" },
    { "type": "text", "id": "doc_3_label", "label": "Right label", "default": "Psychology" },
    { "type": "text", "id": "card_title", "label": "Card title", "default": "A doctor calls you within 24 hours" },
    { "type": "text", "id": "card_text", "label": "Card line", "default": "In Hindi or English, at a time that suits you" }
  ],
  "presets": [{ "name": "Home: hero" }]
}
{% endschema %}
