{%- comment -%}
  Trust strip + real reviews.

  Four short promises (editable, since each one must be true for the
  business), then an app-block slot for Judge.me's own Featured Carousel,
  so the reviews are the store's real, moderated Judge.me reviews and stay
  in sync by themselves. No review text is ever hardcoded here.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
-%}

{%- comment -%} Styles first, so the browser never paints this section unstyled. {%- endcomment -%}
<style>
  #htr-{{ section.id }} { --htr-text: #1d1d1d; --htr-muted: #5c5c5c; --htr-accent: {{ s.accent_color }}; background: #fff; font-family: 'Montserrat', sans-serif; color: var(--htr-text); }
  #htr-{{ section.id }} .htr__inner { max-width: 1160px; margin: 0 auto; padding: 48px 24px 72px; }
  #htr-{{ section.id }} .htr__head { text-align: center; max-width: 640px; margin: 0 auto 36px; }
  #htr-{{ section.id }} .htr__heading { color: var(--htr-text); margin: 0 0 12px; font: 800 clamp(28px, 3.4vw, 46px)/1.08 'Montserrat', sans-serif; letter-spacing: -.02em; text-wrap: balance; }
  #htr-{{ section.id }} .htr__sub { margin: 0; font: 400 16px/1.55 'Montserrat', sans-serif; color: var(--htr-muted); }

  #htr-{{ section.id }} .htr__strip {
    list-style: none; margin: 0 0 48px; padding: 22px 26px; border-radius: 22px; background: #faf7f5;
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px;
  }
  #htr-{{ section.id }} .htr__item { display: flex; align-items: center; gap: 14px; }
  #htr-{{ section.id }} .htr__icon { flex: none; width: 26px; height: 26px; color: var(--htr-accent); }
  #htr-{{ section.id }} .htr__icon svg { width: 100%; height: 100%; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  #htr-{{ section.id }} .htr__txt { display: grid; gap: 3px; }
  #htr-{{ section.id }} .htr__txt b { font: 700 15px/1.2 'Montserrat', sans-serif; }
  #htr-{{ section.id }} .htr__txt small { font: 400 12.5px/1.35 'Montserrat', sans-serif; color: var(--htr-muted); }

  #htr-{{ section.id }} .htr__rating {
    display: inline-flex; align-items: center; gap: 8px; margin: 16px 0 0; padding: 8px 16px; border-radius: 999px;
    background: #faf7f5; font: 600 14px/1 'Montserrat', sans-serif; color: var(--htr-text);
  }
  #htr-{{ section.id }} .htr__rating[hidden] { display: none; }
  #htr-{{ section.id }} .htr__rating i { font-style: normal; color: #f5a623; letter-spacing: 1px; }
  /* The rating now sits in our header; Judge.me's own title row would repeat it. */
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-title-and-link { display: none !important; }

  /* Judge.me carousel, restyled from the outside. The app sizes each item and
     slides the row with transforms, so item widths are left alone: the card
     look is a ::before inset inside each item, the gutters live in padding. */
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-wrapper { width: auto; margin: 0 -10px; padding: 0; }
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel__item-container,
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel__item-wrapper { height: auto !important; }
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-item {
    position: relative; isolation: isolate; display: inline-flex; flex-direction: column; vertical-align: top;
    height: 264px; padding: 24px 34px 22px; white-space: normal; text-align: left;
  }
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-item::before {
    content: ""; position: absolute; inset: 0 10px; z-index: -1; border-radius: 20px;
    background: #faf7f5; border: 1px solid #efe7e2;
  }
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-item__product-image {
    position: absolute; top: 22px; right: 32px; width: 56px; height: 56px; margin: 0;
    border-radius: 14px; object-fit: cover; background: #fff; font-size: 0; color: transparent; overflow: hidden; box-shadow: 0 4px 12px rgba(60, 30, 20, .08);
  }
  /* Judge.me lazy-loads these from data-src, so only hide an image that has no photo at all. */
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-item__product-image:not([src]):not([data-src]),
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-item__product-image[src=""][data-src=""] { display: none; }
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-item__review-wrapper { display: flex; flex-direction: column; flex: 1; width: 100%; height: auto; padding: 0; min-height: 0; }
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-item__review { height: auto; flex: 1; min-height: 0; overflow: hidden; }
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-item__review-rating { padding-right: 64px; margin-bottom: 14px; }
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-item .jdgm-star { color: #f5a623 !important; font-size: 15px; }
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-item__review-title { padding-right: 64px; margin-bottom: 6px; font: 700 16px/1.35 'Montserrat', sans-serif !important; color: var(--htr-text); }
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-item__review-body,
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-item__review-body p { margin: 0; font: 400 14px/1.55 'Montserrat', sans-serif !important; color: var(--htr-muted); }
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-item__reviewer-name-wrapper {
    display: flex; align-items: baseline; gap: 8px; margin-top: 14px; padding-top: 12px; border-top: 1px solid #ebe3dd; width: auto;
  }
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-item__reviewer-name { flex: none; font: 700 13px/1.3 'Montserrat', sans-serif; color: var(--htr-text); }
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-item__product { flex: 1; min-width: 0; height: auto !important; max-height: none !important; line-height: 1.3; text-decoration: none; }
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-item__product-title { font: 600 12.5px/1.3 'Montserrat', sans-serif; color: var(--htr-accent); }
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-item__product-title::before { content: "on "; color: var(--htr-muted); font-weight: 500; }
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-item__timestamp { display: none; }
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel__arrows { margin-top: 24px; display: flex; justify-content: center; align-items: center; gap: 10px; }
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel__left-arrow,
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel__right-arrow {
    width: 44px; height: 44px; margin: 0; border-radius: 50%; border: 1.5px solid #e8e0d9; background-color: #fff;
    background-position: center; transform: none !important; display: grid; place-items: center; cursor: pointer; transition: border-color .2s ease;
  }
  /* Our own chevrons: the app ships its arrows without a visible icon here. */
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel__left-arrow::before,
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel__right-arrow::before {
    content: "" !important; display: block; width: 9px; height: 9px; border: solid var(--htr-text); border-width: 2px 2px 0 0; transform: translateX(-2px) rotate(45deg);
  }
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel__left-arrow::before { transform: translateX(2px) rotate(-135deg); }
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel__left-arrow:hover,
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel__right-arrow:hover { border-color: var(--htr-accent); }

  @media (max-width: 1023px) {
    #htr-{{ section.id }} .htr__strip { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 749px) {
    #htr-{{ section.id }} .htr__inner { padding: 32px 16px 48px; }
    #htr-{{ section.id }} .htr__heading { font-size: 28px; }
    #htr-{{ section.id }} .htr__sub { font-size: 14.5px; }
    #htr-{{ section.id }} .htr__strip { padding: 18px 16px; gap: 16px 12px; margin-bottom: 32px; border-radius: 18px; }
    #htr-{{ section.id }} .htr__item { gap: 10px; align-items: flex-start; }
    #htr-{{ section.id }} .htr__icon { width: 22px; height: 22px; }
    #htr-{{ section.id }} .htr__txt b { font-size: 13.5px; }
    #htr-{{ section.id }} .htr__txt small { font-size: 11.5px; }
  }

  /* Big screens: scale the whole section in proportion, so 1920-3840px
     monitors get a page sized for them instead of a 1200px island. */
  @media (min-width: 1680px) { #htr-{{ section.id }} .htr__inner { zoom: 1.12; } }
  @media (min-width: 1920px) { #htr-{{ section.id }} .htr__inner { zoom: 1.25; } }
  @media (min-width: 2240px) { #htr-{{ section.id }} .htr__inner { zoom: 1.45; } }
  @media (min-width: 2560px) { #htr-{{ section.id }} .htr__inner { zoom: 1.65; } }
  @media (min-width: 3200px) { #htr-{{ section.id }} .htr__inner { zoom: 2; } }
  @media (min-width: 3840px) { #htr-{{ section.id }} .htr__inner { zoom: 2.4; } }
</style>

<section id="htr-{{ section.id }}" class="htr">
  <span id="reviews" class="sh-anchor" style="display:block;position:relative;top:-90px;height:0;visibility:hidden" aria-hidden="true"></span>
  <div class="htr__inner">
    <div class="htr__head">
      <h2 class="htr__heading">{{ s.heading }}</h2>
      {%- if s.subheading != blank -%}<p class="htr__sub">{{ s.subheading }}</p>{%- endif -%}
      {%- if s.rating_line != blank -%}<p class="htr__rating" data-rating data-line="{{ s.rating_line | escape }}" hidden></p>{%- endif -%}
    </div>

    {%- if s.trust_1 != blank or s.trust_2 != blank or s.trust_3 != blank or s.trust_4 != blank -%}
    <ul class="htr__strip">
      {%- for i in (1..4) -%}
        {%- capture k_t -%}trust_{{ i }}{%- endcapture -%}
        {%- capture k_d -%}trust_{{ i }}_text{%- endcapture -%}
        {%- if s[k_t] != blank -%}
          <li class="htr__item">
            <span class="htr__icon" aria-hidden="true">
              {%- case i -%}
                {%- when 1 -%}<svg viewBox="0 0 24 24"><path d="M20 12v8H4v-8M2 7h20v5H2zM12 22V7M12 7H7.5a2.5 2.5 0 1 1 0-5C11 2 12 7 12 7zM12 7h4.5a2.5 2.5 0 1 0 0-5C13 2 12 7 12 7z"/></svg>
                {%- when 2 -%}<svg viewBox="0 0 24 24"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                {%- when 3 -%}<svg viewBox="0 0 24 24"><path d="M21 8 12 3 3 8v8l9 5 9-5zM3 8l9 5 9-5M12 13v8"/></svg>
                {%- else -%}<svg viewBox="0 0 24 24"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/><path d="M6 10v4M18 10v4"/></svg>
              {%- endcase -%}
            </span>
            <span class="htr__txt"><b>{{ s[k_t] }}</b>{%- if s[k_d] != blank -%}<small>{{ s[k_d] }}</small>{%- endif -%}</span>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
    {%- endif -%}

    <div class="htr__reviews">
      {%- comment -%} Picked products: only their reviews (shared snippet). Otherwise the Judge.me app block. {%- endcomment -%}
      {%- if s.review_products != blank -%}
        {%- render 'sehat-jm-reviews', products: s.review_products, min: s.min_rating, max: 18, uid: section.id, hide: s.review_hide -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- render block -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>


<script>
  // Rating line: [rating] and [count] are filled from the Judge.me carousel in
  // this section (store-wide average and count) once it has rendered. Never
  // invented: if a placeholder can't be filled, the line stays hidden.
  (function () {
    var root = document.getElementById('htr-{{ section.id }}');
    if (!root) return;
    var out = root.querySelector('[data-rating]'), tries = 0;
    if (!out) return;
    var line = out.getAttribute('data-line');
    (function look() {
      var r = root.querySelector('.htr__reviews .jdgm-all-reviews-rating[data-score]');
      var c = root.querySelector('.htr__reviews .jdgm-all-reviews-rating-wrapper');
      var score = r && parseFloat(r.getAttribute('data-score'));
      var count = c && (c.textContent.match(/\d+/) || [])[0];
      var needR = line.indexOf('[rating]') > -1, needC = line.indexOf('[count]') > -1;
      if ((!needR || score) && (!needC || count)) {
        out.textContent = line.replace('[rating]', score ? score.toFixed(1) : '').replace('[count]', count || '');
        if (needR) out.insertAdjacentHTML('afterbegin', '<i>★★★★★</i>');
        out.hidden = false;
      } else if (++tries < 40) setTimeout(look, 500);
    })();
  })();
</script>

{% schema %}
{
  "name": "Trust and reviews",
  "tag": "div",
  "class": "section-health-trust",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real people. Real results." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Honest reviews from customers who took the first step." },
    { "type": "text", "id": "rating_line", "label": "Rating line", "default": "[rating] from [count] reviews", "info": "[rating] = live Judge.me average, [count] = number of reviews. e.g. [rating] · Trusted by 25,000+ patients. Empty hides the line." },
    { "type": "color", "id": "accent_color", "label": "Icon colour", "default": "#ee204a" },
    { "type": "product_list", "id": "review_products", "label": "Only reviews of these products", "limit": 20, "info": "Leave empty to use the Judge.me carousel block." },
    { "type": "range", "id": "min_rating", "label": "Lowest star rating to show", "min": 1, "max": 5, "step": 1, "default": 4 },
    { "type": "text", "id": "review_hide", "label": "Hide reviews containing", "info": "Words or phrases, comma separated. A review that contains any of them is skipped." },
    { "type": "header", "content": "Promises (only keep what is true)" },
    { "type": "text", "id": "trust_1", "label": "Promise 1", "default": "Free" },
    { "type": "text", "id": "trust_1_text", "label": "Promise 1 detail", "default": "The Health Score costs nothing" },
    { "type": "text", "id": "trust_2", "label": "Promise 2", "default": "100% private" },
    { "type": "text", "id": "trust_2_text", "label": "Promise 2 detail", "default": "Only your doctor sees your answers" },
    { "type": "text", "id": "trust_3", "label": "Promise 3", "default": "Discreet packaging" },
    { "type": "text", "id": "trust_3_text", "label": "Promise 3 detail", "default": "A plain box, nothing printed on it" },
    { "type": "text", "id": "trust_4", "label": "Promise 4", "default": "Just ₹50 to confirm" },
    { "type": "text", "id": "trust_4_text", "label": "Promise 4 detail", "default": "Pay the rest on delivery, or pay in full online" }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "Trust and reviews" }]
}
{% endschema %}
