{%- comment -%}
  "Free Health Score quizzes": two panels, For women and For men. Each panel
  has its person as a cut-out standing at the outer edge (head rising above
  the panel) looking toward their two quiz buttons. Phones swap the cut-out
  for the square photo as a round avatar next to the panel title.
  Motion: one entrance (panels rise, people rise a beat later, quiz buttons
  slide in), a slight lean of the person toward the pointer, and calm hover
  on the buttons.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sets = 'her,him' | split: ','
-%}
<style>
  #hcd-{{ section.id }} {
    --ink: #1d1d1d; --mute: #6b6b6b; --line: #e9e3dd; --stone: #f4f0ec; --stone2: #ede7e1;
    --red: {{ s.accent_color }}; --btn: {{ s.accent_color | color_darken: 8 }};
    --ease: cubic-bezier(.22, 1, .36, 1);
    background: #fbf9f7; color: var(--ink); font-family: 'Montserrat', sans-serif;
  }
  #hcd-{{ section.id }} * { box-sizing: border-box; }
  #hcd-{{ section.id }} .d__in { max-width: 1320px; margin: 0 auto; padding: clamp(44px, 4vw, 72px) 32px clamp(56px, 5vw, 88px); }

  /* centred: heading, then one line with the free tag leading the promise */
  #hcd-{{ section.id }} .d__head { display: flex; flex-direction: column; align-items: center; gap: 16px; text-align: center; }
  #hcd-{{ section.id }} .d__line { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 8px 14px; }
  #hcd-{{ section.id }} .d__badge { display: inline-flex; align-items: center; gap: 6px; height: 30px; padding: 0 14px 0 10px; border-radius: 999px; background: #fdeef1; color: var(--btn); font: 700 14px/1 'Montserrat', sans-serif; }
  #hcd-{{ section.id }} .d__badge svg { width: 16px; height: 16px; }
  #hcd-{{ section.id }} .d__h { margin: 0; color: var(--ink); font: 800 clamp(34px, 3.6vw, 60px)/1.05 'Montserrat', sans-serif; letter-spacing: -.035em; text-wrap: balance; }
  #hcd-{{ section.id }} .d__sub { margin: 0; font: 400 clamp(16px, 1.25vw, 21px)/1.5 'Montserrat', sans-serif; color: var(--mute); text-wrap: pretty; }

  /* two panels */
  #hcd-{{ section.id }} .d__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin-top: clamp(64px, 5vw, 84px); }
  #hcd-{{ section.id }} .d__panel {
    --lean-x: 0px; --lean-y: 0px;
    position: relative; display: flex; min-height: clamp(400px, 31vw, 470px);
    border-radius: 28px; background: var(--stone);
    transition: opacity .7s ease, transform .9s var(--ease), background .4s ease;
  }
  #hcd-{{ section.id }} .d__panel:hover { background: var(--stone2); }
  #hcd-{{ section.id }} .d__person {
    position: absolute; bottom: 0; height: calc(100% + 56px); width: auto; max-width: none;
    pointer-events: none; user-select: none;
    transform: translate(var(--lean-x), var(--lean-y)); transform-origin: 50% 100%;
    transition: transform .9s var(--ease), opacity .8s ease, filter .6s ease;
  }
  #hcd-{{ section.id }} .d__panel--her .d__person { left: 0; object-position: left bottom; }
  #hcd-{{ section.id }} .d__panel--him .d__person { right: 0; object-position: right bottom; }

  #hcd-{{ section.id }} .d__body { position: relative; z-index: 1; flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 14px; padding: 40px 32px; }
  /* the person takes the outer ~46%, the quizzes the rest (they may overlap a shoulder, never the face) */
  #hcd-{{ section.id }} .d__panel--her .d__body { margin-left: 46%; padding-left: 0; }
  #hcd-{{ section.id }} .d__panel--him .d__body { margin-right: 46%; padding-right: 0; }
  #hcd-{{ section.id }} .d__who { display: flex; align-items: center; gap: 12px; margin: 0 0 6px; font: 800 clamp(28px, 2.4vw, 40px)/1.05 'Montserrat', sans-serif; letter-spacing: -.03em; color: var(--ink); }
  #hcd-{{ section.id }} .d__ava { display: none; width: 64px; height: 64px; flex: none; border-radius: 50%; object-fit: cover; object-position: 50% 30%; background: var(--stone2); box-shadow: 0 0 0 3px #fff; }

  /* quiz button */
  #hcd-{{ section.id }} .d__quiz {
    display: flex; align-items: center; gap: 14px; padding: 16px 16px 16px 18px; border-radius: 18px;
    background: #fff; border: 1.5px solid transparent; color: var(--ink); text-decoration: none;
    box-shadow: 0 1px 0 rgba(29, 29, 29, .03), 0 8px 22px rgba(29, 29, 29, .05);
    transition: transform .45s var(--ease), border-color .3s ease, box-shadow .45s var(--ease), opacity .6s ease;
  }
  #hcd-{{ section.id }} .d__quiz:hover { transform: translateY(-3px); border-color: var(--btn); box-shadow: 0 16px 34px rgba(29, 29, 29, .09); }
  #hcd-{{ section.id }} .d__quiz:active { transform: scale(.98); transition-duration: .12s; }
  #hcd-{{ section.id }} .d__quiz:focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; }
  #hcd-{{ section.id }} .d__ico { display: grid; place-items: center; width: 44px; height: 44px; flex: none; border-radius: 12px; background: var(--stone); transition: background .3s ease, transform .45s var(--ease); }
  #hcd-{{ section.id }} .d__ico svg { width: 26px; height: 26px; fill: none; stroke: var(--ink); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; transition: stroke .3s ease; }
  #hcd-{{ section.id }} .d__ico .r { stroke: var(--red); }
  #hcd-{{ section.id }} .d__ico .rf { fill: var(--red); stroke: none; transition: fill .3s ease; }
  #hcd-{{ section.id }} .d__quiz:hover .d__ico { background: #fdeef1; transform: rotate(-6deg); }
  #hcd-{{ section.id }} .d__qb { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; }
  #hcd-{{ section.id }} .d__qt { font: 700 clamp(16px, 1.15vw, 19px)/1.2 'Montserrat', sans-serif; letter-spacing: -.01em; }
  #hcd-{{ section.id }} .d__qd { font: 400 clamp(13px, .9vw, 15px)/1.4 'Montserrat', sans-serif; color: var(--mute); }
  #hcd-{{ section.id }} .d__go { display: grid; place-items: center; width: 36px; height: 36px; flex: none; border-radius: 50%; background: var(--btn); color: #fff; box-shadow: 0 6px 14px rgba(219, 29, 68, .25); transition: transform .45s var(--ease), box-shadow .3s ease; }
  #hcd-{{ section.id }} .d__go svg { width: 16px; height: 16px; transition: transform .45s var(--ease); }
  #hcd-{{ section.id }} .d__quiz:hover .d__go { transform: scale(1.08); box-shadow: 0 8px 18px rgba(219, 29, 68, .32); }
  #hcd-{{ section.id }} .d__quiz:hover .d__go svg { transform: translateX(2px); }

  /* entrance, once (only added when motion is allowed) */
  #hcd-{{ section.id }}.pre .d__badge { opacity: 0; transform: scale(.8); }
  #hcd-{{ section.id }}.pre .d__h, #hcd-{{ section.id }}.pre .d__sub { opacity: 0; transform: translateY(14px); }
  #hcd-{{ section.id }}.pre .d__panel { opacity: 0; transform: translateY(32px); }
  #hcd-{{ section.id }}.pre .d__person { opacity: 0; transform: translateY(40px); filter: blur(4px); }
  #hcd-{{ section.id }}.pre .d__who { opacity: 0; transform: translateY(10px); }
  #hcd-{{ section.id }}.pre .d__panel--her .d__quiz { opacity: 0; transform: translateX(24px); }
  #hcd-{{ section.id }}.pre .d__panel--him .d__quiz { opacity: 0; transform: translateX(-24px); }
  #hcd-{{ section.id }}.in:not(.done) .d__badge { transition: opacity .5s ease .22s, transform .6s cubic-bezier(.34, 1.56, .64, 1) .22s; }
  #hcd-{{ section.id }}.in:not(.done) .d__h { transition: opacity .7s ease .08s, transform .8s var(--ease) .08s; }
  #hcd-{{ section.id }}.in:not(.done) .d__sub { transition: opacity .7s ease .16s, transform .8s var(--ease) .16s; }
  #hcd-{{ section.id }}.in:not(.done) .d__panel { transition-delay: calc(.2s + var(--p) * .12s); }
  #hcd-{{ section.id }}.in:not(.done) .d__person { transition: opacity .8s ease, transform 1s var(--ease), filter .8s ease; transition-delay: calc(.45s + var(--p) * .12s); }
  #hcd-{{ section.id }}.in:not(.done) .d__who { transition: opacity .6s ease, transform .7s var(--ease); transition-delay: calc(.55s + var(--p) * .12s); }
  #hcd-{{ section.id }}.in:not(.done) .d__quiz { transition: opacity .6s ease, transform .8s var(--ease); transition-delay: calc(.65s + var(--p) * .12s + var(--j) * .1s); }

  @media (min-width: 1400px) {
    #hcd-{{ section.id }} .d__panel--her .d__body { margin-left: 42%; }
    #hcd-{{ section.id }} .d__panel--him .d__body { margin-right: 42%; }
  }
  /* tablets: panels stack, people stay */
  @media (max-width: 1099px) {
    #hcd-{{ section.id }} .d__in { max-width: 680px; padding-left: 20px; padding-right: 20px; }
    #hcd-{{ section.id }} .d__grid { grid-template-columns: minmax(0, 1fr); gap: 72px; }
  }
  /* phones: round avatar instead of the cut-out */
  @media (max-width: 599px) {
    #hcd-{{ section.id }} .d__in { padding: 48px 16px; }
    #hcd-{{ section.id }} .d__badge { height: 30px; font-size: 13px; }
    #hcd-{{ section.id }} .d__head { gap: 12px; }
    #hcd-{{ section.id }} .d__grid { gap: 16px; margin-top: 32px; }
    #hcd-{{ section.id }} .d__panel { min-height: 0; border-radius: 22px; }
    #hcd-{{ section.id }} .d__person { display: none; }
    #hcd-{{ section.id }} .d__ava { display: block; }
    #hcd-{{ section.id }} .d__panel--her .d__body, #hcd-{{ section.id }} .d__panel--him .d__body { margin: 0; width: 100%; padding: 20px 16px 16px; gap: 10px; }
    #hcd-{{ section.id }} .d__who { font-size: 26px; margin-bottom: 8px; }
    #hcd-{{ section.id }}.pre .d__panel--her .d__quiz, #hcd-{{ section.id }}.pre .d__panel--him .d__quiz { transform: translateY(12px); }
  }
  @media (prefers-reduced-motion: reduce) {
    #hcd-{{ section.id }} *, #hcd-{{ section.id }} .d__panel { transition: none !important; }
  }
</style>

<section id="hcd-{{ section.id }}" class="hcd">
  <script>if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) document.currentScript.parentNode.classList.add('pre');</script>
  <div class="d__in">
    <div class="d__head">
      <h2 class="d__h">{{ s.heading }}</h2>
      <div class="d__line">
        {%- if s.badge != blank -%}<span class="d__badge"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="8" r="6.5"/><path d="M5.2 8.2l1.9 1.8 3.7-4"/></svg>{{ s.badge }}</span>{%- endif -%}
        {%- if s.subheading != blank -%}<p class="d__sub">{{ s.subheading }}</p>{%- endif -%}
      </div>
    </div>

    <div class="d__grid">
      {%- for set in sets -%}
        {%- if set == 'her' -%}
          {%- assign tt = s.her_title -%}{%- assign cut = s.her_cutout -%}{%- assign face = s.her_face -%}
        {%- else -%}
          {%- assign tt = s.him_title -%}{%- assign cut = s.him_cutout -%}{%- assign face = s.him_face -%}
        {%- endif -%}
        <div class="d__panel d__panel--{{ set }}" style="--p: {{ forloop.index0 }}">
          {%- if cut != blank -%}
            <img class="d__person" src="{{ cut | image_url: width: 900 }}"
                 srcset="{{ cut | image_url: width: 500 }} 500w, {{ cut | image_url: width: 900 }} 900w, {{ cut | image_url: width: 1200 }} 1200w"
                 sizes="(max-width: 599px) 1px, 440px" width="{{ cut.width }}" height="{{ cut.height }}" alt="" loading="lazy" decoding="async">
          {%- endif -%}
          <div class="d__body">
            <h3 class="d__who">
              {%- if face != blank -%}<img class="d__ava" src="{{ face | image_url: width: 160 }}" width="64" height="64" alt="" loading="lazy">{%- endif -%}
              {{ tt }}
            </h3>
            {%- assign j = 0 -%}
            {%- for block in section.blocks -%}
              {%- assign b = block.settings -%}
              {%- if b.who == set -%}
                <a class="d__quiz" href="{{ b.link | default: '#' }}" style="--j: {{ j }}" {{ block.shopify_attributes }}>
                  <span class="d__ico" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                      {%- case b.icon -%}
                        {%- when 'cycle' -%}
                          <rect x="3.5" y="5" width="17" height="15.5" rx="3"/><path d="M3.5 10h17M8 3v4M16 3v4"/><path class="rf" d="M12 12.2c1.5 1.9 2.3 3 2.3 3.9a2.3 2.3 0 0 1-4.6 0c0-.9.8-2 2.3-3.9z"/>
                        {%- when 'scale' -%}
                          <rect x="3.5" y="4.5" width="17" height="15" rx="3"/><path d="M7.8 11.5a4.2 4.2 0 0 1 8.4 0"/><path class="r" d="M12 11.5l2-2.4"/>
                        {%- else -%}
                          <path d="M12 20s-7.5-4.6-7.5-10A4.3 4.3 0 0 1 12 7.4 4.3 4.3 0 0 1 19.5 10c0 5.4-7.5 10-7.5 10z"/><path class="r" d="M7.4 12.4h2.5l1.4-2.4 2 4.4 1.4-2h1.9"/>
                      {%- endcase -%}
                    </svg>
                  </span>
                  <span class="d__qb">
                    <span class="d__qt">{{ b.title }}</span>
                    {%- if b.text != blank -%}<span class="d__qd">{{ b.text }}</span>{%- endif -%}
                  </span>
                  <span class="d__go" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg></span>
                </a>
                {%- assign j = j | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('hcd-{{ section.id }}');
    if (!root) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    // The person leans a few px toward the pointer (mouse only).
    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      root.querySelectorAll('.d__panel').forEach(function (p) {
        var raf = 0, x = 0, y = 0;
        function paint() { raf = 0; p.style.setProperty('--lean-x', x + 'px'); p.style.setProperty('--lean-y', y + 'px'); }
        p.addEventListener('mousemove', function (e) {
          var r = p.getBoundingClientRect();
          x = ((e.clientX - r.left) / r.width - .5) * 10;
          y = ((e.clientY - r.top) / r.height - .5) * 6;
          if (!raf) raf = requestAnimationFrame(paint);
        });
        p.addEventListener('mouseleave', function () { x = 0; y = 0; if (!raf) raf = requestAnimationFrame(paint); });
      });
    }

    if (!('IntersectionObserver' in window)) { root.classList.remove('pre'); return; }
    root.classList.add('pre');
    // Start only when the people are loaded (max 1.5s) and the hidden state has
    // been painted for two frames; otherwise the browser can skip the transition.
    var people = [].slice.call(root.querySelectorAll('.d__person'));
    function loaded() { return Promise.all(people.map(function (im) {
      return im.complete ? null : new Promise(function (ok) {
        im.addEventListener('load', ok, { once: true }); im.addEventListener('error', ok, { once: true }); setTimeout(ok, 1500);
      });
    })); }
    function frames() { return new Promise(function (ok) { requestAnimationFrame(function () { requestAnimationFrame(ok); }); }); }
    new IntersectionObserver(function (es, io) {
      if (!es[0].isIntersecting) return;
      io.disconnect();
      people.forEach(function (im) { im.loading = 'eager'; });
      loaded().then(frames).then(function () {
        root.classList.add('in');
        root.classList.remove('pre');
        setTimeout(function () { root.classList.add('done'); }, 2200);
      });
    }, { threshold: 0.15 }).observe(root.querySelector('.d__grid'));
  })();
</script>

{% schema %}
{
  "name": "HS360 Quiz doors",
  "tag": "div",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge", "default": "100% free" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Free Health Score quizzes" },
    { "type": "text", "id": "subheading", "label": "Line under the heading", "default": "2 minutes. A few questions. A free doctor call after." },
    { "type": "header", "content": "Women" },
    { "type": "text", "id": "her_title", "label": "Title", "default": "For women" },
    { "type": "image_picker", "id": "her_cutout", "label": "Cut-out photo (laptop)", "info": "Transparent PNG, 4:5, waist-up, looking to the right." },
    { "type": "image_picker", "id": "her_face", "label": "Square photo (phones)", "info": "1:1, shown as a round avatar on phones." },
    { "type": "header", "content": "Men" },
    { "type": "text", "id": "him_title", "label": "Title", "default": "For men" },
    { "type": "image_picker", "id": "him_cutout", "label": "Cut-out photo (laptop)", "info": "Transparent PNG, 4:5, waist-up, looking to the left." },
    { "type": "image_picker", "id": "him_face", "label": "Square photo (phones)" },
    { "type": "color", "id": "accent_color", "label": "Accent colour", "default": "#ee204a" }
  ],
  "blocks": [
    {
      "type": "quiz",
      "name": "Quiz",
      "settings": [
        { "type": "select", "id": "who", "label": "For", "options": [{ "value": "her", "label": "Women" }, { "value": "him", "label": "Men" }], "default": "her" },
        { "type": "select", "id": "icon", "label": "Icon", "options": [{ "value": "cycle", "label": "Cycle" }, { "value": "scale", "label": "Weight" }, { "value": "heart", "label": "Heart" }], "default": "cycle" },
        { "type": "text", "id": "title", "label": "Title", "default": "Period care" },
        { "type": "text", "id": "text", "label": "What it checks", "default": "Cycle, cramps, PMS and PCOS signs" },
        { "type": "url", "id": "link", "label": "Quiz link" }
      ]
    }
  ],
  "presets": [{ "name": "HS360 Quiz doors" }]
}
{% endschema %}
