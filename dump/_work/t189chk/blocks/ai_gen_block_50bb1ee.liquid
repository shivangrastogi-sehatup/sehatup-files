{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  html {
    scroll-behavior: smooth;
  }
  .ai-dark-hero-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
    {% if block.settings.enable_background_color %}
      background-color: #1D1D1D;
    {% endif %}
    overflow: hidden;
  }

  .ai-dark-hero-background-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .ai-dark-hero-background-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: {{ block.settings.image_opacity | divided_by: 100.0 }};
  }

  .ai-dark-hero-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    {% if block.settings.enable_gradient and block.settings.background_gradient != blank %}
      background: {{ block.settings.background_gradient }};
    {% endif %}
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
  }

  .ai-dark-hero-pattern-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0.05;
    background-image: repeating-linear-gradient(
      45deg,
      transparent,
      transparent 10px,
      rgba(255, 255, 255, 0.03) 10px,
      rgba(255, 255, 255, 0.03) 20px
    );
  }

  .ai-dark-hero-container-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-dark-hero-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: clamp(24px,3.4vw,64px);
    line-height: {{ block.settings.heading_line_height }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    font-weight: 700;
  }

  .ai-dark-hero-subheading-{{ ai_gen_id }} {
    color: {{ block.settings.subheading_color }};
    font-size: {{ block.settings.subheading_size }}px;
    line-height: {{ block.settings.subheading_line_height }};
    margin: 0 0 {{ block.settings.subheading_spacing }}px;
    font-weight: 500;
  }

  .ai-dark-hero-body-{{ ai_gen_id }} {
    color: {{ block.settings.body_color }};
    font-size: clamp(10px, 1.2vw, 20px);;
    line-height: {{ block.settings.body_line_height }};
    margin: 0 0 {{ block.settings.body_spacing }}px;
  }

  .ai-dark-hero-tagline-{{ ai_gen_id }} {
    color: {{ block.settings.tagline_color }};
    font-size: {{ block.settings.tagline_size }}px;
    line-height: {{ block.settings.tagline_line_height }};
    margin: 0 0 {{ block.settings.tagline_spacing }}px;
    font-style: italic;
  }

  .ai-dark-hero-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-weight: 600;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .ai-dark-hero-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    transform: translateY(-2px);
  }

  @media screen and (max-width: 989px) {
    .ai-dark-hero-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.7 }}px 20px {{ block.settings.padding_bottom | times: 0.7 }}px;
    }

    .ai-dark-hero-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-dark-hero-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.85 }}px;
    }

    .ai-dark-hero-body-{{ ai_gen_id }} {
      font-size: {{ block.settings.body_size | times: 0.9 }}px;
    }

    .ai-dark-hero-tagline-{{ ai_gen_id }} {
      font-size: {{ block.settings.tagline_size | times: 0.9 }}px;
    }

    .ai-dark-hero-button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_font_size | times: 0.9 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-dark-hero-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.5 }}px 16px {{ block.settings.padding_bottom | times: 0.5 }}px;
    }

    .ai-dark-hero-container-{{ ai_gen_id }} {
      text-align: center;
    }

    .ai-dark-hero-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.6 }}px;
      margin-bottom: {{ block.settings.heading_spacing | times: 0.7 }}px;
    }

    .ai-dark-hero-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.7 }}px;
      margin-bottom: {{ block.settings.subheading_spacing | times: 0.7 }}px;
    }

    .ai-dark-hero-body-{{ ai_gen_id }} {
      font-size: {{ block.settings.body_size | times: 0.85 }}px;
      margin-bottom: {{ block.settings.body_spacing | times: 0.7 }}px;
    }

    .ai-dark-hero-tagline-{{ ai_gen_id }} {
      font-size: {{ block.settings.tagline_size | times: 0.85 }}px;
      margin-bottom: {{ block.settings.tagline_spacing | times: 0.7 }}px;
    }

    .ai-dark-hero-button-{{ ai_gen_id }} {
      {% if block.settings.button_full_width_mobile %}
        width: 100%;
        display: block;
      {% endif %}
      padding: {{ block.settings.button_padding_vertical | times: 0.9 }}px {{ block.settings.button_padding_horizontal | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-dark-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-dark-hero-background-{{ ai_gen_id }}">
    {% if block.settings.background_image %}
      <img
        src="{{ block.settings.background_image | image_url: width: 2000 }}"
        alt="{{ block.settings.background_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.background_image.width }}"
        height="{{ block.settings.background_image.height }}"
      >
    {% endif %}
  </div>

  {% if block.settings.enable_gradient %}
    <div class="ai-dark-hero-overlay-{{ ai_gen_id }}"></div>
  {% endif %}

  {% if block.settings.show_pattern %}
    <div class="ai-dark-hero-pattern-{{ ai_gen_id }}"></div>
  {% endif %}

  <div class="ai-dark-hero-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-dark-hero-heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h2>
    {% endif %}

    {% if block.settings.body_text != blank %}
      <div class="ai-dark-hero-body-{{ ai_gen_id }}">
        {{ block.settings.body_text }}
      </div>
    {% endif %}

    {% if block.settings.tagline != blank %}
      <p class="ai-dark-hero-tagline-{{ ai_gen_id }}">
        {{ block.settings.tagline }}
      </p>
    {% endif %}

    {% if block.settings.button_text != blank %}

      {% if block.settings.button_action_type == 'scroll' and block.settings.button_scroll_id != blank %}
        {% assign final_link = '#' | append: block.settings.button_scroll_id %}
      {% else %}
        {% assign final_link = block.settings.button_link %}
      {% endif %}

      <a
        href="{{ final_link }}"
        class="ai-dark-hero-button-{{ ai_gen_id }}"
      >
        {{ block.settings.button_text }}
      </a>

    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Dark Hero CTA",
  "settings": [
    {
      "type": "header",
      "content": "Background Settings"
    },
    {
      "type": "checkbox",
      "id": "enable_background_color",
      "label": "Enable background color (#1D1D1D)",
      "default": true,
      "info": "Layer 1: Solid background color"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Layer 2: Background image"
    },
    {
      "type": "range",
      "id": "image_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Image opacity",
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "enable_gradient",
      "label": "Enable gradient overlay",
      "default": true,
      "info": "Layer 3: Toggle gradient on/off"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Gradient overlay",
      "info": "Appears on top of the background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Gradient opacity",
      "default": 100
    },
    {
      "type": "checkbox",
      "id": "show_pattern",
      "label": "Show pattern overlay",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Padding top",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Padding bottom",
      "default": 100
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 400,
      "max": 1400,
      "step": 50,
      "unit": "px",
      "label": "Content max width",
      "default": 800
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Heading Here"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 48
    },
    {
      "type": "range",
      "id": "heading_line_height",
      "min": 1.0,
      "max": 2.0,
      "step": 0.1,
      "label": "Heading line height",
      "default": 1.2
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Heading bottom spacing",
      "default": 20
    },
    {
      "type": "header",
      "content": "Subheading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Your Subheading"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#CCCCCC"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "min": 14,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Subheading size",
      "default": 24
    },
    {
      "type": "range",
      "id": "subheading_line_height",
      "min": 1.0,
      "max": 2.0,
      "step": 0.1,
      "label": "Subheading line height",
      "default": 1.4
    },
    {
      "type": "range",
      "id": "subheading_spacing",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Subheading bottom spacing",
      "default": 16
    },
    {
      "type": "header",
      "content": "Body Text"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body text",
      "default": "<p>Your body text goes here</p>"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body text color",
      "default": "#AAAAAA"
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Body text size",
      "default": 16
    },
    {
      "type": "range",
      "id": "body_line_height",
      "min": 1.0,
      "max": 2.0,
      "step": 0.1,
      "label": "Body line height",
      "default": 1.6
    },
    {
      "type": "range",
      "id": "body_spacing",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Body bottom spacing",
      "default": 24
    },
    {
      "type": "header",
      "content": "Tagline"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline"
    },
    {
      "type": "color",
      "id": "tagline_color",
      "label": "Tagline color",
      "default": "#999999"
    },
    {
      "type": "range",
      "id": "tagline_size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Tagline size",
      "default": 14
    },
    {
      "type": "range",
      "id": "tagline_line_height",
      "min": 1.0,
      "max": 2.0,
      "step": 0.1,
      "label": "Tagline line height",
      "default": 1.5
    },
    {
      "type": "range",
      "id": "tagline_spacing",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Tagline bottom spacing",
      "default": 20
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Get Started"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_action_type",
      "label": "Button action type",
      "options": [
        {
          "value": "link",
          "label": "Open link"
        },
        {
          "value": "scroll",
          "label": "Scroll to section"
        }
      ],
      "default": "link"
    },
    {
      "type": "text",
      "id": "button_scroll_id",
      "label": "Section ID to scroll to",
      "info": "Enter section ID without # (example: assessment-section)"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_hover_bg_color",
      "label": "Button hover background",
      "default": "#F0F0F0"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Button hover text color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Button font size",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_padding_vertical",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Button vertical padding",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_padding_horizontal",
      "min": 16,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Button horizontal padding",
      "default": 32
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Button border radius",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "button_full_width_mobile",
      "label": "Full width button on mobile",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Dark Hero CTA"
    }
  ]
}
{% endschema %}
