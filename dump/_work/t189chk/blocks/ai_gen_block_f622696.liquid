{% doc %}
  @prompt
    Build a clean, compliance-focused trust section to display certification logos with labels below.
    
    Layout
    
    Full-width section with configurable background
    
    Centered container (default max-width 1200px)
    
    Optional heading
    
    Responsive grid (auto-fit, min ~220px)
    
    Important behavior
    
    Certification logos must always stay centered
    
    A setting “Label text alignment” should control only the label text, not the logo
    
    Changing text alignment must not affect logo position
    
    Item structure
    
    Logo image (centered)
    
    Label text below (left / center / right)
    
    Configurable logo max-width and % width
    
    Section settings
    
    Heading text, size, weight, color, alignment
    
    Spacing below heading
    
    Container width
    
    Desktop & mobile column gap
    
    Label text alignment (text only)
    
    Logo max width & width (%)
    
    Label font size, weight, color
    
    Padding top/bottom, margin top/bottom
    
    Background color
    
    Block settings
    
    Certification logo (image)
    
    Label text
    
    Technical constraints
    
    Liquid + HTML + CSS only
    
    No JavaScript or external libraries
    
    Mobile-first, semantic markup
    
    Do not use justify-items
    
    Center logos using margin: auto
    
    Style
    
    Minimal, medical/compliance-focused
    
    No shadows, no animations
    
    The section must be production-ready and behave like a native Shopify section.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-trust-cert-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    margin-top: {{ block.settings.margin_top }}px;
    margin-bottom: {{ block.settings.margin_bottom }}px;
  }

  .ai-trust-cert-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 20px;
    padding-right: 20px;
  }

  .ai-trust-cert-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    color: {{ block.settings.heading_color }};
    text-align: {{ block.settings.heading_alignment }};
    margin: 0 0 {{ block.settings.heading_spacing }}px 0;
  }

  .ai-trust-cert-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: {{ block.settings.desktop_gap }}px;
    width: 100%;
  }

  .ai-trust-cert-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ai-trust-cert-logo-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.logo_width }}%;
    max-width: {{ block.settings.logo_max_width }}px;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 12px;
  }

  .ai-trust-cert-logo-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-trust-cert-logo-placeholder-{{ ai_gen_id }} {
    width: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 3 / 2;
  }

  .ai-trust-cert-logo-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-trust-cert-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_font_size }}px;
    font-weight: {{ block.settings.label_weight }};
    color: {{ block.settings.label_color }};
    text-align: {{ block.settings.label_alignment }};
    width: 100%;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-trust-cert-grid-{{ ai_gen_id }} {
      gap: {{ block.settings.mobile_gap }}px;
    }
  }
{% endstyle %}

<div class="ai-trust-cert-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-trust-cert-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-trust-cert-heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h2>
    {% endif %}

    <div class="ai-trust-cert-grid-{{ ai_gen_id }}">
      {% if block.settings.cert_1_logo or block.settings.cert_1_label != blank %}
        <div class="ai-trust-cert-item-{{ ai_gen_id }}">
          <div class="ai-trust-cert-logo-wrapper-{{ ai_gen_id }}">
            {% if block.settings.cert_1_logo %}
              <img
                src="{{ block.settings.cert_1_logo | image_url: width: 600 }}"
                alt="{{ block.settings.cert_1_label | escape }}"
                loading="lazy"
                width="{{ block.settings.cert_1_logo.width }}"
                height="{{ block.settings.cert_1_logo.height }}"
                class="ai-trust-cert-logo-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-trust-cert-logo-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
          {% if block.settings.cert_1_label != blank %}
            <p class="ai-trust-cert-label-{{ ai_gen_id }}">
              {{ block.settings.cert_1_label }}
            </p>
