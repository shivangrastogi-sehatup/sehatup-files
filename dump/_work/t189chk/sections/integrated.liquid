<script>
  document.addEventListener('DOMContentLoaded', function () {
    const track = document.querySelector('.ic-stage-{{uid}}');
    const cards = [...document.querySelectorAll('.ic-mobile-card')];
    const rail = document.querySelector('.ic-dots-{{uid}}');
    if (!track || !cards.length || !rail) return;

    // one moving bar, sized to the share of the row you can see
    rail.innerHTML = '';
    const bar = Object.assign(document.createElement('div'), { className: 'ic-bar-{{uid}}' });
    rail.appendChild(bar);

    let ticking = false;

    function paint() {
      const max = track.scrollWidth - track.clientWidth;
      const share = Math.min(1, track.clientWidth / track.scrollWidth);
      const w = Math.max(18, rail.clientWidth * share);
      const p = max > 0 ? Math.min(1, Math.max(0, track.scrollLeft / max)) : 0;
      bar.style.width = w + 'px';
      bar.style.transform = 'translateX(' + ((rail.clientWidth - w) * p) + 'px)';
    }

    track.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => { ticking = false; paint(); });
    }, { passive: true });

    window.addEventListener('resize', paint);
    paint();
  });
</script>

