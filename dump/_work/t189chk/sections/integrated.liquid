{% assign uid = section.id %}

<style>
    #shopify-section-{{ section.id }},
    .ic-wrap-{{uid}}{ background:#fff; }

    .ic-wrap-{{uid}}{
      max-width:1080px;
      margin:auto;
      padding:50px 16px;
    }

    /* HEADER */
    .ic-header-{{uid}}{ text-align:center; margin-bottom:32px; }
    /* margin-top:0 matters: the theme's default h2 adds about 40px on top of this
       section's own 50px padding, which left a big empty gap above the heading. */
    .ic-header-{{uid}} h2{ font-size: clamp(24px, 3.4vw, 64px); font-weight:700; margin:0 0 10px; line-height:1.14; color: #1D1D1D;}
    .ic-header-{{uid}} p{ margin:0; color:#666; font-size: clamp(14px, 1.5vw, 34px); color: #1D1D1D;}

    /* DESKTOP GRID */
    .ic-grid-{{uid}}{
      display:grid;
      grid-template-columns:546fr 645fr;
      gap:18px;
    }

    .ic-card-base{
      position:relative;
      border-radius:18px;
      overflow:hidden;
    }

    .ic-ayurveda-{{uid}}{ aspect-ratio:546/700; }
    .ic-landscape-{{uid}}{ aspect-ratio:645/338; }

    .ic-img-{{uid}}{ width:100%; height:100%; object-fit:cover; display:block; }

    /* A slow, small zoom on hover. Enough to make the cards feel alive without
       turning into a card-hover effect on everything. */
    @media (hover: hover) and (prefers-reduced-motion: no-preference) {
      .ic-card-base .ic-img-{{uid}}{ transition: transform .6s cubic-bezier(.22,.7,.3,1); }
      .ic-card-base:hover .ic-img-{{uid}}{ transform: scale(1.04); }
    }

    .ic-float-{{uid}}{
      position:absolute;
      right:18px;
      bottom:18px;
      border-radius:14px;
      padding:16px 18px;
      box-shadow:0 10px 26px rgba(20,24,60,.14);
      width: 39rem;
      max-width:85%;
      display:flex;
      align-items:center;
      gap:0;
    }

    .ic-float-{{uid}}.ic-layout-vertical{
      flex-direction:column;
      align-items:flex-start;
    }

    .ic-float-{{uid}}.ic-layout-horizontal{
      flex-direction:row;
      align-items:center;
    }

    .ic-icon-wrap{
      flex-shrink:0;
    }

    .ic-icon-wrap img{
      width:40px;
      height:40px;
      object-fit:contain;
    }

    .ic-float-{{uid}}.ic-layout-vertical .ic-icon-wrap{
      align-self:{{ section.settings.icon_align_vertical }};
    }

    .ic-text-content{
      flex:1;
    }

    .ic-float-{{uid}} h3{
      /* was clamp(14px, 2.4vw, 35px): 14px on a phone, too small to scan */
      font-size: clamp(19px, 2.4vw, 35px);
      color: #1D1D1D;
      font-weight:700;
      margin-bottom:6px;
      margin-top: 0;
    }

    .ic-float-{{uid}} p{
      /* was clamp(10px, 1vw, 20px): 10px on a phone */
      font-size: clamp(15px, 1vw, 20px);
      color: #1D1D1D;
      line-height:1.45;
      margin:0;
    }

    /* STRIP */
    .ic-strip-{{uid}}{
      margin-top:42px;
      {% if section.settings.strip_show_bg %}
      background:{{ section.settings.strip_bg_color }};
      {% endif %}
      {% if section.settings.strip_show_border %}
      border: 1px solid {{ section.settings.strip_border_color }};
      {% endif %}
      border-radius:18px;
      padding: clamp(18px, 2.2vw, 26px) clamp(18px, 3vw, 32px);
      text-align:{{ section.settings.strip_alignment }};
      /* was clamp(10px, 1.2vw, 20px): 10px on a phone */
      font-size: clamp(16px, 1.2vw, 20px);
      color:{{ section.settings.strip_text_color }};
      line-height:1.6;
      /* full width of the card grid above it, not a narrow centred column */
      max-width: none;
    }

    .ic-strip-{{uid}} .ic-highlight{
      color:{{ section.settings.strip_highlight_color }};
      font-weight:{{ section.settings.strip_highlight_weight }};
    }

    /* ================= MOBILE SLIDER ================= */
    @media(max-width:768px){

        /* MOBILE HEADER CONTROL */
        .ic-header-{{uid}} h2{
          font-size: {{ section.settings.mobile_heading_size }}px;
          line-height: 1.2;
        }

        .ic-header-{{uid}} p{
          font-size: {{ section.settings.mobile_subtitle_size }}px;
          line-height: 1.4;
        }


      .ic-grid-{{uid}}{ display:none; }

      /* break out of the wrapper's 16px padding so the cards get the full
         screen width, with a small peek of the next one */
      .ic-mobile-slider{
        position:relative;
        display:block;
        margin-inline:-16px;
      }

      /* Classic swipe carousel: the cards slide, and a slice of the next one
         shows on the right so it is obvious there is more to see. */
      .ic-stage-{{uid}}{
        display:flex;
        gap:12px;
        overflow-x:auto;
        overscroll-behavior-x:contain;
        scroll-snap-type:x mandatory;
        scroll-padding-left:16px;
        -webkit-overflow-scrolling:touch;
        scrollbar-width:none;
        padding:10px 16px 0;
      }
      .ic-stage-{{uid}}::-webkit-scrollbar{ display:none; }

      .ic-mobile-card{
        position:relative;
        flex:0 0 calc(100% - 46px);
        height: {{ section.settings.mobile_card_height }}px;
        scroll-snap-align:start;
        border-radius:18px;
        overflow:hidden;
      }

      .ic-mobile-card .ic-img-{{uid}}{
        width:100%;
        height:100%;
        object-fit:cover;
      }

      /* the pastel box was pinned bottom-right at 85% width, which looked
         off-centre on a phone; even margins on both sides instead */
      .ic-mobile-card .ic-float-{{uid}}{
        left:14px;
        right:14px;
        bottom:14px;
        width:auto;
        max-width:none;
      }

      .ic-arrow{ display:none; }
      .ic-tabs-{{uid}}{ display:none; }
      .ic-swipe-{{uid}}{ display:none; }

      /* Pagination: one rail with a crimson bar that slides as you scroll.
         It is driven directly by the scroll position, so it tracks your finger
         instead of jumping when a card snaps. */
      .ic-dots-{{uid}}{
        display:block;
        position:relative;
        width:104px;
        height:5px;
        margin:18px auto 0;
        border-radius:999px;
        background:#e9e9ee;
        overflow:hidden;
      }

      .ic-bar-{{uid}}{
        position:absolute;
        top:0;
        left:0;
        height:100%;
        border-radius:999px;
        background:{{ section.settings.strip_highlight_color }};
        min-width:22px;
        will-change: transform;
      }

    }

    @media(min-width:769px){
      .ic-mobile-slider{ display:none; }
    }
</style>

