{%- comment -%}
  Product reviews: the reviews app's widget (added as an app block) inside
  the site's own frame, with its fonts, stars, buttons and review cards
  restyled to match. The widget keeps doing the work (loading, sorting,
  writing a review); this section only dresses it.
{%- endcomment -%}

{%- comment -%} Styles first, so the browser never paints this section unstyled. {%- endcomment -%}
<style>
  #srv-{{ section.id }} {
    --srv-text: #1d1d1d; --srv-muted: #555; --srv-line: #eadfd8;
    --srv-ink: {{ section.settings.accent_color | color_darken: 8 }};
    padding: 0 clamp(16px, 2vw, 28px) 56px;
    background: #fff;
    font-family: 'Montserrat', sans-serif; color: var(--srv-text);
  }
  #srv-{{ section.id }} .srv__inner { max-width: 1160px; margin: 0 auto; }
  #srv-{{ section.id }} .srv__heading { margin: 0; font: 800 clamp(24px, 2.6vw, 34px)/1.15 'Montserrat', sans-serif; letter-spacing: -.02em; }
  #srv-{{ section.id }} .srv__sub { margin: 10px 0 0; font: 500 15.5px/1.55 'Montserrat', sans-serif; color: var(--srv-muted); }
  #srv-{{ section.id }} .srv__widget { margin-top: 24px; }

  /* ---- The reviews widget, restyled ------------------------------------ */
  /* Everything but the stars: those are drawn with the app's own icon font. */
  #srv-{{ section.id }} .jdgm-widget, #srv-{{ section.id }} .jdgm-widget *:not(.jdgm-star):not([class*='jdgm-icon']) { font-family: 'Montserrat', sans-serif !important; }
  #srv-{{ section.id }} .jdgm-widget { max-width: none !important; margin: 0 !important; color: var(--srv-text); font-size: 14px !important; }
  #srv-{{ section.id }} .jdgm-rev-widg, #srv-{{ section.id }} .jdgm-row-stars, #srv-{{ section.id }} .jdgm-rev-widg__summary { font-size: 14px !important; }
  #srv-{{ section.id }} .jdgm-star { font-size: 15px !important; }
  #srv-{{ section.id }} .jdgm-histogram, #srv-{{ section.id }} .jdgm-histogram__row { font-size: 12.5px !important; }
  #srv-{{ section.id }} .jdgm-histogram .jdgm-star { font-size: 12px !important; }
  #srv-{{ section.id }} .jdgm-rev-widg { padding: 0 !important; border: 0 !important; background: none !important; }
  #srv-{{ section.id }} .jdgm-rev-widg__title { display: none !important; }   /* our own heading is above */
  #srv-{{ section.id }} .jdgm-rev-widg__header {
    padding: 22px !important; margin: 0 0 16px !important; border-radius: 14px; background: #fff;
    border: 1px solid #e8e0d9 !important;
  }
  #srv-{{ section.id }} .jdgm-rev-widg__summary { margin: 0 !important; text-align: left !important; }
  #srv-{{ section.id }} .jdgm-rev-widg__summary-average { white-space: nowrap; font: 800 17px/1.2 'Montserrat', sans-serif !important; color: var(--srv-text) !important; }
  #srv-{{ section.id }} .jdgm-rev-widg__summary-stars { margin-bottom: 6px; }
  #srv-{{ section.id }} .jdgm-rev-widg__summary-stars .jdgm-star { font-size: 17px !important; }
  #srv-{{ section.id }} .jdgm-rev-widg__summary-text { font: 600 14px/1.4 'Montserrat', sans-serif !important; color: var(--srv-muted) !important; }
  #srv-{{ section.id }} .jdgm-star { color: #f5a623 !important; }
  #srv-{{ section.id }} .jdgm-histogram { margin: 0 !important; border: 0 !important; padding: 0 !important; }
  #srv-{{ section.id }} .jdgm-histogram__bar { background: #f1e9e3 !important; border-radius: 999px !important; box-shadow: none !important; }
  #srv-{{ section.id }} .jdgm-histogram__bar-content { background: #f5a623 !important; border-radius: 999px !important; }
  #srv-{{ section.id }} .jdgm-histogram__percentage, #srv-{{ section.id }} .jdgm-histogram__frequency { color: var(--srv-muted) !important; font-size: 12.5px !important; }
  #srv-{{ section.id }} .jdgm-write-rev-link, #srv-{{ section.id }} .jdgm-ask-question-btn {
    padding: 13px 22px !important; border-radius: 999px !important;
    border: 1.5px solid var(--srv-ink) !important; background: #fff !important; color: var(--srv-ink) !important;
    font: 700 14px/1 'Montserrat', sans-serif !important; text-decoration: none !important; box-shadow: none !important;
    transition: background-color .2s ease, color .2s ease;
  }
  #srv-{{ section.id }} .jdgm-write-rev-link:hover { background: #fdecef !important; color: var(--srv-ink) !important; }
  #srv-{{ section.id }} .jdgm-rev-widg__sort-wrapper { margin: 0 0 14px !important; }
  #srv-{{ section.id }} .jdgm-sort-dropdown { border: 1px solid var(--srv-line) !important; border-radius: 999px !important; padding: 8px 14px !important; background: #fff !important; font-size: 13.5px !important; }

  /* The widget is: header (summary, star bars, write button), a sort row,
     then the body with the reviews. Wide screens: header as a card on the
     left, reviews beside it. */
  #srv-{{ section.id }} .jdgm-row-actions { display: none !important; }
  #srv-{{ section.id }} .jdgm-row-stars { display: flex !important; flex-wrap: wrap; align-items: center; gap: 16px 28px; width: 100% !important; }
  #srv-{{ section.id }} .jdgm-rev-widg__summary, #srv-{{ section.id }} .jdgm-rev-widg__summary-inner { width: auto !important; text-align: left !important; }
  #srv-{{ section.id }} .jdgm-histogram { display: grid !important; gap: 7px; width: auto !important; min-width: 220px; flex: 1 1 220px; max-width: 320px; }
  #srv-{{ section.id }} .jdgm-histogram__row { display: flex !important; align-items: center; gap: 8px; width: 100% !important; min-width: 100%; height: auto !important; margin: 0 !important; }
  #srv-{{ section.id }} .jdgm-histogram__star { flex: none; width: auto !important; white-space: nowrap; }
  #srv-{{ section.id }} .jdgm-histogram__bar { flex: 1 1 auto !important; min-width: 60px; width: auto !important; height: 8px !important; margin: 0 !important; display: block !important; }
  #srv-{{ section.id }} .jdgm-histogram__frequency { flex: none; width: 22px !important; text-align: right; }
  #srv-{{ section.id }} .jdgm-widget-actions-wrapper { width: auto !important; margin-left: auto; border: 0 !important; padding: 0 !important; }
  #srv-{{ section.id }} .jdgm-write-rev-link { display: block !important; margin: 0 !important; text-align: center; white-space: nowrap; }
  @media (min-width: 900px) {
    #srv-{{ section.id }} .jdgm-rev-widg { display: grid !important; grid-template-columns: 300px minmax(0, 1fr); gap: 16px; align-items: start; }
    #srv-{{ section.id }} .jdgm-rev-widg__header { grid-column: 1; grid-row: 1; display: block !important; margin: 0 !important; }
    #srv-{{ section.id }} .jdgm-rev-widg__body { grid-column: 2; grid-row: 1; min-width: 0; width: auto !important; }
    #srv-{{ section.id }} .jdgm-row-stars { flex-direction: column !important; align-items: stretch !important; gap: 18px; }
    #srv-{{ section.id }} .jdgm-rev-widg__summary { display: block !important; align-self: flex-start; }
    #srv-{{ section.id }} .jdgm-histogram { max-width: none; flex: none; width: 100% !important; min-width: 0; }
    #srv-{{ section.id }} .jdgm-widget-actions-wrapper { margin-left: 0; }
    #srv-{{ section.id }} .jdgm-rev-widg__reviews { grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)) !important; }
  }

  /* Inside a review: name row on top, then stars and text, full width. */
  #srv-{{ section.id }} .jdgm-rev__header { display: flow-root !important; width: auto !important; }
  #srv-{{ section.id }} .jdgm-row-profile { float: none !important; width: auto !important; display: flex !important; align-items: center; gap: 10px; }
  #srv-{{ section.id }} .jdgm-rev__icon { float: none !important; flex: none; margin: 0 !important; border-radius: 50% !important; }
  #srv-{{ section.id }} .jdgm-rev__content, #srv-{{ section.id }} .jdgm-rev__actions { margin-left: 0 !important; width: auto !important; }
  #srv-{{ section.id }} .jdgm-rev__content { margin-top: 12px !important; }
  #srv-{{ section.id }} .jdgm-rev__body p { margin: 6px 0 0 !important; }
  #srv-{{ section.id }} .jdgm-rev__br { display: none !important; }

  /* Reviews as cards. */
  #srv-{{ section.id }} .jdgm-rev-widg__reviews { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 16px; }
  #srv-{{ section.id }} .jdgm-rev {
    margin: 0 !important; padding: 20px 22px !important; border: 0 !important; border-radius: 14px; background: #fff;
    border: 1px solid #e8e0d9 !important;
  }
  #srv-{{ section.id }} .jdgm-rev__icon { background: #f6f0ec !important; color: var(--srv-ink) !important; font-weight: 700 !important; }
  #srv-{{ section.id }} .jdgm-rev__icon::after { display: none !important; }
  #srv-{{ section.id }} .jdgm-rev__author { font: 700 15px/1.2 'Montserrat', sans-serif !important; color: var(--srv-text) !important; }
  #srv-{{ section.id }} .jdgm-rev__timestamp { font-size: 12.5px !important; color: var(--srv-muted) !important; }
  #srv-{{ section.id }} .jdgm-rev__buyer-badge { background: #f6f0ec !important; color: var(--srv-text) !important; border-radius: 999px !important; padding: 4px 9px !important; font: 700 11.5px/1 'Montserrat', sans-serif !important; }
  #srv-{{ section.id }} .jdgm-rev__title { font: 700 15.5px/1.35 'Montserrat', sans-serif !important; color: var(--srv-text) !important; }
  #srv-{{ section.id }} .jdgm-rev__body { font: 400 14.5px/1.65 'Montserrat', sans-serif !important; color: #444 !important; }
  #srv-{{ section.id }} .jdgm-rev__actions { margin-top: 10px !important; opacity: .7; }
  #srv-{{ section.id }} .jdgm-paginate__page { border-radius: 999px !important; }
  #srv-{{ section.id }} .jdgm-paginate__page.jdgm-curt { background: var(--srv-ink) !important; color: #fff !important; }
  #srv-{{ section.id }} .jdgm-btn, #srv-{{ section.id }} .jdgm-submit-rev {
    border-radius: 999px !important; background: var(--srv-ink) !important; border-color: var(--srv-ink) !important; color: #fff !important;
    font: 700 14px/1 'Montserrat', sans-serif !important;
  }
  #srv-{{ section.id }} .jdgm-form input, #srv-{{ section.id }} .jdgm-form textarea { border-radius: 12px !important; border-color: var(--srv-line) !important; }

  @media (max-width: 599px) {
    #srv-{{ section.id }} { padding-bottom: 44px; }
    #srv-{{ section.id }} .srv__inner { padding-top: 32px; }
    #srv-{{ section.id }} .jdgm-rev-widg__reviews { grid-template-columns: minmax(0, 1fr); }
    #srv-{{ section.id }} .jdgm-widget-actions-wrapper { width: 100% !important; }
  }
  @media (min-width: 1680px) { #srv-{{ section.id }} .srv__inner { zoom: 1.12; } }
  @media (min-width: 1920px) { #srv-{{ section.id }} .srv__inner { zoom: 1.25; } }
  @media (min-width: 2560px) { #srv-{{ section.id }} .srv__inner { zoom: 1.65; } }
</style>

<section id="srv-{{ section.id }}" class="srv">
  <div class="srv__inner">
    <h2 class="srv__heading">{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}<p class="srv__sub">{{ section.settings.subheading }}</p>{%- endif -%}
    <div class="srv__widget">
      {%- for block in section.blocks -%}{% render block %}{%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "sehatUP reviews",
  "tag": "div",
  "class": "section-sehat-reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What customers say" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "color", "id": "accent_color", "label": "Accent colour", "default": "#d81f48" }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "sehatUP reviews" }]
}
{% endschema %}
