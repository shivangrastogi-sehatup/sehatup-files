{%- comment -%}
  "What is Health Score 360?" without pinning or zoom: the page keeps
  scrolling the whole time. The photo stays beside the text (sticky), the
  intro fades as the steps arrive, each step lights up its dots on the photo,
  and a small prompt under the photo always says what is next.
  Plain IntersectionObserver and CSS, no animation library.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign img = s.image
  assign crop = s.crop_top | divided_by: 100.0
-%}

{%- comment -%} Styles first, so the browser never paints this section unstyled. {%- endcomment -%}
<style>
  #ssw-{{ section.id }} {
    --ssw-text: #1d1d1d; --ssw-muted: #5f5a56; --ssw-line: #e8e0d9; --ssw-soft: #f6f0ec;
    --ssw-ink: {{ s.accent_color | color_darken: 8 }};
    --ssw-top: 72px;
    padding: clamp(48px, 6vw, 88px) clamp(16px, 3vw, 48px);
    background: #fff; font-family: 'Montserrat', sans-serif; color: var(--ssw-text);
  }
  #ssw-{{ section.id }} * { box-sizing: border-box; }
  #ssw-{{ section.id }} .ssw__inner { max-width: 1240px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); grid-template-areas: "media intro" "media steps"; column-gap: clamp(28px, 5vw, 72px); row-gap: 8px; align-items: start; }
  #ssw-{{ section.id }} .ssw__intro { grid-area: intro; }
  #ssw-{{ section.id }} .ssw__steps { grid-area: steps; }

  /* Photo column: stays in view while the steps scroll past. */
  #ssw-{{ section.id }} .ssw__media { grid-area: media; position: sticky; top: calc(var(--ssw-top) + 24px); }
  #ssw-{{ section.id }} .ssw__photo { position: relative; aspect-ratio: 4 / 3; border-radius: 24px; overflow: hidden; background: var(--ssw-soft); }
  /* The 3:2 photo sits inside a 16:9 frame, shifted up so the band with the
     people shows. Dots live on the same layer, so they stay on target. */
  /* The layer is wider than the frame (people larger), centred, and lifted so the band with the people shows. */
  #ssw-{{ section.id }} .ssw__layer { position: absolute; width: 135%; left: -17.5%; aspect-ratio: 3 / 2; top: calc(-1 * {{ crop }} * 120%); }
  #ssw-{{ section.id }} .ssw__layer img { display: block; width: 100%; height: 100%; object-fit: cover; }
  #ssw-{{ section.id }} .ssw__dot {
    position: absolute; width: 16px; height: 16px; margin: -8px 0 0 -8px; border-radius: 50%;
    background: var(--ssw-ink); box-shadow: 0 0 0 4px rgba(255, 255, 255, .9);
    opacity: .35; transform: scale(.8); transition: opacity .4s ease, transform .4s cubic-bezier(.16, 1, .3, 1);
  }
  #ssw-{{ section.id }} .ssw__dot::after { content: ""; position: absolute; inset: -6px; border-radius: 50%; border: 2px solid var(--ssw-ink); opacity: 0; }
  #ssw-{{ section.id }}[data-active="w"] .ssw__dot[data-for="w"],
  #ssw-{{ section.id }}[data-active="s"] .ssw__dot[data-for="s"],
  #ssw-{{ section.id }}[data-active="p"] .ssw__dot[data-for="p"] { opacity: 1; transform: scale(1); }
  #ssw-{{ section.id }}[data-active="w"] .ssw__dot[data-for="w"]::after,
  #ssw-{{ section.id }}[data-active="s"] .ssw__dot[data-for="s"]::after,
  #ssw-{{ section.id }}[data-active="p"] .ssw__dot[data-for="p"]::after { animation: ssw-ping-{{ section.id }} 1.8s ease-out infinite; }
  @keyframes ssw-ping-{{ section.id }} { from { opacity: .9; transform: scale(.6); } to { opacity: 0; transform: scale(1.9); } }

  /* The prompt under the photo: where you are, and what is next. */
  #ssw-{{ section.id }} .ssw__prompt { margin-top: 14px; display: flex; align-items: center; justify-content: space-between; gap: 14px; }
  #ssw-{{ section.id }} .ssw__pips { display: flex; gap: 6px; }
  #ssw-{{ section.id }} .ssw__pips i { width: 26px; height: 4px; border-radius: 2px; background: var(--ssw-line); transition: background-color .3s ease; }
  #ssw-{{ section.id }} .ssw__pips i.is-on { background: var(--ssw-ink); }
  #ssw-{{ section.id }} .ssw__next { display: inline-flex; align-items: center; gap: 8px; font: 600 13.5px/1.3 'Montserrat', sans-serif; color: var(--ssw-muted); text-decoration: none; }
  #ssw-{{ section.id }} .ssw__next::after {
    content: ""; width: 8px; height: 8px; border-right: 2px solid var(--ssw-ink); border-bottom: 2px solid var(--ssw-ink);
    transform: rotate(45deg); animation: ssw-bob-{{ section.id }} 1.4s ease-in-out infinite;
  }
  #ssw-{{ section.id }} .ssw__next.is-done { color: var(--ssw-ink); font-weight: 700; }
  #ssw-{{ section.id }} .ssw__next.is-done::after { transform: rotate(-45deg); animation: none; }
  @keyframes ssw-bob-{{ section.id }} { 0%, 100% { translate: 0 -2px; } 50% { translate: 0 3px; } }

  /* Text column: the intro, then one step per screen-ish. */
  #ssw-{{ section.id }} .ssw__intro { transition: opacity .5s ease; }
  #ssw-{{ section.id }}.is-stepping .ssw__intro { opacity: .28; }
  #ssw-{{ section.id }} .ssw__heading { margin: 0; font: 800 clamp(30px, 3.4vw, 46px)/1.06 'Montserrat', sans-serif; letter-spacing: -.02em; text-wrap: balance; }
  #ssw-{{ section.id }} .ssw__sub { margin: 14px 0 0; max-width: 26em; font: 500 16px/1.6 'Montserrat', sans-serif; color: var(--ssw-muted); }
  #ssw-{{ section.id }} .ssw__steps { list-style: none; margin: 0; padding: 0; }
  #ssw-{{ section.id }} .ssw__step {
    min-height: 44vh; display: flex; flex-direction: column; justify-content: center; padding: 20px 0;
    opacity: .3; transform: translateY(24px); transition: opacity .55s ease, transform .7s cubic-bezier(.16, 1, .3, 1);
  }
  #ssw-{{ section.id }} .ssw__step.is-in { opacity: 1; transform: none; }
  #ssw-{{ section.id }} .ssw__step:first-child { min-height: 36vh; }
  #ssw-{{ section.id }} .ssw__step:last-child { min-height: 40vh; }
  #ssw-{{ section.id }} .ssw__n { font: 800 15px/1 'Montserrat', sans-serif; color: var(--ssw-ink); }
  #ssw-{{ section.id }} .ssw__step h3 { margin: 10px 0 0; font: 800 clamp(26px, 2.6vw, 36px)/1.1 'Montserrat', sans-serif; letter-spacing: -.02em; }
  #ssw-{{ section.id }} .ssw__step p { margin: 10px 0 0; max-width: 24em; font: 500 16.5px/1.6 'Montserrat', sans-serif; color: var(--ssw-muted); }
  #ssw-{{ section.id }} .ssw__cta { display: inline-flex; align-self: flex-start; align-items: center; margin-top: 22px; min-height: 52px; padding: 0 26px; border-radius: 999px; background: var(--ssw-ink); color: #fff; font: 700 15px/1 'Montserrat', sans-serif; text-decoration: none; }
  #ssw-{{ section.id }} .ssw__cta:hover { background: #b3123a; }
  #ssw-{{ section.id }} :is(.ssw__cta, .ssw__next):focus-visible { outline: 2px solid var(--ssw-text); outline-offset: 3px; }

  /* Phones and tablets: the photo pins under the header, the steps scroll beneath it. */
  @media (max-width: 899px) {
    #ssw-{{ section.id }} .ssw__inner { grid-template-columns: minmax(0, 1fr); grid-template-areas: "intro" "media" "steps"; gap: 0; }
    #ssw-{{ section.id }} .ssw__intro { order: -2; padding-bottom: 20px; }
    #ssw-{{ section.id }} .ssw__media { order: -1; top: var(--ssw-top); z-index: 2; padding: 10px 0 12px; background: #fff; }
    #ssw-{{ section.id }} .ssw__photo { aspect-ratio: 3 / 2; border-radius: 18px; }
    #ssw-{{ section.id }} .ssw__layer { width: 130%; left: -15%; top: -30%; }
    #ssw-{{ section.id }} .ssw__prompt { margin-top: 10px; }
    #ssw-{{ section.id }} .ssw__step, #ssw-{{ section.id }} .ssw__step:first-child { min-height: 34vh; }
    #ssw-{{ section.id }} .ssw__step:last-child { min-height: 0; padding-bottom: 8px; }
    #ssw-{{ section.id }} .ssw__cta { align-self: stretch; justify-content: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    #ssw-{{ section.id }} .ssw__step { opacity: 1; transform: none; transition: none; }
    #ssw-{{ section.id }} .ssw__next::after, #ssw-{{ section.id }} .ssw__dot::after { animation: none !important; }
  }
  @media (min-width: 1680px) { #ssw-{{ section.id }} .ssw__inner { zoom: 1.12; } }
  @media (min-width: 1920px) { #ssw-{{ section.id }} .ssw__inner { zoom: 1.25; } }
  @media (min-width: 2560px) { #ssw-{{ section.id }} .ssw__inner { zoom: 1.6; } }
</style>

<section id="ssw-{{ section.id }}" class="ssw" data-active="">
  <div class="ssw__inner">
    <div class="ssw__intro">
      <h2 class="ssw__heading">{{ s.heading }}</h2>
      {%- if s.subheading != blank -%}<p class="ssw__sub">{{ s.subheading }}</p>{%- endif -%}
    </div>

    <div class="ssw__media">
      <div class="ssw__photo">
        <div class="ssw__layer">
          {%- if img != blank -%}
            <img src="{{ img | image_url: width: 1600 }}" srcset="{{ img | image_url: width: 900 }} 900w, {{ img | image_url: width: 1600 }} 1600w, {{ img | image_url: width: 2400 }} 2400w" sizes="(max-width: 899px) 100vw, 720px" alt="{{ img.alt | default: s.image_alt | escape }}" loading="lazy" width="{{ img.width }}" height="{{ img.height }}">
          {%- else -%}
            <img src="{{ s.image_asset | asset_url }}" alt="{{ s.image_alt | escape }}" loading="lazy" width="3840" height="2560">
          {%- endif -%}
          <span class="ssw__dot" data-for="w" style="left: {{ s.w_x }}%; top: {{ s.w_y }}%;"></span>
          <span class="ssw__dot" data-for="w" style="left: {{ s.w_x2 }}%; top: {{ s.w_y2 }}%;"></span>
          <span class="ssw__dot" data-for="s" style="left: {{ s.s_x }}%; top: {{ s.s_y }}%;"></span>
          <span class="ssw__dot" data-for="p" style="left: {{ s.p_x }}%; top: {{ s.p_y }}%;"></span>
        </div>
      </div>
      <div class="ssw__prompt" aria-hidden="true">
        <span class="ssw__pips"><i></i><i></i><i></i></span>
        <span class="ssw__next" data-ssw-next>{{ s.prompt_start }}</span>
      </div>
    </div>

    <ol class="ssw__steps">
      <li class="ssw__step" data-key="w" data-next="{{ s.s_title | escape }}">
        <span class="ssw__n">01</span><h3>{{ s.w_title }}</h3><p>{{ s.w_text }}</p>
      </li>
      <li class="ssw__step" data-key="s" data-next="{{ s.p_title | escape }}">
        <span class="ssw__n">02</span><h3>{{ s.s_title }}</h3><p>{{ s.s_text }}</p>
      </li>
      <li class="ssw__step" data-key="p" data-next="">
        <span class="ssw__n">03</span><h3>{{ s.p_title }}</h3><p>{{ s.p_text }}</p>
        {%- if s.cta_text != blank -%}<a class="ssw__cta" href="{{ s.cta_link | default: '#' }}">{{ s.cta_text }}</a>{%- endif -%}
      </li>
    </ol>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('ssw-{{ section.id }}');
    if (!root || root.dataset.sswBooted === '1') return;
    root.dataset.sswBooted = '1';
    var header = document.querySelector('.section-header');
    if (header) root.style.setProperty('--ssw-top', header.offsetHeight + 'px');
    var steps = root.querySelectorAll('.ssw__step'), pips = root.querySelectorAll('.ssw__pips i'), next = root.querySelector('[data-ssw-next]');
    var startText = next.textContent, nextLabel = {{ s.prompt_next | json }}, doneText = {{ s.prompt_done | json }};

    function setActive(i) {
      var st = steps[i];
      root.dataset.active = st ? st.dataset.key : '';
      root.classList.toggle('is-stepping', !!st);
      pips.forEach(function (p, k) { p.classList.toggle('is-on', st && k <= i); });
      if (!st) { next.textContent = startText; next.classList.remove('is-done'); return; }
      if (st.dataset.next) { next.textContent = nextLabel.replace('[next]', st.dataset.next); next.classList.remove('is-done'); }
      else { next.textContent = doneText; next.classList.add('is-done'); }
    }

    if (!('IntersectionObserver' in window)) { steps.forEach(function (s) { s.classList.add('is-in'); }); setActive(0); return; }
    // A step counts as current while it crosses the middle band of the screen.
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        var i = Array.prototype.indexOf.call(steps, e.target);
        if (e.isIntersecting) { e.target.classList.add('is-in'); setActive(i); }
        else if (i === 0 && e.boundingClientRect.top > 0) setActive(-1);   // scrolled back above the first step
      });
    }, { rootMargin: '-40% 0px -40% 0px' });
    steps.forEach(function (st) { io.observe(st); });
  })();
</script>

{% schema %}
{
  "name": "sehatUP story (no pin)",
  "tag": "div",
  "class": "section-sehat-story-flow",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What Is Health Score 360?" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "image_picker", "id": "image", "label": "Photo (3:2)" },
    { "type": "text", "id": "image_asset", "label": "Or a theme asset file name", "default": "hs360-couple-v3-4k.webp" },
    { "type": "text", "id": "image_alt", "label": "Photo description", "default": "A man and a woman, the two people Health Score 360 is made for" },
    { "type": "range", "id": "crop_top", "label": "Desktop: hide this much of the photo's top (%)", "min": 0, "max": 20, "step": 1, "default": 14 },
    { "type": "header", "content": "Steps" },
    { "type": "text", "id": "w_title", "label": "Step 1 title", "default": "Weight" },
    { "type": "textarea", "id": "w_text", "label": "Step 1 text" },
    { "type": "range", "id": "w_x", "label": "Step 1 dot on her, across (%)", "min": 0, "max": 100, "step": 1, "default": 42 },
    { "type": "range", "id": "w_y", "label": "Step 1 dot on her, down (%)", "min": 0, "max": 100, "step": 1, "default": 66 },
    { "type": "range", "id": "w_x2", "label": "Step 1 dot on him, across (%)", "min": 0, "max": 100, "step": 1, "default": 59 },
    { "type": "range", "id": "w_y2", "label": "Step 1 dot on him, down (%)", "min": 0, "max": 100, "step": 1, "default": 64 },
    { "type": "text", "id": "s_title", "label": "Step 2 title", "default": "Sexual Wellness" },
    { "type": "textarea", "id": "s_text", "label": "Step 2 text" },
    { "type": "range", "id": "s_x", "label": "Step 2 dot, across (%)", "min": 0, "max": 100, "step": 1, "default": 58 },
    { "type": "range", "id": "s_y", "label": "Step 2 dot, down (%)", "min": 0, "max": 100, "step": 1, "default": 53 },
    { "type": "text", "id": "p_title", "label": "Step 3 title", "default": "Period Care" },
    { "type": "textarea", "id": "p_text", "label": "Step 3 text" },
    { "type": "range", "id": "p_x", "label": "Step 3 dot, across (%)", "min": 0, "max": 100, "step": 1, "default": 43 },
    { "type": "range", "id": "p_y", "label": "Step 3 dot, down (%)", "min": 0, "max": 100, "step": 1, "default": 72 },
    { "type": "header", "content": "Prompt under the photo" },
    { "type": "text", "id": "prompt_start", "label": "Before the first step", "default": "Scroll to see what it checks" },
    { "type": "text", "id": "prompt_next", "label": "Between steps", "info": "[next] = the next step's title.", "default": "Keep scrolling: [next]" },
    { "type": "text", "id": "prompt_done", "label": "After the last step", "default": "That's all three. Start below." },
    { "type": "text", "id": "cta_text", "label": "Button after the last step", "default": "Take the free check" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "color", "id": "accent_color", "label": "Accent colour", "default": "#d81f48" }
  ],
  "presets": [{ "name": "sehatUP story (no pin)" }]
}
{% endschema %}
