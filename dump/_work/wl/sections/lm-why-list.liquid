{%- assign s = section.settings -%}
<section class="lm-sec{% if s.tone == 'stone' %} lm-sec--stone{% endif %}" style="--lm-wi: {{ s.image_width }}px; --lm-wic: {{ s.icon_size }}px;">
  <div class="lm-wrap lm-whyl">
    <div>
      <h2 class="lm-h2 lm-whyl__h">{{ s.heading }}{% if s.highlight != blank %} <span class="lm-mark">{{ s.highlight }}</span>{% endif %}</h2>
      <ul class="lm-whyl__list{% if s.dividers %} lm-whyl__list--lines{% endif %}" data-lm-anim>
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <li {{ block.shopify_attributes }}>
            <span class="lm-whyl__ic" aria-hidden="true">
              {%- case b.icon -%}
                {%- when 'calendar' -%}<svg viewBox="0 0 24 24"><rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M8 3v4M16 3v4M3.5 10h17"/><path d="M12 18.2l-2.3-2.2a1.4 1.4 0 0 1 2.3-1.6 1.4 1.4 0 0 1 2.3 1.6z"/></svg>
                {%- when 'pulse' -%}<svg viewBox="0 0 24 24"><path d="M20.4 5.6a5 5 0 0 0-7.1 0L12 6.9l-1.3-1.3a5 5 0 0 0-7.1 7.1L12 21l8.4-8.3a5 5 0 0 0 0-7.1z"/><path d="M5 12h3.5l1.5-2.5 2.5 5 1.5-2.5H19"/></svg>
                {%- when 'stethoscope' -%}<svg viewBox="0 0 24 24"><path d="M6 3.5H5a1 1 0 0 0-1 1V9a5 5 0 0 0 10 0V4.5a1 1 0 0 0-1-1h-1"/><path d="M9 14v1.5a4.5 4.5 0 0 0 9 0V13"/><circle cx="18" cy="11" r="2"/></svg>
                {%- when 'chart' -%}<svg viewBox="0 0 24 24"><path d="M4 20h16M7 16v-4M12 16V7M17 16v-6"/></svg>
                {%- when 'heart' -%}<svg viewBox="0 0 24 24"><path d="M20.4 5.6a5 5 0 0 0-7.1 0L12 6.9l-1.3-1.3a5 5 0 0 0-7.1 7.1L12 21l8.4-8.3a5 5 0 0 0 0-7.1z"/></svg>
                {%- when 'doctor' -%}<svg viewBox="0 0 24 24"><circle cx="10" cy="8" r="4"/><path d="M3 20a7 7 0 0 1 14 0M17 11l2 2 3-3"/></svg>
                {%- else -%}<svg viewBox="0 0 24 24"><path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4"/></svg>
              {%- endcase -%}
            </span>
            <b>{{ b.title }}</b>
            {%- if block.type == 'certs' -%}
              <span class="lm-whyl__logos">
                {%- for i in (1..4) -%}
                  {%- assign lk = 'logo_' | append: i -%}
                  {%- if b[lk] != blank -%}{{ b[lk] | image_url: width: 160 | image_tag: loading: 'lazy', alt: b[lk].alt }}{%- endif -%}
                {%- endfor -%}
              </span>
            {%- elsif b.text != blank -%}
              <span>{{ b.text }}</span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
    {%- if s.image != blank -%}
      <div class="lm-whyl__img">{{ s.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '420, 640, 900', sizes: '(max-width: 749px) 70vw, 440px', alt: s.image.alt }}</div>
    {%- endif -%}
  </div>
</section>
<script>
  (function () {
    var list = document.currentScript.previousElementSibling.querySelector('[data-lm-anim]');
    if (!list || !('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    list.classList.add('lm-anim');
    new IntersectionObserver(function (es, io) {
      if (!es[0].isIntersecting) return;
      list.classList.add('is-in'); io.disconnect();
    }, { threshold: .25 }).observe(list);
  })();
</script>

{% schema %}
{
  "name": "LM: why trust (list)",
  "tag": "div",
  "settings": [
    { "type": "checkbox", "id": "dividers", "label": "Thin lines between the points", "default": false },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why do thousands" },
    { "type": "text", "id": "highlight", "label": "Heading part in red", "default": "trust sehatUP?" },
    { "type": "image_picker", "id": "image", "label": "Round photo" },
    { "type": "select", "id": "tone", "label": "Background", "default": "white", "options": [{ "value": "white", "label": "White" }, { "value": "stone", "label": "Stone" }] },
    {"type":"header","content":"Sizes"},
    {"type":"range","id":"image_width","label":"Round photo width","min":200,"max":640,"step":10,"unit":"px","default":520},
    {"type":"range","id":"icon_size","label":"Icon circle size","min":36,"max":80,"step":2,"unit":"px","default":56}
  ],
  "blocks": [
    {
      "type": "point", "name": "Point",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "shield", "options": [{ "value": "chart", "label": "Chart" }, { "value": "heart", "label": "Heart" }, { "value": "doctor", "label": "Doctor" }, { "value": "shield", "label": "Shield" }, { "value": "calendar", "label": "Calendar with heart" }, { "value": "pulse", "label": "Heart with pulse" }, { "value": "stethoscope", "label": "Stethoscope" }] },
        { "type": "text", "id": "title", "label": "Title", "default": "Point" },
        { "type": "text", "id": "text", "label": "Line under it" }
      ]
    },
    {
      "type": "certs", "name": "Certificates", "limit": 1,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "shield", "options": [{ "value": "chart", "label": "Chart" }, { "value": "heart", "label": "Heart" }, { "value": "doctor", "label": "Doctor" }, { "value": "shield", "label": "Shield" }, { "value": "calendar", "label": "Calendar with heart" }, { "value": "pulse", "label": "Heart with pulse" }, { "value": "stethoscope", "label": "Stethoscope" }] },
        { "type": "text", "id": "title", "label": "Title", "default": "We are certified" },
        { "type": "image_picker", "id": "logo_1", "label": "Logo 1" },
        { "type": "image_picker", "id": "logo_2", "label": "Logo 2" },
        { "type": "image_picker", "id": "logo_3", "label": "Logo 3" },
        { "type": "image_picker", "id": "logo_4", "label": "Logo 4" }
      ]
    }
  ],
  "presets": [{ "name": "LM: why trust (list)" }]
}
{% endschema %}
