{%- comment -%}
  Proof strip: heading and line on top, large certificate logos with labels below, straight on the page.
{%- endcomment -%}

{%- assign s = section.settings -%}

<style>
  #sce-{{ section.id }} { padding: {% if s.section_bg == blank or s.section_bg == '#ffffff' %}clamp(16px, 2.4vw, 32px){% else %}clamp(40px, 5vw, 72px){% endif %} clamp(16px, 3vw, 48px) 0; background: {{ s.section_bg | default: '#ffffff' }}; font-family: 'Montserrat', sans-serif; color: #1d1d1d; }
  #sce-{{ section.id }} * { box-sizing: border-box; }
  #sce-{{ section.id }} .sce__inner { max-width: 1240px; margin: 0 auto; padding: clamp(12px, 1.6vw, 20px) clamp(20px, 3vw, 40px) 0; text-align: center; }
  #sce-{{ section.id }} .sce__h { margin: 0 auto; max-width: 26em; font: 800 clamp(22px, 2.4vw, 32px)/1.15 'Montserrat', sans-serif; letter-spacing: -.02em; }
  #sce-{{ section.id }} .sce__h small { display: block; margin-top: 8px; font: 500 15px/1.5 'Montserrat', sans-serif; color: #5f5a56; letter-spacing: 0; }
  #sce-{{ section.id }} .sce__list { list-style: none; margin: clamp(24px, 3vw, 36px) 0 0; padding: 0; display: flex; justify-content: center; gap: clamp(24px, 6vw, 88px); flex-wrap: wrap; }
  #sce-{{ section.id }} .sce__item { display: flex; flex-direction: column; align-items: center; gap: 14px; }
  #sce-{{ section.id }} .sce__logo { width: clamp(96px, 9vw, 128px); height: clamp(96px, 9vw, 128px); display: grid; place-items: center; }
  #sce-{{ section.id }} .sce__logo img { width: 100%; height: 100%; object-fit: contain; }
  #sce-{{ section.id }} .sce__item b { font: 700 16px/1.3 'Montserrat', sans-serif; }
  @media (max-width: 599px) {
    #sce-{{ section.id }} .sce__list { display: grid; grid-template-columns: repeat({{ section.blocks.size | at_most: 3 }}, minmax(0, 1fr)); gap: 12px; }
    #sce-{{ section.id }} .sce__logo { width: 84px; height: 84px; }
    #sce-{{ section.id }} .sce__item { gap: 10px; }
    #sce-{{ section.id }} .sce__item b { font-size: 13px; }
  }
</style>

<section id="sce-{{ section.id }}" class="sce">
  <div class="sce__inner">
    <h2 class="sce__h">{{ s.heading }}{%- if s.subheading != blank -%}<small>{{ s.subheading }}</small>{%- endif -%}</h2>
    <ul class="sce__list">
      {%- for b in section.blocks -%}
        <li class="sce__item" {{ b.shopify_attributes }}>
          <span class="sce__logo">
            {%- if b.settings.logo != blank -%}{{ b.settings.logo | image_url: width: 300 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
          </span>
          <b>{{ b.settings.label }}</b>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "sehatUP certificates",
  "tag": "div",
  "class": "section-sehat-certs",
  "settings": [
    { "type": "color", "id": "section_bg", "label": "Section background", "default": "#ffffff" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made and checked the right way" },
    { "type": "text", "id": "subheading", "label": "Small line under the heading" }
  ],
  "blocks": [
    { "type": "cert", "name": "Certificate", "limit": 5, "settings": [
      { "type": "image_picker", "id": "logo", "label": "Logo" },
      { "type": "text", "id": "label", "label": "Label", "default": "GMP Certified" }
    ] }
  ],
  "presets": [{ "name": "sehatUP certificates" }]
}
{% endschema %}
