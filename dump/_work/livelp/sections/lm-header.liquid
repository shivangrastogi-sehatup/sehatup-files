{%- assign s = section.settings -%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Google+Sans:wght@400;500;600;700&display=swap">
{{ 'landing-men.css' | asset_url | stylesheet_tag }}
<script>document.body.classList.add('lm-page');</script>
<script type="module">
  import 'https://cdn.jsdelivr.net/npm/number-flow@0.6.2/+esm';
  var still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll('[data-lp-timer] b').forEach(function (b) {
    var f = document.createElement('number-flow');
    f.format = { minimumIntegerDigits: 2 };
    f.trend = -1;
    if (!b.hasAttribute('data-h')) f.digits = { 1: { max: 5 } };
    f.animated = !still;
    f.update(Number(b.textContent) || 0);
    b.style.display = 'none';
    b.after(f);
    new MutationObserver(function () { f.update(Number(b.textContent) || 0); })
      .observe(b, { childList: true, characterData: true, subtree: true });
  });
</script>

<header class="lm-top{% if s.mobile_bar %} lm-top--mbar{% endif %}" style="--lm-logo: {{ s.logo_width }}px;">
  <div class="lm-wrap lm-top__in">
    {%- if s.links != blank -%}
      <details class="lm-menu" data-lm-menu>
        <summary aria-label="Menu"><svg viewBox="0 0 24 24" aria-hidden="true"><path class="lm-menu__open" d="M4 7h16M4 12h16M4 17h16"/><path class="lm-menu__close" d="M6 6l12 12M18 6L6 18"/></svg></summary>
        <div class="lm-menu__panel">
          <nav aria-label="Menu">
            {%- assign mlinks = s.links | newline_to_br | split: '<br />' -%}
            {%- for l in mlinks -%}
              {%- assign p = l | strip | split: '|' -%}
              {%- if p.size == 2 -%}<a href="{{ p[1] | strip }}">{{ p[0] | strip }}<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3l5 5-5 5"/></svg></a>{%- endif -%}
            {%- endfor -%}
          </nav>
          {%- if s.button != blank -%}<a class="lm-btn lm-btn--red" href="{{ s.button_link | default: '#book' }}">{{ s.button }}<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>{%- endif -%}
          {%- if s.wa_link != blank -%}<a class="lm-btn lm-btn--line" href="{{ s.wa_link }}" target="_blank" rel="noopener">{{ s.wa_label | default: 'Chat with us' }} on WhatsApp</a>{%- endif -%}
        </div>
      </details>
    {%- endif -%}
    <a class="lm-top__logo" href="{{ routes.root_url }}" aria-label="sehatUP home">
      {%- if s.logo != blank -%}
        {{ s.logo | image_url: width: 300 | image_tag: alt: 'sehatUP', widths: '150, 300', sizes: '128px' }}
      {%- else -%}
        <img src="https://www.sehatup.com/cdn/shop/files/New_Logo_Red_and_Black_without_tagline.webp?v=1773229485&width=300" alt="sehatUP" width="128" height="28">
      {%- endif -%}
    </a>
    <nav class="lm-top__nav" aria-label="sehatUP">
      {%- assign links = s.links | newline_to_br | split: '<br />' -%}
      {%- for l in links -%}
        {%- assign p = l | strip | split: '|' -%}
        {%- if p.size == 2 -%}<a href="{{ p[1] | strip }}">{{ p[0] | strip }}</a>{%- endif -%}
      {%- endfor -%}
    </nav>
    {%- if s.trust_number != blank -%}
      <span class="lm-top__trust">
        <span class="lm-top__faces" aria-hidden="true">
          {%- for i in (1..3) -%}
            {%- assign fk = 'face_' | append: i -%}
            {%- if s[fk] != blank -%}{{ s[fk] | image_url: width: 64 | image_tag: alt: '', loading: 'eager' }}{%- endif -%}
          {%- endfor -%}
        </span>
        <span>{{ s.trust_before }} <b>{{ s.trust_number }}</b></span>
      </span>
    {%- endif -%}
    {%- if s.button != blank -%}
      <a class="lm-btn lm-btn--red lm-top__btn" href="{{ s.button_link | default: '#book' }}">{{ s.button }}<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>
    {%- endif -%}
  </div>
</header>
<script>
  (function () {
    var m = document.querySelector('[data-lm-menu]');
    if (!m) return;
    m.addEventListener('click', function (e) { if (e.target.closest('.lm-menu__panel a')) m.open = false; });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') m.open = false; });
    matchMedia('(min-width: 700px)').addEventListener('change', function (q) { if (q.matches) m.open = false; });
  })();
</script>

{%- if s.mobile_bar and s.button != blank -%}
  <div class="lm-mbar is-away" data-lm-mbar>
    <a class="lm-btn lm-btn--red" href="{{ s.button_link | default: '#book' }}">{{ s.button }}<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>
  </div>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var bar = document.querySelector('[data-lm-mbar]');
      if (!bar) return;
      document.body.classList.add('has-lm-mbar');
      if (!('IntersectionObserver' in window)) return;
      var hero = document.querySelector('.lm-hero'), form = document.querySelector('#book [data-lp-form]') || document.getElementById('book');
      var heroOn = !!hero, formOn = false;
      function sync() { bar.classList.toggle('is-away', heroOn || formOn); }
      if (hero) new IntersectionObserver(function (e) { heroOn = e[0].isIntersecting; sync(); }).observe(hero);
      if (form) new IntersectionObserver(function (e) { formOn = e[0].isIntersecting; sync(); }).observe(form);
      sync();
    });
  </script>
{%- endif -%}
{%- if s.wa_link != blank -%}
  <a class="lm-wa" href="{{ s.wa_link }}" target="_blank" rel="noopener" aria-label="{{ s.wa_label | default: 'Chat on WhatsApp' | escape }}">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.7a2.8 2.8 0 0 0 1.8-1.3 2.3 2.3 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3z"/></svg>
    {%- if s.wa_label != blank -%}<span>{{ s.wa_label }}</span>{%- endif -%}
  </a>
{%- endif -%}

{% schema %}
{
  "name": "LM header",
  "tag": "div",
  "settings": [
    { "type": "checkbox", "id": "mobile_bar", "label": "On phones, show the button in a bar at the bottom", "info": "Takes it out of the top bar on phones; hides while the booking form is on screen.", "default": false },
    { "type": "image_picker", "id": "logo", "label": "Logo (empty uses the sehatUP logo)" },
    { "type": "textarea", "id": "links", "label": "Links (Label|URL, one per line)", "default": "Home|/\nAbout|/pages/about-us\nContact Us|/pages/contact" },
    { "type": "text", "id": "trust_before", "label": "Trust badge text", "default": "Trusted by" },
    { "type": "text", "id": "trust_number", "label": "Trust badge number", "default": "65,000+" },
    { "type": "text", "id": "button", "label": "Button on the right", "default": "Book Consultation" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Empty goes to the booking form." },
    { "type": "url", "id": "wa_link", "label": "Floating WhatsApp button link", "info": "A wa.me link. Empty hides the button." },
    { "type": "text", "id": "wa_label", "label": "WhatsApp button label (desktop hover)", "default": "Chat with us" },
    { "type": "image_picker", "id": "face_1", "label": "Badge face 1" },
    { "type": "image_picker", "id": "face_2", "label": "Badge face 2" },
    { "type": "image_picker", "id": "face_3", "label": "Badge face 3" },
    {"type":"header","content":"Sizes"},
    {"type":"range","id":"logo_width","label":"Logo width","min":80,"max":220,"step":4,"unit":"px","default":128,"info":"Phones use 85% of this."}
  ],
  "presets": [{ "name": "LM header" }]
}
{% endschema %}
