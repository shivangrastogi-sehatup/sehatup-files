{%- comment -%}
  Line icons for the landing pages. Usage: {% render 'lp-icon', name: 'scale' %}
  24x24, stroke = currentColor, so the icon takes the surrounding text colour.
{%- endcomment -%}
<svg class="lp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
{%- case name -%}
  {%- when 'scale' -%}<rect x="3" y="3" width="18" height="18" rx="4"/><path d="M8 9a4 4 0 0 1 8 0"/><path d="M12 9l1.5-2"/>
  {%- when 'face' -%}<circle cx="12" cy="10" r="6"/><path d="M9.5 12.5c.8.7 1.6 1 2.5 1s1.7-.3 2.5-1"/><path d="M8 18.5c1 1.6 2.4 2.5 4 2.5s3-.9 4-2.5"/>
  {%- when 'mood' -%}<circle cx="12" cy="12" r="9"/><path d="M8.5 15c1-1 2.2-1.5 3.5-1.5s2.5.5 3.5 1.5"/><path d="M9 9.5h.01M15 9.5h.01"/>
  {%- when 'hair' -%}<path d="M5 20c0-6 2-12 7-16"/><path d="M10 20c0-5 1.5-9 5-12"/><path d="M15 20c0-4 1-6.5 4-8"/>
  {%- when 'sparkle' -%}<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/><path d="M19 17l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7z"/>
  {%- when 'drop' -%}<path d="M12 3c3.5 4.2 6 7.6 6 10.6A6 6 0 0 1 6 13.6C6 10.6 8.5 7.2 12 3z"/>
  {%- when 'calendar' -%}<rect x="3" y="5" width="18" height="16" rx="3"/><path d="M3 10h18M8 3v4M16 3v4"/><path d="M14.5 15.5a1.5 1.5 0 1 1-3 0c0-1 1.5-2.5 1.5-2.5s1.5 1.5 1.5 2.5z"/>
  {%- when 'flame' -%}<path d="M12 21a6 6 0 0 0 6-6c0-3.5-2.5-5.5-3.5-8.5-1.5 2-2 3.5-2.5 5-1-1-1.5-2-1.5-3.5C8 10 6 12.3 6 15a6 6 0 0 0 6 6z"/>
  {%- when 'heart' -%}<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/>
  {%- when 'link' -%}<path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/>
  {%- when 'clock' -%}<circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2"/><path d="M9 2h6"/>
  {%- when 'sliders' -%}<path d="M4 7h10M18 7h2M4 17h4M12 17h8"/><circle cx="16" cy="7" r="2"/><circle cx="10" cy="17" r="2"/>
  {%- when 'brain' -%}<path d="M9 4a3 3 0 0 0-3 3 3 3 0 0 0-2 5 3 3 0 0 0 2 5 3 3 0 0 0 3 3h1V4z"/><path d="M15 4a3 3 0 0 1 3 3 3 3 0 0 1 2 5 3 3 0 0 1-2 5 3 3 0 0 1-3 3h-1V4z"/>
  {%- when 'user' -%}<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>
  {%- when 'battery' -%}<rect x="2" y="7" width="17" height="10" rx="2"/><path d="M22 11v2"/><path d="M5.5 10.5v3"/>
  {%- when 'leaf' -%}<path d="M5 19c0-9 6-14 15-14 0 9-5 15-14 15"/><path d="M5 19l8-8"/>
  {%- when 'bottle' -%}<path d="M9 3h6v3H9z"/><path d="M8 6h8l1 3v10a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V9z"/><path d="M10 14h4M12 12v4"/>
  {%- when 'pill' -%}<rect x="3" y="8.5" width="18" height="7" rx="3.5" transform="rotate(-45 12 12)"/><path d="M9.5 9.5l5 5"/>
  {%- when 'doctor' -%}<circle cx="12" cy="7" r="4"/><path d="M5 21v-1a7 7 0 0 1 14 0v1"/><path d="M9 14v3a3 3 0 0 0 6 0"/>
  {%- when 'box' -%}<path d="M3 8l9-5 9 5v8l-9 5-9-5z"/><path d="M3 8l9 5 9-5M12 13v8"/>
  {%- when 'target' -%}<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/>
  {%- when 'gear' -%}<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"/>
  {%- when 'cycle' -%}<path d="M20 12a8 8 0 0 1-14 5.3"/><path d="M4 12a8 8 0 0 1 14-5.3"/><path d="M18 3v4h-4M6 21v-4h4"/>
  {%- when 'chart' -%}<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>
  {%- when 'shield' -%}<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M9 12l2 2 4-4"/>
  {%- when 'chat' -%}<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/>
  {%- when 'lock' -%}<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>
  {%- when 'check' -%}<circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/>
  {%- when 'plan' -%}<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 8h6M9 12h6M9 16h3"/>
  {%- else -%}<circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/>
{%- endcase -%}
</svg>
