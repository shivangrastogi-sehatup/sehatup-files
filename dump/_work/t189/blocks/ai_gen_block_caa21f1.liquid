    <div class="ai-why-matters-layout-{{ ai_gen_id }} {% if block.settings.diagram_position == 'right' %}diagram-right{% endif %}">
      <div class="ai-why-matters-diagram-{{ ai_gen_id }}">
        <div class="ai-why-matters-diagram-wrapper-{{ ai_gen_id }}">
          {% if block.settings.custom_diagram_image %}
            <img
              src="{{ block.settings.custom_diagram_image | image_url: width: 1000 }}"
              alt="{{ block.settings.custom_diagram_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.custom_diagram_image.width }}"
              height="{{ block.settings.custom_diagram_image.height }}"
            >
          {% else %}
            <svg class="ai-why-matters-diagram-svg-{{ ai_gen_id }}" viewBox="0 0 500 500" xmlns="http://www.w3.org/2000/svg">
              <circle cx="250" cy="250" r="60" fill="{{ block.settings.center_circle_color }}" stroke="{{ block.settings.center_circle_border_color }}" stroke-width="3"/>
              <text x="250" y="250" text-anchor="middle" dominant-baseline="central" fill="{{ block.settings.center_text_color }}" font-size="18" font-weight="600">{{ block.settings.center_circle_text }}</text>
              
              <circle cx="250" cy="100" r="35" fill="{{ block.settings.icon_bg_color }}" stroke="{{ block.settings.icon_border_color }}" stroke-width="2"/>
              <path d="M 250 120 L 250 190" stroke="{{ block.settings.connector_color }}" stroke-width="2" stroke-dasharray="5,5"/>
              <text x="250" y="105" text-anchor="middle" font-size="24" fill="{{ block.settings.icon_color }}">🧬</text>
              
              <circle cx="390" cy="160" r="35" fill="{{ block.settings.icon_bg_color }}" stroke="{{ block.settings.icon_border_color }}" stroke-width="2"/>
              <path d="M 370 180 L 295 225" stroke="{{ block.settings.connector_color }}" stroke-width="2" stroke-dasharray="5,5"/>
              <text x="390" y="165" text-anchor="middle" font-size="24" fill="{{ block.settings.icon_color }}">🧠</text>
              
              <circle cx="390" cy="340" r="35" fill="{{ block.settings.icon_bg_color }}" stroke="{{ block.settings.icon_border_color }}" stroke-width="2"/>
              <path d="M 370 320 L 295 275" stroke="{{ block.settings.connector_color }}" stroke-width="2" stroke-dasharray="5,5"/>
              <text x="390" y="345" text-anchor="middle" font-size="24" fill="{{ block.settings.icon_color }}">🛏️</text>
              
              <circle cx="250" cy="400" r="35" fill="{{ block.settings.icon_bg_color }}" stroke="{{ block.settings.icon_border_color }}" stroke-width="2"/>
              <path d="M 250 380 L 250 310" stroke="{{ block.settings.connector_color }}" stroke-width="2" stroke-dasharray="5,5"/>
              <text x="250" y="405" text-anchor="middle" font-size="24" fill="{{ block.settings.icon_color }}">📅</text>
              
              <circle cx="110" cy="340" r="35" fill="{{ block.settings.icon_bg_color }}" stroke="{{ block.settings.icon_border_color }}" stroke-width="2"/>
              <path d="M 130 320 L 205 275" stroke="{{ block.settings.connector_color }}" stroke-width="2" stroke-dasharray="5,5"/>
              <text x="110" y="345" text-anchor="middle" font-size="24" fill="{{ block.settings.icon_color }}">🩺</text>
              
              <circle cx="110" cy="160" r="35" fill="{{ block.settings.icon_bg_color }}" stroke="{{ block.settings.icon_border_color }}" stroke-width="2"/>
              <path d="M 130 180 L 205 225" stroke="{{ block.settings.connector_color }}" stroke-width="2" stroke-dasharray="5,5"/>
              <text x="110" y="165" text-anchor="middle" font-size="24" fill="{{ block.settings.icon_color }}">🔬</text>
            </svg>
          {% endif %}
        </div>
      </div>

      <div class="ai-why-matters-content-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-why-matters-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}

        {% if block.settings.paragraph_1 != blank %}
          <p class="ai-why-matters-paragraph-{{ ai_gen_id }}">{{ block.settings.paragraph_1 }}</p>
        {% endif %}

        {% if block.settings.paragraph_2 != blank %}
          <p class="ai-why-matters-paragraph-{{ ai_gen_id }}">{{ block.settings.paragraph_2 }}</p>
        {% endif %}

        <div class="ai-why-matters-tags-{{ ai_gen_id }}">
          {% if block.settings.tag_1_text != blank %}
            <span class="ai-why-matters-tag-{{ ai_gen_id }}" style="background-color: {{ block.settings.tag_1_bg }}; color: {{ block.settings.tag_1_text_color }};">
              {{ block.settings.tag_1_text }}
            </span>
          {% endif %}
          {% if block.settings.tag_2_text != blank %}
            <span class="ai-why-matters-tag-{{ ai_gen_id }}" style="background-color: {{ block.settings.tag_2_bg }}; color: {{ block.settings.tag_2_text_color }};">
              {{ block.settings.tag_2_text }}
            </span>
          {% endif %}
          {% if block.settings.tag_3_text != blank %}
            <span class="ai-why-matters-tag-{{ ai_gen_id }}" style="background-color: {{ block.settings.tag_3_bg }}; color: {{ block.settings.tag_3_text_color }};">
              {{ block.settings.tag_3_text }}
            </span>
          {% endif %}
          {% if block.settings.tag_4_text != blank %}
            <span class="ai-why-matters-tag-{{ ai_gen_id }}" style="background-color: {{ block.settings.tag_4_bg }}; color: {{ block.settings.tag_4_text_color }};">
              {{ block.settings.tag_4_text }}
            </span>
          {% endif %}
          {% if block.settings.tag_5_text != blank %}
            <span class="ai-why-matters-tag-{{ ai_gen_id }}" style="background-color: {{ block.settings.tag_5_bg }}; color: {{ block.settings.tag_5_text_color }};">
              {{ block.settings.tag_5_text }}
            </span>
          {% endif %}
          {% if block.settings.tag_6_text != blank %}
            <span class="ai-why-matters-tag-{{ ai_gen_id }}" style="background-color: {{ block.settings.tag_6_bg }}; color: {{ block.settings.tag_6_text_color }};">
              {{ block.settings.tag_6_text }}
            </span>
          {% endif %}
          {% if block.settings.tag_7_text != blank %}
            <span class="ai-why-matters-tag-{{ ai_gen_id }}" style="background-color: {{ block.settings.tag_7_bg }}; color: {{ block.settings.tag_7_text_color }};">
              {{ block.settings.tag_7_text }}
            </span>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</why-it-matters-{{ ai_gen_id }}>

<script>
  (function() {
    class WhyItMatters{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupAccessibility();
      }

      setupAccessibility() {
        const heading = this.querySelector('.ai-why-matters-heading-{{ ai_gen_id }}');
        if (heading && !heading.hasAttribute('role')) {
          heading.setAttribute('role', 'heading');
          heading.setAttribute('aria-level', '2');
        }
      }
    }

    customElements.define('why-it-matters-{{ ai_gen_id }}', WhyItMatters{{ ai_gen_id }});
  })();
</script>

