{% doc %}
  @prompt
    Create a responsive "Why It Matters" section with a two-column layout featuring a circular health diagram and informational content.Layout structure:Left column:- Circular diagram with "360 PLAN" in center (red circle)- Six health icons arranged in a circle around the center, connected by dashed lines:  * Blood test/lab icon (top-left)  * Shield with DNA icon (top)  * Brain/mental health icon (top-right)  * Sleep/bed icon (right)  * Pelvic health icon (bottom-right)  * Calendar/period tracking icon (bottom-left)Right column:- Heading: "Why It Matters"- Paragraph 1: "Most people wait for symptoms to get 'serious' before acting. That's the biggest mistake."- Paragraph 2: "Health Score 360 helps you understand early signals related to"- Tag pills in a flexible grid layout:  * Row 1: "Metabolism" (green), "Hormonal imbalance" (beige), "Stress" (light purple)  * Row 2: "Sleep" (pink), "Weight fluctuations" (yellow), "Sexual performance" (light green)  * Row 3: "Period irregularities" (light pink)Requirements:- Fully responsive layout:  * Desktop: 2 columns (diagram left, content right)  * Tablet: 2 columns with adjusted spacing  * Mobile: stacked (diagram on top, content below)- Settings schema to customize:  * Heading text  * Paragraph text (2 separate fields)  * Central circle text and color  * Upload custom diagram image OR use built-in SVG  * Tag pills as blocks: text, background color, text color for each pill  * Add/remove/reorder tag pills  * Typography: heading size, body text size  * Spacing: section padding, column gap, tag spacing  * Color pickers: heading color, text color, circle color, tag colors  * Layout options: diagram position (left/right), alignment- Tag pills should have rounded corners and subtle backgrounds- Diagram should scale proportionally on all devices- Mobile: center-aligned content, full-width tags- Include hover effects on tag pills (optional)- Max-width container for desktop- Flexible block system for health signal tags
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-why-matters-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-why-matters-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-why-matters-layout-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
    align-items: center;
  }

  .ai-why-matters-layout-{{ ai_gen_id }}.diagram-right {
    grid-template-columns: 1fr 1fr;
  }

  .ai-why-matters-layout-{{ ai_gen_id }}.diagram-right .ai-why-matters-diagram-{{ ai_gen_id }} {
    order: 2;
  }

  .ai-why-matters-layout-{{ ai_gen_id }}.diagram-right .ai-why-matters-content-{{ ai_gen_id }} {
    order: 1;
  }

  .ai-why-matters-diagram-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
  }

  .ai-why-matters-diagram-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    max-width: 500px;
    aspect-ratio: 1;
  }

  .ai-why-matters-diagram-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-why-matters-diagram-svg-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
  }

  .ai-why-matters-content-{{ ai_gen_id }} {
    padding: 20px;
  }

  .ai-why-matters-heading-{{ ai_gen_id }} {
    font-size: clamp(24px,3.4vw,64px);
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    font-weight: 600;
    line-height: 1.2;
    text-align: {{ block.settings.content_alignment }};
  }

  .ai-why-matters-paragraph-{{ ai_gen_id }} {
    font-size: clamp(10px, 1.2vw, 20px);
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.paragraph_spacing }}px;
    line-height: 1.6;
    text-align: {{ block.settings.content_alignment }};
  }

  .ai-why-matters-paragraph-{{ ai_gen_id }}:last-of-type {
    margin-bottom: {{ block.settings.tags_top_spacing }}px;
  }

  .ai-why-matters-tags-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: {{ block.settings.tag_spacing }}px;
    {% if block.settings.content_alignment == 'center' %}
      justify-content: center;
    {% elsif block.settings.content_alignment == 'right' %}
      justify-content: flex-end;
    {% else %}
      justify-content: flex-start;
    {% endif %}
  }

  .ai-why-matters-tag-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.tag_padding_vertical }}px {{ block.settings.tag_padding_horizontal }}px;
    border-radius: {{ block.settings.tag_border_radius }}px;
    font-size: clamp(10px, 1.2vw, 20px);
    font-weight: 500;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  {% if block.settings.enable_tag_hover %}
    .ai-why-matters-tag-{{ ai_gen_id }}:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }
  {% endif %}

  @media screen and (max-width: 989px) {
    .ai-why-matters-layout-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_row_gap }}px;
    }

    .ai-why-matters-layout-{{ ai_gen_id }}.diagram-right .ai-why-matters-diagram-{{ ai_gen_id }} {
      order: 1;
    }

    .ai-why-matters-layout-{{ ai_gen_id }}.diagram-right .ai-why-matters-content-{{ ai_gen_id }} {
      order: 2;
    }

    .ai-why-matters-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.85 }}px;
      text-align: {{ block.settings.mobile_alignment }};
    }

    .ai-why-matters-paragraph-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.95 }}px;
      text-align: {{ block.settings.mobile_alignment }};
    }

    .ai-why-matters-tags-{{ ai_gen_id }} {
      {% if block.settings.mobile_alignment == 'center' %}
        justify-content: center;
      {% elsif block.settings.mobile_alignment == 'right' %}
        justify-content: flex-end;
      {% else %}
        justify-content: flex-start;
      {% endif %}
    }

    .ai-why-matters-diagram-wrapper-{{ ai_gen_id }} {
      max-width: 400px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-why-matters-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.7 }}px {{ block.settings.section_padding_horizontal | times: 0.7 }}px {{ block.settings.section_padding_bottom | times: 0.7 }}px;
    }

    .ai-why-matters-content-{{ ai_gen_id }} {
      padding: 10px;
    }

    .ai-why-matters-diagram-{{ ai_gen_id }} {
      padding: 10px;
    }

    .ai-why-matters-diagram-wrapper-{{ ai_gen_id }} {
      max-width: 320px;
    }

    .ai-why-matters-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.75 }}px;
    }

    .ai-why-matters-paragraph-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }

    .ai-why-matters-tag-{{ ai_gen_id }} {
      font-size: {{ block.settings.tag_text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<why-it-matters-{{ ai_gen_id }} class="ai-why-matters-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
