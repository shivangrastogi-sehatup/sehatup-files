{% doc %}
  @prompt
    Create a bottom-left notification widget for the Zencal D3K2 product page (product ID: 10810987413807) with these features:
    
    FUNCTIONALITY:
    - Appears automatically after page load
    - Auto-dismisses after 10 seconds with smooth fade-out animation
    - Has a close icon (X) in the top right corner
    - If user clicks close icon, sets a session storage flag to prevent re-appearance until page reload
    - Positioned in bottom left corner, 80-100px from bottom and 20-30px from left (to sit above WhatsApp icon)
    - Fixed positioning so it stays visible while scrolling
    
    STYLING:
    - Premium healthcare aesthetic with clean, modern design
    - Soft rounded corners (12-16px border radius)
    - Gentle shadow for depth
    - Soothing color palette: white/light background with accent color (soft green or blue)
    - Smooth entrance animation (slide-in from left + fade-in)
    - Smooth exit animation (fade-out)
    - Mobile responsive with adjusted positioning for smaller screens
    
    CUSTOMIZABLE SETTINGS:
    - Heading text field
    - Body text field  
    - Background color
    - Text color
    - Accent/border color
    - Auto-dismiss delay (default 10 seconds)
    - Animation speed
    
    Make it visually appealing, professional, and non-intrusive with premium healthcare branding feel.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-notification-widget-{{ ai_gen_id }} {
    display: block;
    position: fixed;
    bottom: {{ block.settings.bottom_position }}px;
    left: {{ block.settings.left_position }}px;
    z-index: 999;
    max-width: 360px;
    width: calc(100% - 40px);
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    border-radius: {{ block.settings.border_radius }}px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12), 0 2px 8px rgba(0, 0, 0, 0.08);
    padding: 20px;
    opacity: 0;
    transform: translateX(-30px);
    transition: opacity {{ block.settings.animation_speed }}s ease, transform {{ block.settings.animation_speed }}s ease;
    border: 1px solid {{ block.settings.accent_color }};
    border-left: 4px solid {{ block.settings.accent_color }};
  }

  .ai-notification-widget-{{ ai_gen_id }}.ai-notification-visible-{{ ai_gen_id }} {
    opacity: 1;
    transform: translateX(0);
  }

  .ai-notification-widget-{{ ai_gen_id }}.ai-notification-hiding-{{ ai_gen_id }} {
    opacity: 0;
    transform: translateX(-20px);
  }

  .ai-notification-header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 12px;
  }

  .ai-notification-heading-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: 600;
    margin: 0;
    color: {{ block.settings.text_color }};
    line-height: 1.3;
    padding-right: 10px;
  }

  .ai-notification-close-{{ ai_gen_id }} {
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.text_color }};
    opacity: 0.6;
    transition: opacity 0.2s ease;
    flex-shrink: 0;
  }

  .ai-notification-close-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-notification-close-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  .ai-notification-body-{{ ai_gen_id }} {
    font-size: 14px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
    opacity: 0.9;
  }

  .ai-notification-accent-bar-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background-color: {{ block.settings.accent_color }};
    border-radius: 0 0 {{ block.settings.border_radius }}px {{ block.settings.border_radius }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-notification-widget-{{ ai_gen_id }} {
      bottom: {{ block.settings.bottom_position | times: 0.8 }}px;
      left: {{ block.settings.left_position | times: 0.7 }}px;
      max-width: 320px;
      padding: 16px;
    }

    .ai-notification-heading-{{ ai_gen_id }} {
      font-size: 16px;
    }

    .ai-notification-body-{{ ai_gen_id }} {
      font-size: 13px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-notification-widget-{{ ai_gen_id }} {
      bottom: 20px;
      left: 15px;
      right: 15px;
      width: auto;
      max-width: none;
    }
  }
{% endstyle %}

<notification-widget-{{ ai_gen_id }}
  class="ai-notification-widget-{{ ai_gen_id }}"
  data-auto-dismiss="{{ block.settings.auto_dismiss_delay }}"
  data-animation-speed="{{ block.settings.animation_speed }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-notification-header-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h3 class="ai-notification-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h3>
    {% endif %}
    <button
      class="ai-notification-close-{{ ai_gen_id }}"
      aria-label="Close notification"
      type="button"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  {% if block.settings.body_text != blank %}
    <div class="ai-notification-body-{{ ai_gen_id }}">
      {{ block.settings.body_text }}
    </div>
  {% endif %}

  <div class="ai-notification-accent-bar-{{ ai_gen_id }}"></div>
</notification-widget-{{ ai_gen_id }}>

<script>
  (function() {
    class NotificationWidget{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.storageKey = 'ai-notification-dismissed-{{ ai_gen_id }}';
        this.autoDismissDelay = parseInt(this.dataset.autoDismiss) * 1000;
        this.animationSpeed = parseFloat(this.dataset.animationSpeed) * 1000;
        this.autoDismissTimer = null;
      }

      connectedCallback() {
        if (this.shouldShow()) {
          this.show();
          this.setupEventListeners();
          this.startAutoDismissTimer();
        }
      }

      shouldShow() {
        return !sessionStorage.getItem(this.storageKey);
      }

      show() {
        setTimeout(() => {
          this.classList.add('ai-notification-visible-{{ ai_gen_id }}');
        }, 300);
      }

      hide(userDismissed = false) {
        this.classList.remove('ai-notification-visible-{{ ai_gen_id }}');
        this.classList.add('ai-notification-hiding-{{ ai_gen_id }}');

        if (userDismissed) {
          sessionStorage.setItem(this.storageKey, 'true');
        }

        if (this.autoDismissTimer) {
          clearTimeout(this.autoDismissTimer);
        }

        setTimeout(() => {
          this.style.display = 'none';
        }, this.animationSpeed);
      }

      startAutoDismissTimer() {
        this.autoDismissTimer = setTimeout(() => {
          this.hide(false);
        }, this.autoDismissDelay);
      }

      setupEventListeners() {
        const closeButton = this.querySelector('.ai-notification-close-{{ ai_gen_id }}');
        
        if (closeButton) {
          closeButton.addEventListener('click', () => {
            this.hide(true);
          });
        }

        this.addEventListener('mouseenter', () => {
          if (this.autoDismissTimer) {
            clearTimeout(this.autoDismissTimer);
          }
        });

        this.addEventListener('mouseleave', () => {
          this.startAutoDismissTimer();
        });
      }

      disconnectedCallback() {
        if (this.autoDismissTimer) {
          clearTimeout(this.autoDismissTimer);
        }
      }
    }

    customElements.define('notification-widget-{{ ai_gen_id }}', NotificationWidget{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Notification widget",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Special Offer"
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body text",
      "default": "Get 10% off your first order with code WELCOME10"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#2b2c2d"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#4CAF50"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 12
    },
    {
      "type": "header",
      "content": "Position"
    },
    {
      "type": "range",
      "id": "bottom_position",
      "min": 60,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 90
    },
    {
      "type": "range",
      "id": "left_position",
      "min": 15,
      "max": 40,
