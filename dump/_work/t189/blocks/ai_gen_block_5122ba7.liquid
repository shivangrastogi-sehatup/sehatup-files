    {
      "type": "range",
      "id": "auto_dismiss_delay",
      "min": 5,
      "max": 30,
      "step": 5,
      "unit": "s",
      "label": "Auto-dismiss delay",
      "default": 10
    },
    {
      "type": "range",
      "id": "animation_speed",
      "min": 0.2,
      "max": 1,
      "step": 0.1,
      "unit": "s",
      "label": "Animation speed",
      "default": 0.4
    }
  ],
  "presets": [
    {
      "name": "Notification widget"
    }
  ]
}
{% endschema %}
