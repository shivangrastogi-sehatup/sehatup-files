{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
    .ai-healthcare-hero-{{ ai_gen_id }}{
      position:relative;
      width:100%;
      overflow:hidden;
      background:#000;
    }

    /* ============ BACKGROUND ============ */
    .ai-healthcare-hero__bg-{{ ai_gen_id }}{
      position:absolute;
      inset:0;
      z-index:0;
      overflow:hidden;
    }

    .ai-healthcare-hero__bg-{{ ai_gen_id }} img{
      width:100%;
      height:100%;
      object-fit:cover;
      transform: scale(1.08);
      opacity: {{ block.settings.image_opacity | divided_by: 100.0 }};
    }

    /* Figma layer blur */
    .ai-healthcare-hero__blur-{{ ai_gen_id }}{
      position:absolute;
      inset:0;
      z-index:1;
      backdrop-filter: blur({{ block.settings.layer_blur }}px);
      -webkit-backdrop-filter: blur({{ block.settings.layer_blur }}px);
    }

    /* ============ CONTAINER ============ */
    .ai-healthcare-hero__container-{{ ai_gen_id }}{
      position:relative;
      z-index:2;
      max-width:{{ block.settings.container_width }}px;
      margin:auto;
      padding: {{ block.settings.padding_top }}px 60px {{ block.settings.padding_bottom }}px;
      display:flex;
      align-items:center;
      min-height:{{ block.settings.min_height }}px;
    }

    /* ============ CONTENT ============ */
    .ai-healthcare-hero__content-{{ ai_gen_id }}{
      max-width:640px;
      color:#fff;
    }

    .ai-hero-heading-{{ ai_gen_id }}{
      font-size: {{ block.settings.heading_size }}px;
      font-weight: {{ block.settings.heading_weight }};
      color:#fff;
      line-height:120%;
      margin:0;
    }

    .ai-hero-sub-{{ ai_gen_id }}{
      margin-top:16px;
      font-size: {{ block.settings.sub_size }}px;
    }

    .ai-hero-desc-{{ ai_gen_id }}{
      margin-top:14px;
      font-size: {{ block.settings.desc_size }}px;
      line-height:1.6;
    }

    .ai-hero-highlight-{{ ai_gen_id }}{
      color: {{ block.settings.highlight_color }};
      font-weight:700;
    }

    /* Buttons */
    .ai-healthcare-hero__buttons-{{ ai_gen_id }}{
      display:flex;
      gap:18px;
      margin-top:30px;
    }

    .ai-btn{
      padding:16px 34px;
      border-radius:40px;
      font-weight:600;
      text-decoration:none;
      font-size:15px;
    }
    .ai-btn-primary{ background:#F12F46; color:#fff; }
    .ai-btn-secondary{ border:2px solid #ffffffaa; color:#fff; }

    /* Doctor */
    .ai-healthcare-hero__doctor-wrap-{{ ai_gen_id }}{
      position:absolute;
      right:0;
      bottom:0;
      z-index:2;
    }

    .ai-healthcare-hero__doctor-wrap-{{ ai_gen_id }} img{
      height: {{ block.settings.doctor_height }}px;
    }


    /* ============ BELOW 1278px ============ */
    @media (max-width:1278px){

      .ai-healthcare-hero__doctor-wrap-{{ ai_gen_id }} img{
        height:460px;
      }

      .ai-hero-heading-{{ ai_gen_id }}{
        font-size:37px;
      }

      .ai-hero-sub-{{ ai_gen_id }}{
        font-size:16px;
      }

      .ai-hero-desc-{{ ai_gen_id }}{
        font-size:13px;
      }

    }


    /* ============ CRITICAL OVERLAP FIX BELOW 1208px ============ */
    @media (max-width:1208px){

      .ai-healthcare-hero__container-{{ ai_gen_id }}{
        padding: {{ block.settings.padding_top | minus: 30 }}px 40px {{ block.settings.padding_bottom | minus: 30 }}px;
        min-height:405px;
      }

      .ai-healthcare-hero__doctor-wrap-{{ ai_gen_id }} img{
        height:380px;
      }

      .ai-hero-heading-{{ ai_gen_id }}{
        font-size:30px;
        line-height:115%;
      }

      .ai-hero-sub-{{ ai_gen_id }}{
        font-size:14px;
      }

      .ai-hero-desc-{{ ai_gen_id }}{
        font-size:12px;
      }

      .ai-healthcare-hero__buttons-{{ ai_gen_id }}{
        gap:12px;
        margin-top:22px;
      }

      .ai-btn{
        padding:12px 22px;
        font-size:13px;
      }
    }
    /* ============ MOBILE ============ */
    @media(max-width:1024px){
      .ai-healthcare-hero__container-{{ ai_gen_id }}{
        padding: {{ block.settings.padding_top | minus: 30 }}px 40px {{ block.settings.padding_bottom | minus: 30 }}px;
        min-height:359px;
      }

      .ai-healthcare-hero__doctor-wrap-{{ ai_gen_id }} img{
        height:320px;
      }

      .ai-hero-heading-{{ ai_gen_id }}{
        font-size:24px;
        line-height:115%;
      }

      .ai-hero-sub-{{ ai_gen_id }}{
        font-size:13px;
      }

      .ai-hero-desc-{{ ai_gen_id }}{
        font-size:11px;
      }

      .ai-healthcare-hero__buttons-{{ ai_gen_id }}{
        gap:12px;
        margin-top:22px;
      }

      .ai-btn{
        padding:12px 22px;
        font-size:11px;
      }
    }


    /* ============ PHONE PERFECT LAYOUT ============ */
@media (max-width:972px){

  /* Remove hero behavior */
  .ai-healthcare-hero__container-{{ ai_gen_id }}{
    display:block;
    padding:24px 16px;
    min-height:auto;
  }

  .ai-healthcare-hero__content-{{ ai_gen_id }}{
    max-width:100%;
    text-align:left;     /* important — no center */
  }

  .ai-hero-heading-{{ ai_gen_id }}{
    font-size:22px;
    line-height:130%;
  }

  .ai-hero-sub-{{ ai_gen_id }}{
    font-size:13px;
    margin-top:10px;
  }

  .ai-hero-desc-{{ ai_gen_id }}{
    font-size:12px;
    margin-top:10px;
  }

  /* Buttons left aligned */
  .ai-healthcare-hero__buttons-{{ ai_gen_id }}{
    justify-content:flex-start;
    gap:10px;
    margin-top:16px;
    flex-wrap:wrap;
  }

  .ai-btn{
    padding:10px 18px;
    font-size:12px;
  }

  /* Doctor centered below content */
  .ai-healthcare-hero__doctor-wrap-{{ ai_gen_id }}{
    position:relative;
    right:auto;
    bottom:auto;
    margin:20px auto 0 auto;
    display:flex;
    justify-content:center;
    width:100%;
  }

  .ai-healthcare-hero__doctor-wrap-{{ ai_gen_id }} img{
    height:260px;
  }
}
@media (max-width:380px){

  .ai-healthcare-hero__buttons-{{ ai_gen_id }}{
    flex-direction:column;
    gap:10px;
  }

  .ai-btn{
    width:100%;
    text-align:center;
    padding:12px 16px;
  }

}
{% endstyle %}

<section class="ai-healthcare-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-healthcare-hero__bg-{{ ai_gen_id }}">
    <img src="{{ block.settings.background_image | image_url: width:2000 }}">
    <div class="ai-healthcare-hero__blur-{{ ai_gen_id }}"></div>
  </div>

  <div class="ai-healthcare-hero__container-{{ ai_gen_id }}">
    <div class="ai-healthcare-hero__content-{{ ai_gen_id }}">
      <h1 class="ai-hero-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h1>

      <div class="ai-hero-sub-{{ ai_gen_id }}">
        {{ block.settings.sub_text_before }}
        <span class="ai-hero-highlight-{{ ai_gen_id }}">{{ block.settings.highlight_text }}</span>
      </div>

      <div class="ai-hero-desc-{{ ai_gen_id }}">{{ block.settings.description }}</div>

      <div class="ai-healthcare-hero__buttons-{{ ai_gen_id }}">
        <a href="{{ block.settings.primary_link }}" class="ai-btn ai-btn-primary">{{ block.settings.primary_label }}</a>
        <a href="{{ block.settings.secondary_link }}" class="ai-btn ai-btn-secondary">
          {{- block.settings.secondary_label -}}
        </a>
      </div>
    </div>
  </div>

  <div class="ai-healthcare-hero__doctor-wrap-{{ ai_gen_id }}">
    <img src="{{ block.settings.doctor_image | image_url: width:1200 }}">
  </div>
</section>

{% schema %}
{
  "name": "Healthcare hero banner",
  "settings": [
    { "type": "image_picker", "id": "background_image", "label": "Background image" },

    {
      "type": "range",
      "id": "image_opacity",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 39,
      "label": "Image opacity (Figma 39%)"
    },
    {
      "type": "range",
      "id": "layer_blur",
      "min": 0,
      "max": 25,
      "step": 1,
      "unit": "px",
      "default": 8,
      "label": "Figma layer blur"
    },

    {
      "type": "range",
      "id": "container_width",
      "min": 1000,
      "max": 1600,
      "step": 100,
      "unit": "px",
      "default": 1400,
      "label": "Container width"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 40,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 120,
      "label": "Top padding"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 40,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 80,
      "label": "Bottom padding"
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 400,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 700,
      "label": "Section min height"
    },

    { "type": "text", "id": "heading", "label": "Heading text" },
    {
      "type": "range",
      "id": "heading_size",
      "min": 0,
      "max": 90,
      "step": 2,
      "unit": "px",
      "default": 64,
      "label": "Heading size"
    },
    {
      "type": "range",
      "id": "heading_weight",
      "min": 400,
      "max": 900,
      "step": 100,
      "default": 700,
      "label": "Heading weight"
    },

    { "type": "text", "id": "sub_text_before", "label": "Text before highlight" },
    { "type": "text", "id": "highlight_text", "label": "Highlight text" },
    { "type": "color", "id": "highlight_color", "default": "#F12F46", "label": "Highlight color" },
    {
      "type": "range",
      "id": "sub_size",
      "min": 16,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 22,
      "label": "Subheading size"
    },

    { "type": "richtext", "id": "description", "label": "Description" },
    {
      "type": "range",
      "id": "desc_size",
      "min": 14,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16,
      "label": "Description size"
    },

    { "type": "text", "id": "primary_label", "default": "Start Free Assessment", "label": "Primary label" },
    { "type": "url", "id": "primary_link", "label": "Primary link" },
    { "type": "text", "id": "secondary_label", "default": "Talk to a Doctor", "label": "Secondary label" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" },

    { "type": "image_picker", "id": "doctor_image", "label": "Doctor image" },
    {
      "type": "range",
      "id": "doctor_height",
      "min": 50,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 700,
      "label": "Doctor height"
    }
  ],
  "presets": [{ "name": "Healthcare hero banner" }]
}
{% endschema %}
