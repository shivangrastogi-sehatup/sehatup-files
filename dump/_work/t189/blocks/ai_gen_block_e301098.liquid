{% doc %}
  @prompt
    i want you to take the width of the card according to the content and also make the icon left aligned and background red with rounded corners and the icon should be aligned center
    
    Create a responsive "Made Separately for Men and Women" section with two quiz cards side by side.
    
    Layout structure:
    - Main heading: "Made Separately for Men and Women"
    - Subheading: "Your body, hormones, lifestyle, and risks are different - so your quiz should be too"
    - Two cards in a row (desktop/tablet) or stacked (mobile):
    
    Left card (light pink/lavender background):
    - Pink/red quiz icon at top
    - Title: "Men's Health Quiz"
    - Bullet list:
      * Metabolism
      * Hormones
      * Sexual wellness
      * Performance
      * Energy
    - Black rounded button: "Take a Quiz"
    
    Right card (light blue background):
    - Pink/red quiz icon at top
    - Title: "Women's Health Quiz:"
    - Bullet list:
      * Cycle health
      * PMS
      * Hormonal patterns
      * PCOS signals
      * Weight triggers
    - Black rounded button: "Take a Quiz"
    
    Requirements:
    - Fully responsive layout:
      * Desktop: 2 columns side by side
      * Tablet: 2 columns with adjusted spacing
      * Mobile: stacked vertically, full width
    - Settings schema to customize:
      * Main heading and subheading text
      * For each card (as blocks):
        - Icon/image upload
        - Card title
        - Background color
        - Bullet points (repeatable list items)
        - Button text and link
        - Button colors (background, text, hover)
      * Add/remove cards (flexible for more quiz types)
      * Typography: heading sizes, body text, list text
      * Spacing: section padding, card gaps, internal padding
      * Color pickers: card backgrounds, text colors, button colors
      * Card styling: border radius, shadow, padding
    - Cards should have rounded corners and soft backgrounds
    - Icons centered at top of each card
    - Bullet lists with proper formatting and spacing
    - Buttons full-width within cards, rounded, with hover effects
    - Mobile: cards stack vertically with proper spacing
    - Max-width container for desktop, centered
    - Equal height cards on desktop/tablet
    - Flexible block system to add/remove/reorder quiz cards, make both of these aligned in center, now just align the logo red color container to the left of the card , and add a setting for min-width for latop,tablet,and add other etc settings for responsive design
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-quiz-cards-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
  }

  .ai-quiz-cards-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-quiz-cards-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-quiz-cards-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 600;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.subheading_spacing }}px;
    line-height: 1.2;
  }

  .ai-quiz-cards-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-quiz-cards-grid-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: stretch;
    gap: {{ block.settings.card_gap }}px;
    margin-top: {{ block.settings.cards_top_spacing }}px;
    flex-wrap: wrap;
  }

  .ai-quiz-card-{{ ai_gen_id }} {
    background-color: var(--card-bg-color);
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: {{ block.settings.card_shadow_horizontal }}px {{ block.settings.card_shadow_vertical }}px {{ block.settings.card_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity }});
    display: flex;
    flex-direction: column;
    width: fit-content;
    min-width: {{ block.settings.card_min_width_mobile }}px;
  }

  .ai-quiz-card-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
  }

  .ai-quiz-card-icon-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    background-color: {{ block.settings.icon_background_color }};
    border-radius: {{ block.settings.icon_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: {{ block.settings.icon_spacing }}px;
    flex-shrink: 0;
  }

  .ai-quiz-card-icon-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 8px;
  }

  .ai-quiz-card-icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-quiz-card-icon-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    color: {{ block.settings.icon_placeholder_color }};
  }

  .ai-quiz-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: 600;
    color: var(--card-title-color);
    margin: 0 0 {{ block.settings.title_spacing }}px;
    line-height: 1.3;
    text-align: left;
  }

  .ai-quiz-card-list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0 0 {{ block.settings.list_spacing }}px;
    flex-grow: 1;
    width: 100%;
  }

  .ai-quiz-card-list-item-{{ ai_gen_id }} {
    font-size: {{ block.settings.list_item_size }}px;
    color: var(--card-text-color);
    padding-left: 24px;
    position: relative;
    margin-bottom: {{ block.settings.list_item_spacing }}px;
    line-height: 1.5;
    text-align: left;
  }

  .ai-quiz-card-list-item-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .ai-quiz-card-list-item-{{ ai_gen_id }}::before {
    content: "•";
    position: absolute;
    left: 8px;
    color: var(--card-bullet-color);
    font-weight: bold;
  }

  .ai-quiz-card-button-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: var(--button-bg-color);
    color: var(--button-text-color);
    text-align: center;
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.2s ease;
  }

  .ai-quiz-card-button-{{ ai_gen_id }}:hover {
    background-color: var(--button-hover-bg-color);
    color: var(--button-hover-text-color);
    transform: translateY(-2px);
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .ai-quiz-card-{{ ai_gen_id }} {
      min-width: {{ block.settings.card_min_width_tablet }}px;
    }

    .ai-quiz-cards-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.9);
    }

    .ai-quiz-cards-subheading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size }}px * 0.95);
    }
  }

  @media screen and (min-width: 990px) {
    .ai-quiz-card-{{ ai_gen_id }} {
      min-width: {{ block.settings.card_min_width_desktop }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-quiz-cards-grid-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-quiz-card-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-quiz-cards-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-quiz-cards-subheading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size }}px * 0.9);
    }
  }
{% endstyle %}

<quiz-cards-{{ ai_gen_id }} class="ai-quiz-cards-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-quiz-cards-container-{{ ai_gen_id }}">
    <div class="ai-quiz-cards-header-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-quiz-cards-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}
      {% if block.settings.subheading != blank %}
        <p class="ai-quiz-cards-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
      {% endif %}
    </div>

    <div class="ai-quiz-cards-grid-{{ ai_gen_id }}">
      <div
        class="ai-quiz-card-{{ ai_gen_id }}"
        style="
          --card-bg-color: {{ block.settings.card1_bg_color }};
          --card-title-color: {{ block.settings.card1_title_color }};
          --card-text-color: {{ block.settings.card1_text_color }};
          --card-bullet-color: {{ block.settings.card1_bullet_color }};
          --button-bg-color: {{ block.settings.card1_button_bg_color }};
          --button-text-color: {{ block.settings.card1_button_text_color }};
          --button-hover-bg-color: {{ block.settings.card1_button_hover_bg_color }};
          --button-hover-text-color: {{ block.settings.card1_button_hover_text_color }};
        "
      >
        <div class="ai-quiz-card-content-{{ ai_gen_id }}">
          <div class="ai-quiz-card-icon-wrapper-{{ ai_gen_id }}">
            {% if block.settings.card1_icon %}
              <img
                src="{{ block.settings.card1_icon | image_url: width: 200 }}"
                alt="{{ block.settings.card1_title | escape }}"
                class="ai-quiz-card-icon-{{ ai_gen_id }}"
                loading="lazy"
                width="200"
                height="200"
              >
            {% else %}
              <div class="ai-quiz-card-icon-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          {% if block.settings.card1_title != blank %}
            <h3 class="ai-quiz-card-title-{{ ai_gen_id }}">{{ block.settings.card1_title }}</h3>
          {% endif %}

          {% if block.settings.card1_list_items != blank %}
            <ul class="ai-quiz-card-list-{{ ai_gen_id }}">
              {% assign items = block.settings.card1_list_items | newline_to_br | split: '<br />' %}
              {% for item in items %}
                {% assign trimmed_item = item | strip %}
                {% if trimmed_item != blank %}
                  <li class="ai-quiz-card-list-item-{{ ai_gen_id }}">{{ trimmed_item }}</li>
                {% endif %}
              {% endfor %}
            </ul>
          {% endif %}

          {% if block.settings.card1_button_text != blank %}
            <a
              href="{{ block.settings.card1_button_link }}"
              class="ai-quiz-card-button-{{ ai_gen_id }}"
            >
              {{ block.settings.card1_button_text }}
            </a>
          {% endif %}
        </div>
      </div>

      <div
        class="ai-quiz-card-{{ ai_gen_id }}"
        style="
          --card-bg-color: {{ block.settings.card2_bg_color }};
          --card-title-color: {{ block.settings.card2_title_color }};
          --card-text-color: {{ block.settings.card2_text_color }};
          --card-bullet-color: {{ block.settings.card2_bullet_color }};
          --button-bg-color: {{ block.settings.card2_button_bg_color }};
          --button-text-color: {{ block.settings.card2_button_text_color }};
          --button-hover-bg-color: {{ block.settings.card2_button_hover_bg_color }};
          --button-hover-text-color: {{ block.settings.card2_button_hover_text_color }};
        "
      >
        <div class="ai-quiz-card-content-{{ ai_gen_id }}">
          <div class="ai-quiz-card-icon-wrapper-{{ ai_gen_id }}">
            {% if block.settings.card2_icon %}
              <img
                src="{{ block.settings.card2_icon | image_url: width: 200 }}"
                alt="{{ block.settings.card2_title | escape }}"
                class="ai-quiz-card-icon-{{ ai_gen_id }}"
                loading="lazy"
                width="200"
                height="200"
              >
            {% else %}
              <div class="ai-quiz-card-icon-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          {% if block.settings.card2_title != blank %}
            <h3 class="ai-quiz-card-title-{{ ai_gen_id }}">{{ block.settings.card2_title }}</h3>
          {% endif %}

          {% if block.settings.card2_list_items != blank %}
            <ul class="ai-quiz-card-list-{{ ai_gen_id }}">
              {% assign items = block.settings.card2_list_items | newline_to_br | split: '<br />' %}
              {% for item in items %}
                {% assign trimmed_item = item | strip %}
                {% if trimmed_item != blank %}
                  <li class="ai-quiz-card-list-item-{{ ai_gen_id }}">{{ trimmed_item }}</li>
                {% endif %}
              {% endfor %}
            </ul>
          {% endif %}

          {% if block.settings.card2_button_text != blank %}
            <a
              href="{{ block.settings.card2_button_link }}"
              class="ai-quiz-card-button-{{ ai_gen_id }}"
            >
              {{ block.settings.card2_button_text }}
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</quiz-cards-{{ ai_gen_id }}>

<script>
  (function() {
    class QuizCards{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.adjustCardHeights();
        window.addEventListener('resize', () => this.adjustCardHeights());
      }

      adjustCardHeights() {
        const cards = this.querySelectorAll('.ai-quiz-card-{{ ai_gen_id }}');
        if (window.innerWidth >= 750) {
          let maxHeight = 0;
          cards.forEach(card => {
            card.style.height = 'auto';
            const height = card.offsetHeight;
            if (height > maxHeight) maxHeight = height;
          });
          cards.forEach(card => {
            card.style.height = maxHeight + 'px';
          });
        } else {
          cards.forEach(card => {
            card.style.height = 'auto';
          });
        }
      }
    }

    customElements.define('quiz-cards-{{ ai_gen_id }}', QuizCards{{ ai_gen_id }});
  })();
</script>

