{% doc %}
  @prompt
    Create a responsive call-to-action banner section with rounded corners and centered content.Layout structure:- Bright pink/red rounded banner container- Centered content with:  * Main heading: "Take Control of Your Health in 2 Minutes"  * Subheading: "Your personalized report is just a few answers away."  * CTA button: "Start the Quiz" (black/dark button with white text)Requirements:- Fully responsive layout:  * Desktop: wide rounded banner, generous padding, centered content  * Tablet: adjusted width and padding, maintained rounded corners  * Mobile: full-width with smaller border radius, optimized padding and spacing- Settings schema to customize:  * Banner background color or gradient  * Border radius control  * Main heading text and color  * Subheading text and color  * Button text, link, and styling  * Button colors (background, text, hover states)  * Typography controls: heading size, subheading size, font weights  * Spacing controls: section padding, internal padding, element spacing  * Container max-width  * Text alignment option (center/left)  * Button styling: border radius, padding, width options  * Optional background image with overlay- White text on colored background with proper contrast- Rounded corners on banner (adjustable radius)- Button should contrast well (dark on bright background)- Smooth hover effects on button- Mobile: maintain rounded corners, adjust padding, stack content properly- Desktop: max-width container with generous horizontal padding- Vertically centered content within banner- Button centered below text- Accessible color contrast ratios- Optional shadow or border on banner for depth
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
 html {
    scroll-behavior: smooth;
  }
  .ai-cta-banner-{{ ai_gen_id }} {
    background: white;
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
  }

  .ai-cta-banner-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_max_width }}px;
    margin: 0 auto;
    background: {{ block.settings.banner_background }};
    {% if block.settings.banner_background_gradient != blank %}
      background: {{ block.settings.banner_background_gradient }};
    {% endif %}
    border-radius: {{ block.settings.banner_border_radius }}px;
    padding: {{ block.settings.banner_padding_vertical }}px {{ block.settings.banner_padding_horizontal }}px;
    position: relative;
    overflow: hidden;
    {% if block.settings.enable_shadow %}
      box-shadow: 0 {{ block.settings.shadow_vertical }}px {{ block.settings.shadow_blur }}px rgba(0, 0, 0, {{ block.settings.shadow_opacity }});
    {% endif %}
    {% if block.settings.enable_border %}
      border: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
    {% endif %}
  }

  {% if block.settings.background_image %}
    .ai-cta-banner-bg-image-{{ ai_gen_id }} {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: 0;
    }

    .ai-cta-banner-overlay-{{ ai_gen_id }} {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color: {{ block.settings.overlay_color }};
      opacity: {{ block.settings.overlay_opacity }};
      z-index: 1;
    }
  {% endif %}

  .ai-cta-banner-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: {% if block.settings.text_alignment == 'center' %}center{% elsif block.settings.text_alignment == 'left' %}flex-start{% else %}flex-end{% endif %};
    text-align: {{ block.settings.text_alignment }};
    gap: {{ block.settings.content_spacing }}px;
  }

  .ai-cta-banner-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: clamp(24px,3.4vw,64px);
    font-weight: {{ block.settings.heading_weight }};
    line-height: 1.2;
    margin: 0;
    max-width: {{ block.settings.heading_max_width }}px;
  }

  .ai-cta-banner-subheading-{{ ai_gen_id }} {
    color: {{ block.settings.subheading_color }};
    font-size: clamp(10px, 1.2vw, 20px);
    font-weight: {{ block.settings.subheading_weight }};
    line-height: 1.5;
    margin: 0;
    max-width: {{ block.settings.subheading_max_width }}px;
  }

  .ai-cta-banner-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    font-weight: {{ block.settings.button_font_weight }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    {% if block.settings.button_width == 'auto' %}
      width: auto;
    {% elsif block.settings.button_width == 'full' %}
      width: 100%;
    {% else %}
      min-width: {{ block.settings.button_min_width }}px;
    {% endif %}
    text-align: center;
  }

  .ai-cta-banner-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    transform: translateY(-2px);
  }

  @media screen and (max-width: 989px) {
    .ai-cta-banner-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.7 }}px 16px {{ block.settings.section_padding_bottom | times: 0.7 }}px;
    }

    .ai-cta-banner-container-{{ ai_gen_id }} {
      border-radius: {{ block.settings.banner_border_radius | times: 0.8 }}px;
      padding: {{ block.settings.banner_padding_vertical | times: 0.7 }}px {{ block.settings.banner_padding_horizontal | times: 0.7 }}px;
    }

    .ai-cta-banner-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-cta-banner-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.9 }}px;
    }

    .ai-cta-banner-button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_font_size | times: 0.9 }}px;
      padding: {{ block.settings.button_padding_vertical | times: 0.8 }}px {{ block.settings.button_padding_horizontal | times: 0.8 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-cta-banner-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.5 }}px 12px {{ block.settings.section_padding_bottom | times: 0.5 }}px;
    }

    .ai-cta-banner-container-{{ ai_gen_id }} {
      border-radius: {{ block.settings.banner_border_radius | times: 0.6 }}px;
      padding: {{ block.settings.banner_padding_vertical | times: 0.6 }}px {{ block.settings.banner_padding_horizontal | times: 0.6 }}px;
    }

    .ai-cta-banner-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.65 }}px;
    }

    .ai-cta-banner-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.8 }}px;
    }

    .ai-cta-banner-button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_font_size | times: 0.85 }}px;
      padding: {{ block.settings.button_padding_vertical | times: 0.7 }}px {{ block.settings.button_padding_horizontal | times: 0.7 }}px;
      {% if block.settings.button_width == 'custom' %}
        width: 100%;
      {% endif %}
    }

    .ai-cta-banner-content-{{ ai_gen_id }} {
      gap: {{ block.settings.content_spacing | times: 0.7 }}px;
    }
  }
{% endstyle %}

<div class="ai-cta-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-cta-banner-container-{{ ai_gen_id }}">
    {% if block.settings.background_image %}
      <img
        src="{{ block.settings.background_image | image_url: width: 2000 }}"
        alt="{{ block.settings.background_image.alt | escape }}"
        class="ai-cta-banner-bg-image-{{ ai_gen_id }}"
        loading="lazy"
        width="{{ block.settings.background_image.width }}"
        height="{{ block.settings.background_image.height }}"
      >
      <div class="ai-cta-banner-overlay-{{ ai_gen_id }}"></div>
    {% endif %}

    <div class="ai-cta-banner-content-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-cta-banner-heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h2>
      {% endif %}

      {% if block.settings.subheading != blank %}
        <p class="ai-cta-banner-subheading-{{ ai_gen_id }}">
          {{ block.settings.subheading }}
        </p>
      {% endif %}

      {% if block.settings.button_text != blank %}
       {% if block.settings.button_action_type == 'scroll' and block.settings.button_scroll_id != blank %}
          {% assign final_link = '#' | append: block.settings.button_scroll_id %}
        {% else %}
          {% assign final_link = block.settings.button_link %}
        {% endif %}

        <a
          href="{{ final_link }}"
          class="ai-cta-banner-button-{{ ai_gen_id }}"
        >
          {{ block.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CTA banner",
  "settings": [
    {
      "type": "header",
      "content": "Banner container"
    },
    {
      "type": "range",
      "id": "container_max_width",
      "min": 600,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Maximum width",
      "default": 1200
    },
    {
      "type": "color",
      "id": "banner_background",
      "label": "Background color",
      "default": "#E91E63"
    },
    {
      "type": "color_background",
      "id": "banner_background_gradient",
      "label": "Background gradient"
    },
    {
      "type": "range",
      "id": "banner_border_radius",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Border radius",
      "default": 24
    },
    {
      "type": "range",
      "id": "banner_padding_vertical",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Vertical padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "banner_padding_horizontal",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 60
    },
    {
      "type": "header",
      "content": "Background image"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "label": "Overlay opacity",
      "default": 0.3
    },
    {
      "type": "header",
      "content": "Border"
    },
    {
      "type": "checkbox",
      "id": "enable_border",
      "label": "Enable border",
      "default": false
    },
    {
      "type": "range",
      "id": "border_thickness",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Border thickness",
      "default": 2
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Shadow"
    },
    {
      "type": "checkbox",
      "id": "enable_shadow",
      "label": "Enable shadow",
      "default": true
    },
    {
      "type": "range",
      "id": "shadow_vertical",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Vertical offset",
      "default": 8
    },
    {
      "type": "range",
      "id": "shadow_blur",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Blur",
      "default": 24
    },
    {
      "type": "range",
      "id": "shadow_opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "label": "Opacity",
      "default": 0.2
    },
    {
      "type": "header",
      "content": "Content layout"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "content_spacing",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "Spacing between elements",
      "default": 20
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading text",
      "default": "Take Control of Your Health in 2 Minutes"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 48
    },
    {
      "type": "range",
      "id": "heading_weight",
      "min": 300,
      "max": 900,
      "step": 100,
      "label": "Heading weight",
      "default": 700
    },
    {
      "type": "range",
      "id": "heading_max_width",
      "min": 400,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "label": "Heading max width",
      "default": 800
    },
    {
      "type": "header",
      "content": "Subheading"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading text",
      "default": "Your personalized report is just a few answers away."
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Subheading size",
      "default": 18
    },
    {
      "type": "range",
      "id": "subheading_weight",
      "min": 300,
      "max": 900,
      "step": 100,
      "label": "Subheading weight",
      "default": 400
    },
    {
      "type": "range",
      "id": "subheading_max_width",
      "min": 400,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "label": "Subheading max width",
      "default": 700
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Start the Quiz"
    },
    {
      "type": "select",
      "id": "button_action_type",
      "label": "Button action type",
      "options": [
        {
          "value": "link",
          "label": "Open link"
        },
        {
          "value": "scroll",
          "label": "Scroll to section"
        }
      ],
      "default": "link"
    },
    {
      "type": "text",
      "id": "button_scroll_id",
      "label": "Section ID to scroll to",
      "info": "Enter section ID without # (example: assessment-section)"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Hover background color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Hover text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_font_weight",
      "min": 300,
      "max": 900,
      "step": 100,
      "label": "Font weight",
      "default": 600
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 8
    },
    {
      "type": "range",
      "id": "button_padding_vertical",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Vertical padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_padding_horizontal",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 40
    },
    {
      "type": "select",
      "id": "button_width",
      "label": "Button width",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "custom",
          "label": "Custom minimum"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "auto"
    },
    {
      "type": "range",
      "id": "button_min_width",
      "min": 100,
      "max": 400,
      "step": 20,
      "unit": "px",
      "label": "Minimum width",
      "default": 200
