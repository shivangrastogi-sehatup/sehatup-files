    "custom_liquid_ezxNEr": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<section class=\"product-info-container\">\n\n <!-- ✅ Tabs (Same for Desktop & Mobile) -->\n <div class=\"product-tabs\">\n <button class=\"tab-link active\" onclick=\"openTab(event, 'Description')\">Description</button>\n <button class=\"tab-link\" onclick=\"openTab(event, 'Benefits')\">Benefits</button>\n <button class=\"tab-link\" onclick=\"openTab(event, 'HowToUse')\">How to Use</button>\n </div>\n\n <!-- ✅ Tab Content -->\n <div id=\"Description\" class=\"tab-content active\">\n {% if product.description contains '[details]' %}\n {{ product.description | split: '[details]' | first | replace: '<img', '<img class=\"responsive-img\"' }}\n {% else %}\n {{ product.description | replace: '<img', '<img class=\"responsive-img\"' }}\n {% endif %}\n </div>\n\n <div id=\"Benefits\" class=\"tab-content\">\n {% if product.description contains '[benefits]' and product.description contains '[/benefits]' %}\n {{ product.description | split: '[benefits]' | last | split: '[/benefits]' | first | replace: '<img', '<img class=\"responsive-img\"' }}\n {% endif %}\n </div>\n\n <div id=\"HowToUse\" class=\"tab-content\">\n {% if product.description contains '[how_to_use]' and product.description contains '[/how_to_use]' %}\n {{ product.description | split: '[how_to_use]' | last | split: '[/how_to_use]' | first | replace: '<img', '<img class=\"responsive-img\"' }}\n {% endif %}\n </div>\n\n</section>\n\n<script>\n// ✅ Tabs Function (Works on Desktop & Mobile both)\nfunction openTab(evt, tabName) {\n let tabcontent = document.getElementsByClassName(\"tab-content\");\n for (let i = 0; i < tabcontent.length; i++) {\n tabcontent[i].classList.remove(\"active\");\n }\n let tablinks = document.getElementsByClassName(\"tab-link\");\n for (let i = 0; i < tablinks.length; i++) {\n tablinks[i].classList.remove(\"active\");\n }\n document.getElementById(tabName).classList.add(\"active\");\n evt.currentTarget.classList.add(\"active\");\n}\n</script>\n\n<style>\n:root {\n /* ✅ Default (Desktop) paddings */\n --desktop-padding-left: 7%;\n --desktop-padding-right: 7px;\n\n\n\n /* ✅ Mobile paddings */\n --mobile-padding-left: 15px;\n --mobile-padding-right: 15px;\nfont-family: sans-serif !important;\n}\n\n.product-info-container {\n max-width: 1200px;\n padding: 20px;\n font-family: sans-serif !important;\n}\n\n/* ✅ Tabs */\n.product-tabs {\n display: flex;\n justify-content: center;\n gap: 0px;\n border-bottom: 2px solid #eee;\n}\n.tab-link {\n background: none;\n border: none;\n padding: 12px 18px;\n cursor: pointer;\n font-size: 20px;\n font-weight: 600;\n color: #666;\n transition: all 0.3s ease;\n}\n.tab-link.active {\n color: #d32f2f;\n border-bottom: 3px solid #d32f2f;\n}\n.tab-link:hover {\n color: #d32f2f;\n}\n\n/* ✅ Tab Content */\n.tab-content {\n display: none;\n padding: 20px 10px;\n padding-left: var(--desktop-padding-left);\n padding-right: var(--desktop-padding-right);\n animation: fadeEffect 0.3s;\n}\n.tab-content.active {\n display: block;\n}\n\n/* ✅ Responsive (Tabs same in mobile) */\n@media (max-width: 768px) {\n .product-tabs {\n flex-wrap: wrap;\n justify-content: flex-start;\n }\n .tab-link {\n font-size: 15px;\n padding: 10px 14px;\n }\n .tab-content {\n padding-left: var(--mobile-padding-left);\n padding-right: var(--mobile-padding-right);\n }\n}\n\n@keyframes fadeEffect {\n from {opacity: 0;}\n to {opacity: 1;}\n}\n</style>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 52
