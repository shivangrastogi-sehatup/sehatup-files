{% style %}
  /* ── Featured blogs ───────────────────────────────────────────────────────
     Rebuilt 2026-09-24. The desktop grid and the mobile slider used to be two
     full copies of the same markup, so every article image was requested
     twice. There is now one list; CSS decides whether it is a grid or a rail. */

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .blog-container {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 16px;
  }

  .blog-heading {
    /* the same scale, weight and tracking as every other section heading */
    font-size: clamp(25px, 3.3vw, 60px);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: #1d1d1d;
    text-align: center;
    margin: 0 0 clamp(22px, 3.4vw, 44px);
    text-wrap: balance;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    gap: 22px;
    margin: 0;
    padding: 0;
  }

  /* the theme's own card styles do not apply here */
  .blog-card {
    all: unset;
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border: 1px solid #e8e8ee;
    border-radius: {{ section.settings.card_radius }}px;
    overflow: hidden;
    cursor: pointer;
    transition: transform .25s cubic-bezier(.22,.9,.3,1), border-color .25s ease;
  }

  /* the picture is the card's top edge, not a thumbnail floating inside it */
  .blog-card__image {
    aspect-ratio: 16 / 10;
    background: #f4f4f6;
    overflow: hidden;
  }

  .blog-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;          /* was contain, which letterboxed every photo */
    display: block;
    transition: transform .45s cubic-bezier(.22,.9,.3,1);
  }

  @media (hover: hover) {
    .blog-card:hover { transform: translateY(-3px); border-color: #d9d9e2; }
    .blog-card:hover .blog-card__image img { transform: scale(1.05); }
  }

  .blog-card:active { transform: scale(.995); }

  .blog-card:focus-visible {
    outline: 3px solid #ee204a;
    outline-offset: 3px;
  }

  .blog-card__content {
    padding: 16px 18px 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  .blog-card__title {
    margin: 0;
    font-weight: 700;
    /* was clamp(10px, 1.5vw, 20px) with a missing semicolon, which also
       swallowed the line-height declared under it */
    font-size: clamp(17px, 1.5vw, 21px);
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: #1d1d1d;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-card__excerpt {
    margin: 0;
    font-size: clamp(15px, 1.1vw, 16px);
    color: #55555f;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-card__date {
    margin-top: auto;
    padding-top: 4px;
    /* the old rule read "font-size: font-size: clamp(...)" and never applied */
    font-size: 13px;
    color: #8a8a95;
  }

  .blog-view-all {
    margin-top: clamp(22px, 3vw, 34px);
    text-align: center;
  }

  .blog-view-all .button {
    background: transparent;
    border: 1.5px solid #1d1d1d;
    color: #1d1d1d;
    border-radius: 999px;
    min-height: 50px;
    display: inline-flex;
    align-items: center;
    padding: 0 40px;
    font-size: 15px;
    font-weight: 600;
    transition: background .3s ease, color .3s ease, transform .2s ease;
  }

  .blog-view-all .button:hover {
    background: #1d1d1d;
    color: #ffffff;
    transform: translateY(-2px);
  }

  .blog-view-all .button:active { transform: scale(.97); }

  .blog-view-all .button::after {
    display: none !important;
    box-shadow: none !important;
    content: none !important;
  }

  .blog-swipe { display: none; }

  /* ── Phones: the same cards, swiped. One at a time with the next peeking,
     and the dot row the rest of the page uses. The old version floated two
     round arrows on top of the cards. ────────────────────────────────────── */
  @media (max-width: 768px) {
    .blog-container { padding: 0; }
    .blog-heading { padding-inline: 16px; }

    .blog-grid {
      display: flex;
      gap: 14px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding: 4px 16px 10px;
      scroll-padding-inline: 16px;
      align-items: stretch;
    }

    .blog-grid::-webkit-scrollbar { display: none; }

    .blog-card {
      flex: 0 0 calc(100% - 74px);
      min-width: 0;
      scroll-snap-align: start;
    }

    .blog-card__content { padding: 14px 16px 16px; gap: 6px; }
    .blog-card__title { font-size: 18px; }
    .blog-card__excerpt { font-size: 15px; }
    .blog-card__date { font-size: 13px; }

    .blog-swipe { display: block; margin-top: 6px; }
    .blog-dots { display: flex; justify-content: center; gap: 7px; }
    .blog-dots button {
      width: 7px;
      height: 7px;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: #d9d9e0;
      cursor: pointer;
      transition: background .25s ease, width .25s ease;
    }
    .blog-dots button[aria-selected="true"] { background: #1d1d1d; width: 20px; border-radius: 4px; }
    .blog-hint { margin: 10px 0 0; text-align: center; color: #55555f; font-size: 14px; }

    .blog-view-all { padding-inline: 16px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-card,
    .blog-card__image img { transition: none; }
  }
{% endstyle %}

<section class="section-{{ section.id }}-padding">
  <div class="blog-container">
    {% if section.settings.heading != blank %}
      <h2 class="blog-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% assign max_posts = section.settings.columns_desktop %}

    {% if section.settings.blog != blank %}
      <div class="blog-grid" id="blog-track-{{ section.id }}">
        {% for article in section.settings.blog.articles limit: max_posts %}
          <a href="{{ article.url }}" class="blog-card">
            {% if section.settings.show_image and article.image %}
              <div class="blog-card__image">
                <img
                  src="{{ article.image | image_url: width: 800 }}"
                  srcset="{{ article.image | image_url: width: 400 }} 400w,
                          {{ article.image | image_url: width: 700 }} 700w,
                          {{ article.image | image_url: width: 1000 }} 1000w"
                  sizes="(max-width: 768px) 78vw, 340px"
                  alt="{{ article.title | escape }}"
                  width="{{ article.image.width }}"
                  height="{{ article.image.height }}"
                  loading="lazy"
                  decoding="async"
                >
              </div>
            {% endif %}

            <div class="blog-card__content">
              <h3 class="blog-card__title">{{ article.title }}</h3>

              {% if section.settings.show_excerpt %}
                <p class="blog-card__excerpt">{{ article.excerpt_or_content | strip_html }}</p>
              {% endif %}

              {% if section.settings.show_date %}
                <div class="blog-card__date">{{ article.published_at | date: '%B %d, %Y' }}</div>
              {% endif %}
            </div>
          </a>
        {% endfor %}
      </div>

      <div class="blog-swipe" hidden>
        <div class="blog-dots" role="tablist" aria-label="Choose an article"></div>
        <p class="blog-hint"><span aria-hidden="true">&#8592;</span> Swipe to see more <span aria-hidden="true">&#8594;</span></p>
      </div>
    {% endif %}

    {% if section.settings.show_view_all %}
      <div class="blog-view-all">
        <a href="{{ section.settings.blog.url }}" class="button">
          {{ section.settings.view_all_text }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

<script>
  (() => {
    const root = document.getElementById("shopify-section-{{ section.id }}");
    if (!root) return;
    const track = root.querySelector(".blog-grid");
    const swipe = root.querySelector(".blog-swipe");
    if (!track || !swipe) return;

    const cards = [...track.children];
    if (cards.length < 2) return;

    swipe.hidden = false;
    const dots = swipe.querySelector(".blog-dots");
    cards.forEach((card, i) => {
      const b = document.createElement("button");
      b.type = "button";
      b.setAttribute("role", "tab");
      b.setAttribute("aria-label", "Article " + (i + 1));
      b.addEventListener("click", () => {
        track.scrollTo({ left: card.offsetLeft - track.offsetLeft - 16, behavior: "smooth" });
      });
      dots.appendChild(b);
    });

    const marks = [...dots.children];
    let queued = false;
    const paint = () => {
      queued = false;
      const mid = track.scrollLeft + track.clientWidth / 2;
      let best = 0, bestGap = Infinity;
      cards.forEach((c, i) => {
        const gap = Math.abs(c.offsetLeft - track.offsetLeft + c.offsetWidth / 2 - mid);
        if (gap < bestGap) { bestGap = gap; best = i; }
      });
      marks.forEach((m, i) => m.setAttribute("aria-selected", i === best));
    };
    track.addEventListener("scroll", () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(paint);
    }, { passive: true });
    paint();
  })();
</script>

{% schema %}
{
  "name": "Featured Blogs (Clean)",
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Select blog"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Blogs"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Blogs per row (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt (2 lines)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show publish date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All button text",
      "default": "Read All Blogs"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card border radius",
      "min": 8,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Featured Blogs – Clean"
    }
  ]
}
{% endschema %}
