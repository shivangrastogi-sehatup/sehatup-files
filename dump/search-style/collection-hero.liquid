  #MainContent:has(.cho) .cho-sort__opt { display: block; width: 100%; margin: 0; padding: 10px 14px; border: 0; border-radius: 10px; background: none; color: #1d1d1d; font: 500 14px/1.3 'Montserrat', sans-serif; text-align: left; white-space: nowrap; cursor: pointer; }
