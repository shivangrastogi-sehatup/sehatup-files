    { "type": "header", "content": "Offer" },
    { "type": "checkbox", "id": "offer_on", "label": "Show the offer", "default": true },
    { "type": "text", "id": "offer_text", "label": "Offer text", "default": "Diwali offer: buy any 3 individual products and get 15% extra off" },
    { "type": "text", "id": "offer_code", "label": "Discount code", "default": "FESTIVE15", "info": "Tapping it copies the code. Empty hides the offer." },
    { "type": "text", "id": "offer_note", "label": "Small note", "default": "Not valid on combos." },
    { "type": "textarea", "id": "offer_copied", "label": "Message after copying", "default": "Code [code] copied. Add any 3 individual products to your cart, then apply it at checkout for an extra 15% off.", "info": "[code] is replaced by the code." }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Quick link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "For Him" },
        { "type": "text", "id": "link", "label": "Link", "default": "/pages/for-him" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Collection: hero" }]
}
