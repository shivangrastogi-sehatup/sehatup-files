</style>
<input type="hidden" value="true" id="fastrrCollectionPage">
<section id="cho-{{ section.id }}" class="cho">
  <div class="cho__in">
    <h1 class="cho__h">{{ collection.title | default: 'Shop all' }}</h1>
    {%- if s.show_description and collection.description != blank -%}
      <div class="cho__d">{{ collection.description }}</div>
    {%- elsif s.subheading != blank -%}
      <p class="cho__d">{{ s.subheading }}</p>
    {%- endif -%}

    {%- if s.offer_on and s.offer_code != blank -%}
      <div class="cho__offer">
        <svg class="cho__ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 13h17c0 3.6-3.8 6.2-8.5 6.2S3.5 16.6 3.5 13z"/><path d="M12 13V9.5"/><path d="M12 9.5c-1.3-1.5-1.3-3.2 0-4.8 1.3 1.6 1.3 3.3 0 4.8z"/></svg>
        <span class="cho__offer-t">{{ s.offer_text }}</span>
        <button type="button" class="cho__code" data-code="{{ s.offer_code | escape }}" aria-label="Copy code {{ s.offer_code | escape }}">{{ s.offer_code }}</button>
        {%- if s.offer_note != blank -%}<span class="cho__note">{{ s.offer_note }}</span>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="cho__links">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}><a href="{{ block.settings.link | default: '#' }}">{{ block.settings.label }}</a></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>


{% render 'offer-toast' %}
<script>
  (function () {
    var root = document.getElementById('cho-{{ section.id }}');
    if (!root) return;
    root.addEventListener('click', function (e) {
      var btn = e.target.closest('.cho__code');
      if (!btn) return;
      var code = btn.getAttribute('data-code'), label = btn.textContent;
      if (label === 'Copied') label = code;
      btn.textContent = 'Copied';
      setTimeout(function () { btn.textContent = label; }, 2500);
      window.offerCopy(code, {{ s.offer_copied | default: 'Code [code] copied. Add any 3 individual products to your cart, then apply it at checkout for an extra 15% off.' | json }});
    });

    if (['Asia/Kolkata', 'Asia/Calcutta'].indexOf(Intl.DateTimeFormat().resolvedOptions().timeZone) > -1) document.documentElement.classList.add('cho-sr');

    var caret = '<svg viewBox="0 0 10 6" aria-hidden="true"><path fill="currentColor" d="M9.354.646a.5.5 0 0 0-.708 0L5 4.293 1.354.646a.5.5 0 0 0-.708.708l4 4a.5.5 0 0 0 .708 0l4-4a.5.5 0 0 0 0-.708"/></svg>';
    function close(box) { box.querySelector('.cho-sort__btn').setAttribute('aria-expanded', 'false'); box.querySelector('.cho-sort__list').hidden = true; }
    function sortMenu() {
      var sel = document.querySelector('.facet-filters #SortBy');
      if (!sel || sel.dataset.cho) return;
      sel.dataset.cho = '1';
      var wrap = sel.closest('.select');
      var box = document.createElement('div');
      box.className = 'cho-sort';
      var opts = [].map.call(sel.options, function (o) {
        return '<li><button type="button" class="cho-sort__opt" role="option" data-v="' + o.value + '" aria-selected="' + o.selected + '">' + o.textContent.trim() + '</button></li>';
      }).join('');
      box.innerHTML = '<button type="button" class="cho-sort__btn" aria-haspopup="listbox" aria-expanded="false" aria-label="Sort by"><span>' + sel.options[sel.selectedIndex].textContent.trim() + '</span>' + caret + '</button><ul class="cho-sort__list" role="listbox" hidden>' + opts + '</ul>';
      wrap.classList.add('cho-native');
      wrap.after(box);
      box.addEventListener('click', function (e) {
        var btn = e.target.closest('.cho-sort__btn'), opt = e.target.closest('.cho-sort__opt');
        if (btn) {
          var open = btn.getAttribute('aria-expanded') !== 'true';
          btn.setAttribute('aria-expanded', open);
          box.querySelector('.cho-sort__list').hidden = !open;
          if (open) box.querySelector('[aria-selected="true"]').focus();
        } else if (opt) {
          close(box);
          if (opt.dataset.v === sel.value) return;
          sel.value = opt.dataset.v;
          sel.dispatchEvent(new Event('input', { bubbles: true }));
        }
      });
      box.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') { close(box); box.querySelector('.cho-sort__btn').focus(); }
        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
          var all = [].slice.call(box.querySelectorAll('.cho-sort__opt')), i = all.indexOf(document.activeElement);
          if (i < 0) return;
          e.preventDefault();
          all[(i + (e.key === 'ArrowDown' ? 1 : all.length - 1)) % all.length].focus();
        }
      });
    }
    document.addEventListener('click', function (e) {
      var box = document.querySelector('.cho-sort');
      if (box && !box.contains(e.target)) close(box);
    });
    sortMenu();

    function closePicks(except) {
      [].forEach.call(document.querySelectorAll('.cho-pick__btn[aria-expanded="true"]'), function (b) {
        if (b === except) return;
        b.setAttribute('aria-expanded', 'false');
        b.nextElementSibling.hidden = true;
      });
    }
    var base = window.Shopify && Shopify.routes ? Shopify.routes.root : '/';
    document.addEventListener('click', function (e) {
      var pb = e.target.closest('.cho-pick__btn'), po = e.target.closest('.cho-pick__opt');
      closePicks(pb);
      if (pb) {
        var open = pb.getAttribute('aria-expanded') !== 'true';
        pb.setAttribute('aria-expanded', open);
        pb.nextElementSibling.hidden = !open;
        if (open) (pb.nextElementSibling.querySelector('[aria-selected="true"]') || pb.nextElementSibling.querySelector('.cho-pick__opt')).focus();
      } else if (po) {
        var form = po.closest('form');
        form.elements.id.value = po.dataset.v;
        form.querySelector('.cho-pick__val').textContent = po.dataset.t;
        var pr = form.closest('.card') && form.closest('.card').querySelector('.cho-price');
        if (pr) {
          pr.querySelector('.cho-price__now').textContent = po.dataset.p;
          pr.querySelector('.cho-price__mrp').textContent = po.dataset.c || '';
          pr.querySelector('.cho-price__mrp').hidden = !po.dataset.c;
          pr.querySelector('.cho-price__off').textContent = (po.dataset.o || 0) + '% off';
          pr.querySelector('.cho-price__off').hidden = !po.dataset.o;
        }
        [].forEach.call(form.querySelectorAll('.cho-pick__opt'), function (o) { o.setAttribute('aria-selected', o === po); });
        closePicks();
        form.querySelector('.cho-pick__btn').focus();
      }
    });
    document.addEventListener('keydown', function (e) {
      var list = e.target.closest && e.target.closest('.cho-pick__list');
      if (!list) return;
      if (e.key === 'Escape') { closePicks(); list.previousElementSibling.focus(); }
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        var all = [].slice.call(list.querySelectorAll('.cho-pick__opt:not(:disabled)')), i = all.indexOf(e.target);
        e.preventDefault();
        all[(i + (e.key === 'ArrowDown' ? 1 : all.length - 1)) % all.length].focus();
      }
    });
    document.addEventListener('submit', function (e) {
      var form = e.target.closest('[data-cho-buy]');
      if (form && e.submitter && e.submitter.closest('.shiprocket-headless')) { e.preventDefault(); return; }
      if (!form || !e.submitter || !e.submitter.classList.contains('cho-buy__add')) return;
      e.preventDefault();
      var btn = e.submitter, label = btn.textContent, drawer = document.querySelector('cart-drawer');
      btn.disabled = true; btn.textContent = 'Adding...';
      fetch(base + 'cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ items: [{ id: +form.elements.id.value, quantity: 1 }], sections: drawer ? 'cart-drawer,cart-icon-bubble' : 'cart-icon-bubble', sections_url: location.pathname }) })
        .then(function (r) { return r.json().then(function (d) { if (!r.ok) throw d; return d; }); })
        .then(function (d) {
          if (drawer && drawer.renderContents) { drawer.classList.remove('is-empty'); drawer.renderContents(d); }
          else if (d.sections && d.sections['cart-icon-bubble']) {
            var el = document.getElementById('cart-icon-bubble'), h = new DOMParser().parseFromString(d.sections['cart-icon-bubble'], 'text/html').querySelector('.shopify-section');
            if (el && h) el.innerHTML = h.innerHTML;
          }
          document.dispatchEvent(new CustomEvent('cart:updated', { detail: { source: 'collection' } }));
          btn.textContent = 'Added'; btn.classList.add('is-done');
        }, function () { btn.textContent = 'Try again'; })
        .then(function () { setTimeout(function () { btn.disabled = false; btn.textContent = label; btn.classList.remove('is-done'); }, 2000); });
    });
    var main = document.getElementById('MainContent');
    if (main) new MutationObserver(sortMenu).observe(main, { childList: true, subtree: true });
  })();
</script>

{% schema %}
