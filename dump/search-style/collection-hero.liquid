  #MainContent:has(.cho) .cho-pick { position: relative; }
  #MainContent:has(.cho) .cho-pick__btn { display: flex; align-items: center; justify-content: space-between; gap: 8px; width: 100%; min-height: 42px; margin: 0; padding: 0 14px; border: 1px solid #f2d9a6; border-radius: 12px; background: #fdedcf; color: #1d1d1d; font: 600 13.5px/1.2 'Montserrat', sans-serif; text-align: left; cursor: pointer; }
  #MainContent:has(.cho) .cho-pick__val { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  #MainContent:has(.cho) .cho-pick__btn svg { flex: none; width: 11px; height: 11px; color: #8f1836; transition: transform .25s ease; }
  #MainContent:has(.cho) .cho-pick__btn[aria-expanded="true"] { border-color: #d99a2b; }
  #MainContent:has(.cho) .cho-pick__btn[aria-expanded="true"] svg { transform: rotate(180deg); }
  #MainContent:has(.cho) .cho-pick__list { position: absolute; z-index: 5; left: 0; right: 0; bottom: calc(100% + 6px); max-height: 240px; margin: 0; padding: 6px; overflow-y: auto; border: 1px solid #efdcb8; border-radius: 14px; background: #fff; list-style: none; box-shadow: 0 18px 34px -18px rgba(92, 16, 36, .35); }
