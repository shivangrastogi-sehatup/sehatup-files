{%- assign s = section.settings -%}
<style>
  #cho-{{ section.id }} { --ink: #1d1d1d; --mute: #5f5a56; --gold: #d99a2b; --maroon: #8f1836; padding: clamp(36px, 4.4vw, 64px) clamp(16px, 3vw, 48px) clamp(26px, 3vw, 40px); background: #fffaf3; border-bottom: 1px solid #efdcb8; font-family: 'Montserrat', sans-serif; color: var(--ink); text-align: center; }
  #cho-{{ section.id }} * { box-sizing: border-box; letter-spacing: normal; }
  #cho-{{ section.id }} .cho__in { max-width: 920px; margin: 0 auto; }
  #cho-{{ section.id }} .cho__h { margin: 0; font: 800 clamp(34px, 4vw, 56px)/1.05 'Montserrat', sans-serif; letter-spacing: -.025em; color: var(--ink); text-wrap: balance; }
  #cho-{{ section.id }} .cho__d { max-width: 38em; margin: 14px auto 0; font: 400 clamp(15px, 1.2vw, 18px)/1.6 'Montserrat', sans-serif; color: var(--mute); text-wrap: pretty; }
  #cho-{{ section.id }} .cho__d p { margin: 0; }
  #cho-{{ section.id }} .cho__offer { display: inline-flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 8px 14px; margin-top: clamp(20px, 2.4vw, 30px); padding: 12px 20px; border-radius: 16px; background: #5c1024; color: #fbe3b0; font: 600 14.5px/1.35 'Montserrat', sans-serif; }
  #cho-{{ section.id }} .cho__ico { flex: none; width: 22px; height: 22px; fill: none; stroke: #f2c46d; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  #cho-{{ section.id }} .cho__code { margin: 0; padding: 5px 12px; border: 1px dashed #f2c46d; border-radius: 999px; background: #f2c46d; color: #5c1024; font: 700 13px/1 'Montserrat', sans-serif; letter-spacing: .08em; cursor: pointer; }
  #cho-{{ section.id }} .cho__code:focus-visible { outline: 2px solid #fbe3b0; outline-offset: 2px; }
  #cho-{{ section.id }} .cho__note { font-weight: 500; font-size: 13px; opacity: .75; }
  #cho-{{ section.id }} .cho__links { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin: clamp(18px, 2.2vw, 26px) 0 0; padding: 0; list-style: none; }
