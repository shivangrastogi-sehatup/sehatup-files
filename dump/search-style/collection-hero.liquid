  #MainContent:has(.cho) .cho-pick__opt { display: flex; justify-content: space-between; gap: 10px; width: 100%; margin: 0; padding: 9px 10px; border: 0; border-radius: 9px; background: none; color: #1d1d1d; font: 500 13px/1.3 'Montserrat', sans-serif; text-align: left; cursor: pointer; }
  #MainContent:has(.cho) .cho-pick__opt:hover, #MainContent:has(.cho) .cho-pick__opt:focus-visible { background: #fffaf3; outline: none; }
  #MainContent:has(.cho) .cho-pick__opt[aria-selected="true"] { background: #5c1024; color: #fbe3b0; font-weight: 700; }
