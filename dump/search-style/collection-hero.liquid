    #cho-{{ section.id }} .cho__offer { padding: 12px 14px; font-size: 13.5px; }
    #cho-{{ section.id }} .cho__links { flex-wrap: nowrap; justify-content: flex-start; overflow-x: auto; margin: 16px -16px 0; padding: 2px 16px 6px; scrollbar-width: none; }
