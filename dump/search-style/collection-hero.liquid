  @media (hover: hover) { #cho-{{ section.id }} .cho__links a:hover { background: var(--ink); border-color: var(--ink); color: #fff; } }
  #cho-{{ section.id }} .cho__links a:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }

  #MainContent:has(.cho) { background: #fffaf3; }
  #MainContent:has(.cho) .collection, #MainContent:has(.cho) .facets-vertical { padding-top: clamp(20px, 2.4vw, 32px); }
  #MainContent:has(.cho) .facets__form { align-items: center; }
  #MainContent:has(.cho) .facets__wrapper { align-items: center; gap: 10px; }
  #MainContent:has(.cho) :is(.facets__heading, .facet-filters__label, .product-count__text) { margin: 0 4px 0 0; font: 600 14px/1 'Montserrat', sans-serif; color: #5f5a56; }
  #MainContent:has(.cho) .facets__disclosure { margin: 0; }
  #MainContent:has(.cho) .facets__summary { margin: 0; display: inline-flex; align-items: center; padding: 11px 18px; border: 1.5px solid #e6cf9f; border-radius: 999px; background: #fff; color: #1d1d1d; font: 700 14px/1 'Montserrat', sans-serif; transition: border-color .25s ease, background-color .25s ease; }
  #MainContent:has(.cho) .facets__summary > div { gap: 8px; }
