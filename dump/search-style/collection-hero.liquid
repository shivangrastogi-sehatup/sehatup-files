  #MainContent:has(.cho) .card-wrapper .card__content, #MainContent:has(.cho) .card-wrapper .card__information, #MainContent:has(.cho) .cho-buy, #MainContent:has(.cho) .cho-pick, #MainContent:has(.cho) .cho-pick__btn { min-width: 0; }
  #MainContent:has(.cho) .cho-pick__val { flex: 1; min-width: 0; }
  #MainContent:has(.cho) .cho-pick__opt > span:first-child { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  #MainContent:has(.cho) .cho-buy__row { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  #MainContent:has(.cho) :is(.cho-buy__add, .cho-buy__now) { overflow: hidden; text-overflow: ellipsis; }
  #MainContent:has(.cho) .card-wrapper .card__badge { position: absolute; z-index: 2; top: 0; right: 0; left: auto; bottom: auto; display: flex; margin: 0; line-height: 1; }
  #MainContent:has(.cho) .card-wrapper .card__badge .badge { position: static; margin: 0; padding: 7px 12px 7px 14px; border: 0; border-radius: 0 0 0 12px; background: #fbe3b0; color: #5c1024; font: 700 12px/1 'Montserrat', sans-serif; letter-spacing: .01em; }
