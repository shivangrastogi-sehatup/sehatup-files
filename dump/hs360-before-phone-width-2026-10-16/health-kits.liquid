{%- comment -%}
  Most ordered care kits: real products picked in the editor (the Health
  Score page uses the three best-selling kits from Shopify orders), shown as
  cards with the For Her / For Him tone, price + saving, and the Judge.me
  rating when the product has one. "View kit" goes to the product page;
  the copy makes clear the doctor recommends the kit first.
  With "Kits for her" / "Kits for him" set, all kits sit in one swipeable row
  and the row follows the For Her / For Him switch above (hs360:who): the
  chosen side comes first, the other side after it.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign split = false
  if s.her_products != blank or s.him_products != blank
    assign split = true
  endif
-%}

{%- comment -%} Styles first, so the browser never paints this section unstyled. {%- endcomment -%}
<style>
  #hkt-{{ section.id }} { --hkt-text: #1d1d1d; --hkt-muted: #5c5c5c; --hkt-ink: {{ s.accent_color | color_darken: 8 }}; background: #fff; font-family: 'Montserrat', sans-serif; color: var(--hkt-text); }
  #hkt-{{ section.id }} .hkt__inner { max-width: 1160px; margin: 0 auto; padding: 88px 24px 40px; }
  #hkt-{{ section.id }} .hkt__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 36px; }
  #hkt-{{ section.id }} .hkt__eyebrow { margin: 0 0 14px; font: 700 12px/1 'Montserrat', sans-serif; letter-spacing: .14em; text-transform: uppercase; color: var(--hkt-ink); }
  #hkt-{{ section.id }} .hkt__heading { color: var(--hkt-text); margin: 0 0 12px; font: 800 clamp(28px, 3.4vw, 46px)/1.08 'Montserrat', sans-serif; letter-spacing: -.02em; text-wrap: balance; }
  #hkt-{{ section.id }} .hkt__sub { margin: 0; max-width: 560px; font: 400 16px/1.55 'Montserrat', sans-serif; color: var(--hkt-muted); }
  #hkt-{{ section.id }} .hkt__all { flex: none; display: inline-flex; gap: 8px; align-items: center; font: 700 15px/1 'Montserrat', sans-serif; color: var(--hkt-ink); text-decoration: none; padding-bottom: 6px; border-bottom: 2px solid currentColor; }

  #hkt-{{ section.id }} .hkt__row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  #hkt-{{ section.id }} .hkt__row--scroll {
    display: flex; gap: 22px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
    margin: -12px -12px 0; padding: 12px 12px 22px; transition: opacity .25s ease;
  }
  #hkt-{{ section.id }} .hkt__row--scroll::-webkit-scrollbar { display: none; }
  #hkt-{{ section.id }} .hkt__row--scroll .hkt__card { flex: 0 0 calc((100% - 44px) / 3); scroll-snap-align: start; }
  #hkt-{{ section.id }} .hkt__row--scroll.is-swap { opacity: 0; }
  #hkt-{{ section.id }} .hkt__row--scroll .hkt__badge { display: none; }
  #hkt-{{ section.id }} .hkt__row--scroll .hkt__card[data-top] .hkt__badge { display: inline-block; }
  #hkt-{{ section.id }} .hkt__tools { display: flex; align-items: center; gap: 18px; flex: none; }
  #hkt-{{ section.id }} .hkt__nav { display: flex; gap: 8px; }
  #hkt-{{ section.id }} .hkt__arrow {
    width: 40px; height: 40px; border-radius: 50%; border: 1.5px solid #e2dbd5; background: #fff; color: var(--hkt-text);
    display: grid; place-items: center; cursor: pointer; transition: border-color .2s ease, opacity .2s ease;
  }
  #hkt-{{ section.id }} .hkt__arrow svg { width: 16px; height: 16px; }
  #hkt-{{ section.id }} .hkt__arrow:disabled { opacity: .35; cursor: default; }
  @media (hover: hover) { #hkt-{{ section.id }} .hkt__arrow:not(:disabled):hover { border-color: var(--hkt-text); } }
  #hkt-{{ section.id }} .hkt__arrow:focus-visible { outline: 2px solid var(--hkt-text); outline-offset: 2px; }
  @media (min-width: 750px) and (max-width: 1099.98px) {
    #hkt-{{ section.id }} .hkt__row--scroll .hkt__card { flex-basis: calc((100% - 22px) / 2.2); }
  }
  /* Phones: swipe (the next card peeks in), no arrows. */
  @media (max-width: 749.98px) {
    #hkt-{{ section.id }} .hkt__row--scroll { margin: 0; gap: 12px; padding: 4px 16px 18px; scroll-padding: 0 16px; }
    #hkt-{{ section.id }} .hkt__row--scroll .hkt__card { flex-basis: 76%; }
    #hkt-{{ section.id }} .hkt__nav { display: none; }
  }
  #hkt-{{ section.id }} .hkt__card {
    --tone: #fde2e7; --tone-ink: #b3123a;
    display: flex; flex-direction: column; border-radius: 22px; overflow: hidden; text-decoration: none; color: inherit; background: #fff;
    box-shadow: 0 1px 0 rgba(29, 29, 29, .04), 0 12px 32px rgba(29, 29, 29, .07);
    transition: transform .35s cubic-bezier(.16, 1, .3, 1), box-shadow .35s ease;
  }
  #hkt-{{ section.id }} .hkt__card--him { --tone: #d9f0ee; --tone-ink: #0f6b62; }
  @media (hover: hover) and (pointer: fine) {
    #hkt-{{ section.id }} .hkt__card:hover { transform: translateY(-6px); box-shadow: 0 1px 0 rgba(29, 29, 29, .04), 0 22px 44px rgba(29, 29, 29, .12); }
    #hkt-{{ section.id }} .hkt__card:hover .hkt__cta span { transform: translateX(4px); }
  }
  #hkt-{{ section.id }} .hkt__card:focus-visible { outline: 2px solid var(--hkt-text); outline-offset: 3px; }
  /* Product photos come with their own backgrounds: show them as they are, edge to edge. */
  #hkt-{{ section.id }} .hkt__img { position: relative; aspect-ratio: 1; background: #f4f1ee; overflow: hidden; }
  #hkt-{{ section.id }} .hkt__img img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .6s cubic-bezier(.16, 1, .3, 1); }
  @media (hover: hover) and (pointer: fine) { #hkt-{{ section.id }} .hkt__card:hover .hkt__img img { transform: scale(1.04); } }
  #hkt-{{ section.id }} .hkt__tag,
  #hkt-{{ section.id }} .hkt__badge { position: absolute; top: 14px; padding: 7px 11px; border-radius: 999px; font: 700 11.5px/1 'Montserrat', sans-serif; }
  /* Tinted with a shadow so it stays visible on white product photos too. */
  #hkt-{{ section.id }} .hkt__tag { left: 14px; background: var(--tone); color: var(--tone-ink); box-shadow: 0 2px 8px rgba(29, 29, 29, .12); }
  #hkt-{{ section.id }} .hkt__badge { box-shadow: 0 2px 8px rgba(29, 29, 29, .18); }
  #hkt-{{ section.id }} .hkt__badge { right: 14px; background: var(--hkt-text); color: #fff; }
  #hkt-{{ section.id }} .hkt__body { padding: 20px 22px 24px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  #hkt-{{ section.id }} .hkt__title { margin: 0; font: 700 17px/1.3 'Montserrat', sans-serif; color: var(--hkt-text); }
  #hkt-{{ section.id }} .hkt__rating { margin: 0; font: 600 13px/1 'Montserrat', sans-serif; color: var(--hkt-text); }
  #hkt-{{ section.id }} .hkt__rating i { font-style: normal; color: #f5a623; }
  #hkt-{{ section.id }} .hkt__rating span { color: var(--hkt-muted); font-weight: 500; }
  #hkt-{{ section.id }} .hkt__price { margin: 2px 0 0; display: flex; align-items: baseline; flex-wrap: wrap; gap: 8px; }
  #hkt-{{ section.id }} .hkt__price b { font: 800 20px/1 'Montserrat', sans-serif; }
  #hkt-{{ section.id }} .hkt__price s { font: 500 14px/1 'Montserrat', sans-serif; color: #767676; }
  #hkt-{{ section.id }} .hkt__price em { font: 700 12.5px/1 'Montserrat', sans-serif; font-style: normal; color: var(--hkt-ink); }
  #hkt-{{ section.id }} .hkt__cta { margin-top: auto; padding-top: 10px; display: inline-flex; gap: 8px; align-items: center; font: 700 14.5px/1 'Montserrat', sans-serif; color: var(--hkt-ink); }
  #hkt-{{ section.id }} .hkt__cta span { transition: transform .2s ease; }
  #hkt-{{ section.id }} .hkt__note { margin: 28px 0 0; font: 500 14px/1.5 'Montserrat', sans-serif; color: var(--hkt-muted); }

  @media (max-width: 749.98px) {
    #hkt-{{ section.id }} .hkt__inner { padding: 56px 0 28px; }
    #hkt-{{ section.id }} .hkt__head { flex-direction: column; align-items: flex-start; padding: 0 16px; margin-bottom: 24px; gap: 16px; }
    #hkt-{{ section.id }} .hkt__heading { font-size: 28px; }
    #hkt-{{ section.id }} .hkt__sub { font-size: 14.5px; }
    #hkt-{{ section.id }} .hkt__row {
      display: flex; gap: 12px; overflow-x: auto; padding: 4px 16px 18px;
      scroll-snap-type: x mandatory; scroll-padding: 0 16px; scrollbar-width: none;
    }
    #hkt-{{ section.id }} .hkt__row::-webkit-scrollbar { display: none; }
    #hkt-{{ section.id }} .hkt__card { flex: 0 0 76%; scroll-snap-align: start; }
    #hkt-{{ section.id }} .hkt__note { padding: 0 16px; margin-top: 14px; font-size: 13px; }
  }
  @media (prefers-reduced-motion: reduce) { #hkt-{{ section.id }} .hkt__card, #hkt-{{ section.id }} .hkt__cta span { transition: none; } }

  /* Big screens: scale the whole section in proportion, so 1920-3840px
     monitors get a page sized for them instead of a 1200px island. */
  @media (min-width: 1680px) { #hkt-{{ section.id }} .hkt__inner { zoom: 1.12; } }
  @media (min-width: 1920px) { #hkt-{{ section.id }} .hkt__inner { zoom: 1.25; } }
  @media (min-width: 2240px) { #hkt-{{ section.id }} .hkt__inner { zoom: 1.45; } }
  @media (min-width: 2560px) { #hkt-{{ section.id }} .hkt__inner { zoom: 1.65; } }
  @media (min-width: 3200px) { #hkt-{{ section.id }} .hkt__inner { zoom: 2; } }
  @media (min-width: 3840px) { #hkt-{{ section.id }} .hkt__inner { zoom: 2.4; } }
</style>

<section id="hkt-{{ section.id }}" class="hkt">
  <div class="hkt__inner">
    <div class="hkt__head">
      <div>
        {%- if s.eyebrow != blank -%}<p class="hkt__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        <h2 class="hkt__heading">{{ s.heading }}</h2>
        {%- if s.subheading != blank -%}<p class="hkt__sub">{{ s.subheading }}</p>{%- endif -%}
      </div>
      <div class="hkt__tools">
        {%- if s.all_link != blank and s.all_label != blank -%}
          <a class="hkt__all" href="{{ s.all_link }}">{{ s.all_label }}<span aria-hidden="true">&rarr;</span></a>
        {%- endif -%}
        {%- if split -%}
          <div class="hkt__nav">
            <button type="button" class="hkt__arrow" data-dir="-1" aria-label="Previous kits"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3 5 8l5 5"/></svg></button>
            <button type="button" class="hkt__arrow" data-dir="1" aria-label="More kits"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3l5 5-5 5"/></svg></button>
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="hkt__row{% if split %} hkt__row--scroll{% endif %}" data-hkt-row>
      {%- if split -%}{%- assign groups = 'her,him' | split: ',' -%}{%- else -%}{%- assign groups = 'all' | split: ',' -%}{%- endif -%}
      {%- for g in groups -%}
      {%- liquid
        if g == 'her'
          assign list = s.her_products
        elsif g == 'him'
          assign list = s.him_products
        else
          assign list = s.products
        endif
      -%}
      {%- for product in list -%}
        {%- liquid
          if g == 'her'
            assign her = true
          elsif g == 'him'
            assign her = false
          else
            assign probe = product.title | append: ' ' | append: product.handle | downcase
            assign her = false
            if probe contains 'female' or probe contains 'women' or probe contains 'her ' or probe contains 'period' or probe contains 'menses' or probe contains 'hormon'
              assign her = true
            endif
          endif
          assign v = product.selected_or_first_available_variant
          assign rating = product.metafields.reviews.rating.value
          assign rating_count = product.metafields.reviews.rating_count.value
        -%}
        <a class="hkt__card {% if her %}hkt__card--her{% else %}hkt__card--him{% endif %}" href="{{ product.url }}" data-who="{% if her %}her{% else %}him{% endif %}"{% if split and g == 'her' and forloop.first %} data-top{% endif %}>
          <div class="hkt__img">
            {%- if product.featured_image != blank -%}
              <img src="{{ product.featured_image | image_url: width: 600 }}"
                   srcset="{{ product.featured_image | image_url: width: 360 }} 360w, {{ product.featured_image | image_url: width: 600 }} 600w"
                   sizes="(max-width: 749.98px) 80vw, 340px"
                   alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy"
                   width="600" height="{{ 600 | divided_by: product.featured_image.aspect_ratio | round }}">
            {%- endif -%}
            <span class="hkt__tag">{% if her %}{{ s.her_label }}{% else %}{{ s.him_label }}{% endif %}</span>
            {%- if s.first_badge != blank -%}{%- if split or forloop.first -%}<span class="hkt__badge">{{ s.first_badge }}</span>{%- endif -%}{%- endif -%}
          </div>
          <div class="hkt__body">
            <h3 class="hkt__title">{{ product.title }}</h3>
            {%- if rating != blank and rating_count > 0 -%}
              <p class="hkt__rating"><i aria-hidden="true">★</i> {{ rating.rating | round: 1 }} <span>({{ rating_count }})</span></p>
            {%- endif -%}
            <p class="hkt__price">
              <b>{{ v.price | money_without_trailing_zeros }}</b>
              {%- if v.compare_at_price > v.price -%}
                {%- assign save = v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price -%}
                <s>{{ v.compare_at_price | money_without_trailing_zeros }}</s>
                <em>Save {{ save }}%</em>
              {%- endif -%}
            </p>
            <span class="hkt__cta">{{ s.button_label }}<span aria-hidden="true">&rarr;</span></span>
          </div>
        </a>
      {%- endfor -%}
      {%- endfor -%}
    </div>

    {%- if s.note != blank -%}<p class="hkt__note">{{ s.note }}</p>{%- endif -%}
  </div>
</section>

{%- if split -%}
<script>
  (function () {
    var root = document.getElementById('hkt-{{ section.id }}');
    if (!root) return;
    var row = root.querySelector('[data-hkt-row]');
    var prev = root.querySelector('.hkt__arrow[data-dir="-1"]'), next = root.querySelector('.hkt__arrow[data-dir="1"]');
    function step() { var c = row.querySelector('.hkt__card'); return c ? c.getBoundingClientRect().width + 22 : row.clientWidth; }
    function sync() {
      if (!prev) return;
      prev.disabled = row.scrollLeft < 4;
      next.disabled = row.scrollLeft + row.clientWidth >= row.scrollWidth - 4;
    }
    [prev, next].forEach(function (b) { if (b) b.addEventListener('click', function () { row.scrollBy({ left: step() * +b.dataset.dir, behavior: 'smooth' }); }); });
    row.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);
    sync();

    // Follow the For Her / For Him switch further up the page: that side first.
    var shown = 'her';
    function order(who) {
      if (who === shown || (who !== 'her' && who !== 'him')) return;
      shown = who;
      var cards = Array.prototype.slice.call(row.querySelectorAll('.hkt__card'));
      var mine = cards.filter(function (c) { return c.dataset.who === who; });
      var rest = cards.filter(function (c) { return c.dataset.who !== who; });
      if (!mine.length) return;
      row.classList.add('is-swap');
      setTimeout(function () {
        cards.forEach(function (c) { c.removeAttribute('data-top'); });
        mine.concat(rest).forEach(function (c) { row.appendChild(c); });
        mine[0].setAttribute('data-top', '');
        row.scrollLeft = 0;
        row.classList.remove('is-swap');
        sync();
      }, 250);
    }
    document.addEventListener('hs360:who', function (e) { order(e.detail); });
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Care kits",
  "tag": "div",
  "class": "section-health-kits",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What your doctor may suggest" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our most ordered care kits" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Each kit pairs medicines from different systems. Your doctor tells you which one fits you, and what it costs, before you decide." },
    { "type": "product_list", "id": "her_products", "label": "Kits for her", "limit": 8, "info": "Shown first when For Her is chosen above. With either list set, the kits become a swipeable row." },
    { "type": "product_list", "id": "him_products", "label": "Kits for him", "limit": 8, "info": "Shown first when For Him is chosen above." },
    { "type": "product_list", "id": "products", "label": "Kits (old single list)", "limit": 4, "info": "Used only when both lists above are empty." },
    { "type": "text", "id": "first_badge", "label": "Badge on the first kit", "default": "Most ordered" },
    { "type": "text", "id": "button_label", "label": "Card button", "default": "View kit" },
    { "type": "text", "id": "her_label", "label": "For Her tag", "default": "For Her" },
    { "type": "text", "id": "him_label", "label": "For Him tag", "default": "For Him" },
    { "type": "text", "id": "all_label", "label": "All kits link text", "default": "See all combos" },
    { "type": "url", "id": "all_link", "label": "All kits link" },
    { "type": "text", "id": "note", "label": "Small note", "default": "Pay just ₹50 to confirm and the rest on delivery, or pay in full online." },
    { "type": "color", "id": "accent_color", "label": "Accent colour", "default": "#ee204a" }
  ],
  "presets": [{ "name": "Care kits" }]
}
{% endschema %}
