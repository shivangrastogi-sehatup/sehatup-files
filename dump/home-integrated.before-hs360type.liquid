{%- comment -%}
  Home: "one clinic, three systems, one plan" (Claude Design "Integrated
  Care Directions": Direction 24a on desktop, Direction 22's mobile frame).

  Desktop: one red circle with the brand name glides apart into three photo
  circles in a row while the red melts into the photos; a thin red line (the
  circles' ring colour) fades in behind them; each name fades up under its own
  circle; then the closing line and the button. About 3 seconds, once.

  Phones: the red circle opens into a cluster (one on top, two below) with a
  small red "Your plan" circle where they meet; the names sit in a list
  under it, then the closing line and a full-width button.

  Without JS, or with reduced motion, the final picture shows straight away.
  Stage geometry is a 1160 x 400 box; positions below are in that box.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign uid = 'hin-' | append: section.id
-%}
<style>
  #{{ uid }} {
    --ink: #1d1d1d; --mute: #5f5a56; --red: #d81f48; --ease: cubic-bezier(.65, 0, .35, 1);
    padding: clamp(24px, 3vw, 40px) clamp(16px, 4vw, 48px) clamp(48px, 5vw, 80px); background: {{ s.section_bg | default: '#ffffff' }}; color: var(--ink); font-family: 'Montserrat', sans-serif;
  }
  /* The theme spaces body text out; this section is set tight, like the design. */
  #{{ uid }} * { letter-spacing: normal; }
  #{{ uid }} .hin__in { max-width: 1160px; margin: 0 auto; }
  #{{ uid }} .hin__h { margin: 0 auto 36px; max-width: 820px; text-align: center; color: var(--ink); font: 700 clamp(26px, 2.9vw, 40px)/1.15 'Montserrat', sans-serif; letter-spacing: -.02em; text-wrap: balance; }

  #{{ uid }} .hin__h:has(+ .hin__sub) { margin-bottom: 12px; }
  #{{ uid }} .hin__sub { margin: 0 auto 36px; max-width: 640px; text-align: center; font: 400 17px/1.6 'Montserrat', sans-serif; color: var(--mute); text-wrap: pretty; }
  #{{ uid }} .hin__stage, #{{ uid }} .hin__art { position: relative; }
  #{{ uid }} .hin__svg { display: block; width: 100%; height: auto; overflow: visible; }
  #{{ uid }} .hin__d--1 { transform: translate(260px, 140px); }
  #{{ uid }} .hin__d--2 { transform: translate(580px, 140px); }
  #{{ uid }} .hin__d--3 { transform: translate(900px, 140px); }
  #{{ uid }} .hin__red, #{{ uid }} .hin__center { opacity: 0; }

  #{{ uid }} .hin__brand { position: absolute; left: 50%; top: 35%; transform: translate(-50%, -50%); margin: 0; opacity: 0; color: #fff; pointer-events: none; font: 800 clamp(20px, 2.4vw, 30px)/1 'Montserrat', sans-serif; letter-spacing: -.02em; }
  /* Three columns, each centred under its circle (x = 260, 580, 900 of 1160),
     starting where the circles end (y = 282 of 400 = 24.31% of the width). */
  #{{ uid }} .hin__labs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); width: 82.76%; margin: -10.17% auto 0; }
  #{{ uid }} .hin__lab { width: 100%; max-width: 300px; margin: 0 auto; padding: 0 8px; text-align: center; }
  #{{ uid }} .hin__lab b { display: block; font: 800 clamp(16px, 1.7vw, 20px)/1.2 'Montserrat', sans-serif; white-space: nowrap; }
  #{{ uid }} .hin__lab span { display: block; margin-top: 6px; font: 400 clamp(13px, 1.35vw, 16px)/1.45 'Montserrat', sans-serif; color: var(--mute); }

  #{{ uid }} .hin__list { display: none; }
  #{{ uid }} .hin__foot { margin-top: 32px; display: flex; flex-direction: column; align-items: center; gap: 22px; text-align: center; }
  #{{ uid }} .hin__close { margin: 0; max-width: 100%; font: 800 clamp(22px, 2.5vw, 34px)/1.25 'Montserrat', sans-serif; letter-spacing: -.02em; text-wrap: balance; }
  #{{ uid }} .hin__close em { font-style: normal; color: var(--red); }
  #{{ uid }} .hin__btn { display: inline-flex; align-items: center; gap: 10px; height: 54px; padding: 0 30px; border-radius: 999px; background: var(--red); color: #fff; text-decoration: none; font: 700 16px/1 'Montserrat', sans-serif; transition: background-color .2s; }
  @media (hover: hover) { #{{ uid }} .hin__btn:hover { background: #c11a3f; color: #fff; } }
  #{{ uid }} .hin__btn:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  #{{ uid }} .hin__btn svg { width: .9em; height: .9em; }

  /* ---- animation: "is-ready" waits on the first frame, "is-play" runs it ---- */
  #{{ uid }}.is-ready:not(.is-play) .hin__d { transform: translate(580px, 140px); }
  #{{ uid }}.is-ready:not(.is-play) :is(.hin__red, .hin__brand) { opacity: 1; }
  #{{ uid }}.is-ready:not(.is-play) :is(.hin__img, .hin__join, .hin__lab, .hin__list, .hin__close, .hin__btn) { opacity: 0; }

  #{{ uid }}.is-play .hin__d--1 { animation: {{ uid }}-d1 3s var(--ease) both; }
  #{{ uid }}.is-play .hin__d--2 { animation: {{ uid }}-d2 3s var(--ease) both; }
  #{{ uid }}.is-play .hin__d--3 { animation: {{ uid }}-d3 3s var(--ease) both; }
  #{{ uid }}.is-play .hin__brand { animation: {{ uid }}-out .4s ease .5s both; }
  #{{ uid }}.is-play .hin__red { animation: {{ uid }}-out 1.1s ease .6s both; }
  #{{ uid }}.is-play .hin__img { animation: {{ uid }}-in 1.1s ease .6s both; }
  #{{ uid }}.is-play .hin__join { animation: {{ uid }}-in .6s ease 1.2s both; }
  #{{ uid }}.is-play :is(.hin__lab, .hin__list) { animation: {{ uid }}-up .5s ease 1.8s both; }
  #{{ uid }}.is-play .hin__close { animation: {{ uid }}-up .5s ease 2.2s both; }
  #{{ uid }}.is-play .hin__btn { animation: {{ uid }}-up .5s ease 2.45s both; }

  /* still until 0.5s, glide into the row by 1.7s */
  @keyframes {{ uid }}-d1 { 0%, 16.7% { transform: translate(580px, 140px); } 56.7%, 100% { transform: translate(260px, 140px); } }
  @keyframes {{ uid }}-d2 { 0%, 100% { transform: translate(580px, 140px); } }
  @keyframes {{ uid }}-d3 { 0%, 16.7% { transform: translate(580px, 140px); } 56.7%, 100% { transform: translate(900px, 140px); } }
  @keyframes {{ uid }}-in { from { opacity: 0; } to { opacity: 1; } }
  @keyframes {{ uid }}-out { from { opacity: 1; } to { opacity: 0; } }
  /* Uses `translate`, not `transform`, so it never wipes the labels' centring transform. */
  @keyframes {{ uid }}-up { from { opacity: 0; translate: 0 10px; } to { opacity: 1; translate: 0 0; } }

  /* Phones: the cluster (one on top, two below) with "Your plan", names in a list. */
  @media (max-width: 749.98px) {
    #{{ uid }} .hin__h { margin-bottom: 20px; font-size: 28px; }
    #{{ uid }} .hin__sub { margin-bottom: 20px; font-size: 15px; }
    #{{ uid }} .hin__stage { aspect-ratio: 420 / 394; overflow: hidden; max-width: 380px; margin: 0 auto; }
    #{{ uid }} .hin__svg { width: 276.19%; margin: -.48% 0 0 -88.1%; }
    #{{ uid }} .hin__d--1 { transform: translate(490px, 276px); }
    #{{ uid }} .hin__d--2 { transform: translate(580px, 120px); }
    #{{ uid }} .hin__d--3 { transform: translate(670px, 276px); }
    #{{ uid }} .hin__center { opacity: 1; }
    #{{ uid }} .hin__join, #{{ uid }} .hin__labs { display: none; }
    #{{ uid }} .hin__brand { top: 50%; }
    #{{ uid }}.is-ready:not(.is-play) .hin__d { transform: translate(580px, 199px); }
    #{{ uid }}.is-ready:not(.is-play) .hin__center { opacity: 0; }
    #{{ uid }}.is-play .hin__center { animation: {{ uid }}-in .4s ease 1.7s both; }
    @keyframes {{ uid }}-d1 { 0%, 16.7% { transform: translate(580px, 199px); } 56.7%, 100% { transform: translate(490px, 276px); } }
    @keyframes {{ uid }}-d2 { 0%, 16.7% { transform: translate(580px, 199px); } 56.7%, 100% { transform: translate(580px, 120px); } }
    @keyframes {{ uid }}-d3 { 0%, 16.7% { transform: translate(580px, 199px); } 56.7%, 100% { transform: translate(670px, 276px); } }

    #{{ uid }} .hin__list { display: flex; flex-direction: column; margin: 20px 0 0; padding: 0; list-style: none; border-bottom: 1px solid #e8e0d9; }
    #{{ uid }} .hin__list li { padding: 14px 0; border-top: 1px solid #e8e0d9; }
    #{{ uid }} .hin__list b { display: block; font: 800 17px/1.2 'Montserrat', sans-serif; }
    #{{ uid }} .hin__list span { display: block; margin-top: 4px; font: 400 15px/1.45 'Montserrat', sans-serif; color: var(--mute); }
    #{{ uid }} .hin__foot { margin-top: 26px; gap: 20px; }
    #{{ uid }} .hin__close { font-size: 23px; line-height: 1.3; }
    #{{ uid }} .hin__btn { width: 100%; justify-content: center; }
  }
  /* Big screens: the text grows and the artwork gets wider, smoothly where the
     browser can (1.25x at 1920px, 1.67x at 2560px, at most 2.4x), else in steps.
     No zoom on the artwork itself: its circles move in pixels inside the SVG,
     which zoom would throw out of line. */
  @media (min-width: 1680px) { #{{ uid }} { --z: 1.12; } }
  @media (min-width: 1920px) { #{{ uid }} { --z: 1.25; } }
  @media (min-width: 2560px) { #{{ uid }} { --z: 1.65; } }
  @media (min-width: 3200px) { #{{ uid }} { --z: 2; } }
  @supports (zoom: calc(100vw / 1536px)) {
    @media (min-width: 1536px) { #{{ uid }} { --z: clamp(1, 100vw / 1536px, 2.4); } }
  }
  @media (min-width: 1536px) {
    #{{ uid }} { padding-top: calc(40px * var(--z, 1)); padding-bottom: calc(80px * var(--z, 1)); }
    #{{ uid }} .hin__in { max-width: calc(1160px * var(--z, 1)); }
    #{{ uid }} :is(.hin__h, .hin__sub, .hin__brand, .hin__labs, .hin__foot) { zoom: var(--z, 1); }
  }
</style>

<section id="{{ uid }}" class="hin">
  <div class="hin__in">
    {%- if s.heading != blank -%}<h2 class="hin__h">{{ s.heading }}</h2>{%- endif -%}
    {%- if s.subheading != blank -%}<p class="hin__sub">{{ s.subheading }}</p>{%- endif -%}

    <div class="hin__stage">
      <div class="hin__art">
      <svg class="hin__svg" viewBox="0 0 1160 400" aria-hidden="true" focusable="false">
        <defs><clipPath id="{{ uid }}-c"><circle r="110"/></clipPath></defs>
        <g class="hin__join">
          <line x1="260" y1="140" x2="900" y2="140" stroke="#d81f48" stroke-width="1.25" vector-effect="non-scaling-stroke"/>
        </g>
        {%- comment -%} Drawn left, right, then middle, so the middle circle sits on top while they overlap. {%- endcomment -%}
        {%- assign draw = '1,3,2' | split: ',' -%}
        {%- for i in draw -%}
          {%- capture k_img -%}sys{{ i }}_image{%- endcapture -%}
          <g class="hin__d hin__d--{{ i }}">
            <g clip-path="url(#{{ uid }}-c)">
              <rect x="-110" y="-110" width="220" height="220" fill="#fff"/>
              {%- if s[k_img] != blank -%}
                <image class="hin__img" href="{{ s[k_img] | image_url: width: 600 }}" x="-110" y="-110" width="220" height="220" preserveAspectRatio="xMidYMid slice"/>
              {%- endif -%}
              <circle class="hin__red" r="110" fill="#d81f48"/>
            </g>
            <circle r="109.4" fill="none" stroke="#d81f48" stroke-width="1.25" vector-effect="non-scaling-stroke"/>
          </g>
        {%- endfor -%}
        <g class="hin__center">
          <circle cx="580" cy="224" r="44" fill="#d81f48" stroke="#fff" stroke-width="3"/>
          <text x="580" y="229" text-anchor="middle" fill="#fff" style="font: 800 15px 'Montserrat', sans-serif">{{ s.plan_label }}</text>
        </g>
      </svg>

      {%- if s.brand_text != blank -%}<p class="hin__brand" aria-hidden="true">{{ s.brand_text }}</p>{%- endif -%}
      </div>
      <div class="hin__labs">
      {%- for i in (1..3) -%}
        {%- capture k_n -%}sys{{ i }}_name{%- endcapture -%}
        {%- capture k_t -%}sys{{ i }}_text{%- endcapture -%}
        <p class="hin__lab hin__lab--{{ i }}"><b>{{ s[k_n] }}</b>{%- if s[k_t] != blank -%}<span>{{ s[k_t] }}</span>{%- endif -%}</p>
      {%- endfor -%}
      </div>
    </div>

    {%- comment -%} Phones only: top circle first, then the two below. {%- endcomment -%}
    <ul class="hin__list">
      {%- assign order = '2,1,3' | split: ',' -%}
      {%- for i in order -%}
        {%- capture k_n -%}sys{{ i }}_name{%- endcapture -%}
        {%- capture k_t -%}sys{{ i }}_text{%- endcapture -%}
        <li><b>{{ s[k_n] }}</b>{%- if s[k_t] != blank -%}<span>{{ s[k_t] }}</span>{%- endif -%}</li>
      {%- endfor -%}
    </ul>

    {%- if s.closing_red != blank or s.closing != blank or s.button != blank -%}
      <div class="hin__foot">
        {%- if s.closing_red != blank or s.closing != blank -%}<p class="hin__close">{%- if s.closing_red != blank -%}<em>{{ s.closing_red }}</em> {% endif -%}{{ s.closing }}</p>{%- endif -%}
        {%- if s.button != blank -%}<a class="hin__btn" href="{{ s.button_link | default: '#' }}">{{ s.button }}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{%- if s.animate -%}
<script>
  (function () {
    var root = document.getElementById('{{ uid }}');
    if (!root || !('IntersectionObserver' in window)) return;
    if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    root.classList.add('is-ready');
    var io = new IntersectionObserver(function (es) {
      if (!es[0].isIntersecting) return;
      io.disconnect();
      setTimeout(function () { root.classList.add('is-play'); }, 250);
    }, { threshold: .35 });
    io.observe(root.querySelector('.hin__stage'));
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Home: integrated care",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "One clinic, three systems, one plan." },
    { "type": "textarea", "id": "subheading", "label": "Line under the heading", "info": "Optional." },
    { "type": "checkbox", "id": "animate", "label": "Play the animation", "default": true, "info": "Off shows the final picture straight away." },
    { "type": "text", "id": "brand_text", "label": "Text in the first red circle", "default": "sehatUP" },
    { "type": "text", "id": "plan_label", "label": "Text in the centre circle (phones)", "default": "Your plan" },
    { "type": "header", "content": "Left circle (bottom left on phones)" },
    { "type": "image_picker", "id": "sys1_image", "label": "Photo" },
    { "type": "text", "id": "sys1_name", "label": "Name", "default": "Ayurveda" },
    { "type": "text", "id": "sys1_text", "label": "Line", "default": "Lifestyle balance, digestion and long-term healing." },
    { "type": "header", "content": "Middle circle (top on phones)" },
    { "type": "image_picker", "id": "sys2_image", "label": "Photo" },
    { "type": "text", "id": "sys2_name", "label": "Name", "default": "Homeopathy" },
    { "type": "text", "id": "sys2_text", "label": "Line", "default": "Gentle, root-cause care with minimal side effects." },
    { "type": "header", "content": "Right circle (bottom right on phones)" },
    { "type": "image_picker", "id": "sys3_image", "label": "Photo" },
    { "type": "text", "id": "sys3_name", "label": "Name", "default": "Modern medicine" },
    { "type": "text", "id": "sys3_text", "label": "Line", "default": "Accurate diagnosis and fast relief when needed." },
    { "type": "header", "content": "Below" },
    { "type": "text", "id": "closing_red", "label": "Closing line, red part", "default": "Your integrated plan." },
    { "type": "text", "id": "closing", "label": "Closing line, rest", "default": "Made by our doctors, together." },
    { "type": "text", "id": "button", "label": "Button", "default": "Take the free Health Score 360" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "section_bg", "label": "Background", "default": "#ffffff" }
  ],
  "presets": [{ "name": "Home: integrated care" }]
}
{% endschema %}
