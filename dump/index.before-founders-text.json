    "faq": {
      "type": "health-faq",
      "blocks": {
        "question1": {
          "type": "question",
          "settings": {
            "question": "What is sehatUP?",
            "answer": "<p>India's first integrated digital health clinic. Ayurveda and Homeopathy doctors and a counselling psychologist plan your care together, and you get one plan, your kit delivered home, and check-ins on WhatsApp.</p>"
          }
        },
        "question2": {
          "type": "question",
          "settings": {
            "question": "Is the Health Score really free?",
            "answer": "<p>Yes. The questionnaire is free and needs no sign-up. You only pay if you decide to order a care kit.</p>"
          }
        },
        "question3": {
          "type": "question",
          "settings": {
            "question": "Do I have to pay for the doctor consultation?",
            "answer": "<p>No. The doctor call after your Health Score is free, and consultations are included with your care plan at no extra cost.</p>"
          }
        },
        "question4": {
          "type": "question",
          "settings": {
            "question": "Do I have to buy anything?",
            "answer": "<p>No. If your doctor suggests a care kit, they tell you what is in it and what it costs before you decide. Most care kits cost between ₹799 and ₹1,699.</p>"
          }
        },
        "question5": {
          "type": "question",
          "settings": {
            "question": "Is my information confidential?",
            "answer": "<p>Yes. Your answers are encrypted, only your doctor sees them, and they are used only to plan your care.</p>"
          }
        },
        "question6": {
          "type": "question",
          "settings": {
            "question": "Will anyone know what I ordered?",
            "answer": "<p>Your kit is packed discreetly. The shipping label has your address, and product names are cut to their first few letters, so the full names are not shown. Only your doctor sees your answers.</p>"
          }
        },
        "question7": {
          "type": "question",
          "settings": {
            "question": "Are the products safe?",
            "answer": "<p>Our products are AYUSH approved and GMP certified, and a doctor chooses them for you. Always tell your doctor about any medicines you already take.</p>"
          }
        },
        "question8": {
          "type": "question",
          "settings": {
            "question": "Is it safe to combine Ayurveda, Homeopathy and Allopathy?",
            "answer": "<p>Your doctors plan your care together, so the parts of your plan are chosen to work with each other. Always tell your doctor about any medicines you already take.</p>"
          }
        },
        "question9": {
          "type": "question",
          "settings": {
            "question": "How soon will I see results?",
            "answer": "<p>Most people notice first changes in 4 to 6 weeks. A full plan usually runs 3 months, adjusted at each monthly check-in. Results vary from person to person.</p>"
          }
        },
        "question10": {
          "type": "question",
          "settings": {
            "question": "How do I pay for a care kit?",
            "answer": "<p>Confirm your order with just ₹50 and pay the rest when your kit arrives, or pay the full amount online.</p>"
          }
        },
        "question11": {
          "type": "question",
          "settings": {
            "question": "How long does delivery take?",
            "answer": "<p>Usually 3 to 5 days, depending on where you live.</p>"
          }
        }
      },
