{% assign ai_gen_id = section.id | replace: '_', '' | replace: '-', '' | downcase %}

{% style %}
.ai-collection-showcase-{{ ai_gen_id }}{display:block;width:100%;padding:40px 20px;background:{{ section.settings.section_bg_color }};scroll-margin-top:{{ section.settings.scroll_offset }}px;}
.ai-collection-showcase-container-{{ ai_gen_id }}{max-width:{{ settings.page_width }}px;margin:0 auto;}
.ai-collection-showcase-header-{{ ai_gen_id }}{text-align:center;margin-bottom:40px;}
.ai-collection-showcase-heading-{{ ai_gen_id }}{font-family:{{ settings.type_header_font.family }},{{ settings.type_header_font.fallback_families }};font-weight:700;font-size:clamp(24px,3.4vw,64px);margin:0 0 16px;color:{{ section.settings.heading_color }};}
.ai-collection-showcase-description-{{ ai_gen_id }}{font-size:clamp(10px,1vw,20px);color:{{ section.settings.text_color }};margin:0;}

.ai-collection-showcase-wrapper-{{ ai_gen_id }}{position:relative;display:flex;gap:32px;align-items:flex-start;}

.ai-sticky-sidebar-{{ ai_gen_id }}{position:sticky;top:100px;flex-shrink:0;width:350px;will-change:width,opacity;transition:width .4s cubic-bezier(.4,0,.2,1),opacity .4s cubic-bezier(.4,0,.2,1),margin-right .4s cubic-bezier(.4,0,.2,1);z-index:2;overflow:hidden;opacity:1;pointer-events:auto;background:{{ section.settings.sidebar_bg_color }};border-radius:{{ settings.card_corner_radius }}px;}

.ai-sticky-sidebar-{{ ai_gen_id }}.shrinking{width:0;opacity:0;margin-right:-32px;pointer-events:none;}

.ai-sticky-sidebar-content-{{ ai_gen_id }}{padding:24px;white-space:nowrap;width:350px;}
.ai-sticky-sidebar-title-{{ ai_gen_id }}{font-family:{{ settings.type_header_font.family }},{{ settings.type_header_font.fallback_families }};font-weight:600;font-size:clamp(14px,2.4vw,35px);margin:0 0 12px;line-height:1.3;white-space:normal;color:{{ section.settings.sidebar_title_color }};}
.ai-sticky-sidebar-paragraph-{{ ai_gen_id }}{font-size:clamp(13px,1vw,22px);margin:0 0 20px;line-height:1.6;white-space:normal;color:{{ section.settings.sidebar_text_color }};}
.ai-view-all-btn-{{ ai_gen_id }}{width:100%;padding:12px 24px;background:transparent;color:{{ section.settings.view_all_text_color }};border:2px solid {{ section.settings.view_all_border_color }};border-radius:50px;font-size:14px;font-weight:600;cursor:pointer;transition:.3s;text-decoration:none;display:inline-block;text-align:center;box-sizing:border-box;}
.ai-view-all-btn-{{ ai_gen_id }}:hover{background:{{ section.settings.view_all_hover_bg }};color:{{ section.settings.view_all_hover_text }};border-color:{{ section.settings.view_all_hover_bg }};}
.ai-products-section-{{ ai_gen_id }}{flex:1;min-width:0;position:relative;}
.ai-collection-showcase-grid-{{ ai_gen_id }}{display:grid;grid-template-columns:repeat({{ section.settings.products_per_row }},1fr);gap:20px;}

.ai-collection-showcase-scroll-{{ ai_gen_id }}{display:flex;gap:20px;overflow-x:auto;scroll-behavior:smooth;-ms-overflow-style:none;scrollbar-width:none;}
.ai-collection-showcase-scroll-{{ ai_gen_id }}::-webkit-scrollbar{display:none;}

.ai-collection-showcase-scroll-{{ ai_gen_id }} .ai-product-card-{{ ai_gen_id }}{flex:0 0 280px;min-width:280px;max-width:280px;}
.ai-product-card-{{ ai_gen_id }}{position:relative;background:{{ section.settings.card_background }};border-radius:{{ settings.card_corner_radius }}px;overflow:hidden;transition:.3s;box-shadow:0 2px 8px rgba(0,0,0,.08);display:flex;flex-direction:column;}
.ai-product-card-{{ ai_gen_id }}:hover{transform:translateY(-4px);box-shadow:0 8px 16px rgba(0,0,0,.12);}
.ai-product-card-link-{{ ai_gen_id }}{text-decoration:none;color:inherit;display:flex;flex-direction:column;flex-grow:1;}
.ai-product-image-wrapper-{{ ai_gen_id }}{position:relative;width:100%;padding-top:100%;overflow:hidden;background:#f5f5f5;}
.ai-product-image-{{ ai_gen_id }}{position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;}
.ai-product-placeholder-{{ ai_gen_id }}{position:absolute;top:0;left:0;width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#f5f5f5;color:#ccc;}
.ai-product-placeholder-{{ ai_gen_id }} svg{width:60%;height:60%;}
.ai-sale-badge-{{ ai_gen_id }}{position:absolute;top:12px;right:12px;background:{{ section.settings.badge_background }};color:{{ section.settings.badge_text_color }};padding:6px 12px;border-radius:{{ settings.badge_corner_radius }}px;font-size:12px;font-weight:600;z-index:2;}

.ai-pinned-badge-{{ ai_gen_id }}{position:absolute;top:12px;left:12px;background:{{ section.settings.pinned_badge_background }};color:{{ section.settings.pinned_badge_text_color }};padding:6px 12px;border-radius:{{ settings.badge_corner_radius }}px;font-size:12px;font-weight:600;z-index:2;}

.ai-product-info-{{ ai_gen_id }}{padding:16px;flex-grow:1;display:flex;flex-direction:column;}
.ai-product-title-{{ ai_gen_id }}{font-size:clamp(14px,1.4vw,35px);font-weight:700;margin:0 0 8px;line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}
.ai-product-price-{{ ai_gen_id }}{display:flex;align-items:center;gap:8px;margin-bottom:12px;}
.ai-price-regular-{{ ai_gen_id }}{font-size:16px;font-weight:600;color:{{ section.settings.price_color }};}
.ai-price-sale-{{ ai_gen_id }}{font-size:16px;font-weight:600;color:{{ section.settings.sale_price_color }};}
.ai-price-compare-{{ ai_gen_id }}{font-size:14px;color:#999;text-decoration:line-through;}
.ai-product-actions-{{ ai_gen_id }}{margin-top:auto;padding:0 16px 16px;}
.ai-add-to-cart-btn-{{ ai_gen_id }}{width:100%;padding:10px 20px;background:transparent;color:{{ section.settings.cart_btn_text_color }};border:2px solid {{ section.settings.cart_btn_border_color }};border-radius:50px;font-size:14px;font-weight:600;cursor:pointer;transition:.3s;}
.ai-add-to-cart-btn-{{ ai_gen_id }}:hover{background:{{ section.settings.cart_btn_hover_bg }};color:{{ section.settings.cart_btn_hover_text }};border-color:{{ section.settings.cart_btn_hover_bg }};}
.ai-add-to-cart-btn-{{ ai_gen_id }}:disabled{opacity:.6;cursor:not-allowed;}
.ai-quantity-selector-{{ ai_gen_id }}{display:none;align-items:center;justify-content:center;gap:12px;border:2px solid {{ section.settings.cart_btn_border_color }};border-radius:50px;padding:6px 12px;}
.ai-quantity-selector-{{ ai_gen_id }}.active{display:inline-flex;width:100%;justify-content:space-between;}
.ai-quantity-btn-{{ ai_gen_id }}{background:none;border:none;font-size:18px;cursor:pointer;padding:0 4px;line-height:1;color:{{ section.settings.cart_btn_text_color }};}
.ai-quantity-display-{{ ai_gen_id }}{font-size:15px;font-weight:600;min-width:20px;text-align:center;}
.ai-nav-arrow-{{ ai_gen_id }}{position:absolute;top:50%;transform:translateY(-50%);width:48px;height:48px;background:#fff;border:1px solid #ddd;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;z-index:2;transition:.3s;box-shadow:0 2px 8px rgba(0,0,0,.1);}
.ai-nav-arrow-{{ ai_gen_id }}:hover{background:{{ section.settings.button_background }};}
.ai-nav-arrow-{{ ai_gen_id }}:disabled{opacity:.3;cursor:not-allowed;}
.ai-nav-arrow-left-{{ ai_gen_id }}{left:-24px;}
.ai-nav-arrow-right-{{ ai_gen_id }}{right:-24px;}
.ai-empty-state-{{ ai_gen_id }}{text-align:center;padding:40px;color:#999;}

@media(max-width:989px){
  .ai-collection-showcase-grid-{{ ai_gen_id }}{grid-template-columns:repeat(2,1fr);}
}

@media(max-width:768px){
  .ai-sticky-sidebar-{{ ai_gen_id }}{display:none;}
  .ai-nav-arrow-left-{{ ai_gen_id }}{left:-12px;}
  .ai-nav-arrow-right-{{ ai_gen_id }}{right:-12px;}
}

@media(max-width:480px){
  .ai-collection-showcase-grid-{{ ai_gen_id }}{grid-template-columns:1fr;}
}
{% if section.settings.shelf_layout %}
/* ---------- Carousel layout ----------
   Borderless cards (rounded image tile + text), arrows outside the row on the
   image's centre line, dots underneath for position. Swipe-only on phones. */
.ai-shelf-{{ ai_gen_id }}{--gap:24px;--cols:4;--arrow:44px;--accent:{{ section.settings.cart_btn_border_color }};--ink:#1d1d1d;--muted:#6b6b6b;--star:#f5a524;padding:64px 24px;}
.ai-shelf-{{ ai_gen_id }} .ai-shelf-head-{{ ai_gen_id }}{text-align:center;margin:0 auto 36px;max-width:640px;}
.ai-shelf-{{ ai_gen_id }} .ai-collection-showcase-heading-{{ ai_gen_id }}{font-size:clamp(24px,2.6vw,36px);line-height:1.2;letter-spacing:-.01em;margin:0 0 8px;color:var(--ink);}
.ai-shelf-{{ ai_gen_id }} .ai-collection-showcase-description-{{ ai_gen_id }}{font-size:16px;line-height:1.5;color:var(--muted);}

/* Room for the arrows beside the row */
.ai-shelf-{{ ai_gen_id }} .ai-products-section-{{ ai_gen_id }}{padding:0 calc(var(--arrow) + 20px);}
.ai-shelf-{{ ai_gen_id }} .ai-nav-arrow-{{ ai_gen_id }}{top:var(--img-mid,38%);width:var(--arrow);height:var(--arrow);background:#fff;border:1px solid rgba(0,0,0,.1);box-shadow:0 6px 18px rgba(0,0,0,.08);color:var(--ink);transition:background .2s,color .2s,border-color .2s,opacity .2s;}
.ai-shelf-{{ ai_gen_id }} .ai-nav-arrow-left-{{ ai_gen_id }}{left:0;}
.ai-shelf-{{ ai_gen_id }} .ai-nav-arrow-right-{{ ai_gen_id }}{right:0;}
.ai-shelf-{{ ai_gen_id }} .ai-nav-arrow-{{ ai_gen_id }}:hover:not(:disabled){background:var(--accent);border-color:var(--accent);color:#fff;}
.ai-shelf-{{ ai_gen_id }} .ai-nav-arrow-{{ ai_gen_id }}[hidden]{display:none;}
.ai-shelf-{{ ai_gen_id }} .ai-nav-arrow-{{ ai_gen_id }}:disabled{opacity:.35;box-shadow:none;}
.ai-shelf-{{ ai_gen_id }} .ai-nav-arrow-{{ ai_gen_id }} svg{width:20px;height:20px;}
.ai-shelf-{{ ai_gen_id }} :is(.ai-nav-arrow-{{ ai_gen_id }},.ai-add-to-cart-btn-{{ ai_gen_id }},.ai-shelf-dot-{{ ai_gen_id }},.ai-product-card-link-{{ ai_gen_id }}):focus-visible{outline:2px solid var(--accent);outline-offset:3px;}

.ai-shelf-{{ ai_gen_id }} .ai-collection-showcase-scroll-{{ ai_gen_id }}{gap:var(--gap);scroll-snap-type:x mandatory;overscroll-behavior-x:contain;}
.ai-shelf-{{ ai_gen_id }} .ai-collection-showcase-scroll-{{ ai_gen_id }} .ai-product-card-{{ ai_gen_id }}{flex:0 0 calc((100% - (var(--cols) - 1) * var(--gap)) / var(--cols));min-width:0;max-width:none;scroll-snap-align:start;}

/* Card: no box, the image tile carries the shape */
.ai-shelf-{{ ai_gen_id }} .ai-product-card-{{ ai_gen_id }},.ai-shelf-{{ ai_gen_id }} .ai-product-card-{{ ai_gen_id }}:hover{background:transparent;box-shadow:none;border:0;border-radius:0;transform:none;overflow:visible;}
.ai-shelf-{{ ai_gen_id }} .ai-product-image-wrapper-{{ ai_gen_id }}{border-radius:18px;background:#f4f1f3;}
.ai-shelf-{{ ai_gen_id }} .ai-product-image-{{ ai_gen_id }}{transition:transform .5s cubic-bezier(.2,.7,.2,1);}
.ai-shelf-{{ ai_gen_id }} .ai-product-card-{{ ai_gen_id }}:hover .ai-product-image-{{ ai_gen_id }}{transform:scale(1.04);}
.ai-shelf-{{ ai_gen_id }} .ai-pinned-badge-{{ ai_gen_id }}{top:16px;left:0;border-radius:0 6px 6px 0;padding:6px 12px;font-size:12px;font-weight:700;}
.ai-shelf-{{ ai_gen_id }} .ai-sale-badge-{{ ai_gen_id }}{top:12px;right:12px;padding:4px 10px;border-radius:999px;font-size:12px;font-weight:700;}

.ai-shelf-{{ ai_gen_id }} .ai-product-info-{{ ai_gen_id }}{padding:16px 2px 0;}
.ai-shelf-{{ ai_gen_id }} .ai-product-title-{{ ai_gen_id }}{font-size:16px;font-weight:600;line-height:1.35;color:var(--ink);margin:0 0 6px;min-height:2.7em;}
.ai-shelf-{{ ai_gen_id }} .ai-shelf-rating-{{ ai_gen_id }}{min-height:18px;display:flex;align-items:center;gap:6px;margin:0 0 8px;font-size:13px;color:var(--muted);}
.ai-shelf-{{ ai_gen_id }} .ai-shelf-stars-{{ ai_gen_id }}{position:relative;display:inline-block;font-size:14px;letter-spacing:2px;line-height:1;color:rgba(0,0,0,.15);}
.ai-shelf-{{ ai_gen_id }} .ai-shelf-stars-{{ ai_gen_id }}::before{content:"\2605\2605\2605\2605\2605";}
.ai-shelf-{{ ai_gen_id }} .ai-shelf-stars-{{ ai_gen_id }} span{position:absolute;inset:0 auto 0 0;width:var(--pct);overflow:hidden;white-space:nowrap;color:var(--star);}
.ai-shelf-{{ ai_gen_id }} .ai-shelf-stars-{{ ai_gen_id }} span::before{content:"\2605\2605\2605\2605\2605";}
.ai-shelf-{{ ai_gen_id }} .ai-shelf-desc-{{ ai_gen_id }}{font-size:14px;line-height:1.5;color:var(--muted);margin:0 0 12px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:3em;}
.ai-shelf-{{ ai_gen_id }} .ai-product-price-{{ ai_gen_id }}{flex-wrap:wrap;gap:2px 10px;margin:auto 0 0;align-items:baseline;}
.ai-shelf-{{ ai_gen_id }} :is(.ai-price-sale-{{ ai_gen_id }},.ai-price-regular-{{ ai_gen_id }}){font-size:18px;font-weight:700;color:var(--ink);}
.ai-shelf-{{ ai_gen_id }} .ai-price-compare-{{ ai_gen_id }}{font-size:14px;order:2;}

.ai-shelf-{{ ai_gen_id }} .ai-product-actions-{{ ai_gen_id }}{padding:14px 2px 0;}
.ai-shelf-{{ ai_gen_id }} .ai-add-to-cart-btn-{{ ai_gen_id }}{background:var(--accent);color:#fff;border:0;padding:12px 16px;font-size:14px;font-weight:600;letter-spacing:.01em;transition:filter .2s;}
.ai-shelf-{{ ai_gen_id }} .ai-add-to-cart-btn-{{ ai_gen_id }}:hover{background:var(--accent);color:#fff;filter:brightness(.92);}
.ai-shelf-{{ ai_gen_id }} .ai-quantity-selector-{{ ai_gen_id }}{border:1.5px solid var(--accent);padding:8px 16px;}
.ai-shelf-{{ ai_gen_id }} .ai-quantity-btn-{{ ai_gen_id }}{color:var(--accent);font-size:20px;}

/* Dots: one per "page" of the row */
.ai-shelf-{{ ai_gen_id }} .ai-shelf-dots-{{ ai_gen_id }}{display:flex;justify-content:center;gap:2px;margin-top:32px;}
.ai-shelf-{{ ai_gen_id }} .ai-shelf-dots-{{ ai_gen_id }}[hidden]{display:none;}
.ai-shelf-{{ ai_gen_id }} .ai-shelf-dot-{{ ai_gen_id }}{width:24px;height:24px;padding:0;border:0;background:none;cursor:pointer;display:grid;place-items:center;border-radius:12px;}
.ai-shelf-{{ ai_gen_id }} .ai-shelf-dot-{{ ai_gen_id }}::before{content:"";width:8px;height:8px;border-radius:8px;background:rgba(0,0,0,.18);transition:width .25s,background .25s;}
.ai-shelf-{{ ai_gen_id }} .ai-shelf-dot-{{ ai_gen_id }}[aria-current="true"]{width:36px;}
.ai-shelf-{{ ai_gen_id }} .ai-shelf-dot-{{ ai_gen_id }}[aria-current="true"]::before{width:24px;background:var(--accent);}

/* Intro panel: the section's sidebar title/paragraph/View all, beside the row
   on laptop and above it on phone. Stays put (no collapse) so cards don't resize. */
.ai-shelf-{{ ai_gen_id }} .ai-collection-showcase-wrapper-{{ ai_gen_id }}{gap:32px;align-items:stretch;}
.ai-shelf-{{ ai_gen_id }} .ai-sticky-sidebar-{{ ai_gen_id }},.ai-shelf-{{ ai_gen_id }} .ai-sticky-sidebar-{{ ai_gen_id }}.shrinking{position:static;display:flex;width:300px;opacity:1;margin-right:0;pointer-events:auto;border-radius:18px;transition:none;}
.ai-shelf-{{ ai_gen_id }} .ai-sticky-sidebar-content-{{ ai_gen_id }}{width:auto;white-space:normal;padding:32px 28px;display:flex;flex-direction:column;}
.ai-shelf-{{ ai_gen_id }} .ai-sticky-sidebar-title-{{ ai_gen_id }}{font-size:21px;font-weight:700;line-height:1.3;letter-spacing:-.005em;margin:0 0 14px;}
.ai-shelf-{{ ai_gen_id }} .ai-sticky-sidebar-paragraph-{{ ai_gen_id }}{font-size:15px;line-height:1.65;margin:0 0 28px;}
.ai-shelf-{{ ai_gen_id }} .ai-view-all-btn-{{ ai_gen_id }}{margin-top:auto;border-radius:999px;padding:12px 20px;font-size:14px;}
.ai-shelf-intro-{{ ai_gen_id }} .ai-products-section-{{ ai_gen_id }}{--cols:3;}

@media(max-width:1100px){
  .ai-shelf-{{ ai_gen_id }}{--cols:3;--gap:20px;}
  .ai-shelf-intro-{{ ai_gen_id }} .ai-products-section-{{ ai_gen_id }}{--cols:2;}
  .ai-shelf-{{ ai_gen_id }} .ai-sticky-sidebar-{{ ai_gen_id }},.ai-shelf-{{ ai_gen_id }} .ai-sticky-sidebar-{{ ai_gen_id }}.shrinking{width:260px;}
  .ai-shelf-{{ ai_gen_id }} .ai-sticky-sidebar-content-{{ ai_gen_id }}{padding:24px 22px;}
}
@media(max-width:768px){
  .ai-shelf-{{ ai_gen_id }}{--cols:2.2;--gap:14px;padding:40px 16px;}
  .ai-shelf-{{ ai_gen_id }} .ai-shelf-head-{{ ai_gen_id }}{margin-bottom:22px;}
  .ai-shelf-{{ ai_gen_id }} .ai-collection-showcase-description-{{ ai_gen_id }}{font-size:14px;}
  .ai-shelf-{{ ai_gen_id }} .ai-products-section-{{ ai_gen_id }}{padding:0;}
  .ai-shelf-{{ ai_gen_id }} .ai-nav-arrow-{{ ai_gen_id }}{display:none;}
  /* Row runs to the screen edges so the peeking card reads as "swipe". */
  .ai-shelf-{{ ai_gen_id }} .ai-collection-showcase-scroll-{{ ai_gen_id }}{margin:0 -16px;padding:0 16px;scroll-padding:0 16px;}
  .ai-shelf-{{ ai_gen_id }} .ai-product-image-wrapper-{{ ai_gen_id }}{border-radius:14px;}
  .ai-shelf-{{ ai_gen_id }} .ai-pinned-badge-{{ ai_gen_id }}{top:10px;padding:4px 8px;font-size:11px;}
  .ai-shelf-{{ ai_gen_id }} .ai-sale-badge-{{ ai_gen_id }}{top:8px;right:8px;padding:3px 8px;font-size:11px;}
  .ai-shelf-{{ ai_gen_id }} .ai-product-info-{{ ai_gen_id }}{padding-top:12px;}
  .ai-shelf-{{ ai_gen_id }} .ai-product-title-{{ ai_gen_id }}{font-size:14px;}
  .ai-shelf-{{ ai_gen_id }} .ai-shelf-rating-{{ ai_gen_id }}{font-size:12px;margin-bottom:6px;}
  .ai-shelf-{{ ai_gen_id }} .ai-shelf-stars-{{ ai_gen_id }}{font-size:12px;letter-spacing:1px;}
  .ai-shelf-{{ ai_gen_id }} .ai-shelf-desc-{{ ai_gen_id }}{font-size:12.5px;margin-bottom:10px;}
  .ai-shelf-{{ ai_gen_id }} :is(.ai-price-sale-{{ ai_gen_id }},.ai-price-regular-{{ ai_gen_id }}){font-size:16px;}
  .ai-shelf-{{ ai_gen_id }} .ai-price-compare-{{ ai_gen_id }}{font-size:12px;}
  .ai-shelf-{{ ai_gen_id }} .ai-product-actions-{{ ai_gen_id }}{padding-top:10px;}
  .ai-shelf-{{ ai_gen_id }} .ai-add-to-cart-btn-{{ ai_gen_id }}{padding:10px 8px;font-size:13px;}
  .ai-shelf-{{ ai_gen_id }} .ai-quantity-selector-{{ ai_gen_id }}{padding:6px 10px;}
  .ai-shelf-{{ ai_gen_id }} .ai-shelf-dots-{{ ai_gen_id }}{margin-top:22px;}
  .ai-shelf-intro-{{ ai_gen_id }} .ai-products-section-{{ ai_gen_id }}{--cols:2.2;}
  .ai-shelf-{{ ai_gen_id }} .ai-collection-showcase-wrapper-{{ ai_gen_id }}{flex-direction:column;gap:20px;}
  .ai-shelf-{{ ai_gen_id }} .ai-sticky-sidebar-{{ ai_gen_id }},.ai-shelf-{{ ai_gen_id }} .ai-sticky-sidebar-{{ ai_gen_id }}.shrinking{display:flex;width:100%;border-radius:14px;}
  .ai-shelf-{{ ai_gen_id }} .ai-sticky-sidebar-content-{{ ai_gen_id }}{padding:18px 18px 20px;}
  .ai-shelf-{{ ai_gen_id }} .ai-sticky-sidebar-title-{{ ai_gen_id }}{font-size:17px;margin-bottom:8px;}
  .ai-shelf-{{ ai_gen_id }} .ai-sticky-sidebar-paragraph-{{ ai_gen_id }}{font-size:14px;line-height:1.55;margin-bottom:14px;}
  .ai-shelf-{{ ai_gen_id }} .ai-view-all-btn-{{ ai_gen_id }}{align-self:flex-start;width:auto;padding:9px 18px;font-size:13px;}
}
@media(max-width:360px){.ai-shelf-{{ ai_gen_id }},.ai-shelf-intro-{{ ai_gen_id }} .ai-products-section-{{ ai_gen_id }}{--cols:1.7;}}
@media(prefers-reduced-motion:reduce){
  .ai-shelf-{{ ai_gen_id }} .ai-collection-showcase-scroll-{{ ai_gen_id }}{scroll-behavior:auto;}
  .ai-shelf-{{ ai_gen_id }} .ai-product-image-{{ ai_gen_id }},.ai-shelf-{{ ai_gen_id }} .ai-shelf-dot-{{ ai_gen_id }}::before{transition:none;}
}
{% endif %}
{% endstyle %}

{%- assign shelf = false -%}
{%- if section.settings.shelf_layout and section.settings.layout_mode == 'scroll' -%}{%- assign shelf = true -%}{%- endif -%}
{%- assign has_intro = false -%}
{%- if shelf and section.settings.show_sidebar and section.settings.sidebar_title != blank -%}{%- assign has_intro = true -%}{%- endif -%}

{%- assign scroll_anchor_id = section.settings.anchor_id | strip | downcase | replace: ' ', '-' -%}
{%- if scroll_anchor_id == blank -%}
  {%- assign scroll_anchor_id = ai_gen_id -%}
{%- endif -%}

<product-collection-showcase-{{ ai_gen_id }}
  id="{{ scroll_anchor_id }}"
  class="ai-collection-showcase-{{ ai_gen_id }}{% if shelf %} ai-shelf-{{ ai_gen_id }}{% endif %}{% if has_intro %} ai-shelf-intro-{{ ai_gen_id }}{% endif %}"
  {{ section.shopify_attributes }}
>
  <div class="ai-collection-showcase-container-{{ ai_gen_id }}">

    {% if shelf %}
      <div class="ai-shelf-head-{{ ai_gen_id }}">
        <div>
          {% if section.settings.heading != blank %}
            <h2 class="ai-collection-showcase-heading-{{ ai_gen_id }}">{{ section.settings.heading }}</h2>
          {% endif %}
          {% if section.settings.description != blank %}
            <p class="ai-collection-showcase-description-{{ ai_gen_id }}">{{ section.settings.description }}</p>
          {% endif %}
        </div>
      </div>
    {% elsif section.settings.heading != blank or section.settings.description != blank %}
      <div class="ai-collection-showcase-header-{{ ai_gen_id }}">
        {% if section.settings.heading != blank %}
          <h2 class="ai-collection-showcase-heading-{{ ai_gen_id }}">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.description != blank %}
          <p class="ai-collection-showcase-description-{{ ai_gen_id }}">{{ section.settings.description }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if section.settings.collection != blank %}
      <div class="ai-collection-showcase-wrapper-{{ ai_gen_id }}" data-wrapper>

        {% if section.settings.show_sidebar and section.settings.sidebar_title != blank %}
          <div class="ai-sticky-sidebar-{{ ai_gen_id }}" data-sticky-sidebar>
            <div class="ai-sticky-sidebar-content-{{ ai_gen_id }}">
              <h3 class="ai-sticky-sidebar-title-{{ ai_gen_id }}">{{ section.settings.sidebar_title }}</h3>
              {% if section.settings.sidebar_paragraph != blank %}
                <p class="ai-sticky-sidebar-paragraph-{{ ai_gen_id }}">{{ section.settings.sidebar_paragraph }}</p>
              {% endif %}
              {%- assign view_all_url = section.settings.view_all_url | default: section.settings.collection.url -%}
              {% if view_all_url != blank and section.settings.view_all_text != blank %}
                <a href="{{ view_all_url }}" class="ai-view-all-btn-{{ ai_gen_id }}">
                  {{ section.settings.view_all_text }}
                </a>
              {% endif %}
            </div>
          </div>
        {% endif %}

        <div class="ai-products-section-{{ ai_gen_id }}">

          {% if section.settings.layout_mode == 'scroll' %}
            <button
              type="button"
              class="ai-nav-arrow-{{ ai_gen_id }} ai-nav-arrow-left-{{ ai_gen_id }}"
              aria-label="Previous products"
              data-direction="left"
            >
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
          {% endif %}

          <div class="ai-collection-showcase-{{ section.settings.layout_mode }}-{{ ai_gen_id }}" data-products-container>

            {% assign collection_products = section.settings.collection.all_products %}
            {% assign ordered_products = collection_products %}

            {% if section.settings.pinned_products.size > 0 %}
              {% assign rest_products = collection_products %}
              {% for pinned in section.settings.pinned_products %}
                {% assign rest_products = rest_products | reject: 'handle', pinned.handle %}
              {% endfor %}
              {% assign ordered_products = section.settings.pinned_products | concat: rest_products %}
            {% endif %}

            {% assign products_to_show = section.settings.products_count | at_most: ordered_products.size %}

            {% for product in ordered_products limit: products_to_show %}
              {% assign is_pinned = false %}
              {% if forloop.index0 < section.settings.pinned_products.size %}
                {% assign is_pinned = true %}
              {% endif %}

              <div class="ai-product-card-{{ ai_gen_id }}" data-product-id="{{ product.id }}">
                <a href="{{ product.url }}" class="ai-product-card-link-{{ ai_gen_id }}">
                  <div class="ai-product-image-wrapper-{{ ai_gen_id }}">
                    {% if product.featured_image %}
                      <img
                        src="{{ product.featured_image | image_url: width: 600 }}"
                        srcset="{{ product.featured_image | image_url: width: 300 }} 300w, {{ product.featured_image | image_url: width: 600 }} 600w, {{ product.featured_image | image_url: width: 900 }} 900w"
                        sizes="(max-width: 768px) 45vw, 280px"
                        alt="{{ product.featured_image.alt | escape }}"
                        loading="lazy"
                        width="600"
                        height="600"
                        class="ai-product-image-{{ ai_gen_id }}"
                      >
                    {% else %}
                      <div class="ai-product-placeholder-{{ ai_gen_id }}">
                        {{ 'product-1' | placeholder_svg_tag }}
                      </div>
                    {% endif %}

                    {% if is_pinned and section.settings.show_pinned_badge and section.settings.pinned_badge_text != blank %}
                      <div class="ai-pinned-badge-{{ ai_gen_id }}">{{ section.settings.pinned_badge_text }}</div>
                    {% endif %}

                    {% if section.settings.show_sale_badge and product.compare_at_price > product.price %}
                      {%- assign discount = product.compare_at_price | minus: product.price -%}
                      <div class="ai-sale-badge-{{ ai_gen_id }}">
                        {%- if section.settings.badge_format == 'percentage' -%}
                          {%- assign discount_percent = discount | times: 100.0 | divided_by: product.compare_at_price | round -%}
                          -{{ discount_percent }}%
                        {%- else -%}
                          -{{ discount | money }}
                        {%- endif -%}
                      </div>
                    {% endif %}
                  </div>

                  <div class="ai-product-info-{{ ai_gen_id }}">
                    <h3 class="ai-product-title-{{ ai_gen_id }}">{{ product.title }}</h3>
                    {% if shelf %}
                      {%- assign rating = product.metafields.reviews.rating.value -%}
                      {% if section.settings.show_rating %}
                        {%- assign rating_pct = rating.rating | times: 100.0 | divided_by: rating.scale_max -%}
                        <div class="ai-shelf-rating-{{ ai_gen_id }}">
                          {% if rating != blank %}
                          <span class="ai-shelf-stars-{{ ai_gen_id }}" style="--pct: {{ rating_pct }}%" role="img" aria-label="Rated {{ rating.rating | round: 1 }} out of {{ rating.scale_max }}"><span></span></span>
                          {% if product.metafields.reviews.rating_count %}<span>({{ product.metafields.reviews.rating_count }})</span>{% endif %}
                          {% endif %}
                        </div>
                      {% endif %}
                      {% if section.settings.show_description and product.description != blank %}
                        <p class="ai-shelf-desc-{{ ai_gen_id }}">{%- assign desc = product.description | strip_html | strip_newlines -%}{%- if desc contains '[description]' -%}{%- assign desc = desc | split: '[description]' | last -%}{%- endif -%}{{ desc | split: '[' | first | strip | truncatewords: 18 }}</p>
                      {% endif %}
                    {% endif %}
                    <div class="ai-product-price-{{ ai_gen_id }}">
                      {% if product.compare_at_price > product.price %}
                        <span class="ai-price-compare-{{ ai_gen_id }}">{{ product.compare_at_price | money }}</span>
                        <span class="ai-price-sale-{{ ai_gen_id }}">{{ product.price | money }}</span>
                      {% else %}
                        <span class="ai-price-regular-{{ ai_gen_id }}">{{ product.price | money }}</span>
                      {% endif %}
                    </div>
                  </div>
                </a>

                <div class="ai-product-actions-{{ ai_gen_id }}">
                  <button
                    type="button"
                    class="ai-add-to-cart-btn-{{ ai_gen_id }}"
                    data-variant-id="{{ product.variants.first.id }}"
                    {% unless product.available %}disabled{% endunless %}
                    data-product-card
                  >
                    {% if product.available %}{{ section.settings.button_text }}{% else %}Out of Stock{% endif %}
                  </button>

                  <div class="ai-quantity-selector-{{ ai_gen_id }}" data-quantity-selector>
                    <button type="button" class="ai-quantity-btn-{{ ai_gen_id }}" data-quantity-decrease aria-label="Decrease quantity">−</button>
                    <span class="ai-quantity-display-{{ ai_gen_id }}" data-quantity-display>1</span>
                    <button type="button" class="ai-quantity-btn-{{ ai_gen_id }}" data-quantity-increase aria-label="Increase quantity">+</button>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>

          {% if shelf %}
            <div class="ai-shelf-dots-{{ ai_gen_id }}" data-shelf-dots hidden></div>
          {% endif %}

          {% if section.settings.layout_mode == 'scroll' %}
            <button
              type="button"
              class="ai-nav-arrow-{{ ai_gen_id }} ai-nav-arrow-right-{{ ai_gen_id }}"
              aria-label="Next products"
              data-direction="right"
            >
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          {% endif %}

        </div>
      </div>

    {% else %}
      <div class="ai-empty-state-{{ ai_gen_id }}">
        <p>Please select a collection to display products.</p>
      </div>
    {% endif %}

  </div>
</product-collection-showcase-{{ ai_gen_id }}>

<script>
(function() {
  class ProductCollectionShowcase{{ ai_gen_id }} extends HTMLElement {
    constructor() {
      super();
      this.cartQuantities = {};
      this.pendingRequests = new Set();
      this.debounceTimers = {};
      this.buttonTexts = new Map();
      this._scrollTicking = false;
    }

    connectedCallback() {
      this.container  = this.querySelector('[data-products-container]');
      this.cards      = this.querySelectorAll('[data-product-card]');
      this.leftArrow  = this.querySelector('[data-direction="left"]');
      this.rightArrow = this.querySelector('[data-direction="right"]');
      this.sidebar    = this.querySelector('[data-sticky-sidebar]');
      this.dots       = this.querySelector('[data-shelf-dots]');
      if (this.dots) window.addEventListener('resize', () => this.handleScroll(), { passive: true });

      this.cards.forEach(btn => {
        this.buttonTexts.set(btn.dataset.variantId, btn.textContent.trim());
      });

      this.setupEventListeners();
      this.syncCartQuantities();

      if (this.leftArrow && this.rightArrow) {
        this.updateArrowStates();
      }

      this.handleHashScroll();
    }

    handleHashScroll() {
      if (window.location.hash && window.location.hash === '#' + this.id) {
        setTimeout(() => {
          this.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 100);
      }
    }

    setupEventListeners() {
      this.cards.forEach(btn => {
        btn.addEventListener('click', e => {
          e.preventDefault();
          e.stopPropagation();
          this.handleAddToCart(btn);
        });
      });

      this.querySelectorAll('[data-quantity-increase]').forEach(btn => {
        btn.addEventListener('click', e => {
          e.preventDefault();
          e.stopPropagation();
          this.handleQuantityChange(btn, 1);
        });
      });

      this.querySelectorAll('[data-quantity-decrease]').forEach(btn => {
        btn.addEventListener('click', e => {
          e.preventDefault();
          e.stopPropagation();
          this.handleQuantityChange(btn, -1);
        });
      });

      if (this.leftArrow) {
        this.leftArrow.addEventListener('click', () => this.scroll('left'));
      }
      if (this.rightArrow) {
        this.rightArrow.addEventListener('click', () => this.scroll('right'));
      }

      if (this.container) {
        const isScrollLayout = this.container.classList.contains('ai-collection-showcase-scroll-{{ ai_gen_id }}');
        if (isScrollLayout) {
          this.container.addEventListener('scroll', () => {
            if (!this._scrollTicking) {
              requestAnimationFrame(() => {
                this.handleScroll();
                this._scrollTicking = false;
              });
              this._scrollTicking = true;
            }
          }, { passive: true });

          this.handleScroll();
        }
      }
    }

    handleScroll() {
      if (!this.container) return;

      const scrollLeft = this.container.scrollLeft;

      if (this.sidebar) {
        const sidebarWidth = this.sidebar.offsetWidth || 350;

        if (scrollLeft <= 0) {
          this.sidebar.classList.remove('shrinking');
        } else if (scrollLeft >= sidebarWidth) {
          this.sidebar.classList.add('shrinking');
        } else {
          this.sidebar.classList.remove('shrinking');
        }
      }

      this.updateArrowStates();
      this.updateProgress();
    }

    updateProgress() {
      if (!this.dots || !this.container) return;
      const { scrollLeft, scrollWidth, clientWidth } = this.container;
      const max = scrollWidth - clientWidth;

      // Line the side arrows up with the middle of the product images.
      const img = this.container.querySelector('.ai-product-image-wrapper-{{ ai_gen_id }}');
      const section = this.querySelector('.ai-products-section-{{ ai_gen_id }}');
      if (img && section) this.style.setProperty('--img-mid', (img.getBoundingClientRect().top - section.getBoundingClientRect().top + img.offsetHeight / 2) + 'px');

      const scrollable = max > 1;
      this.dots.hidden = !scrollable;
      if (this.leftArrow)  this.leftArrow.hidden  = !scrollable;
      if (this.rightArrow) this.rightArrow.hidden = !scrollable;
      if (!scrollable) return;

      const pages = Math.max(2, Math.ceil(scrollWidth / clientWidth - 0.05));
      if (this.dots.children.length !== pages) {
        this.dots.innerHTML = '';
        for (let i = 0; i < pages; i++) {
          const dot = document.createElement('button');
          dot.type = 'button';
          dot.className = 'ai-shelf-dot-{{ ai_gen_id }}';
          dot.setAttribute('aria-label', 'Show products, page ' + (i + 1) + ' of ' + pages);
          dot.addEventListener('click', () => {
            const { scrollWidth: sw, clientWidth: cw } = this.container;
            this.container.scrollTo({ left: (sw - cw) * i / (pages - 1), behavior: 'smooth' });
          });
          this.dots.appendChild(dot);
        }
      }
      const current = Math.round((scrollLeft / max) * (pages - 1));
      [...this.dots.children].forEach((d, i) => d.setAttribute('aria-current', i === current ? 'true' : 'false'));
    }

    async syncCartQuantities() {
      try {
        const response = await fetch('/cart.js');
        const cart     = await response.json();
        cart.items.forEach(item => {
          this.cartQuantities[String(item.variant_id)] = item.quantity;
        });
        this.updateAllQuantityDisplays();
      } catch (error) {
        console.error('Error syncing cart:', error);
      }
    }

    updateAllQuantityDisplays() {
      this.cards.forEach(button => {
        const variantId        = String(button.dataset.variantId);
        const quantity         = this.cartQuantities[variantId] || 0;
        const card             = button.closest('.ai-product-card-{{ ai_gen_id }}');
        const quantitySelector = card.querySelector('[data-quantity-selector]');
        const quantityDisplay  = card.querySelector('[data-quantity-display]');

        if (quantity > 0) {
          button.style.display = 'none';
          quantitySelector.classList.add('active');
          quantityDisplay.textContent = quantity;
        } else {
          button.style.display = 'block';
          quantitySelector.classList.remove('active');
          const originalText = this.buttonTexts.get(variantId);
          if (originalText) button.textContent = originalText;
        }
      });
    }

    async handleAddToCart(button) {
      if (button.disabled) return;

      const variantId    = button.dataset.variantId;
      const originalText = this.buttonTexts.get(variantId);

      button.disabled    = true;
      button.textContent = 'Adding...';

      try {
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: variantId, quantity: 1 })
        });

        if (!response.ok) throw new Error('Failed to add to cart');

        this.cartQuantities[String(variantId)] = 1;

        const card             = button.closest('.ai-product-card-{{ ai_gen_id }}');
        const quantitySelector = card.querySelector('[data-quantity-selector]');
        const quantityDisplay  = card.querySelector('[data-quantity-display]');

        button.style.display = 'none';
        quantitySelector.classList.add('active');
        quantityDisplay.textContent = '1';

        if (originalText) button.textContent = originalText;

        this.updateCartBadge();

      } catch (error) {
        console.error('Error adding to cart:', error);
        alert('Failed to add product to cart. Please try again.');
        if (originalText) button.textContent = originalText;
      } finally {
        button.disabled = false;
      }
    }

    handleQuantityChange(btn, change) {
      if (btn.disabled) return;

      const card             = btn.closest('.ai-product-card-{{ ai_gen_id }}');
      const addButton        = card.querySelector('[data-product-card]');
      const variantId        = String(addButton.dataset.variantId);
      const currentQuantity  = this.cartQuantities[variantId] || 0;
      const newQuantity      = Math.max(0, currentQuantity + change);

      const quantityDisplay  = card.querySelector('[data-quantity-display]');
      quantityDisplay.textContent    = newQuantity;
      this.cartQuantities[variantId] = newQuantity;

      if (newQuantity === 0) {
        const quantitySelector = card.querySelector('[data-quantity-selector]');
        addButton.style.display = 'block';
        quantitySelector.classList.remove('active');
        const originalText = this.buttonTexts.get(variantId);
        if (originalText) addButton.textContent = originalText;
      }

      if (this.debounceTimers[variantId]) {
        clearTimeout(this.debounceTimers[variantId]);
      }
      this.debounceTimers[variantId] = setTimeout(() => {
        this.updateCartQuantity(variantId, newQuantity, card);
      }, 300);
    }

    async updateCartQuantity(variantId, quantity, card) {
      const requestKey = `${variantId}-${quantity}`;
      if (this.pendingRequests.has(requestKey)) return;

      this.pendingRequests.add(requestKey);

      try {
        const response = await fetch('/cart/update.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ updates: { [variantId]: quantity } })
        });

        if (!response.ok) throw new Error('Failed to update cart');

        this.cartQuantities[variantId] = quantity;
        this.updateCartBadge();

      } catch (error) {
        console.error('Error updating cart:', error);
        this.syncCartQuantities();
      } finally {
        this.pendingRequests.delete(requestKey);
      }
    }

    async updateCartBadge() {
      let totalItems = 0;

      try {
        const response = await fetch('/cart.js');
        const cart     = await response.json();
        totalItems     = cart.item_count;
      } catch (error) {
        console.error('Error reading cart count:', error);
        totalItems = Object.values(this.cartQuantities).reduce((sum, qty) => sum + qty, 0);
      }

      const bubble = document.querySelector('.cart-count-bubble');
      if (bubble) {
        let countSpan = bubble.querySelector('span[aria-hidden="true"]') || bubble.querySelector('span');
        if (!countSpan) {
          countSpan = document.createElement('span');
          countSpan.setAttribute('aria-hidden', 'true');
          bubble.prepend(countSpan);
        }
        countSpan.textContent = totalItems;
        bubble.classList.toggle('hidden', totalItems === 0);
        bubble.style.display = totalItems === 0 ? 'none' : '';
      }

      const cartIcon = document.querySelector('#cart-icon-bubble');
      if (cartIcon && !cartIcon.querySelector('.cart-count-bubble') && totalItems > 0) {
        const newBubble = document.createElement('div');
        newBubble.className = 'cart-count-bubble';
        newBubble.innerHTML = '<span aria-hidden="true">' + totalItems + '</span>';
        cartIcon.appendChild(newBubble);
      }

      document.querySelectorAll('[data-cart-count]').forEach(el => {
        el.textContent = totalItems;
      });

      document.dispatchEvent(new CustomEvent('cart:updated', {
        bubbles: true,
        detail: { totalItems }
      }));
    }

    scroll(direction) {
      if (!this.container) return;

      const scrollAmount  = this.container.offsetWidth * 0.8;
      const currentScroll = this.container.scrollLeft;
      const newScroll     = direction === 'left'
        ? currentScroll - scrollAmount
        : currentScroll + scrollAmount;

      this.container.scrollTo({ left: newScroll, behavior: 'smooth' });
      setTimeout(() => this.updateArrowStates(), 400);
    }

    updateArrowStates() {
      if (!this.container || !this.leftArrow || !this.rightArrow) return;

      const isAtStart = this.container.scrollLeft <= 10;
      const isAtEnd   = this.container.scrollLeft + this.container.offsetWidth >= this.container.scrollWidth - 10;

      this.leftArrow.disabled  = isAtStart;
      this.rightArrow.disabled = isAtEnd;
    }
  }

  customElements.define(
    'product-collection-showcase-{{ ai_gen_id }}',
    ProductCollectionShowcase{{ ai_gen_id }}
  );
})();
</script>

{% schema %}
{
  "name": "Collection shelf",
  "settings": [
    {
      "type": "header",
      "content": "Scroll target (for links)"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Section ID (anchor)",
      "info": "Give this section a unique id like 'weight-loss-kit'. Link to it from a Buy Now button or any page as /pages/combos#weight-loss-kit. Use lowercase letters, numbers and hyphens only."
    },
    {
      "type": "range",
      "id": "scroll_offset",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 100,
      "label": "Scroll offset",
      "unit": "px",
      "info": "Space left above the section when scrolled to, so it doesn't hide behind a sticky header."
    },
    {
      "type": "header",
      "content": "Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "product_list",
      "id": "pinned_products",
      "label": "Pinned products",
      "limit": 6,
      "info": "These products always show first, in the order you add them here."
    },
    {
      "type": "checkbox",
      "id": "show_pinned_badge",
      "label": "Show badge on pinned products",
      "default": false
    },
    {
      "type": "text",
      "id": "pinned_badge_text",
      "label": "Pinned badge text",
      "default": "Bestseller"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "products_count",
      "min": 1,
      "max": 50,
      "step": 1,
      "label": "Number of products",
      "default": 8
    },
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured products"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Discover our premium collection"
    },
    {
      "type": "header",
      "content": "Sticky sidebar"
    },
    {
      "type": "checkbox",
      "id": "show_sidebar",
      "label": "Show sidebar",
      "default": true,
      "info": "Sidebar smoothly shrinks when scrolling right. Hidden on mobile."
    },
    {
      "type": "text",
      "id": "sidebar_title",
      "label": "Title",
      "default": "Sexual Wellness"
    },
    {
      "type": "textarea",
      "id": "sidebar_paragraph",
      "label": "Paragraph",
      "default": "For stronger erections, better control & peak performance."
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "View all button link"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all button text",
      "default": "View All"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_mode",
      "label": "Layout mode",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "scroll",
          "label": "Horizontal scroll"
        }
      ],
      "default": "scroll",
      "info": "Sidebar animation only works with horizontal scroll"
    },
    {
      "type": "checkbox",
      "id": "shelf_layout",
      "label": "Carousel layout",
      "info": "Horizontal scroll only. 4 cards on laptop, 3 on tablet, 2 with a peek on phone; arrows beside the row and dots underneath.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star rating",
      "info": "Carousel layout. Uses the product's review rating (Judge.me).",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show short description",
      "info": "Carousel layout. First words of the product description, 2 lines.",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_row",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Products per row (grid, desktop)",
      "default": 4,
      "info": "Automatically reduces to 2 columns on tablet and 1 on mobile."
    },
    {
      "type": "text",
