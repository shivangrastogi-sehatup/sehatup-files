{%- comment -%}
  Trust strip + real reviews.

  Four short promises (editable, since each one must be true for the
  business), then an app-block slot for Judge.me's own Featured Carousel,
  so the reviews are the store's real, moderated Judge.me reviews and stay
  in sync by themselves. No review text is ever hardcoded here.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
-%}

{%- comment -%} Styles first, so the browser never paints this section unstyled. {%- endcomment -%}
<style>
  #htr-{{ section.id }} { --htr-text: #1d1d1d; --htr-muted: #5c5c5c; --htr-accent: {{ s.accent_color }}; background: #fff; font-family: 'Montserrat', sans-serif; color: var(--htr-text); }
  #htr-{{ section.id }} .htr__inner { max-width: 1320px; margin: 0 auto; padding: 64px 24px 80px; }
  #htr-{{ section.id }} .htr__head { text-align: center; max-width: 1100px; margin: 0 auto 40px; }
  #htr-{{ section.id }} .htr__heading { color: var(--htr-text); margin: 0 0 12px; font: 800 clamp(30px, 3.6vw, 52px)/1.06 'Montserrat', sans-serif; letter-spacing: -.02em; text-wrap: balance; }
  #htr-{{ section.id }} .htr__sub { margin: 0 auto; max-width: min(620px, 43vw); font: 400 17px/1.6 'Montserrat', sans-serif; color: var(--htr-muted); }

  #htr-{{ section.id }} .htr__strip {
    list-style: none; margin: 0 0 48px; padding: 24px 28px; border-radius: 22px; background: #faf7f5;
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px;
  }
  #htr-{{ section.id }} .htr__item { display: flex; align-items: center; gap: 14px; }
  #htr-{{ section.id }} .htr__icon { flex: none; width: 26px; height: 26px; color: var(--htr-accent); }
  #htr-{{ section.id }} .htr__icon svg { width: 100%; height: 100%; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  #htr-{{ section.id }} .htr__txt { display: grid; gap: 3px; }
  #htr-{{ section.id }} .htr__txt b { font: 700 16px/1.25 'Montserrat', sans-serif; }
  #htr-{{ section.id }} .htr__txt small { font: 400 13.5px/1.4 'Montserrat', sans-serif; color: var(--htr-muted); }

  #htr-{{ section.id }} .htr__rating {
    display: inline-flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 6px 8px; margin: 18px 0 0; padding: 10px 18px; border-radius: 999px;
    background: #faf7f5; font: 600 15px/1.2 'Montserrat', sans-serif; color: var(--htr-text);
  }
  #htr-{{ section.id }} .htr__rating b { font-weight: 800; }
  #htr-{{ section.id }} .htr__rating span::before { content: "\00B7"; margin-right: 8px; color: var(--htr-muted); }
  #htr-{{ section.id }} .htr__rating[hidden] { display: none; }
  #htr-{{ section.id }} .htr__rating i { font-style: normal; color: #f5a623; letter-spacing: 1px; }
  /* The rating now sits in our header; Judge.me's own title row would repeat it. */
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-title-and-link { display: none !important; }

  /* Judge.me carousel, restyled from the outside. The app sizes each item and
     slides the row with transforms, so item widths are left alone: the card
     look is a ::before inset inside each item, the gutters live in padding. */
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-wrapper { width: auto; margin: 0 -10px; padding: 0; }
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel__item-container,
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel__item-wrapper { height: auto !important; }
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-item {
    position: relative; isolation: isolate; display: inline-flex; flex-direction: column; vertical-align: top;
    height: 284px; padding: 26px 36px 24px; white-space: normal; text-align: left;
  }
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-item::before {
    content: ""; position: absolute; inset: 0 10px; z-index: -1; border-radius: 20px;
    background: #faf7f5; border: 1px solid #efe7e2;
  }
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-item__product-image {
    position: absolute; top: 22px; right: 32px; width: 56px; height: 56px; margin: 0;
    border-radius: 14px; object-fit: cover; background: #fff; font-size: 0; color: transparent; overflow: hidden; box-shadow: 0 4px 12px rgba(60, 30, 20, .08);
  }
  /* Judge.me lazy-loads these from data-src, so only hide an image that has no photo at all. */
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-item__product-image:not([src]):not([data-src]),
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-item__product-image[src=""][data-src=""] { display: none; }
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-item__review-wrapper { display: flex; flex-direction: column; flex: 1; width: 100%; height: auto; padding: 0; min-height: 0; }
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-item__review { height: auto; flex: 1; min-height: 0; overflow: hidden; }
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-item__review-rating { padding-right: 64px; margin-bottom: 14px; }
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-item .jdgm-star { color: #f5a623 !important; font-size: 15px; }
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-item__review-title { padding-right: 64px; margin-bottom: 6px; font: 700 17px/1.35 'Montserrat', sans-serif !important; color: var(--htr-text); }
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-item__review-body,
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-item__review-body p { margin: 0; font: 400 15px/1.55 'Montserrat', sans-serif !important; color: var(--htr-muted); }
  /* Whole lines only: the title stops at 2 lines and the review at 3, each
     ending in "...", so no line is ever cut in half by the card's fixed height. */
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-item__review-title,
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-item__review-body { display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-item__review-title { -webkit-line-clamp: 2; line-clamp: 2; }
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-item__review-body { -webkit-line-clamp: 3; line-clamp: 3; }
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-item__reviewer-name-wrapper {
    display: flex; align-items: baseline; gap: 8px; margin-top: 14px; padding-top: 12px; border-top: 1px solid #ebe3dd; width: auto;
  }
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-item__reviewer-name { flex: none; font: 700 14px/1.3 'Montserrat', sans-serif; color: var(--htr-text); }
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-item__product { flex: 1; min-width: 0; height: auto !important; max-height: none !important; line-height: 1.3; text-decoration: none; }
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-item__product-title { font: 600 13px/1.3 'Montserrat', sans-serif; color: var(--htr-accent); }
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-item__product-title::before { content: "on "; color: var(--htr-muted); font-weight: 500; }
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel-item__timestamp { display: none; }
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel__arrows { margin-top: 24px; display: flex; justify-content: center; align-items: center; gap: 10px; }
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel__left-arrow,
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel__right-arrow {
    width: 44px; height: 44px; margin: 0; border-radius: 50%; border: 1.5px solid #e8e0d9; background-color: #fff;
    background-position: center; transform: none !important; display: grid; place-items: center; cursor: pointer; transition: border-color .2s ease;
  }
  /* Our own chevrons: the app ships its arrows without a visible icon here. */
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel__left-arrow::before,
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel__right-arrow::before {
    content: "" !important; display: block; width: 9px; height: 9px; border: solid var(--htr-text); border-width: 2px 2px 0 0; transform: translateX(-2px) rotate(45deg);
  }
  #htr-{{ section.id }} .htr__reviews .jdgm-carousel__left-arrow::before { transform: translateX(2px) rotate(-135deg); }
  @media (hover: hover) { #htr-{{ section.id }} .htr__reviews .jdgm-carousel__left-arrow:hover, #htr-{{ section.id }} .htr__reviews .jdgm-carousel__right-arrow:hover { border-color: var(--htr-accent); } }

  @media (max-width: 1023.98px) {
    #htr-{{ section.id }} .htr__strip { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 750px) and (max-width: 1099.98px) {
    #htr-{{ section.id }} .htr__heading { font-size: 38px; }
    #htr-{{ section.id }} .htr__sub { font-size: 16px; max-width: min(520px, 50vw); }
  }
  @media (max-width: 749.98px) {
    #htr-{{ section.id }} .htr__inner { padding: 32px 16px 48px; }
    #htr-{{ section.id }} .htr__heading { font-size: 30px; }
    #htr-{{ section.id }} .htr__sub { font-size: 15px; max-width: none; }
    /* No pill: stars and score on one line, the trust line under it. */
    #htr-{{ section.id }} .htr__rating { display: flex; padding: 0; background: none; gap: 4px 8px; margin-top: 16px; font-size: 15px; }
    #htr-{{ section.id }} .htr__rating i { font-size: 16px; }
    #htr-{{ section.id }} .htr__rating span { flex-basis: 100%; font: 500 14px/1.4 'Montserrat', sans-serif; color: var(--htr-muted); }
    #htr-{{ section.id }} .htr__rating span::before { content: none; }
    #htr-{{ section.id }} .htr__strip { padding: 18px 16px; gap: 16px 12px; margin-bottom: 32px; border-radius: 18px; }
    #htr-{{ section.id }} .htr__item { gap: 10px; align-items: flex-start; }
    #htr-{{ section.id }} .htr__icon { width: 22px; height: 22px; }
    #htr-{{ section.id }} .htr__txt b { font-size: 13.5px; }
    #htr-{{ section.id }} .htr__txt small { font-size: 12.5px; }
    #htr-{{ section.id }} .htr__txt b { font-size: 14px; }
  }
  /* Narrow phones: one promise per row, so nothing is squeezed. */
  @media (max-width: 419.98px) {
    #htr-{{ section.id }} .htr__strip { grid-template-columns: minmax(0, 1fr); gap: 14px; padding: 18px; }
    #htr-{{ section.id }} .htr__item { align-items: center; gap: 14px; }
  }

  /* Big screens: scale the whole section in proportion, so 1920-3840px
     monitors get a page sized for them instead of a 1200px island. */
  @media (min-width: 1680px) { #htr-{{ section.id }} .htr__inner { zoom: 1.12; } }
  @media (min-width: 1920px) { #htr-{{ section.id }} .htr__inner { zoom: 1.25; } }
  @media (min-width: 2240px) { #htr-{{ section.id }} .htr__inner { zoom: 1.45; } }
  @media (min-width: 2560px) { #htr-{{ section.id }} .htr__inner { zoom: 1.65; } }
  @media (min-width: 3200px) { #htr-{{ section.id }} .htr__inner { zoom: 2; } }
  @media (min-width: 3840px) { #htr-{{ section.id }} .htr__inner { zoom: 2.4; } }
  /* ...and a little wider at each step, like the doctors and kits rows. */
  @media (min-width: 1920px) { #htr-{{ section.id }} .htr__inner { max-width: 1360px; } }
  @media (min-width: 2560px) { #htr-{{ section.id }} .htr__inner { max-width: 1440px; } }

  /* Phones: title and intro use the full width. */
  @media (max-width: 749.98px) { #htr-{{ section.id }} .htr__head { max-width: none; } }

  /* "Hide the product" option: no product photo or "on Product" line, so the
     card is just stars, title, review and name. */
  #htr-{{ section.id }}.htr--noprod .htr__reviews .jdgm-carousel-item__product-image,
  #htr-{{ section.id }}.htr--noprod .htr__reviews .jdgm-carousel-item__product { display: none !important; }
  #htr-{{ section.id }}.htr--noprod .htr__reviews .jdgm-carousel-item__review-rating,
  #htr-{{ section.id }}.htr--noprod .htr__reviews .jdgm-carousel-item__review-title { padding-right: 0; }

  /* "Rating on the left" layout: a score panel beside the carousel, cards on white. */
  #htr-{{ section.id }} .htr__side-wrap { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: clamp(28px, 4vw - 8px, 56px); align-items: center; }
  #htr-{{ section.id }}.htr--side .htr__inner { padding-top: 48px; padding-bottom: 28px; }
  #htr-{{ section.id }} .htr__side { display: flex; flex-direction: column; gap: 10px; }
  #htr-{{ section.id }} .htr__score { display: flex; align-items: baseline; gap: 6px; margin: 0; }
  #htr-{{ section.id }} .htr__score b { font: 800 44px/1 'Montserrat', sans-serif; letter-spacing: -.03em; color: var(--htr-text); }
  #htr-{{ section.id }} .htr__score span { font: 600 15px/1 'Montserrat', sans-serif; color: var(--htr-muted); }
  #htr-{{ section.id }} .htr__stars { position: relative; display: inline-block; width: max-content; line-height: 0; }
  #htr-{{ section.id }} .htr__stars svg { width: 19px; height: 19px; margin-right: 2px; }
  #htr-{{ section.id }} .htr__stars-base svg { fill: #e8e0d9; }
  #htr-{{ section.id }} .htr__stars-fill { position: absolute; inset: 0 auto 0 0; overflow: hidden; white-space: nowrap; }
  #htr-{{ section.id }} .htr__stars-fill svg { fill: #f5a623; }
  #htr-{{ section.id }} .htr__side-title { margin: 6px 0 0; font: 700 18px/1.35 'Montserrat', sans-serif; color: var(--htr-text); text-wrap: balance; }
  #htr-{{ section.id }} .htr__side-text { margin: 0; font: 400 15.5px/1.6 'Montserrat', sans-serif; color: var(--htr-muted); text-wrap: pretty; }
  #htr-{{ section.id }} .htr__side-note { margin: 4px 0 0; padding-top: 14px; border-top: 1px solid #e8e0d9; font: 600 14.5px/1.4 'Montserrat', sans-serif; color: var(--htr-text); }
  #htr-{{ section.id }} .htr__side-link { align-self: flex-start; margin-top: 2px; font: 700 15px/1.3 'Montserrat', sans-serif; color: var(--htr-accent); text-decoration: underline; text-underline-offset: 4px; }
  #htr-{{ section.id }} .htr__side-link:focus-visible { outline: 2px solid var(--htr-text); outline-offset: 3px; }
  #htr-{{ section.id }}.htr--side .htr__reviews .jdgm-carousel-item { height: 264px; padding: 28px clamp(24px, 2.4vw, 34px) 24px; }
  #htr-{{ section.id }}.htr--side .htr__reviews .jdgm-carousel-item::before { background: #fff; border-color: #e8e0d9; }
  #htr-{{ section.id }}.htr--side .htr__reviews .jdgm-carousel__arrows { justify-content: flex-start; padding-left: 10px; }

  /* "Arrows on the sides": the carousel arrows sit over the left and right edges of the cards. */
  @media (min-width: 750px) {
    #htr-{{ section.id }}.htr--arrows-sides .htr__reviews { position: relative; }
    #htr-{{ section.id }}.htr--arrows-sides .htr__reviews .jdgm-carousel__arrows {
      position: absolute; inset: 0 -12px; z-index: 2; margin: 0 !important; padding: 0 !important;
      display: flex; justify-content: space-between; align-items: center; pointer-events: none;
    }
    #htr-{{ section.id }}.htr--arrows-sides .htr__reviews .jdgm-carousel__left-arrow,
    #htr-{{ section.id }}.htr--arrows-sides .htr__reviews .jdgm-carousel__right-arrow { pointer-events: auto; box-shadow: 0 2px 10px rgba(29, 29, 29, .08); }
  }
  @media (max-width: 989.98px) {
    #htr-{{ section.id }} .htr__side-wrap { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    #htr-{{ section.id }} .htr__side { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: 18px; row-gap: 8px; align-items: center; }
    #htr-{{ section.id }} .htr__side > :not(.htr__score):not(.htr__stars) { grid-column: 1 / -1; }
  }
  @media (max-width: 749.98px) {
    #htr-{{ section.id }}.htr--side .htr__inner { padding: 32px 16px 44px; }
    #htr-{{ section.id }} .htr__score b { font-size: 48px; }
    #htr-{{ section.id }} .htr__stars svg { width: 20px; height: 20px; }
    #htr-{{ section.id }} .htr__side-title { font-size: 19px; }
    #htr-{{ section.id }} .htr__side-text { font-size: 14.5px; }
    #htr-{{ section.id }}.htr--side .htr__reviews .jdgm-carousel-item { height: 256px; padding: 24px 28px 20px; }
    #htr-{{ section.id }}.htr--side .htr__reviews .jdgm-carousel__arrows { justify-content: center; padding-left: 0; }
  }
</style>

{%- liquid
  assign side = false
  if s.layout == 'side'
    assign side = true
  endif
-%}
{%- capture star -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.9 6 6.6.8-4.9 4.5 1.3 6.5L12 17.1l-5.9 3.2 1.3-6.5-4.9-4.5 6.6-.8z"/></svg>{%- endcapture -%}

<section id="htr-{{ section.id }}" class="htr{% if side %} htr--side{% endif %}{% if s.show_product == false %} htr--noprod{% endif %}{% if s.arrows == 'sides' %} htr--arrows-sides{% endif %}">
  <span id="reviews" class="sh-anchor" style="display:block;position:relative;top:-90px;height:0;visibility:hidden" aria-hidden="true"></span>
  <div class="htr__inner">
    {%- unless side or s.heading == blank and s.subheading == blank and s.rating_line == blank -%}
    <div class="htr__head">
      {%- if s.heading != blank -%}<h2 class="htr__heading">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.subheading != blank -%}<p class="htr__sub">{{ s.subheading }}</p>{%- endif -%}
      {%- if s.rating_line != blank -%}<p class="htr__rating" data-rating data-line="{{ s.rating_line | escape }}" hidden></p>{%- endif -%}
    </div>
    {%- endunless -%}

    {%- if s.trust_1 != blank or s.trust_2 != blank or s.trust_3 != blank or s.trust_4 != blank -%}
    <ul class="htr__strip">
      {%- for i in (1..4) -%}
        {%- capture k_t -%}trust_{{ i }}{%- endcapture -%}
        {%- capture k_d -%}trust_{{ i }}_text{%- endcapture -%}
        {%- if s[k_t] != blank -%}
          <li class="htr__item">
            <span class="htr__icon" aria-hidden="true">
              {%- case i -%}
                {%- when 1 -%}<svg viewBox="0 0 24 24"><path d="M20 12v8H4v-8M2 7h20v5H2zM12 22V7M12 7H7.5a2.5 2.5 0 1 1 0-5C11 2 12 7 12 7zM12 7h4.5a2.5 2.5 0 1 0 0-5C13 2 12 7 12 7z"/></svg>
                {%- when 2 -%}<svg viewBox="0 0 24 24"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                {%- when 3 -%}<svg viewBox="0 0 24 24"><path d="M21 8 12 3 3 8v8l9 5 9-5zM3 8l9 5 9-5M12 13v8"/></svg>
                {%- else -%}<svg viewBox="0 0 24 24"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/><path d="M6 10v4M18 10v4"/></svg>
              {%- endcase -%}
            </span>
            <span class="htr__txt"><b>{{ s[k_t] }}</b>{%- if s[k_d] != blank -%}<small>{{ s[k_d] }}</small>{%- endif -%}</span>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
    {%- endif -%}

    {%- if side -%}
    <div class="htr__side-wrap">
      <div class="htr__side">
        {%- if s.side_score != blank -%}
          {%- assign fill = s.side_score | times: 20 | at_most: 100 -%}
          <p class="htr__score"><b>{{ s.side_score }}</b><span>out of 5</span></p>
          <span class="htr__stars" role="img" aria-label="{{ s.side_score }} out of 5 stars">
            <span class="htr__stars-base">{{ star }}{{ star }}{{ star }}{{ star }}{{ star }}</span>
            <span class="htr__stars-fill" style="width: {{ fill }}%">{{ star }}{{ star }}{{ star }}{{ star }}{{ star }}</span>
          </span>
        {%- endif -%}
        {%- if s.side_title != blank -%}<h2 class="htr__side-title">{{ s.side_title }}</h2>{%- endif -%}
        {%- if s.side_text != blank -%}<p class="htr__side-text">{{ s.side_text }}</p>{%- endif -%}
        {%- if s.side_note != blank -%}<p class="htr__side-note">{{ s.side_note }}</p>{%- endif -%}
        {%- if s.side_link_label != blank and s.side_link != blank -%}<a class="htr__side-link" href="{{ s.side_link }}">{{ s.side_link_label }}</a>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="htr__reviews">
      {%- comment -%} Picked products: only their reviews (shared snippet). Otherwise the Judge.me app block. {%- endcomment -%}
      {%- if s.review_products != blank -%}
        {%- render 'sehat-jm-reviews', products: s.review_products, min: s.min_rating, max: 18, uid: section.id, hide: s.review_hide -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- render block -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
    {%- if side -%}</div>{%- endif -%}
  </div>
</section>


<script>
  // Rating line: [rating] and [count] are filled from the Judge.me carousel in
  // this section (store-wide average and count) once it has rendered. Never
  // invented: if a placeholder can't be filled, the line stays hidden.
  (function () {
    var root = document.getElementById('htr-{{ section.id }}');
    if (!root) return;
    var out = root.querySelector('[data-rating]'), tries = 0;
    if (!out) return;
    var line = out.getAttribute('data-line');
    (function look() {
      var r = root.querySelector('.htr__reviews .jdgm-all-reviews-rating[data-score]');
      var c = root.querySelector('.htr__reviews .jdgm-all-reviews-rating-wrapper');
      var score = r && parseFloat(r.getAttribute('data-score'));
      var count = c && (c.textContent.match(/\d+/) || [])[0];
      var needR = line.indexOf('[rating]') > -1, needC = line.indexOf('[count]') > -1;
      if ((!needR || score) && (!needC || count)) {
        var parts = line.replace('[rating]', score ? score.toFixed(1) : '').replace('[count]', count || '').split(' · ');
        out.textContent = '';
        if (needR) out.insertAdjacentHTML('beforeend', '<i aria-hidden="true">★★★★★</i>');
        var b = document.createElement('b'); b.textContent = parts.shift(); out.appendChild(b);
        if (parts.length) { var sp = document.createElement('span'); sp.textContent = parts.join(' · '); out.appendChild(sp); }
        out.hidden = false;
      } else if (++tries < 40) setTimeout(look, 500);
    })();
  })();
</script>

