{%- comment -%}
  "Often bought with this": up to four products Shopify recommends for the
  current product. The list is loaded after the page (Shopify's product
  recommendations need a second request), so the section stays out of the
  way and simply does not appear when there is nothing to recommend.
{%- endcomment -%}

{%- comment -%} Styles first, so the browser never paints this section unstyled. {%- endcomment -%}
<style>
  #srl-{{ section.id }} {
    --srl-text: #1d1d1d; --srl-muted: #5f5f5f; --srl-line: #e5e3e0;
    padding: clamp(40px, 5vw, 64px) clamp(16px, 2vw, 28px) clamp(44px, 5vw, 64px); background: #fff;
    font-family: 'Montserrat', sans-serif; color: var(--srl-text);
  }
  #srl-{{ section.id }}:not(.is-ready) { display: none; }
  #srl-{{ section.id }} * { box-sizing: border-box; }
  #srl-{{ section.id }} .srl__inner { max-width: 1160px; margin: 0 auto; }
  #srl-{{ section.id }} .srl__heading { margin: 0 0 20px; font: 800 clamp(24px, 2.6vw, 34px)/1.15 'Montserrat', sans-serif; letter-spacing: -.02em; }
  #srl-{{ section.id }} .srl__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  #srl-{{ section.id }} .srl__card { display: flex; flex-direction: column; text-decoration: none; color: inherit; background: #fff; border: 1px solid rgba(17, 17, 17, .07); border-radius: 18px; padding: 10px 10px 16px; box-shadow: 0 1px 2px rgba(17, 17, 17, .04); transition: box-shadow .3s ease, border-color .3s ease; }
  #srl-{{ section.id }} .srl__img { border-radius: 12px; overflow: hidden; aspect-ratio: 1; background: #fff; }
  #srl-{{ section.id }} .srl__img img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .5s cubic-bezier(.16, 1, .3, 1); }
  #srl-{{ section.id }} .srl__name { margin: 14px 6px 0; font: 600 15px/1.35 'Montserrat', sans-serif; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  #srl-{{ section.id }} .srl__price { margin: 6px 6px 0; font: 700 15px/1.2 'Montserrat', sans-serif; }
  #srl-{{ section.id }} .srl__price s { margin-left: 6px; font-weight: 400; color: var(--srl-muted); }
  #srl-{{ section.id }} .srl__price em { margin-left: 6px; font-style: normal; font-weight: 700; font-size: 13px; color: #d01d42; }
  @media (hover: hover) and (pointer: fine) {
    #srl-{{ section.id }} .srl__card:hover .srl__img img { transform: scale(1.04); }
    #srl-{{ section.id }} .srl__card:hover { box-shadow: 0 14px 30px -18px rgba(17, 17, 17, .28); border-color: rgba(17, 17, 17, .12); }
    #srl-{{ section.id }} .srl__card:hover .srl__name { text-decoration: underline; text-underline-offset: 3px; }
  }
  #srl-{{ section.id }} .srl__card:focus-visible { outline: 2px solid var(--srl-text); outline-offset: 4px; border-radius: 18px; }
  @media (max-width: 749px) {
    #srl-{{ section.id }} { padding-top: 36px; padding-bottom: 40px; padding-right: 0; }
    #srl-{{ section.id }} .srl__grid { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding-right: 16px; gap: 12px; }
    #srl-{{ section.id }} .srl__grid::-webkit-scrollbar { display: none; }
    #srl-{{ section.id }} .srl__card { flex: 0 0 46%; scroll-snap-align: start; padding: 8px 8px 14px; border-radius: 16px; }
    #srl-{{ section.id }} .srl__name { font-size: 14px; }
  }
  @media (prefers-reduced-motion: reduce) { #srl-{{ section.id }} .srl__img img { transition: none; } }
  @media (min-width: 1680px) { #srl-{{ section.id }} .srl__inner { zoom: 1.12; } }
  @media (min-width: 1920px) { #srl-{{ section.id }} .srl__inner { zoom: 1.25; } }
  @media (min-width: 2560px) { #srl-{{ section.id }} .srl__inner { zoom: 1.65; } }
</style>

{%- comment -%}
  Our own pairings come first: one line per product in "Pairs", "product-handle: handle, handle".
  A product with no line falls back to Shopify's automatic recommendations.
{%- endcomment -%}
{%- liquid
  assign picks = ''
  assign lines = section.settings.pairs | newline_to_br | split: '<br />'
  for l in lines
    assign key = l | split: ':' | first | strip
    if key == product.handle
      assign picks = l | split: ':' | last | remove: ' ' | strip
      break
    endif
  endfor
  assign shown = 0
-%}
{%- capture own_cards -%}
  {%- if picks != blank -%}
    {%- assign hs = picks | split: ',' -%}
    {%- for h in hs -%}
      {%- assign p = all_products[h] -%}
      {%- if p == blank or p.available == false or p.id == product.id -%}{%- continue -%}{%- endif -%}
      {%- if shown >= section.settings.limit -%}{%- break -%}{%- endif -%}
      {%- render 'sehat-related-card', p: p -%}
      {%- assign shown = shown | plus: 1 -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

<section
  id="srl-{{ section.id }}"
  class="srl{% if shown > 0 or recommendations.performed and recommendations.products_count > 0 %} is-ready{% endif %}"{% if shown > 0 %} data-own{% endif %}
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}"
>
  {%- if shown > 0 -%}
    <div class="srl__inner">
      <h2 class="srl__heading">{{ section.settings.heading }}</h2>
      <div class="srl__grid">{{ own_cards }}</div>
    </div>
  {%- elsif recommendations.performed and recommendations.products_count > 0 -%}
    <div class="srl__inner">
      <h2 class="srl__heading">{{ section.settings.heading }}</h2>
      <div class="srl__grid">
        {%- for p in recommendations.products -%}
          {%- render 'sehat-related-card', p: p -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

<script>
  (function () {
    var root = document.getElementById('srl-{{ section.id }}');
    if (!root || root.hasAttribute('data-own') || root.classList.contains('is-ready') || root.dataset.srlBooted === '1') return;
    root.dataset.srlBooted = '1';
    // Load only when the visitor gets near it.
    var load = function () {
      fetch(root.dataset.url).then(function (r) { return r.text(); }).then(function (html) {
        var doc = new DOMParser().parseFromString(html, 'text/html');
        var fresh = doc.getElementById(root.id);
        if (fresh && fresh.querySelector('.srl__card')) { root.innerHTML = fresh.innerHTML; root.classList.add('is-ready'); }
      }).catch(function () {});
    };
    if ('IntersectionObserver' in window) {
      var probe = root.parentElement.previousElementSibling || root.parentElement;
      var io = new IntersectionObserver(function (en) { if (en[0].isIntersecting) { io.disconnect(); load(); } }, { rootMargin: '600px 0px' });
      io.observe(probe);
    } else { load(); }
  })();
</script>

