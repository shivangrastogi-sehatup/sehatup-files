{%- assign s = section.settings -%}
<style>
  #cho-{{ section.id }} { --ink: #1d1d1d; --mute: #5f5a56; --gold: #d99a2b; --maroon: #8f1836; padding: clamp(36px, 4.4vw, 64px) clamp(16px, 3vw, 48px) clamp(26px, 3vw, 40px); background: #fffaf3; border-bottom: 1px solid #efdcb8; font-family: 'Montserrat', sans-serif; color: var(--ink); text-align: center; }
  #cho-{{ section.id }} * { box-sizing: border-box; letter-spacing: normal; }
  #cho-{{ section.id }} .cho__in { max-width: 920px; margin: 0 auto; }
  #cho-{{ section.id }} .cho__h { margin: 0; font: 800 clamp(34px, 4vw, 56px)/1.05 'Montserrat', sans-serif; letter-spacing: -.025em; color: var(--ink); text-wrap: balance; }
  #cho-{{ section.id }} .cho__d { max-width: 38em; margin: 14px auto 0; font: 400 clamp(15px, 1.2vw, 18px)/1.6 'Montserrat', sans-serif; color: var(--mute); text-wrap: pretty; }
  #cho-{{ section.id }} .cho__d p { margin: 0; }
  #cho-{{ section.id }} .cho__offer { display: inline-flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 8px 14px; margin-top: clamp(20px, 2.4vw, 30px); padding: 12px 20px; border-radius: 16px; background: #5c1024; color: #fbe3b0; font: 600 14.5px/1.35 'Montserrat', sans-serif; }
  #cho-{{ section.id }} .cho__ico { flex: none; width: 22px; height: 22px; fill: none; stroke: #f2c46d; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  #cho-{{ section.id }} .cho__code { margin: 0; padding: 5px 12px; border: 1px dashed #f2c46d; border-radius: 999px; background: #f2c46d; color: #5c1024; font: 700 13px/1 'Montserrat', sans-serif; letter-spacing: .08em; cursor: pointer; }
  #cho-{{ section.id }} .cho__code:focus-visible { outline: 2px solid #fbe3b0; outline-offset: 2px; }
  #cho-{{ section.id }} .cho__note { font-weight: 500; font-size: 13px; opacity: .75; }
  #cho-{{ section.id }} .cho__links { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin: clamp(18px, 2.2vw, 26px) 0 0; padding: 0; list-style: none; }
  #cho-{{ section.id }} .cho__links a { display: inline-block; padding: 10px 20px; border: 1.5px solid #e6cf9f; border-radius: 999px; background: #fff; color: var(--ink); font: 700 14px/1 'Montserrat', sans-serif; text-decoration: none; transition: background-color .25s ease, border-color .25s ease, color .25s ease; }
  @media (hover: hover) { #cho-{{ section.id }} .cho__links a:hover { background: var(--ink); border-color: var(--ink); color: #fff; } }
  #cho-{{ section.id }} .cho__links a:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }

  @media (max-width: 749.98px) {
    #cho-{{ section.id }} { padding: 28px 16px 22px; }
    #cho-{{ section.id }} .cho__offer { padding: 12px 14px; font-size: 13.5px; }
    #cho-{{ section.id }} .cho__links { flex-wrap: nowrap; justify-content: flex-start; overflow-x: auto; margin: 16px -16px 0; padding: 2px 16px 6px; scrollbar-width: none; }
    #cho-{{ section.id }} .cho__links::-webkit-scrollbar { display: none; }
    #cho-{{ section.id }} .cho__links a { white-space: nowrap; }
  }
  @media (min-width: 1680px) { #cho-{{ section.id }} .cho__in { zoom: 1.12; } }
  @media (min-width: 1920px) { #cho-{{ section.id }} .cho__in { zoom: 1.25; } }
  @media (min-width: 2240px) { #cho-{{ section.id }} .cho__in { zoom: 1.45; } }
  @media (min-width: 2560px) { #cho-{{ section.id }} .cho__in { zoom: 1.65; } }
  @media (min-width: 3200px) { #cho-{{ section.id }} .cho__in { zoom: 2; } }
  @media (min-width: 3840px) { #cho-{{ section.id }} .cho__in { zoom: 2.4; } }
  @media (prefers-reduced-motion: reduce) { #cho-{{ section.id }} * { transition: none !important; } }
</style>
<input type="hidden" value="true" id="fastrrCollectionPage">
<section id="cho-{{ section.id }}" class="cho">
  <div class="cho__in">
    <h1 class="cho__h">{{ collection.title | default: 'Shop all' }}</h1>
    {%- if s.show_description and collection.description != blank -%}
      <div class="cho__d">{{ collection.description }}</div>
    {%- elsif s.subheading != blank -%}
      <p class="cho__d">{{ s.subheading }}</p>
    {%- endif -%}

    {%- if s.offer_on and s.offer_code != blank -%}
      <div class="cho__offer">
        <svg class="cho__ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 13h17c0 3.6-3.8 6.2-8.5 6.2S3.5 16.6 3.5 13z"/><path d="M12 13V9.5"/><path d="M12 9.5c-1.3-1.5-1.3-3.2 0-4.8 1.3 1.6 1.3 3.3 0 4.8z"/></svg>
        <span class="cho__offer-t">{{ s.offer_text }}</span>
        <button type="button" class="cho__code" data-code="{{ s.offer_code | escape }}" aria-label="Copy code {{ s.offer_code | escape }}">{{ s.offer_code }}</button>
        {%- if s.offer_note != blank -%}<span class="cho__note">{{ s.offer_note }}</span>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="cho__links">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}><a href="{{ block.settings.link | default: '#' }}">{{ block.settings.label }}</a></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>
{% render 'cho-listing' %}

{% render 'offer-toast' %}
<script>
  (function () {
    var root = document.getElementById('cho-{{ section.id }}');
    if (!root) return;
    root.addEventListener('click', function (e) {
      var btn = e.target.closest('.cho__code');
      if (!btn) return;
      var code = btn.getAttribute('data-code'), label = btn.textContent;
      if (label === 'Copied') label = code;
      btn.textContent = 'Copied';
      setTimeout(function () { btn.textContent = label; }, 2500);
      window.offerCopy(code, {{ s.offer_copied | default: 'Code [code] copied. Add any 3 individual products to your cart, then apply it at checkout for an extra 15% off.' | json }});
    });

  })();
</script>

{% schema %}
{
  "name": "Collection: hero",
  "tag": "div",
  "settings": [
    { "type": "checkbox", "id": "show_description", "label": "Show the collection description", "default": true },
    { "type": "textarea", "id": "subheading", "label": "Line under the title", "info": "Shown when the collection has no description.", "default": "Care made by our doctors, delivered privately to your door." },
    { "type": "header", "content": "Offer" },
    { "type": "checkbox", "id": "offer_on", "label": "Show the offer", "default": true },
    { "type": "text", "id": "offer_text", "label": "Offer text", "default": "Diwali offer: buy any 3 individual products and get 15% extra off" },
    { "type": "text", "id": "offer_code", "label": "Discount code", "default": "FESTIVE15", "info": "Tapping it copies the code. Empty hides the offer." },
    { "type": "text", "id": "offer_note", "label": "Small note", "default": "Not valid on combos." },
    { "type": "textarea", "id": "offer_copied", "label": "Message after copying", "default": "Code [code] copied. Add any 3 individual products to your cart, then apply it at checkout for an extra 15% off.", "info": "[code] is replaced by the code." }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Quick link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "For Him" },
        { "type": "text", "id": "link", "label": "Link", "default": "/pages/for-him" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Collection: hero" }]
}
{% endschema %}
