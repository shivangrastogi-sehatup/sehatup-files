{%- comment -%}
  Why three kinds of medicine together: three cards joined by "+" signs that
  add up to one plan made by the doctors. Line icons are drawn in the page.
{%- endcomment -%}

{%- assign s = section.settings -%}

<style>
  #sig-{{ section.id }} {
    --sig-text: #1d1d1d; --sig-muted: #5f5a56; --sig-soft: {% if s.section_bg == blank or s.section_bg == '#ffffff' %}#f6f0ec{% else %}#fff{% endif %}; --sig-line: #e8e0d9;
    --sig-ink: {{ s.accent_color | color_darken: 8 }};
    padding: clamp(40px, 5vw, 72px) clamp(16px, 3vw, 48px);
    background: {{ s.section_bg | default: '#ffffff' }}; font-family: 'Montserrat', sans-serif; color: var(--sig-text);
  }
  #sig-{{ section.id }} * { box-sizing: border-box; }
  #sig-{{ section.id }} .sig__inner { max-width: 1240px; margin: 0 auto; }
  #sig-{{ section.id }} .sig__h { margin: 0; text-align: center; font: 800 clamp(28px, 3.2vw, 44px)/1.08 'Montserrat', sans-serif; letter-spacing: -.02em; text-wrap: balance; }
  #sig-{{ section.id }} .sig__sub { margin: 12px auto 0; max-width: 36em; text-align: center; font: 500 16px/1.6 'Montserrat', sans-serif; color: var(--sig-muted); }
  #sig-{{ section.id }} .sig__row { list-style: none; margin: clamp(28px, 3.4vw, 44px) 0 0; padding: 0; display: grid; grid-template-columns: repeat({{ section.blocks.size }}, minmax(0, 1fr)); gap: clamp(28px, 3.4vw, 48px); }
  #sig-{{ section.id }} .sig__card { position: relative; padding: clamp(22px, 2.4vw, 30px); border-radius: 24px; background: var(--sig-soft); }
  /* "+" between cards */
  #sig-{{ section.id }} .sig__card + .sig__card::before {
    content: "+"; position: absolute; top: 50%; left: calc(-1 * clamp(28px, 3.4vw, 48px) / 2 - 16px);
    width: 32px; height: 32px; margin-top: -16px; border-radius: 50%; display: grid; place-items: center;
    background: #fff; color: var(--sig-ink); font: 800 20px/1 'Montserrat', sans-serif; box-shadow: 0 4px 12px rgba(60, 30, 20, .1);
  }
  #sig-{{ section.id }} .sig__ico { width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; background: #fff; color: var(--sig-ink); }
  #sig-{{ section.id }} .sig__ico svg { width: 26px; height: 26px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  #sig-{{ section.id }} .sig__card b { display: block; margin-top: 18px; font: 800 20px/1.2 'Montserrat', sans-serif; letter-spacing: -.01em; }
  #sig-{{ section.id }} .sig__job { display: block; margin-top: 4px; font: 700 13px/1.4 'Montserrat', sans-serif; color: var(--sig-ink); }
  #sig-{{ section.id }} .sig__card p { margin: 10px 0 0; font: 500 14.5px/1.55 'Montserrat', sans-serif; color: var(--sig-muted); }
  /* "= one plan" line */
  #sig-{{ section.id }} .sig__sum { margin-top: clamp(20px, 2.4vw, 28px); display: flex; align-items: center; justify-content: center; gap: 14px; flex-wrap: wrap; padding: 18px 22px; border-radius: 20px; border: 1.5px dashed var(--sig-line); text-align: center; }
  #sig-{{ section.id }} .sig__eq { width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; background: var(--sig-ink); color: #fff; font: 800 20px/1 'Montserrat', sans-serif; flex: none; }
  #sig-{{ section.id }} .sig__sum p { margin: 0; font: 700 clamp(15px, 1.4vw, 18px)/1.45 'Montserrat', sans-serif; }
  @media (max-width: 899px) {
    #sig-{{ section.id }} .sig__row { grid-template-columns: minmax(0, 1fr); gap: 34px; }
    #sig-{{ section.id }} .sig__card + .sig__card::before { top: -33px; left: 50%; margin: 0 0 0 -16px; }
    #sig-{{ section.id }} .sig__card { padding: 20px; border-radius: 20px; }
    #sig-{{ section.id }} .sig__sum { flex-direction: column; gap: 10px; }
  }
</style>

<section id="sig-{{ section.id }}" class="sig">
  <div class="sig__inner">
    {%- if s.heading != blank -%}<h2 class="sig__h">{{ s.heading }}</h2>{%- endif -%}
    {%- if s.subheading != blank -%}<p class="sig__sub">{{ s.subheading }}</p>{%- endif -%}
    <ul class="sig__row">
      {%- for b in section.blocks -%}
        <li class="sig__card" {{ b.shopify_attributes }}>
          <span class="sig__ico" aria-hidden="true">
            {%- case b.settings.icon -%}
              {%- when 'leaf' -%}<svg viewBox="0 0 24 24"><path d="M5 19c0-8 5-13 15-14-1 10-6 15-14 15"/><path d="M5 19c3-4 6-7 10-9"/></svg>
              {%- when 'drop' -%}<svg viewBox="0 0 24 24"><path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"/><path d="M9.5 15a2.5 2.5 0 0 0 2.5 2.5"/></svg>
              {%- else -%}<svg viewBox="0 0 24 24"><rect x="3" y="8.5" width="18" height="7" rx="3.5" transform="rotate(-45 12 12)"/><path d="m9.5 9.5 5 5"/></svg>
            {%- endcase -%}
          </span>
          <b>{{ b.settings.title }}</b>
          {%- if b.settings.job != blank -%}<span class="sig__job">{{ b.settings.job }}</span>{%- endif -%}
          {%- if b.settings.text != blank -%}<p>{{ b.settings.text }}</p>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
    {%- if s.sum != blank -%}
      <div class="sig__sum"><span class="sig__eq" aria-hidden="true">=</span><p>{{ s.sum }}</p></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "sehatUP three medicines",
  "tag": "div",
  "class": "section-sehat-integrated",
  "settings": [
    { "type": "color", "id": "section_bg", "label": "Section background", "default": "#ffffff" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three kinds of medicine. One plan for you." },
    { "type": "textarea", "id": "subheading", "label": "Line under the heading" },
    { "type": "text", "id": "sum", "label": "Closing line (after the = sign)" },
    { "type": "color", "id": "accent_color", "label": "Accent colour", "default": "#d81f48" }
  ],
  "blocks": [
    { "type": "system", "name": "Medicine", "limit": 3, "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "leaf", "options": [
        { "value": "leaf", "label": "Leaf (Ayurveda)" },
        { "value": "drop", "label": "Drop (Homeopathy)" },
        { "value": "capsule", "label": "Capsule (Modern medicine)" }
      ] },
      { "type": "text", "id": "title", "label": "Name", "default": "Ayurveda" },
      { "type": "text", "id": "job", "label": "Its job, in a few words" },
      { "type": "textarea", "id": "text", "label": "One or two sentences" }
    ] }
  ],
  "presets": [{ "name": "sehatUP three medicines" }]
}
{% endschema %}
