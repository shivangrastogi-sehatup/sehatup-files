{%- comment -%}
  For Her: "your cycle, decoded". The month bar is the tab control: four parts,
  tapping one cross-fades to that part's slide (all four sit in the same spot;
  a swipe on phones moves to the next or previous one). Each slide: a huge day
  range in that part's colour with its name, then one plain line, "You may
  feel" tags and "See a doctor if".
  Day ranges are fixed for a 28-day cycle; the copy is editable.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign ids = 'period,follicular,ovulation,luteal' | split: ','
  assign froms = '1,6,14,17' | split: ','
  assign tos = '5,13,16,28' | split: ','
-%}
<style>
  #hcy-{{ section.id }} {
    --hcy-red: #ee204a; --hcy-ink: #d81f48; --hcy-text: #1d1d1d; --hcy-muted: #5f5a56; --hcy-line: #ece4de; --hcy-stone: #f6f0ec;
    background: {{ s.section_bg | default: '#ffffff' }}; font-family: 'Montserrat', sans-serif; color: var(--hcy-text);
  }
  #hcy-{{ section.id }} * { box-sizing: border-box; }
  #hcy-{{ section.id }} [data-phase="period"] { --c: #ee204a; }
  #hcy-{{ section.id }} [data-phase="follicular"] { --c: #e98aa0; }
  #hcy-{{ section.id }} [data-phase="ovulation"] { --c: #c93a5c; }
  #hcy-{{ section.id }} [data-phase="luteal"] { --c: #a8848a; }

  #hcy-{{ section.id }} .hcy__head { max-width: 640px; margin: 0 auto; padding: clamp(40px, 5vw, 72px) 16px 0; text-align: center; }
  #hcy-{{ section.id }} h2 { margin: 0; font: 800 clamp(30px, 3.6vw, 52px)/1.06 'Montserrat', sans-serif; letter-spacing: -.02em; text-wrap: balance; }
  #hcy-{{ section.id }} .hcy__lead { margin: 10px 0 0; font: 500 15.5px/1.6 'Montserrat', sans-serif; color: var(--hcy-muted); text-wrap: pretty; }

  /* Stage: month bar (tabs) over a row of four slides. */
  #hcy-{{ section.id }} .hcy__stage { max-width: 1160px; margin: 0 auto; padding: clamp(24px, 3vw, 40px) clamp(16px, 3vw, 48px) clamp(20px, 2.2vw, 32px); }

  /* Month bar */
  #hcy-{{ section.id }} .hcy__month { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 4px; max-width: 900px; margin: 0 auto; padding: 5px; border-radius: 18px; background: var(--hcy-stone); }
  #hcy-{{ section.id }} .hcy__seg {
    display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; column-gap: 10px; min-width: 0; padding: 11px 14px; border: 0; border-radius: 14px;
    background: transparent; text-align: left; cursor: pointer; color: var(--hcy-muted); transition: background-color .25s ease, color .25s ease, box-shadow .25s ease;
  }
  #hcy-{{ section.id }} .hcy__seg i { grid-row: span 2; width: 10px; height: 10px; border-radius: 50%; background: var(--c); }
  #hcy-{{ section.id }} .hcy__seg span { font: 700 14px/1.2 'Montserrat', sans-serif; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  #hcy-{{ section.id }} .hcy__seg small { margin-top: 3px; font: 500 12px/1 'Montserrat', sans-serif; }
  #hcy-{{ section.id }} .hcy__seg:hover { color: var(--hcy-text); }
  #hcy-{{ section.id }} .hcy__seg[aria-selected="true"] { background: #fff; color: var(--hcy-text); box-shadow: 0 2px 10px rgba(60, 30, 20, .1); }
  #hcy-{{ section.id }} .hcy__seg:focus { outline: none; }
  #hcy-{{ section.id }} .hcy__seg:focus-visible { outline: 2px solid var(--hcy-text); outline-offset: 2px; }

  /* Slides */
  /* All slides share one grid cell; the chosen one fades in, the rest fade out. */
  #hcy-{{ section.id }} .hcy__rail { display: grid; margin-top: clamp(28px, 4vw, 44px); touch-action: pan-y; }
  #hcy-{{ section.id }} .hcy__slide { grid-area: 1 / 1; opacity: 0; visibility: hidden; transition: opacity .45s ease, visibility 0s linear .45s; }
  #hcy-{{ section.id }} .hcy__slide.is-now { opacity: 1; visibility: visible; transition: opacity .45s ease .1s, visibility 0s; }
  @media (prefers-reduced-motion: reduce) { #hcy-{{ section.id }} .hcy__slide, #hcy-{{ section.id }} .hcy__slide.is-now { transition: none; } }
  #hcy-{{ section.id }} .hcy__slide { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(24px, 5vw, 72px); align-items: center; padding-right: 4px; }
  #hcy-{{ section.id }} .hcy__big { margin: 0; font: 800 clamp(84px, 11vw, 150px)/.9 'Montserrat', sans-serif; letter-spacing: -.05em; color: var(--c); font-variant-numeric: tabular-nums; }
  /* The tight letter-spacing crowded the dash against the digits. */
  #hcy-{{ section.id }} .hcy__dash { margin: 0 .1em; }
  #hcy-{{ section.id }} .hcy__big small { display: block; margin-top: 10px; font: 700 14px/1 'Montserrat', sans-serif; letter-spacing: .02em; color: var(--hcy-muted); }
  #hcy-{{ section.id }} .hcy__name { margin: 14px 0 0; font: 800 clamp(24px, 2.6vw, 32px)/1.15 'Montserrat', sans-serif; letter-spacing: -.02em; }
  #hcy-{{ section.id }} .hcy__what { margin: 0; font: 600 clamp(17px, 1.6vw, 20px)/1.5 'Montserrat', sans-serif; }
  #hcy-{{ section.id }} .hcy__label { margin: 22px 0 10px; font: 700 13px/1.3 'Montserrat', sans-serif; color: var(--hcy-muted); }
  #hcy-{{ section.id }} .hcy__tags { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  #hcy-{{ section.id }} .hcy__tags li { padding: 8px 14px; border-radius: 999px; border: 1.5px solid var(--hcy-line); font: 600 14px/1.2 'Montserrat', sans-serif; }
  #hcy-{{ section.id }} .hcy__doc { margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--hcy-line); }
  #hcy-{{ section.id }} .hcy__doc .hcy__label { margin-top: 0; color: var(--hcy-ink); }
  #hcy-{{ section.id }} .hcy__doc p:not(.hcy__label) { margin: 0; font: 500 15px/1.55 'Montserrat', sans-serif; color: var(--hcy-muted); }
  #hcy-{{ section.id }} .hcy__slide a { display: inline-block; margin-top: 12px; font: 700 14px/1.3 'Montserrat', sans-serif; color: var(--hcy-ink); text-decoration: underline; text-underline-offset: 4px; }
  #hcy-{{ section.id }} .hcy__slide a:focus-visible { outline: 2px solid var(--hcy-text); outline-offset: 3px; }

  /* The note sits right under the month tabs. */
  #hcy-{{ section.id }} .hcy__fine { max-width: 820px; margin: clamp(18px, 2vw, 26px) auto 0; padding: 0 16px; text-align: center; font: 800 clamp(20px, 2vw, 28px)/1.3 'Montserrat', sans-serif; letter-spacing: -.01em; color: var(--hcy-text); text-wrap: balance; }
  #hcy-{{ section.id }} .hcy__fine em { font-style: normal; color: var(--hcy-red); }

  @media (max-width: 749px) {
    #hcy-{{ section.id }} .hcy__month { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    #hcy-{{ section.id }} .hcy__seg { padding: 10px 12px; }
    #hcy-{{ section.id }} .hcy__seg span { font-size: 13px; }
    #hcy-{{ section.id }} .hcy__slide { grid-template-columns: 1fr; gap: 14px; }
    /* Phones: the days number on the left over two rows; on the right the day range, then the phase name big. */
    #hcy-{{ section.id }} .hcy__slide > div:first-child { display: grid; grid-template-columns: auto minmax(0, 1fr); grid-template-rows: auto auto; column-gap: 16px; align-items: center; }
    #hcy-{{ section.id }} .hcy__big { display: contents; }
    #hcy-{{ section.id }} .hcy__num { grid-column: 1; grid-row: 1 / span 2; font: 800 clamp(48px, 15vw, 64px)/.9 'Montserrat', sans-serif; letter-spacing: -.05em; color: var(--c); }
    #hcy-{{ section.id }} .hcy__big small { grid-column: 2; grid-row: 1; align-self: end; margin: 0 0 4px; font-size: 13px; line-height: 1.3; }
    #hcy-{{ section.id }} .hcy__name { grid-column: 2; grid-row: 2; align-self: start; margin: 0; font-size: clamp(22px, 7vw, 28px); line-height: 1.12; }
    #hcy-{{ section.id }} .hcy__lead { display: none; }
    /* Phones: tighter spacing, and the long explanation under the phase name goes (the tags and the doctor note stay). */
    #hcy-{{ section.id }} .hcy__head { padding-top: 20px; }
    #hcy-{{ section.id }} .hcy__stage { padding-top: 16px; }
    #hcy-{{ section.id }} .hcy__rail { margin-top: 16px; }
    #hcy-{{ section.id }} .hcy__what { display: none; }
    #hcy-{{ section.id }} .hcy__label:first-of-type { margin-top: 4px; }
    #hcy-{{ section.id }} .hcy__fine { margin-top: 14px; font-size: 19px; text-wrap: wrap; }
    #hcy-{{ section.id }} .hcy__stage { padding-bottom: 24px; }
    #hcy-{{ section.id }} .hcy__what { font-size: 15.5px; }
    #hcy-{{ section.id }} .hcy__label { margin: 14px 0 8px; }
    #hcy-{{ section.id }} .hcy__tags li { padding: 6px 11px; font-size: 13px; }
    #hcy-{{ section.id }} .hcy__doc { margin-top: 14px; padding-top: 12px; }
    #hcy-{{ section.id }} .hcy__doc p:not(.hcy__label) { font-size: 13.5px; }
  }
  /* Big screens: the same zoom steps as the other sections (Health Score 360 scale). */
  @media (min-width: 1680px) { #hcy-{{ section.id }} :is(.hcy__head, .hcy__stage) { zoom: 1.12; } }
  @media (min-width: 1920px) { #hcy-{{ section.id }} :is(.hcy__head, .hcy__stage) { zoom: 1.25; } }
  @media (min-width: 2240px) { #hcy-{{ section.id }} :is(.hcy__head, .hcy__stage) { zoom: 1.45; } }
  @media (min-width: 2560px) { #hcy-{{ section.id }} :is(.hcy__head, .hcy__stage) { zoom: 1.65; } }
  @media (min-width: 3200px) { #hcy-{{ section.id }} :is(.hcy__head, .hcy__stage) { zoom: 2; } }
  @media (min-width: 3840px) { #hcy-{{ section.id }} :is(.hcy__head, .hcy__stage) { zoom: 2.4; } }
  /* The theme paints h2/h3 blue-grey; keep this section charcoal like the rest of the page. */
  #hcy-{{ section.id }} :is(h2, h3) { color: var(--hcy-text); }
  /* Site type scale (Health Score 360): heading 30px phones, 38px tablets, up to 52px laptops; the line under it 15 / 16 / 17px. */
  #hcy-{{ section.id }} .hcy__lead { font-size: 17px; }
  @media (min-width: 750px) and (max-width: 1099.98px) { #hcy-{{ section.id }} h2 { font-size: 38px; } #hcy-{{ section.id }} .hcy__lead { font-size: 16px; } }
  @media (max-width: 749.98px) { #hcy-{{ section.id }} h2 { font-size: 30px !important; } #hcy-{{ section.id }} .hcy__lead { font-size: 15px; } }
</style>

<section id="hcy-{{ section.id }}">
  <div class="hcy__head">
    <h2>{{ s.heading }}</h2>
    {%- if s.lead != blank -%}<p class="hcy__lead">{{ s.lead }}</p>{%- endif -%}
  </div>

  <div class="hcy__track">
    <div class="hcy__stage">
      <div class="hcy__month" role="tablist" aria-label="{{ s.heading | escape }}">
        {%- for id in ids -%}
          {%- assign len = tos[forloop.index0] | minus: froms[forloop.index0] | plus: 1 -%}
          {%- assign k_name = id | append: '_name' -%}
          <button type="button" role="tab" class="hcy__seg" data-phase="{{ id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"><i aria-hidden="true"></i><span>{{ s[k_name] }}</span><small>Day {{ froms[forloop.index0] }} to {{ tos[forloop.index0] }}</small></button>
        {%- endfor -%}
      </div>

      {%- if s.fine != blank -%}<p class="hcy__fine">{{ s.fine | escape | replace: '[[', '<em>' | replace: ']]', '</em>' }}</p>{%- endif -%}
      <div class="hcy__rail">
        {%- for id in ids -%}
          {%- liquid
            assign a = froms[forloop.index0] | plus: 0
            assign z = tos[forloop.index0] | plus: 0
            assign k_name = id | append: '_name'
            assign k_happening = id | append: '_happening'
            assign k_feel = id | append: '_feel'
            assign k_doctor = id | append: '_doctor'
            assign k_link = id | append: '_link'
            assign k_label = id | append: '_link_label'
            assign feel = s[k_feel] | remove: '.' | split: ','
          -%}
          <div class="hcy__slide{% if forloop.first %} is-now{% endif %}" role="tabpanel" data-phase="{{ id }}">
            <div>
              <p class="hcy__big"><span class="hcy__num">{{ a }}<span class="hcy__dash">&ndash;</span>{{ z }}</span><small>Day {{ a }} to {{ z }} of your month</small></p>
              <h3 class="hcy__name">{{ s[k_name] }}</h3>
            </div>
            <div>
              <p class="hcy__what">{{ s[k_happening] }}</p>
              <p class="hcy__label">{{ s.label_feel }}</p>
              <ul class="hcy__tags">{%- for t in feel -%}{%- assign tag = t | strip -%}{%- if tag != '' -%}<li>{{ tag }}</li>{%- endif -%}{%- endfor -%}</ul>
              <div class="hcy__doc">
                <p class="hcy__label">{{ s.label_doctor }}</p>
                <p>{{ s[k_doctor] }}</p>
                {%- if s[k_link] != blank -%}<a href="{{ s[k_link] }}">{{ s[k_label] | default: 'See what helps' }}</a>{%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('hcy-{{ section.id }}');
    if (!root) return;
    var rail = root.querySelector('.hcy__rail');
    var tabs = [].slice.call(root.querySelectorAll('.hcy__seg'));
    var slides = [].slice.call(root.querySelectorAll('.hcy__slide'));
    var cur = 0;
    function go(i) {
      cur = i;
      tabs.forEach(function (t, k) { t.setAttribute('aria-selected', k === i ? 'true' : 'false'); });
      slides.forEach(function (s, k) { s.classList.toggle('is-now', k === i); });
    }
    tabs.forEach(function (t, i) {
      t.addEventListener('click', function () { go(i); });
      t.addEventListener('keydown', function (e) {
        var k = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!k) return;
        var n = (i + k + tabs.length) % tabs.length;
        tabs[n].focus(); go(n);
      });
    });
    // A sideways swipe on the slides goes to the next / previous part.
    var x0 = null, y0 = 0;
    rail.addEventListener('touchstart', function (e) { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; }, { passive: true });
    rail.addEventListener('touchend', function (e) {
      if (x0 === null) return;
      var dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0;
      x0 = null;
      if (Math.abs(dx) < 50 || Math.abs(dx) < Math.abs(dy)) return;
      var n = cur + (dx < 0 ? 1 : -1);
      if (n >= 0 && n < slides.length) go(n);
    }, { passive: true });
  })();
</script>

{% schema %}
{
  "name": "Her: cycle",
  "tag": "div",
  "settings": [
    { "type": "color", "id": "section_bg", "label": "Section background", "default": "#ffffff" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your cycle, decoded." },
    { "type": "textarea", "id": "lead", "label": "Lead", "default": "Your body changes through the month. Here is what is normal, and when to see a doctor." },
    { "type": "text", "id": "label_feel", "label": "Tags label", "default": "You may feel" },
    { "type": "text", "id": "label_doctor", "label": "Doctor label", "default": "See a doctor if" },
    { "type": "textarea", "id": "fine", "label": "Line under the month tabs", "default": "Every woman is different. A cycle of [[21 to 35 days]] is normal.", "info": "Put [[double square brackets]] around the words to show in red." },

    { "type": "header", "content": "Day 1 to 5" },
    { "type": "text", "id": "period_name", "label": "Name", "default": "Period" },
    { "type": "textarea", "id": "period_happening", "label": "What is happening", "default": "Your body lets go of last month's lining. This is your bleeding." },
    { "type": "textarea", "id": "period_feel", "label": "You may feel", "info": "Comma separated, shown as tags.", "default": "Cramps, Back pain, Tiredness, Bloating" },
    { "type": "textarea", "id": "period_doctor", "label": "See a doctor if", "default": "The pain stops your day, you change a pad every 1 to 2 hours, or bleeding lasts more than 7 days." },
    { "type": "text", "id": "period_link", "label": "Link", "info": "A page, or #name of a shelf on this page." },
    { "type": "text", "id": "period_link_label", "label": "Link text", "default": "See what helps" },

    { "type": "header", "content": "Day 6 to 13" },
    { "type": "text", "id": "follicular_name", "label": "Name", "default": "After your period" },
    { "type": "textarea", "id": "follicular_happening", "label": "What is happening", "default": "Your body gets ready for the month ahead. Energy comes back." },
    { "type": "textarea", "id": "follicular_feel", "label": "You may feel", "info": "Comma separated, shown as tags.", "default": "More energy, Better mood, Clearer skin" },
    { "type": "textarea", "id": "follicular_doctor", "label": "See a doctor if", "default": "Your periods often come before 21 days or after 35 days." },
    { "type": "text", "id": "follicular_link", "label": "Link", "info": "A page, or #name of a shelf on this page." },
    { "type": "text", "id": "follicular_link_label", "label": "Link text", "default": "See what helps" },

    { "type": "header", "content": "Day 14 to 16" },
    { "type": "text", "id": "ovulation_name", "label": "Name", "default": "Middle of your cycle" },
    { "type": "textarea", "id": "ovulation_happening", "label": "What is happening", "default": "An egg is released. This is when pregnancy is most likely." },
    { "type": "textarea", "id": "ovulation_feel", "label": "You may feel", "info": "Comma separated, shown as tags.", "default": "Mild pain on one side, More white discharge" },
    { "type": "textarea", "id": "ovulation_doctor", "label": "See a doctor if", "default": "Your periods have been irregular for months. It can be a sign of PCOS." },
    { "type": "text", "id": "ovulation_link", "label": "Link", "info": "A page, or #name of a shelf on this page." },
    { "type": "text", "id": "ovulation_link_label", "label": "Link text", "default": "See what helps" },

    { "type": "header", "content": "Day 17 to 28" },
    { "type": "text", "id": "luteal_name", "label": "Name", "default": "Before your period" },
    { "type": "textarea", "id": "luteal_happening", "label": "What is happening", "default": "If you are not pregnant, your body gets ready for the next period." },
    { "type": "textarea", "id": "luteal_feel", "label": "You may feel", "info": "Comma separated, shown as tags.", "default": "Bloating, Cravings, Sore breasts, Mood swings" },
    { "type": "textarea", "id": "luteal_doctor", "label": "See a doctor if", "default": "Mood changes hurt your work or family life, or it gets worse every month." },
    { "type": "text", "id": "luteal_link", "label": "Link", "info": "A page, or #name of a shelf on this page." },
    { "type": "text", "id": "luteal_link_label", "label": "Link text", "default": "See what helps" }
  ],
  "presets": [{ "name": "Her: cycle" }]
}
{% endschema %}
