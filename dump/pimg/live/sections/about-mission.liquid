{%- comment -%}
  About Us: why we exist. A heading, then mission and vision as two short
  labelled statements, then a row of plain facts (big value, small label)
  and one closing line. Fades in once.
  Facts: one "Value|Label" per line.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign facts = s.facts | newline_to_br | split: '<br />'
-%}
<style>
  #amn-{{ section.id }} {
    --ink: #1d1d1d; --mute: #5f5a56; --stone: #f6f0ec; --btn: #d81f48;
    padding: {{ s.padding_top }}px clamp(16px, 4vw, 48px) {{ s.padding_bottom }}px; background: #fff; color: var(--ink); font-family: 'Montserrat', sans-serif;
  }
  #amn-{{ section.id }} .amn__in { max-width: 1160px; margin: 0 auto; padding: clamp(32px, 4.5vw, 64px); border-radius: 28px; background: var(--stone); }
  #amn-{{ section.id }} .amn__h { margin: 0 0 clamp(24px, 3vw, 40px); font: 800 clamp(28px, 3vw, 42px)/1.1 'Montserrat', sans-serif; letter-spacing: -.02em; color: var(--ink); }
  #amn-{{ section.id }} .amn__two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(28px, 5vw, 72px); }
  #amn-{{ section.id }} .amn__l { margin: 0 0 10px; font: 700 14px/1.2 'Montserrat', sans-serif; color: var(--btn); }
  #amn-{{ section.id }} .amn__t { margin: 0; max-width: 32em; font: 500 clamp(17px, 1.4vw, 20px)/1.6 'Montserrat', sans-serif; color: var(--ink); text-wrap: pretty; }

  #amn-{{ section.id }} .amn__facts { display: grid; grid-template-columns: repeat({{ facts.size | at_least: 1 }}, minmax(0, 1fr)); margin: clamp(28px, 3.5vw, 44px) 0 0; padding: clamp(22px, 2.5vw, 32px) 0 0; border-top: 1px solid rgba(29, 29, 29, .12); list-style: none; }
  #amn-{{ section.id }} .amn__facts li { padding-right: 20px; }
  #amn-{{ section.id }} .amn__facts li + li { padding-left: 20px; border-left: 1px solid rgba(29, 29, 29, .12); }
  #amn-{{ section.id }} .amn__facts b { display: block; font: 800 clamp(24px, 2.4vw, 32px)/1.1 'Montserrat', sans-serif; letter-spacing: -.02em; color: var(--ink); }
  #amn-{{ section.id }} .amn__facts span { display: block; margin-top: 6px; font: 500 14px/1.4 'Montserrat', sans-serif; color: var(--mute); }
  #amn-{{ section.id }} .amn__line { margin: clamp(22px, 2.5vw, 32px) 0 0; max-width: 760px; font: 400 15px/1.65 'Montserrat', sans-serif; color: var(--mute); text-wrap: pretty; }

  #amn-{{ section.id }}.js .amn__in { opacity: 0; transform: translateY(12px); }
  #amn-{{ section.id }}.js.in .amn__in { opacity: 1; transform: none; transition: opacity .7s ease, transform .8s cubic-bezier(.22, 1, .36, 1); }

  @media (max-width: 899.98px) {
    #amn-{{ section.id }} .amn__two { grid-template-columns: minmax(0, 1fr); gap: 22px; }
    #amn-{{ section.id }} .amn__facts { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 0; }
    #amn-{{ section.id }} .amn__facts li:nth-child(odd) { padding-left: 0; border-left: 0; }
  }
  @media (max-width: 749.98px) {
    #amn-{{ section.id }} .amn__in { padding: 26px 20px; border-radius: 22px; }
    #amn-{{ section.id }} .amn__h { font-size: 26px; }
    #amn-{{ section.id }} .amn__t { font-size: 16px; }
    #amn-{{ section.id }} .amn__facts b { font-size: 22px; }
    #amn-{{ section.id }} .amn__facts span { font-size: 12.5px; }
    #amn-{{ section.id }} .amn__line { font-size: 14px; }
  }
  @media (min-width: 1680px) { #amn-{{ section.id }} .amn__in { zoom: 1.12; } }
  @media (min-width: 1920px) { #amn-{{ section.id }} .amn__in { zoom: 1.25; } }
  @media (min-width: 2560px) { #amn-{{ section.id }} .amn__in { zoom: 1.65; } }
  @media (min-width: 3200px) { #amn-{{ section.id }} .amn__in { zoom: 2; } }
  @media (prefers-reduced-motion: reduce) { #amn-{{ section.id }} * { transition: none !important; } }
</style>

<section id="amn-{{ section.id }}">
  <div class="amn__in">
    {%- if s.heading != blank -%}<h2 class="amn__h">{{ s.heading }}</h2>{%- endif -%}
    <div class="amn__two">
      <div><p class="amn__l">{{ s.mission_label }}</p><p class="amn__t">{{ s.mission }}</p></div>
      <div><p class="amn__l">{{ s.vision_label }}</p><p class="amn__t">{{ s.vision }}</p></div>
    </div>
    {%- if s.facts != blank -%}
      <ul class="amn__facts">
        {%- for f in facts -%}
          {%- assign parts = f | strip | split: '|' -%}
          {%- if parts.size > 0 -%}<li><b>{{ parts[0] | strip }}</b>{%- if parts[1] != blank -%}<span>{{ parts[1] | strip }}</span>{%- endif -%}</li>{%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if s.line != blank -%}<p class="amn__line">{{ s.line }}</p>{%- endif -%}
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('amn-{{ section.id }}');
    if (!root || !('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    root.classList.add('js');
    var io = new IntersectionObserver(function (es) {
      if (es[0].isIntersecting) { root.classList.add('in'); io.disconnect(); }
    }, { threshold: .2 });
    io.observe(root);
  })();
</script>

{% schema %}
{
  "name": "About: mission",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why we exist" },
    { "type": "text", "id": "mission_label", "label": "Label 1", "default": "Our mission" },
    { "type": "textarea", "id": "mission", "label": "Mission" },
    { "type": "text", "id": "vision_label", "label": "Label 2", "default": "Our vision" },
    { "type": "textarea", "id": "vision", "label": "Vision" },
    { "type": "textarea", "id": "facts", "label": "Facts", "info": "One per line: Value|Label, e.g. 25,000+|patients have trusted us" },
    { "type": "textarea", "id": "line", "label": "Closing line" },
    { "type": "range", "id": "padding_top", "label": "Space above", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Space below", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 }
  ],
  "presets": [{ "name": "About: mission" }]
}
{% endschema %}
