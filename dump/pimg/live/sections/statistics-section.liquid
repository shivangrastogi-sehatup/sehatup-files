<section
  class="impact-stats"
  style="
    background: {{ section.settings.background_color }};
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
  "
>
  <div class="impact-container" style="max-width: {{ section.settings.container_width }}px;">
    {% if section.settings.heading != blank %}
      <h2 class="impact-heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %} 

    <div class="impact-grid">

      {% for i in (1..4) %}
        {% assign key_enabled = 'stat_' | append: i | append: '_enabled' %}
        {% assign key_value   = 'stat_' | append: i | append: '_value' %}
        {% assign key_label   = 'stat_' | append: i | append: '_label' %}

        {% assign en  = section.settings[key_enabled] %}
        {% assign val = section.settings[key_value] %}
        {% assign lbl = section.settings[key_label] %}

        {% if en %}
          <div class="impact-item">
            <div class="impact-value" data-count="{{ val | escape }}">{{ val }}</div>
            <div class="impact-label">{{ lbl }}</div>
          </div>
        {% endif %}
      {% endfor %}

    </div>
  </div>
</section>

<style>
/* digits keep the same width while counting, so the number does not jitter */
.impact-value { font-variant-numeric: tabular-nums; }
.impact-num { display: inline-block; text-align: right; }

.impact-stats {
  width: 100%;
}

.impact-container {
  margin: 0 auto;
  text-align: center;
}

.impact-heading {
  color: {{ section.settings.heading_color }};
  font-size: clamp(24px,3.4vw,64px);
  margin-bottom: {{ section.settings.heading_spacing }}px;
  margin-top: 10px;
  font-weight: 700;
}

.impact-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: {{ section.settings.column_gap }}px;
}

.impact-item {
  padding: 0 10px;
}

.impact-value {
  color: {{ section.settings.accent_color }};
  font-size: {{ section.settings.value_size }}px;
  font-weight: 700;
  margin-bottom: {{ section.settings.value_spacing }}px;
}

.impact-label {
  color: {{ section.settings.label_color }};
  font-size: clamp(14px, 1vw, 35px);
}

/* Tablet */
@media (max-width: 1024px) {
  .impact-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: {{ section.settings.column_gap_mobile }}px {{ section.settings.row_gap_mobile }}px;
  }

  .impact-heading {
    font-size: {{ section.settings.heading_size | times: 0.85 | round }}px;
    margin: 10px 0;
  }

  .impact-value {
    font-size: {{ section.settings.value_size | times: 0.75 | round }}px;
    margin-bottom:0;
  }

  .impact-label {
    font-size: {{ section.settings.label_size | times: 0.9 | round }}px;
  }
}

/* Mobile */
@media (max-width: 600px) {
  .impact-stats {
    padding: {{ section.settings.padding_top_mobile }}px 16px {{ section.settings.padding_bottom_mobile }}px;
  }

  .impact-heading {
    font-size: {{ section.settings.heading_size_mobile }}px;
    margin-bottom: {{ section.settings.heading_spacing | times: 0.6 | round }}px;
  }

  .impact-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: {{ section.settings.column_gap_mobile }}px {{ section.settings.row_gap_mobile }}px;
  }

  .impact-value {
    font-size: {{ section.settings.value_size_mobile }}px;
  }

  .impact-label {
    font-size: {{ section.settings.label_size_mobile }}px;
  }
}
</style>


<script>
  (() => {
    const root = document.getElementById("shopify-section-{{ section.id }}");
    if (!root) return;
    const values = [...root.querySelectorAll(".impact-value")];
    if (!values.length) return;

    // "40%" counts up, "Better" is left alone. Whatever sits around the number
    // (a percent sign, a plus, a currency symbol) is kept exactly as written.
    const targets = values.map(el => {
      const raw = el.dataset.count || el.textContent;
      const m = raw.match(/^(\D*?)(\d[\d,]*)(\.\d+)?(.*)$/);
      if (!m) return null;
      const decimals = m[3] ? m[3].length - 1 : 0;
      return { el, pre: m[1], suf: m[4], decimals,
               end: parseFloat(m[2].replace(/,/g, "") + (m[3] || "")) };
    }).filter(Boolean);
    if (!targets.length) return;

    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (still) return;

    // The number gets its own box, wide enough for the final figure. Without
    // this the text is re-centred on every frame as 0 becomes 40, which is
    // what makes a counter look like it is shaking.
    targets.forEach(t => {
      const box = document.createElement("span");
      box.className = "impact-num";
      box.style.minWidth = (String(Math.round(t.end)).length + (t.decimals ? t.decimals + 1 : 0)) + "ch";
      t.el.textContent = t.pre;
      t.el.appendChild(box);
      t.el.appendChild(document.createTextNode(t.suf));
      t.box = box;
      box.textContent = t.end.toFixed(t.decimals);
    });

    const render = (t, v) => {
      t.box.textContent = v.toFixed(t.decimals);
    };
    // The numbers are NOT zeroed here. If the trigger never fires, for any
    // reason, the real figures stay on screen rather than a row of zeros.

    let started = false;
    const run = () => {
      if (started) return;
      started = true;
      targets.forEach(t => render(t, 0));
      const ms = 1500;
      const t0 = performance.now();
      const frame = (now) => {
        const k = Math.min(1, (now - t0) / ms);
        // fast at first, easing into the final number
        const e = 1 - Math.pow(1 - k, 3);
        targets.forEach(t => render(t, t.end * e));
        if (k < 1) requestAnimationFrame(frame);
        else targets.forEach(t => render(t, t.end));
      };
      requestAnimationFrame(frame);
    };

    // Two ways in: the observer, and a plain scroll check as a backstop.
    const inView = () => {
      const r = root.getBoundingClientRect();
      return r.top < innerHeight * 0.85 && r.bottom > 0;
    };
    const check = () => { if (inView()) { run(); removeEventListener("scroll", check); } };

    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach(e => { if (e.isIntersecting) { io.disconnect(); run(); } });
      }, { threshold: 0.3 });
      io.observe(root);
    }
    addEventListener("scroll", check, { passive: true });
    check();
  })();
</script>

