{% doc %}
  @prompt
    Create a flexible product description section with multiple image layout blocks that adapts responsively across mobile, tablet, and desktop. The section should support:
    
    1. Full-width image blocks with overlay text capability for hero-style product images
    2. Three-column grid blocks that display benefit cards with images, headings, and bullet points side-by-side
    3. Each block should have a setting to choose the layout type (full-width single image, two-column, or three-column grid)
    4. Image blocks should support text overlays with customizable headings and descriptions
    5. Grid blocks should allow individual configuration for each card including image upload, heading, subheading, and bullet point lists
    6. Fully responsive design that stacks columns vertically on mobile, shows 2 columns on tablet, and 3 columns on desktop
    7. Settings schema for each block to control: layout type, image selection, text content, background colors, text colors, and spacing options
    8. Support for mixing different block types within the same section (full-width images followed by grid layouts)
    
    The design should match premium wellness product pages with clean spacing, professional typography, and smooth transitions between layout types., what i wanted , the height of the image it will take automatically and manually we can change if want otherwise the default should be in this way for big big screen make them align center so left side and right side have auto margin and for laptop screens they take full height and width . and for mobile the whole image will be resized smoothly to cover the full height and width of the image
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-desc-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
  }

  .ai-product-desc-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-product-desc-full-width-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    margin-bottom: {{ block.settings.block_spacing }}px;
  }

  .ai-product-desc-full-width-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .ai-product-desc-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    {% if block.settings.use_custom_height %}
      height: {{ block.settings.full_width_height }}px;
    {% else %}
      height: auto;
    {% endif %}
  }

  .ai-product-desc-image-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    {% if block.settings.use_custom_height %}
      height: 100%;
      object-fit: cover;
    {% else %}
      height: auto;
      display: block;
    {% endif %}
  }

  .ai-product-desc-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    {% if block.settings.use_custom_height %}
      height: {{ block.settings.full_width_height }}px;
    {% else %}
      min-height: 400px;
    {% endif %}
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-desc-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-product-desc-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: {{ block.settings.overlay_vertical_align }};
    align-items: {{ block.settings.overlay_horizontal_align }};
    padding: 40px;
    background: {{ block.settings.overlay_background }};
    text-align: {{ block.settings.overlay_text_align }};
  }

  .ai-product-desc-overlay-heading-{{ ai_gen_id }} {
    color: {{ block.settings.overlay_text_color }};
    font-size: {{ block.settings.overlay_heading_size }}px;
    font-weight: 600;
    margin: 0 0 16px;
    line-height: 1.2;
  }

  .ai-product-desc-overlay-text-{{ ai_gen_id }} {
    color: {{ block.settings.overlay_text_color }};
    font-size: {{ block.settings.overlay_text_size }}px;
    line-height: 1.6;
    max-width: 600px;
  }

  .ai-product-desc-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.desktop_columns }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-bottom: {{ block.settings.block_spacing }}px;
  }

  .ai-product-desc-grid-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .ai-product-desc-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    text-align: {{ block.settings.card_text_align }};
  }

  .ai-product-desc-card-image-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.card_image_height }}px;
    margin-bottom: 20px;
    border-radius: {{ block.settings.card_image_radius }}px;
    overflow: hidden;
  }

  .ai-product-desc-card-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-product-desc-card-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-desc-card-image-placeholder-{{ ai_gen_id }} svg {
    width: 80px;
    height: 80px;
  }

  .ai-product-desc-card-heading-{{ ai_gen_id }} {
    color: {{ block.settings.card_heading_color }};
    font-size: {{ block.settings.card_heading_size }}px;
    font-weight: 600;
    margin: 0 0 12px;
    line-height: 1.3;
  }

  .ai-product-desc-card-subheading-{{ ai_gen_id }} {
    color: {{ block.settings.card_text_color }};
    font-size: {{ block.settings.card_subheading_size }}px;
    margin: 0 0 16px;
    line-height: 1.5;
  }

  .ai-product-desc-card-bullets-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
    text-align: left;
  }

  .ai-product-desc-card-bullets-{{ ai_gen_id }} li {
    color: {{ block.settings.card_text_color }};
    font-size: {{ block.settings.card_bullet_size }}px;
    line-height: 1.6;
    margin-bottom: 8px;
    padding-left: 24px;
    position: relative;
  }

  .ai-product-desc-card-bullets-{{ ai_gen_id }} li:before {
    content: "✓";
    position: absolute;
    left: 0;
    color: {{ block.settings.card_bullet_icon_color }};
    font-weight: 600;
  }

  @media screen and (max-width: 989px) {
    .ai-product-desc-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.tablet_columns }}, 1fr);
    }

    .ai-product-desc-overlay-{{ ai_gen_id }} {
      padding: 30px;
    }

    .ai-product-desc-overlay-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.overlay_heading_size | times: 0.8 }}px;
    }

    .ai-product-desc-overlay-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.overlay_text_size | times: 0.9 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-product-desc-container-{{ ai_gen_id }} {
      padding: 0;
    }

    .ai-product-desc-full-width-{{ ai_gen_id }} {
      border-radius: 0;
    }

    .ai-product-desc-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.grid_gap | times: 0.7 }}px;
    }

    .ai-product-desc-image-wrapper-{{ ai_gen_id }} {
      {% if block.settings.use_custom_height %}
        height: auto;
      {% endif %}
    }

    .ai-product-desc-image-wrapper-{{ ai_gen_id }} img {
      height: auto;
      object-fit: contain;
    }

    .ai-product-desc-overlay-{{ ai_gen_id }} {
      padding: 20px;
    }

    .ai-product-desc-overlay-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.overlay_heading_size | times: 0.6 }}px;
    }

    .ai-product-desc-overlay-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.overlay_text_size | times: 0.8 }}px;
    }

    .ai-product-desc-card-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.7 }}px;
    }
  }
{% endstyle %}

<div class="ai-product-desc-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-desc-container-{{ ai_gen_id }}">
    {% if block.settings.layout_type == 'full_width' %}
      <div class="ai-product-desc-full-width-{{ ai_gen_id }}">
        <div class="ai-product-desc-image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.full_width_image %}
            <img
              src="{{ block.settings.full_width_image | image_url: width: 2000 }}"
              alt="{{ block.settings.full_width_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.full_width_image.width }}"
              height="{{ block.settings.full_width_image.height }}"
            >
          {% else %}
            <div class="ai-product-desc-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>

        {% if block.settings.show_overlay %}
          <div class="ai-product-desc-overlay-{{ ai_gen_id }}">
            {% if block.settings.overlay_heading != blank %}
              <h2 class="ai-product-desc-overlay-heading-{{ ai_gen_id }}">
                {{ block.settings.overlay_heading }}
              </h2>
            {% endif %}
            {% if block.settings.overlay_text != blank %}
              <div class="ai-product-desc-overlay-text-{{ ai_gen_id }}">
                {{ block.settings.overlay_text }}
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>

    {% elsif block.settings.layout_type == 'two_column' or block.settings.layout_type == 'three_column' %}
      <div class="ai-product-desc-grid-{{ ai_gen_id }}">
        {% for i in (1..3) %}
          {% liquid
            assign card_enabled_key = 'card_' | append: i | append: '_enabled'
            assign card_image_key = 'card_' | append: i | append: '_image'
            assign card_heading_key = 'card_' | append: i | append: '_heading'
            assign card_subheading_key = 'card_' | append: i | append: '_subheading'
            assign card_bullet_1_key = 'card_' | append: i | append: '_bullet_1'
            assign card_bullet_2_key = 'card_' | append: i | append: '_bullet_2'
            assign card_bullet_3_key = 'card_' | append: i | append: '_bullet_3'
            assign card_bullet_4_key = 'card_' | append: i | append: '_bullet_4'

            assign card_enabled = block.settings[card_enabled_key]
            assign card_image = block.settings[card_image_key]
            assign card_heading = block.settings[card_heading_key]
            assign card_subheading = block.settings[card_subheading_key]
            assign card_bullet_1 = block.settings[card_bullet_1_key]
            assign card_bullet_2 = block.settings[card_bullet_2_key]
            assign card_bullet_3 = block.settings[card_bullet_3_key]
            assign card_bullet_4 = block.settings[card_bullet_4_key]
          %}

          {% if card_enabled %}
            {% if block.settings.layout_type == 'two_column' and i > 2 %}
              {% break %}
            {% endif %}

            <div class="ai-product-desc-card-{{ ai_gen_id }}">
              <div class="ai-product-desc-card-image-{{ ai_gen_id }}">
                {% if card_image %}
                  <img
                    src="{{ card_image | image_url: width: 800 }}"
                    alt="{{ card_image.alt | escape }}"
                    loading="lazy"
                    width="{{ card_image.width }}"
                    height="{{ card_image.height }}"
                  >
                {% else %}
                  <div class="ai-product-desc-card-image-placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>

              {% if card_heading != blank %}
                <h3 class="ai-product-desc-card-heading-{{ ai_gen_id }}">
                  {{ card_heading }}
                </h3>
              {% endif %}

              {% if card_subheading != blank %}
                <p class="ai-product-desc-card-subheading-{{ ai_gen_id }}">
                  {{ card_subheading }}
                </p>
              {% endif %}

              {% if card_bullet_1 != blank or card_bullet_2 != blank or card_bullet_3 != blank or card_bullet_4 != blank %}
                <ul class="ai-product-desc-card-bullets-{{ ai_gen_id }}">
                  {% if card_bullet_1 != blank %}
                    <li>{{ card_bullet_1 }}</li>
                  {% endif %}
                  {% if card_bullet_2 != blank %}
                    <li>{{ card_bullet_2 }}</li>
                  {% endif %}
                  {% if card_bullet_3 != blank %}
                    <li>{{ card_bullet_3 }}</li>
                  {% endif %}
                  {% if card_bullet_4 != blank %}
                    <li>{{ card_bullet_4 }}</li>
                  {% endif %}
                </ul>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Product layout",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "Layout type",
      "options": [
        {
          "value": "full_width",
          "label": "Full-width image"
        },
        {
          "value": "two_column",
          "label": "Two-column grid"
        },
        {
          "value": "three_column",
          "label": "Three-column grid"
        }
      ],
      "default": "full_width"
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Container width",
      "min": 1000,
      "max": 1600,
      "step": 100,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "block_spacing",
      "label": "Block spacing",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Full-width image"
    },
    {
      "type": "image_picker",
      "id": "full_width_image",
      "label": "Image"
    },
