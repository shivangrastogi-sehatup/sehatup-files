{% doc %}
  @prompt
    Create a premium blog listing section with full pagination for Shopify OS 2.0
    
    Build a complete, customizable blog page section with modern magazine-style layout, responsive grid, and working pagination.
    
    Core Layout:
    
    Full-width hero header with blog title, optional description, and background image/gradient support
    Responsive blog post grid (1-4 columns, adjustable per breakpoint)
    Optional sidebar with categories, tags, and recent posts (toggleable)
    Proper content max-width and spacing controls
    Blog Post Cards:
    
    Featured image with aspect ratio options (16:9, 4:3, 1:1, portrait) and object-fit control (cover/contain)
    Lazy loading for all images
    Optional image overlay (gradient or solid color)
    Display: post title, excerpt (adjustable word count), author name with optional avatar, publish date, read time estimate, category/tag badges
    Customizable "Read more" button (text, style: filled/outline/text-only)
    Smooth hover effects (image zoom, shadow lift, card elevation)
    Pagination:
    
    Full Shopify blog pagination at bottom
    Previous/next navigation
    Optional page numbers display
    Customizable alignment (left/center/right) and button styling
    Active page indicator
    Typography & Styling:
    
    Clear hierarchy for blog title, post titles, meta info, and excerpts
    Font family, size, weight, and color controls
    Color scheme settings: background, text, accent
    Border radius controls for cards and images
    Shadow intensity options
    Content alignment (left/center/right)
    Theme Editor Settings:
    
    Section padding (top/bottom)
    Max content width
    Posts per page
    Grid columns (responsive)
    Show/hide toggles: featured image, author, date, tags, excerpt, read time
    Layout style selector: grid/list/masonry
    Sidebar enable/disable
    Image aspect ratio and object-fit
    Button and hover effect styles
    Pagination style options
    Design Requirements:
    
    Premium, clean, modern aesthetic suitable for wellness/lifestyle brands
    Optimized for performance (lazy loading, efficient markup)
    SEO-friendly structure
    Fully responsive across all devices
    Scalable for blogs with 10–1000+ posts
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-blog-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    background: {{ block.settings.section_background }};
  }

  .ai-blog-hero-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding: {{ block.settings.hero_padding_top }}px 20px {{ block.settings.hero_padding_bottom }}px;
    margin-bottom: {{ block.settings.hero_margin_bottom }}px;
    {% if block.settings.hero_background_image %}
      background-image: url('{{ block.settings.hero_background_image | image_url: width: 2000 }}');
      background-size: cover;
      background-position: center;
    {% elsif block.settings.hero_background_gradient != blank %}
      background: {{ block.settings.hero_background_gradient }};
    {% else %}
      background: {{ block.settings.hero_background_color }};
    {% endif %}
    text-align: {{ block.settings.hero_text_alignment }};
  }

  .ai-blog-hero-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    {% if block.settings.hero_overlay_type == 'gradient' %}
      background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,{{ block.settings.hero_overlay_opacity | divided_by: 100.0 }}) 100%);
    {% else %}
      background: rgba(0,0,0,{{ block.settings.hero_overlay_opacity | divided_by: 100.0 }});
    {% endif %}
    pointer-events: none;
  }

  .ai-blog-hero-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
  }

  .ai-blog-hero-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.hero_title_size }}px;
    font-weight: {{ block.settings.hero_title_weight }};
    color: {{ block.settings.hero_title_color }};
    margin: 0 0 {{ block.settings.hero_title_margin }}px;
    line-height: 1.2;
  }

  .ai-blog-hero-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.hero_description_size }}px;
    color: {{ block.settings.hero_description_color }};
    margin: 0;
    line-height: 1.6;
  }

  .ai-blog-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-blog-layout-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.sidebar_gap }}px;
    {% if block.settings.sidebar_position == 'left' %}
      flex-direction: row-reverse;
    {% endif %}
  }

  .ai-blog-main-{{ ai_gen_id }} {
    flex: 1;
    min-width: 0;
  }

  .ai-blog-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-bottom: {{ block.settings.pagination_margin_top }}px;
  }

  .ai-blog-card-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    background: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    {% if block.settings.card_shadow_opacity > 0 %}
      box-shadow: 0 {{ block.settings.card_shadow_vertical }}px {{ block.settings.card_shadow_blur }}px rgba(0,0,0,{{ block.settings.card_shadow_opacity | divided_by: 100.0 }});
    {% endif %}
  }

  .ai-blog-card-{{ ai_gen_id }}:hover {
    {% if block.settings.card_hover_lift %}
      transform: translateY(-{{ block.settings.card_hover_lift_amount }}px);
      box-shadow: 0 {{ block.settings.card_shadow_vertical | plus: 8 }}px {{ block.settings.card_shadow_blur | plus: 10 }}px rgba(0,0,0,{{ block.settings.card_shadow_opacity | divided_by: 100.0 | plus: 0.1 }});
    {% endif %}
  }

  .ai-blog-card-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {% if block.settings.image_aspect_ratio == '16-9' %}56.25%{% elsif block.settings.image_aspect_ratio == '4-3' %}75%{% elsif block.settings.image_aspect_ratio == '1-1' %}100%{% else %}133.33%{% endif %};
    overflow: hidden;
    background: #f4f4f4;
  }

  .ai-blog-card-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: {{ block.settings.image_object_fit }};
    transition: transform 0.5s ease;
  }

  .ai-blog-card-{{ ai_gen_id }}:hover .ai-blog-card-image-{{ ai_gen_id }} {
    {% if block.settings.image_hover_zoom %}
      transform: scale(1.05);
    {% endif %}
  }

  .ai-blog-card-image-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    {% if block.settings.image_overlay_type == 'gradient' %}
      background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,{{ block.settings.image_overlay_opacity | divided_by: 100.0 }}) 100%);
    {% elsif block.settings.image_overlay_type == 'solid' %}
      background: rgba(0,0,0,{{ block.settings.image_overlay_opacity | divided_by: 100.0 }});
    {% endif %}
  }

  .ai-blog-card-content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .ai-blog-card-meta-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: {{ block.settings.meta_margin_bottom }}px;
    flex-wrap: wrap;
  }

  .ai-blog-card-author-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: {{ block.settings.meta_font_size }}px;
    color: {{ block.settings.meta_color }};
  }

  .ai-blog-card-author-avatar-{{ ai_gen_id }} {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: {{ block.settings.meta_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    color: #fff;
    font-weight: 600;
  }

  .ai-blog-card-date-{{ ai_gen_id }},
  .ai-blog-card-read-time-{{ ai_gen_id }} {
    font-size: {{ block.settings.meta_font_size }}px;
    color: {{ block.settings.meta_color }};
  }

  .ai-blog-card-tags-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: {{ block.settings.tags_margin_bottom }}px;
  }

  .ai-blog-card-tag-{{ ai_gen_id }} {
    padding: 4px 12px;
    background: {{ block.settings.tag_background }};
    color: {{ block.settings.tag_color }};
    font-size: {{ block.settings.tag_font_size }}px;
    border-radius: {{ block.settings.tag_border_radius }}px;
    text-decoration: none;
    transition: background 0.3s ease;
  }

  .ai-blog-card-tag-{{ ai_gen_id }}:hover {
    background: {{ block.settings.tag_hover_background }};
  }

  .ai-blog-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: {{ block.settings.title_font_weight }};
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_margin_bottom }}px;
    line-height: 1.3;
  }

  .ai-blog-card-title-link-{{ ai_gen_id }} {
    color: inherit;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .ai-blog-card-title-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.title_hover_color }};
  }

  .ai-blog-card-excerpt-{{ ai_gen_id }} {
    font-size: {{ block.settings.excerpt_font_size }}px;
    color: {{ block.settings.excerpt_color }};
    line-height: 1.6;
    margin: 0 0 {{ block.settings.excerpt_margin_bottom }}px;
    flex: 1;
  }

  .ai-blog-card-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    transition: all 0.3s ease;
    align-self: flex-start;
    {% if block.settings.button_style == 'filled' %}
      background: {{ block.settings.button_background }};
      color: {{ block.settings.button_text_color }};
      border: none;
    {% elsif block.settings.button_style == 'outline' %}
      background: transparent;
      color: {{ block.settings.button_background }};
      border: 2px solid {{ block.settings.button_background }};
    {% else %}
      background: transparent;
      color: {{ block.settings.button_background }};
      border: none;
      padding-left: 0;
      padding-right: 0;
    {% endif %}
  }

  .ai-blog-card-button-{{ ai_gen_id }}:hover {
    {% if block.settings.button_style == 'filled' %}
      background: {{ block.settings.button_hover_background }};
      color: {{ block.settings.button_hover_text_color }};
    {% elsif block.settings.button_style == 'outline' %}
      background: {{ block.settings.button_background }};
      color: {{ block.settings.button_text_color }};
    {% else %}
      color: {{ block.settings.button_hover_background }};
    {% endif %}
  }

  .ai-blog-sidebar-{{ ai_gen_id }} {
    width: {{ block.settings.sidebar_width }}px;
    flex-shrink: 0;
  }

  .ai-blog-sidebar-widget-{{ ai_gen_id }} {
    background: {{ block.settings.sidebar_widget_background }};
    padding: {{ block.settings.sidebar_widget_padding }}px;
    border-radius: {{ block.settings.sidebar_widget_border_radius }}px;
    margin-bottom: {{ block.settings.sidebar_widget_gap }}px;
  }

  .ai-blog-sidebar-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.sidebar_title_size }}px;
    font-weight: {{ block.settings.sidebar_title_weight }};
    color: {{ block.settings.sidebar_title_color }};
    margin: 0 0 16px;
  }

  .ai-blog-sidebar-list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-blog-sidebar-list-item-{{ ai_gen_id }} {
    margin-bottom: 12px;
  }

  .ai-blog-sidebar-link-{{ ai_gen_id }} {
    color: {{ block.settings.sidebar_link_color }};
    text-decoration: none;
    font-size: {{ block.settings.sidebar_link_size }}px;
    transition: color 0.3s ease;
  }

  .ai-blog-sidebar-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.sidebar_link_hover_color }};
  }

  .ai-blog-pagination-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: {{ block.settings.pagination_alignment }};
    gap: 12px;
    flex-wrap: wrap;
  }

  .ai-blog-pagination-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    height: 44px;
    padding: 0 16px;
    background: {{ block.settings.pagination_button_background }};
    color: {{ block.settings.pagination_button_color }};
    border: 1px solid {{ block.settings.pagination_button_border }};
    border-radius: {{ block.settings.pagination_button_radius }}px;
    text-decoration: none;
    font-size: {{ block.settings.pagination_font_size }}px;
    font-weight: 500;
    transition: all 0.3s ease;
  }

  .ai-blog-pagination-button-{{ ai_gen_id }}:hover:not(.ai-blog-pagination-active-{{ ai_gen_id }}) {
    background: {{ block.settings.pagination_button_hover_background }};
    color: {{ block.settings.pagination_button_hover_color }};
  }

  .ai-blog-pagination-active-{{ ai_gen_id }} {
    background: {{ block.settings.pagination_active_background }};
    color: {{ block.settings.pagination_active_color }};
    border-color: {{ block.settings.pagination_active_background }};
  }

  .ai-blog-pagination-disabled-{{ ai_gen_id }} {
    opacity: 0.4;
    pointer-events: none;
  }

  @media screen and (max-width: 989px) {
    .ai-blog-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }

    .ai-blog-layout-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-blog-sidebar-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-blog-hero-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.hero_title_size }}px * 0.8);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-blog-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-blog-hero-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.hero_title_size }}px * 0.6);
    }

    .ai-blog-hero-description-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.hero_description_size }}px * 0.9);
    }
  }
{% endstyle %}

<blog-section-{{ ai_gen_id }} class="ai-blog-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.show_hero %}
    <div class="ai-blog-hero-{{ ai_gen_id }}">
      {% if block.settings.hero_overlay_opacity > 0 %}
        <div class="ai-blog-hero-overlay-{{ ai_gen_id }}"></div>
      {% endif %}
      <div class="ai-blog-hero-content-{{ ai_gen_id }}">
        {% if block.settings.hero_title != blank %}
          <h1 class="ai-blog-hero-title-{{ ai_gen_id }}">{{ block.settings.hero_title }}</h1>
        {% endif %}
        {% if block.settings.hero_description != blank %}
          <div class="ai-blog-hero-description-{{ ai_gen_id }}">{{ block.settings.hero_description }}</div>
        {% endif %}
      </div>
    </div>
  {% endif %}

  <div class="ai-blog-container-{{ ai_gen_id }}">
    <div class="ai-blog-layout-{{ ai_gen_id }}">
      <div class="ai-blog-main-{{ ai_gen_id }}">
        {% paginate blog.articles by block.settings.posts_per_page %}
          <div class="ai-blog-grid-{{ ai_gen_id }}">
            {% for article in blog.articles %}
              <article class="ai-blog-card-{{ ai_gen_id }}">
                {% if block.settings.show_featured_image and article.image %}
                  <div class="ai-blog-card-image-wrapper-{{ ai_gen_id }}">
                    <img
                      src="{{ article.image | image_url: width: 800 }}"
                      alt="{{ article.image.alt | escape }}"
                      class="ai-blog-card-image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="800"
                      height="{% if block.settings.image_aspect_ratio == '16-9' %}450{% elsif block.settings.image_aspect_ratio == '4-3' %}600{% elsif block.settings.image_aspect_ratio == '1-1' %}800{% else %}1066{% endif %}"
                    >
                    {% if block.settings.image_overlay_opacity > 0 %}
                      <div class="ai-blog-card-image-overlay-{{ ai_gen_id }}"></div>
                    {% endif %}
                  </div>
                {% endif %}

                <div class="ai-blog-card-content-{{ ai_gen_id }}">
                  {% if block.settings.show_author or block.settings.show_date or block.settings.show_read_time %}
                    <div class="ai-blog-card-meta-{{ ai_gen_id }}">
                      {% if block.settings.show_author %}
                        <div class="ai-blog-card-author-{{ ai_gen_id }}">
                          {% if block.settings.show_author_avatar %}
                            <div class="ai-blog-card-author-avatar-{{ ai_gen_id }}">
                              {{ article.author | slice: 0 | upcase }}
                            </div>
                          {% endif %}
                          <span>{{ article.author }}</span>
                        </div>
                      {% endif %}
                      {% if block.settings.show_date %}
                        <time class="ai-blog-card-date-{{ ai_gen_id }}" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                          {{ article.published_at | date: block.settings.date_format }}
                        </time>
                      {% endif %}
                      {% if block.settings.show_read_time %}
                        {% assign word_count = article.content | strip_html | split: ' ' | size %}
                        {% assign read_time = word_count | divided_by: 200 %}
                        {% if read_time < 1 %}{% assign read_time = 1 %}{% endif %}
                        <span class="ai-blog-card-read-time-{{ ai_gen_id }}">{{ read_time }} min read</span>
                      {% endif %}
                    </div>
                  {% endif %}

                  {% if block.settings.show_tags and article.tags.size > 0 %}
                    <div class="ai-blog-card-tags-{{ ai_gen_id }}">
                      {% for tag in article.tags limit: 3 %}
                        <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="ai-blog-card-tag-{{ ai_gen_id }}">
                          {{ tag }}
                        </a>
                      {% endfor %}
                    </div>
                  {% endif %}

                  <h2 class="ai-blog-card-title-{{ ai_gen_id }}">
                    <a href="{{ article.url }}" class="ai-blog-card-title-link-{{ ai_gen_id }}">
                      {{ article.title }}
                    </a>
                  </h2>

                  {% if block.settings.show_excerpt %}
                    <div class="ai-blog-card-excerpt-{{ ai_gen_id }}">
                      {% if article.excerpt != blank %}
                        {{ article.excerpt | strip_html | truncatewords: block.settings.excerpt_word_count }}
                      {% else %}
                        {{ article.content | strip_html | truncatewords: block.settings.excerpt_word_count }}
                      {% endif %}
                    </div>
                  {% endif %}

                  <a href="{{ article.url }}" class="ai-blog-card-button-{{ ai_gen_id }}">
                    {{ block.settings.button_text }}
                  </a>
                </div>
              </article>
            {% endfor %}
          </div>

          {% if paginate.pages > 1 %}
            <nav class="ai-blog-pagination-{{ ai_gen_id }}" role="navigation" aria-label="Blog pagination">
              {% if paginate.previous %}
                <a href="{{ paginate.previous.url }}" class="ai-blog-pagination-button-{{ ai_gen_id }}" aria-label="Previous page">
                  {{ block.settings.pagination_previous_text }}
                </a>
              {% else %}
                <span class="ai-blog-pagination-button-{{ ai_gen_id }} ai-blog-pagination-disabled-{{ ai_gen_id }}">
                  {{ block.settings.pagination_previous_text }}
                </span>
              {% endif %}

              {% if block.settings.show_page_numbers %}
                {% for part in paginate.parts %}
                  {% if part.is_link %}
                    <a href="{{ part.url }}" class="ai-blog-pagination-button-{{ ai_gen_id }}">
                      {{ part.title }}
                    </a>
                  {% else %}
                    {% if part.title == paginate.current_page %}
                      <span class="ai-blog-pagination-button-{{ ai_gen_id }} ai-blog-pagination-active-{{ ai_gen_id }}">
                        {{ part.title }}
                      </span>
                    {% else %}
                      <span class="ai-blog-pagination-button-{{ ai_gen_id }}">{{ part.title }}</span>
                    {% endif %}
                  {% endif %}
                {% endfor %}
              {% endif %}

              {% if paginate.next %}
                <a href="{{ paginate.next.url }}" class="ai-blog-pagination-button-{{ ai_gen_id }}" aria-label="Next page">
                  {{ block.settings.pagination_next_text }}
                </a>
              {% else %}
                <span class="ai-blog-pagination-button-{{ ai_gen_id }} ai-blog-pagination-disabled-{{ ai_gen_id }}">
                  {{ block.settings.pagination_next_text }}
                </span>
              {% endif %}
            </nav>
          {% endif %}
        {% endpaginate %}
      </div>

      {% if block.settings.show_sidebar %}
        <aside class="ai-blog-sidebar-{{ ai_gen_id }}">
          {% if block.settings.show_sidebar_categories and blog.all_tags.size > 0 %}
            <div class="ai-blog-sidebar-widget-{{ ai_gen_id }}">
              <h3 class="ai-blog-sidebar-title-{{ ai_gen_id }}">Categories</h3>
              <ul class="ai-blog-sidebar-list-{{ ai_gen_id }}">
                {% for tag in blog.all_tags limit: 10 %}
                  <li class="ai-blog-sidebar-list-item-{{ ai_gen_id }}">
                    <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="ai-blog-sidebar-link-{{ ai_gen_id }}">
                      {{ tag }}
                    </a>
                  </li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}

          {% if block.settings.show_sidebar_recent %}
            <div class="ai-blog-sidebar-widget-{{ ai_gen_id }}">
              <h3 class="ai-blog-sidebar-title-{{ ai_gen_id }}">Recent posts</h3>
              <ul class="ai-blog-sidebar-list-{{ ai_gen_id }}">
                {% for article in blog.articles limit: 5 %}
                  <li class="ai-blog-sidebar-list-item-{{ ai_gen_id }}">
                    <a href="{{ article.url }}" class="ai-blog-sidebar-link-{{ ai_gen_id }}">
                      {{ article.title }}
                    </a>
                  </li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}
        </aside>
      {% endif %}
    </div>
  </div>
</blog-section-{{ ai_gen_id }}>

<script>
  (function() {
    class BlogSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.initLazyLoading();
      }

      initLazyLoading() {
        if ('IntersectionObserver' in window) {
          const images = this.querySelectorAll('.ai-blog-card-image-{{ ai_gen_id }}');
          const imageObserver = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                const img = entry.target;
                img.src = img.src;
                observer.unobserve(img);
              }
            });
          });

          images.forEach(img => imageObserver.observe(img));
        }
      }
    }

    customElements.define('blog-section-{{ ai_gen_id }}', BlogSection{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Premium blog listing",
  "tag": null,
  "class": "ai-blog-section",
  "settings": [
