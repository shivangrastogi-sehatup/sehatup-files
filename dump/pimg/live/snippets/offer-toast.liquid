{%- comment -%}
  Shared "code copied" message for the Diwali offer (announcement bar, collection hero).
  window.offerCopy(code, text) copies the code and shows text as a small notification,
  bottom right above the chat bubble, until closed (or after 10 seconds).
{%- endcomment -%}
<style>
  .offer-toast { position: fixed; z-index: 1000; right: 20px; bottom: 112px; display: flex; align-items: flex-start; gap: 10px; width: min(360px, calc(100vw - 32px)); padding: 14px 12px 14px 16px; border: 1px solid #efdcb8; border-radius: 14px; background: #fff; color: #1d1d1d; box-shadow: 0 16px 36px -16px rgba(29, 29, 29, .35); font: 500 13.5px/1.5 'Montserrat', sans-serif; opacity: 0; transform: translateX(40px); transition: transform .4s ease-in, opacity .35s ease-in, visibility 0s linear .4s; visibility: hidden; }
  .offer-toast.is-on { opacity: 1; transform: none; visibility: visible; transition: transform .8s cubic-bezier(.16, 1, .3, 1), opacity .6s ease-out, visibility 0s; animation: offer-toast-glow 1.6s .7s ease-out 1; }
  @keyframes offer-toast-glow { 0% { border-color: #efdcb8; box-shadow: 0 16px 36px -16px rgba(29, 29, 29, .35), 0 0 0 0 rgba(217, 154, 43, .45); } 40% { border-color: #d99a2b; box-shadow: 0 16px 36px -16px rgba(29, 29, 29, .35), 0 0 0 6px rgba(217, 154, 43, .18); } 100% { border-color: #efdcb8; box-shadow: 0 16px 36px -16px rgba(29, 29, 29, .35), 0 0 0 10px rgba(217, 154, 43, 0); } }
  .offer-toast__ico { flex: none; width: 20px; height: 20px; margin-top: 1px; fill: none; stroke: #d99a2b; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .offer-toast__t { flex: 1; min-width: 0; margin: 0; }
  .offer-toast__t b { color: #8f1836; font-weight: 700; letter-spacing: .03em; }
  .offer-toast__x { flex: none; display: grid; place-items: center; width: 28px; height: 28px; margin: -4px -2px 0 0; padding: 0; border: 0; border-radius: 8px; background: none; color: #5f5a56; cursor: pointer; }
  .offer-toast__x:hover { background: #fffaf3; color: #1d1d1d; }
  .offer-toast__x:focus-visible { outline: 2px solid #1d1d1d; outline-offset: 1px; }
  .offer-toast__x svg { width: 12px; height: 12px; }
  @media (max-width: 749.98px) { .offer-toast { right: 16px; bottom: 96px; } }
  @media (prefers-reduced-motion: reduce) { .offer-toast, .offer-toast.is-on { transition: none; animation: none; } }
</style>
<script>
  window.offerCopy = window.offerCopy || function (code, text) {
    try { navigator.clipboard.writeText(code).catch(function () {}); } catch (err) {}
    var t = document.querySelector('.offer-toast');
    if (!t) {
      t = document.createElement('div');
      t.className = 'offer-toast';
      t.setAttribute('role', 'status');
      t.setAttribute('aria-live', 'polite');
      t.innerHTML = '<svg class="offer-toast__ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 13h17c0 3.6-3.8 6.2-8.5 6.2S3.5 16.6 3.5 13z"/><path d="M12 13V9.5"/><path d="M12 9.5c-1.3-1.5-1.3-3.2 0-4.8 1.3 1.6 1.3 3.3 0 4.8z"/></svg>'
        + '<p class="offer-toast__t"></p>'
        + '<button type="button" class="offer-toast__x" aria-label="Close"><svg viewBox="0 0 12 12" aria-hidden="true"><path d="M1 1l10 10M11 1L1 11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></button>';
      document.body.appendChild(t);
      t.querySelector('.offer-toast__x').addEventListener('click', function () { clearTimeout(t._h); t.classList.remove('is-on'); });
    }
    var safe = function (s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); };
    t.querySelector('.offer-toast__t').innerHTML = safe(text).split('[code]').join('<b>' + safe(code) + '</b>');
    t.classList.add('is-on');
    clearTimeout(t._h);
    t._h = setTimeout(function () { t.classList.remove('is-on'); }, 10000);
  };
</script>
