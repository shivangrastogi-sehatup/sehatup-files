# ── APPS SCRIPT ENDPOINTS (preferred) ─────────────────────────────────────
# One Web App deployment per board, all running apps-script/Code.gs with a
# different CONFIG.SOURCE. Each returns its own board's current AND previous
# month; the dashboard fetches all three in parallel. They read the sheets
# natively, so they don't touch the Sheets API's 60-reads-per-minute quota that
# the /api/sheet path below kept hitting.
#
# ALL THREE must be set for the dashboard to use them — a half-configured set
# would show one live board beside two empty ones, which reads on the wall as a
# sales collapse rather than a misconfiguration. Leave any blank and the whole
# thing falls back to /api/sheet. See apps-script/Code.gs for deploy steps.
#
# NOTE: VITE_ vars are compiled into the browser bundle. Anyone who can open the
# board can read this key and call the endpoints directly, so only point these at
# data you're comfortable having behind a shared secret rather than a real login.
# If that isn't acceptable, keep using /api/sheet instead.
VITE_SHEETS_KEY=the_same_long_random_string_you_put_in_Code.gs
VITE_SHEETS_ENDPOINT_HEALTH=https://script.google.com/macros/s/AKfycb.../exec
VITE_SHEETS_ENDPOINT_QUICK=https://script.google.com/macros/s/AKfycb.../exec
VITE_SHEETS_ENDPOINT_MENS=https://script.google.com/macros/s/AKfycb.../exec

# ── SERVER-SIDE ONLY (no VITE_ prefix → never exposed to the browser) ──
# Used by the serverless function api/sheet.js — the fallback data path.
# Once the Apps Script endpoint above is live these can be removed, along with
# api/sheet.js and the googleapis dependency.

# Base64 of the entire service-account JSON key file.
#   Create it:  base64 -w0 service-account.json     (Linux/Git Bash)
#               [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))   (PowerShell)
GOOGLE_SERVICE_ACCOUNT_JSON=base64_of_your_service_account_json_here

# Per-sheet tab selector. Each SHEET_TAB_* may be:
#   auto:month          → current "<Month> <Year>" tab (e.g. "June 2026"), rolls over monthly
#   auto:leads          → current "<Month> <Year> LEADS" tab (Healthscore per-lead board)
#   auto:afterconsult   → current "<Month> <Year> After Consultation" tab
#   <number>            → a specific tab gid (the number after gid= in the URL)
#   <Tab Title>         → a literal tab name
# Healthscore 360 — per-lead monthly "LEADS" tab (Caller 1 + Call Status).
SHEET_ID_HEALTH=1140R1IZCvNyNezYCvW_5cVltWFkJ4oFGHEH9bpmRh6M
SHEET_TAB_HEALTH=auto:leads
# Quick Reply Leads — per-lead monthly tab (Caller 1 + Status; "Order Placed" = conversion).
SHEET_ID_QUICK=1p_p0Ti0owVswnZI-N263UIJ-5pt3H7WxJbwdazALksg
SHEET_TAB_QUICK=auto:month

# Men's Wellness — monthly ORDERS board (Date, Pdt Name, Product Value, Mode,
# Lead Source, Agent Name). This is the revenue + orders basis.
SHEET_ID_MENS=your_mens_wellness_sheet_id
SHEET_TAB_MENS=auto:month
