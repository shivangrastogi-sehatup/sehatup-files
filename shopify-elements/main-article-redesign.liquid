    { "type": "text", "id": "cta_button", "label": "Button", "default": "Request a call back" },
    { "type": "textarea", "id": "cta_consent", "label": "Consent line", "default": "We call 10 am to 8 pm. Your number stays private." },
    { "type": "url", "id": "privacy_url", "label": "Privacy policy link" },
    { "type": "checkbox", "id": "show_topic", "label": "Ask what they need help with", "default": false },
    { "type": "text", "id": "topics", "label": "Topic options", "default": "Stamina and performance, Low energy, Stress and sleep, Something else" },
    { "type": "text", "id": "trust_1", "label": "Trust point 1", "default": "AYUSH certified" },
    { "type": "text", "id": "trust_2", "label": "Trust point 2", "default": "Verified doctors" },
    { "type": "text", "id": "trust_3", "label": "Trust point 3", "default": "Private", "info": "The three trust points share one line and never wrap, so keep them very short - the rail is 300px wide." },
    { "type": "url", "id": "whatsapp_url", "label": "WhatsApp link" },
    { "type": "text", "id": "whatsapp_label", "label": "WhatsApp label", "default": "Chat on WhatsApp" },
    { "type": "text", "id": "done_title", "label": "Success heading", "default": "We have your number" },
    { "type": "textarea", "id": "done_dek", "label": "Success sub-line", "default": "A doctor calls you back today, 10 am to 8 pm." },
    { "type": "text", "id": "lead_endpoint", "label": "Lead endpoint URL", "info": "The Apps Script Web App /exec URL. The deployment must be set to Anyone, not Anyone with Google Account. Blank means the form validates but sends nothing.", "default": "https://script.google.com/macros/s/AKfycbx7NDoB9rbbvvJGSh9J5HCNjg4WAOri1AX8gVRlrMiYClr6J04I4JpJ55B2ceETCJeI/exec" },
    { "type": "text", "id": "lead_token", "label": "Shared token", "info": "Must match SHARED_TOKEN in blog-lead-sheet.gs exactly. Filters drive-by bots; it travels in the page source, so it is not a secret.", "default": "sehatup-blog-J7d3qHngA8KDmBBuUNl3FCYK" },
    { "type": "text", "id": "lead_collection", "label": "Sheet tab name", "default": "Blog leads" },
    { "type": "range", "id": "sticky_top", "label": "Sticky offset", "min": 0, "max": 180, "step": 4, "unit": "px", "default": 20, "info": "Clearance under a header that stays on screen. Measured from the live header on load, so this is only the value used before the script runs." },

    { "type": "header", "content": "Mobile bar" },
    { "type": "checkbox", "id": "show_mobile_bar", "label": "Show the sticky bar on mobile", "default": true },
    { "type": "text", "id": "bar_button", "label": "Bar button", "default": "Book call" },
    { "type": "text", "id": "bar_text", "label": "Bar text", "default": "Free doctor consultation", "info": "One short line. It shares a narrow bar with the button and the WhatsApp bubble." },
    { "type": "range", "id": "bar_trigger", "label": "Show after", "min": 10, "max": 60, "step": 2, "unit": "%", "default": 22 },

    { "type": "header", "content": "Formulation panel" },
    { "type": "paragraph", "content": "Per post. Set article.metafields.custom.formulation (JSON) on each article. Without it the panel does not render, so a men's formula never lands on a women's post." },
    { "type": "checkbox", "id": "panel_fallback", "label": "Fall back to the Ingredient blocks below", "default": false, "info": "Off is right for a mixed blog. On puts the same ingredient list on every post that has no metafield." },
    { "type": "text", "id": "panel_kicker", "label": "Kicker", "default": "What is inside" },
    { "type": "text", "id": "panel_title", "label": "Title", "default": "Vaji Bati" },
    { "type": "text", "id": "panel_note", "label": "Footnote", "default": "AYUSH certified. No added hormones." },
    { "type": "url", "id": "panel_link", "label": "Product link" },
    { "type": "text", "id": "panel_link_label", "label": "Product link label", "default": "See the product" },

    { "type": "header", "content": "Latest blogs" },
    { "type": "text", "id": "latest_title", "label": "List label", "default": "Latest blogs" },
    { "type": "range", "id": "latest_count", "label": "How many", "min": 2, "max": 6, "step": 1, "default": 4 },

    { "type": "header", "content": "Reading" },
    { "type": "checkbox", "id": "show_progress", "label": "Show the reading progress line", "default": true },

    { "type": "header", "content": "Colour" },
    { "type": "color", "id": "color_brand", "label": "Action", "default": "#ee204a" },
    { "type": "color", "id": "color_brand_deep", "label": "Action pressed", "default": "#c8143a" },
    { "type": "color", "id": "color_wine", "label": "Structure", "default": "#55123a" }
  ],
  "blocks": [
    {
      "type": "herb",
      "name": "Ingredient",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Ashwagandha" },
        { "type": "text", "id": "botanical", "label": "Botanical name", "default": "Withania somnifera" },
        { "type": "text", "id": "use", "label": "Traditional use", "default": "Traditionally used to help the body manage stress." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Article",
      "blocks": [
        { "type": "herb" },
        { "type": "herb", "settings": { "name": "Shilajit", "botanical": "Asphaltum punjabianum", "use": "A mineral rich resin from the Himalayas, traditionally used for stamina." } },
        { "type": "herb", "settings": { "name": "Safed Musli", "botanical": "Chlorophytum borivilianum", "use": "Traditionally associated with libido and reproductive wellness." } },
        { "type": "herb", "settings": { "name": "Kaunch Beej", "botanical": "Mucuna pruriens", "use": "Traditionally used to support hormonal balance and vitality." } },
        { "type": "herb", "settings": { "name": "Gokshura", "botanical": "Tribulus terrestris", "use": "Traditionally used to support stamina and performance." } }
      ]
    }
  ]
}
