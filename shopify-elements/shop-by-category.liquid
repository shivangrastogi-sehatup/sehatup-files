{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-shop-category-{{ ai_gen_id }} {
    display: block;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.section_background_color }};
    width: 100%;
  }

  .ai-shop-category-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-shop-category-heading-{{ ai_gen_id }} {
    font-size: clamp(24px,3.4vw,64px);
    font-weight: {{ block.settings.heading_weight }};
    text-align: {{ block.settings.heading_alignment }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
  }

  .ai-shop-category-grid-wrapper-{{ ai_gen_id }} {
    display: flex;
    {% if block.settings.card_alignment == 'center' %}
      justify-content: center;
    {% elsif block.settings.card_alignment == 'start' %}
      justify-content: flex-start;
    {% elsif block.settings.card_alignment == 'end' %}
      justify-content: flex-end;
    {% endif %}
  }

  .ai-shop-category-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.cards_per_row_desktop }}, auto);
    gap: {{ block.settings.card_gap }}px;
    width: max-content;
  }

  {% if block.settings.mobile_scroll_behavior == 'scroll' %}
    @media screen and (max-width: 749px) {
      .ai-shop-category-grid-{{ ai_gen_id }} {
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        gap: {{ block.settings.card_gap | times: 0.8 }}px;
        padding-bottom: 10px;
      }

      .ai-shop-category-grid-{{ ai_gen_id }}::-webkit-scrollbar {
        height: 6px;
      }

      .ai-shop-category-grid-{{ ai_gen_id }}::-webkit-scrollbar-track {
        background: rgba(0, 0, 0, 0.1);
        border-radius: 3px;
      }

      .ai-shop-category-grid-{{ ai_gen_id }}::-webkit-scrollbar-thumb {
        background: rgba(0, 0, 0, 0.3);
        border-radius: 3px;
      }

      .ai-shop-category-card-{{ ai_gen_id }} {
        flex: 0 0 auto;
        scroll-snap-align: start;
        width: {{ block.settings.mobile_image_size | times: 1.2 }}px;
      }
    }
  {% endif %}

  .ai-shop-category-card-{{ ai_gen_id }} {
    text-align: center;
    cursor: pointer;
    transition: transform 0.3s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ai-shop-category-card-{{ ai_gen_id }}:hover {
    {% if block.settings.hover_effect == 'zoom' %}
      transform: scale(1.05);
    {% elsif block.settings.hover_effect == 'lift' %}
      transform: translateY(-8px);
    {% endif %}
  }

  .ai-shop-category-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.image_size }}px;
    height: {{ block.settings.image_size }}px;
    margin: 0 0 {{ block.settings.text_spacing }}px;
    transition: box-shadow 0.3s ease;
    flex-shrink: 0;
  }

  .ai-shop-category-card-{{ ai_gen_id }}:hover .ai-shop-category-image-wrapper-{{ ai_gen_id }} {
    {% if block.settings.hover_effect == 'shadow' %}
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
    {% endif %}
  }

  .ai-shop-category-image-bg-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    height: 100%;
    border-radius: 50%;
    z-index: 1;
  }

  .ai-shop-category-image-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    z-index: 2;
    border-style: solid;
  }

  .ai-shop-category-image-placeholder-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    z-index: 2;
  }

  .ai-shop-category-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-shop-category-title-{{ ai_gen_id }} {
    font-size: clamp(16px,1.55vw,34px);
    font-weight: {{ block.settings.title_weight }};
    margin: 0 0 {{ block.settings.description_spacing }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-shop-category-description-{{ ai_gen_id }} {
    font-size: clamp(10px, 1vw, 20px);
    line-height: {{ block.settings.description_line_height }};
    margin: 0;
    text-align: {{ block.settings.text_alignment }};
  }

  @media screen and (max-width: 989px) {
    .ai-shop-category-grid-{{ ai_gen_id }} {
      {% if block.settings.mobile_scroll_behavior == 'grid' %}
        grid-template-columns: repeat({{ block.settings.cards_per_row_tablet }}, minmax(0, 1fr));
      {% endif %}
    }

    .ai-shop-category-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.9 }}px;
    }

    .ai-shop-category-image-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.image_size | times: 0.85 }}px;
      height: {{ block.settings.image_size | times: 0.85 }}px;
    }

    .ai-shop-category-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.9 }}px;
    }

    .ai-shop-category-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-shop-category-grid-{{ ai_gen_id }} {
      {% if block.settings.mobile_scroll_behavior == 'grid' %}
        grid-template-columns: repeat({{ block.settings.cards_per_row_mobile }}, minmax(0, 1fr));
      {% endif %}
    }

    .ai-shop-category-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_heading_size }}px;
    }

    .ai-shop-category-image-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_image_size }}px;
      height: {{ block.settings.mobile_image_size }}px;
    }

    .ai-shop-category-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_title_size }}px;
    }

    .ai-shop-category-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_description_size }}px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-shop-category-card-{{ ai_gen_id }},
    .ai-shop-category-image-wrapper-{{ ai_gen_id }} {
      transition: none;
    }
  }
{% endstyle %}

<shop-by-category-{{ ai_gen_id }}
  class="ai-shop-category-{{ ai_gen_id }}"
  data-scroll-offset="{{ block.settings.scroll_offset }}"
  data-scroll-duration="{{ block.settings.scroll_duration }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-shop-category-container-{{ ai_gen_id }}">
    {% if block.settings.section_heading != blank %}
      <h2 class="ai-shop-category-heading-{{ ai_gen_id }}">{{ block.settings.section_heading }}</h2>
    {% endif %}

    <div class="ai-shop-category-grid-wrapper-{{ ai_gen_id }}">
      <div class="ai-shop-category-grid-{{ ai_gen_id }}">
        {% for i in (1..8) %}
          {% liquid
            assign card_enabled_key = 'card_' | append: i | append: '_enabled'
            assign card_image_key = 'card_' | append: i | append: '_image'
            assign card_bg_color_key = 'card_' | append: i | append: '_bg_color'
            assign card_border_color_key = 'card_' | append: i | append: '_border_color'
            assign card_border_width_key = 'card_' | append: i | append: '_border_width'
            assign card_title_key = 'card_' | append: i | append: '_title'
            assign card_description_key = 'card_' | append: i | append: '_description'
            assign card_link_key = 'card_' | append: i | append: '_link'
            assign card_section_id_key = 'card_' | append: i | append: '_section_id'
            assign card_scroll_behavior_key = 'card_' | append: i | append: '_scroll_behavior'

            assign card_enabled = block.settings[card_enabled_key]
            assign card_image = block.settings[card_image_key]
            assign card_bg_color = block.settings[card_bg_color_key]
            assign card_border_color = block.settings[card_border_color_key]
            assign card_border_width = block.settings[card_border_width_key]
            assign card_title = block.settings[card_title_key]
            assign card_description = block.settings[card_description_key]
            assign card_link = block.settings[card_link_key]
            assign card_section_id = block.settings[card_section_id_key]
            assign card_scroll_behavior = block.settings[card_scroll_behavior_key]
          %}

          {% if card_enabled %}
            <div
              class="ai-shop-category-card-{{ ai_gen_id }}"
              data-card-index="{{ i }}"
              {% if card_scroll_behavior == 'scroll' and card_section_id != blank %}
                data-scroll-target="{{ card_section_id }}"
              {% elsif card_link != blank %}
                data-link-url="{{ card_link }}"
              {% endif %}
            >
              <div class="ai-shop-category-image-wrapper-{{ ai_gen_id }}">
                <div
                  class="ai-shop-category-image-bg-{{ ai_gen_id }}"
                  style="background-color: {{ card_bg_color }};"
                ></div>
                {% if card_image %}
                  <img
                    src="{{ card_image | image_url: width: 600 }}"
                    alt="{{ card_title | escape }}"
                    class="ai-shop-category-image-{{ ai_gen_id }}"
                    style="border-color: {{ card_border_color }}; border-width: {{ card_border_width }}px;"
                    loading="lazy"
                    width="600"
                    height="600"
                  >
                {% else %}
                  <div
                    class="ai-shop-category-image-placeholder-{{ ai_gen_id }}"
                    style="border: {{ card_border_width }}px solid {{ card_border_color }};"
                  >
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>

              {% if card_title != blank %}
                <h3 class="ai-shop-category-title-{{ ai_gen_id }}">{{ card_title }}</h3>
              {% endif %}

              {% if card_description != blank %}
                <p class="ai-shop-category-description-{{ ai_gen_id }}">{{ card_description }}</p>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</shop-by-category-{{ ai_gen_id }}>

<script>
  (function () {
    class ShopByCategory{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.scrollOffset = parseInt(this.dataset.scrollOffset) || 0;
        this.scrollDuration = parseInt(this.dataset.scrollDuration) || 800;
      }

      connectedCallback() {
        this.cards = this.querySelectorAll('.ai-shop-category-card-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.cards.forEach((card) => {
          card.addEventListener('click', () => {
            const scrollTarget = card.dataset.scrollTarget;
            const linkUrl = card.dataset.linkUrl;

            if (scrollTarget) {
              this.scrollToSection(scrollTarget);
            } else if (linkUrl) {
              window.location.href = linkUrl;
            }
          });

          card.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ' || e.key === 'Spacebar') {
              e.preventDefault();
              card.click();
            }
          });

          card.setAttribute('tabindex', '0');
          card.setAttribute('role', 'button');
        });
      }

      prefersReducedMotion() {
        return window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      }

      scrollToSection(sectionId) {
        const target = document.getElementById(sectionId);

        if (!target) {
          console.warn('[shop-by-category] target section not found:', sectionId);
          return;
        }

        target.style.scrollMarginTop = this.scrollOffset + 'px';

        if (this.prefersReducedMotion()) {
          target.scrollIntoView({ block: 'start', behavior: 'auto' });
          return;
        }

        if ('scrollBehavior' in document.documentElement.style) {
          target.scrollIntoView({ block: 'start', behavior: 'smooth' });
          return;
        }

        this.animateScrollTo(target);
      }

      animateScrollTo(target) {
        const startPosition = window.pageYOffset;
        const targetPosition = target.getBoundingClientRect().top + startPosition - this.scrollOffset;
        const distance = targetPosition - startPosition;
        const duration = this.scrollDuration;
        const root = document.documentElement;
        const previousBehavior = root.style.scrollBehavior;

        root.style.scrollBehavior = 'auto';

        let startTime = null;

        const step = (currentTime) => {
          if (startTime === null) startTime = currentTime;

          const progress = Math.min((currentTime - startTime) / duration, 1);
          const ease =
            progress < 0.5
              ? 4 * progress * progress * progress
              : 1 - Math.pow(-2 * progress + 2, 3) / 2;

          const y = startPosition + distance * ease;

          try {
            window.scrollTo({ top: y, left: 0, behavior: 'instant' });
          } catch (err) {
            window.scrollTo(0, y);
          }

          if (progress < 1) {
            requestAnimationFrame(step);
          } else {
            root.style.scrollBehavior = previousBehavior;
          }
        };

        requestAnimationFrame(step);
      }
    }

    customElements.define('shop-by-category-{{ ai_gen_id }}', ShopByCategory{{ ai_gen_id }});
  })();
</script>

