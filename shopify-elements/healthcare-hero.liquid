{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{%- liquid
  assign fg_scale = block.settings.foreground_image_scale | default: 100
  assign fg_x = block.settings.foreground_position_x
  assign fg_y = block.settings.foreground_position_y
  assign fg_ox = block.settings.foreground_offset_x | default: 0
  assign fg_oy = block.settings.foreground_offset_y | default: 0

  assign fg_tx = '0'
  assign fg_ty = '0'
  if fg_x == 'center'
    assign fg_tx = '-50%'
  endif
  if fg_y == 'center'
    assign fg_ty = '-50%'
  endif

  assign ov = block.settings.background_overlay_strength | default: 0
  assign ov_alpha = ov | divided_by: 100.0
-%}

{% style %}

    .ai-healthcare-hero-{{ ai_gen_id }} {
      display: block;
      position: relative;
      width: 100%;
      max-width: {{ block.settings.desktop_width_percent }}%;
      margin-left: auto;
      margin-right: auto;
      min-height: {{ block.settings.section_min_height }}px;
      overflow: hidden;
    }

    .ai-healthcare-hero__background-{{ ai_gen_id }} {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
    }

    .ai-healthcare-hero__background-image-{{ ai_gen_id }} {
      width: 100%;
      height: 100%;
      object-fit: {{ block.settings.background_image_size }};
      object-position: {{ block.settings.background_position_x }} {{ block.settings.background_position_y }};
      transform: scale(1.08);
      opacity: {{ block.settings.background_overlay_opacity | divided_by: 100.0 }};
    }

    .ai-healthcare-hero__background-placeholder-{{ ai_gen_id }} {
      width: 100%;
      height: 100%;
      background-color: #f4f4f4;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 1.0;
    }

    .ai-healthcare-hero__background-placeholder-{{ ai_gen_id }} svg {
      width: 100%;
      height: 100%;
      max-width: 600px;
      max-height: 600px;
    }

    .ai-healthcare-hero__background-overlay-{{ ai_gen_id }} {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
      {% if ov > 0 %}
        background-color: rgba({{ block.settings.background_overlay_color.rgb }}, {{ ov_alpha }});
      {% endif %}
    }

    {% if block.settings.layout_mode == 'split-layout' or block.settings.show_white_panel %}
      .ai-healthcare-hero__white-panel-{{ ai_gen_id }} {
        position: absolute;
        top: 0;
        left: 0;
        width: {{ block.settings.white_panel_width }}%;
        height: 100%;
        background-color: {{ block.settings.white_panel_color }};
        opacity: {{ block.settings.white_panel_opacity | divided_by: 100.0 }};
        z-index: 1;
        {% if block.settings.white_panel_rounded %}
          border-radius: 0 {{ block.settings.white_panel_border_radius }}px {{ block.settings.white_panel_border_radius }}px 0;
        {% endif %}
      }
    {% endif %}

    .ai-healthcare-hero__container-{{ ai_gen_id }} {
      position: relative;
      z-index: 2;
      max-width: {{ block.settings.content_max_width }}px;
      margin: 0 auto;
      margin-left: 50px;
      padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
      min-height: {{ block.settings.section_min_height }}px;
      display: flex;
      align-items: center;
      {% if block.settings.content_position == 'left' %}
        justify-content: flex-start;
      {% elsif block.settings.content_position == 'center' %}
        justify-content: center;
      {% else %}
        justify-content: flex-end;
      {% endif %}
    }

    .ai-healthcare-hero__content-{{ ai_gen_id }} {
      max-width: {{ block.settings.content_text_max_width }}px;
      color: #ffffff;
      {% if block.settings.content_position == 'center' %}
        text-align: center;
      {% elsif block.settings.content_position == 'right' %}
        text-align: right;
      {% else %}
        text-align: left;
      {% endif %}
    }

    .ai-healthcare-hero__heading-{{ ai_gen_id }} {
      font-size: clamp(24px, 3.4vw, {{ block.settings.heading_size }}px);
      font-weight: {{ block.settings.heading_weight }};
      color: {{ block.settings.heading_color }};
      margin: 0 0 {{ block.settings.content_spacing }}px;
      line-height: 1.2;
      {% if block.settings.text_shadow_enabled %}
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
      {% endif %}
    }

    .ai-healthcare-hero__subheading-{{ ai_gen_id }} {
      font-size: clamp(16px, 3.4vw, {{ block.settings.subheading_size }}px);
      font-weight: {{ block.settings.subheading_weight }};
      color: {{ block.settings.subheading_color }};
      margin: 0 0 {{ block.settings.content_spacing }}px;
      line-height: 1.4;
      {% if block.settings.text_shadow_enabled %}
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
      {% endif %}
    }

    .ai-healthcare-hero__body-{{ ai_gen_id }} {
      font-size: clamp(10px, 3.4vw, {{ block.settings.body_size }}px);
      color: {{ block.settings.body_color }};
      margin: 0 0 {{ block.settings.content_spacing }}px;
      line-height: 1.6;
      {% if block.settings.text_shadow_enabled %}
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
      {% endif %}
    }

    .ai-healthcare-hero__buttons-{{ ai_gen_id }} {
      display: flex;
      gap: 16px;
      margin-top: {{ block.settings.button_spacing }}px;
      {% if block.settings.button_layout == 'stacked' %}
        flex-direction: column;
        align-items: {% if block.settings.content_position == 'center' %}center{% elsif block.settings.content_position == 'right' %}flex-end{% else %}flex-start{% endif %};
      {% else %}
        flex-direction: row;
        flex-wrap: wrap;
        {% if block.settings.content_position == 'center' %}
          justify-content: center;
        {% elsif block.settings.content_position == 'right' %}
          justify-content: flex-end;
        {% else %}
          justify-content: flex-start;
        {% endif %}
      {% endif %}
    }

    .ai-healthcare-hero__button-{{ ai_gen_id }} {
      display: inline-block;
      padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
      font-size: {{ block.settings.button_font_size }}px;
      font-weight: {{ block.settings.button_font_weight }};
      text-decoration: none;
      border-radius: {{ block.settings.button_border_radius }}px;
      transition: all 0.3s ease;
      cursor: pointer;
      border: 2px solid transparent;
      {% if block.settings.button_layout == 'stacked' %}
        width: 100%;
        max-width: 300px;
        text-align: center;
      {% endif %}
    }

    .ai-healthcare-hero__button-primary-{{ ai_gen_id }} {
      background-color: {{ block.settings.button_1_bg_color }};
      color: {{ block.settings.button_1_text_color }};
      border-color: {{ block.settings.button_1_border_color }};
      {% if block.settings.button_1_style == 'outline' %}
        background-color: transparent;
        border-color: {{ block.settings.button_1_bg_color }};
        color: {{ block.settings.button_1_bg_color }};
      {% endif %}
    }

    .ai-healthcare-hero__button-primary-{{ ai_gen_id }}:hover {
      background-color: {{ block.settings.button_1_hover_bg_color }};
      color: {{ block.settings.button_1_hover_text_color }};
      border-color: {{ block.settings.button_1_hover_border_color }};
      transform: translateY(-2px);
    }

    .ai-healthcare-hero__button-secondary-{{ ai_gen_id }} {
      background-color: {{ block.settings.button_2_bg_color }};
      color: {{ block.settings.button_2_text_color }};
      border-color: {{ block.settings.button_2_border_color }};
      {% if block.settings.button_2_style == 'outline' %}
        background-color: transparent;
        border-color: {{ block.settings.button_2_bg_color }};
        color: {{ block.settings.button_2_bg_color }};
      {% endif %}
    }

    .ai-healthcare-hero__button-secondary-{{ ai_gen_id }}:hover {
      background-color: {{ block.settings.button_2_hover_bg_color }};
      color: {{ block.settings.button_2_hover_text_color }};
      border-color: {{ block.settings.button_2_hover_border_color }};
      transform: translateY(-2px);
    }

    .hero-highlight-{{ ai_gen_id }} {
      color: {{ block.settings.subheading_highlight_color }};
      font-weight: 700;
    }

    {% if block.settings.layout_mode == 'background-with-overlay-image' and block.settings.foreground_image %}
      .ai-healthcare-hero__foreground-image-{{ ai_gen_id }} {
        position: absolute;
        z-index: 2;
        {% if fg_x == 'left' %}
          left: {{ fg_ox }}%;
        {% elsif fg_x == 'center' %}
          left: 50%;
        {% else %}
          right: {{ fg_ox }}%;
        {% endif %}
        {% if fg_y == 'top' %}
          top: {{ fg_oy }}%;
        {% elsif fg_y == 'center' %}
          top: 50%;
        {% else %}
          bottom: {{ fg_oy }}%;
        {% endif %}
        transform: translate({{ fg_tx }}, {{ fg_ty }});
      }

      .ai-healthcare-hero__foreground-image-{{ ai_gen_id }} img {
        height: calc({{ block.settings.section_min_height }}px * {{ fg_scale }} / 100);
        width: auto;
        object-fit: {{ block.settings.foreground_image_fit }};
        object-position: bottom center;
        display: block;
      }
    {% endif %}

    /* ============ CRITICAL OVERLAP FIX BELOW 1208px ============ */
    @media (max-width: 1208px) {
      .ai-healthcare-hero__container-{{ ai_gen_id }} {
        padding: {{ block.settings.section_padding_top | minus: 30 }}px 40px {{ block.settings.section_padding_bottom | minus: 30 }}px;
        min-height: 405px;
      }

      .ai-healthcare-hero__foreground-image-{{ ai_gen_id }} img {
        height: calc(380px * {{ fg_scale }} / 100);
      }

      .ai-healthcare-hero__buttons-{{ ai_gen_id }} {
        gap: 12px;
        margin-top: 22px;
      }

      .ai-healthcare-hero__button-{{ ai_gen_id }} {
        padding: 12px 22px;
        font-size: 13px;
      }
    }

    @media (max-width: 1140px) {
      .ai-healthcare-hero__foreground-image-{{ ai_gen_id }} img {
        height: calc(350px * {{ fg_scale }} / 100);
      }

      .ai-healthcare-hero__container-{{ ai_gen_id }} {
        padding: {{ block.settings.section_padding_top | minus: 30 }}px 40px {{ block.settings.section_padding_bottom | minus: 30 }}px;
        min-height: 368px;
      }
    }

    @media (max-width: 1084px) {
      .ai-healthcare-hero__container-{{ ai_gen_id }} {
        padding: {{ block.settings.section_padding_top | minus: 30 }}px 40px {{ block.settings.section_padding_bottom | minus: 30 }}px;
        min-height: 359px;
      }

      .ai-healthcare-hero__foreground-image-{{ ai_gen_id }} img {
        height: calc(320px * {{ fg_scale }} / 100);
      }

      .ai-healthcare-hero__buttons-{{ ai_gen_id }} {
        gap: 12px;
        margin-top: 22px;
      }

      .ai-healthcare-hero__button-{{ ai_gen_id }} {
        padding: 12px 22px;
        font-size: 11px;
      }
    }

    /* ============ PHONE PERFECT LAYOUT ============ */
    @media (max-width: 1040px) {
      .ai-healthcare-hero-{{ ai_gen_id }} {
        max-width: 100%;
      }

      .ai-healthcare-hero__container-{{ ai_gen_id }} {
        display: block;
        {% if block.settings.enable_mobile_overrides %}
          padding: {{ block.settings.section_padding_top_mobile }}px {{ block.settings.section_padding_horizontal_mobile }}px {{ block.settings.section_padding_bottom_mobile }}px;
          min-height: {% if block.settings.section_min_height_mobile > 0 %}{{ block.settings.section_min_height_mobile }}px{% else %}auto{% endif %};
        {% else %}
          padding: 24px 16px;
          min-height: auto;
        {% endif %}
        margin: 0;
      }

      {% if block.settings.enable_mobile_overrides %}
        .ai-healthcare-hero__background-image-{{ ai_gen_id }} {
          object-position: {{ block.settings.mobile_background_position_x }} {{ block.settings.mobile_background_position_y }};
        }
      {% endif %}

      .ai-healthcare-hero__content-{{ ai_gen_id }} {
        max-width: 100%;
        {% if block.settings.enable_mobile_overrides %}
          text-align: {{ block.settings.mobile_content_alignment }};
        {% else %}
          text-align: left;
        {% endif %}
      }

      .ai-healthcare-hero__heading-{{ ai_gen_id }} {
        font-size: 22px;
        line-height: 1.3;
      }

      .ai-healthcare-hero__subheading-{{ ai_gen_id }} {
        font-size: 13px;
        margin-top: 10px;
      }

      .ai-healthcare-hero__body-{{ ai_gen_id }} {
        font-size: 12px;
        margin-top: 10px;
      }

      .ai-healthcare-hero__buttons-{{ ai_gen_id }} {
        {% if block.settings.enable_mobile_overrides and block.settings.mobile_content_alignment == 'center' %}
          justify-content: center;
        {% elsif block.settings.enable_mobile_overrides and block.settings.mobile_content_alignment == 'right' %}
          justify-content: flex-end;
        {% else %}
          justify-content: flex-start;
        {% endif %}
        gap: 10px;
        margin-top: 16px;
        flex-wrap: wrap;
      }

      .ai-healthcare-hero__button-{{ ai_gen_id }} {
        padding: 10px 18px;
        font-size: 12px;
      }

      .ai-healthcare-hero__foreground-image-{{ ai_gen_id }} {
        {% if block.settings.hide_foreground_mobile %}
          display: none;
        {% else %}
          position: relative;
          left: auto;
          right: auto;
          top: auto;
          bottom: auto;
          transform: none;
          margin: 20px auto 0 auto;
          display: flex;
          justify-content: center;
          width: 100%;
        {% endif %}
      }

      .ai-healthcare-hero__foreground-image-{{ ai_gen_id }} img {
        height: auto;
        max-height: calc(300px * {{ fg_scale }} / 100);
        width: auto;
        max-width: 100%;
      }
    }
{% endstyle %}

<healthcare-hero-{{ ai_gen_id }} class="ai-healthcare-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-healthcare-hero__background-{{ ai_gen_id }}">
    {% if block.settings.background_image %}
      <img
        src="{{ block.settings.background_image | image_url: width: 1600 }}"
        fetchpriority="high"
        loading="eager"
        decoding="async"
        srcset="
        {{ block.settings.background_image | image_url: width: 480 }} 480w,
        {{ block.settings.background_image | image_url: width: 768 }} 768w,
        {{ block.settings.background_image | image_url: width: 1200 }} 1200w,
        {{ block.settings.background_image | image_url: width: 1600 }} 1600w
        "
        sizes="100vw"
        alt="{{ block.settings.background_image.alt | escape }}"
        width="{{ block.settings.background_image.width }}"
        height="{{ block.settings.background_image.height }}"
        class="ai-healthcare-hero__background-image-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-healthcare-hero__background-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
    <div class="ai-healthcare-hero__background-overlay-{{ ai_gen_id }}"></div>
  </div>

  {% if block.settings.layout_mode == 'split-layout' or block.settings.show_white_panel %}
    <div class="ai-healthcare-hero__white-panel-{{ ai_gen_id }}"></div>
  {% endif %}

  <div class="ai-healthcare-hero__container-{{ ai_gen_id }}">
    <div class="ai-healthcare-hero__content-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h1 class="ai-healthcare-hero__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h1>
      {% endif %}

      {% if block.settings.subheading_prefix != blank %}
        <div class="ai-healthcare-hero__subheading-{{ ai_gen_id }}">
          {{ block.settings.subheading_prefix }}
          {% if block.settings.subheading_highlight != blank %}
            <span class="hero-highlight-{{ ai_gen_id }}">
              {{ block.settings.subheading_highlight }}
            </span>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.body_text != blank %}
        <div class="ai-healthcare-hero__body-{{ ai_gen_id }}">
          {{ block.settings.body_text }}
        </div>
      {% endif %}

      {% if block.settings.button_1_text != blank or block.settings.button_2_text != blank %}
        <div class="ai-healthcare-hero__buttons-{{ ai_gen_id }}">
          {% if block.settings.button_1_text != blank %}
            <a
              href="{{ block.settings.button_1_link }}"
              class="ai-healthcare-hero__button-{{ ai_gen_id }} ai-healthcare-hero__button-primary-{{ ai_gen_id }}"
            >
              {{ block.settings.button_1_text }}
            </a>
          {% endif %}

          {% if block.settings.show_button_2 and block.settings.button_2_text != blank %}
            {% assign btn2_text_downcase = block.settings.button_2_text | downcase %}
            <a
              href="{{ block.settings.button_2_link }}"
              class="ai-healthcare-hero__button-{{ ai_gen_id }} ai-healthcare-hero__button-secondary-{{ ai_gen_id }}"
              {% if block.settings.enable_doctor_new_tab
                    and btn2_text_downcase contains 'talk to a doctor' %}
                target="_blank"
                rel="noopener noreferrer"
              {% endif %}
            >
              {{ block.settings.button_2_text }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>

  {% if block.settings.layout_mode == 'background-with-overlay-image' and block.settings.foreground_image %}
    <div class="ai-healthcare-hero__foreground-image-{{ ai_gen_id }}">
      <img
        src="{{ block.settings.foreground_image | image_url: width: 1000 }}"
        alt="{{ block.settings.foreground_image.alt | escape }}"
        loading="eager"
        width="{{ block.settings.foreground_image.width }}"
        height="{{ block.settings.foreground_image.height }}"
      >
    </div>
  {% endif %}
</healthcare-hero-{{ ai_gen_id }}>

<script>
  (function() {
    class HealthcareHero{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.init();
      }

      init() {
        const container = this;
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              container.classList.add('visible');
              observer.disconnect();
            }
          });
        }, { threshold: 0.1 });

        observer.observe(container);
      }
    }

    if (!customElements.get('healthcare-hero-{{ ai_gen_id }}')) {
      customElements.define('healthcare-hero-{{ ai_gen_id }}', HealthcareHero{{ ai_gen_id }});
    }
  })();
</script>

{% schema %}
{
  "name": "Healthcare hero banner",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_mode",
      "label": "Layout mode",
      "options": [
        { "value": "full-background", "label": "Full background" },
        { "value": "split-layout", "label": "Split layout" },
        { "value": "background-with-overlay-image", "label": "Background with overlay image" }
      ],
      "default": "full-background"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Background image"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "select",
      "id": "background_image_size",
      "label": "Background image size",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "background_position_x",
      "label": "Background position X",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "background_position_y",
      "label": "Background position Y",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "background_overlay_opacity",
      "label": "Image opacity",
      "info": "Fades the photo itself. 100% shows it at full strength.",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "color",
      "id": "background_overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "background_overlay_strength",
      "label": "Overlay strength",
      "info": "Tints the whole banner with the overlay color. 0% means no overlay.",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "header",
      "content": "White panel"
    },
    {
      "type": "checkbox",
      "id": "show_white_panel",
      "label": "Show white panel",
      "default": false
    },
    {
      "type": "range",
      "id": "white_panel_width",
      "label": "Panel width",
      "min": 30,
      "max": 60,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "color",
      "id": "white_panel_color",
      "label": "Panel color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "white_panel_opacity",
      "label": "Panel opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 95
    },
    {
      "type": "checkbox",
      "id": "white_panel_rounded",
      "label": "Rounded corners",
      "default": true
    },
    {
      "type": "range",
      "id": "white_panel_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Foreground image",
      "info": "Only used when Layout mode is \"Background with overlay image\"."
    },
    {
      "type": "image_picker",
      "id": "foreground_image",
      "label": "Foreground image"
    },
    {
      "type": "range",
      "id": "foreground_image_scale",
      "label": "Image size",
      "info": "100% matches the section Min height. Raise or lower to resize the person.",
      "min": 50,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "foreground_image_fit",
      "label": "Image fit",
      "options": [
        { "value": "contain", "label": "Contain (show whole image)" },
        { "value": "cover", "label": "Cover (crop to fill)" }
      ],
      "default": "contain"
    },
    {
      "type": "select",
      "id": "foreground_position_x",
      "label": "Horizontal position",
      "options": [
