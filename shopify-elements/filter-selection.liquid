<div class="ai-filter-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-filter-section__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-filter-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    {% if block.settings.subheading != blank %}
      <p class="ai-filter-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
    {% endif %}

    <ul class="ai-pills-container-{{ ai_gen_id }}" role="list">
      {% for i in (1..12) %}
        {% assign pill_enabled_key = 'pill_' | append: i | append: '_enabled' %}
        {% assign pill_text_key = 'pill_' | append: i | append: '_text' %}

        {% assign pill_enabled = block.settings[pill_enabled_key] %}
        {% assign pill_text = block.settings[pill_text_key] %}

        {% if pill_enabled and pill_text != blank %}
          <li class="ai-pill-{{ ai_gen_id }}">{{ pill_text }}</li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</div>

{% style %}
  .ai-filter-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.section_bg_color }};
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
  }

  .ai-filter-section__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
  }

  .ai-filter-heading-{{ ai_gen_id }} {
    font-size: clamp(24px,3.4vw,64px);
    font-weight: {{ block.settings.heading_weight }};
    color: {{ block.settings.heading_color }};
    text-align: {{ block.settings.heading_alignment }};
    margin: 0 0 {{ block.settings.heading_to_subheading_spacing }}px;
    line-height: 1.2;
  }

  .ai-filter-subheading-{{ ai_gen_id }} {
    font-size: clamp(14px, 1.5vw, 34px);
    font-weight: {{ block.settings.subheading_weight }};
    color: {{ block.settings.subheading_color }};
    text-align: {{ block.settings.subheading_alignment }};
    margin: 0 0 {{ block.settings.subheading_to_pills_spacing }}px;
    line-height: 1.4;
  }

  .ai-pills-container-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: {{ block.settings.pills_gap }}px;
    justify-content: {{ block.settings.pills_alignment }};
    margin: 0 0 {{ block.settings.pills_bottom_spacing }}px;
    padding: 0;
    list-style: none;
  }

  .ai-pill-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.pill_padding_vertical }}px {{ block.settings.pill_padding_horizontal }}px;
    background-color: {{ block.settings.pill_bg_color }};
    color: {{ block.settings.pill_text_color }};
    border: {{ block.settings.pill_border_thickness }}px solid {{ block.settings.pill_border_color }};
    border-radius: {{ block.settings.pill_radius }}px;
    font-size: clamp(10px, 1vw, 20px);
    font-weight: {{ block.settings.pill_font_weight }};
    letter-spacing: {{ block.settings.pill_letter_spacing }}px;
    white-space: nowrap;
    cursor: default;
    user-select: none;
  }

  @media screen and (max-width: 749px) {
    .ai-filter-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-filter-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.85 }}px;
    }

    {% if block.settings.mobile_pills_layout == 'scroll' %}
      .ai-pills-container-{{ ai_gen_id }} {
        overflow-x: auto;
        flex-wrap: nowrap;
        -webkit-overflow-scrolling: touch;
      }
    {% endif %}

    .ai-pill-{{ ai_gen_id }} {
      font-size: {{ block.settings.pill_font_size | times: 0.9 }}px;
      padding: {{ block.settings.pill_padding_vertical | times: 0.9 }}px {{ block.settings.pill_padding_horizontal | times: 0.9 }}px;
    }
  }
{% endstyle %}

