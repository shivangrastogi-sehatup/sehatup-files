  #lead-popup-mini-{{ section.id }}.lead-popup-mini--brand .lead-popup-mini__title { color: #fff; }
  #lead-popup-mini-{{ section.id }}.lead-popup-mini--brand .lead-popup-mini__sub   { color: rgba(255, 255, 255, .82); }
