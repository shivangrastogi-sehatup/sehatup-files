{%- comment -%}
  ============================================================================
  sehatup Lead Capture Popup, minimisable
  ============================================================================
  Same popup and same Firebase write as `lead-capture-popup.liquid`, with one
  addition: closing it does not throw it away. The dialog is sucked down into a
  small tab in the corner, and tapping that tab pulls it back out.

  The two swap by handover, not by travel: whichever one is leaving fades out
  first, and only once it has gone does the other fade in. Sequenced rather
  than overlapped, so there is never a frame with half a popup and half a tab
  on screen, and nothing crosses the middle of the page on the way.

  Writes to Firebase Firestore (project sehatup-f96b5). Config is hardcoded
  in the script, NOT in the schema.

  Install: Sections > add `lead-capture-popup-minimizable.liquid`, add it from
  the theme editor. Use this OR the plain popup on a page, not both.
  ============================================================================
{%- endcomment -%}

{%- assign show_here = false -%}
{%- if section.settings.enable_popup -%}
  {%- if section.settings.show_on_home and template == 'index' -%}
    {%- assign show_here = true -%}
  {%- endif -%}
  {%- if section.settings.target_page != blank and page != blank and page.handle == section.settings.target_page.handle -%}
    {%- assign show_here = true -%}
  {%- endif -%}
{%- endif -%}

{%- if show_here -%}

{%- liquid
  # Packaged advisor photo. Transparent WebP already on the Shopify CDN, which
  # negotiates format per browser: WebP (17KB, alpha intact) where supported,
  # PNG otherwise. `popup_image` in the theme editor overrides it.
  assign doctor_url = 'https://cdn.shopify.com/s/files/1/0924/5687/8383/files/doctor-440.webp?v=1787047522'

  assign has_image = section.settings.show_photo

  assign m_heading = section.settings.mobile_heading | default: section.settings.popup_heading
  assign m_sub     = section.settings.mobile_subheading | default: section.settings.popup_subheading

  # How the "times shown" counter is scoped. Off, the allowance is spent across
  # the whole visit, so a visitor who saw it twice on the home page sees nothing
  # on the custom page. On, the URL joins the key, so every page carries its own
  # allowance. request.path is the page itself ("/" or "/pages/health-score-360"),
  # never the query string, so utm tags cannot hand out extra showings.
  assign scope_key = ''
  if section.settings.count_per_page
    assign scope_key = request.path | default: '/'
  endif

  # ---- The minimised tab ------------------------------------------------
  assign mini_pos   = section.settings.mini_position | default: 'bottom-right'
  assign mini_theme = section.settings.mini_theme | default: 'light'
  assign mini_style = section.settings.mini_style | default: 'pill'
  assign mini_size  = section.settings.mini_size | default: 'medium'
  assign mini_attention = section.settings.mini_attention | default: 'nudge'
  assign mini_title = section.settings.mini_title | default: section.settings.popup_heading
  assign mini_sub   = section.settings.mini_sub

  # 'compact' is the photo on its own, 'text' is the words on their own.
  assign mini_show_img = true
  assign mini_show_text = true
  if mini_style == 'text'
    assign mini_show_img = false
  endif
  if mini_style == 'compact'
    assign mini_show_text = false
  endif

  # The tab's own picture falls back to the popup's advisor photo, so a
  # merchant who has already replaced that one does not have to do it twice.
  assign mini_img_source = section.settings.mini_image
  if mini_img_source == blank
    assign mini_img_source = section.settings.popup_image
  endif
-%}

{%- if section.settings.enable_minimise -%}
  {%- comment -%}
    The tab lives OUTSIDE the popup root, not inside it. The root is a
    full-viewport fixed overlay that gets `hidden` on close, so anything
    nested in it would be hidden along with it.

    `lead-popup-mini__wrap` is the element the fade animates. The dismiss
    cross is absolutely positioned inside it so it fades along with the pill
    rather than hanging in the air on its own.
  {%- endcomment -%}
  <div
    id="lead-popup-mini-{{ section.id }}"
    class="lead-popup-mini lead-popup-mini--{{ mini_pos }} lead-popup-mini--{{ mini_theme }} lead-popup-mini--{{ mini_size }}"
    data-attention="{{ mini_attention }}"
    hidden
  >
    <div class="lead-popup-mini__wrap" data-lead-popup-mini-wrap>
      <button
        type="button"
        class="lead-popup-mini__btn"
        data-lead-popup-restore
        aria-label="Reopen {{ mini_title | escape }}"
      >
        {%- if mini_show_img -%}
          <span class="lead-popup-mini__avatar" aria-hidden="true">
            {%- if mini_img_source != blank -%}
              <img
                class="lead-popup-mini__img"
                src="{{ mini_img_source | image_url: width: 160 }}"
                srcset="{{ mini_img_source | image_url: width: 160 }} 160w,
                        {{ mini_img_source | image_url: width: 240 }} 240w"
                sizes="80px"
                alt=""
                width="160"
                height="240"
                loading="lazy"
                decoding="async"
              >
            {%- else -%}
              <img
                class="lead-popup-mini__img"
                src="{{ doctor_url }}&width=160"
                srcset="{{ doctor_url }}&width=160 160w,
                        {{ doctor_url }}&width=240 240w"
                sizes="80px"
                alt=""
                width="160"
                height="240"
                loading="lazy"
                decoding="async"
              >
            {%- endif -%}
          </span>
        {%- endif -%}

        {%- if mini_show_text -%}
          <span class="lead-popup-mini__text">
            <span class="lead-popup-mini__title">{{ mini_title }}</span>
            {%- if mini_sub != blank -%}
              <span class="lead-popup-mini__sub">{{ mini_sub }}</span>
            {%- endif -%}
          </span>
        {%- endif -%}
      </button>

      {%- if section.settings.mini_dismissible -%}
        <button
          type="button"
          class="lead-popup-mini__x"
          data-lead-popup-mini-dismiss
          aria-label="Hide this for now"
          title="Hide"
        >&#215;</button>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

<div
  id="lead-popup-{{ section.id }}"
  class="lead-popup"
  data-lead-popup
  data-delay="{{ section.settings.popup_delay | default: 0.5 }}"
  data-scroll-percent="{{ section.settings.scroll_trigger_percent | default: 60 }}"
  data-max-shows="{{ section.settings.max_shows | default: 2 }}"
  data-session-key="lead_popup_seen_{{ section.id }}{{ scope_key }}"
  data-firestore-collection="{{ section.settings.firestore_collection | default: 'popup_leads' }}"
  data-template="{{ template }}"
  data-minimise="{% if section.settings.enable_minimise %}true{% else %}false{% endif %}"
  data-mini-persist="{% if section.settings.mini_persist %}true{% else %}false{% endif %}"
  data-mini-speed="{{ section.settings.minimise_speed | default: 520 }}"
  hidden
>
  <div class="lead-popup__overlay" data-lead-popup-close></div>

  <div
    class="lead-popup__dialog{% unless has_image %} lead-popup__dialog--no-image{% endunless %}"
    role="dialog"
    aria-modal="true"
    aria-label="{{ section.settings.popup_heading | escape }}"
  >
    <button type="button" class="lead-popup__close" data-lead-popup-close aria-label="Close" title="Close">&#215;</button>

    {%- comment -%}
      Visual panel: desktop/tablet left column, mobile top band.
      On mobile the heading moves INTO the band (mockup 2c), so the content
      header is hidden there and this one takes over.
    {%- endcomment -%}
    <div class="lead-popup__visual">
      {%- if has_image -%}
        {%- if section.settings.popup_image != blank -%}
          {%- comment -%} Theme-editor override, full srcset off the uploaded file. {%- endcomment -%}
          <img
            class="lead-popup__doctor"
            src="{{ section.settings.popup_image | image_url: width: 700 }}"
            srcset="{{ section.settings.popup_image | image_url: width: 400 }} 400w,
                    {{ section.settings.popup_image | image_url: width: 700 }} 700w,
                    {{ section.settings.popup_image | image_url: width: 1000 }} 1000w"
            sizes="(max-width: 767px) 150px, 350px"
            alt="{{ section.settings.popup_image.alt | default: 'sehatup health advisor' | escape }}"
            loading="lazy"
            decoding="async"
            width="700"
            height="1050"
          >
        {%- else -%}
          {%- comment -%}
            Packaged photo. The source is 440px wide, so the srcset stops at
            440w, because Shopify's CDN does not upscale, and asking for 700w would
            just re-serve the same pixels under a wider descriptor and mislead
            the browser's selection.
          {%- endcomment -%}
          <img
            class="lead-popup__doctor"
            src="{{ doctor_url }}&width=440"
            srcset="{{ doctor_url }}&width=220 220w,
                    {{ doctor_url }}&width=330 330w,
                    {{ doctor_url }}&width=440 440w"
            sizes="(max-width: 767px) 150px, 350px"
            alt="sehatup health advisor"
            loading="lazy"
            decoding="async"
            width="440"
            height="660"
          >
        {%- endif -%}
      {%- endif -%}

      <span class="lead-popup__handle" aria-hidden="true"></span>

      {%- if section.settings.trust_1 != blank or section.settings.trust_2 != blank or section.settings.trust_3 != blank or section.settings.trust_4 != blank -%}
        <div class="lead-popup__scrim" aria-hidden="true"></div>
        <div class="lead-popup__trust">
          {%- if section.settings.trust_1 != blank -%}<span>{{ section.settings.trust_1 }}</span>{%- endif -%}
          {%- if section.settings.trust_2 != blank -%}<span>{{ section.settings.trust_2 }}</span>{%- endif -%}
          {%- if section.settings.trust_3 != blank -%}<span>{{ section.settings.trust_3 }}</span>{%- endif -%}
          {%- if section.settings.trust_4 != blank -%}<span>{{ section.settings.trust_4 }}</span>{%- endif -%}
        </div>
      {%- endif -%}

      <div class="lead-popup__band-text">
        <h2>{{ m_heading }}</h2>
        {%- if m_sub != blank -%}<p>{{ m_sub }}</p>{%- endif -%}
      </div>
    </div>

    <div class="lead-popup__content">
      <div class="lead-popup__head" data-head>
        {%- if section.settings.eyebrow != blank -%}
          <span class="lead-popup__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 class="lead-popup__heading">{{ section.settings.popup_heading }}</h2>
        {%- if section.settings.popup_subheading != blank -%}
          <p class="lead-popup__subheading">{{ section.settings.popup_subheading }}</p>
        {%- endif -%}
      </div>

      {%- comment -%}
        Everything is required except the email address. Errors surface
        per-field on submit. The button is never disabled as a validation gate.
      {%- endcomment -%}
      <form class="lead-popup__form" data-lead-popup-form novalidate>
        <div class="lead-popup__fields">
          <div class="lead-popup__field">
            <label for="lead-name-{{ section.id }}">Full name<span class="lead-popup__req">*</span></label>
            <input type="text" id="lead-name-{{ section.id }}" name="name" autocomplete="name" placeholder="Enter your full name" required>
            <p class="lead-popup__error" data-error-for="name"></p>
          </div>

          <div class="lead-popup__grid lead-popup__grid--phone">
            <div class="lead-popup__field">
              <label for="lead-phone-{{ section.id }}">Mobile number<span class="lead-popup__req">*</span></label>
              <div class="lead-popup__inputgroup" data-group-for="phone">
                <span class="lead-popup__prefix">+91</span>
                <input
                  type="tel"
                  id="lead-phone-{{ section.id }}"
                  name="phone"
                  inputmode="numeric"
                  autocomplete="tel"
                  placeholder="10-digit mobile"
                  required
                >
              </div>
              <p class="lead-popup__error" data-error-for="phone"></p>
            </div>

            <div class="lead-popup__field">
              <label for="lead-age-{{ section.id }}">Age<span class="lead-popup__req">*</span></label>
              <input type="number" id="lead-age-{{ section.id }}" name="age" inputmode="numeric" min="18" max="100" placeholder="Your age" required>
              <p class="lead-popup__error" data-error-for="age"></p>
            </div>
          </div>

          {%- if section.settings.collect_email -%}
            <div class="lead-popup__field">
              <label for="lead-email-{{ section.id }}">
                Email address<span class="lead-popup__optional">optional</span>
              </label>
              <input
                type="email"
                id="lead-email-{{ section.id }}"
                name="email"
                autocomplete="email"
                autocapitalize="off"
                spellcheck="false"
                placeholder="Enter your email address"
              >
              <p class="lead-popup__error" data-error-for="email"></p>
            </div>
          {%- endif -%}

          {%- comment -%}
            One free-text city field. Whatever the customer types is stored
            verbatim as `city`, with no parsing, no splitting, no guessing.
          {%- endcomment -%}
          <div class="lead-popup__field">
            <label for="lead-city-{{ section.id }}">City<span class="lead-popup__req">*</span></label>
            <input
              type="text"
              id="lead-city-{{ section.id }}"
              name="city"
              autocomplete="address-level2"
              placeholder="Enter your city"
              required
            >
            <p class="lead-popup__error" data-error-for="city"></p>
          </div>
        </div>

        <button type="submit" class="lead-popup__submit" data-submit>
          <span class="lead-popup__spinner" aria-hidden="true"></span>
          <span data-btn-label>{{ section.settings.button_text | default: 'Get free consultation' }}</span>
        </button>

        <p class="lead-popup__status" data-lead-popup-status role="status" aria-live="polite"></p>

        {%- if section.settings.consent_text != blank -%}
          <p class="lead-popup__consent">{{ section.settings.consent_text }}</p>
        {%- endif -%}
      </form>

      {%- comment -%} Mockup 1e: the form is replaced, not just annotated. {%- endcomment -%}
      <div class="lead-popup__success" data-success hidden>
        <span class="lead-popup__tick" aria-hidden="true">&#10003;</span>
        <h3>{{ section.settings.success_title | default: "Thanks, we'll call you soon" }}</h3>
        <p>{{ section.settings.success_message | default: 'One of our doctors will call you on this number within 24 hours.' }}</p>
      </div>
    </div>
  </div>
</div>

<style>
  #lead-popup-{{ section.id }} {
    /* Palette taken from the live theme's index.json so the popup sits in the
       storefront rather than beside it:
         #ee204a  accent, used as accent_color and button_primary_bg
         #d01d42  the accent's own hover, already defined by the theme
         #1d1d1d  the heading colour across every section
         #555555  secondary text
         #e5e5e5  the FAQ border colour                                    */
    --lp-accent: {{ section.settings.accent_color | default: '#ee204a' }};
    --lp-accent-hover: #d01d42;
    --lp-text: #1d1d1d;
    --lp-muted: #555555;
    --lp-border: #e5e5e5;
    --lp-required: #e11d48;
    --lp-error: #ef4444;
    --lp-success: #16a34a;
    --lp-panel: linear-gradient(165deg, #3d0a1a 0%, #9c1233 48%, #ee204a 100%);
    --lp-panel-mobile: linear-gradient(120deg, #3d0a1a 0%, #9c1233 55%, #ee204a 100%);

    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Montserrat', sans-serif;
  }
  #lead-popup-{{ section.id }}[hidden] { display: none !important; }

  #lead-popup-{{ section.id }} .lead-popup__overlay {
    position: absolute;
    inset: 0;
    background: rgba(17, 24, 39, {{ section.settings.overlay_opacity | default: 55 | divided_by: 100.0 }});
    animation: lp-veil-in-{{ section.id }} .24s ease both;
  }

  /* ---- Motion ----------------------------------------------------------
     Calm and clinical, not bouncy: decelerating ease on the way in, a
     shorter ease-in on the way out. `data-state="closing"` is set by the
     script, which then waits for animationend before hiding the popup,
     without that wait the element disappears and the exit never renders. */
  @keyframes lp-veil-in-{{ section.id }}  { from { opacity: 0; } to { opacity: 1; } }
  @keyframes lp-veil-out-{{ section.id }} { from { opacity: 1; } to { opacity: 0; } }
  @keyframes lp-in-{{ section.id }} {
    from { opacity: 0; transform: translateY(14px) scale(.985); }
    to   { opacity: 1; transform: none; }
  }
  @keyframes lp-out-{{ section.id }} {
    from { opacity: 1; transform: none; }
    to   { opacity: 0; transform: translateY(10px) scale(.99); }
  }

  #lead-popup-{{ section.id }}[data-state="closing"] .lead-popup__overlay {
    animation: lp-veil-out-{{ section.id }} .19s ease both;
  }
  #lead-popup-{{ section.id }}[data-state="closing"] .lead-popup__dialog {
    animation: lp-out-{{ section.id }} .19s ease both;
  }

  /* ---- Dialog (mockup 1a / 2a) ---------------------------------------- */
  #lead-popup-{{ section.id }} .lead-popup__dialog {
    position: relative;
    display: grid;
    grid-template-columns: 350px 1fr;
    /* minmax(0,1fr), not auto: an auto row sizes to its content and overflows
       max-height, which clipped the bottom of the photo panel (trust points)
       instead of letting the form column scroll. */
    grid-template-rows: minmax(0, 1fr);
    width: min(920px, calc(100vw - 40px));
    max-height: 90vh;
    /* The mockup's 500px floor lives here, not on the panel: on the panel it
       pushes the grid row past max-height and clips the trust points on short
       windows. On the dialog the panel just stretches to fill. */
    min-height: min(500px, 90vh);
    border-radius: 14px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 24px 64px rgba(0, 0, 0, .32);
    animation: lp-in-{{ section.id }} .3s cubic-bezier(.16, 1, .3, 1) both;
  }
  /* Mockup 1b: no image, narrow single column. */
  #lead-popup-{{ section.id }} .lead-popup__dialog--no-image {
    grid-template-columns: 1fr;
    width: min(560px, calc(100vw - 40px));
  }
  #lead-popup-{{ section.id }} .lead-popup__dialog--no-image .lead-popup__visual { display: none; }

  #lead-popup-{{ section.id }} .lead-popup__close {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 3;
    width: 40px;
    height: 40px;
    padding: 0;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--lp-border);
    box-shadow: 0 2px 8px rgba(0, 0, 0, .14);
    color: var(--lp-text);
    font: 400 18px/1 sans-serif;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    /* isolate makes the button its own stacking context, so the fill below can
       sit at z-index -1: painted over the button's own white background, but
       still behind the glyph. No wrapper element needed. */
    isolation: isolate;
    transition: color .18s ease, border-color .22s ease, box-shadow .22s ease, transform .1s ease;
  }

  /* The fill itself. inset:-1px so it covers the 1px border rather than
     leaving a pale ring around the filled circle. */
  #lead-popup-{{ section.id }} .lead-popup__close::before {
    content: "";
    position: absolute;
    inset: -1px;
    z-index: -1;
    border-radius: inherit;
    background: var(--lp-accent);
    transform: scale(0);
    transition: transform .3s cubic-bezier(.16, 1, .3, 1);
  }

  /* Pointer devices only. On a touchscreen :hover sticks after a tap, which
     would leave the button filled red until something else is touched. */
  @media (hover: hover) and (pointer: fine) {
    #lead-popup-{{ section.id }} .lead-popup__close:hover::before { transform: scale(1); }
    #lead-popup-{{ section.id }} .lead-popup__close:hover {
      color: #fff;
      border-color: var(--lp-accent);
      box-shadow: 0 4px 14px rgba(238, 32, 74, .35);
    }
  }

  #lead-popup-{{ section.id }} .lead-popup__close:active { transform: scale(.93); }
  #lead-popup-{{ section.id }} .lead-popup__close:focus-visible {
    outline: 2px solid var(--lp-accent);
    outline-offset: 2px;
  }

  /* ---- Visual panel ---------------------------------------------------- */
  #lead-popup-{{ section.id }} .lead-popup__visual {
    position: relative;
    min-height: 0;
    background: var(--lp-panel);
    overflow: hidden;
  }
  #lead-popup-{{ section.id }} .lead-popup__doctor {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
    display: block;
  }
  #lead-popup-{{ section.id }} .lead-popup__scrim {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 38%;
    background: linear-gradient(to top, rgba(20, 4, 10, .82), rgba(20, 4, 10, 0));
  }
  #lead-popup-{{ section.id }} .lead-popup__trust {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 18px;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  #lead-popup-{{ section.id }} .lead-popup__trust span {
    font: 500 12px/1.35 sans-serif;
    color: rgba(255, 255, 255, .94);
  }

  /* Mobile-only pieces, hidden at desktop/tablet. */
  #lead-popup-{{ section.id }} .lead-popup__handle,
  #lead-popup-{{ section.id }} .lead-popup__band-text { display: none; }

  /* ---- Content column -------------------------------------------------- */
  #lead-popup-{{ section.id }} .lead-popup__content {
    padding: 44px 48px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    overflow-y: auto;
    /* Grid children default to min-height:auto, which refuses to shrink below
       their content, so the dialog would clip at 90vh instead of scrolling. */
    min-height: 0;
  }
  #lead-popup-{{ section.id }} .lead-popup__head {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  #lead-popup-{{ section.id }} .lead-popup__eyebrow {
    font: 600 11px/1 sans-serif;
    letter-spacing: .09em;
    text-transform: uppercase;
    color: var(--lp-accent);
  }
  #lead-popup-{{ section.id }} .lead-popup__heading {
    margin: 0;
    font: 600 27px/1.25 sans-serif;
    color: var(--lp-text);
    text-wrap: pretty;
  }
  #lead-popup-{{ section.id }} .lead-popup__dialog--no-image .lead-popup__heading { font-size: 26px; }
  #lead-popup-{{ section.id }} .lead-popup__subheading {
    margin: 0;
    font: 400 14.5px/1.55 sans-serif;
    color: var(--lp-muted);
    text-wrap: pretty;
  }

  #lead-popup-{{ section.id }} .lead-popup__form {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  #lead-popup-{{ section.id }} .lead-popup__fields {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  #lead-popup-{{ section.id }} .lead-popup__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  #lead-popup-{{ section.id }} .lead-popup__grid--phone { grid-template-columns: 1.6fr 1fr; }

  #lead-popup-{{ section.id }} .lead-popup__field label {
    display: flex;
    gap: 4px;
    align-items: center;
    font: 600 12.5px sans-serif;
    color: var(--lp-text);
    margin-bottom: 6px;
  }
  #lead-popup-{{ section.id }} .lead-popup__req { color: var(--lp-required); }
  #lead-popup-{{ section.id }} .lead-popup__optional {
    font: italic 400 11.5px sans-serif;
    color: var(--lp-muted);
  }
  #lead-popup-{{ section.id }} .lead-popup__field label:has(.lead-popup__optional) {
    gap: 6px;
    align-items: baseline;
  }

  #lead-popup-{{ section.id }} .lead-popup__field input {
    width: 100%;
    box-sizing: border-box;
    padding: 11px 12px;
    border: 1px solid var(--lp-border);
    border-radius: 8px;
    font: 400 14px sans-serif;
    color: var(--lp-text);
    background: #fff;
  }
  #lead-popup-{{ section.id }} .lead-popup__field input:focus {
    outline: none;
    border-color: var(--lp-accent);
    box-shadow: 0 0 0 3px rgba(238, 32, 74, .16);
  }
  #lead-popup-{{ section.id }} input[type="number"] { -moz-appearance: textfield; appearance: textfield; }
  #lead-popup-{{ section.id }} input[type="number"]::-webkit-outer-spin-button,
  #lead-popup-{{ section.id }} input[type="number"]::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  /* Phone group: static +91, so the field itself holds only the 10 digits. */
  #lead-popup-{{ section.id }} .lead-popup__inputgroup {
    display: flex;
    align-items: center;
    border: 1px solid var(--lp-border);
    border-radius: 8px;
    background: #fff;
  }
  #lead-popup-{{ section.id }} .lead-popup__prefix {
    padding: 11px 0 11px 12px;
    font: 400 14px sans-serif;
    color: var(--lp-muted);
  }
  #lead-popup-{{ section.id }} .lead-popup__inputgroup input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: none;
    padding: 11px 12px;
    background: transparent;
  }
  #lead-popup-{{ section.id }} .lead-popup__inputgroup:focus-within {
    border-color: var(--lp-accent);
    box-shadow: 0 0 0 3px rgba(238, 32, 74, .16);
  }
  #lead-popup-{{ section.id }} .lead-popup__inputgroup input:focus { box-shadow: none; }

  /* Error state (mockup 1c) */
  #lead-popup-{{ section.id }} .lead-popup__field input[aria-invalid="true"],
  #lead-popup-{{ section.id }} .lead-popup__inputgroup[data-invalid="true"] {
    border-color: var(--lp-error);
    box-shadow: 0 0 0 3px rgba(239, 68, 68, .14);
  }
  #lead-popup-{{ section.id }} .lead-popup__inputgroup[data-invalid="true"] input { box-shadow: none; }
  #lead-popup-{{ section.id }} .lead-popup__error {
    margin: 5px 0 0;
    font: 400 11.5px/1.4 sans-serif;
    color: var(--lp-error);
  }
  #lead-popup-{{ section.id }} .lead-popup__error:empty { display: none; }

  #lead-popup-{{ section.id }} .lead-popup__submit {
    width: 100%;
    padding: 14px 18px;
    border: 0;
    border-radius: 8px;
    background: var(--lp-accent);
    color: #fff;
    font: 600 15px sans-serif;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
  }
  #lead-popup-{{ section.id }} .lead-popup__submit:hover:not(:disabled) {
    background: var(--lp-accent-hover);
  }
  #lead-popup-{{ section.id }} .lead-popup__submit:active:not(:disabled) { transform: translateY(1px); }
  #lead-popup-{{ section.id }} .lead-popup__submit:focus-visible {
    outline: 2px solid var(--lp-text);
    outline-offset: 2px;
  }
  /* Disabled ONLY during the write, never as a validation gate. */
  #lead-popup-{{ section.id }} .lead-popup__submit:disabled { opacity: .6; cursor: default; }

  #lead-popup-{{ section.id }} .lead-popup__spinner { display: none; }
  #lead-popup-{{ section.id }} .lead-popup__submit[data-loading="true"] .lead-popup__spinner {
    display: inline-block;
    width: 14px;
    height: 14px;
    border-radius: 999px;
    border: 2px solid rgba(255, 255, 255, .45);
    border-top-color: #fff;
    animation: lp-spin-{{ section.id }} .7s linear infinite;
  }
  @keyframes lp-spin-{{ section.id }} { to { transform: rotate(360deg); } }

  #lead-popup-{{ section.id }} .lead-popup__status {
    margin: 0;
    font: 500 12.5px/1.4 sans-serif;
    color: var(--lp-error);
    text-align: center;
  }
  #lead-popup-{{ section.id }} .lead-popup__status:empty { display: none; }

  #lead-popup-{{ section.id }} .lead-popup__consent {
    margin: 0;
    font: 400 11.5px/1.5 sans-serif;
    color: var(--lp-muted);
    text-align: center;
    text-wrap: pretty;
  }

  /* ---- Success (mockup 1e) -------------------------------------------- */
  #lead-popup-{{ section.id }} .lead-popup__success {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
    padding: 36px 24px;
    /* Centres in the column once the form is gone, so the card does not sit
       stranded at the top of a tall dialog. */
    margin: auto 0;
  }
  #lead-popup-{{ section.id }} .lead-popup__tick {
    width: 52px;
    height: 52px;
    border-radius: 999px;
    background: rgba(22, 163, 74, .12);
    color: var(--lp-success);
    font: 600 24px/52px sans-serif;
  }
  #lead-popup-{{ section.id }} .lead-popup__success h3 {
    margin: 0;
    font: 600 18px/1.3 sans-serif;
    color: var(--lp-text);
  }
  #lead-popup-{{ section.id }} .lead-popup__success p {
    margin: 0;
    font: 400 13.5px/1.5 sans-serif;
    color: var(--lp-muted);
  }

  /* ---- Laptop 1024-1365 ------------------------------------------------
     A 1366×768 laptop has ~691px of usable height at 90vh. The full 920px
     desktop dialog fits but reads cramped, so it steps down between the
     desktop and tablet sizes rather than jumping straight from one to the
     other. -------------------------------------------------------------- */
  @media (min-width: 1024px) and (max-width: 1365px) {
    #lead-popup-{{ section.id }} .lead-popup__dialog {
      grid-template-columns: 310px 1fr;
      width: min(820px, calc(100vw - 40px));
    }
    #lead-popup-{{ section.id }} .lead-popup__dialog--no-image {
      grid-template-columns: 1fr;
      width: min(520px, calc(100vw - 40px));
    }
    #lead-popup-{{ section.id }} .lead-popup__content { padding: 36px 40px; gap: 20px; }
    #lead-popup-{{ section.id }} .lead-popup__heading { font-size: 24px; }
    #lead-popup-{{ section.id }} .lead-popup__subheading { font-size: 14px; }
  }

  /* ---- Tablet 768-1023 (mockup 2b) ------------------------------------ */
  @media (min-width: 768px) and (max-width: 1023px) {
    #lead-popup-{{ section.id }} .lead-popup__dialog {
      grid-template-columns: 204px 1fr;
      width: min(600px, calc(100vw - 40px));
    }
    #lead-popup-{{ section.id }} .lead-popup__dialog--no-image { grid-template-columns: 1fr; }
    #lead-popup-{{ section.id }} .lead-popup__dialog { min-height: min(420px, 90vh); }
    /* No room to read beside a 204px figure. */
    #lead-popup-{{ section.id }} .lead-popup__trust,
    #lead-popup-{{ section.id }} .lead-popup__scrim { display: none; }
    #lead-popup-{{ section.id }} .lead-popup__content { padding: 32px 30px; gap: 18px; }
    #lead-popup-{{ section.id }} .lead-popup__head { gap: 7px; }
    #lead-popup-{{ section.id }} .lead-popup__eyebrow { font-size: 10.5px; }
    #lead-popup-{{ section.id }} .lead-popup__heading { font: 600 22px/1.28 sans-serif; }
    #lead-popup-{{ section.id }} .lead-popup__subheading { font: 400 13.5px/1.5 sans-serif; }
    #lead-popup-{{ section.id }} .lead-popup__form { gap: 18px; }
    #lead-popup-{{ section.id }} .lead-popup__submit { padding: 13px 18px; font-size: 14.5px; }
    #lead-popup-{{ section.id }} .lead-popup__close { top: 14px; right: 14px; }
  }

  /* ---- Mobile < 768 (mockup 2c): bottom sheet, never fullscreen ------- */
  @media (max-width: 767px) {
    #lead-popup-{{ section.id }} { align-items: flex-end; }

    #lead-popup-{{ section.id }} .lead-popup__dialog,
    #lead-popup-{{ section.id }} .lead-popup__dialog--no-image {
      grid-template-columns: 1fr;
      /* Band is fixed; the form column takes the rest and scrolls. */
      grid-template-rows: auto minmax(0, 1fr);
      width: 100%;
      max-width: none;
      max-height: 85%;
      border-radius: 18px 18px 0 0;
      box-shadow: 0 -12px 40px rgba(0, 0, 0, .28);
      animation-name: lp-sheet-{{ section.id }};
    }

    #lead-popup-{{ section.id }} .lead-popup__visual {
      display: block;
      min-height: 0;
      height: 140px;
      background: var(--lp-panel-mobile);
    }
    /* No-image mobile keeps the band: it carries the heading. */
    #lead-popup-{{ section.id }} .lead-popup__dialog--no-image .lead-popup__visual { display: block; }

    #lead-popup-{{ section.id }} .lead-popup__handle {
      display: block;
      position: absolute;
      top: 8px;
      left: 50%;
      transform: translateX(-50%);
      width: 40px;
      height: 4px;
      border-radius: 999px;
      background: rgba(255, 255, 255, .55);
      z-index: 2;
    }

    /* Right-anchored and cut at the chest. A full-width strip with default
       centring would crop to her torso and cut her head off. */
    #lead-popup-{{ section.id }} .lead-popup__doctor {
      inset: auto;
      right: 8px;
      bottom: 0;
      width: 150px;
      height: 170px;
      object-position: center top;
    }

    #lead-popup-{{ section.id }} .lead-popup__band-text {
      display: flex;
      position: absolute;
      left: 20px;
      top: 0;
      bottom: 0;
      /* The mockup's flat 190px only clears the photo at exactly 390px wide.
         At 375 (iPhone SE) and 360 (most budget Androids) the text ran under
         her. Cap at the mockup value, shrink below it. */
      width: min(190px, calc(100% - 190px));
      flex-direction: column;
      justify-content: center;
      gap: 6px;
    }
    #lead-popup-{{ section.id }} .lead-popup__band-text h2 {
      margin: 0;
      font: 600 18px/1.25 sans-serif;
      color: #fff;
      text-wrap: pretty;
    }
    #lead-popup-{{ section.id }} .lead-popup__band-text p {
      margin: 0;
      font: 400 12.5px/1.4 sans-serif;
      color: rgba(255, 255, 255, .85);
    }

    /* The band carries the heading on mobile. */
    #lead-popup-{{ section.id }} .lead-popup__head,
    #lead-popup-{{ section.id }} .lead-popup__trust,
    #lead-popup-{{ section.id }} .lead-popup__scrim { display: none; }

    #lead-popup-{{ section.id }} .lead-popup__content {
      padding: 18px 20px calc(20px + env(safe-area-inset-bottom));
      gap: 14px;
      min-height: 0;
    }
    #lead-popup-{{ section.id }} .lead-popup__form { gap: 14px; }
    #lead-popup-{{ section.id }} .lead-popup__fields { gap: 13px; }
    #lead-popup-{{ section.id }} .lead-popup__grid { gap: 10px; }

    /* Bigger touch targets than desktop. */
    #lead-popup-{{ section.id }} .lead-popup__field input { padding: 13px 12px; font-size: 15px; }
    #lead-popup-{{ section.id }} .lead-popup__prefix { padding: 13px 0 13px 12px; font-size: 15px; }
    #lead-popup-{{ section.id }} .lead-popup__inputgroup input { padding: 13px 12px; }
    #lead-popup-{{ section.id }} .lead-popup__submit { padding: 15px 18px; font-size: 15.5px; }
    #lead-popup-{{ section.id }} .lead-popup__close { top: 12px; right: 12px; }
  }

  /* ---- Small phones ≤ 374 (iPhone SE, budget Androids) -----------------
     The 170px image height above is bottom-anchored against a 140px band. As
     soon as the band gets shorter the overhang grows and `overflow: hidden`
     starts eating her head. Below 375 the image is tied to the band instead,
     and framing is handled by object-position, which cannot decouple. */
  @media (max-width: 374px) {
    #lead-popup-{{ section.id }} .lead-popup__visual { height: 124px; }
    #lead-popup-{{ section.id }} .lead-popup__doctor {
      width: 118px;
      right: 6px;
      height: 100%;
      object-position: 50% 12%;
    }
    #lead-popup-{{ section.id }} .lead-popup__band-text { left: 16px; }
    #lead-popup-{{ section.id }} .lead-popup__band-text h2 { font-size: 16px; }
    #lead-popup-{{ section.id }} .lead-popup__band-text p { font-size: 11.5px; }
    #lead-popup-{{ section.id }} .lead-popup__content { padding: 16px 16px calc(16px + env(safe-area-inset-bottom)); }
    /* Two inputs per row get too narrow to type in below 375px. */
    #lead-popup-{{ section.id }} .lead-popup__grid,
    #lead-popup-{{ section.id }} .lead-popup__grid--phone { grid-template-columns: 1fr; }
  }

  /* ---- Very narrow ≤ 300 (Galaxy Fold outer screen is 280) -------------
     Past this the photo leaves the heading roughly 80px, which wraps "Talk to
     a health advisor" onto three lines against her shoulder. The photo is
     decorative and the heading is not, so the photo goes and the text takes
     the full band, centred. Symmetric padding keeps it optically centred and
     clear of the close button. */
  @media (max-width: 300px) {
    #lead-popup-{{ section.id }} .lead-popup__doctor { display: none; }
    #lead-popup-{{ section.id }} .lead-popup__visual { height: 104px; }
    #lead-popup-{{ section.id }} .lead-popup__band-text {
      left: 0;
      right: 0;
      width: auto;
      padding: 0 42px;
      align-items: center;
      text-align: center;
      gap: 4px;
    }
    #lead-popup-{{ section.id }} .lead-popup__band-text h2 { font-size: 15px; }
    #lead-popup-{{ section.id }} .lead-popup__band-text p { font-size: 11px; }
    #lead-popup-{{ section.id }} .lead-popup__close { width: 30px; height: 30px; top: 10px; right: 10px; }
  }

  /* ---- Short viewports (landscape phones) ------------------------------
     The band would eat most of the sheet and push the form off-screen, so
     it goes entirely. The sheet must never become a fullscreen takeover. */
  @media (max-width: 1023px) and (max-height: 480px) {
    #lead-popup-{{ section.id }} .lead-popup__visual { display: none; }
    #lead-popup-{{ section.id }} .lead-popup__dialog,
    #lead-popup-{{ section.id }} .lead-popup__dialog--no-image {
      grid-template-rows: minmax(0, 1fr);
      min-height: 0;
      max-height: 92%;
    }
    /* The band carried the heading on mobile; with it gone, restore it. */
    #lead-popup-{{ section.id }} .lead-popup__head { display: flex; gap: 4px; }
    #lead-popup-{{ section.id }} .lead-popup__heading { font-size: 18px; }
    #lead-popup-{{ section.id }} .lead-popup__subheading { font-size: 13px; }
  }

  /* The sheet travels its own height rather than fading in place. On mobile
     the gesture should read as "slid up from the edge". */
  @keyframes lp-sheet-{{ section.id }} {
    from { opacity: .4; transform: translateY(100%); }
    to   { opacity: 1; transform: none; }
  }
  @keyframes lp-sheet-out-{{ section.id }} {
    from { opacity: 1; transform: none; }
    to   { opacity: .4; transform: translateY(100%); }
  }
  @media (max-width: 767px) {
    #lead-popup-{{ section.id }}[data-state="closing"] .lead-popup__dialog {
      animation: lp-sheet-out-{{ section.id }} .24s cubic-bezier(.5, 0, .75, 0) both;
    }
  }

  /* ---- Form gives way to the confirmation ------------------------------
     The form lifts and fades, then the card rises into the space it left.
     Sequenced by the script, not by delays, so the swap cannot desync. */
  @keyframes lp-leave-{{ section.id }} {
    from { opacity: 1; transform: none; }
    to   { opacity: 0; transform: translateY(-8px); }
  }
  @keyframes lp-arrive-{{ section.id }} {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: none; }
  }
  @keyframes lp-tick-{{ section.id }} {
    from { opacity: 0; transform: scale(.6); }
    to   { opacity: 1; transform: scale(1); }
  }

  #lead-popup-{{ section.id }} .lead-popup__head[data-leaving],
  #lead-popup-{{ section.id }} .lead-popup__form[data-leaving] {
    animation: lp-leave-{{ section.id }} .18s ease both;
    pointer-events: none;
  }
  #lead-popup-{{ section.id }} .lead-popup__success:not([hidden]) {
    animation: lp-arrive-{{ section.id }} .34s cubic-bezier(.16, 1, .3, 1) both;
  }
  #lead-popup-{{ section.id }} .lead-popup__success:not([hidden]) .lead-popup__tick {
    animation: lp-tick-{{ section.id }} .42s cubic-bezier(.34, 1.56, .64, 1) .08s both;
  }

  /* The `hidden` attribute is only `display:none` at UA specificity, and the
     class rules above set `display:flex` and beat it, which left the form on
     screen with the thank-you stacked underneath. These win it back. */
  #lead-popup-{{ section.id }} .lead-popup__head[hidden],
  #lead-popup-{{ section.id }} .lead-popup__form[hidden],
  #lead-popup-{{ section.id }} .lead-popup__success[hidden] { display: none !important; }

  @media (prefers-reduced-motion: reduce) {
    #lead-popup-{{ section.id }} .lead-popup__overlay,
    #lead-popup-{{ section.id }} .lead-popup__dialog,
    #lead-popup-{{ section.id }} .lead-popup__head,
    #lead-popup-{{ section.id }} .lead-popup__form,
    #lead-popup-{{ section.id }} .lead-popup__success,
    #lead-popup-{{ section.id }} .lead-popup__tick { animation: none !important; }
    /* The fill still happens, it just arrives instantly instead of growing. */
    #lead-popup-{{ section.id }} .lead-popup__close,
    #lead-popup-{{ section.id }} .lead-popup__close::before { transition: none !important; }
  }

  /* ======================================================================
     Minimised tab
     ====================================================================== */

  /* States driven by the minimise script. `animation: none` matters here:
     the dialog and the veil carry CSS entrance animations with fill `both`,
     which would restart the moment the state attribute is removed and play a
     second time on top of the fade. `open` is a resting state that keeps
     them switched off after a restore, and is replaced by `closing` when the
     popup is dismissed for real, which is when the exit animation should run. */
  #lead-popup-{{ section.id }}[data-state="minimising"] .lead-popup__dialog,
  #lead-popup-{{ section.id }}[data-state="restoring"] .lead-popup__dialog,
  #lead-popup-{{ section.id }}[data-state="open"] .lead-popup__dialog,
  #lead-popup-{{ section.id }}[data-state="minimising"] .lead-popup__overlay,
  #lead-popup-{{ section.id }}[data-state="restoring"] .lead-popup__overlay,
  #lead-popup-{{ section.id }}[data-state="open"] .lead-popup__overlay {
    animation: none;
  }
  /* Mid-flight the dialog is a moving picture, not a form. */
  #lead-popup-{{ section.id }}[data-state="minimising"] .lead-popup__dialog,
  #lead-popup-{{ section.id }}[data-state="restoring"] .lead-popup__dialog {
    pointer-events: none;
  }

  #lead-popup-mini-{{ section.id }} {
    --lpm-side: {{ section.settings.mini_offset_side | default: 24 }}px;
    --lpm-bottom: {{ section.settings.mini_offset_bottom | default: 24 }}px;
    --lpm-accent: {{ section.settings.accent_color | default: '#ee204a' }};
    --lpm-panel: linear-gradient(140deg, #3d0a1a 0%, #9c1233 52%, #ee204a 100%);

    position: fixed;
    z-index: 9998;
    font-family: 'Montserrat', sans-serif;
    /* The middle-* variants stretch the full viewport height to centre without
       a transform, because a transform on this element would be overwritten by
       the pop-in animation and the tab would jump. Only the pill takes clicks. */
    pointer-events: none;
  }
  #lead-popup-mini-{{ section.id }}[hidden] { display: none !important; }

  #lead-popup-mini-{{ section.id }}.lead-popup-mini--bottom-right { right: var(--lpm-side); bottom: var(--lpm-bottom); }
  #lead-popup-mini-{{ section.id }}.lead-popup-mini--bottom-left  { left:  var(--lpm-side); bottom: var(--lpm-bottom); }
  #lead-popup-mini-{{ section.id }}.lead-popup-mini--middle-right,
  #lead-popup-mini-{{ section.id }}.lead-popup-mini--middle-left {
    top: 0;
    bottom: 0;
    display: flex;
    align-items: center;
  }
  #lead-popup-mini-{{ section.id }}.lead-popup-mini--middle-right { right: var(--lpm-side); }
  #lead-popup-mini-{{ section.id }}.lead-popup-mini--middle-left  { left:  var(--lpm-side); }

  #lead-popup-mini-{{ section.id }} .lead-popup-mini__wrap {
    position: relative;
    pointer-events: auto;
  }
  /* The pill grows out of the corner it is parked in, so the pop reads as the
     tab arriving rather than as a box inflating in mid air. */
  #lead-popup-mini-{{ section.id }}.lead-popup-mini--bottom-right .lead-popup-mini__wrap { transform-origin: 100% 100%; }
  #lead-popup-mini-{{ section.id }}.lead-popup-mini--bottom-left  .lead-popup-mini__wrap { transform-origin: 0% 100%; }
  #lead-popup-mini-{{ section.id }}.lead-popup-mini--middle-right .lead-popup-mini__wrap { transform-origin: 100% 50%; }
  #lead-popup-mini-{{ section.id }}.lead-popup-mini--middle-left  .lead-popup-mini__wrap { transform-origin: 0% 50%; }

  #lead-popup-mini-{{ section.id }}[data-state="staged"] .lead-popup-mini__wrap {
    /* In the layout so its animation can be attached and held, but not yet
       visible. The popup is still on screen at this point. */
    opacity: 0;
    pointer-events: none;
  }

  #lead-popup-mini-{{ section.id }} .lead-popup-mini__btn {
    position: relative;
    display: flex;
    align-items: center;
    gap: 11px;
    max-width: min(300px, calc(100vw - 32px));
    margin: 0;
    border: 1px solid rgba(0, 0, 0, .07);
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 10px 30px rgba(0, 0, 0, .17), 0 2px 6px rgba(0, 0, 0, .08);
    cursor: pointer;
    text-align: left;
    -webkit-appearance: none;
    appearance: none;
    transition: box-shadow .22s ease, transform .16s cubic-bezier(.16, 1, .3, 1);
  }
  @media (hover: hover) and (pointer: fine) {
    #lead-popup-mini-{{ section.id }} .lead-popup-mini__btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 16px 38px rgba(0, 0, 0, .22), 0 3px 8px rgba(0, 0, 0, .1);
    }
  }
  #lead-popup-mini-{{ section.id }} .lead-popup-mini__btn:active { transform: scale(.97); }
  #lead-popup-mini-{{ section.id }} .lead-popup-mini__btn:focus-visible {
    outline: 2px solid var(--lpm-accent);
    outline-offset: 3px;
  }

  #lead-popup-mini-{{ section.id }} .lead-popup-mini__avatar {
    position: relative;
    flex: 0 0 auto;
    display: block;
    border-radius: 999px;
    overflow: hidden;
    /* The packaged advisor photo is a transparent cut-out, so the gradient
       behind it is what fills the circle. */
    background: var(--lpm-panel);
  }
  #lead-popup-mini-{{ section.id }} .lead-popup-mini__img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    /* 14% down the frame lands on the face of a full-length portrait, rather
       than on the middle of the coat. */
    object-position: center 14%;
  }

  #lead-popup-mini-{{ section.id }} .lead-popup-mini__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  #lead-popup-mini-{{ section.id }} .lead-popup-mini__title {
    display: block;
    color: #1d1d1d;
    font-weight: 700;
    line-height: 1.25;
    /* Two lines, then an ellipsis. A long popup heading reused here would
       otherwise stretch the pill across half the screen. */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  #lead-popup-mini-{{ section.id }} .lead-popup-mini__sub {
    display: block;
    color: #555;
    font-weight: 500;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ---- Sizes ----------------------------------------------------------- */
  #lead-popup-mini-{{ section.id }}.lead-popup-mini--small .lead-popup-mini__btn   { padding: 6px 15px 6px 6px; }
  #lead-popup-mini-{{ section.id }}.lead-popup-mini--small .lead-popup-mini__avatar{ width: 40px; height: 40px; }
  #lead-popup-mini-{{ section.id }}.lead-popup-mini--small .lead-popup-mini__title { font-size: 12px; }
  #lead-popup-mini-{{ section.id }}.lead-popup-mini--small .lead-popup-mini__sub   { font-size: 10.5px; }

  #lead-popup-mini-{{ section.id }}.lead-popup-mini--medium .lead-popup-mini__btn   { padding: 7px 18px 7px 7px; }
  #lead-popup-mini-{{ section.id }}.lead-popup-mini--medium .lead-popup-mini__avatar{ width: 52px; height: 52px; }
  #lead-popup-mini-{{ section.id }}.lead-popup-mini--medium .lead-popup-mini__title { font-size: 13px; }
  #lead-popup-mini-{{ section.id }}.lead-popup-mini--medium .lead-popup-mini__sub   { font-size: 11.5px; }

  #lead-popup-mini-{{ section.id }}.lead-popup-mini--large .lead-popup-mini__btn   { padding: 8px 22px 8px 8px; }
  #lead-popup-mini-{{ section.id }}.lead-popup-mini--large .lead-popup-mini__avatar{ width: 62px; height: 62px; }
  #lead-popup-mini-{{ section.id }}.lead-popup-mini--large .lead-popup-mini__title { font-size: 14.5px; }
  #lead-popup-mini-{{ section.id }}.lead-popup-mini--large .lead-popup-mini__sub   { font-size: 12.5px; }

  /* Photo on its own: a circle, so the padding has to be even all round. */
  #lead-popup-mini-{{ section.id }} .lead-popup-mini__btn:not(:has(.lead-popup-mini__text)) { gap: 0; }
  #lead-popup-mini-{{ section.id }}.lead-popup-mini--small  .lead-popup-mini__btn:not(:has(.lead-popup-mini__text)) { padding: 6px; }
  #lead-popup-mini-{{ section.id }}.lead-popup-mini--medium .lead-popup-mini__btn:not(:has(.lead-popup-mini__text)) { padding: 7px; }
  #lead-popup-mini-{{ section.id }}.lead-popup-mini--large  .lead-popup-mini__btn:not(:has(.lead-popup-mini__text)) { padding: 8px; }
  /* Words on their own: nothing to sit beside, so the left padding matches. */
  #lead-popup-mini-{{ section.id }} .lead-popup-mini__btn:not(:has(.lead-popup-mini__avatar)) { padding-left: 20px; }

  /* ---- Themes ---------------------------------------------------------- */
  #lead-popup-mini-{{ section.id }}.lead-popup-mini--brand .lead-popup-mini__btn {
    background: var(--lpm-panel);
    border-color: rgba(255, 255, 255, .18);
