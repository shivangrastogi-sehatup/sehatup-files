      // Parked in the tab, so this showing grows back out of it instead of
      // fading in over the top of it.
      if (docked && miniOn && bubble && !bubble.hidden) {
        restore(true);
        return;
      }
      if (!root.hidden) return;

      lastFocused = document.activeElement;
      root.removeAttribute('data-state');   // lets the CSS entrance run
      root.hidden = false;
      lockScroll();
      bumpShown();
      // Only stop listening once there are no showings left to give.
      if (exhausted()) teardownTriggers();

      var first = root.querySelector('input');
      // Focusing on mobile yanks the keyboard open over the sheet; desktop only.
      if (first && window.matchMedia('(min-width: 768px)').matches) {
        first.focus({ preventScroll: true });
      }
    }

    function finishClose() {
      root.hidden = true;
      root.removeAttribute('data-state');
      unlockScroll();
      lastClosedAt = Date.now();
      docked = false;
      // preventScroll: restoring focus must not drag the page back to wherever
      // the trigger element happened to sit.
      if (lastFocused && typeof lastFocused.focus === 'function') {
        lastFocused.focus({ preventScroll: true });
      }
    }

    /* allowDock false is the close that follows a successful submit. That one
       really is the end of it, so it must not leave a tab behind inviting the
       customer to fill the same form again. */
    function closePopup(allowDock) {
      if (root.hidden || busy) return;
      if (root.dataset.state === 'closing') return;

      if (allowDock !== false && canDock()) { minimise(); return; }

      if (reduceMotion) { finishClose(); return; }

      // Hiding the element immediately would skip the exit animation entirely,
      // so mark the state, let CSS run it, and hide on animationend. The
      // timeout is a backstop for when the animation never fires (element not
      // rendered, background tab), otherwise the popup would stay stuck open.
      root.dataset.state = 'closing';
      var done = false;
      function once() {
        if (done) return;
        done = true;
        finishClose();
      }
      dialog.addEventListener('animationend', once, { once: true });
      setTimeout(once, 400);
    }

    /* ------------------------------------------------------------------
       Triggers, in order. The delay opens showing one. The scroll depth opens
       showing two, and is gated on the first having already happened so the
       order is deterministic rather than a race. The scroll listener stays
       bound across the first dismissal, and is only removed once every
       showing has been used or the visitor has converted.
       ------------------------------------------------------------------ */
    var timerId = null;
    var scrollBound = false;
    var ticking = false;
    var lastClosedAt = 0;
    var REARM_MS = 2000;

    function scrollDepth() {
      var doc = document.documentElement;
      var scrollable = doc.scrollHeight - window.innerHeight;
      if (scrollable <= 0) return 0;
      return (window.pageYOffset || doc.scrollTop) / scrollable * 100;
    }

    function onScroll() {
      // rAF-throttled: an unthrottled scroll handler janks mid-range Android.
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(function () {
        ticking = false;
        // shownCount() >= 1 keeps this as the SECOND showing, never the first.
        if (shownCount() >= 1 && scrollDepth() >= scrollPct) openPopup('scroll');
      });
    }

    function teardownTriggers() {
      if (timerId) { clearTimeout(timerId); timerId = null; }
      if (scrollBound) { window.removeEventListener('scroll', onScroll); scrollBound = false; }
    }

    if (!exhausted()) {
      // Showing one. Skipped if this session already had it, so a page change
      // does not restart the sequence from the top.
      if (delay >= 0 && shownCount() === 0) {
        timerId = setTimeout(function () { openPopup('delay'); }, delay);
      }
      if (scrollPct > 0) {
        window.addEventListener('scroll', onScroll, { passive: true });
        scrollBound = true;
        // Deliberately not called here: on a page loaded already past the
        // threshold this would fire showing two before showing one appeared.
      }
    }

    /* Wrapped rather than passed straight through: the handler receives the
       click event as its first argument, and closePopup reads that argument
       as the "may this dock" flag. */
    root.querySelectorAll('[data-lead-popup-close]').forEach(function (el) {
      el.addEventListener('click', function () { closePopup(true); });
    });

    if (miniOn) {
      var restoreBtn = bubble.querySelector('[data-lead-popup-restore]');
      if (restoreBtn) {
        // A deliberate tap is not a showing. The session allowance exists to
        // limit how often the popup interrupts, and this one was asked for.
        restoreBtn.addEventListener('click', function () { restore(false); });
      }

      var dismissBtn = bubble.querySelector('[data-lead-popup-mini-dismiss]');
      if (dismissBtn) {
        dismissBtn.addEventListener('click', function (e) {
          e.stopPropagation();
          retireTab();
        });
      }

      /* Carried across pages. The section only renders on the pages the
         merchant switched it on for, so the tab follows the popup and appears
         nowhere else. Nothing is handing over on a fresh page load, so it
         slides up into place rather than fading in. */
      if (miniPersist && !converted() && !tabRetired() && shownCount() >= 1) {
        bubble.hidden = false;
        bubble.dataset.state = 'entering';
        docked = true;
        wrap.addEventListener('animationend', function () {
          bubble.removeAttribute('data-state');
        }, { once: true });
      }
    }

    document.addEventListener('keydown', function (e) {
      if (root.hidden) return;
      if (e.key === 'Escape') { closePopup(); return; }

      // Minimal focus trap so tabbing cannot wander behind the overlay.
      if (e.key !== 'Tab') return;
      var focusables = root.querySelectorAll('button, input, [href], select, textarea');
      if (!focusables.length) return;
      var first = focusables[0];
      var last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    /* ------------------------------------------------------------------
       Submit
       ------------------------------------------------------------------ */
    var form = root.querySelector('[data-lead-popup-form]');
    var statusEl = root.querySelector('[data-lead-popup-status]');
    var submitBtn = form.querySelector('.lead-popup__submit');
    var btnLabel = form.querySelector('[data-btn-label]');
    var defaultLabel = btnLabel.textContent;
    var headEl = root.querySelector('[data-head]');
    var successEl = root.querySelector('[data-success]');

    // Matches the questionnaire engine's rule: 10 digits, tolerant of +91 / 0
    // prefixes and spacing that users paste in.
    function normalisePhone(raw) {
      var digits = (raw || '').replace(/\D/g, '');
      if (digits.length === 12 && digits.indexOf('91') === 0) digits = digits.slice(2);
      if (digits.length === 11 && digits.charAt(0) === '0') digits = digits.slice(1);
      return digits;
    }

    /* ------------------------------------------------------------------
       Field-level errors.

       The submit button is never disabled. Pressing it is how the customer
       finds out what is wrong. Every invalid field is flagged at once so they
       fix the whole form in one pass instead of discovering problems one
       submit at a time.
       ------------------------------------------------------------------ */
    function setError(fieldName, message) {
      var input = form.querySelector('[name="' + fieldName + '"]');
      var slot = form.querySelector('[data-error-for="' + fieldName + '"]');
      var group = form.querySelector('[data-group-for="' + fieldName + '"]');
      if (slot) slot.textContent = message || '';
      if (group) {
        // The bordered wrapper carries the error ring, not the bare input.
        if (message) group.setAttribute('data-invalid', 'true');
        else group.removeAttribute('data-invalid');
      }
      if (!input) return;
      if (message) input.setAttribute('aria-invalid', 'true');
      else input.removeAttribute('aria-invalid');
    }

    function clearErrors() {
      form.querySelectorAll('[data-error-for]').forEach(function (el) { el.textContent = ''; });
      form.querySelectorAll('[aria-invalid]').forEach(function (el) { el.removeAttribute('aria-invalid'); });
      form.querySelectorAll('[data-invalid]').forEach(function (el) { el.removeAttribute('data-invalid'); });
      statusEl.textContent = '';
    }

    // Clear a field's error as soon as the customer starts fixing it.
    form.addEventListener('input', function (e) {
      var fieldName = e.target.name;
      if (fieldName && e.target.hasAttribute('aria-invalid')) setError(fieldName, '');
    });


    /* Swap the form out for the confirmation card. The form is hidden only
       after its exit animation finishes, so the two never overlap. */
    function showSuccess() {
      function swap() {
        // They sent their details. Never ask again on this browser.
        markConverted();
        teardownTriggers();
        // They sent their details, so the tab has nothing left to reopen.
        if (miniOn) retireTab();
        form.hidden = true;
        if (headEl) headEl.hidden = true;
        if (successEl) successEl.hidden = false;
        // Move focus to the confirmation so screen readers announce it and a
        // keyboard user is not left on a control that no longer exists.
        if (successEl) {
          successEl.setAttribute('tabindex', '-1');
          // preventScroll: focus() scrolls its target into view by default,
          // which yanked the page behind the popup, visible as the scrollbar
          // jumping on submit and again when the popup closed and focus was
          // restored. The popup is position:fixed and already on screen, so
          // there is nothing to scroll to.
          successEl.focus({ preventScroll: true });
        }
        // false: no docking. This close is final.
        setTimeout(function () { closePopup(false); }, 3400);
      }

      if (reduceMotion) { swap(); return; }

      form.setAttribute('data-leaving', 'true');
      if (headEl) headEl.setAttribute('data-leaving', 'true');
      var done = false;
      function once() {
        if (done) return;
        done = true;
        form.removeAttribute('data-leaving');
        if (headEl) headEl.removeAttribute('data-leaving');
        swap();
      }
      form.addEventListener('animationend', once, { once: true });
      setTimeout(once, 320);
    }

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      clearErrors();

      var data = new FormData(form);
      var name = (data.get('name') || '').toString().trim();
      var phoneRaw = (data.get('phone') || '').toString().trim();
      var phone = normalisePhone(phoneRaw);
      var ageRaw = (data.get('age') || '').toString().trim();
      var age = parseInt(ageRaw, 10);
      var email = (data.get('email') || '').toString().trim(); // optional
      var city = (data.get('city') || '').toString().trim();

      // Collect every problem, then report them together (mockup 1c).
      var errors = [];
      function invalid(field, message) { errors.push(field); setError(field, message); }

      if (!name) invalid('name', 'Name is required');

      if (!phoneRaw) invalid('phone', 'Phone number is required');
      else if (!/^\d{10}$/.test(phone)) invalid('phone', 'Enter a valid 10-digit mobile number');

      if (!ageRaw) invalid('age', 'Age is required');
      else if (isNaN(age) || age < 18 || age > 100) invalid('age', 'Enter an age between 18 and 100');

      // Optional, only checked when something was actually typed. The pattern
      // is deliberately loose (something@something.tld); strict RFC patterns
      // reject valid addresses far more often than they catch typos.
      if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
        invalid('email', 'Enter a valid email address');
      }

      if (!city) invalid('city', 'City is required');

      if (errors.length) {
        statusEl.textContent = errors.length === 1
          ? 'Please fix the highlighted field'
          : 'Please fix the ' + errors.length + ' highlighted fields';
        var firstBad = form.querySelector('[name="' + errors[0] + '"]');
        if (firstBad) {
          // Same preventScroll guard, but the invalid field genuinely may be
          // below the fold of the popup's own scroll area, so scroll it into
          // view with `nearest`, which moves the popup column and not the page.
          firstBad.focus({ preventScroll: true });
          firstBad.scrollIntoView({ block: 'nearest' });
        }
        return;
      }

      var succeeded = false;
      submitBtn.disabled = true;
      submitBtn.setAttribute('data-loading', 'true');
      btnLabel.textContent = 'Sending…';

      try {
        var fb = await getWriter();

        await fb.add(collectionName, {
          name: name,
          phone: phone,
          email: email,
          age: age,
          // Stored exactly as typed, with no parsing into city/state/pincode.
          city: city,
          status: 'new',
          source: 'lead_popup',
          sectionId: '{{ section.id }}',
          pageTemplate: root.dataset.template || '',
          pageUrl: window.location.href,
          referrer: document.referrer || '',
          // Mirrors the questionnaire engine: serverTimestamp for ordering,
          // a client Date for immediate local reads.
          timestamp: fb.stamp(),
          createdAt: new Date()
        });

        // Mockup 1e: the form is REPLACED by the success card, not annotated
        // underneath it. Let the form animate out first, then swap.
        // OpenAI Pixel: the lead row is written, so this is the conversion.
        try { if (window.oaiq) oaiq("measure", "lead_created", { type: "customer_action" }); } catch (e) {}

        succeeded = true;
        showSuccess();
      } catch (err) {
        console.error('[lead-popup] submit failed:', err);
        statusEl.textContent = 'Could not send. Check your connection and try again.';
      } finally {
        // On success the form is mid-fade, so restoring the label there would
        // flash "Request a callback" back over the spinner as it leaves.
        if (!succeeded) {
          submitBtn.disabled = false;
          submitBtn.removeAttribute('data-loading');
          btnLabel.textContent = defaultLabel;
        }
      }
    });
  })();
</script>
{%- endif -%}

