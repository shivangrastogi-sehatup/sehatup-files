<script>
  (function () {
    var root = document.getElementById('lead-popup-{{ section.id }}');
    if (!root || root.dataset.lpBooted === '1') return;
    root.dataset.lpBooted = '1';

    /* The minimised tab. Absent when the merchant switched minimising off,
       in which case every path below falls back to the plain close. */
    var bubble = document.getElementById('lead-popup-mini-{{ section.id }}');
    var wrap   = bubble ? bubble.querySelector('[data-lead-popup-mini-wrap]') : null;
    var miniOn = root.dataset.minimise === 'true' && !!bubble && !!wrap;
