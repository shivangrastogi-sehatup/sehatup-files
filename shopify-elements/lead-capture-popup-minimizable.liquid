  #lead-popup-mini-{{ section.id }} .lead-popup-mini__x:active { transform: scale(.9); }
  #lead-popup-mini-{{ section.id }} .lead-popup-mini__x:focus-visible {
    outline: 2px solid var(--lpm-accent);
    outline-offset: 2px;
  }

  /* ---- Attention -------------------------------------------------------
     A ring expanding out of the pill swept a large area of the screen for
     something meant to sit quietly in a corner, and pulled the eye off the
     page. All three options below stay inside the tab's own footprint. */

  /* Dot. The notification idiom, and the quietest thing that still registers.
     Parked on the corner opposite the dismiss cross so the two never meet. */
  @keyframes lpm-dot-{{ section.id }} {
    0%, 76%, 100% { transform: scale(1); }
    84%           { transform: scale(1.3); }
    92%           { transform: scale(1); }
  }
  #lead-popup-mini-{{ section.id }}[data-attention="dot"] .lead-popup-mini__wrap::after {
    content: "";
    position: absolute;
    right: 2px;
    bottom: 2px;
    width: 11px;
    height: 11px;
    border-radius: 999px;
    background: var(--lpm-accent);
    /* White collar, so it separates from a brand or dark pill as well as a
       white one. */
    box-shadow: 0 0 0 2px #fff, 0 1px 3px rgba(0, 0, 0, .3);
    animation: lpm-dot-{{ section.id }} 3.4s ease-in-out infinite;
    pointer-events: none;
  }

  /* Nudge. Movement is what the eye actually catches, so this spends its
     attention there instead of on area: 5px, over in a fraction of a second,
     once every six. It rides on the wrap rather than the button, because the
     button's own transform belongs to the hover lift. */
  @keyframes lpm-nudge-{{ section.id }} {
    0%, 86%, 100% { transform: translateY(0); }
    89%           { transform: translateY(-5px); }
    92%           { transform: translateY(0); }
    95%           { transform: translateY(-2px); }
    98%           { transform: translateY(0); }
  }
  #lead-popup-mini-{{ section.id }}[data-attention="nudge"] .lead-popup-mini__wrap {
    animation: lpm-nudge-{{ section.id }} 6s ease-in-out infinite;
  }

  /* Sheen. A light sweep across the pill, adding nothing to its outline. */
  @keyframes lpm-sheen-{{ section.id }} {
    0%        { transform: translateX(-160%); }
    55%, 100% { transform: translateX(320%); }
  }
  #lead-popup-mini-{{ section.id }}[data-attention="sheen"] .lead-popup-mini__btn { overflow: hidden; }
  #lead-popup-mini-{{ section.id }}[data-attention="sheen"] .lead-popup-mini__btn::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 34%;
    background: linear-gradient(100deg, transparent, rgba(0, 0, 0, .07), transparent);
    animation: lpm-sheen-{{ section.id }} 4.8s ease-in-out infinite;
    pointer-events: none;
  }
  /* On a dark or brand pill the sweep has to be light, not dark. */
  #lead-popup-mini-{{ section.id }}.lead-popup-mini--brand[data-attention="sheen"] .lead-popup-mini__btn::after,
  #lead-popup-mini-{{ section.id }}.lead-popup-mini--dark[data-attention="sheen"] .lead-popup-mini__btn::after {
    background: linear-gradient(100deg, transparent, rgba(255, 255, 255, .28), transparent);
  }

  /* ---- Arriving on a later page ---------------------------------------
     No dialog to fly from here, so the tab just slides up into place. */
  @keyframes lpm-enter-{{ section.id }} {
    from { opacity: 0; transform: translateY(18px) scale(.9); }
    to   { opacity: 1; transform: none; }
  }
  #lead-popup-mini-{{ section.id }}[data-state="entering"] .lead-popup-mini__wrap {
    animation: lpm-enter-{{ section.id }} .42s cubic-bezier(.16, 1, .3, 1) both;
  }

  /* ---- Phones ----------------------------------------------------------
     Sticky add-to-cart bars and the iOS home indicator both live along the
     bottom edge, so the tab gets its own offset there. */
  @media (max-width: 767px) {
    #lead-popup-mini-{{ section.id }} {
      --lpm-bottom: calc({{ section.settings.mini_offset_bottom_mobile | default: 16 }}px + env(safe-area-inset-bottom));
      --lpm-side: {{ section.settings.mini_offset_side_mobile | default: 12 }}px;
    }
    #lead-popup-mini-{{ section.id }} .lead-popup-mini__btn {
      max-width: calc(100vw - 24px);
    }
    #lead-popup-mini-{{ section.id }} .lead-popup-mini__sub { display: none; }
  }

  /* The dot stays, it just stops beating. Reduced motion asks for less
     movement, not for the indicator itself to be taken away. */
  @media (prefers-reduced-motion: reduce) {
    #lead-popup-mini-{{ section.id }} .lead-popup-mini__wrap,
    #lead-popup-mini-{{ section.id }} .lead-popup-mini__wrap::after,
    #lead-popup-mini-{{ section.id }} .lead-popup-mini__btn::after { animation: none; }
    #lead-popup-mini-{{ section.id }}[data-attention="sheen"] .lead-popup-mini__btn::after { opacity: 0; }
    #lead-popup-mini-{{ section.id }} .lead-popup-mini__btn { transition: none; }
  }
