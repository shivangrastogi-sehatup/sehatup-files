    /* ------------------------------------------------------------------
       Firebase, hardcoded, project sehatup-f96b5.
       Same values as _shared/public/firebase-config.js. These are public
       client keys (safe to ship); access is governed by Firestore rules.
       ------------------------------------------------------------------ */
    var FIREBASE_CONFIG = {
      apiKey: 'AIzaSyBCuj9geUYV69Ievt59WO8PjJWQZ1cKDLw',
      authDomain: 'sehatup-f96b5.firebaseapp.com',
      projectId: 'sehatup-f96b5',
      storageBucket: 'sehatup-f96b5.firebasestorage.app',
      messagingSenderId: '886569695434',
      appId: '1:886569695434:web:4932dca7625c98972a5c33',
      measurementId: 'G-X2274KKWE4'
    };
    var SDK_VERSION = '10.13.0';

    var collectionName = root.dataset.firestoreCollection || 'popup_leads';
    var delay = parseFloat(root.dataset.delay || '12') * 1000;
    var scrollPct = parseFloat(root.dataset.scrollPercent || '0');
    var maxShows = Math.max(1, parseInt(root.dataset.maxShows || '2', 10) || 1);
    var sessionKey = root.dataset.sessionKey;

    /* Session state is a COUNT, not a flag, so the popup can appear more than
       once: the delay opens it the first time, the scroll depth opens it the
       second. `converted` is separate and permanent for the session, because
       someone who already sent their details must never be asked again. */
    function shownCount() {
      try { return parseInt(sessionStorage.getItem(sessionKey) || '0', 10) || 0; }
      catch (e) { return 0; }
    }
    function bumpShown() {
      try { sessionStorage.setItem(sessionKey, String(shownCount() + 1)); }
      catch (e) { /* private mode */ }
    }
    /* localStorage, not sessionStorage, and deliberately not keyed to the
       section id. "This person already gave us their number" is a fact about
       the person, not about the tab they were in or which copy of the section
       happened to show. sessionStorage dies with the tab, so a second tab or
       a visit tomorrow would ask them all over again.
       The value is a timestamp rather than '1' so a cooldown can be added
       later without having to migrate anything. */
    var CONVERTED_KEY = 'sehatup_lead_popup_done';

    function converted() {
      try { return !!localStorage.getItem(CONVERTED_KEY); }
      catch (e) { return false; }
    }
    function markConverted() {
      try { localStorage.setItem(CONVERTED_KEY, new Date().toISOString()); }
      catch (e) { /* private mode, or storage full */ }
    }
    function exhausted() { return converted() || shownCount() >= maxShows; }

    /* ------------------------------------------------------------------
       Writer adapter.
       The questionnaire pages load the v9 *compat* SDK and expose window.db.
       The compat and modular APIs are not interchangeable, so we normalise
       both behind { add, stamp } instead of assuming one of them.
       ------------------------------------------------------------------ */
    function compatWriter(db) {
      return {
        add: function (col, data) { return db.collection(col).add(data); },
        stamp: function () { return window.firebase.firestore.FieldValue.serverTimestamp(); }
      };
    }

    var writerPromise = null;
    function getWriter() {
      if (writerPromise) return writerPromise;

      writerPromise = (async function () {
        // 1. Reuse the instance the page already created.
        if (window.db && typeof window.db.collection === 'function') {
          return compatWriter(window.db);
        }

        // 2. Compat SDK on the page but no db yet, so init without double-registering.
        if (window.firebase && typeof window.firebase.firestore === 'function') {
          var app = (window.firebase.apps && window.firebase.apps.length)
            ? window.firebase.app()
            : window.firebase.initializeApp(FIREBASE_CONFIG);
          var cdb = window.firebase.firestore(app);
          if (!window.db) window.db = cdb;
          return compatWriter(cdb);
        }

        // 3. No SDK at all, so lazy-load modular v10.
        var appMod = await import('https://www.gstatic.com/firebasejs/' + SDK_VERSION + '/firebase-app.js');
        var fsMod = await import('https://www.gstatic.com/firebasejs/' + SDK_VERSION + '/firebase-firestore.js');
        var mApp = appMod.getApps().length ? appMod.getApp() : appMod.initializeApp(FIREBASE_CONFIG);
        var mdb = fsMod.getFirestore(mApp);
        return {
          add: function (col, data) { return fsMod.addDoc(fsMod.collection(mdb, col), data); },
          stamp: function () { return fsMod.serverTimestamp(); }
        };
      })();

      // A failed load must not poison every later attempt.
      writerPromise.catch(function () { writerPromise = null; });
      return writerPromise;
    }

    /* ------------------------------------------------------------------
       Open / close / minimise
       ------------------------------------------------------------------ */
    var lastFocused = null;
    var dialog  = root.querySelector('.lead-popup__dialog');
    var overlay = root.querySelector('.lead-popup__overlay');
    var docked  = false;   // the tab is on screen holding the popup's place
    var busy    = false;   // an open or close animation is mid-flight

    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var canAnimate = typeof Element !== 'undefined' &&
                     typeof Element.prototype.animate === 'function';

    /* Scroll lock. Hiding the page scrollbar reclaims its width, so the layout
       behind the popup reflows sideways on open and back on close. Padding the
       body by the exact scrollbar width holds it still. The previous inline
       values are restored verbatim rather than blanked, so a theme that set
       its own body overflow or padding survives. */
    var priorOverflow = '';
    var priorPadRight = '';

    function lockScroll() {
      var gap = window.innerWidth - document.documentElement.clientWidth;
      priorOverflow = document.body.style.overflow;
      priorPadRight = document.body.style.paddingRight;
      document.body.style.overflow = 'hidden';
      if (gap > 0) {
        var current = parseFloat(window.getComputedStyle(document.body).paddingRight) || 0;
        document.body.style.paddingRight = (current + gap) + 'px';
      }
    }

    function unlockScroll() {
      document.body.style.overflow = priorOverflow;
      document.body.style.paddingRight = priorPadRight;
    }

    /* ------------------------------------------------------------------
       The tab
       ------------------------------------------------------------------ */
    function clearAnims(el) {
      if (!el || typeof el.getAnimations !== 'function') return;
      el.getAnimations().forEach(function (a) { a.cancel(); });
    }

    function tabRetired() {
      try { return sessionStorage.getItem(TAB_OFF_KEY) === '1'; }
      catch (e) { return false; }
    }
    function retireTab() {
      try { sessionStorage.setItem(TAB_OFF_KEY, '1'); } catch (e) { /* private mode */ }
      hideTab();
    }
    function hideTab() {
      if (!bubble) return;
      bubble.hidden = true;
      bubble.removeAttribute('data-state');
      clearAnims(wrap);
      docked = false;
    }
    /* quiet: laid out so it can be measured, but not yet visible. */
    function showTab(quiet) {
      if (!bubble) return;
      bubble.hidden = false;
      if (quiet) bubble.dataset.state = 'staged';
      else bubble.removeAttribute('data-state');
    }
    function canDock() {
      return miniOn && !converted() && !tabRetired();
    }

    /* ------------------------------------------------------------------
       Handover between the popup and the tab.

       One of the two is always leaving and the other always arriving, and
       they take strict turns: the leaver fades out completely, and only then
       does the arriver fade in. No travel between the two positions, so
       nothing sweeps across the middle of the page, and no overlap, so there
       is never a frame showing half a popup and half a tab.

       The split is 40/60 of the configured duration on the way down and 35/65
       on the way up, because an arrival wants a little more room than a
       departure. Transform and opacity only, so it stays on the compositor.
       ------------------------------------------------------------------ */

    /* Everything the popup gives up when it leaves the screen, shared by the
       minimise path and the plain close. */
    function stashPopup() {
      clearAnims(dialog);
      clearAnims(overlay);
      dialog.style.opacity = '';
      dialog.style.transform = '';
      overlay.style.opacity = '';
      root.hidden = true;
      root.removeAttribute('data-state');
      unlockScroll();
      lastClosedAt = Date.now();
    }

    /* ---- minimise ---------------------------------------------------- */
    function finishMinimise() {
      stashPopup();
      showTab(false);
      clearAnims(wrap);
      docked = true;
      busy = false;
      // The tab is where the popup went, so it is where focus should follow.
      var btn = bubble.querySelector('[data-lead-popup-restore]');
      if (btn) btn.focus({ preventScroll: true });
    }

    function minimise() {
      busy = true;
      showTab(true);   // staged in the layout, still invisible

      if (reduceMotion || !canAnimate) { finishMinimise(); return; }

      root.dataset.state = 'minimising';
      var outMs = Math.max(90, Math.round(DUR * 0.4));
      var inMs  = Math.max(140, DUR - outMs);

      var leaving = dialog.animate(
        [{ opacity: 1, transform: 'scale(1)' },
         { opacity: 0, transform: 'scale(.985)' }],
        { duration: outMs, easing: 'ease-in', fill: 'forwards' }
      );
      overlay.animate([{ opacity: 1 }, { opacity: 0 }],
        { duration: outMs, easing: 'ease-in', fill: 'forwards' });

      var gone = false;
      function popupGone() {
        if (gone) return;
        gone = true;
        stashPopup();
        // Clickable from here. The tab's own fade is still inside its delay
        // and holds it at zero opacity, so this does not flash it in early.
        showTab(false);
      }
      leaving.addEventListener('finish', popupGone);
      // Backstop for a background tab, where animations may never fire.
      setTimeout(popupGone, outMs + 250);

      var arriving = wrap.animate(
        [{ opacity: 0, transform: 'scale(.92)' },
         { opacity: 1, transform: 'scale(1)' }],
        {
          duration: inMs,
          delay: outMs,
          easing: 'cubic-bezier(.16, 1, .3, 1)',
          fill: 'both'
        }
      );

      var settled = false;
      function settle() {
        if (settled) return;
        settled = true;
        popupGone();
        clearAnims(wrap);
        docked = true;
        busy = false;
        var btn = bubble.querySelector('[data-lead-popup-restore]');
        if (btn) btn.focus({ preventScroll: true });
      }
      arriving.addEventListener('finish', settle);
      setTimeout(settle, outMs + inMs + 300);
    }

    /* ---- restore ----------------------------------------------------- */
    function raisePopup(countIt) {
      root.dataset.state = 'restoring';
      // Covers the single frame between being laid out and the animation
      // taking over. The animation outranks inline style, so it wins from
      // there, and finishRestore clears this again.
      dialog.style.opacity = '0';
      root.hidden = false;
      lockScroll();
      if (countIt) {
        bumpShown();
        if (exhausted()) teardownTriggers();
      }
    }

    function finishRestore() {
      clearAnims(dialog);
      clearAnims(overlay);
      dialog.style.opacity = '';
      dialog.style.transform = '';
      overlay.style.opacity = '';

      // 'open', not nothing: clearing the attribute would switch the CSS
      // entrance animation back on and replay it on top of the fade that
      // has just run.
      root.dataset.state = 'open';
      hideTab();
      busy = false;

      var first = root.querySelector('input');
      if (first && window.matchMedia('(min-width: 768px)').matches) {
        first.focus({ preventScroll: true });
      }
    }

    function restore(countIt) {
      if (busy) return;
      if (converted()) { retireTab(); return; }
      busy = true;
      lastFocused = document.activeElement;

      if (reduceMotion || !canAnimate) {
        hideTab();
        raisePopup(countIt);
        finishRestore();
        return;
      }

      var outMs = Math.max(80, Math.round(DUR * 0.35));
      var inMs  = Math.max(150, DUR - outMs);

      // 1. the tab goes first, on its own
      var leaving = wrap.animate(
        [{ opacity: 1, transform: 'scale(1)' },
         { opacity: 0, transform: 'scale(.92)' }],
        { duration: outMs, easing: 'ease-in', fill: 'forwards' }
      );

      // 2. only once it has gone does the popup come up
      var started = false;
      function bringUp() {
        if (started) return;
        started = true;
        hideTab();
        raisePopup(countIt);

        var arriving = dialog.animate(
          [{ opacity: 0, transform: 'scale(.97)' },
           { opacity: 1, transform: 'scale(1)' }],
          { duration: inMs, easing: 'cubic-bezier(.16, 1, .3, 1)', fill: 'forwards' }
        );
        overlay.animate([{ opacity: 0 }, { opacity: 1 }],
          { duration: inMs, easing: 'ease', fill: 'forwards' });

        var done = false;
        function end() { if (done) return; done = true; finishRestore(); }
        arriving.addEventListener('finish', end);
        setTimeout(end, inMs + 300);
      }
      leaving.addEventListener('finish', bringUp);
      setTimeout(bringUp, outMs + 250);
