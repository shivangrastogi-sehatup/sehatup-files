  #lead-popup-mini-{{ section.id }}.lead-popup-mini--dark .lead-popup-mini__title { color: #fff; }
  #lead-popup-mini-{{ section.id }}.lead-popup-mini--dark .lead-popup-mini__sub   { color: rgba(255, 255, 255, .72); }

  /* ---- Dismiss --------------------------------------------------------- */
  #lead-popup-mini-{{ section.id }} .lead-popup-mini__x {
    position: absolute;
    top: -7px;
    right: -7px;
    width: 22px;
    height: 22px;
