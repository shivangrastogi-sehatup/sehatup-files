{%- comment -%}
  ============================================================================
  sehatup Lead Capture Popup
  ============================================================================
  Styling matches the approved Claude Design mockups 1a to 1e / 2a to 2d exactly
  (dialog 920px, panel 350px). Palette comes from the theme index.json.

  Writes to Firebase Firestore (project sehatup-f96b5). Config is hardcoded
  in the script, NOT in the schema. The writer adapter reuses window.db when
  the questionnaire pages have already booted the v9 compat SDK.

  Install: Sections > add `lead-capture-popup.liquid`, add it from the theme
  editor, and set the advisor photo in `popup_image`.
  ============================================================================
{%- endcomment -%}

{%- assign show_here = false -%}
{%- if section.settings.enable_popup -%}
  {%- if section.settings.show_on_home and template == 'index' -%}
    {%- assign show_here = true -%}
  {%- endif -%}
  {%- if section.settings.target_page != blank and page != blank and page.handle == section.settings.target_page.handle -%}
    {%- assign show_here = true -%}
  {%- endif -%}
{%- endif -%}

{%- if show_here -%}

{%- liquid
  # Packaged advisor photo. Transparent WebP already on the Shopify CDN, which
  # negotiates format per browser: WebP (17KB, alpha intact) where supported,
  # PNG otherwise. `popup_image` in the theme editor overrides it.
  assign doctor_url = 'https://cdn.shopify.com/s/files/1/0924/5687/8383/files/doctor-440.webp?v=1787047522'

  assign has_image = section.settings.show_photo

  assign m_heading = section.settings.mobile_heading | default: section.settings.popup_heading
  assign m_sub     = section.settings.mobile_subheading | default: section.settings.popup_subheading

  # How the "times shown" counter is scoped. Off, the allowance is spent across
  # the whole visit, so a visitor who saw it twice on the home page sees nothing
  # on the custom page. On, the URL joins the key, so every page carries its own
  # allowance. request.path is the page itself ("/" or "/pages/health-score-360"),
  # never the query string, so utm tags cannot hand out extra showings.
  assign scope_key = ''
  if section.settings.count_per_page
    assign scope_key = request.path | default: '/'
  endif
-%}

<div
  id="lead-popup-{{ section.id }}"
  class="lead-popup"
  data-lead-popup
  data-delay="{{ section.settings.popup_delay | default: 0.5 }}"
  data-scroll-percent="{{ section.settings.scroll_trigger_percent | default: 60 }}"
  data-max-shows="{{ section.settings.max_shows | default: 2 }}"
  data-session-key="lead_popup_seen_{{ section.id }}{{ scope_key }}"
  data-firestore-collection="{{ section.settings.firestore_collection | default: 'popup_leads' }}"
  data-template="{{ template }}"
  hidden
>
  <div class="lead-popup__overlay" data-lead-popup-close></div>

  <div
    class="lead-popup__dialog{% unless has_image %} lead-popup__dialog--no-image{% endunless %}"
    role="dialog"
    aria-modal="true"
    aria-label="{{ section.settings.popup_heading | escape }}"
  >
    <button type="button" class="lead-popup__close" data-lead-popup-close aria-label="Close" title="Close">&#215;</button>

    {%- comment -%}
      Visual panel: desktop/tablet left column, mobile top band.
      On mobile the heading moves INTO the band (mockup 2c), so the content
      header is hidden there and this one takes over.
    {%- endcomment -%}
    <div class="lead-popup__visual">
      {%- if has_image -%}
        {%- if section.settings.popup_image != blank -%}
          {%- comment -%} Theme-editor override, full srcset off the uploaded file. {%- endcomment -%}
          <img
            class="lead-popup__doctor"
            src="{{ section.settings.popup_image | image_url: width: 700 }}"
            srcset="{{ section.settings.popup_image | image_url: width: 400 }} 400w,
                    {{ section.settings.popup_image | image_url: width: 700 }} 700w,
                    {{ section.settings.popup_image | image_url: width: 1000 }} 1000w"
            sizes="(max-width: 767px) 150px, 350px"
            alt="{{ section.settings.popup_image.alt | default: 'sehatup health advisor' | escape }}"
            loading="lazy"
            decoding="async"
            width="700"
            height="1050"
          >
        {%- else -%}
          {%- comment -%}
            Packaged photo. The source is 440px wide, so the srcset stops at
            440w, because Shopify's CDN does not upscale, and asking for 700w would
            just re-serve the same pixels under a wider descriptor and mislead
            the browser's selection.
          {%- endcomment -%}
          <img
            class="lead-popup__doctor"
            src="{{ doctor_url }}&width=440"
            srcset="{{ doctor_url }}&width=220 220w,
                    {{ doctor_url }}&width=330 330w,
                    {{ doctor_url }}&width=440 440w"
            sizes="(max-width: 767px) 150px, 350px"
            alt="sehatup health advisor"
            loading="lazy"
            decoding="async"
            width="440"
            height="660"
          >
        {%- endif -%}
      {%- endif -%}

      <span class="lead-popup__handle" aria-hidden="true"></span>

      {%- if section.settings.trust_1 != blank or section.settings.trust_2 != blank or section.settings.trust_3 != blank or section.settings.trust_4 != blank -%}
        <div class="lead-popup__scrim" aria-hidden="true"></div>
        <div class="lead-popup__trust">
          {%- if section.settings.trust_1 != blank -%}<span>{{ section.settings.trust_1 }}</span>{%- endif -%}
          {%- if section.settings.trust_2 != blank -%}<span>{{ section.settings.trust_2 }}</span>{%- endif -%}
          {%- if section.settings.trust_3 != blank -%}<span>{{ section.settings.trust_3 }}</span>{%- endif -%}
          {%- if section.settings.trust_4 != blank -%}<span>{{ section.settings.trust_4 }}</span>{%- endif -%}
        </div>
      {%- endif -%}

      <div class="lead-popup__band-text">
        <h2>{{ m_heading }}</h2>
        {%- if m_sub != blank -%}<p>{{ m_sub }}</p>{%- endif -%}
      </div>
    </div>

    <div class="lead-popup__content">
      <div class="lead-popup__head" data-head>
        {%- if section.settings.eyebrow != blank -%}
          <span class="lead-popup__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 class="lead-popup__heading">{{ section.settings.popup_heading }}</h2>
        {%- if section.settings.popup_subheading != blank -%}
          <p class="lead-popup__subheading">{{ section.settings.popup_subheading }}</p>
        {%- endif -%}
      </div>

      {%- comment -%}
        Everything is required except the email address. Errors surface
        per-field on submit. The button is never disabled as a validation gate.
      {%- endcomment -%}
      <form class="lead-popup__form" data-lead-popup-form novalidate>
        <div class="lead-popup__fields">
          <div class="lead-popup__field">
            <label for="lead-name-{{ section.id }}">Full name<span class="lead-popup__req">*</span></label>
            <input type="text" id="lead-name-{{ section.id }}" name="name" autocomplete="name" placeholder="Enter your full name" required>
            <p class="lead-popup__error" data-error-for="name"></p>
          </div>

          <div class="lead-popup__grid lead-popup__grid--phone">
            <div class="lead-popup__field">
              <label for="lead-phone-{{ section.id }}">Mobile number<span class="lead-popup__req">*</span></label>
              <div class="lead-popup__inputgroup" data-group-for="phone">
                <span class="lead-popup__prefix">+91</span>
                <input
                  type="tel"
                  id="lead-phone-{{ section.id }}"
                  name="phone"
                  inputmode="numeric"
                  autocomplete="tel"
                  placeholder="10-digit mobile"
                  required
                >
              </div>
              <p class="lead-popup__error" data-error-for="phone"></p>
            </div>

            <div class="lead-popup__field">
              <label for="lead-age-{{ section.id }}">Age<span class="lead-popup__req">*</span></label>
              <input type="number" id="lead-age-{{ section.id }}" name="age" inputmode="numeric" placeholder="Your age" required>
              <p class="lead-popup__error" data-error-for="age"></p>
            </div>
          </div>

          {%- if section.settings.collect_email -%}
            <div class="lead-popup__field">
              <label for="lead-email-{{ section.id }}">
                Email address<span class="lead-popup__optional">optional</span>
              </label>
              <input
                type="email"
                id="lead-email-{{ section.id }}"
                name="email"
                autocomplete="email"
                autocapitalize="off"
                spellcheck="false"
                placeholder="Enter your email address"
              >
              <p class="lead-popup__error" data-error-for="email"></p>
            </div>
          {%- endif -%}

          {%- comment -%}
            One free-text city field. Whatever the customer types is stored
            verbatim as `city`, with no parsing, no splitting, no guessing.
          {%- endcomment -%}
          <div class="lead-popup__field">
            <label for="lead-city-{{ section.id }}">City<span class="lead-popup__req">*</span></label>
            <input
              type="text"
              id="lead-city-{{ section.id }}"
              name="city"
              autocomplete="address-level2"
              placeholder="Enter your city"
              required
            >
            <p class="lead-popup__error" data-error-for="city"></p>
          </div>
        </div>

        <button type="submit" class="lead-popup__submit" data-submit>
          <span class="lead-popup__spinner" aria-hidden="true"></span>
          <span data-btn-label>{{ section.settings.button_text | default: 'Get free consultation' }}</span>
        </button>

        <p class="lead-popup__status" data-lead-popup-status role="status" aria-live="polite"></p>

        {%- if section.settings.consent_text != blank -%}
          <p class="lead-popup__consent">{{ section.settings.consent_text }}</p>
        {%- endif -%}
      </form>

      {%- comment -%} Mockup 1e: the form is replaced, not just annotated. {%- endcomment -%}
      <div class="lead-popup__success" data-success hidden>
        <span class="lead-popup__tick" aria-hidden="true">&#10003;</span>
        <h3>{{ section.settings.success_title | default: "Thanks, we'll call you soon" }}</h3>
        <p>{{ section.settings.success_message | default: 'One of our doctors will call you on this number within 24 hours.' }}</p>
      </div>
    </div>
  </div>
</div>

<style>
  #lead-popup-{{ section.id }} {
    /* Palette taken from the live theme's index.json so the popup sits in the
       storefront rather than beside it:
         #ee204a  accent, used as accent_color and button_primary_bg
         #d01d42  the accent's own hover, already defined by the theme
         #1d1d1d  the heading colour across every section
         #555555  secondary text
         #e5e5e5  the FAQ border colour                                    */
    --lp-accent: {{ section.settings.accent_color | default: '#ee204a' }};
    --lp-accent-hover: #d01d42;
    --lp-text: #1d1d1d;
    --lp-muted: #555555;
    --lp-border: #e5e5e5;
    --lp-required: #e11d48;
    --lp-error: #ef4444;
    --lp-success: #16a34a;
    --lp-panel: linear-gradient(165deg, #3d0a1a 0%, #9c1233 48%, #ee204a 100%);
    --lp-panel-mobile: linear-gradient(120deg, #3d0a1a 0%, #9c1233 55%, #ee204a 100%);

    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Montserrat', sans-serif;
  }
  #lead-popup-{{ section.id }}[hidden] { display: none !important; }

  #lead-popup-{{ section.id }} .lead-popup__overlay {
    position: absolute;
    inset: 0;
    background: rgba(17, 24, 39, {{ section.settings.overlay_opacity | default: 55 | divided_by: 100.0 }});
    animation: lp-veil-in-{{ section.id }} .24s ease both;
  }

  /* ---- Motion ----------------------------------------------------------
     Calm and clinical, not bouncy: decelerating ease on the way in, a
     shorter ease-in on the way out. `data-state="closing"` is set by the
     script, which then waits for animationend before hiding the popup,
     without that wait the element disappears and the exit never renders. */
  @keyframes lp-veil-in-{{ section.id }}  { from { opacity: 0; } to { opacity: 1; } }
  @keyframes lp-veil-out-{{ section.id }} { from { opacity: 1; } to { opacity: 0; } }
  @keyframes lp-in-{{ section.id }} {
    from { opacity: 0; transform: translateY(14px) scale(.985); }
    to   { opacity: 1; transform: none; }
  }
  @keyframes lp-out-{{ section.id }} {
    from { opacity: 1; transform: none; }
    to   { opacity: 0; transform: translateY(10px) scale(.99); }
  }

  #lead-popup-{{ section.id }}[data-state="closing"] .lead-popup__overlay {
    animation: lp-veil-out-{{ section.id }} .19s ease both;
  }
  #lead-popup-{{ section.id }}[data-state="closing"] .lead-popup__dialog {
    animation: lp-out-{{ section.id }} .19s ease both;
  }

  /* ---- Dialog (mockup 1a / 2a) ---------------------------------------- */
  #lead-popup-{{ section.id }} .lead-popup__dialog {
    position: relative;
    display: grid;
    grid-template-columns: 350px 1fr;
    /* minmax(0,1fr), not auto: an auto row sizes to its content and overflows
       max-height, which clipped the bottom of the photo panel (trust points)
       instead of letting the form column scroll. */
    grid-template-rows: minmax(0, 1fr);
    width: min(920px, calc(100vw - 40px));
    max-height: 90vh;
    /* The mockup's 500px floor lives here, not on the panel: on the panel it
       pushes the grid row past max-height and clips the trust points on short
       windows. On the dialog the panel just stretches to fill. */
    min-height: min(500px, 90vh);
    border-radius: 14px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 24px 64px rgba(0, 0, 0, .32);
    animation: lp-in-{{ section.id }} .3s cubic-bezier(.16, 1, .3, 1) both;
  }
  /* Mockup 1b: no image, narrow single column. */
  #lead-popup-{{ section.id }} .lead-popup__dialog--no-image {
    grid-template-columns: 1fr;
    width: min(560px, calc(100vw - 40px));
  }
  #lead-popup-{{ section.id }} .lead-popup__dialog--no-image .lead-popup__visual { display: none; }

  #lead-popup-{{ section.id }} .lead-popup__close {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 3;
    width: 40px;
    height: 40px;
    padding: 0;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--lp-border);
    box-shadow: 0 2px 8px rgba(0, 0, 0, .14);
    color: var(--lp-text);
    font: 400 18px/1 sans-serif;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    /* isolate makes the button its own stacking context, so the fill below can
       sit at z-index -1: painted over the button's own white background, but
       still behind the glyph. No wrapper element needed. */
    isolation: isolate;
    transition: color .18s ease, border-color .22s ease, box-shadow .22s ease, transform .1s ease;
  }

  /* The fill itself. inset:-1px so it covers the 1px border rather than
     leaving a pale ring around the filled circle. */
  #lead-popup-{{ section.id }} .lead-popup__close::before {
    content: "";
    position: absolute;
    inset: -1px;
    z-index: -1;
    border-radius: inherit;
    background: var(--lp-accent);
    transform: scale(0);
    transition: transform .3s cubic-bezier(.16, 1, .3, 1);
  }

  /* Pointer devices only. On a touchscreen :hover sticks after a tap, which
     would leave the button filled red until something else is touched. */
  @media (hover: hover) and (pointer: fine) {
    #lead-popup-{{ section.id }} .lead-popup__close:hover::before { transform: scale(1); }
    #lead-popup-{{ section.id }} .lead-popup__close:hover {
      color: #fff;
      border-color: var(--lp-accent);
      box-shadow: 0 4px 14px rgba(238, 32, 74, .35);
    }
  }

  #lead-popup-{{ section.id }} .lead-popup__close:active { transform: scale(.93); }
  #lead-popup-{{ section.id }} .lead-popup__close:focus-visible {
    outline: 2px solid var(--lp-accent);
    outline-offset: 2px;
  }

  /* ---- Visual panel ---------------------------------------------------- */
  #lead-popup-{{ section.id }} .lead-popup__visual {
    position: relative;
    min-height: 0;
    background: var(--lp-panel);
    overflow: hidden;
  }
  #lead-popup-{{ section.id }} .lead-popup__doctor {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
    display: block;
  }
  #lead-popup-{{ section.id }} .lead-popup__scrim {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 38%;
    background: linear-gradient(to top, rgba(20, 4, 10, .82), rgba(20, 4, 10, 0));
  }
  #lead-popup-{{ section.id }} .lead-popup__trust {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 18px;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  #lead-popup-{{ section.id }} .lead-popup__trust span {
    font: 500 12px/1.35 sans-serif;
    color: rgba(255, 255, 255, .94);
  }

  /* Mobile-only pieces, hidden at desktop/tablet. */
  #lead-popup-{{ section.id }} .lead-popup__handle,
  #lead-popup-{{ section.id }} .lead-popup__band-text { display: none; }

  /* ---- Content column -------------------------------------------------- */
  #lead-popup-{{ section.id }} .lead-popup__content {
    padding: 44px 48px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    overflow-y: auto;
    /* Grid children default to min-height:auto, which refuses to shrink below
       their content, so the dialog would clip at 90vh instead of scrolling. */
    min-height: 0;
  }
  #lead-popup-{{ section.id }} .lead-popup__head {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  #lead-popup-{{ section.id }} .lead-popup__eyebrow {
    font: 600 11px/1 sans-serif;
    letter-spacing: .09em;
    text-transform: uppercase;
    color: var(--lp-accent);
  }
  #lead-popup-{{ section.id }} .lead-popup__heading {
    margin: 0;
    font: 600 27px/1.25 sans-serif;
    color: var(--lp-text);
    text-wrap: pretty;
  }
  #lead-popup-{{ section.id }} .lead-popup__dialog--no-image .lead-popup__heading { font-size: 26px; }
  #lead-popup-{{ section.id }} .lead-popup__subheading {
    margin: 0;
    font: 400 14.5px/1.55 sans-serif;
    color: var(--lp-muted);
    text-wrap: pretty;
  }

  #lead-popup-{{ section.id }} .lead-popup__form {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  #lead-popup-{{ section.id }} .lead-popup__fields {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  #lead-popup-{{ section.id }} .lead-popup__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  #lead-popup-{{ section.id }} .lead-popup__grid--phone { grid-template-columns: 1.6fr 1fr; }

  #lead-popup-{{ section.id }} .lead-popup__field label {
    display: flex;
    gap: 4px;
    align-items: center;
    font: 600 12.5px sans-serif;
    color: var(--lp-text);
    margin-bottom: 6px;
  }
  #lead-popup-{{ section.id }} .lead-popup__req { color: var(--lp-required); }
  #lead-popup-{{ section.id }} .lead-popup__optional {
    font: italic 400 11.5px sans-serif;
    color: var(--lp-muted);
  }
  #lead-popup-{{ section.id }} .lead-popup__field label:has(.lead-popup__optional) {
    gap: 6px;
    align-items: baseline;
  }

  #lead-popup-{{ section.id }} .lead-popup__field input {
    width: 100%;
    box-sizing: border-box;
    padding: 11px 12px;
    border: 1px solid var(--lp-border);
    border-radius: 8px;
    font: 400 14px sans-serif;
    color: var(--lp-text);
    background: #fff;
  }
  #lead-popup-{{ section.id }} .lead-popup__field input:focus {
    outline: none;
    border-color: var(--lp-accent);
    box-shadow: 0 0 0 3px rgba(238, 32, 74, .16);
  }
  #lead-popup-{{ section.id }} input[type="number"] { -moz-appearance: textfield; appearance: textfield; }
  #lead-popup-{{ section.id }} input[type="number"]::-webkit-outer-spin-button,
  #lead-popup-{{ section.id }} input[type="number"]::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  /* Phone group: static +91, so the field itself holds only the 10 digits. */
  #lead-popup-{{ section.id }} .lead-popup__inputgroup {
    display: flex;
    align-items: center;
    border: 1px solid var(--lp-border);
    border-radius: 8px;
    background: #fff;
  }
  #lead-popup-{{ section.id }} .lead-popup__prefix {
    padding: 11px 0 11px 12px;
    font: 400 14px sans-serif;
    color: var(--lp-muted);
  }
  #lead-popup-{{ section.id }} .lead-popup__inputgroup input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: none;
    padding: 11px 12px;
    background: transparent;
  }
  #lead-popup-{{ section.id }} .lead-popup__inputgroup:focus-within {
    border-color: var(--lp-accent);
    box-shadow: 0 0 0 3px rgba(238, 32, 74, .16);
  }
  #lead-popup-{{ section.id }} .lead-popup__inputgroup input:focus { box-shadow: none; }

  /* Error state (mockup 1c) */
  #lead-popup-{{ section.id }} .lead-popup__field input[aria-invalid="true"],
  #lead-popup-{{ section.id }} .lead-popup__inputgroup[data-invalid="true"] {
    border-color: var(--lp-error);
    box-shadow: 0 0 0 3px rgba(239, 68, 68, .14);
  }
  #lead-popup-{{ section.id }} .lead-popup__inputgroup[data-invalid="true"] input { box-shadow: none; }
  #lead-popup-{{ section.id }} .lead-popup__error {
    margin: 5px 0 0;
    font: 400 11.5px/1.4 sans-serif;
    color: var(--lp-error);
  }
  #lead-popup-{{ section.id }} .lead-popup__error:empty { display: none; }

  #lead-popup-{{ section.id }} .lead-popup__submit {
    width: 100%;
    padding: 14px 18px;
    border: 0;
    border-radius: 8px;
    background: var(--lp-accent);
    color: #fff;
    font: 600 15px sans-serif;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
  }
  #lead-popup-{{ section.id }} .lead-popup__submit:hover:not(:disabled) {
    background: var(--lp-accent-hover);
  }
  #lead-popup-{{ section.id }} .lead-popup__submit:active:not(:disabled) { transform: translateY(1px); }
  #lead-popup-{{ section.id }} .lead-popup__submit:focus-visible {
    outline: 2px solid var(--lp-text);
    outline-offset: 2px;
  }
  /* Disabled ONLY during the write, never as a validation gate. */
  #lead-popup-{{ section.id }} .lead-popup__submit:disabled { opacity: .6; cursor: default; }

  #lead-popup-{{ section.id }} .lead-popup__spinner { display: none; }
  #lead-popup-{{ section.id }} .lead-popup__submit[data-loading="true"] .lead-popup__spinner {
    display: inline-block;
    width: 14px;
    height: 14px;
    border-radius: 999px;
    border: 2px solid rgba(255, 255, 255, .45);
    border-top-color: #fff;
    animation: lp-spin-{{ section.id }} .7s linear infinite;
  }
  @keyframes lp-spin-{{ section.id }} { to { transform: rotate(360deg); } }

  #lead-popup-{{ section.id }} .lead-popup__status {
    margin: 0;
    font: 500 12.5px/1.4 sans-serif;
    color: var(--lp-error);
    text-align: center;
  }
  #lead-popup-{{ section.id }} .lead-popup__status:empty { display: none; }

  #lead-popup-{{ section.id }} .lead-popup__consent {
    margin: 0;
    font: 400 11.5px/1.5 sans-serif;
    color: var(--lp-muted);
    text-align: center;
    text-wrap: pretty;
  }

